//! AST to IR Lowering
//!
//! This module converts the Abstract Syntax Tree (AST) into the
//! Intermediate Representation (IR) suitable for optimization,
//! analysis, and code generation.
//!
//! ## Key Responsibilities
//!
//! 1. **Type Resolution**: Attach resolved types to every IR node
//! 2. **Evidence Propagation**: Track and propagate evidence levels
//! 3. **Pipeline Desugaring**: Convert pipe chains to explicit operations
//! 4. **Morpheme Expansion**: Expand morpheme shorthand to full operations
//! 5. **Name Resolution**: Resolve all identifiers to unique IDs

invoke tome·ast·*;
invoke tome·ir·*;
invoke tome·span·Span;
invoke tome·typeck·{Type, TypeChecker, EvidenceLevel};

// ============================================================================
// Lowering Context
// ============================================================================

/// The lowering context tracks state during AST → IR conversion
☉ sigil LoweringContext {
    /// Type checker for type information
    type_checker: !TypeChecker,

    /// Unique ID counter for names
    id_counter: !u64,

    /// Current function being lowered
    current_function: ?String,

    /// Current This type name (when inside impl block)
    current_self_type: ?String,

    /// Collected errors
    errors: ![LowerError],

    /// Variable ID map: source name → unique ID
    var_ids: !Map<String, String>,

    /// Variable type map: variable name → type name (for method resolution)
    var_types: !Map<String, String>,

    /// CG-015: Map of qualified method name → has_mut_self
    /// e.g., "Lexer·advance" → yea, "Lexer·peek" → nay
    method_signatures: !Map<String, bool>,

    /// Import resolution map: imported name → qualified path
    /// e.g., "bar" → "foo·bar" from `invoke foo·bar;`
    /// e.g., "bar" → "foo·bar", "baz" → "foo·baz" from `invoke foo·{bar, baz};`
    imports: !Map<String, String>,

    /// Namespace stack for tracking current module path
    /// e.g., ["foo", "bar"] means we're inside scroll foo { scroll bar { ... } }
    namespace_stack: !Vec<String>,
}

⊢ LoweringContext {
    /// Create a new lowering context
    ☉ rite new(type_checker: !TypeChecker) → !LoweringContext {
        LoweringContext {
            type_checker,
            id_counter: 0,
            current_function: null,
            current_self_type: null,
            errors: [],
            var_ids: Map·new(),
            var_types: Map·new(),
            method_signatures: Map·new(),
            imports: Map·new(),
            namespace_stack: Vec·new(),
        }
    }

    /// Generate a unique ID
    rite fresh_id(vary this) → !String {
        ≔ id = this.id_counter;
        this.id_counter += 1;
        format!("id_{}", id)
    }

    /// Get the current namespace as a qualified name
    /// e.g., ["foo", "bar"] → "foo·bar·"
    rite current_namespace(this) → !String {
        ⎇ this.namespace_stack.len() == 0 {
            "".to_string()
        } ⎉ {
            // Build namespace string manually
            ≔ stack = this.namespace_stack;
            ≔ vary result = stack[0].clone();
            ≔ vary i = 1;
            ⟳ i < stack.len() {
                result = format!("{}·{}", result, stack[i]);
                i += 1;
            }
            format!("{}·", result)
        }
    }

    /// Qualify a name with the current namespace
    /// e.g., "baz" in namespace ["foo", "bar"] → "foo·bar·baz"
    rite qualify_name(this, name: !&str) → !String {
        ≔ ns = this.current_namespace();
        format!("{}{}", ns, name)
    }

    /// Record an error
    rite error(vary this, err: !LowerError) {
        this.errors.push(err);
    }

    /// Get or create an ID for a variable
    rite get_var_id(vary this, name: !&str) → !String {
        ⎇ ≔ ?id = this.var_ids.get(name) {
            id.clone()
        } ⎉ {
            ≔ id = this.fresh_id();
            this.var_ids.insert(name.to_string(), id.clone());
            id
        }
    }
}

/// Lowering error
☉ sigil LowerError {
    ☉ message: !String,
    ☉ span: ?Span,
}

⊢ LowerError {
    ☉ rite new(message: !String) → !LowerError {
        LowerError { message, span: null }
    }

    ☉ rite with_span(vary this, span: !Span) → !LowerError {
        this.span = ?span;
        this
    }
}

// ============================================================================
// Main Lowering Interface
// ============================================================================

/// Lower a complete source file to IR
☉ rite lower_file(file: !SourceFile, type_checker: !TypeChecker, path: !String) → !Result<IrModule, [LowerError]> {
    ≔ vary ctx = LoweringContext·new(type_checker);
    ≔ vary module = IrModule·new(path);

    // Lower all items
    ≔ vary idx: usize = 0;
    ⟳ idx < file.items.len() {
        lower_item(&vary ctx, &vary module, file.items[idx].node);
        idx = idx + 1;
    }

    // Report errors but continue - allows codegen to proceed
    // even with lowering errors (for development/bootstrapping)
    ≔ vary err_idx: usize = 0;
    ⟳ err_idx < ctx.errors.len() {
        // Skip eprintln! macro - not available in bootstrap context
        ≔ _ = format!("Lowering error: {}", ctx.errors[err_idx]);
        err_idx = err_idx + 1;
    }

    // CG-015: Copy method signatures to module for codegen lookup
    module.method_signatures = ctx.method_signatures.clone();

    Result·Ok(module)
}

/// Process a invoke declaration tree and populate the imports map
/// prefix: accumulated module path (e.g., "std·collections")
rite process_use_decl(ctx: &vary LoweringContext, prefix: !&str, tree: !UseTree) {
    ⌥ tree {
        UseTree·Path { prefix: segment, suffix } => {
            // Build up the path: prefix·segment
            ≔ new_prefix = ⎇ prefix == "" {
                segment.name.clone()
            } ⎉ {
                format!("{}·{}", prefix, segment.name)
            };
            process_use_decl(ctx, new_prefix.as_str(), *suffix);
        },
        UseTree·Name(name) => {
            // Final name: invoke prefix·name;
            ≔ full_path = ⎇ prefix == "" {
                name.name.clone()
            } ⎉ {
                format!("{}·{}", prefix, name.name)
            };
            // Map local name to full path
            ctx.imports.insert(name.name.clone(), full_path);
        },
        UseTree·Rename { name, alias } => {
            // invoke prefix·name as alias;
            ≔ full_path = ⎇ prefix == "" {
                name.name.clone()
            } ⎉ {
                format!("{}·{}", prefix, name.name)
            };
            // Map alias to full path
            ctx.imports.insert(alias.name.clone(), full_path);
        },
        UseTree·Glob => {
            // invoke prefix·*;  - not implemented yet, would need symbol table
            // For now, just ignore it
        },
        UseTree·Group(trees) => {
            // invoke prefix·{a, b, c};
            each subtree ∈ trees {
                process_use_decl(ctx, prefix, subtree);
            }
        },
    }
}

/// Lower a single item
rite lower_item(ctx: &vary LoweringContext, module: &vary IrModule, item: !Item) {
    ⌥ item {
        Item·Function(f) => {
            ⎇ ≔ ?ir_fn = lower_function(ctx, f) {
                module.functions.push(ir_fn);
            }
        },
        Item·Struct(s) => {
            module.types.push(lower_struct(ctx, s));
        },
        Item·Enum(e) => {
            module.types.push(lower_enum(ctx, e));
        },
        Item·TypeAlias(t) => {
            module.types.push(lower_type_alias(ctx, t));
        },
        Item·Const(c) => {
            ⎇ ≔ ?ir_const = lower_const(ctx, c) {
                module.constants.push(ir_const);
            }
        },
        Item·Trait(t) => {
            module.traits.push(lower_trait(ctx, t));
        },
        Item·Impl(i) => {
            // Get the type name for qualified function names
            ≔ type_name = ⌥ i.self_ty {
                TypeExpr·Path(p) => {
                    ⎇ p.segments.len() > 0 {
                        p.segments[0].ident.name.clone()
                    } ⎉ {
                        "".to_string()
                    }
                },
                _ => "".to_string(),
            };

            // Set current This type for resolving This in sigil expressions
            ctx.current_self_type = ?type_name.clone();

            // Add each method to module.functions with qualified name
            each impl_item ∈ i.items.clone() {
                ⎇ ≔ ImplItem·Function(f) = impl_item {
                    // Create a copy of the function with qualified name
                    ≔ qualified_name = format!("{}·{}", type_name, f.name.name);
                    ≔ vary qualified_func = f.clone();
                    qualified_func.name.name = qualified_name.clone();

                    // CG-015: Check ⎇ first param is `vary this` and record signature
                    ≔ has_mut_self = ⎇ f.params.len() > 0 {
                        ≔ first = &f.params[0];
                        ⌥ first.pattern {
                            Pattern·Ident { name, mutable, .. } => {
                                name.name == "this" ∧ mutable
                            },
                            _ => nay,
                        }
                    } ⎉ {
                        nay
                    };
                    ctx.method_signatures.insert(qualified_name.clone(), has_mut_self);

                    ⎇ ≔ ?ir_fn = lower_function(ctx, qualified_func) {
                        module.functions.push(ir_fn);
                    }
                }
            }

            module.impls.push(lower_impl(ctx, i));

            // Reset current This type
            ctx.current_self_type = null;
        },
        Item·Use(u) => {
            // Process invoke declaration and populate imports map
            process_use_decl(ctx, "", u.tree);
        },
        Item·Module(m) => {
            // Enter the module namespace
            ctx.namespace_stack.push(m.name.name.clone());

            // Recursively process module items
            each item ∈ m.items {
                lower_item(ctx, module, item);
            }

            // Exit the module namespace
            ctx.namespace_stack.pop();
        },
        _ => {
            // Other items don't generate IR
        },
    }
}

// ============================================================================
// Function Lowering
// ============================================================================

/// Lower a function definition
rite lower_function(ctx: &vary LoweringContext, func: !Function) → ?IrFunction {
    ≔ name = ctx.qualify_name(func.name.name.as_str());
    ≔ id = ctx.fresh_id();

    ctx.current_function = ?name.clone();

    // Clear function-local variable types to prevent cross-function type pollution
    // This is critical: without clearing, a variable like `params` in one function
    // with type String could incorrectly be used for `params` in another function
    ctx.var_types = Map·new();

    // Lower generics
    ≔ generics = ⌥ func.generics {
        ?g => g.params|τ{p => lower_generic_param(ctx, p)}|collect(),
        null | Option·None => [],
    };

    // Lower parameters
    ≔ params = func.params|τ{p => lower_param(ctx, p)}|collect();

    // Lower ⤺ type
    ≔ return_type = ⌥ func.return_type {
        ?t => lower_type(ctx, t),
        null | Option·None => IrType·Unit,
    };

    // Lower body
    ≔ body = ⌥ func.body {
        ?b => ?lower_block(ctx, b),
        null | Option·None => null,
    };

    // Visibility
    ≔ visibility = lower_visibility(func.visibility);

    // Span
    ≔ span = ?IrSpan·from_span(func.name.span);

    ctx.current_function = null;

    ?IrFunction {
        name,
        id,
        visibility,
        generics,
        params,
        return_type,
        body,
        attributes: [],
        is_async: func.is_async,
        span,
    }
}

/// Lower a generic parameter
rite lower_generic_param(ctx: &vary LoweringContext, param: !GenericParam) → !IrGenericParam {
    ⌥ param {
        GenericParam·Type { .. } => {
            ≔ name = param.name;
            ≔ bounds = param.bounds;
            IrGenericParam {
                name: name.name,
                bounds: ⌥ bounds {
                    ?b => b|τ{bound => bound.to_string()}|collect(),
                    null | Option·None => [],
                },
            }
        },
        GenericParam·Const { .. } => {
            ≔ name = param.name;
            IrGenericParam {
                name: name.name,
                bounds: [],
            }
        },
        GenericParam·Lifetime(name) => IrGenericParam {
            name: format!("'{}", name.name),
            bounds: [],
        },
    }
}

/// Lower a function parameter
rite lower_param(ctx: &vary LoweringContext, param: !Parameter) → !IrParam {
    ≔ name = ⌥ param.pattern.binding_name() {
        ?n => n,
        null | Option·None => "_",
    };

    ≔ ty = ⌥ param.ty {
        ?t => lower_type(ctx, t),
        null | Option·None => IrType·Infer,  // Closure params may have optional types
    };
    ≔ evidence = ⌥ param.pattern.evidentiality() {
        ?e => IrEvidence·from_typeck(EvidenceLevel·from_ast(e)),
        null | Option·None => IrEvidence·Known,
    };

    // CG-015: Extract mutability from the pattern
    ≔ mutable = ⌥ param.pattern {
        Pattern·Ident { mutable: m, .. } => m,
        _ => nay,
    };

    IrParam { name, ty, evidence, mutable }
}

/// Lower visibility
rite lower_visibility(vis: !Visibility) → !IrVisibility {
    ⌥ vis {
        Visibility·Public => IrVisibility·Public,
        Visibility·Crate => IrVisibility·Crate,
        Visibility·Private => IrVisibility·Private,
        Visibility·Restricted(_) => IrVisibility·Private,
    }
}

// ============================================================================
// Type Lowering
// ============================================================================

/// Extract the base type name from a TypeExpr for variable type tracking
/// Handles both Path types and Evidential types (like !IrTypeDef)
rite extract_type_name(ty: !TypeExpr) → ?String {
    ⌥ ty {
        TypeExpr·Path(p) => {
            ⎇ p.segments.len() == 1 {
                ?p.segments[0].ident.name.clone()
            } ⎉ {
                null
            }
        },
        TypeExpr·Evidential { inner, .. } => {
            // Unwrap evidential type (e.g., !IrTypeDef → IrTypeDef)
            extract_type_name(*inner)
        },
        _ => null,
    }
}

/// Lower a type expression to IR type
rite lower_type(ctx: &vary LoweringContext, ty: !TypeExpr) → !IrType {
    ⌥ ty {
        // Handle null TypeExpr gracefully (shouldn't happen but safety first)
        null | Option·None => IrType·Infer,

        TypeExpr·Path(path) => {
            ≔ name = path.segments|τ{s => s.ident.name}|join("·");
            ≔ generics = ⌥ path.segments.last() {
                ?seg => ⌥ seg.generics {
                    ?gs => gs|τ{t => lower_type(ctx, t)}|collect(),
                    null | Option·None => [],
                },
                null | Option·None => [],
            };

            // Check for primitive types
            ⌥ name.as_str() {
                "bool" => IrType·Primitive { name: "bool" },
                "char" => IrType·Primitive { name: "char" },
                "str" | "String" => IrType·Primitive { name: "str" },
                "i8" | "i16" | "i32" | "i64" | "i128" | "isize" => IrType·Primitive { name: name.clone() },
                "u8" | "u16" | "u32" | "u64" | "u128" | "usize" => IrType·Primitive { name: name.clone() },
                "f32" | "f64" => IrType·Primitive { name: name.clone() },
                _ => IrType·Named { name: name.clone(), generics },
            }
        },

        TypeExpr·Reference { .. } => {
            ≔ mutable = ty.mutable;
            ≔ inner = ty.inner;
            IrType·Reference {
                mutable,
                inner: Box·new(lower_type(ctx, *inner)),
            }
        },

        TypeExpr·Pointer { .. } => {
            ≔ mutable = ty.mutable;
            ≔ inner = ty.inner;
            IrType·Pointer {
                mutable,
                inner: Box·new(lower_type(ctx, *inner)),
            }
        },

        TypeExpr·Array { .. } => {
            ≔ element = ty.element;
            ≔ length = ty.length;
            IrType·Array {
                element: Box·new(lower_type(ctx, *element)),
                length: ⌥ length {
                    ?s => ?eval_const_length(ctx, s),
                    null | Option·None => null,
                },
            }
        },

        TypeExpr·Slice(inner) => IrType·Slice {
            element: Box·new(lower_type(ctx, *inner)),
        },

        TypeExpr·Tuple(elements) => IrType·Tuple {
            elements: elements|τ{t => lower_type(ctx, t)}|collect(),
        },

        TypeExpr·Function { .. } => {
            ≔ params = ty.params;
            ≔ return_type = ty.return_type;
            IrType·Function {
                params: params|τ{t => lower_type(ctx, t)}|collect(),
                return_type: Box·new(⌥ return_type {
                    ?t => lower_type(ctx, *t),
                    null | Option·None => IrType·Unit,
                }),
                is_async: nay,
            }
        },

        TypeExpr·Evidential { .. } => {
            ≔ inner = ty.inner;
            ≔ evidentiality = ty.evidentiality;
            IrType·Evidential {
                inner: Box·new(lower_type(ctx, *inner)),
                evidence: IrEvidence·from_typeck(EvidenceLevel·from_ast(evidentiality)),
            }
        },

        TypeExpr·Cycle { .. } => IrType·Cycle { modulus: 12 },

        TypeExpr·Simd { .. } => {
            ≔ element = ty.element;
            ≔ lanes = ty.lanes;
            IrType·Simd {
                element: Box·new(lower_type(ctx, *element)),
                lanes: lanes as u64,
            }
        },

        TypeExpr·Atomic(inner) => IrType·Atomic {
            inner: Box·new(lower_type(ctx, *inner)),
        },

        TypeExpr·Never => IrType·Never,
        TypeExpr·Infer => IrType·Infer,

        // impl Trait and dyn Trait - for now, lower as opaque/any type
        TypeExpr·ImplTrait { bounds } => {
            ⎇ bounds.is_empty() {
                IrType·Any
            } ⎉ {
                lower_type(ctx, bounds[0].clone())
            }
        }
        TypeExpr·DynTrait { bounds } => {
            ⎇ bounds.is_empty() {
                IrType·Any
            } ⎉ {
                lower_type(ctx, bounds[0].clone())
            }
        }
    }
}

/// Evaluate a constant expression to u64 (for array lengths)
rite eval_const_length(ctx: &vary LoweringContext, expr: !Expr) → !u64 {
    ⌥ expr {
        Expr·Literal(lit) => {
            ⌥ lit {
                Literal·Int { .. } => {
                    ≔ value = lit.value;
                    value as u64
                },
                _ => {
                    ctx.error(LowerError·new("array length must be constant integer"));
                    0
                },
            }
        },
        _ => {
            ctx.error(LowerError·new("array length must be constant integer"));
            0
        },
    }
}

// ============================================================================
// Type Definition Lowering
// ============================================================================

/// Lower a sigil definition
rite lower_struct(ctx: &vary LoweringContext, s: !Struct) → !IrTypeDef {
    ≔ generics = ⌥ s.generics {
        ?g => g.params|τ{p => lower_generic_param(ctx, p)}|collect(),
        null | Option·None => [],
    };

    ≔ fields = ⌥ s.fields {
        StructFields·Named(fs) => fs|τ{f => IrField {
            name: f.name.name,
            ty: lower_type(ctx, f.ty),
            visibility: lower_visibility(f.visibility),
        }}|collect(),
        StructFields·Tuple(ts) => ts
            |enumerate()
            |τ{pair => IrField {
                name: pair.0.to_string(),
                ty: lower_type(ctx, pair.1),
                visibility: IrVisibility·Private,
            }}|collect(),
        StructFields·Unit => [],
    };

    IrTypeDef·Struct {
        name: s.name.name,
        generics,
        fields,
        span: ?IrSpan·from_span(s.name.span),
    }
}

/// Lower an ᛈ definition
rite lower_enum(ctx: &vary LoweringContext, e: !Enum) → !IrTypeDef {
    ≔ generics = ⌥ e.generics {
        ?g => g.params|τ{p => lower_generic_param(ctx, p)}|collect(),
        null | Option·None => [],
    };

    ≔ variants = e.variants|τ{v => {
        ≔ fields = ⌥ v.fields {
            StructFields·Named(fs) => ?fs|τ{f => IrField {
                name: f.name.name,
                ty: lower_type(ctx, f.ty),
                visibility: lower_visibility(f.visibility),
            }}|collect(),
            StructFields·Tuple(ts) => ?ts
                |enumerate()
                |τ{pair => IrField {
                    name: pair.0.to_string(),
                    ty: lower_type(ctx, pair.1),
                    visibility: IrVisibility·Private,
                }}|collect(),
            StructFields·Unit => null,
        };

        IrVariant {
            name: v.name.name,
            fields,
            discriminant: ⌥ v.discriminant {
                ?d => ?eval_const_i64(ctx, d),
                null | Option·None => null,
            },
        }
    }}|collect();

    IrTypeDef·Enum {
        name: e.name.name,
        generics,
        variants,
        span: ?IrSpan·from_span(e.name.span),
    }
}

/// Lower a type alias
rite lower_type_alias(ctx: &vary LoweringContext, t: !TypeAlias) → !IrTypeDef {
    ≔ generics = ⌥ t.generics {
        ?g => g.params|τ{p => lower_generic_param(ctx, p)}|collect(),
        null | Option·None => [],
    };

    IrTypeDef·TypeAlias {
        name: t.name.name,
        generics,
        target: lower_type(ctx, t.ty),
        span: ?IrSpan·from_span(t.name.span),
    }
}

/// Evaluate a constant expression to i64 (for ᛈ discriminants)
rite eval_const_i64(ctx: &vary LoweringContext, expr: !Expr) → !i64 {
    ⌥ expr {
        Expr·Literal(Literal·Int { value, .. }) => value,
        _ => {
            ctx.error(LowerError·new("discriminant must be constant integer"));
            0
        },
    }
}

// ============================================================================
// Constant Lowering
// ============================================================================

/// Lower a constant definition
rite lower_const(ctx: &vary LoweringContext, c: !Const) → ?IrConstant {
    ≔ ty = lower_type(ctx, c.ty);
    ≔ value = lower_expr(ctx, c.value);
    ≔ visibility = lower_visibility(c.visibility);

    ?IrConstant {
        name: c.name.name,
        ty,
        value,
        visibility,
        span: ?IrSpan·from_span(c.name.span),
    }
}

// ============================================================================
// Trait and Impl Lowering
// ============================================================================

/// Lower a aspect definition
rite lower_trait(ctx: &vary LoweringContext, t: !TraitDef) → !IrTraitDef {
    ≔ generics = ⌥ t.generics {
        ?g => g.params|τ{p => lower_generic_param(ctx, p)}|collect(),
        null | Option·None => [],
    };

    ≔ super_traits = t.supertraits|τ{s => s.to_string()}|collect();

    ≔ methods = t.items
        |φ{item => ⌥ item { TraitItem·Method(_) => yea, _ => nay }}
        |τ{item => ⌥ item {
            TraitItem·Method(f) => lower_function(ctx, f),
            _ => null,
        }}
        |φ{m => m != null}
        |τ{m => m.unwrap()}
        |collect();

    IrTraitDef {
        name: t.name.name,
        generics,
        super_traits,
        methods,
        span: ?IrSpan·from_span(t.name.span),
    }
}

/// Lower an impl block
rite lower_impl(ctx: &vary LoweringContext, i: !ImplBlock) → !IrImplBlock {
    ≔ generics = ⌥ i.generics {
        ?g => g.params|τ{p => lower_generic_param(ctx, p)}|collect(),
        null | Option·None => [],
    };

    ≔ trait_name = ⌥ i.trait_ {
        ?p => {
            ≔ vary names: ![String] = Vec·new();
            each seg ∈ p.segments {
                names.push(seg.ident.name);
            }
            ?names.join("·")
        },
        null | Option·None => null,
    };

    ≔ target_type = lower_type(ctx, i.self_ty);

    ≔ methods = i.items
        |φ{item => ⌥ item { ImplItem·Function(_) => yea, _ => nay }}
        |τ{item => ⌥ item {
            ImplItem·Function(f) => lower_function(ctx, f),
            _ => panic("unreachable"),
        }}
        |collect();

    IrImplBlock {
        trait_name,
        target_type,
        generics,
        methods,
        span: null,
    }
}

// ============================================================================
// Expression Lowering
// ============================================================================

/// Lower an expression to IR operation
rite lower_expr(ctx: &vary LoweringContext, expr: !Expr) → !IrOperation {
    ⌥ expr {
        Expr·Literal(lit) => lower_literal(ctx, lit),

        Expr·Path(path) => {
            ≔ name = path.segments|τ{s => s.ident.name}|join("·");
            ≔ id = ctx.get_var_id(name);
            IrOperation·Var {
                name,
                id,
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Binary { .. } => {
            ≔ left = expr.left;
            ≔ op = expr.op;
            ≔ right = expr.right;
            ≔ ir_left = lower_expr(ctx, *left);
            ≔ ir_right = lower_expr(ctx, *right);
            ≔ ir_op = lower_binop(op);

            IrOperation·Binary {
                operator: ir_op,
                left: Box·new(ir_left),
                right: Box·new(ir_right),
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Unary { .. } => {
            ≔ op = expr.op;
            ≔ inner_expr = expr.expr;
            ≔ operand = lower_expr(ctx, *inner_expr);
            ≔ ir_op = lower_unaryop(op);

            IrOperation·Unary {
                operator: ir_op,
                operand: Box·new(operand),
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Call { .. } => {
            ≔ func = expr.func;
            ≔ args = expr.args;
            ≔ vary func_name = ⌥ *func {
                Expr·Path(path) => path.segments|τ{s => s.ident.name}|join("·"),
                _ => "<anonymous>",
            };

            // Resolve imports: ⎇ it's a simple name (no ·), check imports map
            ⎇ !func_name.contains("·") {
                ⎇ ≔ ?resolved = ctx.imports.get(func_name.as_str()) {
                    func_name = resolved.clone();
                }
            }

            ≔ ir_args = args|τ{a => lower_expr(ctx, a)}|collect();

            IrOperation·Call {
                function: func_name,
                function_id: ctx.fresh_id(),
                args: ir_args,
                type_args: [],
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Array(elements) => {
            ≔ vary ir_elements: ![IrOperation] = Vec·new();
            ≔ vary idx: usize = 0;
            ⟳ idx < elements.len() {
                ir_elements.push(lower_expr(ctx, elements[idx]));
                idx = idx + 1;
            }

            IrOperation·Array {
                elements: ir_elements,
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Repeat { value, count } => {
            IrOperation·Repeat {
                value: Box·new(lower_expr(ctx, *value)),
                count: Box·new(lower_expr(ctx, *count)),
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Tuple(elements) => {
            ≔ vary ir_elements: ![IrOperation] = Vec·new();
            ≔ vary idx: usize = 0;
            ⟳ idx < elements.len() {
                ir_elements.push(lower_expr(ctx, elements[idx]));
                idx = idx + 1;
            }

            IrOperation·Tuple {
                elements: ir_elements,
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Struct { .. } => {
            ≔ path = expr.path;
            ≔ fields = expr.fields;
            ≔ rest = expr.rest;
            // Get sigil name from path
            ≔ vary name = path.segments|τ{s => s.ident.name}|join("·");

            // Resolve This to actual type name when inside impl block
            ⎇ name == "This" {
                ⎇ ≔ ?self_type = ctx.current_self_type.clone() {
                    name = self_type;
                }
            }

            // Lower each field, handling shorthand syntax (This { x } means This { x: x })
            ≔ ir_fields = fields|τ{f => {
                ≔ value_expr = ⌥ f.value {
                    ?v => lower_expr(ctx, v),
                    null | Option·None => {
                        // Shorthand syntax: This { x } means This { x: x }
                        // Generate a variable reference for the field name
                        ≔ field_name = f.name.name.clone();
                        ≔ id = ctx.get_var_id(field_name.clone());
                        IrOperation·Var {
                            name: field_name,
                            id,
                            ty: IrType·Infer,
                            evidence: IrEvidence·Known,
                        }
                    },
                };
                (f.name.name.clone(), value_expr)
            }}|collect();

            // Lower rest expression ⎇ present
            ≔ ir_rest = ⌥ rest {
                ?r => ?Box·new(lower_expr(ctx, *r)),
                null | Option·None => null,
            };

            IrOperation·StructInit {
                name,
                fields: ir_fields,
                rest: ir_rest,
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Block(block) => lower_block(ctx, block),

        Expr·If { .. } => {
            ≔ condition = expr.condition;
            ≔ then_branch = expr.then_branch;
            ≔ else_branch = expr.else_branch;
            ≔ ir_cond = lower_expr(ctx, *condition);
            ≔ ir_then = lower_block(ctx, then_branch);
            ≔ ir_else = ⌥ else_branch {
                ?e => ?Box·new(lower_expr(ctx, *e)),
                null | Option·None => null,
            };

            IrOperation·If {
                condition: Box·new(ir_cond),
                then_branch: Box·new(ir_then),
                else_branch: ir_else,
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·While { .. } => {
            ≔ condition = expr.condition;
            ≔ body = expr.body;
            ≔ ir_cond = lower_expr(ctx, *condition);
            ≔ ir_body = lower_block(ctx, body);

            IrOperation·Loop {
                variant: LoopVariant·While,
                condition: ?Box·new(ir_cond),
                iterator: null,
                body: Box·new(ir_body),
                ty: IrType·Unit,
                evidence: IrEvidence·Known,
            }
        },

        Expr·For { .. } => {
            ≔ pattern = expr.pattern;
            ≔ iter = expr.iter;
            ≔ body = expr.body;
            ≔ ir_iter = lower_expr(ctx, *iter);
            ≔ ir_body = lower_block(ctx, body);
            ≔ ir_pattern = lower_pattern(ctx, pattern);

            IrOperation·Loop {
                variant: LoopVariant·For,
                condition: null,
                iterator: ?IrForIterator {
                    pattern: ir_pattern,
                    iterable: Box·new(ir_iter),
                },
                body: Box·new(ir_body),
                ty: IrType·Unit,
                evidence: IrEvidence·Known,
            }
        },

        // CG-011: Handle infinite loop expression
        Expr·Loop(body) => {
            ≔ ir_body = lower_block(ctx, body);
            IrOperation·Loop {
                variant: LoopVariant·Infinite,
                condition: null,
                iterator: null,
                body: Box·new(ir_body),
                ty: IrType·Unit,
                evidence: IrEvidence·Known,
            }
        },

        // CG-012: Handle break expression
        Expr·Break(value) => {
            ≔ ir_value = ⌥ value {
                null | Option·None => null,
                _ => ?Box·new(lower_expr(ctx, *value!)),
            };
            IrOperation·Break {
                value: ir_value,
                ty: IrType·Never,
                evidence: IrEvidence·Known,
            }
        },

        // CG-013: Handle continue expression
        Expr·Continue => {
            IrOperation·Continue {
                ty: IrType·Never,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Match { .. } => {
            ≔ inner_expr = expr.expr;
            ≔ arms = expr.arms;
            ≔ scrutinee = lower_expr(ctx, *inner_expr);
            ≔ ir_arms = arms|τ{arm => lower_match_arm(ctx, arm)}|collect();

            IrOperation·Match {
                scrutinee: Box·new(scrutinee),
                arms: ir_arms,
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Pipe { .. } => {
            ≔ inner_expr = expr.expr;
            ≔ operations = expr.operations;
            lower_pipeline(ctx, *inner_expr, operations)
        },

        Expr·Index { .. } => {
            ≔ inner_expr = expr.expr;
            ≔ index = expr.index;
            ≔ ir_expr = lower_expr(ctx, *inner_expr);
            ≔ ir_index = lower_expr(ctx, *index);

            IrOperation·Index {
                expr: Box·new(ir_expr),
                index: Box·new(ir_index),
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Field { .. } => {
            ≔ inner_expr = expr.expr;
            ≔ field = expr.field;
            ≔ ir_expr = lower_expr(ctx, *inner_expr);

            IrOperation·Field {
                expr: Box·new(ir_expr),
                field: field.name,
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Return(val) => {
            ≔ ir_val = ⌥ val {
                ?v => ?Box·new(lower_expr(ctx, *v)),
                null | Option·None => null,
            };

            IrOperation·Return {
                value: ir_val,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Range { .. } => {
            ≔ start = expr.start;
            ≔ end = expr.end;
            ≔ inclusive = expr.inclusive;
            ≔ ir_start = ⌥ start {
                ?s => ?Box·new(lower_expr(ctx, *s)),
                null | Option·None => null,
            };
            ≔ ir_end = ⌥ end {
                ?e => ?Box·new(lower_expr(ctx, *e)),
                null | Option·None => null,
            };

            IrOperation·Range {
                start: ir_start,
                end: ir_end,
                inclusive,
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Closure { params, body, .. } => {
            // Collect parameter names to exclude from capture analysis
            ≔ vary param_names: ![String] = Vec·new();
            each p ∈ params.iter() {
                ⎇ ≔ ?name = p.pattern.binding_name() {
                    param_names.push(name.to_string());
                }
            }

            // Find free variables in the closure body (captured from outer scope)
            ≔ captures = find_free_variables(&*body, &param_names);
            ≔ ir_params = params|τ{p => lower_param(ctx, p)}|collect();
            ≔ ir_body = lower_expr(ctx, *body);

            IrOperation·Closure {
                params: ir_params,
                body: Box·new(ir_body),
                captures,
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Evidential { .. } => {
            ≔ inner_expr = expr.expr;
            ≔ evidentiality = expr.evidentiality;
            ≔ inner = lower_expr(ctx, *inner_expr);
            ≔ ev = IrEvidence·from_typeck(EvidenceLevel·from_ast(evidentiality));

            IrOperation·EvidenceCoerce {
                operation: EvidenceOp·Mark,
                expr: Box·new(inner),
                from_evidence: IrEvidence·Known,
                to_evidence: ev,
                ty: IrType·Infer,
            }
        },

        Expr·Await { expr, evidentiality } => {
            ≔ ir_expr = lower_expr(ctx, *expr);
            ≔ evidence = ⌥ evidentiality {
                ?Evidentiality·Known => IrEvidence·Known,
                ?Evidentiality·Uncertain => IrEvidence·Uncertain,
                ?Evidentiality·Reported => IrEvidence·Reported,
                ?Evidentiality·Paradox => IrEvidence·Paradox,
                null | Option·None => IrEvidence·Known,
            };

            IrOperation·Await {
                expr: Box·new(ir_expr),
                ty: IrType·Infer,
                evidence,
            }
        },

        Expr·Assign { .. } => {
            ≔ target = expr.target;
            ≔ value = expr.value;
            ≔ ir_target = lower_expr(ctx, *target);
            ≔ ir_value = lower_expr(ctx, *value);

            IrOperation·Assign {
                target: Box·new(ir_target),
                value: Box·new(ir_value),
                evidence: IrEvidence·Known,
            }
        },

        // Let expression (for if-≔ patterns): returns yea ⎇ pattern matches
        Expr·Let { .. } => {
            ≔ pattern = expr.pattern;
            ≔ value = expr.value;
            ≔ ir_pattern = lower_pattern(ctx, *pattern);
            ≔ ir_value = lower_expr(ctx, *value);

            IrOperation·LetMatch {
                pattern: ir_pattern,
                value: Box·new(ir_value),
                ty: IrType·Primitive { name: "bool".to_string() },
                evidence: IrEvidence·Known,
            }
        },

        Expr·MethodCall { .. } => {
            ≔ receiver = expr.receiver;
            ≔ method = expr.method;
            ≔ args = expr.args;
            ≔ ir_receiver = lower_expr(ctx, *receiver.clone());
            ≔ ir_args = args|τ{a => lower_expr(ctx, a)}|collect();

            // Try to resolve method calls to qualified calls
            // 1. If receiver is 'this' and we're in an impl block, invoke Type·method(this, args)
            // 2. If receiver is a variable with known type, invoke Type·method(var, args)
            ≔ receiver_type = ⌥ *receiver {
                Expr·Path(p) => {
                    ⎇ p.segments.len() == 1 {
                        ≔ name = p.segments[0].ident.name.clone();
                        ⎇ name == "this" {
                            ctx.current_self_type.clone()
                        } ⎉ {
                            // Look up variable type
                            ⎇ ≔ ?type_name = ctx.var_types.get(name.as_str()) {
                                ?type_name.clone()
                            } ⎉ {
                                null
                            }
                        }
                    } ⎉ ⎇ p.segments.len() == 2 {
                        // 2-segment path like Token·Fn - invoke first segment as type
                        // This handles ᛈ variant constructors
                        ?p.segments[0].ident.name.clone()
                    } ⎉ {
                        null
                    }
                },
                Expr·Call { func, .. } => {
                    // Check ⎇ this is an ᛈ variant constructor call like Token·Ident("foo")
                    ⌥ *func {
                        Expr·Path(p) => {
                            ⎇ p.segments.len() == 2 {
                                // Enum variant constructor with data - invoke first segment as type
                                ?p.segments[0].ident.name.clone()
                            } ⎉ {
                                null
                            }
                        },
                        _ => null,
                    }
                },
                _ => null,
            };

            ⎇ ≔ ?recv_type = receiver_type {
                // Strip evidence prefixes (Uncertain, Known, Reported) from type name
                // These are generated by the interpreter for evidential types
                ≔ base_type = ⎇ recv_type.starts_with("Uncertain") {
                    recv_type[9..].to_string()
                } ⎉ ⎇ recv_type.starts_with("Known") {
                    recv_type[5..].to_string()
                } ⎉ ⎇ recv_type.starts_with("Reported") {
                    recv_type[8..].to_string()
                } ⎉ {
                    recv_type.clone()
                };

                // Generate qualified call: Type·method(receiver, args)
                ≔ qualified_name = format!("{}·{}", base_type, method.name);
                ≔ vary all_args = [ir_receiver];
                each arg ∈ ir_args {
                    all_args.push(arg);
                }
                ⤺ IrOperation·Call {
                    function: qualified_name,
                    args: all_args,
                    type_args: [],
                    ty: IrType·Infer,
                    evidence: IrEvidence·Known,
                };
            }

            // Fallback to generic method call
            IrOperation·MethodCall {
                receiver: Box·new(ir_receiver),
                method: method.name,
                args: ir_args,
                type_args: [],
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Cast { .. } => {
            ≔ inner_expr = expr.expr;
            ≔ ty = expr.ty;
            ≔ ir_expr = lower_expr(ctx, *inner_expr);
            ≔ target_type = lower_type(ctx, ty);

            IrOperation·Cast {
                expr: Box·new(ir_expr),
                target_type: target_type.clone(),
                ty: target_type,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Macro { .. } => {
            ≔ path = expr.path;
            ≔ tokens = expr.tokens;
            // Get macro name from path
            ≔ macro_name = path.segments|τ{s => s.ident.name}|join("·");

            // Handle known macros
            ⌥ macro_name.as_str() {
                "write" | "writeln" => {
                    // write!(buf, "format", args...) → macro_write(buf, "format", args...)
                    IrOperation·MacroExpansion {
                        name: macro_name,
                        tokens,
                        ty: IrType·Unit,
                        evidence: IrEvidence·Known,
                    }
                },
                "format" => {
                    // format!("...", args) → MacroExpansion with tokens passed through
                    // Note: Argument translation (e.g., x.len() → sigil_len(x)) happens in
                    // build.sh post-processing due to complexity of re-parsing at lowering phase
                    IrOperation·MacroExpansion {
                        name: macro_name,
                        tokens,
                        ty: IrType·Primitive { name: "String" },
                        evidence: IrEvidence·Known,
                    }
                },
                "print" | "println" => {
                    // print!("...") → macro_print("...")
                    IrOperation·MacroExpansion {
                        name: macro_name,
                        tokens,
                        ty: IrType·Unit,
                        evidence: IrEvidence·Known,
                    }
                },
                "vec" => {
                    // vec![a, b, c] → macro_vec(a, b, c)
                    IrOperation·MacroExpansion {
                        name: macro_name,
                        tokens,
                        ty: IrType·Infer,
                        evidence: IrEvidence·Known,
                    }
                },
                "assert" | "assert_eq" => {
                    // assert!(cond) → macro_assert(cond)
                    IrOperation·MacroExpansion {
                        name: macro_name,
                        tokens,
                        ty: IrType·Unit,
                        evidence: IrEvidence·Known,
                    }
                },
                _ => {
                    // Unknown macro - generate generic macro call
                    IrOperation·MacroExpansion {
                        name: macro_name,
                        tokens,
                        ty: IrType·Infer,
                        evidence: IrEvidence·Uncertain,
                    }
                },
            }
        },

        // Try expression: expr?
        // Evaluates inner expression, returns early ⎇ error, unwraps ⎇ ok
        // Try always produces uncertain evidence
        Expr·Try(inner) => {
            ≔ ir_inner = lower_expr(ctx, *inner);

            IrOperation·Try {
                expr: Box·new(ir_inner),
                ty: IrType·Infer,
                evidence: IrEvidence·Uncertain,
            }
        },

        // Unsafe block - lower contents, marking as unsafe
        Expr·Unsafe(block) => {
            lower_block(ctx, block)
        },

        // Extern block expression - declarations are in C runtime, ⤺ unit
        Expr·ExternBlockExpr(_) => {
            IrOperation·Literal {
                variant: LiteralVariant·Null,
                value: LiteralValue·Null,
                ty: IrType·Unit,
                evidence: IrEvidence·Known,
            }
        },

        // Dereference: *ptr
        Expr·Deref(inner) => {
            ≔ ir_inner = lower_expr(ctx, *inner);
            IrOperation·Unary {
                operator: UnaryOp·Deref,
                operand: Box·new(ir_inner),
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        // Address-of: &expr or &vary expr
        Expr·AddrOf { expr: inner, mutable } => {
            ≔ ir_inner = lower_expr(ctx, *inner);
            ≔ op = ⎇ mutable { UnaryOp·RefMut } ⎉ { UnaryOp·Ref };
            IrOperation·Unary {
                operator: op,
                operand: Box·new(ir_inner),
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        // Reference (alias for AddrOf)
        Expr·Reference { expr: inner, mutable } => {
            ≔ ir_inner = lower_expr(ctx, *inner);
            ≔ op = ⎇ mutable { UnaryOp·RefMut } ⎉ { UnaryOp·Ref };
            IrOperation·Unary {
                operator: op,
                operand: Box·new(ir_inner),
                ty: IrType·Infer,
                evidence: IrEvidence·Known,
            }
        },

        // Add handlers for expressions that shouldn't reach the fallback
        Expr·Incorporation { .. } => {
            // Incorporation: file·open·read - emit as chain of method calls
            ctx.error(LowerError·new("incorporation expressions not yet supported"));
            IrOperation·Literal {
                variant: LiteralVariant·Null,
                value: LiteralValue·Null,
                ty: IrType·Unit,
                evidence: IrEvidence·Known,
            }
        },

        Expr·Morpheme { .. } => {
            // Morpheme: τ{f} - emit as transform call
            ctx.error(LowerError·new("morpheme expressions not yet supported"));
            IrOperation·Literal {
                variant: LiteralVariant·Null,
                value: LiteralValue·Null,
                ty: IrType·Unit,
                evidence: IrEvidence·Known,
            }
        },

        Expr·InlineAsm(_) => {
            ctx.error(LowerError·new("inline assembly not yet supported"));
            IrOperation·Literal {
                variant: LiteralVariant·Null,
                value: LiteralValue·Null,
                ty: IrType·Unit,
                evidence: IrEvidence·Known,
            }
        },

        _ => {
            // Fallback for unhandled expressions - this should NOT be reached
            // If we get here, there's a missing ⌥ arm above
            ctx.error(LowerError·new("unsupported expression type (missing ⌥ arm)"));
            IrOperation·Literal {
                variant: LiteralVariant·Null,
                value: LiteralValue·Null,
                ty: IrType·Unit,
                evidence: IrEvidence·Known,
            }
        },
    }
}

/// Helper to parse integer literals with different bases
rite parse_int_literal(value_str: !String, base: !NumBase) → !i64 {
    // Remove underscores for readability (they're allowed in literals)
    ≔ clean_str = value_str.replace("_", "");

    ⌥ base {
        NumBase·Decimal => clean_str as i64,
        NumBase·Hex => {
            // Remove "0x" prefix
            ≔ hex_digits = ⎇ clean_str.starts_with("0x") ∨ clean_str.starts_with("0X") {
                clean_str[2..].to_string()
            } ⎉ {
                clean_str
            };
            // Parse hex string to i64
            i64·from_str_radix(hex_digits.as_str(), 16).unwrap_or(0)
        },
        NumBase·Binary => {
            // Remove "0b" prefix
            ≔ bin_digits = ⎇ clean_str.starts_with("0b") ∨ clean_str.starts_with("0B") {
                clean_str[2..].to_string()
            } ⎉ {
                clean_str
            };
            i64·from_str_radix(bin_digits.as_str(), 2).unwrap_or(0)
        },
        NumBase·Octal => {
            // Remove "0o" prefix
            ≔ oct_digits = ⎇ clean_str.starts_with("0o") ∨ clean_str.starts_with("0O") {
                clean_str[2..].to_string()
            } ⎉ {
                clean_str
            };
            i64·from_str_radix(oct_digits.as_str(), 8).unwrap_or(0)
        },
        _ => clean_str as i64,  // Fallback for other bases
    }
}

/// Lower a literal
rite lower_literal(ctx: &vary LoweringContext, lit: !Literal) → !IrOperation {
    ⌥ lit {
        Literal·Int { value, base, .. } => {
            // Parse the string value according to its base
            ≔ parsed_value = parse_int_literal(value, base);
            IrOperation·Literal {
                variant: LiteralVariant·Int,
                value: LiteralValue·Int(parsed_value),
                ty: IrType·Primitive { name: "i64" },
                evidence: IrEvidence·Known,
            }
        },
        Literal·Float { .. } => {
            ≔ value = lit.value;
            IrOperation·Literal {
                variant: LiteralVariant·Float,
                value: LiteralValue·Float(value),
                ty: IrType·Primitive { name: "f64" },
                evidence: IrEvidence·Known,
            }
        },
        Literal·Bool(b) => IrOperation·Literal {
            variant: LiteralVariant·Bool,
            value: LiteralValue·Bool(b),
            ty: IrType·Primitive { name: "bool" },
            evidence: IrEvidence·Known,
        },
        Literal·Char(c) => IrOperation·Literal {
            variant: LiteralVariant·Char,
            value: LiteralValue·Char(c),
            ty: IrType·Primitive { name: "char" },
            evidence: IrEvidence·Known,
        },
        Literal·String(s) => IrOperation·Literal {
            variant: LiteralVariant·String,
            value: LiteralValue·String(s),
            ty: IrType·Primitive { name: "str" },
            evidence: IrEvidence·Known,
        },
        Literal·ByteString(bytes) => {
            // Convert bytes to string by treating as ASCII/UTF-8
            ≔ vary s = String·new();
            each b ∈ bytes {
                s.push(b as char);
            }
            IrOperation·Literal {
                variant: LiteralVariant·String,
                value: LiteralValue·String(s),
                ty: IrType·Array { element: Box·new(IrType·Primitive { name: "u8" }) },
                evidence: IrEvidence·Known,
            }
        },
        Literal·Null => IrOperation·Literal {
            variant: LiteralVariant·Null,
            value: LiteralValue·Null,
            ty: IrType·Unit,
            evidence: IrEvidence·Known,
        },
        _ => {
            ctx.error(LowerError·new("unsupported literal type"));
            IrOperation·Literal {
                variant: LiteralVariant·Null,
                value: LiteralValue·Null,
                ty: IrType·Unit,
                evidence: IrEvidence·Known,
            }
        },
    }
}

/// Find free variables in an expression that are not in the bound set
/// This is used for closure capture analysis
rite find_free_variables(expr: &Expr, bound: &[String]) → ![String] {
    ≔ free: ![String] = Vec·new();
    collect_free_vars(expr, bound, free)
}

/// Helper to collect free variables, returning updated array
rite collect_free_vars(expr: &Expr, bound: &[String], free: ![String]) → ![String] {
    ≔ vary result = free;
    ⌥ expr {
        Expr·Path(path) => {
            // Single-segment paths are potential variable references
            ⎇ path.segments.len() == 1 {
                ≔ name = path.segments[0].ident.name.clone();
                // Check ⎇ it's not already bound or already in free
                ⎇ !bound.contains(&name) ∧ !result.contains(&name) {
                    result.push(name);
                }
            }
        },
        Expr·Binary { left, right, .. } => {
            result = collect_free_vars(left, bound, result);
            result = collect_free_vars(right, bound, result);
        },
        Expr·Unary { operand, .. } => {
            result = collect_free_vars(operand, bound, result);
        },
        Expr·Call { func, args, .. } => {
            result = collect_free_vars(func, bound, result);
            each arg ∈ args.iter() {
                result = collect_free_vars(arg, bound, result);
            }
        },
        Expr·MethodCall { receiver, args, .. } => {
            result = collect_free_vars(receiver, bound, result);
            each arg ∈ args.iter() {
                result = collect_free_vars(arg, bound, result);
            }
        },
        Expr·If { condition, then_block, else_block, .. } => {
            result = collect_free_vars(condition, bound, result);
            each stmt ∈ then_block.stmts.iter() {
                result = collect_free_vars_stmt(stmt, bound, result);
            }
            ⎇ ≔ Some(else_expr) = else_block {
                result = collect_free_vars(else_expr, bound, result);
            }
        },
        Expr·Block(block) => {
            each stmt ∈ block.stmts.iter() {
                result = collect_free_vars_stmt(stmt, bound, result);
            }
            // Also check the optional final expression
            ⌥ block.expr {
                ?e => result = collect_free_vars(*e, bound, result),
                null | Option·None => {},
            }
        },
        Expr·Array(elements) => {
            each elem ∈ elements.iter() {
                result = collect_free_vars(elem, bound, result);
            }
        },
        Expr·Repeat { value, count } => {
            result = collect_free_vars(&*value, bound, result);
            result = collect_free_vars(&*count, bound, result);
        },
        Expr·Tuple(elements) => {
            each elem ∈ elements.iter() {
                result = collect_free_vars(elem, bound, result);
            }
        },
        Expr·Index { expr, index, .. } => {
            result = collect_free_vars(expr, bound, result);
            result = collect_free_vars(index, bound, result);
        },
        Expr·Field { expr, .. } => {
            result = collect_free_vars(expr, bound, result);
        },
        Expr·Return(val) => {
            ⎇ ≔ Some(v) = val {
                result = collect_free_vars(v, bound, result);
            }
        },
        Expr·Match { expr, arms, .. } => {
            result = collect_free_vars(expr, bound, result);
            each arm ∈ arms.iter() {
                // Pattern bindings would extend bound, but for simplicity just recurse into body
                result = collect_free_vars(&arm.body, bound, result);
            }
        },
        // Closure within closure - extend bound with params, then recurse
        Expr·Closure { params, body, .. } => {
            ≔ vary inner_bound: ![String] = Vec·new();
            each b ∈ bound.iter() {
                inner_bound.push(b.clone());
            }
            each p ∈ params.iter() {
                inner_bound.push(p.name.clone());
            }
            result = collect_free_vars(body, &inner_bound, result);
        },
        // For/While loops
        Expr·For { pattern, iter, body, .. } => {
            result = collect_free_vars(iter, bound, result);
            // Pattern bindings extend bound for body
            each stmt ∈ body.stmts.iter() {
                result = collect_free_vars_stmt(stmt, bound, result);
            }
        },
        Expr·While { condition, body, .. } => {
            result = collect_free_vars(condition, bound, result);
            each stmt ∈ body.stmts.iter() {
                result = collect_free_vars_stmt(stmt, bound, result);
            }
        },
        Expr·Loop(body) => {
            each stmt ∈ body.stmts.iter() {
                result = collect_free_vars_stmt(stmt, bound, result);
            }
        },
        // Literals and other simple expressions don't have free vars
        _ => {}
    }
    result
}

/// Helper to collect free variables from statements, returning updated array
rite collect_free_vars_stmt(stmt: &Stmt, bound: &[String], free: ![String]) → ![String] {
    ⌥ stmt {
        Stmt·Expr(expr) => collect_free_vars(expr, bound, free),
        Stmt·Let { init, .. } => {
            ⎇ ≔ Some(expr) = init {
                collect_free_vars(expr, bound, free)
            } ⎉ {
                free
            }
        },
        _ => free
    }
}

/// Lower a binary operator
rite lower_binop(op: !BinOp) → !BinaryOp {
    ⌥ op {
        BinOp·Add => BinaryOp·Add,
        BinOp·Sub => BinaryOp·Sub,
        BinOp·Mul => BinaryOp·Mul,
        BinOp·Div => BinaryOp·Div,
        BinOp·Rem => BinaryOp·Rem,
        BinOp·Pow => BinaryOp·Pow,
        BinOp·And => BinaryOp·And,
        BinOp·Or => BinaryOp·Or,
        BinOp·BitAnd => BinaryOp·BitAnd,
        BinOp·BitOr => BinaryOp·BitOr,
        BinOp·BitXor => BinaryOp·BitXor,
        BinOp·Shl => BinaryOp·Shl,
        BinOp·Shr => BinaryOp·Shr,
        BinOp·Eq => BinaryOp·Eq,
        BinOp·Ne => BinaryOp·Ne,
        BinOp·Lt => BinaryOp·Lt,
        BinOp·Le => BinaryOp·Le,
        BinOp·Gt => BinaryOp·Gt,
        BinOp·Ge => BinaryOp·Ge,
        BinOp·Concat => BinaryOp·Concat,
    }
}

/// Lower a unary operator (AST UnaryOp → IR UnaryOp)
rite lower_unaryop(op: !ast·UnaryOp) → !UnaryOp {
    ⌥ op {
        ast·UnaryOp·Neg => UnaryOp·Neg,
        ast·UnaryOp·Not => UnaryOp·Not,
        ast·UnaryOp·Ref => UnaryOp·Ref,
        ast·UnaryOp·RefMut => UnaryOp·RefMut,
        ast·UnaryOp·Deref => UnaryOp·Deref,
    }
}

// ============================================================================
// Block and Statement Lowering
// ============================================================================

/// Lower a block
rite lower_block(ctx: &vary LoweringContext, block: !Block) → !IrOperation {
    ≔ vary statements: ![IrOperation] = Vec·new();

    ≔ vary idx: usize = 0;
    ⟳ idx < block.stmts.len() {
        statements.push(lower_stmt(ctx, block.stmts[idx]));
        idx = idx + 1;
    }

    // If there's a trailing expression, add it as the last statement
    ⎇ ≔ ?expr = block.expr {
        statements.push(lower_expr(ctx, expr));
    }

    IrOperation·Block {
        statements,
        ty: IrType·Infer,
        evidence: IrEvidence·Known,
    }
}

/// Lower a statement
rite lower_stmt(ctx: &vary LoweringContext, stmt: !Stmt) → !IrOperation {
    ⌥ stmt {
        Stmt·Let { .. } => {
            ≔ pattern = stmt.pattern;
            ≔ ty = stmt.ty;
            ≔ init = stmt.init;
            ≔ ir_pattern = lower_pattern(ctx, pattern.clone());
            ≔ type_annotation = ⌥ ty {
                ?t => ?lower_type(ctx, t),
                null | Option·None => null,
            };

            // Try to infer type from init expression (e.g., Point·new(...) → Point)
            ≔ inferred_type = ⌥ init.clone() {
                ?e => {
                    ⌥ e {
                        Expr·Call { .. } => {
                            ≔ func = e.func;
                            ⌥ *func {
                                Expr·Path(p) => {
                                    // If call is Type·method, extract Type
                                    ≔ segments = p.segments;
                                    ⎇ segments.len() >= 2 {
                                        ?segments[0].ident.name.clone()
                                    } ⎉ ⎇ segments.len() == 1 ∧ segments[0].ident.name.contains("·") {
                                        // Handle qualified name like "Point·new"
                                        ≔ parts = segments[0].ident.name.split("·");
                                        ⎇ parts.len() >= 1 { ?parts[0].to_string() } ⎉ { null }
                                    } ⎉ {
                                        null
                                    }
                                },
                                _ => null,
                            }
                        },
                        _ => null,
                    }
                },
                null | Option·None => null,
            };

            // Track variable type from inference or explicit annotation
            ≔ final_type = ⎇ ≔ ?type_name = inferred_type {
                ?type_name
            } ⎉ {
                // Try to get type name from explicit annotation
                ⌥ ty {
                    ?t => extract_type_name(t),
                    null | Option·None => null,
                }
            };

            ⎇ ≔ ?type_name = final_type {
                ⌥ pattern {
                    Pattern·Ident { .. } => {
                        ≔ name = pattern.name;
                        ctx.var_types.insert(name.name.clone(), type_name);
                    },
                    _ => {},
                }
            }

            ≔ ir_init = ⌥ init {
                ?e => lower_expr(ctx, e),
                null | Option·None => IrOperation·Literal {
                    variant: LiteralVariant·Null,
                    value: LiteralValue·Null,
                    ty: IrType·Unit,
                    evidence: IrEvidence·Known,
                },
            };

            IrOperation·Let {
                pattern: ir_pattern,
                type_annotation,
                init: Box·new(ir_init),
                evidence: IrEvidence·Known,
            }
        },
        Stmt·LetElse { .. } => {
            ≔ pattern = stmt.pattern;
            ≔ ty = stmt.ty;
            ≔ init = stmt.init;
            ≔ else_branch = stmt.else_branch;
            // Lower let-else: ≔ Pattern = expr ⎉ { ... }
            ≔ ir_pattern = lower_pattern(ctx, pattern.clone());
            ≔ type_annotation = ⌥ ty {
                ?t => ?lower_type(ctx, t),
                null | Option·None => null,
            };

            ≔ ir_init = lower_expr(ctx, init);
            ≔ ir_else = lower_expr(ctx, else_branch);

            // Lower to a conditional with pattern matching
            // The else branch should diverge (return/panic)
            IrOperation·LetElse {
                pattern: ir_pattern,
                type_annotation,
                init: Box·new(ir_init),
                else_branch: Box·new(ir_else),
                evidence: IrEvidence·Known,
            }
        },
        Stmt·Expr(e) | Stmt·Semi(e) => lower_expr(ctx, e),
        Stmt·Item(item) => {
            // Nested items are handled separately
            IrOperation·Block {
                statements: [],
                ty: IrType·Unit,
                evidence: IrEvidence·Known,
            }
        },
    }
}

// ============================================================================
// Pattern Lowering
// ============================================================================

/// Lower a pattern
rite lower_pattern(ctx: &vary LoweringContext, pattern: !Pattern) → !IrPattern {
    ⌥ pattern {
        Pattern·Ident { name, mutable, by_ref, evidentiality } => {
            ≔ ev = ⌥ evidentiality {
                ?e => ?IrEvidence·from_typeck(EvidenceLevel·from_ast(e)),
                null | Option·None => null,
            };
            IrPattern·Ident {
                name: name.name,
                mutable,
                by_ref,
                evidence: ev,
            }
        },
        Pattern·Tuple(pats) => IrPattern·Tuple {
            elements: pats|τ{p => lower_pattern(ctx, p)}|collect(),
        },
        Pattern·Struct { path, fields, rest } => IrPattern·Struct {
            path: path.segments|τ{s => s.ident.name}|join("·"),
            fields: fields|τ{f => (f.name.name, ⌥ f.pattern {
                ?p => lower_pattern(ctx, p),
                null | Option·None => IrPattern·Ident {
                    name: f.name.name,
                    mutable: nay,
                    by_ref: nay,
                    evidence: null,
                },
            })}|collect(),
            rest,
        },
        Pattern·TupleStruct { path, fields } => IrPattern·TupleStruct {
            path: path.segments|τ{s => s.ident.name}|join("·"),
            fields: fields|τ{p => lower_pattern(ctx, p)}|collect(),
        },
        Pattern·Slice(pats) => IrPattern·Slice {
            elements: pats|τ{p => lower_pattern(ctx, p)}|collect(),
        },
        Pattern·Or(pats) => IrPattern·Or {
            patterns: pats|τ{p => lower_pattern(ctx, p)}|collect(),
        },
        Pattern·Literal(lit) => IrPattern·Literal {
            value: lower_literal_value(ctx, lit),
        },
        Pattern·Range { start, end, inclusive } => IrPattern·Range {
            start: ⌥ start {
                ?s => ?Box·new(lower_pattern(ctx, *s)),
                null | Option·None => null,
            },
            end: ⌥ end {
                ?e => ?Box·new(lower_pattern(ctx, *e)),
                null | Option·None => null,
            },
            inclusive,
        },
        Pattern·Wildcard => IrPattern·Wildcard,
        Pattern·Rest => IrPattern·Wildcard,
        Pattern·Evidential { pattern: inner, evidentiality } => {
            // CG-025 FIX: Evidential patterns like ?v need evidence propagated
            ≔ inner_lowered = lower_pattern(ctx, *inner);
            ≔ ev = ?IrEvidence·from_typeck(EvidenceLevel·from_ast(evidentiality));
            // Propagate evidence to the inner pattern (for Ident and Wildcard patterns)
            ⌥ inner_lowered {
                IrPattern·Ident { name, mutable, by_ref, .. } => IrPattern·Ident {
                    name,
                    mutable,
                    by_ref,
                    evidence: ev,
                },
                // CG-057 FIX: ?_ (evidential wildcard) should become IrPattern·Ident with evidence
                // This allows codegen to emit proper null checks instead of "⎇ (1)"
                IrPattern·Wildcard => IrPattern·Ident {
                    name: "_".to_string(),
                    mutable: nay,
                    by_ref: nay,
                    evidence: ev,
                },
                _ => inner_lowered,  // Other patterns: ⤺ as-is (evidence noted but not stored)
            }
        },
        Pattern·Path(path) => {
            // Path patterns like Some or None
            IrPattern·Path {
                path: path.segments|τ{s => s.ident.name}|join("·"),
            }
        },
    }
}

/// Lower a literal to LiteralValue
rite lower_literal_value(ctx: &vary LoweringContext, lit: !Literal) → !LiteralValue {
    ⌥ lit {
        Literal·Int { value, .. } => LiteralValue·Int(value),
        Literal·Float { value, .. } => LiteralValue·Float(value),
        Literal·Bool(b) => LiteralValue·Bool(b),
        Literal·Char(c) => LiteralValue·Char(c),
        Literal·String(s) => LiteralValue·String(s),
        Literal·Null => LiteralValue·Null,
        _ => LiteralValue·Null,
    }
}

// ============================================================================
// Match Arm Lowering
// ============================================================================

/// Lower a ⌥ arm
rite lower_match_arm(ctx: &vary LoweringContext, arm: !MatchArm) → !IrMatchArm {
    ≔ pattern = lower_pattern(ctx, arm.pattern);
    ≔ guard = ⌥ arm.guard {
        ?g => ?lower_expr(ctx, g),
        null | Option·None => null,
    };
    ≔ body = lower_expr(ctx, arm.body);

    IrMatchArm { pattern, guard, body }
}

// ============================================================================
// Pipeline Lowering
// ============================================================================

/// Lower a pipeline expression
rite lower_pipeline(ctx: &vary LoweringContext, input: !Expr, operations: ![PipeOp]) → !IrOperation {
    ≔ ir_input = lower_expr(ctx, input);
    ≔ steps = operations|τ{op => lower_pipe_op(ctx, op)}|collect();

    IrOperation·Pipeline {
        input: Box·new(ir_input),
        steps,
        ty: IrType·Infer,
        evidence: IrEvidence·Known,
    }
}

/// Lower a pipe operation
rite lower_pipe_op(ctx: &vary LoweringContext, op: !PipeOp) → !IrPipelineStep {
    ⌥ op {
        PipeOp·Transform(body) => IrPipelineStep·Morpheme {
            morpheme: MorphemeKind·Transform,
            symbol: "τ",
            body: ?Box·new(lower_expr(ctx, *body)),
        },
        PipeOp·Filter(body) => IrPipelineStep·Morpheme {
            morpheme: MorphemeKind·Filter,
            symbol: "φ",
            body: ?Box·new(lower_expr(ctx, *body)),
        },
        PipeOp·Sort(body) => IrPipelineStep·Morpheme {
            morpheme: MorphemeKind·Sort,
            symbol: "σ",
            body: ⌥ body {
                ?b => ?Box·new(lower_expr(ctx, *b)),
                null | Option·None => null,
            },
        },
        PipeOp·Reduce(body) => IrPipelineStep·Morpheme {
            morpheme: MorphemeKind·Reduce,
            symbol: "ρ",
            body: ?Box·new(lower_expr(ctx, *body)),
        },
        PipeOp·ReduceSum => IrPipelineStep·Morpheme {
            morpheme: MorphemeKind·Sum,
            symbol: "Σ",
            body: null,
        },
        PipeOp·ReduceProd => IrPipelineStep·Morpheme {
            morpheme: MorphemeKind·Product,
            symbol: "Π",
            body: null,
        },
        PipeOp·First => IrPipelineStep·Morpheme {
            morpheme: MorphemeKind·First,
            symbol: "α",
            body: null,
        },
        PipeOp·Last => IrPipelineStep·Morpheme {
            morpheme: MorphemeKind·Last,
            symbol: "ω",
            body: null,
        },
        PipeOp·Method { name, args } => IrPipelineStep·Method {
            name: name.name,
            args: args|τ{a => lower_expr(ctx, a)}|collect(),
        },
        PipeOp·Await => IrPipelineStep·Await,
        PipeOp·Send(_) | PipeOp·Recv | PipeOp·Connect(_) | PipeOp·Close => {
            IrPipelineStep·Protocol {
                operation: ⌥ op {
                    PipeOp·Send(_) => ProtocolOp·Send,
                    PipeOp·Recv => ProtocolOp·Recv,
                    PipeOp·Connect(_) => ProtocolOp·Connect,
                    PipeOp·Close => ProtocolOp·Close,
                    _ => ProtocolOp·Send,
                },
                config: null,
            }
        },
        _ => IrPipelineStep·Identity,
    }
}

// Tests removed - need interpreter support for slice methods before TDD can work
// Integration tests are in this-hosted/tests/
