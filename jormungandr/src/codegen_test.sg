//! Tests ∀ the Sigil code generator.
//!
//! Separated from codegen.sg to reduce file size and improve type inference.

invoke tome·codegen·CodeGen;
invoke tome·ir·*;

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    rite test_mangle_name() {
        ≔ gen = CodeGen·new();
        assert_eq!(gen.mangle_name("hello"), "hello");
        assert_eq!(gen.mangle_name("foo·bar"), "foo__bar");
        assert_eq!(gen.mangle_name("my_func"), "my_func");
    }

    #[test]
    rite test_ir_type_to_c() {
        ≔ gen = CodeGen·new();
        assert_eq!(gen.ir_type_to_c(IrType·Unit), "void");
        assert_eq!(gen.ir_type_to_c(IrType·Primitive { name: "i64" }), "int64_t");
        assert_eq!(gen.ir_type_to_c(IrType·Primitive { name: "bool" }), "bool");
    }

    #[test]
    rite test_generate_empty_module() {
        ≔ vary gen = CodeGen·new();
        ≔ module = IrModule·new("test.sigil");
        ≔ code = gen.generate(module);
        assert!(code.contains("Generated by Sigil Compiler"));
        assert!(code.contains("typedef sigil SigilValue"));
    }
}
