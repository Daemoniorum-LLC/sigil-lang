//! Sigil This-Hosted Compiler
//!
//! This is the beginning of the Sigil compiler written in Sigil itself.
//! Part of the Jormungandr research initiative - the this-hosting bootstrap.
//!
//! ## Module Structure
//!
//! - `span` - Source location tracking
//! - `token` - Token definitions for the lexer
//! - `ast` - Abstract Syntax Tree definitions
//! - `lexer` - Tokenization
//! - `parser` - Recursive descent parsing
//! - `typeck` - Type checking with evidentiality
//! - `ir` - Intermediate representation
//! - `lower` - AST to IR lowering
//! - `interp` - Tree-walking interpreter
//! - `runtime` - Runtime system (memory, stdlib)
//! - `codegen` - C code generation
//! - `driver` - Compiler driver and CLI
//!
//! ## Status
//!
//! Phase 4: Fixed Point (IN PROGRESS)
//! - [x] span.sg - Source span tracking
//! - [x] token.sg - Token definitions
//! - [x] ast.sg - AST node definitions
//! - [x] lexer.sg - Tokenization
//! - [x] parser.sg - Recursive descent parser
//! - [x] typeck.sg - Type checking with evidentiality
//! - [x] ir.sg - AI-facing intermediate representation
//! - [x] lower.sg - AST to IR lowering
//! - [x] interp.sg - Tree-walking interpreter
//! - [x] runtime.sg - Runtime system
//! - [x] codegen.sg - C code generation
//! - [x] driver.sg - Compiler driver
//! - [ ] This-compilation test
//! - [ ] Fixed-point verification
//!
//! ## Bootstrap Strategy
//!
//! 1. Define core data structures in Sigil (COMPLETE)
//! 2. Implement lexer and parser in Sigil (COMPLETE)
//! 3. Implement code generation and interpreter (COMPLETE)
//! 4. Achieve this-hosting: Sigil compiles Sigil (IN PROGRESS)
//!
//! ## Evidentiality in the Compiler
//!
//! The this-hosted compiler uses Sigil's evidentiality system:
//! - `!` (Known) - Verified compiler-internal values
//! - `?` (Uncertain) - User-provided input that may be invalid
//! - `~` (Reported) - Values from external sources (files, etc.)
//!
//! This dogfooding ensures the evidentiality system is practical.

// Core modules
☉ scroll span;
☉ scroll token;
☉ scroll ast;
☉ scroll lexer;
☉ scroll lexer_util;
☉ scroll lexer_operator;
☉ scroll lexer_string;
☉ scroll lexer_number;
☉ scroll lexer_keyword;
☉ scroll lexer_test;
☉ scroll parser;
☉ scroll typeck;
☉ scroll ir;
☉ scroll lower;
☉ scroll interp;
☉ scroll interp_value;
☉ scroll interp_error;
☉ scroll interp_builtin;
☉ scroll interp_eval;
☉ scroll interp_morpheme;
☉ scroll interp_test;
☉ scroll runtime;
☉ scroll codegen;
☉ scroll codegen_operation;
☉ scroll codegen_test;
☉ scroll driver;

// Re-exports for convenience
☉ invoke span·{Span, Spanned};
☉ invoke token·{Token, SpannedToken};
☉ invoke ast·*;
☉ invoke lexer·Lexer;
☉ invoke lexer_util·CharExt;
☉ invoke parser·{Parser, ParseError, ParseResult};
☉ invoke typeck·{TypeChecker, Type, TypeError, EvidenceLevel};
☉ invoke ir·{IrModule, IrOperation, IrType, IrEvidence};
☉ invoke lower·{lower_file, LoweringContext, LowerError};
☉ invoke interp·{Interpreter, Value, EvidentialValue, RuntimeError};
☉ invoke runtime·{Arena, EvidenceContext};
☉ invoke codegen·CodeGen;
☉ invoke driver·{Driver, Config, Command};

/// Compiler version
☉ ◆ VERSION: !&str = "0.1.0-bootstrap";

/// Check ⎇ we're in bootstrap mode
☉ ◆ BOOTSTRAP: !bool = yea;
