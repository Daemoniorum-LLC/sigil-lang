//! Builtin function implementations ∀ the Sigil interpreter.

invoke tome·ir·*;
invoke tome·interp_value·{Value, EvidentialValue};
invoke tome·interp_error·RuntimeError;
invoke tome·interp·Interpreter;

⊢ Interpreter {
    rite is_builtin(this, name: !&str) → !bool {
        ⌥ name {
            "print" | "println" | "input" |
            "int" | "float" | "str" | "bool" |
            "abs" | "sqrt" | "sin" | "cos" | "pow" | "floor" | "ceil" | "round" | "min" | "max" |
            "len" | "push" | "pop" | "first" | "last" | "range" |
            "assert" | "assert_eq" |
            "evidence_of" | "validate" | "verify" |
            "panic" | "todo" => yea,
            _ => nay,
        }
    }

    /// Call a built-in function
    rite call_builtin(vary this, name: !&str, args: ![EvidentialValue]) → !Result<EvidentialValue, RuntimeError> {
        ⌥ name {
            "print" => {
                each arg ∈ args {
                    this.output.push(arg.value.to_string());
                }
                Result·Ok(EvidentialValue·known(Value·Unit))
            },
            "println" => {
                each arg ∈ args {
                    this.output.push(arg.value.to_string());
                }
                this.output.push("\n");
                Result·Ok(EvidentialValue·known(Value·Unit))
            },
            "len" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("len expects 1 argument"));
                }
                ≔ val = args[0].value;
                ≔ len = ⌥ val {
                    Value·String(s) => s.len() as i64,
                    Value·Array(a) => a.len() as i64,
                    _ => ⤺ Result·Err(RuntimeError·new("len requires string or array")),
                };
                Result·Ok(EvidentialValue·known(Value·Int(len)))
            },
            "int" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("int expects 1 argument"));
                }
                ≔ val = ⌥ args[0].value {
                    Value·Int(n) => n,
                    Value·Float(f) => f as i64,
                    Value·Bool(b) => ⎇ b { 1 } ⎉ { 0 },
                    Value·String(s) => s.parse().unwrap_or(0),
                    _ => ⤺ Result·Err(RuntimeError·new("cannot convert to int")),
                };
                Result·Ok(EvidentialValue·known(Value·Int(val)))
            },
            "float" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("float expects 1 argument"));
                }
                ≔ val = ⌥ args[0].value {
                    Value·Int(n) => n as f64,
                    Value·Float(f) => f,
                    Value·String(s) => s.parse().unwrap_or(0.0),
                    _ => ⤺ Result·Err(RuntimeError·new("cannot convert to float")),
                };
                Result·Ok(EvidentialValue·known(Value·Float(val)))
            },
            "str" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("str expects 1 argument"));
                }
                Result·Ok(EvidentialValue·known(Value·String(args[0].value.to_string())))
            },
            "abs" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("abs expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Int(n) => Result·Ok(EvidentialValue·known(Value·Int(n.abs()))),
                    Value·Float(f) => Result·Ok(EvidentialValue·known(Value·Float(f.abs()))),
                    _ => Result·Err(RuntimeError·new("abs requires number")),
                }
            },
            "sqrt" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("sqrt expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Float(f) => Result·Ok(EvidentialValue·known(Value·Float(f.sqrt()))),
                    Value·Int(n) => Result·Ok(EvidentialValue·known(Value·Float((n as f64).sqrt()))),
                    _ => Result·Err(RuntimeError·new("sqrt requires number")),
                }
            },
            "sin" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("sin expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Float(f) => Result·Ok(EvidentialValue·known(Value·Float(f.sin()))),
                    Value·Int(n) => Result·Ok(EvidentialValue·known(Value·Float((n as f64).sin()))),
                    _ => Result·Err(RuntimeError·new("sin requires number")),
                }
            },
            "cos" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("cos expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Float(f) => Result·Ok(EvidentialValue·known(Value·Float(f.cos()))),
                    Value·Int(n) => Result·Ok(EvidentialValue·known(Value·Float((n as f64).cos()))),
                    _ => Result·Err(RuntimeError·new("cos requires number")),
                }
            },
            "pow" => {
                ⎇ args.len() != 2 {
                    ⤺ Result·Err(RuntimeError·new("pow expects 2 arguments"));
                }
                ≔ base = ⌥ args[0].value {
                    Value·Float(f) => f,
                    Value·Int(n) => n as f64,
                    _ => ⤺ Result·Err(RuntimeError·new("pow requires numbers")),
                };
                ≔ exp = ⌥ args[1].value {
                    Value·Float(f) => f,
                    Value·Int(n) => n as f64,
                    _ => ⤺ Result·Err(RuntimeError·new("pow requires numbers")),
                };
                Result·Ok(EvidentialValue·known(Value·Float(base.powf(exp))))
            },
            "min" => {
                ⎇ args.len() != 2 {
                    ⤺ Result·Err(RuntimeError·new("min expects 2 arguments"));
                }
                ⌥ (args[0].value, args[1].value) {
                    (Value·Int(a), Value·Int(b)) => Result·Ok(EvidentialValue·known(Value·Int(⎇ a < b { a } ⎉ { b }))),
                    (Value·Float(a), Value·Float(b)) => Result·Ok(EvidentialValue·known(Value·Float(⎇ a < b { a } ⎉ { b }))),
                    _ => Result·Err(RuntimeError·new("min requires same types")),
                }
            },
            "max" => {
                ⎇ args.len() != 2 {
                    ⤺ Result·Err(RuntimeError·new("max expects 2 arguments"));
                }
                ⌥ (args[0].value, args[1].value) {
                    (Value·Int(a), Value·Int(b)) => Result·Ok(EvidentialValue·known(Value·Int(⎇ a > b { a } ⎉ { b }))),
                    (Value·Float(a), Value·Float(b)) => Result·Ok(EvidentialValue·known(Value·Float(⎇ a > b { a } ⎉ { b }))),
                    _ => Result·Err(RuntimeError·new("max requires same types")),
                }
            },
            "range" => {
                ⎇ args.len() != 2 {
                    ⤺ Result·Err(RuntimeError·new("range expects 2 arguments"));
                }
                ⌥ (args[0].value, args[1].value) {
                    (Value·Int(start), Value·Int(end)) => {
                        ≔ arr = (start..end)|τ{n => Value·Int(n)}|collect();
                        Result·Ok(EvidentialValue·known(Value·Array(arr)))
                    },
                    _ => Result·Err(RuntimeError·new("range requires integers")),
                }
            },
            "first" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("first expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Array(arr) => ⌥ arr.first() {
                        ?v => Result·Ok(EvidentialValue·uncertain(v.clone())),
                        null | Option·None => Result·Ok(EvidentialValue·known(Value·Null)),
                    },
                    _ => Result·Err(RuntimeError·new("first requires array")),
                }
            },
            "last" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("last expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Array(arr) => ⌥ arr.last() {
                        ?v => Result·Ok(EvidentialValue·uncertain(v.clone())),
                        null | Option·None => Result·Ok(EvidentialValue·known(Value·Null)),
                    },
                    _ => Result·Err(RuntimeError·new("last requires array")),
                }
            },
            "assert" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("assert expects 1 argument"));
                }
                ⎇ !args[0].value.is_truthy() {
                    ⤺ Result·Err(RuntimeError·new("assertion failed"));
                }
                Result·Ok(EvidentialValue·known(Value·Unit))
            },
            "assert_eq" => {
                ⎇ args.len() != 2 {
                    ⤺ Result·Err(RuntimeError·new("assert_eq expects 2 arguments"));
                }
                ≔ eq = this.values_equal(args[0].value, args[1].value);
                ⎇ !eq {
                    ⤺ Result·Err(RuntimeError·new(format!(
                        "assertion failed: {} != {}",
                        args[0].value.to_string(),
                        args[1].value.to_string()
                    )));
                }
                Result·Ok(EvidentialValue·known(Value·Unit))
            },
            "evidence_of" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("evidence_of expects 1 argument"));
                }
                Result·Ok(EvidentialValue·known(Value·String(args[0].evidence.name())))
            },
            "validate" => {
                // Promote to uncertain
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("validate expects 1 argument"));
                }
                Result·Ok(EvidentialValue {
                    value: args[0].value.clone(),
                    evidence: IrEvidence·Uncertain,
                })
            },
            "verify" => {
                // Promote to known (runtime check passed)
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("verify expects 1 argument"));
                }
                Result·Ok(EvidentialValue·known(args[0].value.clone()))
            },
            "panic" => {
                ≔ msg = ⎇ args.is_empty() {
                    "explicit panic"
                } ⎉ {
                    args[0].value.to_string()
                };
                Result·Err(RuntimeError·new(format!("panic: {}", msg)))
            },
            "todo" => {
                Result·Err(RuntimeError·new("not yet implemented"))
            },
            _ => Result·Err(RuntimeError·new(format!("unknown builtin: {}", name))),
        }
    }

    /// Check value equality
}
