//! Number literal lexing for the Sigil lexer.
//!
//! Handles integers, floats, and various numeric bases (binary, hex, etc).
//! Also contains character classification helpers.

invoke tome·span·Span;
invoke tome·token·Token;
invoke tome·lexer·Lexer;

⊢ Lexer {
    rite is_digit(c: ?char) → !bool {
        ⌥ c {
            '0'..='9' => yea,
            _ => nay,
        }
    }

    /// Helper to check ⎇ a char is digit or underscore
    rite is_digit_or_underscore(c: ?char) → !bool {
        ⌥ c {
            '0'..='9' | '_' => yea,
            _ => nay,
        }
    }

    /// Helper to check ⎇ char is hex digit
    rite is_hex_digit(c: ?char) → !bool {
        ⌥ c {
            '0'..='9' | 'a'..='f' | 'A'..='F' => yea,
            _ => nay,
        }
    }

    /// Helper to check ⎇ char is hex digit or underscore
    rite is_hex_or_underscore(c: ?char) → !bool {
        ⌥ c {
            '0'..='9' | 'a'..='f' | 'A'..='F' | '_' => yea,
            _ => nay,
        }
    }

    /// Helper to check ⎇ char is vigesimal digit (0-9, a-j)
    rite is_vigesimal_or_underscore(c: ?char) → !bool {
        ⌥ c {
            '0'..='9' | 'a'..='j' | 'A'..='J' | '_' => yea,
            _ => nay,
        }
    }

    /// Helper to check ⎇ char is alphanumeric or underscore
    rite is_alnum_or_underscore(c: ?char) → !bool {
        ⌥ c {
            '0'..='9' | 'a'..='z' | 'A'..='Z' | '_' => yea,
            _ => nay,
        }
    }

    /// Helper to check ⎇ char is duodecimal digit (0-9, a-b)
    rite is_duodecimal_or_underscore(c: ?char) → !bool {
        ⌥ c {
            '0'..='9' | 'a'..='b' | 'A'..='B' | '_' => yea,
            _ => nay,
        }
    }

    /// Helper to check ⎇ char is alphabetic (basic ASCII + common Unicode letters for bootstrap)
    rite is_alpha(c: !char) → !bool {
        ⌥ c {
            'a'..='z' | 'A'..='Z' => yea,
            // Greek letters used in Sigil morphemes
            'α'..='ω' | 'Α'..='Ω' => yea,
            _ => nay,
        }
    }

    /// Helper to check ⎇ char is alphanumeric
    rite is_alphanumeric(c: ?char) → !bool {
        ⌥ c {
            '0'..='9' | 'a'..='z' | 'A'..='Z' => yea,
            _ => nay,
        }
    }

    /// Helper to check ⎇ char is alphanumeric or underscore (includes common Unicode)
    rite is_unicode_alnum_or_underscore(c: ?char) → !bool {
        ⌥ c {
            '0'..='9' | 'a'..='z' | 'A'..='Z' | '_' => yea,
            // Greek letters
            'α'..='ω' | 'Α'..='Ω' => yea,
            _ => nay,
        }
    }

    /// Lex a number (integer or float, various bases).
    rite lex_number(vary this, first: !char) → !Token {
        // Check for base prefix
        ⎇ first == '0' {
            ⌥ this.current() {
                'b' | 'B' => ⤺ this.lex_binary(),
                'o' | 'O' => ⤺ this.lex_octal(),
                'x' | 'X' => ⤺ this.lex_hex(),
                'v' | 'V' => ⤺ this.lex_vigesimal(),
                's' | 'S' => ⤺ this.lex_sexagesimal(),
                'z' | 'Z' => ⤺ this.lex_duodecimal(),
                _ => {}
            }
        }

        // Decimal integer or float
        ≔ vary value = String·new();
        value.push(first);

        // Integer part - invoke loop to avoid is_ascii_digit() method call
        forever {
            ⎇ !Lexer·is_digit_or_underscore(this.current()) {
                ⊲;
            }
            ≔ c = this.advance()!;
            // Skip underscores in output
            ⌥ c {
                '_' => {},
                _ => value.push(c),
            }
        }

        // Check for float
        ⎇ this.current() == '.' ∧ Lexer·is_digit(this.peek_char(1)) {
            value.push(this.advance()!); // '.'

            // Fractional part
            forever {
                ⎇ !Lexer·is_digit_or_underscore(this.current()) {
                    ⊲;
                }
                ≔ c = this.advance()!;
                ⌥ c {
                    '_' => {},
                    _ => value.push(c),
                }
            }

            // Exponent
            ⎇ this.current() == 'e' ∨ this.current() == 'E' {
                value.push(this.advance()!);
                ⎇ this.current() == '+' ∨ this.current() == '-' {
                    value.push(this.advance()!);
                }
                forever {
                    ⎇ !Lexer·is_digit_or_underscore(this.current()) {
                        ⊲;
                    }
                    ≔ c = this.advance()!;
                    ⌥ c {
                        '_' => {},
                        _ => value.push(c),
                    }
                }
            }

            Token·FloatLit(value)
        } ⎉ ⎇ this.current() == 'e' ∨ this.current() == 'E' {
            // Integer with exponent (e.g., 1e9) - also a float
            value.push(this.advance()!);
            ⎇ this.current() == '+' ∨ this.current() == '-' {
                value.push(this.advance()!);
            }
            forever {
                ⎇ !Lexer·is_digit_or_underscore(this.current()) {
                    ⊲;
                }
                ≔ c = this.advance()!;
                ⌥ c {
                    '_' => {},
                    _ => value.push(c),
                }
            }
            Token·FloatLit(value)
        } ⎉ {
            // Check for integer type suffix: u8, u16, u32, u64, u128, usize, i8, i16, i32, i64, i128, isize
            ⎇ this.current() == 'u' ∨ this.current() == 'i' {
                ≔ suffix_start = this.current();
                this.advance();
                // Consume the rest of the suffix
                ⟳ Lexer·is_alphanumeric(this.current()) {
                    this.advance();
                }
                // We don't need to track the suffix for parsing, just consume it
            }
            Token·IntLit(value)
        }
    }

    /// Lex binary literal (0b...).
    rite lex_binary(vary this) → !Token {
        this.advance(); // Skip 'b'
        ≔ vary value = "0b".to_string();

        ⟳ this.current() == '0' ∨ this.current() == '1' ∨ this.current() == '_' {
            ≔ c = this.advance()!;
            value.push(c);
        }

        Token·BinaryLit(value)
    }

    /// Lex octal literal (0o...).
    rite lex_octal(vary this) → !Token {
        this.advance(); // Skip 'o'
        ≔ vary value = "0o".to_string();

        ⟳ this.current() >= '0' ∧ this.current() <= '7' ∨ this.current() == '_' {
            ≔ c = this.advance()!;
            value.push(c);
        }

        Token·OctalLit(value)
    }

    /// Lex hexadecimal literal (0x...).
    rite lex_hex(vary this) → !Token {
        this.advance(); // Skip 'x'
        ≔ vary value = "0x".to_string();

        // Use loop with helper to avoid method call issues
        forever {
            ⎇ !Lexer·is_hex_or_underscore(this.current()) {
                ⊲;
            }
            ≔ c = this.advance()!;
            value.push(c);
        }

        Token·HexLit(value)
    }

    /// Lex vigesimal literal (0v..., base 20).
    rite lex_vigesimal(vary this) → !Token {
        this.advance(); // Skip 'v'
        ≔ vary value = "0v".to_string();

        // Use loop with helper to avoid method call issues
        forever {
            ⎇ !Lexer·is_vigesimal_or_underscore(this.current()) {
                ⊲;
            }
            ≔ c = this.advance()!;
            value.push(c);
        }

        Token·VigesimalLit(value)
    }

    /// Lex sexagesimal literal (0s..., base 60).
    rite lex_sexagesimal(vary this) → !Token {
        this.advance(); // Skip 's'
        ≔ vary value = "0s".to_string();

        // Use loop with helper to avoid method call issues
        forever {
            ⎇ !Lexer·is_alnum_or_underscore(this.current()) {
                ⊲;
            }
            ≔ c = this.advance()!;
            value.push(c);
        }

        Token·SexagesimalLit(value)
    }

    /// Lex duodecimal literal (0z..., base 12).
    rite lex_duodecimal(vary this) → !Token {
        this.advance(); // Skip 'z'
        ≔ vary value = "0z".to_string();

        // Use loop with helper to avoid method call issues
        forever {
            ⎇ !Lexer·is_duodecimal_or_underscore(this.current()) {
                ⊲;
            }
            ≔ c = this.advance()!;
            value.push(c);
        }

        Token·DuodecimalLit(value)
    }

    /// Lex an identifier or keyword.
}
