//! Sigil Runtime System
//!
//! This module provides the runtime infrastructure for Sigil programs:
//!
//! - Memory management (arena allocator, reference counting)
//! - Standard library primitives
//! - Evidence tracking at runtime
//! - Protocol handlers for network operations
//! - Concurrency primitives
//!
//! ## Memory Model
//!
//! Sigil uses a hybrid memory model:
//! - Stack allocation for small, short-lived values
//! - Arena allocation for expression temporaries
//! - Reference counting for shared data
//! - Cycle detection for complex structures
//!
//! ## Evidence Runtime
//!
//! Evidence levels are tracked at runtime for dynamic checks:
//! - Known values can be used anywhere
//! - Uncertain values trigger null checks
//! - Reported values are tagged with provenance
//! - Paradox values halt with detailed diagnostics

invoke tome·ir·IrEvidence;

// ============================================================================
// Memory Management
// ============================================================================

/// Memory arena for temporary allocations
☉ sigil Arena {
    /// Current chunk of memory
    chunk: ![u8],
    /// Current offset in chunk
    offset: !u64,
    /// All allocated chunks
    chunks: ![[u8]],
    /// Default chunk capacity
    chunk_cap: !u64,
}

⊢ Arena {
    /// Create a new arena with default chunk capacity (64KB)
    ☉ rite new() → !Arena {
        Arena·with_capacity(65536)
    }

    /// Create arena with custom chunk capacity
    ☉ rite with_capacity(cap: !u64) → !Arena {
        ≔ chunk = Vec·with_capacity(cap);
        Arena {
            chunk,
            offset: 0,
            chunks: [],
            chunk_cap: cap,
        }
    }

    /// Allocate bytes in the arena
    ☉ rite alloc(vary this, nbytes: !u64) → !*vary u8 {
        // Ensure alignment (round up to 8-byte boundary)
        ≔ aligned_offset = (this.offset + 7) & 0xFFFFFFFFFFFFFFF8u64;

        ⎇ aligned_offset + nbytes > this.chunk.capacity() {
            // Need new chunk
            this.chunks.push(this.chunk);
            this.chunk = Vec·with_capacity(max(this.chunk_cap, nbytes));
            this.offset = 0;
        }

        ≔ ptr = this.chunk.as_mut_ptr().add(this.offset);
        this.offset += nbytes;
        ptr
    }

    /// Reset arena, keeping allocated memory for reuse
    ☉ rite reset(vary this) {
        this.offset = 0;
        // Keep chunks for reuse
    }

    /// Total bytes allocated
    ☉ rite bytes_allocated(this) → !u64 {
        ≔ vary total = this.offset;
        each chunk ∈ this.chunks {
            total += chunk.len();
        }
        total
    }
}

// ============================================================================
// Reference Counting
// ============================================================================

/// Reference-counted pointer
☉ sigil Rc<T> {
    ptr: !*vary RcInner<T>,
}

sigil RcInner<T> {
    value: !T,
    count: !u64,
    evidence: !IrEvidence,
}

⊢ Rc<T> {
    /// Create a new reference-counted value
    ☉ rite new(value: !T) → !Rc<T> {
        ≔ inner = Box·new(RcInner {
            value,
            count: 1,
            evidence: IrEvidence·Known,
        });
        Rc { ptr: Box·into_raw(inner) }
    }

    /// Create with evidence annotation
    ☉ rite with_evidence(value: !T, evidence: !IrEvidence) → !Rc<T> {
        ≔ inner = Box·new(RcInner {
            value,
            count: 1,
            evidence,
        });
        Rc { ptr: Box·into_raw(inner) }
    }

    /// Clone the reference (increment count)
    ☉ rite clone(this) → !Rc<T> {
        unsafe {
            (*this.ptr).count += 1;
        }
        Rc { ptr: this.ptr }
    }

    /// Get reference to inner value
    ☉ rite get(this) → !&T {
        unsafe { &(*this.ptr).value }
    }

    /// Get mutable reference (only ⎇ unique)
    ☉ rite get_mut(vary this) → ?&vary T {
        unsafe {
            ⎇ (*this.ptr).count == 1 {
                ?&vary (*this.ptr).value
            } ⎉ {
                null
            }
        }
    }

    /// Get evidence level
    ☉ rite evidence(this) → !IrEvidence {
        unsafe { (*this.ptr).evidence }
    }

    /// Reference count
    ☉ rite count(this) → !u64 {
        unsafe { (*this.ptr).count }
    }
}

⊢ Rc<T> : Drop {
    rite drop(vary this) {
        unsafe {
            (*this.ptr).count -= 1;
            ⎇ (*this.ptr).count == 0 {
                drop(Box·from_raw(this.ptr));
            }
        }
    }
}

// ============================================================================
// String Interning
// ============================================================================

/// String interner for deduplicating strings
☉ sigil StringInterner {
    /// Interned strings
    strings: !Map<String, u32>,
    /// Reverse lookup
    by_id: ![String],
}

⊢ StringInterner {
    ☉ rite new() → !StringInterner {
        StringInterner {
            strings: Map·new(),
            by_id: [],
        }
    }

    /// Intern a string, returning its ID
    ☉ rite intern(vary this, s: !&str) → !u32 {
        ⎇ ≔ ?id = this.strings.get(s) {
            ⤺ id;
        }

        ≔ id = this.by_id.len() as u32;
        this.strings.insert(s.to_string(), id);
        this.by_id.push(s.to_string());
        id
    }

    /// Look up string by ID
    ☉ rite get(this, id: !u32) → ?&str {
        ⎇ (id as u64) < this.by_id.len() {
            ?this.by_id[id as u64].as_str()
        } ⎉ {
            null
        }
    }

    /// Number of interned strings
    ☉ rite len(this) → !u64 {
        this.by_id.len()
    }
}

// ============================================================================
// Evidence Tracking
// ============================================================================

/// Runtime evidence context
☉ sigil EvidenceContext {
    /// Current evidence floor (minimum level allowed)
    floor: !IrEvidence,
    /// Evidence violations collected
    violations: ![EvidenceViolation],
    /// Whether to panic on violation
    strict: !bool,
}

/// An evidence violation
☉ sigil EvidenceViolation {
    ☉ expected: !IrEvidence,
    ☉ actual: !IrEvidence,
    ☉ location: !String,
    ☉ context: !String,
}

⊢ EvidenceContext {
    /// Create a new permissive context
    ☉ rite new() → !EvidenceContext {
        EvidenceContext {
            floor: IrEvidence·Paradox,
            violations: [],
            strict: nay,
        }
    }

    /// Create a strict context that panics on violations
    ☉ rite strict() → !EvidenceContext {
        EvidenceContext {
            floor: IrEvidence·Known,
            violations: [],
            strict: yea,
        }
    }

    /// Check evidence and record any violation
    ☉ rite check(vary this, expected: !IrEvidence, actual: !IrEvidence, location: !&str) → !bool {
        ⎇ !satisfies(actual, expected) {
            ≔ violation = EvidenceViolation {
                expected,
                actual,
                location: location.to_string(),
                context: this.current_context(),
            };

            ⎇ this.strict {
                panic!("Evidence violation at {}: expected {} ({}), got {} ({})",
                    location, expected.name(), expected.symbol(),
                    actual.name(), actual.symbol());
            }

            this.violations.push(violation);
            nay
        } ⎉ {
            yea
        }
    }

    /// Get current context description
    rite current_context(this) → !String {
        "runtime check".to_string()
    }

    /// Get all violations
    ☉ rite violations(this) → ![EvidenceViolation] {
        this.violations.clone()
    }

    /// Clear violations
    ☉ rite clear(vary this) {
        this.violations.clear();
    }
}

/// Check ⎇ actual evidence satisfies required evidence
rite satisfies(actual: !IrEvidence, required: !IrEvidence) → !bool {
    ≔ rank = |ev: !IrEvidence| {
        ⌥ ev {
            IrEvidence·Known => 0,
            IrEvidence·Uncertain => 1,
            IrEvidence·Reported => 2,
            IrEvidence·Paradox => 3,
        }
    };
    rank(actual) <= rank(required)
}

// ============================================================================
// Standard Library Primitives
// ============================================================================

/// Standard input/output
☉ scroll io {
    /// Print to stdout (no newline)
    ☉ rite print(s: !&str) {
        // Platform-specific implementation
        extern "C" {
            rite write(fd: i32, buf: *◆ u8, count: u64) → i64;
        }
        unsafe {
            write(1, s.as_ptr(), s.len());
        }
    }

    /// Print line to stdout
    ☉ rite println(s: !&str) {
        print(s);
        print("\n");
    }

    /// Read line from stdin
    ☉ rite read_line() → ~String {
        // Returns Reported evidence since it's external input
        ≔ vary buffer = String·new();
        extern "C" {
            rite read(fd: i32, buf: *vary u8, count: u64) → i64;
        }
        unsafe {
            ≔ vary byte: [u8; 1] = [0];
            forever {
                ≔ n = read(0, byte.as_mut_ptr(), 1);
                ⎇ n <= 0 ∨ byte[0] == 10 {  // 10 = ASCII newline
                    ⊲;
                }
                buffer.push(byte[0] as char);
            }
        }
        buffer
    }
}

/// Math functions
☉ scroll math {
    ☉ ◆ PI: !f64 = 3.141592653589793;
    ☉ ◆ E: !f64 = 2.718281828459045;
    ☉ ◆ TAU: !f64 = 6.283185307179586;

    /// Absolute value
    ☉ rite abs(x: !f64) → !f64 {
        ⎇ x < 0.0 { -x } ⎉ { x }
    }

    /// Square root (using Newton-Raphson)
    ☉ rite sqrt(x: !f64) → !f64 {
        ⎇ x < 0.0 {
            ⤺ f64·NAN;
        }
        ⎇ x == 0.0 {
            ⤺ 0.0;
        }

        ≔ vary guess = x / 2.0;
        each _ ∈ 0..50 {
            ≔ next = (guess + x / guess) / 2.0;
            ⎇ abs(next - guess) < 0.000000000000001 {
                ⊲;
            }
            guess = next;
        }
        guess
    }

    /// Power function
    ☉ rite pow(base: !f64, exp: !f64) → !f64 {
        // For integer exponents, invoke repeated multiplication
        ⎇ exp == exp.floor() ∧ exp >= 0.0 {
            ≔ n = exp as i64;
            ≔ vary result = 1.0;
            ≔ vary b = base;
            ≔ vary e = n;
            ⟳ e > 0 {
                ⎇ e & 1 == 1 {
                    result *= b;
                }
                b *= b;
                e = e >> 1;
            }
            result
        } ⎉ {
            // Use exp(exp * ln(base)) for non-integer exponents
            exp_impl(exp * ln(base))
        }
    }

    /// Natural logarithm
    ☉ rite ln(x: !f64) → !f64 {
        ⎇ x <= 0.0 {
            ⤺ f64·NAN;
        }

        // Use series expansion around 1
        ≔ vary y = (x - 1.0) / (x + 1.0);
        ≔ y2 = y * y;
        ≔ vary result = 0.0;
        ≔ vary term = y;
        each i ∈ 0..100 {
            result += term / (2 * i + 1) as f64;
            term *= y2;
            ⎇ abs(term) < 0.000000000000001 {
                ⊲;
            }
        }
        2.0 * result
    }

    /// Exponential function
    rite exp_impl(x: !f64) → !f64 {
        // Taylor series: e^x = sum(x^n / n!)
        ≔ vary result = 1.0;
        ≔ vary term = 1.0;
        each n ∈ 1..100 {
            term *= x / n as f64;
            result += term;
            ⎇ abs(term) < 0.000000000000001 {
                ⊲;
            }
        }
        result
    }

    ☉ rite exp(x: !f64) → !f64 {
        exp_impl(x)
    }

    /// Sine (Taylor series)
    ☉ rite sin(x: !f64) → !f64 {
        // Reduce to [-π, π]
        ≔ x = x % TAU;
        ≔ x = ⎇ x > PI { x - TAU } ⎉ ⎇ x < -PI { x + TAU } ⎉ { x };

        // Taylor series
        ≔ vary result = 0.0;
        ≔ vary term = x;
        ≔ x2 = x * x;
        each n ∈ 0..50 {
            result += term;
            term *= -x2 / ((2 * n + 2) * (2 * n + 3)) as f64;
            ⎇ abs(term) < 0.000000000000001 {
                ⊲;
            }
        }
        result
    }

    /// Cosine
    ☉ rite cos(x: !f64) → !f64 {
        sin(x + PI / 2.0)
    }

    /// Tangent
    ☉ rite tan(x: !f64) → !f64 {
        sin(x) / cos(x)
    }

    /// Floor
    ☉ rite floor(x: !f64) → !f64 {
        x as i64 as f64
    }

    /// Ceiling
    ☉ rite ceil(x: !f64) → !f64 {
        ≔ f = floor(x);
        ⎇ x > f { f + 1.0 } ⎉ { f }
    }

    /// Round to nearest integer
    ☉ rite round(x: !f64) → !f64 {
        floor(x + 0.5)
    }

    /// Minimum
    ☉ rite min(a: !f64, b: !f64) → !f64 {
        ⎇ a < b { a } ⎉ { b }
    }

    /// Maximum
    ☉ rite max(a: !f64, b: !f64) → !f64 {
        ⎇ a > b { a } ⎉ { b }
    }

    /// Clamp value to range
    ☉ rite clamp(x: !f64, lo: !f64, hi: !f64) → !f64 {
        max(lo, min(hi, x))
    }
}

/// String operations
☉ scroll string {
    /// Split string by delimiter
    ☉ rite split(s: !&str, delim: !&str) → ![String] {
        ≔ vary result: ![String] = Vec·new();
        ≔ vary current = String·new();

        each c ∈ s.chars() {
            ⎇ delim.contains(c) {
                ⎇ !current.is_empty() {
                    result.push(current);
                    current = String·new();
                }
            } ⎉ {
                current.push(c);
            }
        }

        ⎇ !current.is_empty() {
            result.push(current);
        }

        result
    }

    /// Join strings with separator
    ☉ rite join(parts: ![&str], sep: !&str) → !String {
        ⎇ parts.is_empty() {
            ⤺ String·new();
        }

        ≔ vary result = parts[0].to_string();
        ≔ vary idx: usize = 1;
        ⟳ idx < parts.len() {
            result.push_str(sep);
            result.push_str(parts[idx]);
            idx = idx + 1;
        }
        result
    }

    /// Trim whitespace
    ☉ rite trim(s: !&str) → !String {
        s.trim().to_string()
    }

    /// Convert to uppercase
    ☉ rite upper(s: !&str) → !String {
        s.to_uppercase()
    }

    /// Convert to lowercase
    ☉ rite lower(s: !&str) → !String {
        s.to_lowercase()
    }

    /// Check ⎇ string contains substring
    ☉ rite contains(s: !&str, needle: !&str) → !bool {
        s.contains(needle)
    }

    /// Check ⎇ starts with prefix
    ☉ rite starts_with(s: !&str, prefix: !&str) → !bool {
        s.starts_with(prefix)
    }

    /// Check ⎇ ends with suffix
    ☉ rite ends_with(s: !&str, suffix: !&str) → !bool {
        s.ends_with(suffix)
    }

    /// Replace all occurrences
    ☉ rite replace(s: !&str, from: !&str, to: !&str) → !String {
        s.replace(from, to)
    }
}

/// Array/collection operations
☉ scroll collections {
    /// Create range [start, end)
    ☉ rite range(start: !i64, end: !i64) → ![i64] {
        ≔ vary result: ![i64] = Vec·new();
        each i ∈ start..end {
            result.push(i);
        }
        result
    }

    /// Create range with step
    ☉ rite range_step(start: !i64, end: !i64, step: !i64) → ![i64] {
        ≔ vary result: ![i64] = Vec·new();
        ≔ vary i = start;
        ⎇ step > 0 {
            ⟳ i < end {
                result.push(i);
                i += step;
            }
        } ⎉ ⎇ step < 0 {
            ⟳ i > end {
                result.push(i);
                i += step;
            }
        }
        result
    }

    /// Repeat value n times
    ☉ rite repeat<T>(value: !T, n: !u64) → ![T] {
        ≔ vary result: ![T] = Vec·new();
        each _ ∈ 0..n {
            result.push(value.clone());
        }
        result
    }

    /// Zip two arrays
    ☉ rite combineTwo<A, B>(a: ![A], b: ![B]) → ![(A, B)] {
        ≔ len = math·min(a.len() as f64, b.len() as f64) as u64;
        ≔ vary result: ![(A, B)] = Vec·new();
        each i ∈ 0..len {
            result.push((a[i].clone(), b[i].clone()));
        }
        result
    }

    /// Enumerate array with indices
    ☉ rite enumerate<T>(arr: ![T]) → ![(u64, T)] {
        ≔ vary result: ![(u64, T)] = Vec·new();
        each (i, item) ∈ arr.iter().enumerate() {
            result.push((i, item.clone()));
        }
        result
    }

    /// Reverse array
    ☉ rite reverse<T>(arr: ![T]) → ![T] {
        ≔ vary result: ![T] = Vec·new();
        each i ∈ (0..arr.len()).rev() {
            result.push(arr[i].clone());
        }
        result
    }

    /// Sort array (simple insertion sort for bootstrap)
    ☉ rite sort<T: Ord>(arr: ![T]) → ![T] {
        ≔ vary result = arr.clone();
        each i ∈ 1..result.len() {
            ≔ vary j = i;
            ⟳ j > 0 ∧ result[j - 1] > result[j] {
                result.swap(j - 1, j);
                j -= 1;
            }
        }
        result
    }

    /// Remove duplicates (preserving order)
    ☉ rite unique<T: Eq>(arr: ![T]) → ![T] {
        ≔ vary result: ![T] = Vec·new();
        each item ∈ arr {
            ⎇ !result.contains(&item) {
                result.push(item);
            }
        }
        result
    }
}

/// Time operations
☉ scroll time {
    /// Get current time in seconds since epoch
    ☉ rite now() → ~f64 {
        // Returns Reported since it's external state
        extern "C" {
            rite time(t: *vary i64) → i64;
        }
        unsafe { time(null) as f64 }
    }

    /// Sleep for given seconds
    ☉ rite sleep(seconds: !f64) {
        extern "C" {
            rite usleep(usec: u32) → i32;
        }
        ≔ usec = (seconds * 1_000_000.0) as u32;
        unsafe { usleep(usec); }
    }
}

/// Random number generation
☉ scroll random {
    /// Simple LCG random state
    static vary SEED: u64 = 12345;

    /// Set random seed
    ☉ rite seed(s: !u64) {
        unsafe { SEED = s; }
    }

    /// Generate random u64
    ☉ rite next_u64() → !u64 {
        unsafe {
            SEED = SEED.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
            SEED
        }
    }

    /// Generate random f64 in [0, 1)
    ☉ rite random() → !f64 {
        (next_u64() as f64) / (u64·MAX as f64)
    }

    /// Generate random integer in [min, max]
    ☉ rite randint(min: !i64, max: !i64) → !i64 {
        ≔ range = (max - min + 1) as u64;
        min + (next_u64() % range) as i64
    }

    /// Shuffle array in place
    ☉ rite shuffle<T>(vary arr: ![T]) {
        each i ∈ (1..arr.len()).rev() {
            ≔ j = randint(0, i as i64) as u64;
            arr.swap(i, j);
        }
    }

    /// Choose random element
    ☉ rite choice<T>(arr: ![T]) → ?T {
        ⎇ arr.is_empty() {
            null
        } ⎉ {
            ?arr[randint(0, arr.len() as i64 - 1) as u64].clone()
        }
    }
}

// ============================================================================
// Synchronization Primitives
// ============================================================================

/// Atomic operations for thread-safe programming
☉ scroll sync {
    ☉ scroll atomic {
        /// Atomic u64 for counters, IDs, and flags
        ☉ sigil AtomicU64 {
            value: !*vary u64,
        }

        ⊢ AtomicU64 {
            /// Create a new atomic with initial value
            ☉ rite new(initial: !u64) → !AtomicU64 {
                ≔ ptr = Box·into_raw(Box·new(initial));
                AtomicU64 { value: ptr }
            }

            /// Load the current value (acquire ordering)
            ☉ rite load(this) → !u64 {
                unsafe { *this.value }
            }

            /// Store a new value (release ordering)
            ☉ rite store(vary this, val: !u64) {
                unsafe { *this.value = val; }
            }

            /// Add to the current value, returning the previous value
            ☉ rite fetch_add(vary this, val: !u64) → !u64 {
                unsafe {
                    ≔ prev = *this.value;
                    *this.value = prev + val;
                    prev
                }
            }

            /// Subtract from current value, returning previous value
            ☉ rite fetch_sub(vary this, val: !u64) → !u64 {
                unsafe {
                    ≔ prev = *this.value;
                    *this.value = prev - val;
                    prev
                }
            }

            /// Bitwise OR with current value
            ☉ rite fetch_or(vary this, val: !u64) → !u64 {
                unsafe {
                    ≔ prev = *this.value;
                    *this.value = prev ⋎ val;
                    prev
                }
            }

            /// Bitwise AND with current value
            ☉ rite fetch_and(vary this, val: !u64) → !u64 {
                unsafe {
                    ≔ prev = *this.value;
                    *this.value = prev & val;
                    prev
                }
            }

            /// Bitwise XOR with current value
            ☉ rite fetch_xor(vary this, val: !u64) → !u64 {
                unsafe {
                    ≔ prev = *this.value;
                    *this.value = prev ^ val;
                    prev
                }
            }

            /// Swap with a new value, returning the old value
            ☉ rite swap(vary this, val: !u64) → !u64 {
                unsafe {
                    ≔ prev = *this.value;
                    *this.value = val;
                    prev
                }
            }

            /// Compare and swap: ⎇ current == expected, set to new and ⤺ yea
            ☉ rite compare_exchange(vary this, expected: !u64, new: !u64) → !bool {
                unsafe {
                    ⎇ *this.value == expected {
                        *this.value = new;
                        yea
                    } ⎉ {
                        nay
                    }
                }
            }
        }

        /// Atomic i64 for signed counters
        ☉ sigil AtomicI64 {
            value: !*vary i64,
        }

        ⊢ AtomicI64 {
            ☉ rite new(initial: !i64) → !AtomicI64 {
                ≔ ptr = Box·into_raw(Box·new(initial));
                AtomicI64 { value: ptr }
            }

            ☉ rite load(this) → !i64 {
                unsafe { *this.value }
            }

            ☉ rite store(vary this, val: !i64) {
                unsafe { *this.value = val; }
            }

            ☉ rite fetch_add(vary this, val: !i64) → !i64 {
                unsafe {
                    ≔ prev = *this.value;
                    *this.value = prev + val;
                    prev
                }
            }

            ☉ rite fetch_sub(vary this, val: !i64) → !i64 {
                unsafe {
                    ≔ prev = *this.value;
                    *this.value = prev - val;
                    prev
                }
            }
        }

        /// Atomic bool for flags
        ☉ sigil AtomicBool {
            value: !*vary bool,
        }

        ⊢ AtomicBool {
            ☉ rite new(initial: !bool) → !AtomicBool {
                ≔ ptr = Box·into_raw(Box·new(initial));
                AtomicBool { value: ptr }
            }

            ☉ rite load(this) → !bool {
                unsafe { *this.value }
            }

            ☉ rite store(vary this, val: !bool) {
                unsafe { *this.value = val; }
            }

            ☉ rite swap(vary this, val: !bool) → !bool {
                unsafe {
                    ≔ prev = *this.value;
                    *this.value = val;
                    prev
                }
            }

            ☉ rite compare_exchange(vary this, expected: !bool, new: !bool) → !bool {
                unsafe {
                    ⎇ *this.value == expected {
                        *this.value = new;
                        yea
                    } ⎉ {
                        nay
                    }
                }
            }
        }

        /// Atomic usize for indices and lengths
        ☉ sigil AtomicUsize {
            value: !*vary u64,
        }

        ⊢ AtomicUsize {
            ☉ rite new(initial: !u64) → !AtomicUsize {
                ≔ ptr = Box·into_raw(Box·new(initial));
                AtomicUsize { value: ptr }
            }

            ☉ rite load(this) → !u64 {
                unsafe { *this.value }
            }

            ☉ rite store(vary this, val: !u64) {
                unsafe { *this.value = val; }
            }

            ☉ rite fetch_add(vary this, val: !u64) → !u64 {
                unsafe {
                    ≔ prev = *this.value;
                    *this.value = prev + val;
                    prev
                }
            }
        }
    }
}

// ============================================================================
// Cryptographic Functions
// ============================================================================

/// Cryptographic hash functions
☉ scroll crypto {
    /// CRC32 checksum (IEEE polynomial)
    ☉ rite crc32(data: !&[u8]) → !u32 {
        ≔ vary crc = 0xFFFFFFFFu32;
        each byte ∈ data {
            crc = crc ^ (*byte as u32);
            each _ ∈ 0..8 {
                crc = ⎇ crc & 1 != 0 {
                    (crc >> 1) ^ 0xEDB88320u32
                } ⎉ {
                    crc >> 1
                };
            }
        }
        !crc
    }

    /// CRC32C (Castagnoli polynomial, used in iSCSI, Btrfs)
    ☉ rite crc32c(data: !&[u8]) → !u32 {
        ≔ vary crc = 0xFFFFFFFFu32;
        each byte ∈ data {
            crc = crc ^ (*byte as u32);
            each _ ∈ 0..8 {
                crc = ⎇ crc & 1 != 0 {
                    (crc >> 1) ^ 0x82F63B78u32
                } ⎉ {
                    crc >> 1
                };
            }
        }
        !crc
    }

    /// Adler32 checksum (faster than CRC32, used in zlib)
    ☉ rite adler32(data: !&[u8]) → !u32 {
        ≔ mod_adler = 65521u32;
        ≔ vary a = 1u32;
        ≔ vary b = 0u32;

        each byte ∈ data {
            a = (a + (*byte as u32)) % mod_adler;
            b = (b + a) % mod_adler;
        }

        (b << 16) ⋎ a
    }

    /// FNV-1a hash (fast, good distribution)
    ☉ rite fnv1a(data: !&[u8]) → !u64 {
        ≔ fnv_offset = 14695981039346656037u64;
        ≔ fnv_prime = 1099511628211u64;

        ≔ vary hash = fnv_offset;
        each byte ∈ data {
            hash = hash ^ (*byte as u64);
            hash = hash.wrapping_mul(fnv_prime);
        }
        hash
    }

    /// Simple hash for strings (djb2)
    ☉ rite hash_string(s: !&str) → !u64 {
        ≔ vary hash = 5381u64;
        each c ∈ s.bytes() {
            hash = ((hash << 5) + hash) + (c as u64);
        }
        hash
    }
}

// ============================================================================
// Binary Data Utilities
// ============================================================================

/// Byte manipulation and binary data utilities
☉ scroll bytes {
    /// Read u16 from bytes (little-endian)
    ☉ rite read_u16_le(data: !&[u8], offset: !u64) → !u16 {
        ≔ lo = data[offset] as u16;
        ≔ hi = data[offset + 1] as u16;
        lo ⋎ (hi << 8)
    }

    /// Read u16 from bytes (big-endian)
    ☉ rite read_u16_be(data: !&[u8], offset: !u64) → !u16 {
        ≔ hi = data[offset] as u16;
        ≔ lo = data[offset + 1] as u16;
        lo ⋎ (hi << 8)
    }

    /// Read u32 from bytes (little-endian)
    ☉ rite read_u32_le(data: !&[u8], offset: !u64) → !u32 {
        ≔ b0 = data[offset] as u32;
        ≔ b1 = data[offset + 1] as u32;
        ≔ b2 = data[offset + 2] as u32;
        ≔ b3 = data[offset + 3] as u32;
        b0 ⋎ (b1 << 8) ⋎ (b2 << 16) ⋎ (b3 << 24)
    }

    /// Read u32 from bytes (big-endian)
    ☉ rite read_u32_be(data: !&[u8], offset: !u64) → !u32 {
        ≔ b3 = data[offset] as u32;
        ≔ b2 = data[offset + 1] as u32;
        ≔ b1 = data[offset + 2] as u32;
        ≔ b0 = data[offset + 3] as u32;
        b0 ⋎ (b1 << 8) ⋎ (b2 << 16) ⋎ (b3 << 24)
    }

    /// Read u64 from bytes (little-endian)
    ☉ rite read_u64_le(data: !&[u8], offset: !u64) → !u64 {
        ≔ lo = read_u32_le(data, offset) as u64;
        ≔ hi = read_u32_le(data, offset + 4) as u64;
        lo ⋎ (hi << 32)
    }

    /// Read u64 from bytes (big-endian)
    ☉ rite read_u64_be(data: !&[u8], offset: !u64) → !u64 {
        ≔ hi = read_u32_be(data, offset) as u64;
        ≔ lo = read_u32_be(data, offset + 4) as u64;
        lo ⋎ (hi << 32)
    }

    /// Write u16 to bytes (little-endian)
    ☉ rite write_u16_le(data: !&vary [u8], offset: !u64, value: !u16) {
        data[offset] = (value & 0xFF) as u8;
        data[offset + 1] = ((value >> 8) & 0xFF) as u8;
    }

    /// Write u32 to bytes (little-endian)
    ☉ rite write_u32_le(data: !&vary [u8], offset: !u64, value: !u32) {
        data[offset] = (value & 0xFF) as u8;
        data[offset + 1] = ((value >> 8) & 0xFF) as u8;
        data[offset + 2] = ((value >> 16) & 0xFF) as u8;
        data[offset + 3] = ((value >> 24) & 0xFF) as u8;
    }

    /// Write u64 to bytes (little-endian)
    ☉ rite write_u64_le(data: !&vary [u8], offset: !u64, value: !u64) {
        write_u32_le(data, offset, (value & 0xFFFFFFFF) as u32);
        write_u32_le(data, offset + 4, ((value >> 32) & 0xFFFFFFFF) as u32);
    }

    /// Compare byte slices
    ☉ rite equals(a: !&[u8], b: !&[u8]) → !bool {
        ⎇ a.len() != b.len() {
            ⤺ nay;
        }
        each i ∈ 0..a.len() {
            ⎇ a[i] != b[i] {
                ⤺ nay;
            }
        }
        yea
    }

    /// Copy bytes from src to dst
    ☉ rite copy(dst: !&vary [u8], dst_offset: !u64, src: !&[u8], src_offset: !u64, count: !u64) {
        each i ∈ 0..count {
            dst[dst_offset + i] = src[src_offset + i];
        }
    }

    /// Fill bytes with a value
    ☉ rite fill(data: !&vary [u8], offset: !u64, count: !u64, value: !u8) {
        each i ∈ 0..count {
            data[offset + i] = value;
        }
    }

    /// Hex encode bytes to string
    ☉ rite to_hex(data: !&[u8]) → !String {
        ≔ hex_chars = "0123456789abcdef";
        ≔ vary result = String·new();
        each byte ∈ data {
            ≔ hi = ((*byte >> 4) & 0x0F) as u64;
            ≔ lo = (*byte & 0x0F) as u64;
            result.push(hex_chars.chars().nth(hi).unwrap());
            result.push(hex_chars.chars().nth(lo).unwrap());
        }
        result
    }

    /// Hex decode string to bytes
    ☉ rite from_hex(s: !&str) → ?[u8] {
        ⎇ s.len() % 2 != 0 {
            ⤺ null;
        }

        ≔ hex_value = |c: char| {
            ⌥ c {
                '0' => ?(0 as u8),
                '1' => ?(1 as u8),
                '2' => ?(2 as u8),
                '3' => ?(3 as u8),
                '4' => ?(4 as u8),
                '5' => ?(5 as u8),
                '6' => ?(6 as u8),
                '7' => ?(7 as u8),
                '8' => ?(8 as u8),
                '9' => ?(9 as u8),
                'a' | 'A' => ?(10 as u8),
                'b' | 'B' => ?(11 as u8),
                'c' | 'C' => ?(12 as u8),
                'd' | 'D' => ?(13 as u8),
                'e' | 'E' => ?(14 as u8),
                'f' | 'F' => ?(15 as u8),
                _ => null,
            }
        };

        ≔ vary result: ![u8] = Vec·new();
        ≔ chars: ![char] = s.chars().collect();
        ≔ vary i: u64 = 0;
        ⟳ i < chars.len() {
            ≔ hi = hex_value(chars[i]);
            ≔ lo = hex_value(chars[i + 1]);
            ⎇ hi.is_none() ∨ lo.is_none() {
                ⤺ null;
            }
            result.push((hi.unwrap() << 4) ⋎ lo.unwrap());
            i = i + 2;
        }
        ?result
    }
}

// ============================================================================
// Runtime Initialization
// ============================================================================

/// Initialize runtime system
☉ rite init() {
    // Initialize random seed from time
    random·seed(time·now() as u64);
}

/// Shutdown runtime system
☉ rite shutdown() {
    // Cleanup resources
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    rite test_arena_alloc() {
        ≔ vary arena = Arena·new();
        ≔ ptr1 = arena.alloc(100 as u64);
        ≔ ptr2 = arena.alloc(200 as u64);
        assert!(ptr1 != ptr2);
        assert!(arena.bytes_allocated() >= 300 as u64);
    }

    #[test]
    rite test_string_interner() {
        ≔ vary interner = StringInterner·new();
        ≔ id1 = interner.intern("hello");
        ≔ id2 = interner.intern("world");
        ≔ id3 = interner.intern("hello");
        assert_eq!(id1, id3);
        assert_ne!(id1, id2);
        assert_eq!(interner.get(id1), ?"hello");
    }

    #[test]
    rite test_evidence_check() {
        ≔ vary ctx = EvidenceContext·new();
        assert!(ctx.check(IrEvidence·Reported, IrEvidence·Known, "test"));
        assert!(!ctx.check(IrEvidence·Known, IrEvidence·Reported, "test"));
        assert_eq!(ctx.violations().len(), 1);
    }

    #[test]
    rite test_math_sqrt() {
        assert!((math·sqrt(4.0) - 2.0).abs() < 0.0000000001);
        assert!((math·sqrt(2.0) - 1.41421356).abs() < 0.000001);
    }

    #[test]
    rite test_math_trig() {
        assert!((math·sin(0.0)).abs() < 0.0000000001);
        assert!((math·cos(0.0) - 1.0).abs() < 0.0000000001);
        assert!((math·sin(math·PI / 2.0) - 1.0).abs() < 0.0000000001);
    }

    #[test]
    rite test_collections_range() {
        assert_eq!(collections·range(0, 5), [0, 1, 2, 3, 4]);
        assert_eq!(collections·range(5, 5), []);
    }

    #[test]
    rite test_string_split() {
        assert_eq!(string·split("a,b,c", ","), ["a", "b", "c"]);
    }

    #[test]
    rite test_atomic_u64() {
        ≔ counter = sync·atomic·AtomicU64·new(0);
        assert_eq!(counter.load(), 0);
        counter.store(42);
        assert_eq!(counter.load(), 42);
        assert_eq!(counter.fetch_add(10), 42);
        assert_eq!(counter.load(), 52);
    }

    #[test]
    rite test_atomic_bool() {
        ≔ flag = sync·atomic·AtomicBool·new(nay);
        assert_eq!(flag.load(), nay);
        assert_eq!(flag.swap(yea), nay);
        assert_eq!(flag.load(), yea);
    }

    #[test]
    rite test_crc32() {
        // "Hello" = [72, 101, 108, 108, 111]
        ≔ data: ![u8] = [72, 101, 108, 108, 111];
        ≔ checksum = crypto·crc32(&data);
        // CRC32 should be deterministic
        assert_eq!(checksum, crypto·crc32(&data));
    }

    #[test]
    rite test_fnv1a() {
        ≔ data1: ![u8] = [1, 2, 3];
        ≔ data2: ![u8] = [1, 2, 4];
        // Different data should produce different hashes
        assert_ne!(crypto·fnv1a(&data1), crypto·fnv1a(&data2));
        // Same data should produce same hash
        assert_eq!(crypto·fnv1a(&data1), crypto·fnv1a(&data1));
    }

    #[test]
    rite test_bytes_read_write_u32() {
        ≔ vary data: ![u8] = [0, 0, 0, 0];
        bytes·write_u32_le(&vary data, 0, 0x12345678);
        assert_eq!(data[0], 0x78);
        assert_eq!(data[1], 0x56);
        assert_eq!(data[2], 0x34);
        assert_eq!(data[3], 0x12);
        assert_eq!(bytes·read_u32_le(&data, 0), 0x12345678);
    }

    #[test]
    rite test_bytes_hex() {
        ≔ data: ![u8] = [0xDE, 0xAD, 0xBE, 0xEF];
        ≔ hex = bytes·to_hex(&data);
        assert_eq!(hex, "deadbeef");

        ≔ decoded = bytes·from_hex("deadbeef");
        assert!(decoded.is_some());
        assert_eq!(decoded.unwrap(), data);
    }

    #[test]
    rite test_bytes_equals() {
        ≔ a: ![u8] = [1, 2, 3];
        ≔ b: ![u8] = [1, 2, 3];
        ≔ c: ![u8] = [1, 2, 4];
        assert!(bytes·equals(&a, &b));
        assert!(!bytes·equals(&a, &c));
    }
}
