//! AI-Facing Intermediate Representation (IR)
//!
//! This module provides a JSON-serializable IR designed for consumption by
//! AI agents, language servers, and external tooling. The IR captures:
//!
//! - Function definitions with typed parameters and bodies
//! - Pipeline operations (morphemes, transformations, forks)
//! - Evidentiality annotations throughout
//! - Type information including the evidentiality lattice
//! - Control flow and data flow structures
//! - Protocol operations with their trust boundaries
//!
//! ## Design Principles
//!
//! 1. **AI-Consumable**: JSON-serializable for easy parsing by any agent
//! 2. **Evidence-Aware**: Every operation carries its evidence level
//! 3. **Pipeline-Native**: First-class representation of morpheme chains
//! 4. **Protocol-Aware**: Network operations are explicit with trust boundaries

invoke tome·span·Span;
invoke tome·typeck·EvidenceLevel;

// ============================================================================
// Version
// ============================================================================

/// The version of the IR schema
☉ ◆ IR_VERSION: !&str = "1.0.0";

// ============================================================================
// Top-Level Module
// ============================================================================

/// Top-level IR module representing a complete Sigil program
☉ sigil IrModule {
    /// Schema version
    ☉ version: !String,
    /// Source file path
    ☉ source: !String,
    /// All function definitions
    ☉ functions: ![IrFunction],
    /// Type definitions (structs, enums)
    ☉ types: ![IrTypeDef],
    /// Trait definitions
    ☉ traits: ![IrTraitDef],
    /// Impl blocks
    ☉ impls: ![IrImplBlock],
    /// Constants
    ☉ constants: ![IrConstant],
    /// The evidentiality lattice structure
    ☉ evidentiality_lattice: !EvidentialityLattice,
    /// CG-015: Method signatures for call-site lookup
    /// Maps qualified method name (e.g., "Lexer·advance") to whether it has vary this
    ☉ method_signatures: !Map<String, bool>,
}

⊢ IrModule {
    /// Create a new empty IR module
    ☉ rite new(source: !String) → !IrModule {
        IrModule {
            version: IR_VERSION,
            source,
            functions: [],
            types: [],
            traits: [],
            impls: [],
            constants: [],
            evidentiality_lattice: EvidentialityLattice·default(),
            method_signatures: Map·new(),
        }
    }

    /// Serialize to JSON string
    ☉ rite to_json(this, pretty: !bool) → !String {
        // JSON serialization - placeholder for actual implementation
        ⎇ pretty {
            this.to_json_pretty()
        } ⎉ {
            this.to_json_compact()
        }
    }

    rite to_json_pretty(this) → !String {
        // IR-JSON-FIX: Use display() to output full sigil - simpler than manual JSON
        // This will give us Rust debug output format which includes all fields
        display(this)
    }

    rite to_json_compact(this) → !String {
        // IR-JSON-FIX: Use display() for compact output too
        display(this)
    }

    /// Merge another module into this one
    /// Combines all functions, types, traits, impls, constants, and method_signatures
    ☉ rite merge(vary this, other: !IrModule) → !IrModule {
        // Merge functions
        each func ∈ other.functions {
            this.functions.push(func);
        }
        // Merge types
        each ty ∈ other.types {
            this.types.push(ty);
        }
        // Merge traits
        each tr ∈ other.traits {
            this.traits.push(tr);
        }
        // Merge impls
        each imp ∈ other.impls {
            this.impls.push(imp);
        }
        // Merge constants
        each c ∈ other.constants {
            this.constants.push(c);
        }
        // Note: method_signatures are built per-file during typechecking
        // so we don't need to merge them here (they're already in the shared checker)
        this
    }
}

// ============================================================================
// Evidentiality Lattice
// ============================================================================

/// The evidentiality lattice with explicit join/meet rules
☉ sigil EvidentialityLattice {
    /// The four evidence levels in order
    ☉ levels: ![LatticeLevel],
    /// Join rules (pessimistic combination)
    ☉ join_rules: ![LatticeRule],
    /// Meet rules (optimistic combination)
    ☉ meet_rules: ![LatticeRule],
}

⊢ EvidentialityLattice {
    /// Create the default evidentiality lattice
    ☉ rite default() → !EvidentialityLattice {
        EvidentialityLattice {
            levels: [
                LatticeLevel {
                    name: "known",
                    symbol: "!",
                    order: 0,
                    description: "Direct computation, verified",
                },
                LatticeLevel {
                    name: "uncertain",
                    symbol: "?",
                    order: 1,
                    description: "Inferred, possibly absent",
                },
                LatticeLevel {
                    name: "reported",
                    symbol: "~",
                    order: 2,
                    description: "External source, untrusted",
                },
                LatticeLevel {
                    name: "paradox",
                    symbol: "‽",
                    order: 3,
                    description: "Contradictory, trust boundary",
                },
            ],
            join_rules: [
                LatticeRule·new("known", "uncertain", "uncertain"),
                LatticeRule·new("known", "reported", "reported"),
                LatticeRule·new("known", "paradox", "paradox"),
                LatticeRule·new("uncertain", "reported", "reported"),
                LatticeRule·new("uncertain", "paradox", "paradox"),
                LatticeRule·new("reported", "paradox", "paradox"),
            ],
            meet_rules: [
                LatticeRule·new("known", "uncertain", "known"),
                LatticeRule·new("known", "reported", "known"),
                LatticeRule·new("known", "paradox", "known"),
                LatticeRule·new("uncertain", "reported", "uncertain"),
                LatticeRule·new("uncertain", "paradox", "uncertain"),
                LatticeRule·new("reported", "paradox", "reported"),
            ],
        }
    }
}

/// An evidence level in the lattice
☉ sigil LatticeLevel {
    ☉ name: !String,
    ☉ symbol: !String,
    ☉ order: !u8,
    ☉ description: !String,
}

/// A join/meet rule in the lattice
☉ sigil LatticeRule {
    ☉ left: !String,
    ☉ right: !String,
    ☉ result: !String,
}

⊢ LatticeRule {
    ☉ rite new(left: !&str, right: !&str, result: !&str) → !LatticeRule {
        LatticeRule {
            left: left.to_string(),
            right: right.to_string(),
            result: result.to_string(),
        }
    }
}

// ============================================================================
// Evidence in IR
// ============================================================================

/// Evidence marker ᛈ for IR
☉ ᛈ IrEvidence {
    Known,
    Uncertain,
    Reported,
    Paradox,
}

⊢ IrEvidence {
    /// Convert from type checker evidence level
    ☉ rite from_typeck(ev: !EvidenceLevel) → !IrEvidence {
        ⌥ ev {
            EvidenceLevel·Known => IrEvidence·Known,
            EvidenceLevel·Uncertain => IrEvidence·Uncertain,
            EvidenceLevel·Reported => IrEvidence·Reported,
            EvidenceLevel·Paradox => IrEvidence·Paradox,
        }
    }

    /// Join two evidence levels (pessimistic)
    ☉ rite join(this, other: !IrEvidence) → !IrEvidence {
        ⌥ (this, other) {
            (IrEvidence·Paradox, _) | (_, IrEvidence·Paradox) => IrEvidence·Paradox,
            (IrEvidence·Reported, _) | (_, IrEvidence·Reported) => IrEvidence·Reported,
            (IrEvidence·Uncertain, _) | (_, IrEvidence·Uncertain) => IrEvidence·Uncertain,
            (IrEvidence·Known, IrEvidence·Known) => IrEvidence·Known,
        }
    }

    /// Meet two evidence levels (optimistic)
    ☉ rite meet(this, other: !IrEvidence) → !IrEvidence {
        ⌥ (this, other) {
            (IrEvidence·Known, _) | (_, IrEvidence·Known) => IrEvidence·Known,
            (IrEvidence·Uncertain, _) | (_, IrEvidence·Uncertain) => IrEvidence·Uncertain,
            (IrEvidence·Reported, _) | (_, IrEvidence·Reported) => IrEvidence·Reported,
            (IrEvidence·Paradox, IrEvidence·Paradox) => IrEvidence·Paradox,
        }
    }

    /// Get the symbol for this evidence level
    ☉ rite symbol(this) → !&str {
        ⌥ this {
            IrEvidence·Known => "!",
            IrEvidence·Uncertain => "?",
            IrEvidence·Reported => "~",
            IrEvidence·Paradox => "‽",
        }
    }

    /// Get the name for this evidence level
    ☉ rite name(this) → !&str {
        ⌥ this {
            IrEvidence·Known => "known",
            IrEvidence·Uncertain => "uncertain",
            IrEvidence·Reported => "reported",
            IrEvidence·Paradox => "paradox",
        }
    }
}

// ============================================================================
// Source Spans
// ============================================================================

/// Source location span in IR
☉ sigil IrSpan {
    ☉ start: !IrPosition,
    ☉ end: !IrPosition,
}

☉ sigil IrPosition {
    ☉ line: !u64,
    ☉ column: !u64,
}

⊢ IrSpan {
    ☉ rite from_span(span: !Span) → !IrSpan {
        // Span uses byte offsets, so we invoke those as placeholders
        // A proper implementation would track line/column during parsing
        IrSpan {
            start: IrPosition { line: span.start, column: 0 },
            end: IrPosition { line: span.end, column: 0 },
        }
    }
}

// ============================================================================
// Visibility
// ============================================================================

/// Function/item visibility
☉ ᛈ IrVisibility {
    Public,
    Private,
    Crate,
}

⊢ IrVisibility {
    ☉ rite default() → !IrVisibility {
        IrVisibility·Private
    }
}

// ============================================================================
// Functions
// ============================================================================

/// A function definition in IR
☉ sigil IrFunction {
    /// Function name
    ☉ name: !String,
    /// Unique identifier
    ☉ id: !String,
    /// Visibility
    ☉ visibility: !IrVisibility,
    /// Generic type parameters
    ☉ generics: ![IrGenericParam],
    /// Parameters
    ☉ params: ![IrParam],
    /// Return type
    ☉ return_type: !IrType,
    /// Function body
    ☉ body: ?IrOperation,
    /// Attributes
    ☉ attributes: ![String],
    /// Whether async
    ☉ is_async: !bool,
    /// Source span
    ☉ span: ?IrSpan,
}

/// A generic type parameter
☉ sigil IrGenericParam {
    ☉ name: !String,
    ☉ bounds: ![String],
}

/// A function parameter
☉ sigil IrParam {
    ☉ name: !String,
    ☉ ty: !IrType,
    ☉ evidence: !IrEvidence,
    /// CG-015: Whether parameter is mutable (for `vary this`)
    ☉ mutable: !bool,
}

// ============================================================================
// Types
// ============================================================================

/// Type representation in IR
☉ ᛈ IrType {
    /// Primitive types (i32, f64, bool, str, etc.)
    Primitive { name: !String },

    /// Unit type ()
    Unit,

    /// Never type !
    Never,

    /// Array type [T; N]
    Array {
        element: !Box<IrType>,
        length: ?u64,
    },

    /// Slice type [T]
    Slice { element: !Box<IrType> },

    /// Tuple type (A, B, C)
    Tuple { elements: ![IrType] },

    /// Named struct/ᛈ type
    Named {
        name: !String,
        generics: ![IrType],
    },

    /// Reference &T or &vary T
    Reference {
        mutable: !bool,
        inner: !Box<IrType>,
    },

    /// Pointer *◆ T or *vary T
    Pointer {
        mutable: !bool,
        inner: !Box<IrType>,
    },

    /// Function type fn(A, B) → C
    Function {
        params: ![IrType],
        return_type: !Box<IrType>,
        is_async: !bool,
    },

    /// Evidential wrapper with evidence level
    Evidential {
        inner: !Box<IrType>,
        evidence: !IrEvidence,
    },

    /// Cyclic arithmetic type Z/nZ
    Cycle { modulus: !u64 },

    /// SIMD vector type
    Simd {
        element: !Box<IrType>,
        lanes: !u64,
    },

    /// Atomic type
    Atomic { inner: !Box<IrType> },

    /// Type variable (for inference)
    Var { id: !String },

    /// Infer placeholder _
    Infer,

    /// Error recovery type
    Error,

    /// Any type (opaque/existential - for impl Trait)
    Any,
}

⊢ IrType {
    ☉ rite unit() → !IrType {
        IrType·Unit
    }

    ☉ rite never() → !IrType {
        IrType·Never
    }

    ☉ rite bool_type() → !IrType {
        IrType·Primitive { name: "bool" }
    }

    ☉ rite i64_type() → !IrType {
        IrType·Primitive { name: "i64" }
    }

    ☉ rite f64_type() → !IrType {
        IrType·Primitive { name: "f64" }
    }

    ☉ rite str_type() → !IrType {
        IrType·Primitive { name: "str" }
    }
}

// ============================================================================
// Type Definitions
// ============================================================================

/// Type definition (struct, enum, type alias)
☉ ᛈ IrTypeDef {
    Struct {
        name: !String,
        generics: ![IrGenericParam],
        fields: ![IrField],
        span: ?IrSpan,
    },
    Enum {
        name: !String,
        generics: ![IrGenericParam],
        variants: ![IrVariant],
        span: ?IrSpan,
    },
    TypeAlias {
        name: !String,
        generics: ![IrGenericParam],
        target: !IrType,
        span: ?IrSpan,
    },
}

⊢ IrTypeDef {
    /// Get the name of this type definition
    ☉ rite get_name(this) → !String {
        ⌥ this {
            IrTypeDef·Struct { name, .. } => name,
            IrTypeDef·Enum { name, .. } => name,
            IrTypeDef·TypeAlias { name, .. } => name,
        }
    }
}

/// Free function to get type name (avoids method dispatch issues)
☉ rite ir_typedef_name(tdef: !IrTypeDef) → !String {
    ⌥ tdef {
        IrTypeDef·Struct { name, .. } => name,
        IrTypeDef·Enum { name, .. } => name,
        IrTypeDef·TypeAlias { name, .. } => name,
    }
}

/// A sigil field
☉ sigil IrField {
    ☉ name: !String,
    ☉ ty: !IrType,
    ☉ visibility: !IrVisibility,
}

/// An ᛈ variant
☉ sigil IrVariant {
    ☉ name: !String,
    ☉ fields: ?[IrField],
    ☉ discriminant: ?i64,
}

/// Trait definition
☉ sigil IrTraitDef {
    ☉ name: !String,
    ☉ generics: ![IrGenericParam],
    ☉ super_traits: ![String],
    ☉ methods: ![IrFunction],
    ☉ span: ?IrSpan,
}

/// Impl block
☉ sigil IrImplBlock {
    ☉ trait_name: ?String,
    ☉ target_type: !IrType,
    ☉ generics: ![IrGenericParam],
    ☉ methods: ![IrFunction],
    ☉ span: ?IrSpan,
}

/// Constant definition
☉ sigil IrConstant {
    ☉ name: !String,
    ☉ ty: !IrType,
    ☉ value: !IrOperation,
    ☉ visibility: !IrVisibility,
    ☉ span: ?IrSpan,
}

// ============================================================================
// Operations (Core IR Nodes)
// ============================================================================

/// Core operation node - the heart of the IR
☉ ᛈ IrOperation {
    // === Literals ===
    Literal {
        variant: !LiteralVariant,
        value: !LiteralValue,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Variables ===
    Var {
        name: !String,
        id: !String,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Bindings ===
    Let {
        pattern: !IrPattern,
        type_annotation: ?IrType,
        init: !Box<IrOperation>,
        evidence: !IrEvidence,
    },

    /// Let-else binding: ≔ pattern = init ⎉ { else_branch }
    LetElse {
        pattern: !IrPattern,
        type_annotation: ?IrType,
        init: !Box<IrOperation>,
        else_branch: !Box<IrOperation>,
        evidence: !IrEvidence,
    },

    // === Binary operations ===
    Binary {
        operator: !BinaryOp,
        left: !Box<IrOperation>,
        right: !Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Unary operations ===
    Unary {
        operator: !UnaryOp,
        operand: !Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Function calls ===
    Call {
        function: !String,
        function_id: !String,
        args: ![IrOperation],
        type_args: ![IrType],
        ty: !IrType,
        evidence: !IrEvidence,
    },

    MethodCall {
        receiver: !Box<IrOperation>,
        method: !String,
        args: ![IrOperation],
        type_args: ![IrType],
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Closures ===
    Closure {
        params: ![IrParam],
        body: !Box<IrOperation>,
        captures: ![String],
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Control flow ===
    If {
        condition: !Box<IrOperation>,
        then_branch: !Box<IrOperation>,
        else_branch: ?Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    Match {
        scrutinee: !Box<IrOperation>,
        arms: ![IrMatchArm],
        ty: !IrType,
        evidence: !IrEvidence,
    },

    /// Pattern ⌥ used as a boolean condition in if-let/while-≔ expressions.
    LetMatch {
        pattern: !IrPattern,
        value: !Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    Loop {
        variant: !LoopVariant,
        condition: ?Box<IrOperation>,
        iterator: ?IrForIterator,
        body: !Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    Break {
        value: ?Box<IrOperation>,
        evidence: !IrEvidence,
    },

    Continue {
        evidence: !IrEvidence,
    },

    Return {
        value: ?Box<IrOperation>,
        evidence: !IrEvidence,
    },

    // === Blocks ===
    Block {
        statements: ![IrOperation],
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Pipeline operations (core Sigil feature) ===
    Pipeline {
        input: !Box<IrOperation>,
        steps: ![IrPipelineStep],
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Morpheme operations ===
    Morpheme {
        morpheme: !MorphemeKind,
        symbol: !String,
        input: !Box<IrOperation>,
        body: ?Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Fork/Join ===
    Fork {
        branches: ![IrOperation],
        join_strategy: !JoinStrategy,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    Identity {
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Data structures ===
    Array {
        elements: ![IrOperation],
        ty: !IrType,
        evidence: !IrEvidence,
    },

    /// Array repeat: [value; count]
    Repeat {
        value: !Box<IrOperation>,
        count: !Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    Tuple {
        elements: ![IrOperation],
        ty: !IrType,
        evidence: !IrEvidence,
    },

    StructInit {
        name: !String,
        fields: ![(String, IrOperation)],
        rest: ?Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Field/Index access ===
    Field {
        expr: !Box<IrOperation>,
        field: !String,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    Index {
        expr: !Box<IrOperation>,
        index: !Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Assignment ===
    Assign {
        target: !Box<IrOperation>,
        value: !Box<IrOperation>,
        evidence: !IrEvidence,
    },

    // === Evidentiality operations ===
    EvidenceCoerce {
        operation: !EvidenceOp,
        expr: !Box<IrOperation>,
        from_evidence: !IrEvidence,
        to_evidence: !IrEvidence,
        ty: !IrType,
    },

    // === Incorporation (noun-verb fusion) ===
    Incorporation {
        segments: ![IncorporationSegment],
        args: ![IrOperation],
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Protocol operations ===
    HttpRequest {
        method: !HttpMethod,
        url: !Box<IrOperation>,
        headers: ?Box<IrOperation>,
        body: ?Box<IrOperation>,
        timeout_ms: ?Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    WebSocket {
        operation: !WebSocketOp,
        url: !Box<IrOperation>,
        message: ?Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Async ===
    Await {
        expr: !Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Unsafe ===
    Unsafe {
        body: !Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Cast ===
    Cast {
        expr: !Box<IrOperation>,
        target_type: !IrType,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Macro expansion ===
    MacroExpansion {
        name: !String,
        tokens: !String,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Format call (lowered format! macro) ===
    // Unlike MacroExpansion which stores raw tokens, this stores lowered arguments
    FormatCall {
        format_string: !String,
        args: ![IrOperation],
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Try (? operator) ===
    Try {
        expr: !Box<IrOperation>,
        ty: !IrType,
        evidence: !IrEvidence,
    },

    // === Range expression (a..b or a..=b) ===
    Range {
        start: ?Box<IrOperation>,
        end: ?Box<IrOperation>,
        inclusive: !bool,
        ty: !IrType,
        evidence: !IrEvidence,
    },
}

// ============================================================================
// Literal Values
// ============================================================================

/// Literal variants
☉ ᛈ LiteralVariant {
    Int,
    Float,
    Bool,
    Char,
    String,
    Null,
}

/// Literal values
☉ ᛈ LiteralValue {
    Int(!i64),
    Float(!f64),
    Bool(!bool),
    Char(!char),
    String(!String),
    Null,
}

// ============================================================================
// Operators
// ============================================================================

/// Binary operators
☉ ᛈ BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    Pow,
    And,
    Or,
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    Concat,
}

/// Unary operators
☉ ᛈ UnaryOp {
    Neg,
    Not,
    Deref,
    Ref,
    RefMut,
}

// ============================================================================
// Control Flow
// ============================================================================

/// Loop variants
☉ ᛈ LoopVariant {
    Infinite,
    While,
    For,
}

/// For loop iterator
☉ sigil IrForIterator {
    ☉ pattern: !IrPattern,
    ☉ iterable: !Box<IrOperation>,
}

/// Match arm
☉ sigil IrMatchArm {
    ☉ pattern: !IrPattern,
    ☉ guard: ?IrOperation,
    ☉ body: !IrOperation,
}

// ============================================================================
// Patterns
// ============================================================================

/// Pattern in IR
☉ ᛈ IrPattern {
    Ident {
        name: !String,
        mutable: !bool,
        by_ref: !bool,
        evidence: ?IrEvidence,
    },

    Tuple { elements: ![IrPattern] },

    Struct {
        path: !String,
        fields: ![(String, IrPattern)],
        rest: !bool,
    },

    TupleStruct {
        path: !String,
        fields: ![IrPattern],
    },

    Slice { elements: ![IrPattern] },

    Or { patterns: ![IrPattern] },

    Literal { value: !LiteralValue },

    Range {
        start: ?Box<IrPattern>,
        end: ?Box<IrPattern>,
        inclusive: !bool,
    },

    Wildcard,

    /// Path pattern for unit variants (e.g., None, MyEnum·Variant)
    Path { path: !String },

    /// Rest pattern (..)
    Rest,
}

// ============================================================================
// Pipeline Operations
// ============================================================================

/// Pipeline step
☉ ᛈ IrPipelineStep {
    Call {
        function: !String,
        args: ![IrOperation],
    },

    Morpheme {
        morpheme: !MorphemeKind,
        symbol: !String,
        body: ?Box<IrOperation>,
    },

    Fork { branches: ![IrPipelineStep] },

    Identity,

    Method {
        name: !String,
        args: ![IrOperation],
    },

    Await,

    Protocol {
        operation: !ProtocolOp,
        config: ?Box<IrOperation>,
    },
}

/// Morpheme kinds
☉ ᛈ MorphemeKind {
    Transform,  // τ
    Filter,     // φ
    Sort,       // σ
    Reduce,     // ρ
    Lambda,     // λ
    Sum,        // Σ
    Product,    // Π
    Min,
    Max,
    Concat,
    All,
    Any,
    First,      // α
    Last,       // ω
    Middle,     // μ
    Choice,     // χ
    Nth,        // ν
    Next,       // ξ
}

⊢ MorphemeKind {
    ☉ rite symbol(this) → !&str {
        ⌥ this {
            MorphemeKind·Transform => "τ",
            MorphemeKind·Filter => "φ",
            MorphemeKind·Sort => "σ",
            MorphemeKind·Reduce => "ρ",
            MorphemeKind·Lambda => "λ",
            MorphemeKind·Sum => "Σ",
            MorphemeKind·Product => "Π",
            MorphemeKind·Min => "ρ_min",
            MorphemeKind·Max => "ρ_max",
            MorphemeKind·Concat => "ρ++",
            MorphemeKind·All => "ρ&",
            MorphemeKind·Any => "ρ|",
            MorphemeKind·First => "α",
            MorphemeKind·Last => "ω",
            MorphemeKind·Middle => "μ",
            MorphemeKind·Choice => "χ",
            MorphemeKind·Nth => "ν",
            MorphemeKind·Next => "ξ",
        }
    }
}

/// Join strategy for fork operations
☉ ᛈ JoinStrategy {
    Tuple,
    First,
    All,
    Race,
}

/// Evidence operations
☉ ᛈ EvidenceOp {
    Trust,
    Verify,
    Mark,
}

/// Incorporation segment (noun-verb)
☉ ᛈ IncorporationSegment {
    Noun { name: !String },
    Verb { name: !String },
}

// ============================================================================
// Protocol Operations
// ============================================================================

/// HTTP methods
☉ ᛈ HttpMethod {
    Get,
    Post,
    Put,
    Delete,
    Patch,
    Head,
    Options,
    Connect,
    Trace,
}

/// WebSocket operations
☉ ᛈ WebSocketOp {
    Connect,
    Send,
    Receive,
    Close,
}

/// Protocol operations for pipeline
☉ ᛈ ProtocolOp {
    Send,
    Recv,
    Stream,
    Connect,
    Close,
    Timeout,
    Retry,
}

// ============================================================================
// Dump Options
// ============================================================================

/// Configuration options for IR dump
☉ sigil IrDumpOptions {
    /// Pretty-print JSON output
    ☉ pretty: !bool,
    /// Include full type information on every node
    ☉ full_types: !bool,
    /// Include source spans
    ☉ include_spans: !bool,
    /// Optimization level to apply before dumping
    ☉ opt_level: ?u8,
}

⊢ IrDumpOptions {
    ☉ rite default() → !IrDumpOptions {
        IrDumpOptions {
            pretty: nay,
            full_types: nay,
            include_spans: nay,
            opt_level: null,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    rite test_evidence_join() {
        assert_eq!(IrEvidence·Known.join(IrEvidence·Known), IrEvidence·Known);
        assert_eq!(IrEvidence·Known.join(IrEvidence·Uncertain), IrEvidence·Uncertain);
        assert_eq!(IrEvidence·Known.join(IrEvidence·Reported), IrEvidence·Reported);
        assert_eq!(IrEvidence·Known.join(IrEvidence·Paradox), IrEvidence·Paradox);
        assert_eq!(IrEvidence·Reported.join(IrEvidence·Paradox), IrEvidence·Paradox);
    }

    #[test]
    rite test_evidence_meet() {
        assert_eq!(IrEvidence·Paradox.meet(IrEvidence·Paradox), IrEvidence·Paradox);
        assert_eq!(IrEvidence·Paradox.meet(IrEvidence·Reported), IrEvidence·Reported);
        assert_eq!(IrEvidence·Paradox.meet(IrEvidence·Uncertain), IrEvidence·Uncertain);
        assert_eq!(IrEvidence·Paradox.meet(IrEvidence·Known), IrEvidence·Known);
    }

    #[test]
    rite test_ir_module_creation() {
        ≔ module = IrModule·new("test.sigil");
        assert_eq!(module.version, IR_VERSION);
        assert_eq!(module.source, "test.sigil");
    }

    #[test]
    rite test_morpheme_symbols() {
        assert_eq!(MorphemeKind·Transform.symbol(), "τ");
        assert_eq!(MorphemeKind·Filter.symbol(), "φ");
        assert_eq!(MorphemeKind·Reduce.symbol(), "ρ");
        assert_eq!(MorphemeKind·First.symbol(), "α");
        assert_eq!(MorphemeKind·Last.symbol(), "ω");
    }

    #[test]
    rite test_lattice_default() {
        ≔ lattice = EvidentialityLattice·default();
        assert_eq!(lattice.levels.len(), 4);
        assert_eq!(lattice.levels[0].name, "known");
        assert_eq!(lattice.levels[3].name, "paradox");
    }
}
