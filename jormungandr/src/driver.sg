//! Sigil Compiler Driver
//!
//! This is the main entry point for the Sigil this-hosted compiler.
//! It orchestrates the compilation pipeline:
//!
//!   Source → Lexer → Parser → TypeCheck → Lower → IR → (Interp | CodeGen)
//!
//! ## Usage
//!
//! ```
//! sigil compile input.sg -o output.c    # Generate C code
//! sigil run input.sg                     # Interpret directly
//! sigil check input.sg                   # Type check only
//! sigil dump-ir input.sg                 # Dump IR as JSON
//! sigil dump-ast input.sg                # Dump AST
//! ```
//!
//! ## This-Hosting
//!
//! This compiler can compile itself:
//!
//! ```
//! sigil compile this-hosted/src/*.sg -o sigil2.c
//! gcc sigil2.c -o sigil2
//! ./sigil2 compile this-hosted/src/*.sg -o sigil3.c
//! diff sigil2.c sigil3.c  # Should be identical (fixed point!)
//! ```

invoke tome·lexer·Lexer;
invoke tome·parser·{Parser, ParseError};
invoke tome·typeck·{TypeChecker, TypeError};
invoke tome·lower·{lower_file, LowerError};
invoke tome·ir·IrModule;
invoke tome·interp·{Interpreter, RuntimeError};
invoke tome·codegen·CodeGen;
invoke tome·span·Span;
invoke tome·ast·{SourceFile, UseTree, UseDecl, Ident, Item, Module};

// ============================================================================
// Compiler Configuration
// ============================================================================

/// Compilation mode
☉ ᛈ CompileMode {
    /// Generate C code
    Compile,
    /// Run immediately with interpreter
    Run,
    /// Type check only
    Check,
    /// Dump IR as JSON
    DumpIr,
    /// Dump AST
    DumpAst,
    /// Dump tokens
    DumpTokens,
}

/// Compiler configuration
☉ sigil Config {
    /// Input files
    ☉ input_files: ![String],
    /// Output file
    ☉ output_file: ?String,
    /// Compilation mode
    ☉ mode: !CompileMode,
    /// Enable verbose output
    ☉ verbose: !bool,
    /// Enable debug info
    ☉ debug: !bool,
    /// Optimization level (0-3)
    ☉ opt_level: !u8,
    /// Emit evidence checks at runtime
    ☉ evidence_checks: !bool,
    /// Tome search paths (directories containing tomes)
    ☉ tome_paths: ![String],
    /// Auto-resolve external tome imports
    ☉ resolve_tomes: !bool,
}

⊢ Config {
    ☉ rite default() → !Config {
        Config {
            input_files: [],
            output_file: null,
            mode: CompileMode·Compile,
            verbose: nay,
            debug: nay,
            opt_level: 0,
            evidence_checks: yea,
            tome_paths: [],
            resolve_tomes: yea,  // Auto-resolve by default
        }
    }

    /// Parse command line arguments
    ☉ rite from_args(argv: ![String]) → !Result<Config, String> {
        ≔ vary config = Config·default();
        ≔ vary expect_output = nay;

        each arg ∈ argv.iter() {
            ≔ s = arg.clone();

            ⎇ expect_output {
                config.output_file = Option·Some(s);
                expect_output = nay;
            } ⎉ ⎇ s == "compile" {
                config.mode = CompileMode·Compile;
            } ⎉ ⎇ s == "run" {
                config.mode = CompileMode·Run;
            } ⎉ ⎇ s == "check" {
                config.mode = CompileMode·Check;
            } ⎉ ⎇ s == "dump-ir" {
                config.mode = CompileMode·DumpIr;
            } ⎉ ⎇ s == "dump-ast" {
                config.mode = CompileMode·DumpAst;
            } ⎉ ⎇ s == "dump-tokens" {
                config.mode = CompileMode·DumpTokens;
            } ⎉ ⎇ s == "-o" ∨ s == "--output" {
                expect_output = yea;
            } ⎉ ⎇ s == "-v" ∨ s == "--verbose" {
                config.verbose = yea;
            } ⎉ ⎇ s == "-g" ∨ s == "--debug" {
                config.debug = yea;
            } ⎉ ⎇ s == "-O0" {
                config.opt_level = 0;
            } ⎉ ⎇ s == "-O1" {
                config.opt_level = 1;
            } ⎉ ⎇ s == "-O2" {
                config.opt_level = 2;
            } ⎉ ⎇ s == "-O3" {
                config.opt_level = 3;
            } ⎉ ⎇ s == "--no-evidence-checks" {
                config.evidence_checks = nay;
            } ⎉ ⎇ s == "--no-resolve-tomes" {
                config.resolve_tomes = nay;
            } ⎉ ⎇ s.starts_with("--tome-path=") {
                // Extract path after '='
                ≔ path = s.chars().skip(12).collect·<String>();
                config.tome_paths.push(path);
            } ⎉ ⎇ s == "-h" ∨ s == "--help" {
                ⤺ Result·Err(This·help_text());
            } ⎉ ⎇ s == "--version" {
                ⤺ Result·Err(format!("Sigil Compiler {}", tome·VERSION));
            } ⎉ ⎇ s.starts_with("-") {
                ⤺ Result·Err(format!("unknown option: {}", s));
            } ⎉ {
                config.input_files.push(s);
            }
        }

        ⎇ config.input_files.is_empty() {
            ⤺ Result·Err("no input files specified");
        }

        Result·Ok(config)
    }

    rite help_text() → !String {
        "Sigil Compiler - The Jormungandr Bootstrap\n\n" ++
        "USAGE:\n" ++
        "    sigil <command> [options] <files>\n\n" ++
        "COMMANDS:\n" ++
        "    compile     Generate C code from Sigil source\n" ++
        "    run         Execute Sigil code with interpreter\n" ++
        "    check       Type check without generating code\n" ++
        "    dump-ir     Dump IR as JSON\n" ++
        "    dump-ast    Dump parsed AST\n" ++
        "    dump-tokens Dump lexer tokens\n\n" ++
        "OPTIONS:\n" ++
        "    -o, --output <file>    Output file (default: stdout)\n" ++
        "    -v, --verbose          Verbose output\n" ++
        "    -g, --debug            Include debug information\n" ++
        "    -O0, -O1, -O2, -O3     Optimization level\n" ++
        "    --no-evidence-checks   Disable runtime evidence checks\n" ++
        "    -h, --help             Show this help\n" ++
        "    --version              Show version\n\n" ++
        "EXAMPLES:\n" ++
        "    sigil compile hello.sg -o hello.c\n" ++
        "    sigil run hello.sg\n" ++
        "    sigil check src/*.sg\n\n" ++
        "SELF-HOSTING:\n" ++
        "    sigil compile this-hosted/src/*.sg -o sigil2.c\n" ++
        "    gcc sigil2.c -o sigil2\n" ++
        "    ./sigil2 compile this-hosted/src/*.sg -o sigil3.c\n" ++
        "    diff sigil2.c sigil3.c  # Fixed point!\n"
    }
}

// ============================================================================
// Source Location Utilities
// ============================================================================

/// Line and column location in source
☉ sigil SourceLoc {
    ☉ line: !u64,
    ☉ col: !u64,
}

/// Convert byte offset to line:column given source text
/// Lines and columns are 1-indexed
rite offset_to_line_col(source: !&str, offset: !u64) → !SourceLoc {
    ≔ vary line = 1;
    ≔ vary col = 1;
    ≔ vary pos = 0;

    each c ∈ source.chars() {
        ⎇ pos >= offset {
            ⊲;
        }
        ⎇ c == '\n' {
            line = line + 1;
            col = 1;
        } ⎉ {
            col = col + 1;
        }
        pos = pos + 1;
    }

    SourceLoc { line, col }
}

// ============================================================================
// Compiler Driver
// ============================================================================

/// The main compiler driver
☉ sigil Driver {
    /// Configuration
    config: !Config,
    /// Collected errors
    errors: ![CompileError],
    /// Collected warnings
    warnings: ![CompileWarning],
}

/// Compile error
☉ sigil CompileError {
    ☉ message: !String,
    ☉ span: ?Span,
    ☉ file: ?String,
    ☉ notes: ![String],
    /// Source text for line/column calculation
    ☉ source: ?String,
}

⊢ CompileError {
    ☉ rite new(message: !String) → !CompileError {
        CompileError {
            message,
            span: null,
            file: null,
            notes: [],
            source: null,
        }
    }

    ☉ rite with_span(vary this, span: !Span) → !CompileError {
        this.span = ?span;
        this
    }

    ☉ rite with_file(vary this, file: !String) → !CompileError {
        this.file = ?file;
        this
    }

    ☉ rite with_note(vary this, note: !String) → !CompileError {
        this.notes.push(note);
        this
    }

    ☉ rite with_source(vary this, source: !String) → !CompileError {
        this.source = ?source;
        this
    }

    ☉ rite display(this) → !String {
        ≔ vary result = String·new();

        // Error header
        result.push_str("error: ");
        result.push_str(this.message);
        result.push('\n');

        // Location
        ⎇ ≔ ?file = this.file {
            result.push_str("  --> ");
            result.push_str(file);
            ⎇ ≔ ?span = this.span {
                // Convert byte offset to line:column ⎇ source is available
                ⎇ ≔ ?src = this.source {
                    ≔ loc = offset_to_line_col(src, span.start);
                    result.push_str(format!(":{}:{}", loc.line, loc.col));
                } ⎉ {
                    // Fallback to byte offsets
                    result.push_str(format!(":{}", span.start));
                }
            }
            result.push('\n');
        }

        // Notes
        each note ∈ this.notes {
            result.push_str("  note: ");
            result.push_str(note);
            result.push('\n');
        }

        result
    }
}

/// Compile warning
☉ sigil CompileWarning {
    ☉ message: !String,
    ☉ span: ?Span,
    ☉ file: ?String,
}

// ============================================================================
// Tome Resolution
// ============================================================================

/// Extract tome names from a UseTree
rite extract_tome_names(tree: !UseTree) → ![String] {
    ≔ vary names: ![String] = Vec·new();
    ⌥ tree {
        UseTree·Path { prefix, suffix } => {
            // The first segment is the tome name
            ≔ tome_name = prefix.name.clone();
            // Skip "crate", "this", "super", "tome" - these are local references
            ⎇ tome_name != "crate" ∧ tome_name != "this" ∧ tome_name != "super" ∧ tome_name != "tome" {
                names.push(tome_name);
            }
        },
        UseTree·Name(ident) => {
            // Single name import - could be a tome
            ≔ tome_name = ident.name.clone();
            ⎇ tome_name != "crate" ∧ tome_name != "this" ∧ tome_name != "super" ∧ tome_name != "tome" {
                names.push(tome_name);
            }
        },
        UseTree·Group(trees) => {
            // Group import - recurse
            each t ∈ trees.iter() {
                ≔ sub_names = extract_tome_names(t.clone());
                each n ∈ sub_names.iter() {
                    names.push(n.clone());
                }
            }
        },
        _ => {},
    }
    names
}

/// Find tome source file by name in search paths
rite find_tome_source(tome_name: !String, search_paths: ![String]) → ?String {
    each path ∈ search_paths.iter() {
        // Try <path>/<tome_name>/src/lib.sg
        ≔ lib_path = format!("{}/{}/src/lib.sg", path, tome_name);
        // We can't easily check ⎇ file exists in pure Sigil, so just ⤺ the path
        // The compiler will error later ⎇ it doesn't exist
        ⤺ ?lib_path;
    }
    null
}

/// Infer tome search path from input file
rite infer_tome_path(input_file: !String) → ?String {
    // If input is /path/to/mytome/src/lib.sg, search path is /path/to
    // Look for "/src/" in the path and go two levels up
    ≔ vary chars: ![char] = Vec·new();
    each c ∈ input_file.chars() {
        chars.push(c);
    }

    // Find last occurrence of "/src/"
    ≔ vary last_src_pos = null;
    ≔ vary i = 0;
    ⟳ i + 4 < chars.len() {
        ⎇ chars[i] == '/' ∧ chars[i+1] == 's' ∧ chars[i+2] == 'r' ∧ chars[i+3] == 'c' ∧ chars[i+4] == '/' {
            last_src_pos = Option·Some(i);
        }
        i = i + 1;
    }

    ⌥ last_src_pos {
        Option·Some(pos) => {
            // Find the slash before /src/
            ≔ vary j = pos - 1;
            ⟳ j >= 0 {
                ⎇ chars[j] == '/' {
                    // Return path up to this point
                    ≔ vary result = String·new();
                    ≔ vary k = 0;
                    ⟳ k < j {
                        result.push(chars[k]);
                        k = k + 1;
                    }
                    ⤺ ?result;
                }
                j = j - 1;
            }
            null
        },
        null | Option·None => null,
    }
}

⊢ Driver {
    /// Create a new driver with configuration
    ☉ rite new(config: !Config) → !Driver {
        Driver {
            config,
            errors: [],
            warnings: [],
        }
    }

    /// Run the compiler
    ☉ rite run(vary this) → !Result<(), i32> {
        ⌥ this.config.mode {
            CompileMode·Compile => this.compile(),
            CompileMode·Run => this.interpret(),
            CompileMode·Check => this.check(),
            CompileMode·DumpIr => this.dump_ir(),
            CompileMode·DumpAst => this.dump_ast(),
            CompileMode·DumpTokens => this.dump_tokens(),
        }
    }

    /// Resolve tome imports from AST and ⤺ additional files to compile
    rite resolve_tome_imports(vary this, asts: ![SourceFile], file_paths: ![String]) → ![String] {
        ≔ vary additional_files: ![String] = Vec·new();
        ≔ vary resolved_tomes: ![String] = Vec·new();  // Track which tomes we've already resolved
        ≔ vary local_modules: ![String] = Vec·new();   // Track locally defined modules

        // First pass: collect all locally defined module names
        // This prevents us from trying to resolve `invoke span·...` when `scroll span;` is local
        each ast ∈ asts.iter() {
            each item ∈ ast.items.iter() {
                ⌥ item.node {
                    Item·Module(mod_def) => {
                        local_modules.push(mod_def.name.name.clone());
                    },
                    _ => {},
                }
            }
        }

        // Build search paths
        ≔ vary search_paths = this.config.tome_paths.clone();

        // Infer search path from input files
        each fp ∈ file_paths.iter() {
            ⌥ infer_tome_path(fp.clone()) {
                ?path => {
                    // Check ⎇ already in search paths
                    ≔ vary found = nay;
                    each sp ∈ search_paths.iter() {
                        ⎇ sp == path {
                            found = yea;
                        }
                    }
                    ⎇ !found {
                        search_paths.push(path);
                    }
                },
                null | Option·None => {},
            }
        }

        ⎇ this.config.verbose ∧ search_paths.len() > 0 {
            println("  Tome search paths:");
            each sp ∈ search_paths.iter() {
                println(format!("    - {}", sp));
            }
        }

        // Scan all ASTs for use/invoke declarations
        each ast ∈ asts.iter() {
            each item ∈ ast.items.iter() {
                ⌥ item.node {
                    Item·Use(decl) => {
                        ≔ tome_names = extract_tome_names(decl.tree.clone());
                        each tome_name ∈ tome_names.iter() {
                            // Skip local modules - they're not external tomes
                            ≔ vary is_local = nay;
                            each lm ∈ local_modules.iter() {
                                ⎇ lm == tome_name {
                                    is_local = yea;
                                }
                            }
                            ⎇ is_local {
                                ⊳;
                            }

                            // Skip well-known stdlib modules that aren't real tomes
                            ⎇ tome_name == "std" {
                                ⊳;
                            }

                            // Check ⎇ already resolved
                            ≔ vary already_resolved = nay;
                            each rt ∈ resolved_tomes.iter() {
                                ⎇ rt == tome_name {
                                    already_resolved = yea;
                                }
                            }
                            ⎇ !already_resolved {
                                resolved_tomes.push(tome_name.clone());
                                ⌥ find_tome_source(tome_name.clone(), search_paths.clone()) {
                                    ?tome_file => {
                                        // Check ⎇ not already in input files
                                        ≔ vary in_inputs = nay;
                                        each fp ∈ file_paths.iter() {
                                            ⎇ fp == tome_file {
                                                in_inputs = yea;
                                            }
                                        }
                                        ⎇ !in_inputs {
                                            ⎇ this.config.verbose {
                                                println(format!("  Resolved tome '{}' → {}", tome_name, tome_file));
                                            }
                                            additional_files.push(tome_file);
                                        }
                                    },
                                    null | Option·None => {
                                        ⎇ this.config.verbose {
                                            println(format!("  Warning: Could not resolve tome '{}'", tome_name));
                                        }
                                    },
                                }
                            }
                        }
                    },
                    _ => {},
                }
            }
        }

        additional_files
    }

    /// Compile to C code
    ///
    /// Uses multi-file compilation to support cross-module references:
    /// 0. (Optional) Resolve external tome imports
    /// 1. Parse ALL input files first
    /// 2. Build a unified type environment from ALL files
    /// 3. Type check and lower each file using the shared environment
    rite compile(vary this) → !Result<(), i32> {
        ⎇ this.config.verbose {
            println("Sigil Compiler - Jormungandr Bootstrap");
            ≔ file_count = this.config.input_files.len();
            println(format!("Compiling {} file(s)...", file_count));
        }

        // ================================================================
        // Phase 1: Parse ALL files first (including resolved tomes)
        // ================================================================
        ≔ vary file_paths: ![String] = Vec·new();
        ≔ vary asts: ![SourceFile] = Vec·new();

        ≔ vary i = 0;
        ⟳ i < this.config.input_files.len() {
            ≔ file_path = this.config.input_files[i].clone();
            ⎇ this.config.verbose {
                println(format!("  Parsing: {}", file_path));
            }

            ≔ source = ⌥ this.read_file(file_path.clone()) {
                Result·Ok(s) => s,
                Result·Err(code) => {
                    this.print_errors();
                    ⤺ Result·Err(code);
                },
            };
            ≔ ast = ⌥ this.parse(file_path.clone(), source) {
                Result·Ok(a) => a,
                Result·Err(code) => {
                    this.print_errors();
                    ⤺ Result·Err(code);
                },
            };
            file_paths.push(file_path);
            asts.push(ast);
            i = i + 1;
        }

        // ================================================================
        // Phase 1.5: Resolve external tome imports (iterative)
        // ================================================================
        ⎇ this.config.resolve_tomes {
            ≔ vary iteration = 0;
            ≔ max_iterations = 10;  // Prevent infinite loops

            ⟳ iteration < max_iterations {
                ≔ additional_files = this.resolve_tome_imports(asts.clone(), file_paths.clone());

                ⎇ additional_files.is_empty() {
                    ⊲;  // No more tomes to resolve
                }

                // Parse additional files
                each additional_path ∈ additional_files.iter() {
                    ⎇ this.config.verbose {
                        println(format!("  Parsing tome: {}", additional_path));
                    }

                    ≔ source = ⌥ this.read_file(additional_path.clone()) {
                        Result·Ok(s) => s,
                        Result·Err(_code) => {
                            // File doesn't exist - skip silently for now
                            // This handles the case where tome paths are guessed but don't exist
                            ⊳;
                        },
                    };

                    ≔ ast = ⌥ this.parse(additional_path.clone(), source) {
                        Result·Ok(a) => a,
                        Result·Err(code) => {
                            this.print_errors();
                            ⤺ Result·Err(code);
                        },
                    };

                    file_paths.push(additional_path.clone());
                    asts.push(ast);
                }

                iteration = iteration + 1;
            }
        }

        // ================================================================
        // Phase 2: Build unified type environment from ALL files
        // ================================================================
        ⎇ this.config.verbose {
            println("  Building unified type environment...");
        }

        ≔ vary checker = TypeChecker·new();

        // Pass 1: Collect type definitions from ALL files
        ≔ vary j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.collect_type_def(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }

        // Pass 2: Collect function signatures from ALL files
        j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.collect_fn_sig(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }

        // Pass 3: Check items in ALL files (with complete type environment)
        j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.check_item(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }

        // ================================================================
        // Phase 3: Lower each file using the shared type checker
        // ================================================================
        ≔ vary modules: ![IrModule] = Vec·new();

        j = 0;
        ⟳ j < asts.len() {
            ≔ file_path = file_paths[j].clone();
            ≔ ast = asts[j].clone();

            ⎇ this.config.verbose {
                println(format!("  Lowering: {}", file_path));
            }

            // Lower to IR using the shared checker
            ⌥ lower_file(ast, checker.clone(), file_path.clone()) {
                Result·Ok(ir) => modules.push(ir),
                Result·Err(errs) => {
                    each err ∈ errs {
                        this.errors.push(CompileError·new(err.message)
                            .with_file(file_path.clone()));
                    }
                    this.print_errors();
                    ⤺ Result·Err(1);
                },
            };
            j = j + 1;
        }

        // Merge all modules into one unified module
        // NOTE: Type deduplication happens at codegen time using #ifndef guards
        ≔ main_module = ⎇ !modules.is_empty() {
            ≔ vary merged = modules[0].clone();
            // Append functions/types from other modules
            ≔ vary idx = 1;
            ⟳ idx < modules.len() {
                ≔ other = modules[idx].clone();
                // Merge functions (deduplicate by name)
                ≔ vary fi = 0;
                ⟳ fi < other.functions.len() {
                    ≔ func = other.functions[fi].clone();
                    // Check ⎇ function already exists in merged
                    ≔ vary exists = nay;
                    ≔ vary check_idx = 0;
                    ⟳ check_idx < merged.functions.len() {
                        ⎇ merged.functions[check_idx].name == func.name {
                            exists = yea;
                        }
                        check_idx = check_idx + 1;
                    }
                    ⎇ !exists {
                        merged.functions.push(func);
                    }
                    fi = fi + 1;
                }
                // Merge types (duplicates will be handled by codegen with #ifndef)
                ≔ vary ti = 0;
                ⟳ ti < other.types.len() {
                    merged.types.push(other.types[ti].clone());
                    ti = ti + 1;
                }
                // Merge traits
                ≔ vary tri = 0;
                ⟳ tri < other.traits.len() {
                    merged.traits.push(other.traits[tri].clone());
                    tri = tri + 1;
                }
                // Merge impls
                ≔ vary ii = 0;
                ⟳ ii < other.impls.len() {
                    merged.impls.push(other.impls[ii].clone());
                    ii = ii + 1;
                }
                // Merge constants
                ≔ vary ci = 0;
                ⟳ ci < other.constants.len() {
                    merged.constants.push(other.constants[ci].clone());
                    ci = ci + 1;
                }
                idx = idx + 1;
            }
            merged
        } ⎉ {
            ⤺ Result·Err(1);
        };

        // ================================================================
        // Phase 4: Generate C code
        // ================================================================
        ⎇ this.config.verbose {
            println("  Generating C code...");
        }

        ≔ vary codegen = CodeGen·new();
        ≔ c_code = codegen.generate(main_module);

        // Write output
        ⎇ this.config.output_file.is_some() {
            ≔ output = this.config.output_file.unwrap();
            ⌥ this.write_file(output, c_code) {
                Result·Ok(_) => {},
                Result·Err(code) => {
                    this.print_errors();
                    ⤺ Result·Err(code);
                },
            };
            ⎇ this.config.verbose {
                println(format!("  Wrote: {}", output));
            }
        } ⎉ {
            print(c_code);
        }

        ⎇ this.config.verbose {
            println("Done!");
        }

        ⎇ this.errors.is_empty() {
            Result·Ok(())
        } ⎉ {
            this.print_errors();
            Result·Err(1)
        }
    }

    /// Run with interpreter
    ///
    /// Uses multi-file compilation for cross-module support.
    rite interpret(vary this) → !Result<(), i32> {
        ⎇ this.config.verbose {
            println("Sigil Interpreter - Jormungandr Bootstrap");
        }

        // Phase 1: Parse ALL files first
        ≔ vary file_paths: ![String] = Vec·new();
        ≔ vary asts: ![SourceFile] = Vec·new();

        ≔ vary i = 0;
        ⟳ i < this.config.input_files.len() {
            ≔ file_path = this.config.input_files[i].clone();
            ≔ source = ⌥ this.read_file(file_path.clone()) {
                Result·Ok(s) => s,
                Result·Err(code) => {
                    this.print_errors();
                    ⤺ Result·Err(code);
                },
            };
            ≔ ast = ⌥ this.parse(file_path.clone(), source) {
                Result·Ok(a) => a,
                Result·Err(code) => {
                    this.print_errors();
                    ⤺ Result·Err(code);
                },
            };
            file_paths.push(file_path);
            asts.push(ast);
            i = i + 1;
        }

        // Phase 2: Build unified type environment
        ≔ vary checker = TypeChecker·new();

        ≔ vary j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.collect_type_def(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }
        j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.collect_fn_sig(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }
        j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.check_item(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }

        // Phase 3: Lower and load modules
        ≔ vary interpreter = Interpreter·new();

        j = 0;
        ⟳ j < asts.len() {
            ≔ file_path = file_paths[j].clone();
            ≔ ast = asts[j].clone();
            ⌥ lower_file(ast, checker.clone(), file_path.clone()) {
                Result·Ok(ir) => interpreter.load_module(ir),
                Result·Err(errs) => {
                    each err ∈ errs {
                        this.errors.push(CompileError·new(err.message)
                            .with_file(file_path.clone()));
                    }
                    this.print_errors();
                    ⤺ Result·Err(1);
                },
            };
            j = j + 1;
        }

        // Run main
        ⌥ interpreter.run() {
            Result·Ok(result) => {
                ⎇ this.config.verbose {
                    println(format!("Result: {}", result.value.to_string()));
                }
                Result·Ok(())
            },
            Result·Err(err) => {
                this.errors.push(CompileError·new(format!("runtime error: {}", err.message)));
                this.print_errors();
                Result·Err(1)
            },
        }
    }

    /// Type check only
    ///
    /// Uses multi-file type checking for cross-module support.
    rite check(vary this) → !Result<(), i32> {
        ⎇ this.config.verbose {
            println("Sigil Type Checker");
        }

        // Phase 1: Parse ALL files first
        ≔ vary file_paths: ![String] = Vec·new();
        ≔ vary asts: ![SourceFile] = Vec·new();

        ≔ vary i = 0;
        ⟳ i < this.config.input_files.len() {
            ≔ file_path = this.config.input_files[i].clone();
            ≔ source = ⌥ this.read_file(file_path.clone()) {
                Result·Ok(s) => s,
                Result·Err(code) => {
                    this.print_errors();
                    ⤺ Result·Err(code);
                },
            };
            ≔ ast = ⌥ this.parse(file_path.clone(), source) {
                Result·Ok(a) => a,
                Result·Err(code) => {
                    this.print_errors();
                    ⤺ Result·Err(code);
                },
            };
            file_paths.push(file_path);
            asts.push(ast);
            i = i + 1;
        }

        // Phase 2: Build unified type environment and check
        ≔ vary checker = TypeChecker·new();

        // Pass 1: Collect type definitions from ALL files
        ≔ vary j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.collect_type_def(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }

        // Pass 2: Collect function signatures from ALL files
        j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.collect_fn_sig(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }

        // Pass 3: Check items in ALL files
        j = 0;
        ⟳ j < asts.len() {
            ⎇ this.config.verbose {
                ≔ fp = file_paths[j].clone();
                println(format!("  Checking: {}", fp));
            }
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.check_item(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }

        ⎇ this.errors.is_empty() {
            println("All files type check successfully!");
            Result·Ok(())
        } ⎉ {
            this.print_errors();
            Result·Err(1)
        }
    }

    /// Dump IR as JSON
    ///
    /// Uses multi-file compilation for cross-module support.
    rite dump_ir(vary this) → !Result<(), i32> {
        // Phase 1: Parse ALL files first
        ≔ vary file_paths: ![String] = Vec·new();
        ≔ vary asts: ![SourceFile] = Vec·new();

        ≔ vary i = 0;
        ⟳ i < this.config.input_files.len() {
            ≔ file_path = this.config.input_files[i].clone();
            ≔ source = ⌥ this.read_file(file_path.clone()) {
                Result·Ok(s) => s,
                Result·Err(code) => {
                    this.print_errors();
                    ⤺ Result·Err(code);
                },
            };
            ≔ ast = ⌥ this.parse(file_path.clone(), source) {
                Result·Ok(a) => a,
                Result·Err(code) => {
                    this.print_errors();
                    ⤺ Result·Err(code);
                },
            };
            file_paths.push(file_path);
            asts.push(ast);
            i = i + 1;
        }

        // Phase 2: Build unified type environment
        ≔ vary checker = TypeChecker·new();

        ≔ vary j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.collect_type_def(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }
        j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.collect_fn_sig(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }
        j = 0;
        ⟳ j < asts.len() {
            ≔ vary k = 0;
            ⟳ k < asts[j].items.len() {
                checker.check_item(asts[j].items[k].node.clone());
                k = k + 1;
            }
            j = j + 1;
        }

        // Phase 3: Lower and dump IR
        j = 0;
        ⟳ j < asts.len() {
            ≔ file_path = file_paths[j].clone();
            ≔ ast = asts[j].clone();
            ⌥ lower_file(ast, checker.clone(), file_path.clone()) {
                Result·Ok(ir) => {
                    ≔ json = ir.to_json(yea);
                    ⌥ this.config.output_file {
                        ?output => {
                            ⌥ this.write_file(output, json) {
                                Result·Ok(_) => {},
                                Result·Err(code) => ⤺ Result·Err(code),
                            };
                        },
                        null | Option·None => println(json),
                    }
                },
                Result·Err(errs) => {
                    each err ∈ errs {
                        this.errors.push(CompileError·new(err.message)
                            .with_file(file_path.clone()));
                    }
                    this.print_errors();
                    ⤺ Result·Err(1);
                },
            };
            j = j + 1;
        }
        Result·Ok(())
    }

    /// Dump AST
    rite dump_ast(vary this) → !Result<(), i32> {
        each file_path ∈ this.config.input_files {
            ≔ source = this.read_file(file_path)?;
            ≔ ast = this.parse(file_path, source)?;

            println(format!("=== AST for {} ===", file_path));
            println(format!("Items: {}", ast.items.len()));
            each item ∈ ast.items {
                    ≔ name = item.node.kind_name();
                println(format!("  - {}", name));
            }
        }
        Result·Ok(())
    }

    /// Dump tokens
    rite dump_tokens(vary this) → !Result<(), i32> {
        each file_path ∈ this.config.input_files {
            ≔ source = this.read_file(file_path)?;

            println(format!("=== Tokens for {} ===", file_path));
            ≔ vary lexer = Lexer·new(source);

            forever {
                ⌥ lexer.next_token() {
                    ?(tok, span) => {
                        println(format!("  {:?} @ {:?}", tok, span));
                    },
                    null | Option·None => ⊲,
                }
            }
        }
        Result·Ok(())
    }

    // ========================================================================
    // Pipeline Stages
    // ========================================================================

    /// Read a source file
    rite read_file(vary this, path: !&str) → !Result<String, i32> {
        // In a real implementation, this would read from the filesystem
        // For now, we'll invoke a placeholder
        extern "C" {
            rite sigil_read_file(path: *◆ u8, len: u64) → *vary u8;
            rite sigil_file_len() → u64;
        }

        unsafe {
            ≔ content_ptr = sigil_read_file(path.as_ptr(), path.len());
            ⎇ content_ptr.is_null() {
                this.errors.push(CompileError·new(format!("cannot read file: {}", path)));
                ⤺ Result·Err(1);
            }
            ≔ len = sigil_file_len();
            ≔ content = String·from_raw_parts(content_ptr, len, len);
            Result·Ok(content)
        }
    }

    /// Write output file
    rite write_file(vary this, path: !&str, content: !String) → !Result<(), i32> {
        extern "C" {
            rite sigil_write_file(path: *◆ u8, path_len: u64,
                               content: *◆ u8, content_len: u64) → bool;
        }

        unsafe {
            ≔ ok = sigil_write_file(
                path.as_ptr(), path.len(),
                content.as_ptr(), content.len()
            );
            ⎇ !ok {
                this.errors.push(CompileError·new(format!("cannot write file: {}", path)));
                ⤺ Result·Err(1);
            }
        }
        Result·Ok(())
    }

    /// Parse source code
    rite parse(vary this, file: !&str, source: !String) → !Result<SourceFile, i32> {
        ≔ vary parser = Parser·new(source.clone());

        ⌥ parser.parse_file() {
            Result·Ok(ast) => Result·Ok(ast),
            Result·Err(err) => {
                ≔ vary compile_err = CompileError·new(err.message());
                compile_err = compile_err.with_file(file.to_string());
                compile_err = compile_err.with_source(source);
                // Add span ⎇ available
                ⎇ ≔ ?span = err.span() {
                    compile_err = compile_err.with_span(span);
                }
                this.errors.push(compile_err);
                Result·Err(1)
            },
        }
    }

    /// Lower AST to IR
    rite lower(vary this, file: !&str, ast: !SourceFile) → !Result<IrModule, i32> {
        // Type check first
        ≔ vary checker = TypeChecker·new();
        ⌥ checker.check_file(ast.clone()) {
            Result·Ok(_) => {},
            Result·Err(errs) => {
                each err ∈ errs {
                    eprintln(format!("Type error: {}", err.message));
                    this.errors.push(CompileError·new(err.message)
                        .with_file(file.to_string()));
                }
                ⤺ Result·Err(1);
            },
        }

        // Lower to IR
        ⌥ lower_file(ast, checker, file.to_string()) {
            Result·Ok(ir) => Result·Ok(ir),
            Result·Err(errs) => {
                each err ∈ errs {
                    this.errors.push(CompileError·new(err.message)
                        .with_file(file.to_string()));
                }
                Result·Err(1)
            },
        }
    }

    /// Print collected errors
    rite print_errors(this) {
        each err ∈ this.errors {
            eprint(err.display());
        }
        eprintln("");
        ≔ error_count = this.errors.len();
        eprintln(format!("{} error(s) found", error_count));
    }
}

// ============================================================================
// Main Entry Point
// ============================================================================

/// Main entry point for the compiler
☉ rite main(args: ![String]) → !i32 {
    println("Jormungandr compiler starting...");
    // Parse configuration
    ≔ config = ⌥ Config·from_args(args) {
        Result·Ok(c) => c,
        Result·Err(msg) => {
            eprintln(msg);
            ⤺ 1;
        },
    };

    // Run compiler
    ≔ vary driver = Driver·new(config);
    ⌥ driver.run() {
        Result·Ok(_) => 0,
        Result·Err(code) => code,
    }
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Print functions - implemented in runtime (build.sh header)
extern "C" {
    rite print(s: !&str);
    rite println(s: !&str);
    rite eprint(s: !&str);
    rite eprintln(s: !&str);
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    rite test_config_parse_compile() {
        ≔ args = ["compile", "test.sg", "-o", "test.c"];
        ≔ config = Config·from_args(args).unwrap();
        ≔ is_compile = ⌥ config.mode { CompileMode·Compile => yea, _ => nay };
        assert!(is_compile);
        assert_eq!(config.input_files, ["test.sg"]);
        assert_eq!(config.output_file, ?"test.c");
    }

    #[test]
    rite test_config_parse_run() {
        ≔ args = ["run", "test.sg"];
        ≔ config = Config·from_args(args).unwrap();
        ≔ is_run = ⌥ config.mode { CompileMode·Run => yea, _ => nay };
        assert!(is_run);
    }

    #[test]
    rite test_config_verbose() {
        ≔ args = ["check", "-v", "test.sg"];
        ≔ config = Config·from_args(args).unwrap();
        assert!(config.verbose);
    }

    #[test]
    rite test_error_display() {
        ≔ err = CompileError·new("type mismatch")
            .with_file("test.sg")
            .with_note("expected i64, found string");

        ≔ display = err.display();
        assert!(display.contains("type mismatch"));
        assert!(display.contains("test.sg"));
        assert!(display.contains("expected i64"));
    }
}
