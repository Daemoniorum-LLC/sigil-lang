    rite emit_value_constructors(vary this) {
        // Unit
        this.line("static inline SigilValue sigil_unit(void) {");
        this.indent_push();
        this.line("⤺ (SigilValue){ .tag = TAG_UNIT, .evidence = SIGIL_KNOWN };");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Bool
        this.line("static inline SigilValue sigil_bool(bool b) {");
        this.indent_push();
        this.line("⤺ (SigilValue){ .tag = TAG_BOOL, .evidence = SIGIL_KNOWN, .v.b = b };");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Int
        this.line("static inline SigilValue sigil_int(int64_t i) {");
        this.indent_push();
        this.line("⤺ (SigilValue){ .tag = TAG_INT, .evidence = SIGIL_KNOWN, .v.i = i };");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Float
        this.line("static inline SigilValue sigil_float(double f) {");
        this.indent_push();
        this.line("⤺ (SigilValue){ .tag = TAG_FLOAT, .evidence = SIGIL_KNOWN, .v.f = f };");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Char
        this.line("static inline SigilValue sigil_char(char c) {");
        this.indent_push();
        this.line("⤺ (SigilValue){ .tag = TAG_CHAR, .evidence = SIGIL_KNOWN, .v.c = c };");
        this.indent_pop();
        this.line("}");
        this.line("");

        // String
        this.line("static inline SigilValue sigil_string(◆ char* s) {");
        this.indent_push();
        this.line("char* copy = strdup(s);");
        this.line("⤺ (SigilValue){ .tag = TAG_STRING, .evidence = SIGIL_KNOWN, .v.s = copy };");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Null
        this.line("static inline SigilValue sigil_null(void) {");
        this.indent_push();
        this.line("⤺ (SigilValue){ .tag = TAG_NULL, .evidence = SIGIL_UNCERTAIN };");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Array - uses header format ∀ Vec-like dynamic operations
        this.line("static inline SigilValue sigil_array(size_t len) {");
        this.indent_push();
        this.line("/* Use header format ∀ shared length tracking */");
        this.line("size_t cap = len < 4 ? 4 : len;");
        this.line("SigilArrayHeader* header = (SigilArrayHeader*)calloc(1, sizeof(SigilArrayHeader) + cap * sizeof(SigilValue));");
        this.line("header->len = len;");
        this.line("header->cap = cap;");
        this.line("⤺ (SigilValue){ .tag = TAG_ARRAY, .evidence = SIGIL_KNOWN, .v.arr = { (SigilValue*)sigil_array_data(header), len, cap } };");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Evidence setter
        this.line("static inline SigilValue sigil_with_evidence(SigilValue v, uint8_t ev) {");
        this.indent_push();
        this.line("v.evidence = ev;");
        this.line("⤺ v;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Truthiness
        this.line("static inline bool sigil_truthy(SigilValue v) {");
        this.indent_push();
        this.line("switch (v.tag) {");
        this.indent_push();
        this.line("case TAG_BOOL: ⤺ v.v.b;");
        this.line("case TAG_INT: ⤺ v.v.i != 0;");
        this.line("case TAG_FLOAT: ⤺ v.v.f != 0.0;");
        this.line("case TAG_STRING: ⤺ v.v.s ∧ v.v.s[0];");
        this.line("case TAG_ARRAY: ⤺ v.v.arr.len > 0;");
        this.line("case TAG_NULL: ⤺ nay;");
        this.line("case TAG_UNIT: ⤺ nay;");
        this.line("case TAG_ENUM: ⤺ yea;  /* Enum values are always truthy */");
        this.line("default: ⤺ yea;");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Equality
        this.line("static inline bool sigil_eq(SigilValue a, SigilValue b) {");
        this.indent_push();
        this.line("/* Dereference refs before comparing */");
        this.line("⎇ (a.tag == TAG_REF ∧ a.v.ptr) a = *(SigilValue*)a.v.ptr;");
        this.line("⎇ (b.tag == TAG_REF ∧ b.v.ptr) b = *(SigilValue*)b.v.ptr;");
        this.line("⎇ (a.tag != b.tag) ⤺ nay;");
        this.line("switch (a.tag) {");
        this.indent_push();
        this.line("case TAG_BOOL: ⤺ a.v.b == b.v.b;");
        this.line("case TAG_INT: ⤺ a.v.i == b.v.i;");
        this.line("case TAG_FLOAT: ⤺ a.v.f == b.v.f;");
        this.line("case TAG_CHAR: ⤺ a.v.c == b.v.c;");
        this.line("case TAG_STRING: ⤺ strcmp(a.v.s, b.v.s) == 0;");
        this.line("case TAG_NULL: ⤺ yea;");
        this.line("case TAG_UNIT: ⤺ yea;");
        this.line("case TAG_ENUM: ⤺ a.v.e.enum_id == b.v.e.enum_id ∧ a.v.e.variant == b.v.e.variant;");
        this.line("default: ⤺ nay;");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Result type helpers
        this.line("/* Result type helpers */");
        this.line("static inline SigilValue sigil_Ok(SigilValue v) {");
        this.indent_push();
        this.line("SigilValue* inner = (SigilValue*)malloc(sizeof(SigilValue));");
        this.line("*inner = v;");
        this.line("⤺ (SigilValue){ .tag = TAG_RESULT_OK, .evidence = SIGIL_KNOWN, .v.ptr = inner };");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("static inline SigilValue sigil_Err(SigilValue v) {");
        this.indent_push();
        this.line("SigilValue* inner = (SigilValue*)malloc(sizeof(SigilValue));");
        this.line("*inner = v;");
        this.line("⤺ (SigilValue){ .tag = TAG_RESULT_ERR, .evidence = SIGIL_KNOWN, .v.ptr = inner };");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("static inline bool sigil_is_ok(SigilValue v) { ⤺ v.tag == TAG_RESULT_OK; }");
        this.line("static inline bool sigil_is_err(SigilValue v) { ⤺ v.tag == TAG_RESULT_ERR; }");
        this.line("");

        // Char from u32
        this.line("static inline SigilValue sigil_char____from_u32(SigilValue codepoint) {");
        this.indent_push();
        this.line("⤺ sigil_char((char)(codepoint.v.i & 0xFF));");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Tick function (∀ loop iteration limit)
        this.line("static long long global_tick = 0;");
        this.line("static inline void tick(◆ char* fn) {");
        this.indent_push();
        this.line("global_tick++;");
        this.line("⎇ (global_tick > 100000000) { fprintf(stderr, \"Infinite loop ∈ %s\\n\", fn); exit(1); }");
        this.indent_pop();
        this.line("}");
        this.line("");
    }

    rite emit_builtin_decls(vary this) {
        this.line("/* I/O - print/println provided by user code or library */");
