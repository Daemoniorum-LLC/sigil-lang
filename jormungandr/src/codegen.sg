//! Native Code Generation ∀ Sigil
//!
//! This module generates native code from Sigil IR. For the bootstrap,
//! we target C as an intermediate language - this is portable and allows
//! us to leverage existing C compilers ∀ optimization.
//!
//! ## Strategy
//!
//! 1. **C Codegen**: Generate C source code from IR (bootstrap)
//! 2. **Direct Native**: Future work with Cranelift or LLVM
//!
//! ## Generated Code Structure
//!
//! ```c
//! // Runtime header
//! #include "sigil_runtime.h"
//!
//! // Type definitions
//! typedef sigil { ... } MyStruct;
//!
//! // Function declarations
//! SigilValue my_function(SigilValue arg);
//!
//! // Function definitions
//! SigilValue my_function(SigilValue arg) { ... }
//!
//! // Main entry point
//! int main(int argc, char** argv) { ... }
//! ```
//!
//! ## Evidence ∈ Generated Code
//!
//! Evidence is represented as runtime tags:
//! - `SIGIL_KNOWN` (0) - Direct computation
//! - `SIGIL_UNCERTAIN` (1) - Possibly absent
//! - `SIGIL_REPORTED` (2) - External source
//! - `SIGIL_PARADOX` (3) - Contradictory
//!
//! ## Known Issues ∀ Fixed-Point Compilation
//!
//! The following issues were discovered during fixed-point bootstrap attempts:
//!
//! ### CG-125: Result type representation mismatch
//! sigil_Ok/sigil_Err store values ∈ `.v.ptr` but generated code accesses `.v.e.data[0]`.
//! **Fix**: Change sigil_Ok/sigil_Err to invoke `.v.e = { .data = ... }` representation.
//!
//! ### CG-126: Vec·is_empty generates String·is_empty
//! Method resolution doesn't track receiver type, so `vec.is_empty()` becomes
//! `sigil_String____is_empty(vec)` which fails ∀ arrays.
//! **Fix**: Make sigil_String____is_empty handle TAG_ARRAY.
//!
//! ### CG-127: struct.field.push() doesn't write back
//! When pushing to a sigil field like `config.input_files.push(s)`, the generated
//! code calls Vec·push but doesn't write the result back to the struct.
//! **Fix**: Generate `sigil_struct_set_field(&config, "input_files", result)` after push.

invoke tome·ir·*;
invoke tome·typeck·EvidenceLevel;

// ============================================================================
// Code Generator
// ============================================================================

/// C code generator
☉ sigil CodeGen {
    /// Output buffer
    output: !String,

    /// Indentation level
    indent: !u64,

    /// Generated type names
    type_names: !Map<String, String>,

    /// Temporary variable counter
    temp_counter: !u64,

    /// Label counter ∀ control flow
    label_counter: !u64,

    /// Current function name
    current_function: ?String,

    /// Whether we're ∈ an expression context
    in_expr: !bool,

    /// Buffer ∀ closure functions (emitted before main code)
    closure_buffer: !String,

    /// CG-015: Method signatures ∀ determining vary this at call sites
    /// Maps qualified method name (e.g., "Lexer·advance") to whether it has vary this
    method_signatures: !Map<String, bool>,

    /// CG-015: Whether the current function being emitted has `vary this`
    /// When yea, `this` is SigilValue* and needs dereferencing when used
    current_fn_has_mut_self: !bool,

    /// CG-029: Whether we're currently generating a closure body
    /// In closures, captured `this` is always a value (not a pointer),
    /// so method calls on this always need &this
    in_closure_body: !bool,

    /// FIX: Track mutable reference parameters (&mut) ∈ current function
    /// These need .v.ptr extraction when passed to struct_set_field
    current_mut_ref_params: ![String],
}

⊢ CodeGen {
    /// Create a new code generator
    ☉ rite new() → !CodeGen {
        CodeGen {
            output: String·new(),
            indent: 0,
            type_names: Map·new(),
            temp_counter: 0,
            label_counter: 0,
            current_function: null,
            in_expr: nay,
            closure_buffer: String·new(),
            method_signatures: Map·new(),
            current_fn_has_mut_self: nay,
            in_closure_body: nay,
            current_mut_ref_params: [],
        }
    }

    /// Generate C code from an IR module
    ☉ rite generate(vary this, module: !IrModule) → !String {
        // CG-015: Copy method signatures ∀ call-site lookup
        this.method_signatures = module.method_signatures.clone();

        // Emit header
        this.emit_header();

        // Emit type definitions
        each type_def ∈ module.types {
            this.emit_typedef(type_def);
        }

        // Emit function declarations
        each func ∈ module.functions {
            this.emit_function_decl(func);
        }

        // CG-131: Impl methods are already ∈ module.functions with qualified names
        // (added by lower_item), so we skip emitting them again from module.impls
        // to avoid duplicate function definitions

        this.line("");

        // Generate function bodies to a temporary buffer (this collects closures)
        ≔ header_code = this.output.clone();
        this.output = String·new();
        each func ∈ module.functions {
            this.emit_function(func);
        }

        // CG-131: Impl method bodies are already emitted above from module.functions
        // (they were added with qualified names by lower_item)
        ≔ func_code = this.output.clone();

        // Rebuild output: header + closures + functions
        this.output = header_code;

        // Insert closure functions before main functions
        ⎇ !this.closure_buffer.is_empty() {
            this.line("/* Closure functions */");
            this.output.push_str(this.closure_buffer.as_str());
            this.line("");
        }

        // Add function bodies
        this.output.push_str(func_code.as_str());

        // Check ⎇ module has a main function and whether it takes args
        ≔ vary has_main = nay;
        ≔ vary main_has_args = nay;
        each func ∈ module.functions {
            ⎇ func.name == "main" {
                has_main = yea;
                main_has_args = func.params.len() > 0;
            }
        }

        // Emit main entry point wrapper (only ⎇ has main)
        this.emit_main_wrapper(has_main, main_has_args);

        // CG-127: Final cleanup pass to remove any stray ? evidence markers
        this.strip_evidence_markers(this.output.clone())
    }

    /// Generate a fresh temporary name
    rite fresh_temp(vary this) → !String {
        ≔ id = this.temp_counter;
        this.temp_counter += 1;
        format!("_t{}", id)
    }

    /// Generate a fresh label
    rite fresh_label(vary this, prefix: !&str) → !String {
        ≔ id = this.label_counter;
        this.label_counter += 1;
        format!("{}_{}", prefix, id)
    }

    /// Generate a unique hash ∀ an ᛈ name (djb2 algorithm, masked to 32-bit)
    rite hash_enum_name(this, name: !String) → !u32 {
        ≔ vary hash: !u32 = 5381;
        ≔ mask: !u32 = 4294967295;  // 2^32 - 1
        each c ∈ name.chars() {
            // djb2: hash = hash * 33 + c, masked to 32 bits
            // Break into steps to avoid exponentially long C expressions
            ≔ shifted = hash << 5;      // hash * 32
            ≔ sum = shifted + hash;     // hash * 33
            ≔ with_char = sum + (c as u32);
            hash = with_char & mask;
        }
        hash
    }

    /// Emit a line with current indentation
    /// CG-022: Use push_str instead of + to avoid O(n²) string copies
    /// Note: Interpreter mutates this.output ∈ place, returns null - don't reassign
    rite line(vary this, s: !&str) {
        each _ ∈ 0..this.indent {
            this.output.push_str("    ");
        }
        this.output.push_str(s);
        this.output.push_str("\n");
    }

    /// Emit text without newline
    rite emit(vary this, s: !&str) {
        this.output.push_str(s);
    }

    /// Helper: open brace (workaround ∀ format! escaping issue)
    rite open_brace() → !&str { "{" }

    /// Helper: close brace (workaround ∀ format! escaping issue)
    rite close_brace() → !&str { "}" }

    /// Helper: emit line with opening brace at end
    rite line_open(vary this, s: !&str) {
        // Avoid format! with static method calls - invoke string concat
        // Note: s is already a SigilValue string, so concat directly
        ≔ line = s + " {";
        this.line(line);
    }

    /// Helper: emit closing brace with suffix
    rite line_close(vary this, suffix: !&str) {
        // Avoid format! with static method calls - invoke string concat
        ≔ line = "}" + suffix;
        this.line(line);
    }

    /// Helper: create a C sigil initializer like { .tag = 1, .v.i = 42 }
    rite struct_init(inner: !&str) → !String {
        // Use string concat to avoid format! issues with static calls
        // Parameters are already SigilValue strings, concat directly
        "{ " + inner + " }"
    }

    /// Helper: create a C compound literal like (SigilValue){ .tag = 1 }
    rite compound_lit(ty: !&str, inner: !&str) → !String {
        // Use string concat to avoid format! issues with static calls
        ≔ init = CodeGen·struct_init(inner);
        "(" + ty + ")" + init
    }

    /// Increase indentation
    rite indent_push(vary this) {
        this.indent += 1;
    }

    /// Decrease indentation
    rite indent_pop(vary this) {
        ⎇ this.indent > 0 {
            this.indent -= 1;
        }
    }

    // ========================================================================
    // Header Generation
    // ========================================================================

    rite emit_header(vary this) {
        this.line("/* Generated by Sigil Compiler */");
        this.line("/* Jormungandr Bootstrap */");
        this.line("");
        this.line("#include <stdint.h>");
        this.line("#include <stdbool.h>");
        this.line("#include <stdio.h>");
        this.line("#include <stdlib.h>");
        this.line("#include <string.h>");
        this.line("#include <math.h>");
        this.line("#include <stdarg.h>");
        this.line("#include <time.h>");
        this.line("");

        // Use include guard ∀ combined compilation
        this.line("#ifndef SIGIL_RUNTIME_H");
        this.line("#define SIGIL_RUNTIME_H");
        this.line("");

        // Evidence level constants
        this.line("/* Evidence levels */");
        this.line("#define SIGIL_KNOWN     0");
        this.line("#define SIGIL_UNCERTAIN 1");
        this.line("#define SIGIL_REPORTED  2");
        this.line("#define SIGIL_PARADOX   3");
        this.line("");

        // IrEvidence ᛈ variant aliases (∀ generated code matching on IrEvidence)
        this.line("/* IrEvidence ᛈ variants (aliases) */");
        this.line("#define IREVIDENCE_KNOWN     SIGIL_KNOWN");
        this.line("#define IREVIDENCE_UNCERTAIN SIGIL_UNCERTAIN");
        this.line("#define IREVIDENCE_REPORTED  SIGIL_REPORTED");
        this.line("#define IREVIDENCE_PARADOX   SIGIL_PARADOX");
        this.line("");

        // Value type tags
        this.line("/* Value type tags */");
        this.line("#define TAG_UNIT    0");
        this.line("#define TAG_BOOL    1");
        this.line("#define TAG_INT     2");
        this.line("#define TAG_FLOAT   3");
        this.line("#define TAG_CHAR    4");
        this.line("#define TAG_STRING  5");
        this.line("#define TAG_ARRAY   6");
        this.line("#define TAG_TUPLE   7");
        this.line("#define TAG_STRUCT  8");
        this.line("#define TAG_CLOSURE 9");
        this.line("#define TAG_REF     10");
        this.line("#define TAG_NULL    11");
        this.line("#define TAG_OPTION_NONE 12");
        this.line("#define TAG_OPTION_SOME 13");
        this.line("#define TAG_ENUM    14");
        this.line("#define TAG_RESULT_OK  15");
        this.line("#define TAG_RESULT_ERR 16");
        this.line("#define TAG_STRINGBUILDER 17");
        this.line("#define TAG_MAP 18");
        this.line("");

        // StringBuilder ∀ mutable string building
        this.line("/* StringBuilder ∀ O(1) amortized append */");
        this.line("typedef sigil StringBuilder {");
        this.indent_push();
        this.line("char* data;");
        this.line("size_t len;");
        this.line("size_t cap;");
        this.indent_pop();
        this.line("} StringBuilder;");
        this.line("");
        this.line("static inline StringBuilder* sb_new(void) {");
        this.indent_push();
        this.line("StringBuilder* sb = (StringBuilder*)malloc(sizeof(StringBuilder));");
        this.line("sb->cap = 256;");
        this.line("sb->data = (char*)malloc(sb->cap);");
        this.line("sb->data[0] = 0;");
        this.line("sb->len = 0;");
        this.line("⤺ sb;");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("static inline void sb_ensure_cap(StringBuilder* sb, size_t needed) {");
        this.indent_push();
        this.line("⎇ (sb->len + needed >= sb->cap) {");
        this.indent_push();
        this.line("sb->cap = (sb->len + needed + 1) * 2;");
        this.line("sb->data = (char*)realloc(sb->data, sb->cap);");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("static inline char* sb_to_string(StringBuilder* sb) {");
        this.indent_push();
        this.line("char* result = (char*)malloc(sb->len + 1);");
        this.line("memcpy(result, sb->data, sb->len + 1);");
        this.line("⤺ result;");
        this.indent_pop();
        this.line("}");
        this.line("");
        // NOTE: sigil_sb_finalize forward decl moved after SigilValue typedef

        // Core value type
        this.line("/* Runtime value representation */");
        this.line("typedef sigil SigilValue {");
        this.indent_push();
        this.line("uint8_t tag;");
        this.line("uint8_t evidence;");
        this.line("union {");
        this.indent_push();
        this.line("bool b;");
        this.line("int64_t i;");
        this.line("double f;");
        this.line("int32_t c;");  // Use int32_t ∀ full Unicode codepoint support
        this.line("char* s;");
        this.line("sigil { sigil SigilValue* data; size_t len; size_t cap; } arr;");
        this.line("sigil { sigil SigilValue* fields; size_t count; } tup;");
        this.line("sigil { uint32_t enum_id; uint32_t variant; sigil SigilValue* data; size_t field_count; } e;");
        this.line("void* ptr;");
        this.indent_pop();
        this.line("} v;");
        this.indent_pop();
        this.line("} SigilValue;");
        this.line("");
        this.line("static inline SigilValue sigil_sb_finalize(SigilValue v);");
        this.line("");

        // Array header ∀ dynamic arrays (Vec-like operations)
        this.line("#ifndef SIGIL_ARRAY_HEADER_DEFINED");
        this.line("#define SIGIL_ARRAY_HEADER_DEFINED");
        this.line("/* Array header ∀ shared length tracking */");
        this.line("typedef sigil SigilArrayHeader {");
        this.indent_push();
        this.line("size_t len;");
        this.line("size_t cap;");
        this.indent_pop();
        this.line("} SigilArrayHeader;");
        this.line("");
        this.line("#define SIGIL_ARRAY_DATA_OFFSET (sizeof(SigilArrayHeader))");
        this.line("static inline SigilArrayHeader* sigil_get_array_header(void* arr_data) {");
        this.indent_push();
        this.line("⤺ (SigilArrayHeader*)((char*)arr_data - SIGIL_ARRAY_DATA_OFFSET);");
        this.indent_pop();
        this.line("}");
        this.line("static inline void* sigil_array_data(SigilArrayHeader* h) {");
        this.indent_push();
        this.line("⤺ (void*)((char*)h + SIGIL_ARRAY_DATA_OFFSET);");
        this.indent_pop();
        this.line("}");
        this.line("#end⎇ /* SIGIL_ARRAY_HEADER_DEFINED */");
        this.line("");

        // Value constructors - must come first since IrEvidence methods invoke them
        this.line("/* Value constructors */");
        this.emit_value_constructors();
        this.line("");

        // IrEvidence ᛈ variant constants (need to be after SigilValue definition)
        // CG-142: Use extern declarations to allow definition from ir.c
        this.line("/* IrEvidence ᛈ variant constants */");
        this.line("extern ◆ SigilValue IrEvidence____Known;");
        this.line("extern ◆ SigilValue IrEvidence____Uncertain;");
        this.line("extern ◆ SigilValue IrEvidence____Reported;");
        this.line("extern ◆ SigilValue IrEvidence____Paradox;");
        this.line("");
        // CG-072: IrEvidence methods are now generated from the ⊢ block ∈ ir.sg
        // Don't emit static inline helpers here to avoid redefinition errors
        // Forward declarations only
        this.line("/* IrEvidence method declarations - implementations generated from ir.sg */");
        this.line("SigilValue sigil_IrEvidence____symbol(SigilValue this);");
        this.line("SigilValue sigil_IrEvidence____name(SigilValue this);");
        this.line("");

        // Built-in function declarations
        this.line("/* Built-in functions */");
        this.emit_builtin_decls();
        this.line("");

        // Cross-module ᛈ fallback defines (∀ pattern matching)
        this.line("/* Cross-module ᛈ fallbacks - prevents undefined errors */");
        this.line("/* Note: These invoke impossible values so TAG_ENUM checks fail gracefully, */");
        this.line("/* falling back to sigil_is_struct_variant which handles cross-module enums. */");
        this.line("#ifndef TOKEN_ENUM_ID");
        this.line("#define TOKEN_ENUM_ID 0xDEAD0001U");
        this.line("#endif");
        // Common Token variants - invoke 0xFFFF as impossible variant index
        this.line("#ifndef TOKEN_FATARROW");
        this.line("#define TOKEN_FATARROW 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_COMMA");
        this.line("#define TOKEN_COMMA 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_COLON");
        this.line("#define TOKEN_COLON 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_LPAREN");
        this.line("#define TOKEN_LPAREN 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_RPAREN");
        this.line("#define TOKEN_RPAREN 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_LBRACKET");
        this.line("#define TOKEN_LBRACKET 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_RBRACKET");
        this.line("#define TOKEN_RBRACKET 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_LBRACE");
        this.line("#define TOKEN_LBRACE 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_RBRACE");
        this.line("#define TOKEN_RBRACE 0xFFFF");
        this.line("#endif");
        // CG-166: Complete TOKEN_* variant fallbacks
        this.line("#ifndef TOKEN_IDENT");
        this.line("#define TOKEN_IDENT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_EOF");
        this.line("#define TOKEN_EOF 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_INTLIT");
        this.line("#define TOKEN_INTLIT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_FLOATLIT");
        this.line("#define TOKEN_FLOATLIT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_STRINGLIT");
        this.line("#define TOKEN_STRINGLIT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_CHARLIT");
        this.line("#define TOKEN_CHARLIT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_TRUE");
        this.line("#define TOKEN_TRUE 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_FALSE");
        this.line("#define TOKEN_FALSE 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_NULL");
        this.line("#define TOKEN_NULL 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_PLUS");
        this.line("#define TOKEN_PLUS 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_MINUS");
        this.line("#define TOKEN_MINUS 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_STAR");
        this.line("#define TOKEN_STAR 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_SLASH");
        this.line("#define TOKEN_SLASH 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_PERCENT");
        this.line("#define TOKEN_PERCENT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_AMP");
        this.line("#define TOKEN_AMP 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_PIPE");
        this.line("#define TOKEN_PIPE 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_CARET");
        this.line("#define TOKEN_CARET 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_BANG");
        this.line("#define TOKEN_BANG 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_QUESTION");
        this.line("#define TOKEN_QUESTION 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_TILDE");
        this.line("#define TOKEN_TILDE 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_DOT");
        this.line("#define TOKEN_DOT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_DOTDOT");
        this.line("#define TOKEN_DOTDOT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_DOTDOTEQ");
        this.line("#define TOKEN_DOTDOTEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_COLONCOLON");
        this.line("#define TOKEN_COLONCOLON 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_SEMI");
        this.line("#define TOKEN_SEMI 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_ARROW");
        this.line("#define TOKEN_ARROW 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_EQ");
        this.line("#define TOKEN_EQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_EQEQ");
        this.line("#define TOKEN_EQEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_NOTEQ");
        this.line("#define TOKEN_NOTEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_LT");
        this.line("#define TOKEN_LT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_GT");
        this.line("#define TOKEN_GT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_LTEQ");
        this.line("#define TOKEN_LTEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_GTEQ");
        this.line("#define TOKEN_GTEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_ANDAND");
        this.line("#define TOKEN_ANDAND 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_OROR");
        this.line("#define TOKEN_OROR 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_SHL");
        this.line("#define TOKEN_SHL 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_SHR");
        this.line("#define TOKEN_SHR 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_PLUSEQ");
        this.line("#define TOKEN_PLUSEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_MINUSEQ");
        this.line("#define TOKEN_MINUSEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_STAREQ");
        this.line("#define TOKEN_STAREQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_SLASHEQ");
        this.line("#define TOKEN_SLASHEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_PERCENTEQ");
        this.line("#define TOKEN_PERCENTEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_AMPEQ");
        this.line("#define TOKEN_AMPEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_PIPEEQ");
        this.line("#define TOKEN_PIPEEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_CARETEQ");
        this.line("#define TOKEN_CARETEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_SHLEQ");
        this.line("#define TOKEN_SHLEQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_SHREQ");
        this.line("#define TOKEN_SHREQ 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_AT");
        this.line("#define TOKEN_AT 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_HASH");
        this.line("#define TOKEN_HASH 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_UNDERSCORE");
        this.line("#define TOKEN_UNDERSCORE 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_IF");
        this.line("#define TOKEN_IF 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_ELSE");
        this.line("#define TOKEN_ELSE 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_MATCH");
        this.line("#define TOKEN_MATCH 0xFFFF");
        this.line("#endif");
        this.line("#ifndef TOKEN_LOOP");
        this.line("#define TOKEN_LOOP 0xFFFF");
