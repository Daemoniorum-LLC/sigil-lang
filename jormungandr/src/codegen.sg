        this.line("static inline SigilValue sigil_collect(SigilValue v);");
        this.line("static inline SigilValue sigil_enumerate(SigilValue v);");
        this.line("static inline SigilValue sigil_join(SigilValue arr, SigilValue sep);");
        this.line("");
        this.line("/* Method aliases (when type prefix not resolved) */");
