                            format!("{}.v.arr.data[{}]", arr_name, index_expr)
                        } ⎉ {
                            // For variable indices, need to access .v.i to get the integer
                            format!("{}.v.arr.data[{}.v.i]", arr_name, index_expr)
                        };

                        // CG-092b: Check ∀ chained field/method access after array index
                        ≔ after_bracket = idx_end + 1;
                        ⎇ after_bracket < len ∧ chars[after_bracket] == '.' {
                            // Read the field/method name
                            ≔ chain_start = after_bracket + 1;
                            ≔ vary chain_end = chain_start;
                            ⟳ chain_end < len {
                                ≔ ch = chars[chain_end];
                                ⎇ (ch >= 'a' ∧ ch <= 'z') ∨ (ch >= 'A' ∧ ch <= 'Z') ∨
                                   (ch >= '0' ∧ ch <= '9') ∨ ch == '_' {
                                    chain_end = chain_end + 1;
                                } ⎉ {
                                    ⊲;
                                }
                            }
                            ⎇ chain_end > chain_start {
                                ≔ vary chain_name = String·new();
                                ≔ vary ck = chain_start;
                                ⟳ ck < chain_end {
                                    chain_name.push(chars[ck]);
                                    ck = ck + 1;
                                }
                                // Check ⎇ it's a method call
                                ⎇ chain_end < len ∧ chars[chain_end] == '(' {
                                    // Method call like .to_string()
                                    ⎇ chain_name == "to_string" {
                                        ≔ vary call_end = chain_end + 1;
                                        ⎇ call_end < len ∧ chars[call_end] == ')' {
                                            call_end = call_end + 1;
                                        }
                                        result = result + format!("sigil_to_string({})", arr_access).as_str();
                                        i = call_end;
                                        ⊳;
