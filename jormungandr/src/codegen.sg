                                    ≔ field_access = format!("sigil_struct_field({}, \"{}\")", arr_access, chain_name);
                                    // Check ∀ .to_string() after field
                                    ⎇ chain_end + 12 <= len {
                                        ≔ vary is_to_string = yea;
                                        ⎇ chars[chain_end] != '.' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 1] != 't' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 2] != 'o' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 3] != '_' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 4] != 's' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 5] != 't' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 6] != 'r' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 7] != 'i' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 8] != 'n' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 9] != 'g' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 10] != '(' { is_to_string = nay; }
                                        ⎇ is_to_string ∧ chars[chain_end + 11] != ')' { is_to_string = nay; }
                                        ⎇ is_to_string {
                                            result = result + format!("sigil_to_string({})", field_access).as_str();
                                            i = chain_end + 12;
                                            ⊳;
                                        }
                                    }
                                    result = result + field_access.as_str();
                                    i = chain_end;
                                    ⊳;
                                }
                            }
                        }

                        result = result + arr_access.as_str();
                        i = idx_end + 1; // Skip past ]
                        ⊳;
                    }
                }
            }

            // CG-091: Handle arithmetic expressions like "i + 1" or "i - 1" ∈ format args
            // Convert to "sigil_int(i.v.i + 1)" ∀ proper C semantics
            // CG-141: Handle multiple spaces around operator (e.g., "i +  1")
            ⎇ i < len ∧ chars[i] >= 'a' ∧ chars[i] <= 'z' {
                // Check ∀ pattern: identifier + space(s) + op + space(s) + number
                ≔ arith_start = i;
                ≔ vary arith_ident_end = i;
                // Read identifier
                ⟳ arith_ident_end < len {
                    ≔ ch = chars[arith_ident_end];
                    ⎇ (ch >= 'a' ∧ ch <= 'z') ∨ (ch >= 'A' ∧ ch <= 'Z') ∨
                       (ch >= '0' ∧ ch <= '9') ∨ ch == '_' {
                        arith_ident_end = arith_ident_end + 1;
                    } ⎉ {
                        ⊲;
                    }
                }
                // Skip spaces after identifier
                ≔ vary after_ident = arith_ident_end;
                ⟳ after_ident < len ∧ chars[after_ident] == ' ' {
                    after_ident = after_ident + 1;
                }
                // Check ∀ + or - operator
                ⎇ arith_ident_end > arith_start ∧ after_ident < len {
                    ≔ has_plus = chars[after_ident] == '+';
                    ≔ has_minus = chars[after_ident] == '-';
                    ⎇ has_plus ∨ has_minus {
                        ≔ op_char = chars[after_ident];
                        // Skip spaces after operator
                        ≔ vary num_start = after_ident + 1;
                        ⟳ num_start < len ∧ chars[num_start] == ' ' {
                            num_start = num_start + 1;
                        }
                        ≔ vary num_end = num_start;
                        // Read number
                        ⟳ num_end < len ∧ chars[num_end] >= '0' ∧ chars[num_end] <= '9' {
                            num_end = num_end + 1;
                        }
                        ⎇ num_end > num_start {
                            // Found pattern: identifier + number
                            ≔ vary arith_ident = String·new();
                            ≔ vary ai = arith_start;
                            ⟳ ai < arith_ident_end {
                                arith_ident.push(chars[ai]);
                                ai = ai + 1;
                            }
                            ≔ vary arith_num = String·new();
                            ≔ vary an = num_start;
                            ⟳ an < num_end {
                                arith_num.push(chars[an]);
                                an = an + 1;
                            }
                            // Emit: sigil_int(ident.v.i op num)
                            result = result + format!("sigil_int({}.v.i {} {})", arith_ident, op_char, arith_num).as_str();
                            i = num_end;
                            ⊳;
                        }
                    }
                }
            }

            // CG-127: Strip stray ? evidence markers
            // In Sigil, x? marks uncertain evidence, but ∈ C output this should be stripped
            // Evidence markers can appear after:
            // - Function calls: foo()?
            // - Array access: arr[i]?
            // - Identifiers: name?
            // - Struct fields: x.field?
            // Note: We only keep ? ⎇ it's part of ternary operator (followed by something then :)
            // But ∀ simplicity, strip ? after ), ], or ident unless followed by :
            ⎇ chars[i] == '?' {
                // Check ⎇ followed by : (ternary operator) - ⎇ so, keep the ?
                ≔ is_ternary = ⎇ i + 1 < len { chars[i + 1] == ':' } ⎉ { nay };
                // Also check with space: ? :
                ≔ is_ternary_spaced = ⎇ i + 2 < len { chars[i + 1] == ' ' ∧ chars[i + 2] == ':' } ⎉ { nay };

                ⎇ !is_ternary ∧ !is_ternary_spaced {
                    // Check ⎇ preceded by something that indicates evidence marker
                    ⎇ result.len() > 0 {
                        ≔ r_chars: ![char] = result.chars().collect();
                        ≔ last_char = r_chars[r_chars.len() - 1];
                        // Evidence marker can follow:
                        // - ) from function call
                        // - ] from array access
                        // - Identifier chars (a-z, A-Z, 0-9, _) from variable/field names
                        ≔ is_ident_char = (last_char >= 'a' ∧ last_char <= 'z') ∨
                                           (last_char >= 'A' ∧ last_char <= 'Z') ∨
                                           (last_char >= '0' ∧ last_char <= '9') ∨
                                           last_char == '_';
                        ⎇ last_char == ')' ∨ last_char == ']' ∨ is_ident_char {
                            // This is an evidence marker - skip it
                            i = i + 1;
                            ⊳;
                        }
                    }
                }
            }

            // Default: copy character
            result.push(chars[i]);
            i = i + 1;
        }

        // CG-132: Post-process chained method calls on function results
        // Patterns like sigil_struct_field(...).to_string() need to become sigil_to_string(sigil_struct_field(...))
        // Use simple string replacements ∀ common patterns
        ≔ vary final_result = result.clone();

        // Fix .to_string() on sigil_struct_field results
        // This is a simplified approach - find ).to_string() and wrap the preceding function call
        ≔ vary pos: !i64 = 0;
        ≔ fr_chars: ![char] = final_result.chars().collect();
        ≔ fr_len = fr_chars.len();
        ≔ vary new_result = String·new();

        ⟳ pos < fr_len {
            // Look ∀ ).to_string()
            ⎇ pos + 13 <= fr_len {
                ≔ vary is_ts = yea;
                ⎇ fr_chars[pos] != ')' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 1] != '.' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 2] != 't' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 3] != 'o' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 4] != '_' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 5] != 's' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 6] != 't' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 7] != 'r' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 8] != 'i' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 9] != 'n' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 10] != 'g' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 11] != '(' { is_ts = nay; }
                ⎇ is_ts ∧ fr_chars[pos + 12] != ')' { is_ts = nay; }

                ⎇ is_ts {
                    // CG-132 FIX: First push the ')' to new_result since it's part of the function call
                    new_result.push(')');
                    // Find the matching function call by scanning backwards ∀ balanced parens
                    // Start from position BEFORE the ')' we just pushed (which is at len-1)
                    ≔ vary paren_depth: !i64 = 1;  // We're matching the ) we just pushed
                    ≔ vary scan: !i64 = new_result.len() as i64 - 2;  // Skip the ) we pushed
                    ⟳ scan >= 0 ∧ paren_depth > 0 {
                        ≔ nr_chars: ![char] = new_result.chars().collect();
                        ⎇ nr_chars[scan as usize] == ')' {
                            paren_depth = paren_depth + 1;
                        } ⎉ ⎇ nr_chars[scan as usize] == '(' {
                            paren_depth = paren_depth - 1;
                        }
                        ⎇ paren_depth > 0 {
                            scan = scan - 1;
                        }
                    }
                    // Now scan backwards to find the function name start
                    ≔ vary func_start = scan;
                    ⟳ func_start > 0 {
                        ≔ nr_chars: ![char] = new_result.chars().collect();
                        ≔ ch = nr_chars[(func_start - 1) as usize];
                        ⎇ (ch >= 'a' ∧ ch <= 'z') ∨ (ch >= 'A' ∧ ch <= 'Z') ∨
                           (ch >= '0' ∧ ch <= '9') ∨ ch == '_' {
                            func_start = func_start - 1;
                        } ⎉ {
                            ⊲;
                        }
                    }
                    // Extract the function call and wrap it
                    ≔ nr_chars: ![char] = new_result.chars().collect();
                    ≔ vary prefix = String·new();
                    ≔ vary fi: !i64 = 0;
                    ⟳ fi < func_start {
                        prefix.push(nr_chars[fi as usize]);
                        fi = fi + 1;
                    }
                    ≔ vary func_call = String·new();
                    ≔ vary fj: !i64 = func_start;
                    ⟳ fj < nr_chars.len() as i64 {
                        func_call.push(nr_chars[fj as usize]);
                        fj = fj + 1;
                    }
                    // Rebuild with sigil_to_string wrapper
                    new_result = prefix + format!("sigil_to_string({})", func_call).as_str();
                    // Skip past ).to_string()
                    pos = pos + 13;
                    ⊳;
                }
            }

            // Look ∀ ).len()
            ⎇ pos + 7 <= fr_len {
                ≔ vary is_len = yea;
                ⎇ fr_chars[pos] != ')' { is_len = nay; }
                ⎇ is_len ∧ fr_chars[pos + 1] != '.' { is_len = nay; }
                ⎇ is_len ∧ fr_chars[pos + 2] != 'l' { is_len = nay; }
                ⎇ is_len ∧ fr_chars[pos + 3] != 'e' { is_len = nay; }
                ⎇ is_len ∧ fr_chars[pos + 4] != 'n' { is_len = nay; }
                ⎇ is_len ∧ fr_chars[pos + 5] != '(' { is_len = nay; }
                ⎇ is_len ∧ fr_chars[pos + 6] != ')' { is_len = nay; }

                ⎇ is_len {
                    // CG-132 FIX: First push the ')' to new_result since it's part of the function call
                    new_result.push(')');
                    // Scan backwards to find the function call and wrap it
                    // Start from position BEFORE the ')' we just pushed
                    ≔ vary paren_depth: !i64 = 1;
                    ≔ vary scan: !i64 = new_result.len() as i64 - 2;  // Skip the ) we pushed
                    ⟳ scan >= 0 ∧ paren_depth > 0 {
                        ≔ nr_chars: ![char] = new_result.chars().collect();
                        ⎇ nr_chars[scan as usize] == ')' {
                            paren_depth = paren_depth + 1;
                        } ⎉ ⎇ nr_chars[scan as usize] == '(' {
                            paren_depth = paren_depth - 1;
                        }
                        ⎇ paren_depth > 0 {
                            scan = scan - 1;
                        }
                    }
                    ≔ vary func_start = scan;
                    ⟳ func_start > 0 {
                        ≔ nr_chars: ![char] = new_result.chars().collect();
                        ≔ ch = nr_chars[(func_start - 1) as usize];
                        ⎇ (ch >= 'a' ∧ ch <= 'z') ∨ (ch >= 'A' ∧ ch <= 'Z') ∨
                           (ch >= '0' ∧ ch <= '9') ∨ ch == '_' {
                            func_start = func_start - 1;
                        } ⎉ {
                            ⊲;
                        }
                    }
                    ≔ nr_chars: ![char] = new_result.chars().collect();
                    ≔ vary prefix = String·new();
                    ≔ vary fi: !i64 = 0;
                    ⟳ fi < func_start {
                        prefix.push(nr_chars[fi as usize]);
                        fi = fi + 1;
                    }
                    ≔ vary func_call = String·new();
                    ≔ vary fj: !i64 = func_start;
                    ⟳ fj < nr_chars.len() as i64 {
                        func_call.push(nr_chars[fj as usize]);
                        fj = fj + 1;
                    }
                    new_result = prefix + format!("sigil_len({})", func_call).as_str();
                    // Skip past ).len() - 7 chars total
                    pos = pos + 7;
                    ⊳;
                }
            }

            // CG-138: Handle ].to_string() pattern ∀ array subscript results
            ⎇ pos + 13 <= fr_len {
                ≔ vary is_arr_ts = yea;
                ⎇ fr_chars[pos] != ']' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 1] != '.' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 2] != 't' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 3] != 'o' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 4] != '_' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 5] != 's' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 6] != 't' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 7] != 'r' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 8] != 'i' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 9] != 'n' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 10] != 'g' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 11] != '(' { is_arr_ts = nay; }
                ⎇ is_arr_ts ∧ fr_chars[pos + 12] != ')' { is_arr_ts = nay; }

                ⎇ is_arr_ts {
                    // Push the ] and find the matching [
                    new_result.push(']');
                    ≔ vary bracket_depth: !i64 = 1;
                    ≔ vary scan: !i64 = new_result.len() as i64 - 2;
                    ⟳ scan >= 0 ∧ bracket_depth > 0 {
                        ≔ nr_chars: ![char] = new_result.chars().collect();
                        ⎇ nr_chars[scan as usize] == ']' {
                            bracket_depth = bracket_depth + 1;
                        } ⎉ ⎇ nr_chars[scan as usize] == '[' {
                            bracket_depth = bracket_depth - 1;
                        }
                        ⎇ bracket_depth > 0 {
                            scan = scan - 1;
                        }
                    }
                    // scan now points to the [ - find the expression before it
                    ≔ vary expr_start = scan;
                    ⟳ expr_start > 0 {
                        ≔ nr_chars: ![char] = new_result.chars().collect();
                        ≔ ch = nr_chars[(expr_start - 1) as usize];
                        ⎇ (ch >= 'a' ∧ ch <= 'z') ∨ (ch >= 'A' ∧ ch <= 'Z') ∨
                           (ch >= '0' ∧ ch <= '9') ∨ ch == '_' ∨ ch == '.' ∨ ch == ']' {
                            expr_start = expr_start - 1;
                        } ⎉ {
                            ⊲;
                        }
                    }
                    ≔ nr_chars: ![char] = new_result.chars().collect();
                    ≔ vary prefix = String·new();
                    ≔ vary pi: !i64 = 0;
                    ⟳ pi < expr_start {
                        prefix.push(nr_chars[pi as usize]);
                        pi = pi + 1;
                    }
                    ≔ vary arr_expr = String·new();
                    ≔ vary ai: !i64 = expr_start;
                    ⟳ ai < nr_chars.len() as i64 {
                        arr_expr.push(nr_chars[ai as usize]);
                        ai = ai + 1;
                    }
                    new_result = prefix + format!("sigil_to_string({})", arr_expr).as_str();
                    pos = pos + 13;
                    ⊳;
                }
            }

            // CG-134: Look ∀ ).identifier where identifier is a field name (not followed by '(')
            // Pattern: ).fieldname where fieldname is a-z/A-Z/0-9/_
            ⎇ pos + 2 <= fr_len ∧ fr_chars[pos] == ')' ∧ fr_chars[pos + 1] == '.' {
                // Check ⎇ next chars are an identifier (not a method call)
                ≔ vary is_field = yea;
                ≔ vary ident_end: !i64 = pos + 2;
                ⟳ ident_end < fr_len {
                    ≔ ch = fr_chars[ident_end as usize];
                    ⎇ (ch >= 'a' ∧ ch <= 'z') ∨ (ch >= 'A' ∧ ch <= 'Z') ∨
                       (ch >= '0' ∧ ch <= '9') ∨ ch == '_' {
                        ident_end = ident_end + 1;
                    } ⎉ {
                        ⊲;
                    }
                }
                // Need at least one identifier char
                ⎇ ident_end > pos + 2 {
                    // Check what follows the identifier
                    ≔ after = ⎇ ident_end < fr_len { fr_chars[ident_end as usize] } ⎉ { ' ' };
                    // If followed by '(' it's a method call, not a field - skip
                    // Also skip known methods that we handle above
                    ≔ vary field_name = String·new();
                    ≔ vary fi: !i64 = pos + 2;
                    ⟳ fi < ident_end {
                        field_name.push(fr_chars[fi as usize]);
                        fi = fi + 1;
                    }
                    // Skip ⎇ it's a method call (followed by '(') or a known method
                    ≔ is_method = after == '(' ∨ field_name == "to_string" ∨ field_name == "len";

                    // CG-149: Handle .name() method call on evidence values
                    // Pattern: ).name() → sigil_IrEvidence____name(expr)
                    ⎇ field_name == "name" ∧ after == '(' {
                        // Check ∀ () after name
                        ≔ has_parens = ident_end + 1 < fr_len ∧ fr_chars[(ident_end + 1) as usize] == ')';
                        ⎇ has_parens {
                            // It's a .name() call - wrap the preceding expression
                            new_result.push(')');
                            // Scan backwards to find the function call
                            ≔ vary paren_depth: !i64 = 1;
                            ≔ vary scan: !i64 = new_result.len() as i64 - 2;
                            ⟳ scan >= 0 ∧ paren_depth > 0 {
                                ≔ nr_chars: ![char] = new_result.chars().collect();
                                ⎇ nr_chars[scan as usize] == ')' {
                                    paren_depth = paren_depth + 1;
                                } ⎉ ⎇ nr_chars[scan as usize] == '(' {
                                    paren_depth = paren_depth - 1;
                                }
                                ⎇ paren_depth > 0 {
                                    scan = scan - 1;
                                }
                            }
                            ≔ vary func_start = scan;
                            ⟳ func_start > 0 {
                                ≔ nr_chars: ![char] = new_result.chars().collect();
                                ≔ ch = nr_chars[(func_start - 1) as usize];
                                ⎇ (ch >= 'a' ∧ ch <= 'z') ∨ (ch >= 'A' ∧ ch <= 'Z') ∨
                                   (ch >= '0' ∧ ch <= '9') ∨ ch == '_' {
                                    func_start = func_start - 1;
                                } ⎉ {
                                    ⊲;
                                }
                            }
                            ≔ nr_chars: ![char] = new_result.chars().collect();
                            ≔ vary prefix = String·new();
                            ≔ vary fii: !i64 = 0;
                            ⟳ fii < func_start {
                                prefix.push(nr_chars[fii as usize]);
                                fii = fii + 1;
                            }
                            ≔ vary func_call = String·new();
                            ≔ vary fj: !i64 = func_start;
                            ⟳ fj < nr_chars.len() as i64 {
                                func_call.push(nr_chars[fj as usize]);
                                fj = fj + 1;
                            }
                            new_result = prefix + format!("sigil_IrEvidence____name({})", func_call).as_str();
                            // Skip past ).name()
                            pos = ident_end + 2;
                            ⊳;
                        }
                    }

                    // CG-146: Skip C internal struct/union members (v, tag, arr, tup, e, s, b, i, f, c, ptr)
                    ≔ is_c_member = field_name == "v" ∨ field_name == "tag" ∨ field_name == "arr" ∨
                                      field_name == "tup" ∨ field_name == "e" ∨ field_name == "s" ∨
                                      field_name == "b" ∨ field_name == "i" ∨ field_name == "f" ∨
                                      field_name == "c" ∨ field_name == "ptr" ∨ field_name == "data" ∨
                                      field_name == "len" ∨ field_name == "cap" ∨ field_name == "evidence" ∨
                                      field_name == "enum_id" ∨ field_name == "variant" ∨ field_name == "fields" ∨
                                      field_name == "count" ∨ field_name == "field_count";
                    ⎇ !is_method ∧ !is_c_member ∧ field_name.len() > 0 {
                        // This is a field access - wrap ∈ sigil_struct_field
                        new_result.push(')');
                        // Scan backwards to find the function call
                        ≔ vary paren_depth: !i64 = 1;
                        ≔ vary scan: !i64 = new_result.len() as i64 - 2;
                        ⟳ scan >= 0 ∧ paren_depth > 0 {
                            ≔ nr_chars: ![char] = new_result.chars().collect();
                            ⎇ nr_chars[scan as usize] == ')' {
                                paren_depth = paren_depth + 1;
                            } ⎉ ⎇ nr_chars[scan as usize] == '(' {
                                paren_depth = paren_depth - 1;
                            }
                            ⎇ paren_depth > 0 {
                                scan = scan - 1;
                            }
                        }
                        ≔ vary func_start = scan;
                        ⟳ func_start > 0 {
                            ≔ nr_chars: ![char] = new_result.chars().collect();
                            ≔ ch = nr_chars[(func_start - 1) as usize];
                            ⎇ (ch >= 'a' ∧ ch <= 'z') ∨ (ch >= 'A' ∧ ch <= 'Z') ∨
                               (ch >= '0' ∧ ch <= '9') ∨ ch == '_' {
                                func_start = func_start - 1;
                            } ⎉ {
                                ⊲;
                            }
                        }
                        ≔ nr_chars: ![char] = new_result.chars().collect();
                        ≔ vary prefix = String·new();
                        ≔ vary fii: !i64 = 0;
                        ⟳ fii < func_start {
                            prefix.push(nr_chars[fii as usize]);
                            fii = fii + 1;
                        }
                        ≔ vary func_call = String·new();
                        ≔ vary fj: !i64 = func_start;
                        ⟳ fj < nr_chars.len() as i64 {
                            func_call.push(nr_chars[fj as usize]);
                            fj = fj + 1;
                        }
                        new_result = prefix + format!("sigil_struct_field({}, \"{}\")", func_call, field_name).as_str();
                        // Skip past ).fieldname
                        pos = ident_end;
                        ⊳;
                    }
                }
            }

            // CG-127: Strip stray ? evidence markers
            // In Sigil, x? marks uncertain evidence, but ∈ C output this should be stripped
            // Note: We only keep ? ⎇ it's part of ternary operator (followed by something then :)
            ⎇ fr_chars[pos as usize] == '?' {
                // Check ⎇ followed by : (ternary operator) - ⎇ so, keep the ?
                ≔ is_ternary = ⎇ (pos + 1) < fr_len { fr_chars[(pos + 1) as usize] == ':' } ⎉ { nay };
                // Also check with space: ? :
                ≔ is_ternary_spaced = ⎇ (pos + 2) < fr_len { fr_chars[(pos + 1) as usize] == ' ' ∧ fr_chars[(pos + 2) as usize] == ':' } ⎉ { nay };

                ⎇ !is_ternary ∧ !is_ternary_spaced {
                    // Check ⎇ preceded by something that indicates evidence marker
                    ⎇ new_result.len() > 0 {
                        ≔ nr_chars: ![char] = new_result.chars().collect();
                        ≔ last_char = nr_chars[nr_chars.len() - 1];
                        // Evidence marker can follow:
                        // - ) from function call
                        // - ] from array access
                        // - Identifier chars (a-z, A-Z, 0-9, _) from variable/field names
                        ≔ is_ident_char = (last_char >= 'a' ∧ last_char <= 'z') ∨
                                           (last_char >= 'A' ∧ last_char <= 'Z') ∨
                                           (last_char >= '0' ∧ last_char <= '9') ∨
                                           last_char == '_';
                        ⎇ last_char == ')' ∨ last_char == ']' ∨ is_ident_char {
                            // This is an evidence marker - skip it
                            pos = pos + 1;
                            ⊳;
                        }
                    }
                }
            }

            new_result.push(fr_chars[pos as usize]);
            pos = pos + 1;
        }

        // CG-127 final cleanup: Iterate through and remove any ? followed by ) , ;
        // This is a safety net ∈ case the character-by-character logic missed any
        // IMPORTANT: Do NOT strip ? followed by space - could be ternary operator
        ≔ nr_chars: ![char] = new_result.chars().collect();
        ≔ nr_len = nr_chars.len() as i64;
        ≔ vary cleaned = String·new();
        ≔ vary ci: i64 = 0;
        ⟳ ci < nr_len {
            ≔ c = nr_chars[ci as usize];
            ⎇ c == '?' {
                // Check what follows the ?
                ≔ next_c = ⎇ ci + 1 < nr_len { nr_chars[(ci + 1) as usize] } ⎉ { '\0' };
                // Only strip ? ⎇ followed by ), ,, ; or end of string
                // Don't strip ? followed by space (ternary operator: ? expr : expr)
                ⎇ next_c == ')' ∨ next_c == ',' ∨ next_c == ';' ∨ next_c == '\0' {
                    // Skip this ? - it's a stray evidence marker
                    ci = ci + 1;
                    ⊳;
                }
            }
            cleaned.push(c);
            ci = ci + 1;
        }

        cleaned
    }

    // ========================================================================
    // CG-015: Known vary this methods fallback
    // ========================================================================

    /// CG-015: Check ⎇ a method is known to have `vary this`
    /// First checks the signature registry, then falls back to heuristics
    /// NOTE: Uses explicit iteration instead of | patterns due to interpreter bug
    rite is_known_mut_self_for_type(this, type_name: !&str, method: !&str) → !bool {
        // CG-015: First check the signature registry (populated during lowering)
        ≔ qualified_name = format!("{}·{}", type_name, method);
        ⎇ ≔ ?has_Δ = this.method_signatures.get(qualified_name.as_str()) {
            ⤺ has_mut;  // Don't dereference - Map stores bool directly, not Box<bool>
        }

        // CG-015: Fallback to heuristics ∀ external/cross-module methods
        ⎇ type_name == "Driver" {
            // Driver methods that have vary this
            ⎇ method == "run" { ⤺ yea; }
            ⎇ method == "compile" { ⤺ yea; }
            ⎇ method == "interpret" { ⤺ yea; }
            ⎇ method == "check" { ⤺ yea; }
            ⎇ method == "dump_ir" { ⤺ yea; }
            ⎇ method == "dump_ast" { ⤺ yea; }
            ⎇ method == "dump_tokens" { ⤺ yea; }
            ⎇ method == "read_file" { ⤺ yea; }
            ⎇ method == "write_file" { ⤺ yea; }
            ⎇ method == "parse" { ⤺ yea; }
            ⎇ method == "lower" { ⤺ yea; }
            ⎇ method == "resolve_tome_imports" { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "Lexer" {
            ⎇ method == "next_token" { ⤺ yea; }
            ⎇ method == "peek" { ⤺ yea; }
            ⎇ method == "peek_is_closure_indicator" { ⤺ yea; }
            ⎇ method == "peek_is_macro_delimiter" { ⤺ yea; }
            ⎇ method == "advance" { ⤺ yea; }
            ⎇ method == "match_char" { ⤺ yea; }
            ⎇ method == "skip_whitespace_and_comments" { ⤺ yea; }
            ⎇ method == "skip_line_comment" { ⤺ yea; }
            ⎇ method == "lex_ident_or_keyword" { ⤺ yea; }
            ⎇ method == "lex_string" { ⤺ yea; }
            ⎇ method == "lex_multiline_string" { ⤺ yea; }
            ⎇ method == "lex_char" { ⤺ yea; }
            ⎇ method == "lex_number" { ⤺ yea; }
            ⎇ method == "lex_raw_string" { ⤺ yea; }
            ⎇ method == "match_str" { ⤺ yea; }
            // All lex_* methods are vary this
            ⎇ method.starts_with("lex_") { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "Parser" {
            ⎇ method == "advance" { ⤺ yea; }
            ⎇ method == "consume_if" { ⤺ yea; }
            ⎇ method == "expect" { ⤺ yea; }
            ⎇ method == "expect_gt" { ⤺ yea; }
            ⎇ method == "is_closure_start" { ⤺ yea; }
            ⎇ method == "skip_extern_block" { ⤺ yea; }
            // All parse_* methods are vary this
            ⎇ method.starts_with("parse_") { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "TypeChecker" {
            ⎇ method == "register_builtins" { ⤺ yea; }
            ⎇ method == "fresh_var" { ⤺ yea; }
            ⎇ method == "freshen" { ⤺ yea; }
            ⎇ method == "freshen_inner" { ⤺ yea; }
            ⎇ method == "push_scope" { ⤺ yea; }
            ⎇ method == "pop_scope" { ⤺ yea; }
            ⎇ method == "error" { ⤺ yea; }
            ⎇ method == "check_evidence" { ⤺ yea; }
            ⎇ method == "check_file" { ⤺ yea; }
            ⎇ method == "unify" { ⤺ yea; }
            ⎇ method == "bind_pattern" { ⤺ yea; }
            // CG-122/123: infer_literal takes value this
            ⎇ method == "infer_literal" { ⤺ nay; }
            // All check_*, collect_*, infer_* methods are vary this
            ⎇ method.starts_with("check_") { ⤺ yea; }
            ⎇ method.starts_with("collect_") { ⤺ yea; }
            ⎇ method.starts_with("infer_") { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "CodeGen" {
            ⎇ method == "generate" { ⤺ yea; }
            ⎇ method == "fresh_temp" { ⤺ yea; }
            ⎇ method == "fresh_label" { ⤺ yea; }
            ⎇ method == "line" { ⤺ yea; }
            ⎇ method == "emit" { ⤺ yea; }
            ⎇ method == "line_open" { ⤺ yea; }
            ⎇ method == "line_close" { ⤺ yea; }
            ⎇ method == "indent_push" { ⤺ yea; }
            ⎇ method == "indent_pop" { ⤺ yea; }
            // CG-122/123: These emit_* methods take value this (not vary this)
            ⎇ method == "emit_binary_add" { ⤺ nay; }
            ⎇ method == "emit_binary_sub" { ⤺ nay; }
            ⎇ method == "emit_binary_mul" { ⤺ nay; }
            ⎇ method == "emit_binary_div" { ⤺ nay; }
            ⎇ method == "emit_binary_rem" { ⤺ nay; }
            ⎇ method == "emit_binary_ne" { ⤺ nay; }
            ⎇ method == "emit_binary_lt" { ⤺ nay; }
            ⎇ method == "emit_binary_le" { ⤺ nay; }
            ⎇ method == "emit_binary_gt" { ⤺ nay; }
            ⎇ method == "emit_binary_ge" { ⤺ nay; }
            ⎇ method == "emit_pattern_condition" { ⤺ nay; }
            // All other emit_* methods are vary this
            ⎇ method.starts_with("emit_") { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "Interpreter" {
            ⎇ method == "register_builtins" { ⤺ yea; }
            ⎇ method == "load_module" { ⤺ yea; }
            ⎇ method == "run" { ⤺ yea; }
            ⎇ method == "call_function" { ⤺ yea; }
            ⎇ method == "call_builtin" { ⤺ yea; }
            ⎇ method == "bind_pattern" { ⤺ yea; }
            // CG-122/123: These eval_* methods take value this (not vary this)
            ⎇ method == "eval_binary" { ⤺ nay; }
            ⎇ method == "eval_unary" { ⤺ nay; }
            // All other eval_* methods are vary this
            ⎇ method.starts_with("eval_") { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "LoweringContext" {
            ⎇ method == "fresh_id" { ⤺ yea; }
            ⎇ method == "error" { ⤺ yea; }
            ⎇ method == "get_var_id" { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "TypeEnv" {
            ⎇ method == "define" { ⤺ yea; }
            ⤺ nay;
        }
        // CG-150: Environment methods that take &this or vary this (need pointer)
        // CG-122/123: child is a static function (rite child(parent: Environment)), not a method
        ⎇ type_name == "Environment" {
            // clone takes this by value, not vary this
            ⎇ method == "clone" { ⤺ nay; }
            ⎇ method == "define" { ⤺ yea; }
            ⎇ method == "get" { ⤺ yea; }
            ⎇ method == "set" { ⤺ yea; }
            // child takes value this, not vary this
            ⎇ method == "child" { ⤺ nay; }
            ⤺ nay;
        }
        ⎇ type_name == "Arena" {
            ⎇ method == "alloc" { ⤺ yea; }
            ⎇ method == "reset" { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "Rc" {
            ⎇ method == "get_mut" { ⤺ yea; }
            ⎇ method == "drop" { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "StringInterner" {
            ⎇ method == "intern" { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "EvidenceContext" {
            ⎇ method == "check" { ⤺ yea; }
            ⎇ method == "clear" { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "CompileError" {
            ⎇ method == "with_span" { ⤺ yea; }
            ⎇ method == "with_file" { ⤺ yea; }
            ⎇ method == "with_note" { ⤺ yea; }
            ⎇ method == "with_source" { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "LowerError" {
            ⎇ method == "with_span" { ⤺ yea; }
            ⤺ nay;
        }
        ⎇ type_name == "TypeError" {
            ⎇ method == "with_span" { ⤺ yea; }
            ⎇ method == "with_note" { ⤺ yea; }
            ⤺ nay;
        }
        nay
    }

    // ========================================================================
    // Main Wrapper
    // ========================================================================

    rite emit_main_wrapper(vary this, has_main: !bool, main_has_args: !bool) {
        this.line("");
        this.line("/* Built-in function implementations */");
        this.line("#ifndef SIGIL_BUILTINS_DEFINED");
        this.line("#define SIGIL_BUILTINS_DEFINED");
        this.emit_builtin_impls();
        this.line("#end⎇ /* SIGIL_BUILTINS_DEFINED */");

        // Only emit main entry point ⎇ the module has a main function
        ⎇ has_main {
            this.line("");
            this.line("/* Main entry point */");
            this.line("int main(int argc, char** argv) {");
            this.indent_push();
            ⎇ main_has_args {
                this.line("/* Build args array from command line */");
                this.line("SigilValue args = sigil_Vec____new();");
                this.line("∀ (int i = 1; i < argc; i++) {");  // Skip argv[0] (program name)
                this.line("    args = sigil_push(args, sigil_string(argv[i]));");
                this.line("}");
                this.line("SigilValue result = sigil_main(args);");
            } ⎉ {
                this.line("(void)argc; (void)argv; /* unused */");
                this.line("SigilValue result = sigil_main();");
            }
            this.line("⤺ (result.tag == TAG_INT) ? (int)result.v.i : 0;");
            this.indent_pop();
            this.line("}");
        }
    }

    rite emit_builtin_impls(vary this) {
        // Forward declare SigilStruct ∀ sigil_display (full typedef comes later)
        this.line("typedef sigil { ◆ char* name; ◆ char** field_names; SigilValue* field_values; size_t num_fields; } SigilStruct;");
        this.line("");

        // sigil_format - variadic string formatting (like format! macro)
        this.line("SigilValue sigil_format(◆ char* fmt, ...) {");
        this.indent_push();
        this.line("va_list args;");
        this.line("va_start(args, fmt);");
        this.line("char buf[65536];");
        this.line("char* out = buf;");
        this.line("size_t remaining = sizeof(buf);");
        this.line("◆ char* p = fmt;");
        this.line("⟳ (*p ∧ remaining > 1) {");
        this.indent_push();
        this.line("⎇ (*p == '{' ∧ *(p+1) == '}') {");
        this.indent_push();
        this.line("SigilValue v = va_arg(args, SigilValue);");
        this.line("SigilValue s = sigil_display(v);");
        this.line("⎇ (s.tag == TAG_STRING ∧ s.v.s) {");
        this.indent_push();
        this.line("size_t len = strlen(s.v.s);");
        this.line("⎇ (len >= remaining) len = remaining - 1;");
        this.line("memcpy(out, s.v.s, len);");
        this.line("out += len; remaining -= len;");
        this.indent_pop();
        this.line("}");
        this.line("p += 2;");
        this.indent_pop();
        this.line("} ⎉ ⎇ (*p == '{' ∧ *(p+1) == ':') {");
        this.indent_push();
        this.line("// Skip format specifiers like {:?}");
        this.line("⟳ (*p ∧ *p != '}') p++;");
        this.line("⎇ (*p == '}') p++;");
        this.line("SigilValue v = va_arg(args, SigilValue);");
        this.line("SigilValue s = sigil_display(v);");
        this.line("⎇ (s.tag == TAG_STRING ∧ s.v.s) {");
        this.indent_push();
        this.line("size_t len = strlen(s.v.s);");
        this.line("⎇ (len >= remaining) len = remaining - 1;");
        this.line("memcpy(out, s.v.s, len);");
        this.line("out += len; remaining -= len;");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        // CG-098: Handle {{ → { (literal brace escape)
        this.line("} ⎉ ⎇ (*p == '{' ∧ *(p+1) == '{') {");
        this.indent_push();
        this.line("/* {{ → { (literal brace) */");
        this.line("*out++ = '{';");
        this.line("p += 2;");
        this.line("remaining--;");
        this.indent_pop();
        // CG-098: Handle }} → } (literal brace escape)
        this.line("} ⎉ ⎇ (*p == '}' ∧ *(p+1) == '}') {");
        this.indent_push();
        this.line("/* }} → } (literal brace) */");
        this.line("*out++ = '}';");
        this.line("p += 2;");
        this.line("remaining--;");
        this.indent_pop();
        this.line("} ⎉ {");
        this.indent_push();
        this.line("*out++ = *p++;");
        this.line("remaining--;");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("*out = '\\0';");
        this.line("va_end(args);");
        this.line("⤺ sigil_string(buf);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Note: print/println/eprint/eprintln are provided by user code (driver.sg)
        // sigil_display converts a value to its string representation
        this.line("SigilValue sigil_display(SigilValue v) {");
        this.indent_push();
        this.line("char buf[256];");
        this.line("switch (v.tag) {");
        this.indent_push();
        this.line("case TAG_STRING: ⤺ v;");
        this.line("case TAG_INT: snprintf(buf, sizeof(buf), \"%ld\", (long)v.v.i); ⊲;");
        this.line("case TAG_FLOAT: snprintf(buf, sizeof(buf), \"%g\", v.v.f); ⊲;");
        this.line("case TAG_BOOL: ⤺ sigil_string(v.v.b ? \"yea\" : \"nay\");");
        this.line("case TAG_CHAR: snprintf(buf, sizeof(buf), \"%c\", v.v.c); ⊲;");
        this.line("case TAG_NULL: ⤺ sigil_string(\"null\");");
        this.line("case TAG_UNIT: ⤺ sigil_string(\"()\");");
        this.line("case TAG_STRUCT: {");
        this.indent_push();
        this.line("SigilStruct* s = (SigilStruct*)v.v.ptr;");
        this.line("⎇ (!s) ⤺ sigil_string(\"<null-struct>\");");
        this.line("size_t total = strlen(s->name ? s->name : \"?\") + 4;");
        this.line("∀ (size_t i = 0; i < s->num_fields; i++) {");
        this.indent_push();
        this.line("total += strlen(s->field_names[i]) + 32;");
        this.indent_pop();
        this.line("}");
        this.line("char* out = (char*)malloc(total);");
        this.line("char* p = out;");
        this.line("p += sprintf(p, \"%s { \", s->name ? s->name : \"?\");");
        this.line("∀ (size_t i = 0; i < s->num_fields; i++) {");
        this.indent_push();
        this.line("⎇ (i > 0) p += sprintf(p, \", \");");
        this.line("SigilValue fv = sigil_display(s->field_values[i]);");
        this.line("p += sprintf(p, \"%s: %s\", s->field_names[i], fv.tag == TAG_STRING ∧ fv.v.s ? fv.v.s : \"?\");");
        this.indent_pop();
        this.line("}");
        this.line("sprintf(p, \" }\");");
        this.line("⤺ sigil_string(out);");
        this.indent_pop();
        this.line("}");
        this.line("case TAG_ARRAY: {");
        this.indent_push();
        this.line("size_t len = v.v.arr.len;");
        this.line("⎇ (len == 0) ⤺ sigil_string(\"[]\");");
        this.line("size_t total = 3 + len * 32;");
        this.line("char* out = (char*)malloc(total);");
        this.line("char* p = out;");
        this.line("*p++ = '[';");
        this.line("∀ (size_t i = 0; i < len; i++) {");
        this.indent_push();
        this.line("⎇ (i > 0) { *p++ = ','; *p++ = ' '; }");
        this.line("SigilValue ev = sigil_display(v.v.arr.data[i]);");
        this.line("⎇ (ev.tag == TAG_STRING ∧ ev.v.s) { size_t n = strlen(ev.v.s); memcpy(p, ev.v.s, n); p += n; }");
        this.indent_pop();
        this.line("}");
        this.line("*p++ = ']'; *p = 0;");
        this.line("⤺ sigil_string(out);");
        this.indent_pop();
        this.line("}");
        this.line("default: ⤺ sigil_string(\"<value>\");");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_string(buf);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Array length helper - reads from header ∀ accurate dynamic length
        this.line("#ifndef SIGIL_ARR_LEN_DEFINED");
        this.line("#define SIGIL_ARR_LEN_DEFINED");
        this.line("size_t sigil_arr_len(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag == TAG_ARRAY ∧ v.v.arr.data) {");
        this.indent_push();
        this.line("SigilArrayHeader* header = sigil_get_array_header(v.v.arr.data);");
        this.line("/* Validate header looks reasonable */");
        this.line("⎇ (header->cap > 0 ∧ header->cap < 10000000 ∧ header->len <= header->cap) {");
        this.indent_push();
        this.line("⤺ header->len;");
        this.indent_pop();
        this.line("}");
        this.line("⤺ v.v.arr.len; /* Fallback to sigil field */");
        this.indent_pop();
        this.line("}");
        this.line("⤺ 0;");
        this.indent_pop();
        this.line("}");
        this.line("#endif");
        this.line("");

        // Len
        this.line("SigilValue sigil_len(SigilValue v) {");
        this.indent_push();
        this.line("switch (v.tag) {");
        this.indent_push();
        this.line("case TAG_STRING: ⤺ sigil_int(strlen(v.v.s));");
        this.line("case TAG_ARRAY: ⤺ sigil_int(v.v.arr.len);");
        this.line("default: ⤺ sigil_int(0);");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_to_string - convert any value to a string
        this.line("SigilValue sigil_to_string(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag == TAG_STRING) ⤺ v;");
        this.line("⤺ sigil_display(v);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_clone - clone a value (shallow copy, structs are copy-by-value ∈ SigilValue)
        this.line("SigilValue sigil_clone(SigilValue v) {");
        this.indent_push();
        this.line("⤺ v; /* SigilValue is passed by value, shallow copy is sufficient */");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_contains - check ⎇ a collection contains an element (guarded)
        // CG-023: Handle TAG_REF parameters ∀ closure capture analysis
        this.line("#ifndef SIGIL_CONTAINS_DEFINED");
        this.line("#define SIGIL_CONTAINS_DEFINED");
        this.line("SigilValue sigil_contains(SigilValue collection, SigilValue element) {");
        this.indent_push();
        this.line("/* Dereference TAG_REF ∀ collection */");
        this.line("⟳ (collection.tag == TAG_REF ∧ collection.v.ptr) {");
        this.indent_push();
        this.line("collection = *((SigilValue*)collection.v.ptr);");
        this.indent_pop();
        this.line("}");
        this.line("/* Dereference TAG_REF ∀ element */");
        this.line("⟳ (element.tag == TAG_REF ∧ element.v.ptr) {");
        this.indent_push();
        this.line("element = *((SigilValue*)element.v.ptr);");
        this.indent_pop();
        this.line("}");
        this.line("⎇ (collection.tag == TAG_ARRAY) {");
        this.indent_push();
        this.line("∀ (size_t i = 0; i < sigil_arr_len(collection); i++) {");
        this.indent_push();
        this.line("⎇ (sigil_eq(collection.v.arr.data[i], element)) ⤺ sigil_bool(yea);");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("} ⎉ ⎇ (collection.tag == TAG_STRUCT) {");
        this.indent_push();
        this.line("/* Map is a sigil - check using Map get */");
        this.line("SigilValue result = sigil_Map____get(collection, element);");
        this.line("⤺ sigil_bool(result.tag != TAG_NULL);");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_bool(nay);");
        this.indent_pop();
        this.line("}");
        this.line("#end⎇ /* SIGIL_CONTAINS_DEFINED */");
        this.line("");

        // Vec push - dynamic array push with header support
        this.line("#ifndef SIGIL_VEC_PUSH_DEFINED");
        this.line("#define SIGIL_VEC_PUSH_DEFINED");
        this.line("SigilValue sigil_Vec____push(SigilValue v, SigilValue item) {");
        this.indent_push();
        this.line("⎇ (v.tag == TAG_ARRAY ∧ v.v.arr.data) {");
        this.indent_push();
        this.line("SigilArrayHeader* header = sigil_get_array_header(v.v.arr.data);");
        this.line("/* Safety check: skip push ⎇ header looks invalid */");
        this.line("⎇ (header->cap == 0 ∨ header->cap > 10000000 ∨ header->len > header->cap) {");
        this.indent_push();
        this.line("⤺ v; /* Return unchanged */");
        this.indent_pop();
        this.line("}");
        this.line("⎇ (header->len >= header->cap) {");
        this.indent_push();
        this.line("size_t new_cap = header->cap == 0 ? 4 : header->cap * 2;");
        this.line("SigilArrayHeader* new_header = (SigilArrayHeader*)realloc(header, SIGIL_ARRAY_DATA_OFFSET + new_cap * sizeof(SigilValue));");
        this.line("new_header->cap = new_cap;");
        this.line("header = new_header;");
        this.line("v.v.arr.data = (SigilValue*)sigil_array_data(header);");
        this.line("v.v.arr.cap = new_cap;");
        this.indent_pop();
        this.line("}");
        this.line("((SigilValue*)sigil_array_data(header))[header->len++] = item;");
        this.line("v.v.arr.len = header->len;");
        this.indent_pop();
        this.line("}");
        this.line("⤺ v;");
        this.indent_pop();
        this.line("}");
        this.line("#end⎇ /* SIGIL_VEC_PUSH_DEFINED */");
        this.line("");

        // CG-144: Vec as_slice - identity operation since Vec and slice have same representation
        this.line("#ifndef SIGIL_VEC_AS_SLICE_DEFINED");
        this.line("#define SIGIL_VEC_AS_SLICE_DEFINED");
        this.line("SigilValue sigil_Vec____as_slice(SigilValue v) { ⤺ v; }");
        this.line("#end⎇ /* SIGIL_VEC_AS_SLICE_DEFINED */");
        this.line("");

        // CG-144: Vec capacity - returns the capacity of an array
        this.line("#ifndef SIGIL_VEC_CAPACITY_DEFINED");
        this.line("#define SIGIL_VEC_CAPACITY_DEFINED");
        this.line("SigilValue sigil_Vec____capacity(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag == TAG_ARRAY) { ⤺ sigil_int((long long)v.v.arr.cap); }");
        this.line("⤺ sigil_int(0LL);");
        this.indent_pop();
        this.line("}");
        this.line("#end⎇ /* SIGIL_VEC_CAPACITY_DEFINED */");
        this.line("");

        // CG-144: Vec clear - clears the array by setting length to 0
        this.line("#ifndef SIGIL_VEC_CLEAR_DEFINED");
        this.line("#define SIGIL_VEC_CLEAR_DEFINED");
        this.line("SigilValue sigil_Vec____clear(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag == TAG_ARRAY) { v.v.arr.len = 0; }");
        this.line("⤺ v;");
        this.indent_pop();
        this.line("}");
        this.line("#end⎇ /* SIGIL_VEC_CLEAR_DEFINED */");
        this.line("");

        // CG-160: Vec clone - creates a shallow copy of an array
        this.line("#ifndef SIGIL_VEC_CLONE_DEFINED");
        this.line("#define SIGIL_VEC_CLONE_DEFINED");
        this.line("SigilValue sigil_Vec____clone(SigilValue v) {");
        this.indent_push();
        this.line("⤺ sigil_clone(v);");
        this.indent_pop();
        this.line("}");
        this.line("#end⎇ /* SIGIL_VEC_CLONE_DEFINED */");
        this.line("");

        // CG-160: Type clone - creates a shallow copy of a type
        this.line("#ifndef SIGIL_TYPE_CLONE_DEFINED");
        this.line("#define SIGIL_TYPE_CLONE_DEFINED");
        this.line("SigilValue sigil_Type____clone(SigilValue v) { ⤺ sigil_clone(v); }");
        this.line("#endif");
        this.line("");

        // CG-160: Environment clone - note: Rust codegen declares with SigilValue but calls with pointer
        // We provide both forms to handle this inconsistency
        this.line("#ifndef SIGIL_ENVIRONMENT_CLONE_DEFINED");
        this.line("#define SIGIL_ENVIRONMENT_CLONE_DEFINED");
        this.line("SigilValue sigil_Environment____clone(SigilValue v) { ⤺ sigil_clone(v); }");
        this.line("#endif");
        this.line("");

        // CG-144: String len - returns the length of a string
        this.line("#ifndef SIGIL_STRING_LEN_DEFINED");
        this.line("#define SIGIL_STRING_LEN_DEFINED");
        this.line("SigilValue sigil_String____len(SigilValue str) {");
        this.indent_push();
        this.line("⎇ (str.tag == TAG_STRING ∧ str.v.s) { ⤺ sigil_int((long long)strlen(str.v.s)); }");
        this.line("⤺ sigil_int(0LL);");
        this.indent_pop();
        this.line("}");
        this.line("#end⎇ /* SIGIL_STRING_LEN_DEFINED */");
        this.line("");

        // Iterator helpers - guarded to avoid conflict with build.sh prelude
        this.line("#ifndef SIGIL_ITER_DEFINED");
        this.line("#define SIGIL_ITER_DEFINED");
        this.line("static inline SigilValue sigil_iter(SigilValue v) { ⤺ v; }");
        this.line("static inline SigilValue sigil_collect(SigilValue v) { ⤺ v; }");
        this.line("static inline SigilValue sigil_enumerate(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag != TAG_ARRAY) ⤺ sigil_array(0);");
        this.line("SigilValue result = sigil_array(v.v.arr.len);");
        this.line("∀ (size_t i = 0; i < v.v.arr.len; i++) {");
        this.indent_push();
        this.line("SigilValue* fields = (SigilValue*)malloc(2 * sizeof(SigilValue));");
        this.line("fields[0] = sigil_int((long long)i);");
        this.line("fields[1] = v.v.arr.data[i];");
        this.line("result.v.arr.data[i] = (SigilValue){ .tag = TAG_TUPLE, .evidence = SIGIL_KNOWN, .v.tup = { .fields = fields, .count = 2 } };");
        this.indent_pop();
        this.line("}");
        this.line("⤺ result;");
        this.indent_pop();
        this.line("}");
        this.line("/* sigil_filter - keep elements matching predicate */");
        this.line("SigilValue sigil_filter(SigilValue v, SigilValue pred) {");
        this.indent_push();
        this.line("⎇ (v.tag != TAG_ARRAY ∨ !v.v.arr.data) ⤺ sigil_array(0);");
        this.line("SigilValue result = sigil_array(0);");
        this.line("result.v.arr.data = (SigilValue*)malloc(v.v.arr.len * sizeof(SigilValue));");
        this.line("result.v.arr.cap = v.v.arr.len;");
        this.line("result.v.arr.len = 0;");
        this.line("SigilValue (*fn)(SigilValue) = (SigilValue (*)(SigilValue))pred.v.ptr;");
        this.line("∀ (size_t i = 0; i < v.v.arr.len; i++) {");
        this.indent_push();
        this.line("SigilValue item = v.v.arr.data[i];");
        this.line("SigilValue keep = λ(item);");
        this.line("⎇ (sigil_truthy(keep)) {");
        this.indent_push();
        this.line("result.v.arr.data[result.v.arr.len++] = item;");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("⤺ result;");
        this.indent_pop();
        this.line("}");
        this.line("/* sigil_flat_map - map and flatten results */");
        this.line("SigilValue sigil_flat_map(SigilValue v, SigilValue mapper) {");
        this.indent_push();
        this.line("⎇ (v.tag != TAG_ARRAY ∨ !v.v.arr.data) ⤺ sigil_array(0);");
        this.line("/* First pass: count total elements */");
        this.line("size_t total = 0;");
        this.line("SigilValue (*fn)(SigilValue) = (SigilValue (*)(SigilValue))mapper.v.ptr;");
        this.line("∀ (size_t i = 0; i < v.v.arr.len; i++) {");
        this.indent_push();
        this.line("SigilValue mapped = λ(v.v.arr.data[i]);");
        this.line("⎇ (mapped.tag == TAG_ARRAY) total += mapped.v.arr.len;");
        this.line("⎉ total += 1;");
        this.indent_pop();
        this.line("}");
        this.line("/* Second pass: collect elements */");
        this.line("SigilValue result = sigil_array(total);");
        this.line("size_t idx = 0;");
        this.line("∀ (size_t i = 0; i < v.v.arr.len; i++) {");
        this.indent_push();
        this.line("SigilValue mapped = λ(v.v.arr.data[i]);");
        this.line("⎇ (mapped.tag == TAG_ARRAY) {");
        this.indent_push();
        this.line("∀ (size_t j = 0; j < mapped.v.arr.len; j++) {");
        this.indent_push();
        this.line("result.v.arr.data[idx++] = mapped.v.arr.data[j];");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("} ⎉ {");
        this.indent_push();
        this.line("result.v.arr.data[idx++] = mapped;");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("⤺ result;");
        this.indent_pop();
        this.line("}");
        this.line("#end⎇ /* SIGIL_ITER_DEFINED */");
        this.line("");

        // HashMap Entry API implementation
        this.line("#ifndef SIGIL_ENTRY_API_DEFINED");
        this.line("#define SIGIL_ENTRY_API_DEFINED");
        this.line("/* sigil_map_entry_or_default - get or insert default ∀ key */");
        this.line("SigilValue sigil_map_entry_or_default(SigilValue map, SigilValue key) {");
        this.indent_push();
        this.line("/* Check ⎇ key exists */");
        this.line("SigilValue existing = sigil_Map____get(map, key);");
        this.line("⎇ (existing.tag != TAG_NULL) {");
        this.indent_push();
        this.line("⤺ existing;");
        this.indent_pop();
        this.line("}");
        this.line("/* Insert default value (empty array ∀ most common case) */");
        this.line("SigilValue def = sigil_array(0);");
        this.line("sigil_Map____insert(map, key, def);");
        this.line("⤺ sigil_Map____get(map, key);");
        this.indent_pop();
        this.line("}");
        this.line("/* sigil_map_entry_or_insert - get or insert specific value ∀ key */");
        this.line("SigilValue sigil_map_entry_or_insert(SigilValue map, SigilValue key, SigilValue value) {");
        this.indent_push();
        this.line("SigilValue existing = sigil_Map____get(map, key);");
        this.line("⎇ (existing.tag != TAG_NULL) {");
        this.indent_push();
        this.line("⤺ existing;");
        this.indent_pop();
        this.line("}");
        this.line("sigil_Map____insert(map, key, value);");
        this.line("⤺ sigil_Map____get(map, key);");
        this.indent_pop();
        this.line("}");
        this.line("/* sigil_map_entry_or_insert_with - get or insert closure result ∀ key */");
        this.line("SigilValue sigil_map_entry_or_insert_with(SigilValue map, SigilValue key, SigilValue closure) {");
        this.indent_push();
        this.line("SigilValue existing = sigil_Map____get(map, key);");
        this.line("⎇ (existing.tag != TAG_NULL) {");
        this.indent_push();
        this.line("⤺ existing;");
        this.indent_pop();
        this.line("}");
        this.line("/* Call closure to get default value */");
        this.line("SigilValue (*fn)(void) = (SigilValue (*)(void))closure.v.ptr;");
        this.line("SigilValue value = rite ? λ() : sigil_unit();");
        this.line("sigil_Map____insert(map, key, value);");
        this.line("⤺ sigil_Map____get(map, key);");
        this.indent_pop();
        this.line("}");
        this.line("#end⎇ /* SIGIL_ENTRY_API_DEFINED */");
        this.line("");

        // sigil_join implementation (with guard) - includes pointer validation
        this.line("#ifndef SIGIL_JOIN_DEFINED");
        this.line("#define SIGIL_JOIN_DEFINED");
        this.line("#include <stdint.h>");
        this.line("static inline int sigil_join_valid_ptr(◆ char* p) {");
        this.indent_push();
        this.line("⎇ (!p) ⤺ 0;");
        this.line("uintptr_t addr = (uintptr_t)p;");
        this.line("⎇ (addr < 0x10000) ⤺ 0;  /* Low address = likely corrupted */");
        this.line("⎇ (addr > 0x7FFFFFFFFFFF) ⤺ 0;  /* Beyond user space */");
        this.line("⤺ 1;");
        this.indent_pop();
        this.line("}");
        this.line("SigilValue sigil_join(SigilValue arr, SigilValue sep) {");
        this.indent_push();
        this.line("⎇ (arr.tag != TAG_ARRAY ∨ !arr.v.arr.data) ⤺ sigil_string(\"\");");
        this.line("size_t arr_len = sigil_arr_len(arr);");
        this.line("⎇ (arr_len == 0) ⤺ sigil_string(\"\");");
        this.line("⎇ (arr_len > 100000) ⤺ sigil_string(\"\");  /* Sanity check */");
        this.line("size_t total = 0;");
        this.line("◆ char* sep_str = (sep.tag == TAG_STRING ∧ sigil_join_valid_ptr(sep.v.s)) ? sep.v.s : \"\";");
        this.line("size_t sep_len = strlen(sep_str);");
        this.line("∀ (size_t i = 0; i < arr_len; i++) {");
        this.indent_push();
        this.line("SigilValue item = arr.v.arr.data[i];");
        this.line("⎇ (item.tag == TAG_STRING ∧ sigil_join_valid_ptr(item.v.s)) total += strlen(item.v.s);");
        this.line("⎇ (i > 0) total += sep_len;");
        this.indent_pop();
        this.line("}");
        this.line("char* result = (char*)malloc(total + 1);");
        this.line("⎇ (!result) ⤺ sigil_string(\"\");");
        this.line("result[0] = '\\0';");
        this.line("∀ (size_t i = 0; i < arr_len; i++) {");
        this.indent_push();
        this.line("⎇ (i > 0) strcat(result, sep_str);");
        this.line("SigilValue item = arr.v.arr.data[i];");
        this.line("⎇ (item.tag == TAG_STRING ∧ sigil_join_valid_ptr(item.v.s)) strcat(result, item.v.s);");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_string(result);");
        this.indent_pop();
        this.line("}");
        this.line("#end⎇ /* SIGIL_JOIN_DEFINED */");
        this.line("");

        // Math builtins
        this.line("SigilValue sigil_abs(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag == TAG_INT) ⤺ sigil_int(v.v.i < 0 ? -v.v.i : v.v.i);");
        this.line("⤺ sigil_float(fabs(v.v.f));");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_sqrt(SigilValue v) {");
        this.indent_push();
        this.line("double x = v.tag == TAG_INT ? (double)v.v.i : v.v.f;");
        this.line("⤺ sigil_float(sqrt(x));");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_sin(SigilValue v) {");
        this.indent_push();
        this.line("double x = v.tag == TAG_INT ? (double)v.v.i : v.v.f;");
        this.line("⤺ sigil_float(sin(x));");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_cos(SigilValue v) {");
        this.indent_push();
        this.line("double x = v.tag == TAG_INT ? (double)v.v.i : v.v.f;");
        this.line("⤺ sigil_float(cos(x));");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_pow(SigilValue base, SigilValue exp) {");
        this.indent_push();
        this.line("double b = base.tag == TAG_INT ? (double)base.v.i : base.v.f;");
        this.line("double e = exp.tag == TAG_INT ? (double)exp.v.i : exp.v.f;");
        this.line("⤺ sigil_float(pow(b, e));");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Assert
        this.line("SigilValue sigil_assert(SigilValue cond, SigilValue msg) {");
        this.indent_push();
        this.line("⎇ (!sigil_truthy(cond)) {");
        this.indent_push();
        this.line("fprintf(stderr, \"Assertion failed: %s\\n\", msg.tag == TAG_STRING ? msg.v.s : \"<no message>\");");
        this.line("exit(1);");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_unit();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_assert_eq(SigilValue a, SigilValue b) {");
        this.indent_push();
        this.line("⎇ (!sigil_eq(a, b)) {");
        this.indent_push();
        this.line("fprintf(stderr, \"Assertion failed: values not equal\\n\");");
        this.line("exit(1);");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_unit();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_panic(SigilValue msg) {");
        this.indent_push();
        this.line("fprintf(stderr, \"panic: %s\\n\", msg.tag == TAG_STRING ? msg.v.s : \"<no message>\");");
        this.line("exit(1);");
        this.line("⤺ sigil_unit(); /* unreachable */");
        this.indent_pop();
        this.line("}");
        this.line("");

        // String concat
        this.line("SigilValue sigil_concat(SigilValue a, SigilValue b) {");
        this.indent_push();
        this.line("⎇ (a.tag == TAG_STRING ∧ b.tag == TAG_STRING) {");
        this.indent_push();
        this.line("size_t len = strlen(a.v.s) + strlen(b.v.s) + 1;");
        this.line("char* s = (char*)malloc(len);");
        this.line("strcpy(s, a.v.s);");
        this.line("strcat(s, b.v.s);");
        this.line("⤺ (SigilValue){ .tag = TAG_STRING, .evidence = SIGIL_KNOWN, .v.s = s };");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_null();");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Struct helpers (SigilStruct typedef is at the top of emit_builtin_impls)

        this.line("SigilValue sigil_struct(◆ char* name, ◆ char** names, SigilValue* values, size_t n) {");
        this.indent_push();
        this.line("SigilStruct* s = (SigilStruct*)malloc(sizeof(SigilStruct));");
        this.line("s->name = name;");
        this.line("s->field_names = names;");
        this.line("s->field_values = (SigilValue*)malloc(n * sizeof(SigilValue));");
        this.line("∀ (size_t i = 0; i < n; i++) s->field_values[i] = values[i];");
        this.line("s->num_fields = n;");
        this.line("⤺ (SigilValue){ .tag = TAG_STRUCT, .evidence = SIGIL_KNOWN, .v.ptr = s };");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_struct_field(SigilValue v, ◆ char* field) {");
        this.indent_push();
        this.line("⎇ (v.tag != TAG_STRUCT) ⤺ sigil_null();");
        this.line("SigilStruct* s = (SigilStruct*)v.v.ptr;");
        this.line("∀ (size_t i = 0; i < s->num_fields; i++) {");
        this.indent_push();
        this.line("⎇ (strcmp(s->field_names[i], field) == 0) ⤺ s->field_values[i];");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_null();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_struct_set_field(SigilValue* v, ◆ char* field, SigilValue val) {");
        this.indent_push();
        this.line("⎇ (v->tag != TAG_STRUCT) ⤺ sigil_unit();");
        this.line("SigilStruct* s = (SigilStruct*)v->v.ptr;");
        this.line("∀ (size_t i = 0; i < s->num_fields; i++) {");
        this.indent_push();
        this.line("⎇ (strcmp(s->field_names[i], field) == 0) { s->field_values[i] = val; ⤺ sigil_unit(); }");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_unit();");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_is_struct_variant - check ⎇ a value is a sigil with a specific name
        this.line("int sigil_is_struct_variant(SigilValue v, ◆ char* name) {");
        this.indent_push();
        this.line("/* Dereference TAG_REF ⎇ needed */");
        this.line("⟳ (v.tag == TAG_REF ∧ v.v.ptr) {");
        this.indent_push();
        this.line("v = *((SigilValue*)v.v.ptr);");
        this.indent_pop();
        this.line("}");
        this.line("⎇ (v.tag != TAG_STRUCT) ⤺ 0;");
        this.line("SigilStruct* s = (SigilStruct*)v.v.ptr;");
        this.line("⤺ s ∧ s->name ∧ strcmp(s->name, name) == 0;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_is_enum_variant - check ⎇ a value is an ᛈ variant (handles both TAG_STRUCT and TAG_ENUM)
        this.line("int sigil_is_enum_variant(SigilValue v, ◆ char* name) {");
        this.indent_push();
        this.line("/* Dereference TAG_REF ⎇ needed */");
        this.line("⟳ (v.tag == TAG_REF ∧ v.v.ptr) {");
        this.indent_push();
        this.line("v = *((SigilValue*)v.v.ptr);");
        this.indent_pop();
        this.line("}");
        this.line("/* Try TAG_STRUCT representation first (native compiler style) */");
        this.line("⎇ (v.tag == TAG_STRUCT) {");
        this.indent_push();
        this.line("SigilStruct* s = (SigilStruct*)v.v.ptr;");
        this.line("⤺ s ∧ s->name ∧ strcmp(s->name, name) == 0;");
        this.indent_pop();
        this.line("}");
        this.line("/* TAG_ENUM: check variant name suffix matches */");
        this.line("⎇ (v.tag == TAG_ENUM) {");
        this.indent_push();
        this.line("/* For enums, we can only do a best-effort ⌥ on variant name */");
        this.line("/* The name format is 'EnumName·VariantName' */");
        this.line("⤺ 1; /* TODO: proper ᛈ variant matching */");
        this.indent_pop();
        this.line("}");
        this.line("⤺ 0;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_enum_eq - compare two ᛈ values ∀ equality
        this.line("int sigil_enum_eq(SigilValue a, SigilValue b) {");
        this.indent_push();
        this.line("/* Dereference TAG_REF ⎇ needed */");
        this.line("⟳ (a.tag == TAG_REF ∧ a.v.ptr) a = *((SigilValue*)a.v.ptr);");
        this.line("⟳ (b.tag == TAG_REF ∧ b.v.ptr) b = *((SigilValue*)b.v.ptr);");
        this.line("/* Both must be TAG_ENUM */");
        this.line("⎇ (a.tag != TAG_ENUM ∨ b.tag != TAG_ENUM) ⤺ 0;");
        this.line("/* Compare enum_id and variant */");
        this.line("⤺ a.v.e.enum_id == b.v.e.enum_id ∧ a.v.e.variant == b.v.e.variant;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Tuple helper
        this.line("SigilValue sigil_tuple(SigilValue* fields, size_t n) {");
        this.indent_push();
        this.line("SigilValue* data = (SigilValue*)malloc(n * sizeof(SigilValue));");
        this.line("∀ (size_t i = 0; i < n; i++) data[i] = fields[i];");
        this.line("SigilValue v = { .tag = TAG_TUPLE, .evidence = SIGIL_KNOWN };");
        this.line("v.v.tup.fields = data;");
        this.line("v.v.tup.count = n;");
        this.line("⤺ v;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Option helpers - using a tagged variant representation
        // We invoke TAG_NULL ∀ None and a wrapper sigil ∀ Some
        this.line("/* Option helpers */");
        this.line("◆ SigilValue Option____None = { .tag = TAG_NULL, .evidence = SIGIL_KNOWN };");
        this.line("");
        this.line("SigilValue sigil_Option____Some(SigilValue v) {");
        this.indent_push();
        this.line("SigilValue* inner = (SigilValue*)malloc(sizeof(SigilValue));");
        this.line("*inner = v;");
        this.line("⤺ (SigilValue){ .tag = TAG_OPTION_SOME, .evidence = SIGIL_KNOWN, .v.ptr = inner };");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_is_some(SigilValue v) {");
        this.indent_push();
        this.line("⤺ sigil_bool(v.tag == TAG_OPTION_SOME);");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_is_none(SigilValue v) {");
        this.indent_push();
        this.line("⤺ sigil_bool(v.tag == TAG_NULL ∨ v.tag == TAG_OPTION_NONE);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // CG-201: Additional Option/Result/Vec/String runtime functions ∀ this-hosting
        this.line("SigilValue sigil_Option____unwrap(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag == TAG_OPTION_SOME ∧ v.v.ptr) ⤺ *((SigilValue*)v.v.ptr);");
        this.line("⎇ (v.tag != TAG_NULL ∧ v.tag != TAG_UNIT) ⤺ v;");
        this.line("⤺ sigil_null();");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_Option____unwrap_or(SigilValue opt, SigilValue def) {");
        this.indent_push();
        this.line("⎇ (opt.tag == TAG_OPTION_SOME ∧ opt.v.ptr) ⤺ *((SigilValue*)opt.v.ptr);");
        this.line("⎇ (opt.tag == TAG_NULL ∨ opt.tag == TAG_UNIT) ⤺ def;");
        this.line("⤺ opt;");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_Option____is_some(SigilValue v) { ⤺ sigil_bool(v.tag == TAG_OPTION_SOME ∨ (v.tag != TAG_NULL ∧ v.tag != TAG_UNIT)); }");
        this.line("SigilValue sigil_Vec____with_capacity(SigilValue cap) { ⤺ sigil_array((size_t)cap.v.i); }");
        this.line("SigilValue sigil_Vec____len(SigilValue v) { ⤺ sigil_len(v); }");
        this.line("SigilValue sigil_max(SigilValue a, SigilValue b) { ⤺ a.v.i > b.v.i ? a : b; }");
        this.line("SigilValue sigil_as_mut_ptr(SigilValue v) { ⤺ v; }");
        this.line("SigilValue sigil_Box____from_raw(SigilValue ptr) { ⤺ ptr; }");
        this.line("SigilValue sigil_Box____into_raw(SigilValue b) { ⤺ b; }");
        // sigil_sb_finalize implementation
        this.line("SigilValue sigil_sb_finalize(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag == TAG_STRINGBUILDER) {");
        this.indent_push();
        this.line("StringBuilder* sb = (StringBuilder*)v.v.ptr;");
        this.line("char* str = sb_to_string(sb);");
        this.line("⤺ (SigilValue){ .tag = TAG_STRING, .evidence = v.evidence, .v.s = str };");
        this.indent_pop();
        this.line("}");
        this.line("⤺ v;");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_String____as_str(SigilValue s) { ⤺ s; }");
        // CG-XXX: Clone - emit as multiline to avoid runtime bug with long strings
        this.line("SigilValue sigil_String____clone(SigilValue s) {");
        this.line("    ⎇ (s.tag == TAG_STRING ∧ s.v.s) ⤺ sigil_string(s.v.s);");
        this.line("    ⤺ s;");
        this.line("}");
        // sigil_String____new is defined later with SigilStringBuilder
        // CG-XXX: is_empty - emit as multiline to avoid runtime bug
        this.line("SigilValue sigil_String____is_empty(SigilValue s) {");
        this.line("    ⎇ (s.tag != TAG_STRING) ⤺ sigil_bool(yea);");
        this.line("    ⎇ (!s.v.s) ⤺ sigil_bool(yea);");
        this.line("    ⤺ sigil_bool(s.v.s[0] == 0);");
        this.line("}");
        this.line("SigilValue sigil_rank(SigilValue v) { ⤺ sigil_int(v.evidence); }");
        this.line("SigilValue sigil_Result____Ok(SigilValue v) { SigilValue* inner = (SigilValue*)malloc(sizeof(SigilValue)); *inner = v; ⤺ (SigilValue){ .tag = TAG_RESULT_OK, .evidence = SIGIL_KNOWN, .v.ptr = inner }; }");
        this.line("SigilValue sigil_Result____Err(SigilValue v) { SigilValue* inner = (SigilValue*)malloc(sizeof(SigilValue)); *inner = v; ⤺ (SigilValue){ .tag = TAG_RESULT_ERR, .evidence = SIGIL_KNOWN, .v.ptr = inner }; }");
        this.line("SigilValue sigil_Result____ok(SigilValue r) { ⤺ sigil_bool(r.tag == TAG_RESULT_OK); }");
        this.line("");
        this.line("SigilValue sigil_any_truthy(SigilValue arr) {");
        this.indent_push();
        this.line("⎇ (arr.tag != TAG_ARRAY ∨ !arr.v.arr.data) ⤺ sigil_bool(nay);");
        this.line("∀ (size_t i = 0; i < arr.v.arr.len; i++) { ⎇ (sigil_truthy(arr.v.arr.data[i])) ⤺ sigil_bool(yea); }");
        this.line("⤺ sigil_bool(nay);");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_skip(SigilValue arr, SigilValue n) {");
        this.indent_push();
        this.line("⎇ (arr.tag != TAG_ARRAY ∨ !arr.v.arr.data) ⤺ sigil_array(0);");
        this.line("size_t skip = (size_t)n.v.i;");
        this.line("⎇ (skip >= arr.v.arr.len) ⤺ sigil_array(0);");
        this.line("SigilValue result = sigil_array(arr.v.arr.len - skip);");
        this.line("∀ (size_t i = 0; i < arr.v.arr.len - skip; i++) result.v.arr.data[i] = arr.v.arr.data[i + skip];");
        this.line("⤺ result;");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_with_note(SigilValue v, SigilValue note) { (void)note; ⤺ v; }");
        this.line("SigilValue sigil_char_at(SigilValue s, SigilValue idx) { ⤺ (s.tag == TAG_STRING ∧ s.v.s ∧ (size_t)idx.v.i < strlen(s.v.s)) ? sigil_char(s.v.s[idx.v.i]) : sigil_null(); }");
        this.line("");
        this.line("SigilValue sigil_String____chars(SigilValue s) {");
        this.indent_push();
        this.line("⎇ (s.tag != TAG_STRING ∨ !s.v.s) ⤺ sigil_array(0);");
        this.line("size_t len = strlen(s.v.s);");
        this.line("SigilValue arr = sigil_array(len);");
        this.line("∀ (size_t i = 0; i < len; i++) arr.v.arr.data[i] = sigil_char(s.v.s[i]);");
        this.line("⤺ arr;");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_Vec____pop(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag != TAG_ARRAY ∨ !v.v.arr.data ∨ v.v.arr.len == 0) ⤺ sigil_null();");
        this.line("⤺ v.v.arr.data[--v.v.arr.len];");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_Vec____extend(SigilValue dst, SigilValue src) {");
        this.indent_push();
        this.line("⎇ (src.tag != TAG_ARRAY ∨ !src.v.arr.data) ⤺ dst;");
        this.line("∀ (size_t i = 0; i < src.v.arr.len; i++) dst = sigil_Vec____push(dst, src.v.arr.data[i]);");
        this.line("⤺ dst;");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_String____contains(SigilValue s, SigilValue sub) {");
        this.indent_push();
        this.line("⎇ (s.tag != TAG_STRING ∨ sub.tag != TAG_STRING) ⤺ sigil_bool(nay);");
        this.line("⎇ (!s.v.s ∨ !sub.v.s) ⤺ sigil_bool(nay);");
        this.line("⤺ sigil_bool(strstr(s.v.s, sub.v.s) != NULL);");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_String____ends_with(SigilValue s, SigilValue suffix) {");
        this.indent_push();
        this.line("⎇ (s.tag != TAG_STRING ∨ suffix.tag != TAG_STRING) ⤺ sigil_bool(nay);");
        this.line("⎇ (!s.v.s ∨ !suffix.v.s) ⤺ sigil_bool(nay);");
        this.line("size_t slen = strlen(s.v.s), plen = strlen(suffix.v.s);");
        this.line("⎇ (plen > slen) ⤺ sigil_bool(nay);");
        this.line("⤺ sigil_bool(strcmp(s.v.s + slen - plen, suffix.v.s) == 0);");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_String____strip_prefix(SigilValue s, SigilValue prefix) {");
        this.indent_push();
        this.line("⎇ (s.tag != TAG_STRING ∨ prefix.tag != TAG_STRING) ⤺ sigil_null();");
        this.line("⎇ (!s.v.s ∨ !prefix.v.s) ⤺ sigil_null();");
        this.line("size_t plen = strlen(prefix.v.s);");
        this.line("⎇ (strncmp(s.v.s, prefix.v.s, plen) != 0) ⤺ sigil_null();");
        this.line("⤺ sigil_Option____Some(sigil_string(s.v.s + plen));");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_Map____entries(SigilValue map) {");
        this.indent_push();
        this.line("⎇ (map.tag != TAG_MAP) ⤺ sigil_array(0);");
        this.line("⤺ sigil_array(0); /* TODO: implement properly */");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("SigilValue sigil_CrateConfig____default(void) { ⤺ sigil_struct(\"CrateConfig\", NULL, NULL, 0); }");
        this.line("SigilValue sigil_FunctionAttrs____default(void) { ⤺ sigil_struct(\"FunctionAttrs\", NULL, NULL, 0); }");
        this.line("SigilValue sigil_StructAttrs____default(void) { ⤺ sigil_struct(\"StructAttrs\", NULL, NULL, 0); }");
        this.line("");

        // String case conversion
        this.line("SigilValue sigil_String____to_uppercase(SigilValue s) {");
        this.indent_push();
        this.line("⎇ (s.tag != TAG_STRING ∨ !s.v.s) ⤺ sigil_string(\"\");");
        this.line("size_t len = strlen(s.v.s);");
        this.line("char* result = (char*)malloc(len + 1);");
        this.line("∀ (size_t i = 0; i < len; i++) {");
        this.indent_push();
        this.line("result[i] = (s.v.s[i] >= 'a' ∧ s.v.s[i] <= 'z') ? s.v.s[i] - 32 : s.v.s[i];");
        this.indent_pop();
        this.line("}");
        this.line("result[len] = '\\0';");
        this.line("⤺ sigil_string(result);");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_String____to_lowercase(SigilValue s) {");
        this.indent_push();
        this.line("⎇ (s.tag != TAG_STRING ∨ !s.v.s) ⤺ sigil_string(\"\");");
        this.line("size_t len = strlen(s.v.s);");
        this.line("char* result = (char*)malloc(len + 1);");
        this.line("∀ (size_t i = 0; i < len; i++) {");
        this.indent_push();
        this.line("result[i] = (s.v.s[i] >= 'A' ∧ s.v.s[i] <= 'Z') ? s.v.s[i] + 32 : s.v.s[i];");
        this.indent_pop();
        this.line("}");
        this.line("result[len] = '\\0';");
        this.line("⤺ sigil_string(result);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // I/O functions - println, print
        this.line("/* I/O functions */");
        this.line("SigilValue sigil_println(SigilValue v) {");
        this.indent_push();
        this.line("SigilValue s = sigil_display(v);");
        this.line("⎇ (s.tag == TAG_STRING ∧ s.v.s) { printf(\"%s\\n\", s.v.s); }");
        this.line("⎉ { printf(\"<value>\\n\"); }");
        this.line("⤺ sigil_unit();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_print(SigilValue v) {");
        this.indent_push();
        this.line("SigilValue s = sigil_display(v);");
        this.line("⎇ (s.tag == TAG_STRING ∧ s.v.s) { printf(\"%s\", s.v.s); }");
        this.line("⤺ sigil_unit();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_eprintln(SigilValue v) {");
        this.indent_push();
        this.line("SigilValue s = sigil_display(v);");
        this.line("⎇ (s.tag == TAG_STRING ∧ s.v.s) { fprintf(stderr, \"%s\\n\", s.v.s); }");
        this.line("⤺ sigil_unit();");
        this.indent_pop();
        this.line("}");
        this.line("");

        // File I/O functions ∀ FFI
        this.line("/* File I/O functions ∀ FFI */");
        this.line("static size_t __sigil_last_file_len = 0;");
        this.line("");

        this.line("SigilValue sigil_read_file(SigilValue path, SigilValue len) {");
        this.indent_push();
        this.line("⎇ (path.tag != TAG_STRING ∨ !path.v.s) ⤺ sigil_null();");
        this.line("FILE* f = fopen(path.v.s, \"rb\");");
        this.line("⎇ (!f) ⤺ sigil_null();");
        this.line("fseek(f, 0, SEEK_END);");
        this.line("size_t size = ftell(f);");
        this.line("fseek(f, 0, SEEK_SET);");
        this.line("char* buf = (char*)malloc(size + 1);");
        this.line("fread(buf, 1, size, f);");
        this.line("buf[size] = '\\0';");
        this.line("fclose(f);");
        this.line("__sigil_last_file_len = size;");
        this.line("⤺ sigil_string(buf);");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_file_len(void) {");
        this.indent_push();
        this.line("⤺ sigil_int(__sigil_last_file_len);");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_write_file(SigilValue path, SigilValue path_len, SigilValue content, SigilValue content_len) {");
        this.indent_push();
        this.line("(void)path_len; (void)content_len; /* length params unused - null-terminated */");
        this.line("⎇ (path.tag != TAG_STRING ∨ !path.v.s) ⤺ sigil_bool(nay);");
        this.line("⎇ (content.tag != TAG_STRING ∨ !content.v.s) ⤺ sigil_bool(nay);");
        this.line("FILE* f = fopen(path.v.s, \"w\");");
        this.line("⎇ (!f) ⤺ sigil_bool(nay);");
        this.line("fputs(content.v.s, f);");
        this.line("fclose(f);");
        this.line("⤺ sigil_bool(yea);");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_String____from_raw_parts(SigilValue ptr, SigilValue len, SigilValue cap) {");
        this.indent_push();
        this.line("(void)cap; /* capacity unused */");
        this.line("⎇ (ptr.tag != TAG_STRING) ⤺ sigil_string(\"\");");
        this.line("/* ptr already contains the string from sigil_read_file */");
        this.line("⤺ ptr;");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_with_span(SigilValue err, SigilValue span) {");
        this.indent_push();
        this.line("/* Add span info to error - ∀ now just ⤺ unchanged */");
        this.line("(void)span;");
        this.line("⤺ err;");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_as_ptr(SigilValue s) {");
        this.indent_push();
        this.line("/* Return the string pointer wrapped as a SigilValue - used ∀ FFI */");
        this.line("⎇ (s.tag == TAG_STRING) ⤺ s;");
        this.line("⤺ sigil_null();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_is_null(SigilValue v) {");
        this.indent_push();
        this.line("⤺ sigil_bool(v.tag == TAG_NULL);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Map functions - simple hash map implementation
        this.line("/* Map functions - stub implementation */");
        this.line("SigilValue sigil_Map____new(void) {");
        this.indent_push();
        this.line("/* Stub: maps not fully implemented yet */");
        this.line("⤺ sigil_null();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_Map____get(SigilValue m, SigilValue key) {");
        this.indent_push();
        this.line("/* Stub: ⤺ null ∀ now */");
        this.line("(void)m; (void)key;");
        this.line("⤺ sigil_null();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_Map____insert(SigilValue m, SigilValue key, SigilValue val) {");
        this.indent_push();
        this.line("/* Stub: no-op ∀ now */");
        this.line("(void)m; (void)key; (void)val;");
        this.line("⤺ sigil_unit();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_Map____contains(SigilValue m, SigilValue key) {");
        this.indent_push();
        this.line("/* Stub: always ⤺ nay */");
        this.line("(void)m; (void)key;");
        this.line("⤺ sigil_bool(nay);");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_Map____contains_key(SigilValue m, SigilValue key) {");
        this.indent_push();
        this.line("/* Stub: always ⤺ nay */");
        this.line("(void)m; (void)key;");
        this.line("⤺ sigil_bool(nay);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Vec functions
        this.line("/* Vec functions */");
        this.line("SigilValue sigil_Vec____new(void) {");
        this.indent_push();
        this.line("⤺ sigil_array(0);");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_Vec____first(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag == TAG_ARRAY ∧ v.v.arr.len > 0) ⤺ v.v.arr.data[0];");
        this.line("⤺ sigil_null();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_Vec____last(SigilValue v) {");
        this.indent_push();
        this.line("⎇ (v.tag == TAG_ARRAY ∧ v.v.arr.len > 0) ⤺ v.v.arr.data[v.v.arr.len - 1];");
        this.line("⤺ sigil_null();");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_Vec____join(SigilValue arr, SigilValue sep) {");
        this.indent_push();
        this.line("⎇ (arr.tag != TAG_ARRAY) ⤺ sigil_string(\"\");");
        this.line("⎇ (arr.v.arr.len == 0) ⤺ sigil_string(\"\");");
        this.line("◆ char* sep_str = (sep.tag == TAG_STRING ∧ sep.v.s) ? sep.v.s : \"\";");
        this.line("size_t total_len = 0;");
        this.line("size_t sep_len = strlen(sep_str);");
        this.line("∀ (size_t i = 0; i < arr.v.arr.len; i++) {");
        this.indent_push();
        this.line("SigilValue s = sigil_display(arr.v.arr.data[i]);");
        this.line("⎇ (s.tag == TAG_STRING ∧ s.v.s) total_len += strlen(s.v.s);");
        this.line("⎇ (i > 0) total_len += sep_len;");
        this.indent_pop();
        this.line("}");
        this.line("char* result = (char*)malloc(total_len + 1);");
        this.line("result[0] = '\\0';");
        this.line("∀ (size_t i = 0; i < arr.v.arr.len; i++) {");
        this.indent_push();
        this.line("⎇ (i > 0) strcat(result, sep_str);");
        this.line("SigilValue s = sigil_display(arr.v.arr.data[i]);");
        this.line("⎇ (s.tag == TAG_STRING ∧ s.v.s) strcat(result, s.v.s);");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_string(result);");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_push(SigilValue arr, SigilValue item) {");
        this.indent_push();
        this.line("⎇ (arr.tag != TAG_ARRAY ∨ !arr.v.arr.data) ⤺ arr;");
        this.line("SigilArrayHeader* header = sigil_get_array_header(arr.v.arr.data);");
        this.line("⎇ (header->cap == 0 ∨ header->cap > 10000000 ∨ header->len > header->cap) ⤺ arr;");
        this.line("⎇ (header->len >= header->cap) {");
        this.indent_push();
        this.line("size_t new_cap = header->cap == 0 ? 4 : header->cap * 2;");
        this.line("SigilArrayHeader* new_header = (SigilArrayHeader*)realloc(header, SIGIL_ARRAY_DATA_OFFSET + new_cap * sizeof(SigilValue));");
        this.line("new_header->cap = new_cap; header = new_header;");
        this.line("arr.v.arr.data = (SigilValue*)sigil_array_data(header); arr.v.arr.cap = new_cap;");
        this.indent_pop();
        this.line("}");
        this.line("((SigilValue*)sigil_array_data(header))[header->len++] = item;");
        this.line("arr.v.arr.len = header->len;");
        this.line("⤺ arr;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // zip and all ∀ iterator operations
        this.line("SigilValue sigil_zip(SigilValue a, SigilValue b) {");
        this.indent_push();
        this.line("⎇ (a.tag != TAG_ARRAY ∨ b.tag != TAG_ARRAY) ⤺ sigil_array(0);");
        this.line("size_t len = a.v.arr.len < b.v.arr.len ? a.v.arr.len : b.v.arr.len;");
        this.line("SigilValue result = sigil_array(len);");
        this.line("∀ (size_t i = 0; i < len; i++) {");
        this.indent_push();
        this.line("SigilValue* fields = (SigilValue*)malloc(2 * sizeof(SigilValue));");
        this.line("fields[0] = a.v.arr.data[i];");
        this.line("fields[1] = b.v.arr.data[i];");
        this.line("result.v.arr.data[i] = (SigilValue){ .tag = TAG_TUPLE, .evidence = SIGIL_KNOWN };");
        this.line("result.v.arr.data[i].v.tup.fields = fields;");
        this.line("result.v.arr.data[i].v.tup.count = 2;");
        this.indent_pop();
        this.line("}");
        this.line("⤺ result;");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_all(SigilValue arr, SigilValue closure) {");
        this.indent_push();
        this.line("⎇ (arr.tag != TAG_ARRAY) ⤺ sigil_bool(yea);");
        this.line("typedef SigilValue (*ClosureFn)(SigilValue);");
        this.line("ClosureFn rite = (ClosureFn)closure.v.ptr;");
        this.line("∀ (size_t i = 0; i < arr.v.arr.len; i++) {");
        this.indent_push();
        this.line("SigilValue result = λ(arr.v.arr.data[i]);");
        this.line("⎇ (!sigil_truthy(result)) ⤺ sigil_bool(nay);");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_bool(yea);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Box functions
        this.line("SigilValue sigil_Box____new(SigilValue v) {");
        this.indent_push();
        this.line("SigilValue* boxed = (SigilValue*)malloc(sizeof(SigilValue));");
        this.line("*boxed = v;");
        this.line("⤺ (SigilValue){ .tag = TAG_REF, .evidence = v.evidence, .v.ptr = boxed };");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Additional String functions
        this.line("SigilValue sigil_String____starts_with(SigilValue s, SigilValue prefix) {");
        this.indent_push();
        this.line("⎇ (s.tag != TAG_STRING ∨ prefix.tag != TAG_STRING) ⤺ sigil_bool(nay);");
        this.line("⎇ (!s.v.s ∨ !prefix.v.s) ⤺ sigil_bool(nay);");
        this.line("⤺ sigil_bool(strncmp(s.v.s, prefix.v.s, strlen(prefix.v.s)) == 0);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // String builder infrastructure
        this.line("/* String builder ∀ efficient string concatenation */");
        this.line("typedef sigil { size_t len; size_t cap; char data[]; } SigilStringBuilder;");
        this.line("#define SB_INITIAL_CAP 256");
        this.line("#define SB_HEADER_SIZE (sizeof(size_t) * 2)");
        this.line("");
        this.line("static inline SigilStringBuilder* get_builder(char* s) {");
        this.indent_push();
        this.line("⤺ (SigilStringBuilder*)((char*)s - SB_HEADER_SIZE);");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("static inline int is_string_builder(char* s) {");
        this.indent_push();
        this.line("⎇ (!s) ⤺ 0;");
        this.line("SigilStringBuilder* sb = get_builder(s);");
        this.line("⤺ (sb->cap >= SB_INITIAL_CAP ∧ sb->cap <= 1024*1024*100 ∧ sb->len <= sb->cap);");
        this.indent_pop();
        this.line("}");
        this.line("");
        this.line("static inline SigilStringBuilder* ensure_capacity(SigilStringBuilder* sb, size_t needed) {");
        this.indent_push();
        this.line("⎇ (sb->len + needed < sb->cap) ⤺ sb;");
        this.line("size_t new_cap = sb->cap * 2;");
        this.line("⟳ (sb->len + needed >= new_cap) new_cap *= 2;");
        this.line("SigilStringBuilder* new_sb = (SigilStringBuilder*)realloc(sb, SB_HEADER_SIZE + new_cap);");
        this.line("new_sb->cap = new_cap;");
        this.line("⤺ new_sb;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_String____new
        this.line("SigilValue sigil_String____new(void) {");
        this.indent_push();
        this.line("SigilStringBuilder* sb = (SigilStringBuilder*)malloc(SB_HEADER_SIZE + SB_INITIAL_CAP);");
        this.line("sb->len = 0;");
        this.line("sb->cap = SB_INITIAL_CAP;");
        this.line("sb->data[0] = '\\0';");
        this.line("⤺ (SigilValue){ .tag = TAG_STRING, .evidence = SIGIL_KNOWN, .v.s = sb->data };");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_String____push
        this.line("SigilValue sigil_String____push(SigilValue s, SigilValue c) {");
        this.indent_push();
        this.line("⎇ (s.tag != TAG_STRING ∨ !s.v.s) ⤺ s;");
        this.line("char ch = '?';");
        this.line("⎇ (c.tag == TAG_CHAR) ch = c.v.c;");
        this.line("⎉ ⎇ (c.tag == TAG_INT) ch = (char)c.v.i;");
        this.line("⎇ (is_string_builder(s.v.s)) {");
        this.indent_push();
        this.line("SigilStringBuilder* sb = get_builder(s.v.s);");
        this.line("sb = ensure_capacity(sb, 1);");
        this.line("sb->data[sb->len++] = ch;");
        this.line("sb->data[sb->len] = '\\0';");
        this.line("s.v.s = sb->data;");
        this.indent_pop();
        this.line("} ⎉ {");
        this.indent_push();
        this.line("size_t len = strlen(s.v.s);");
        this.line("size_t new_cap = (len + 2 < SB_INITIAL_CAP) ? SB_INITIAL_CAP : (len + 2) * 2;");
        this.line("SigilStringBuilder* sb = (SigilStringBuilder*)malloc(SB_HEADER_SIZE + new_cap);");
        this.line("sb->len = len + 1;");
        this.line("sb->cap = new_cap;");
        this.line("memcpy(sb->data, s.v.s, len);");
        this.line("sb->data[len] = ch;");
        this.line("sb->data[len + 1] = '\\0';");
        this.line("s.v.s = sb->data;");
        this.indent_pop();
        this.line("}");
        this.line("⤺ s;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_String____push_str (simple version - no StringBuilder)
        this.line("SigilValue sigil_String____push_str(SigilValue s, SigilValue str) {");
        this.indent_push();
        // CG-PUSHSTR-FIX: Dereference TAG_REF arguments
        this.line("⎇ (str.tag == TAG_REF ∧ str.v.ptr) str = *(SigilValue*)str.v.ptr;");
        this.line("⎇ (s.tag != TAG_STRING ∨ str.tag != TAG_STRING) ⤺ s;");
        this.line("size_t len1 = s.v.s ? strlen(s.v.s) : 0;");
        this.line("size_t len2 = str.v.s ? strlen(str.v.s) : 0;");
        this.line("char* result = (char*)malloc(len1 + len2 + 1);");
        this.line("⎇ (s.v.s) strcpy(result, s.v.s); ⎉ result[0] = '\\0';");
        this.line("⎇ (str.v.s) strcat(result, str.v.s);");
        this.line("⤺ sigil_string(result);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_String____split
        this.line("SigilValue sigil_String____split(SigilValue s, SigilValue delim) {");
        this.indent_push();
        this.line("SigilValue result = sigil_Vec____new();");
        this.line("⎇ (s.tag != TAG_STRING ∨ delim.tag != TAG_STRING ∨ !s.v.s ∨ !delim.v.s) ⤺ result;");
        this.line("char* str = strdup(s.v.s);");
        this.line("char* token = strtok(str, delim.v.s);");
        this.line("⟳ (token) {");
        this.indent_push();
        this.line("result = sigil_Vec____push(result, sigil_string(strdup(token)));");
        this.line("token = strtok(NULL, delim.v.s);");
        this.indent_pop();
        this.line("}");
        this.line("free(str);");
        this.line("⤺ result;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_add
        this.line("SigilValue sigil_add(SigilValue a, SigilValue b) {");
        this.indent_push();
        this.line("⎇ (a.tag == TAG_INT ∧ b.tag == TAG_INT) ⤺ sigil_int(a.v.i + b.v.i);");
        this.line("⎇ (a.tag == TAG_FLOAT ∨ b.tag == TAG_FLOAT) {");
        this.indent_push();
        this.line("double fa = (a.tag == TAG_INT) ? (double)a.v.i : a.v.f;");
        this.line("double fb = (b.tag == TAG_INT) ? (double)b.v.i : b.v.f;");
        this.line("⤺ sigil_float(fa + fb);");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_int(0);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_eprint
        this.line("SigilValue sigil_eprint(SigilValue v) {");
        this.indent_push();
        this.line("SigilValue s = sigil_display(v);");
        this.line("⎇ (s.tag == TAG_STRING ∧ s.v.s) fprintf(stderr, \"%s\", s.v.s);");
        this.line("⤺ sigil_unit();");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_error
        this.line("SigilValue sigil_error(SigilValue ctx, SigilValue err) {");
        this.indent_push();
        this.line("fprintf(stderr, \"Error: \");");
        this.line("SigilValue s = sigil_display(err);");
        this.line("⎇ (s.tag == TAG_STRING ∧ s.v.s) fprintf(stderr, \"%s\\n\", s.v.s);");
        this.line("⤺ sigil_unit();");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_cloned - deep copy of values
        this.line("SigilValue sigil_cloned(SigilValue v) {");
        this.indent_push();
        this.line("switch (v.tag) {");
        this.indent_push();
        this.line("case TAG_STRING: ⎇ (v.v.s) ⤺ sigil_string(strdup(v.v.s)); ⤺ v;");
        this.line("case TAG_ARRAY: {");
        this.indent_push();
        this.line("SigilValue result = sigil_Vec____new();");
        this.line("∀ (size_t i = 0; i < v.v.arr.len; i++) result = sigil_Vec____push(result, sigil_cloned(v.v.arr.data[i]));");
        this.line("⤺ result;");
        this.indent_pop();
        this.line("}");
        this.line("case TAG_STRUCT: {");
        this.indent_push();
        this.line("SigilStruct* src = (SigilStruct*)v.v.ptr;");
        this.line("⎇ (!src) ⤺ v;");
        this.line("SigilStruct* dst = (SigilStruct*)malloc(sizeof(SigilStruct));");
        this.line("dst->name = src->name ? strdup(src->name) : NULL;");
        this.line("dst->num_fields = src->num_fields;");
        this.line("dst->field_names = (◆ char**)malloc(src->num_fields * sizeof(char*));");
        this.line("dst->field_values = (SigilValue*)malloc(src->num_fields * sizeof(SigilValue));");
        this.line("∀ (size_t i = 0; i < src->num_fields; i++) {");
        this.indent_push();
        this.line("dst->field_names[i] = src->field_names[i] ? strdup(src->field_names[i]) : NULL;");
        this.line("dst->field_values[i] = sigil_cloned(src->field_values[i]);");
        this.indent_pop();
        this.line("}");
        this.line("⤺ (SigilValue){ .tag = TAG_STRUCT, .evidence = v.evidence, .v.ptr = dst };");
        this.indent_pop();
        this.line("}");
        this.line("default: ⤺ v;");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_nth
        this.line("SigilValue sigil_nth(SigilValue v, SigilValue n) {");
        this.indent_push();
        this.line("⎇ (v.tag != TAG_ARRAY ∨ n.tag != TAG_INT) ⤺ sigil_unit();");
        this.line("int64_t idx = n.v.i;");
        this.line("⎇ (idx < 0 ∨ (size_t)idx >= v.v.arr.len) ⤺ sigil_unit();");
        this.line("⤺ v.v.arr.data[idx];");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_next - stub ∀ iterator protocol
        this.line("SigilValue sigil_next(SigilValue iter) {");
        this.indent_push();
        this.line("/* Iterator next - ⤺ Option·None ∀ stub */");
        this.line("⤺ Option____None;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // Character classification helpers
        this.line("SigilValue sigil_is_uppercase(SigilValue c) {");
        this.indent_push();
        this.line("⎇ (c.tag != TAG_CHAR) ⤺ sigil_bool(nay);");
        this.line("⤺ sigil_bool(c.v.c >= 'A' ∧ c.v.c <= 'Z');");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_is_duodecimal_digit(SigilValue c) {");
        this.indent_push();
        this.line("⎇ (c.tag != TAG_CHAR) ⤺ sigil_bool(nay);");
        this.line("char ch = c.v.c;");
        this.line("⤺ sigil_bool((ch >= '0' ∧ ch <= '9') ∨ ch == 'X' ∨ ch == 'E' ∨ ch == 'x' ∨ ch == 'e');");
        this.indent_pop();
        this.line("}");
        this.line("");

        this.line("SigilValue sigil_is_vigesimal_digit(SigilValue c) {");
        this.indent_push();
        this.line("⎇ (c.tag != TAG_CHAR) ⤺ sigil_bool(nay);");
        this.line("char ch = c.v.c;");
        this.line("⤺ sigil_bool((ch >= '0' ∧ ch <= '9') ∨ (ch >= 'A' ∧ ch <= 'J') ∨ (ch >= 'a' ∧ ch <= 'j'));");
        this.indent_pop();
        this.line("}");
        this.line("");

        // UTF-8 helpers
        this.line("SigilValue sigil_len_utf8(SigilValue c) {");
        this.indent_push();
        this.line("⎇ (c.tag != TAG_CHAR) ⤺ sigil_int(0);");
        this.line("unsigned char ch = (unsigned char)c.v.c;");
        this.line("⎇ (ch < 0x80) ⤺ sigil_int(1);");
        this.line("⎇ ((ch & 0xE0) == 0xC0) ⤺ sigil_int(2);");
        this.line("⎇ ((ch & 0xF0) == 0xE0) ⤺ sigil_int(3);");
        this.line("⎇ ((ch & 0xF8) == 0xF0) ⤺ sigil_int(4);");
        this.line("⤺ sigil_int(1);");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_parse - stub ∀ parsing
        this.line("SigilValue sigil_parse(SigilValue s) {");
        this.indent_push();
        this.line("/* Parse stub - returns int ⎇ numeric, ⎉ string */");
        this.line("⎇ (s.tag != TAG_STRING ∨ !s.v.s) ⤺ s;");
        this.line("char* endptr;");
        this.line("long val = strtol(s.v.s, &endptr, 10);");
        this.line("⎇ (*endptr == '\\0') ⤺ sigil_int(val);");
        this.line("⤺ s;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_map_err - stub ∀ Result error mapping
        this.line("SigilValue sigil_map_err(SigilValue result, SigilValue mapper) {");
        this.indent_push();
        this.line("/* Map error ∈ Result - ⎇ Err, apply mapper */");
        this.line("⎇ (sigil_is_struct_variant(result, \"Result·Err\") ∨ sigil_is_struct_variant(result, \"Err\")) {");
        this.indent_push();
        this.line("⎇ (result.v.ptr ∧ mapper.tag == TAG_CLOSURE) {");
        this.indent_push();
        this.line("SigilValue err = *(SigilValue*)result.v.ptr;");
        this.line("SigilValue (*fn)(SigilValue) = (SigilValue (*)(SigilValue))mapper.v.ptr;");
        this.line("⤺ sigil_Err(λ(err));");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("⤺ result;");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_to_json - stub (signature must ⌥ forward declaration)
        this.line("SigilValue sigil_to_json(SigilValue v, SigilValue opts) {");
        this.indent_push();
        this.line("(void)opts;  /* unused ∀ now */");
        this.line("⤺ sigil_display(v);  /* Simplified: just display */");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_kind_name - get type name
        this.line("SigilValue sigil_kind_name(SigilValue v) {");
        this.indent_push();
        this.line("switch (v.tag) {");
        this.indent_push();
        this.line("case TAG_INT: ⤺ sigil_string(\"int\");");
        this.line("case TAG_FLOAT: ⤺ sigil_string(\"float\");");
        this.line("case TAG_STRING: ⤺ sigil_string(\"string\");");
        this.line("case TAG_BOOL: ⤺ sigil_string(\"bool\");");
        this.line("case TAG_CHAR: ⤺ sigil_string(\"char\");");
        this.line("case TAG_ARRAY: ⤺ sigil_string(\"array\");");
        this.line("case TAG_STRUCT: ⤺ sigil_string(\"struct\");");
        this.line("case TAG_ENUM: ⤺ sigil_string(\"enum\");");
        this.line("default: ⤺ sigil_string(\"unknown\");");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("");

        // sigil_collect_results - collect array of Results into Result of array
        this.line("SigilValue sigil_collect_results(SigilValue arr) {");
        this.indent_push();
        this.line("⎇ (arr.tag != TAG_ARRAY) ⤺ sigil_Err(sigil_string(\"not an array\"));");
        this.line("SigilValue result = sigil_Vec____new();");
        this.line("∀ (size_t i = 0; i < arr.v.arr.len; i++) {");
        this.indent_push();
        this.line("SigilValue item = arr.v.arr.data[i];");
        this.line("⎇ (sigil_is_struct_variant(item, \"Result·Err\") ∨ sigil_is_struct_variant(item, \"Err\")) ⤺ item;");
        this.line("⎇ (sigil_is_struct_variant(item, \"Result·Ok\") ∨ sigil_is_struct_variant(item, \"Ok\")) {");
        this.indent_push();
        this.line("⎇ (item.v.ptr) result = sigil_Vec____push(result, *(SigilValue*)item.v.ptr);");
        this.indent_pop();
        this.line("} ⎉ {");
        this.indent_push();
        this.line("result = sigil_Vec____push(result, item);");
        this.indent_pop();
        this.line("}");
        this.indent_pop();
        this.line("}");
        this.line("⤺ sigil_Ok(result);");
        this.indent_pop();
        this.line("}");
    }
}
