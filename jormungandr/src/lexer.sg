//! Lexer for the Sigil programming language.
//!
//! This is a hand-written lexer for bootstrapping - no external dependencies.
//! Handles polysynthetic morphemes, evidentiality markers, and multi-base numerals.
//!
//! This-hosted conversion: lexer.rs → lexer.sg
//! Original: 1355 lines of Rust (using logos crate)
//! Status: Complete (hand-written for bootstrap)

invoke tome·span·Span;
invoke tome·token·Token;
invoke tome·lexer_util·CharExt;

/// A lexer for Sigil source code.
/// Produces a stream of tokens with source spans.
☉ sigil Lexer {
    /// The source code being lexed
    source: !String,
    /// Current byte position in the source
    pos: !u64,
    /// Start position of the current token
    start: !u64,
    /// Peeked token (for lookahead)
    peeked: ?Token,
    /// Peeked span
    peeked_span: ?Span,
}

⊢ Lexer {
    /// Create a new lexer for the given source code.
    ☉ rite new(source: !String) → !This {
        This {
            source,
            pos: 0,
            start: 0,
            peeked: null,
            peeked_span: null,
        }
    }

    /// Get the next token and its span.
    ☉ rite next_token(vary this) → ?(Token, Span) {
        // Return peeked token ⎇ available
        // Use ⌥ instead of ⎇ != null to work around codegen issue
        ⌥ this.peeked {
            ?token => {
                ≔ span = this.peeked_span!;
                this.peeked = null;
                this.peeked_span = null;
                ⤺ ?((token, span));
            },
            null | Option·None => {},  // Continue to lex next token
        }

        this.skip_whitespace_and_comments();

        ⎇ this.is_eof() {
            ⤺ null;
        }

        this.start = this.pos;
        ≔ c = this.advance()!;

        // Handle null character (unexpected EOF or invalid UTF-8)
        ⎇ c == null {
            ⤺ null;
        }

        ≔ token = ⌥ c {
            // Single-character tokens
            '(' => Token·LParen,
            ')' => Token·RParen,
            '{' => Token·LBrace,
            '}' => Token·RBrace,
            '[' => Token·LBracket,
            ']' => Token·RBracket,
            ';' => Token·Semi,
            ',' => Token·Comma,
            '@' => Token·At,
            '_' => this.lex_underscore_or_ident(),

            // Operators that might be multi-character
            '+' => this.lex_plus(),
            '-' => this.lex_minus(),
            '*' => this.lex_star(),
            '/' => this.lex_slash(),
            '%' => this.lex_percent(),
            '=' => this.lex_eq(),
            '!' => this.lex_bang(),
            '?' => Token·Question,
            '~' => Token·Tilde,
            '◊' => Token·Lozenge,
            '<' => this.lex_lt(),
            '>' => this.lex_gt(),
            '&' => this.lex_amp(),
            '|' => this.lex_pipe(),
            '^' => this.lex_caret(),
            ':' => this.lex_colon(),
            '.' => this.lex_dot(),
            '#' => this.lex_hash(),

            // String literals
            '"' => this.lex_string(),
            '\'' => this.lex_quote_or_char(),

            // Numbers
            '0'..='9' => this.lex_number(c),

            // Identifiers and keywords
            'a'..='z' | 'A'..='Z' => this.lex_ident_or_keyword(c),

            // Handle null (EOF or invalid) - must be before wildcard
            null | Option·None => { ⤺ null; },

            // Unicode morphemes and symbols
            _ => this.lex_unicode(c),
        };

        ≔ span = Span·new(this.start, this.pos);
        ?((token, span))
    }

    /// Peek at the next token without consuming it.
    ☉ rite peek(vary this) → ?(Token, Span) {
        ⌥ this.peeked {
            null | Option·None => {
                ⌥ this.next_token() {
                    ?(token, span) => {
                        this.peeked = ?token;
                        this.peeked_span = ?span;
                    },
                    null | Option·None => ⤺ null,
                }
            },
            _ => {},
        }
        // Return by value instead of reference for bootstrap compatibility
        ?((this.peeked!, this.peeked_span!))
    }

    /// Check ⎇ peeked token indicates start of a closure (=>, comma, or colon).
    ☉ rite peek_is_closure_indicator(vary this) → !bool {
        // Use ⌥ instead of ⎇ == null for bootstrap compatibility
        ⌥ this.peeked {
            null | Option·None => {
                ⌥ this.next_token() {
                    ?(token, span) => {
                        this.peeked = token;
                        this.peeked_span = span;
                    },
                    null | Option·None => ⤺ nay,
                }
            },
            _ => {},
        }
        ⌥ this.peeked {
            ?Token·FatArrow => yea,
            ?Token·Comma => yea,
            // Don't treat : as closure indicator - it conflicts with sigil init { field: value }
            // Closures with typed params invoke => not | anyway
            _ => nay,
        }
    }

    /// Check ⎇ peeked token is a macro delimiter (paren, bracket, brace).
    ☉ rite peek_is_macro_delimiter(vary this) → !bool {
        // Use ⌥ instead of ⎇ == null for bootstrap compatibility
        ⌥ this.peeked {
            null | Option·None => {
                ⌥ this.next_token() {
                    ?(token, span) => {
                        this.peeked = token;
                        this.peeked_span = span;
                    },
                    null | Option·None => ⤺ nay,
                }
            },
            _ => {},
        }
        ⌥ this.peeked {
            ?Token·LParen => yea,
            ?Token·LBracket => yea,
            ?Token·LBrace => yea,
            _ => nay,
        }
    }

    /// Get the current span (for error reporting).
    ☉ rite span(this) → !Span {
        Span·new(this.start, this.pos)
    }

    // ========================================
    // Helper Methods
    // ========================================

    /// Check ⎇ we've reached end of file.
    rite is_eof(this) → !bool {
        this.pos >= this.source.len()
    }

    /// Get current character without advancing.
    rite current(this) → ?char {
        ⎇ this.is_eof() {
            null
        } ⎉ {
            this.source.char_at(this.pos)
        }
    }

    /// Peek at the character after the current one.
    rite peek_ahead(this) → ?char {
        ⎇ this.is_eof() {
            ⤺ null;
        }
        // Skip current character
        ≔ curr_char = this.source.char_at(this.pos)?;
        ≔ next_pos = this.pos + curr_char.len_utf8();
        ⎇ next_pos >= this.source.len() {
            null
        } ⎉ {
            this.source.char_at(next_pos)
        }
    }

    /// Advance and ⤺ the current character.
    rite advance(vary this) → ?char {
        ⎇ this.is_eof() {
            ⤺ null;
        }
        ≔ c = this.source.char_at(this.pos)!;
        this.pos += c.len_utf8();
        ?c
    }

    /// Check ⎇ current char matches, and ⎇ so advance.
    rite match_char(vary this, expected: !char) → !bool {
        ⌥ this.current() {
            ?c => {
                ⎇ c == expected {
                    this.advance();
                    yea
                } ⎉ {
                    nay
                }
            },
            null | Option·None => nay,
        }
    }

    /// Skip whitespace and comments.
    rite skip_whitespace_and_comments(vary this) {
        forever {
            ⌥ this.current() {
                // Whitespace
                ' ' | '\t' | '\n' | '\r' => {
                    this.advance();
                }
                // Line comment
                '/' => {
                    ⎇ this.peek_char(1) == '/' {
                        this.skip_line_comment();
                    } ⎉ {
                        ⊲;
                    }
                }
                _ => ⊲,
            }
        }
    }

    /// Skip a line comment (// ...)
    rite skip_line_comment(vary this) {
        // Skip the //
        this.advance();
        this.advance();
        // Skip until newline (invoke loop with break to avoid != comparison bug)
        forever {
            ⎇ this.is_eof() {
                ⊲;
            }
            ≔ c = this.current();
            ⎇ c == '\n' {
                ⊲;
            }
            this.advance();
        }
    }

    /// Peek at a character at offset from current position.
    rite peek_char(this, offset: !u64) → ?char {
        ≔ vary pos = this.pos;
        each _ ∈ 0..offset {
            ⎇ pos >= this.source.len() {
                ⤺ null;
            }
            ≔ c = this.source.char_at(pos)?;
            pos += c.len_utf8();
        }
        ⎇ pos >= this.source.len() {
            null
        } ⎉ {
            this.source.char_at(pos)
        }
    }

    // ========================================
    // Token Lexers
    // ========================================

    /// Lex + or += or ++
}
