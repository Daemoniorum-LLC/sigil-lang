//! Tree-Walking Interpreter ∀ Sigil IR
//!
//! This module provides an interpreter that directly executes the IR,
//! serving as both a reference implementation and a stepping stone
//! toward native code generation.
//!
//! ## Execution Model
//!
//! The interpreter uses a stack-based execution model with:
//! - Value stack ∀ operands and results
//! - Call stack ∀ function invocations
//! - Environment stack ∀ variable scoping
//! - Evidence tracking at runtime
//!
//! ## Evidence at Runtime
//!
//! Unlike static typing, the interpreter tracks evidence dynamically:
//! - Known (!) values are trusted implicitly
//! - Uncertain (?) values trigger runtime checks
//! - Reported (~) values are tagged ∀ provenance tracking
//! - Paradox (‽) values halt execution with an error

invoke crate·ir·*;
invoke crate·typeck·EvidenceLevel;

// ============================================================================
// Runtime Values
// ============================================================================

/// Runtime value representation with evidence tracking
☉ ᛈ Value {
    /// Unit value ()
    Unit,

    /// Boolean
    Bool(!bool),

    /// Signed integers
    Int(!i64),

    /// Floating point
    Float(!f64),

    /// Character
    Char(!char),

    /// String (heap allocated)
    String(!String),

    /// Array of values
    Array(![Value]),

    /// Tuple of values
    Tuple(![Value]),

    /// Struct instance
    Struct {
        name: !String,
        fields: !Map<String, Value>,
    },

    /// Enum variant
    Enum {
        name: !String,
        variant: !String,
        fields: ![Value],
    },

    /// Closure (captured environment + function)
    Closure {
        params: ![String],
        body: !Box<IrOperation>,
        env: !Environment,
    },

    /// Function reference
    Function(!String),

    /// Reference to another value
    Ref(!Box<Value>),

    /// Mutable reference
    RefMut(!Box<Value>),

    /// Null/None value
    Null,

    /// Never type (diverging)
    Never,
}

⊢ Value {
    /// Check ⎇ this is a truthy value
    ☉ λ is_truthy(self) -> !bool {
        ⌥ self {
            Value·Bool(b) => b,
            Value·Int(n) => n != 0,
            Value·Float(f) => f != 0.0,
            Value·String(s) => !s.is_empty(),
            Value·Array(a) => !a.is_empty(),
            Value·Null => false,
            Value·Unit => false,
            _ => true,
        }
    }

    /// Convert to string representation
    ☉ λ to_string(self) -> !String {
        ⌥ self {
            Value·Unit => "()",
            Value·Bool(b) => ⎇ b { "true" } ⎉ { "false" },
            Value·Int(n) => n.to_string(),
            Value·Float(f) => f.to_string(),
            Value·Char(c) => format!("'{}'", c),
            Value·String(s) => s,
            Value·Array(elements) => {
                ≔ parts = elements|τ{e => e.to_string()}|join(", ");
                format!("[{}]", parts)
            },
            Value·Tuple(elements) => {
                ≔ parts = elements|τ{e => e.to_string()}|join(", ");
                format!("({})", parts)
            },
            Value·Struct { name, fields } => {
                ≔ parts = fields.entries()|τ{pair => format!("{}: {}", pair.0, pair.1.to_string())}|join(", ");
                format!("{} {{ {} }}", name, parts)
            },
            Value·Enum { name, variant, fields } => {
                ⎇ fields.is_empty() {
                    format!("{}·{}", name, variant)
                } ⎉ {
                    ≔ parts = fields|τ{f => f.to_string()}|join(", ");
                    format!("{}·{}({})", name, variant, parts)
                }
            },
            Value·Closure { .. } => "<closure>",
            Value·Function(name) => format!("<λ {}>", name),
            Value·Ref(v) => format!("&{}", v.to_string()),
            Value·RefMut(v) => format!("&Δ {}", v.to_string()),
            Value·Null => "null",
            Value·Never => "!",
        }
    }

    /// Get type name ∀ error messages
    ☉ λ type_name(self) -> !&str {
        ⌥ self {
            Value·Unit => "()",
            Value·Bool(_) => "bool",
            Value·Int(_) => "i64",
            Value·Float(_) => "f64",
            Value·Char(_) => "char",
            Value·String(_) => "str",
            Value·Array(_) => "array",
            Value·Tuple(_) => "tuple",
            Value·Struct { name, .. } => name,
            Value·Enum { name, .. } => name,
            Value·Closure { .. } => "closure",
            Value·Function(_) => "function",
            Value·Ref(_) => "ref",
            Value·RefMut(_) => "ref mut",
            Value·Null => "null",
            Value·Never => "!",
        }
    }
}

/// Runtime value with evidence annotation
☉ Σ EvidentialValue {
    ☉ value: !Value,
    ☉ evidence: !IrEvidence,
}

⊢ EvidentialValue {
    ☉ λ known(value: !Value) -> !EvidentialValue {
        EvidentialValue { value, evidence: IrEvidence·Known }
    }

    ☉ λ uncertain(value: !Value) -> !EvidentialValue {
        EvidentialValue { value, evidence: IrEvidence·Uncertain }
    }

    ☉ λ reported(value: !Value) -> !EvidentialValue {
        EvidentialValue { value, evidence: IrEvidence·Reported }
    }
}

// ============================================================================
// Environment
// ============================================================================

/// Variable environment with scoping
☉ Σ Environment {
    /// Variable bindings
    bindings: !Map<String, EvidentialValue>,
    /// Parent scope
    parent: ?Box<Environment>,
}

⊢ Environment {
    /// Create a new empty environment
    ☉ λ new() -> !Environment {
        Environment {
            bindings: Map·new(),
            parent: null,
        }
    }

    /// Create a child environment
    ☉ λ child(parent: !Environment) -> !Environment {
        Environment {
            bindings: Map·new(),
            parent: ?Box·new(parent),
        }
    }

    /// Define a variable
    ☉ λ define(Δ self, name: !String, value: !EvidentialValue) {
        self.bindings.insert(name, value);
    }

    /// Look up a variable
    ☉ λ get(self, name: !&str) -> ?EvidentialValue {
        ⎇ ≔ ?val = self.bindings.get(name) {
            ⤺ ?val.clone();
        }
        ⎇ ≔ ?parent = self.parent {
            ⤺ parent.get(name);
        }
        null
    }

    /// Update an existing variable
    ☉ λ set(Δ self, name: !&str, value: !EvidentialValue) -> !bool {
        ⎇ self.bindings.contains_key(name) {
            self.bindings.insert(name.to_string(), value);
            ⤺ true;
        }
        ⎇ ≔ ?parent = self.parent {
            ⤺ parent.set(name, value);
        }
        false
    }
}

// ============================================================================
// Call Frame
// ============================================================================

/// Call stack frame
☉ Σ CallFrame {
    /// Function name
    ☉ function: !String,
    /// Local environment
    ☉ env: !Environment,
    /// Return address (∀ debugging)
    ☉ return_addr: ?String,
}

// ============================================================================
// Interpreter
// ============================================================================

/// The Sigil interpreter
☉ Σ Interpreter {
    /// Global environment
    globals: !Environment,

    /// Call stack
    call_stack: ![CallFrame],

    /// Loaded modules
    modules: !Map<String, IrModule>,

    /// Function definitions
    functions: !Map<String, IrFunction>,

    /// Output buffer (∀ print statements)
    output: ![String],

    /// Maximum call stack depth
    max_stack_depth: !u64,
}

⊢ Interpreter {
    /// Create a new interpreter
    ☉ λ new() -> !Interpreter {
        ≔ Δ interp = Interpreter {
            globals: Environment·new(),
            call_stack: [],
            modules: Map·new(),
            functions: Map·new(),
            output: [],
            max_stack_depth: 1000,
        };

        // Register built-in functions
        interp.register_builtins();
        interp
    }

    /// Register built-in functions
    λ register_builtins(Δ self) {
        // I/O
        self.globals.define("print", EvidentialValue·known(Value·Function("print")));
        self.globals.define("println", EvidentialValue·known(Value·Function("println")));
        self.globals.define("input", EvidentialValue·known(Value·Function("input")));

        // Type conversions
        self.globals.define("int", EvidentialValue·known(Value·Function("int")));
        self.globals.define("float", EvidentialValue·known(Value·Function("float")));
        self.globals.define("str", EvidentialValue·known(Value·Function("str")));
        self.globals.define("bool", EvidentialValue·known(Value·Function("bool")));

        // Math
        self.globals.define("abs", EvidentialValue·known(Value·Function("abs")));
        self.globals.define("sqrt", EvidentialValue·known(Value·Function("sqrt")));
        self.globals.define("sin", EvidentialValue·known(Value·Function("sin")));
        self.globals.define("cos", EvidentialValue·known(Value·Function("cos")));
        self.globals.define("pow", EvidentialValue·known(Value·Function("pow")));
        self.globals.define("floor", EvidentialValue·known(Value·Function("floor")));
        self.globals.define("ceil", EvidentialValue·known(Value·Function("ceil")));
        self.globals.define("round", EvidentialValue·known(Value·Function("round")));
        self.globals.define("min", EvidentialValue·known(Value·Function("min")));
        self.globals.define("max", EvidentialValue·known(Value·Function("max")));

        // Collections
        self.globals.define("len", EvidentialValue·known(Value·Function("len")));
        self.globals.define("push", EvidentialValue·known(Value·Function("push")));
        self.globals.define("pop", EvidentialValue·known(Value·Function("pop")));
        self.globals.define("first", EvidentialValue·known(Value·Function("first")));
        self.globals.define("last", EvidentialValue·known(Value·Function("last")));
        self.globals.define("range", EvidentialValue·known(Value·Function("range")));

        // Assertions
        self.globals.define("assert", EvidentialValue·known(Value·Function("assert")));
        self.globals.define("assert_eq", EvidentialValue·known(Value·Function("assert_eq")));

        // Evidence
        self.globals.define("evidence_of", EvidentialValue·known(Value·Function("evidence_of")));
        self.globals.define("validate", EvidentialValue·known(Value·Function("validate")));
        self.globals.define("verify", EvidentialValue·known(Value·Function("verify")));

        // Control
        self.globals.define("panic", EvidentialValue·known(Value·Function("panic")));
        self.globals.define("todo", EvidentialValue·known(Value·Function("todo")));
    }

    /// Load an IR module
    ☉ λ load_module(Δ self, module: !IrModule) {
        // Register all functions
        ∀ func ∈ module.functions {
            self.functions.insert(func.name.clone(), func);
        }

        // Store module
        self.modules.insert(module.source.clone(), module);
    }

    /// Execute the main function
    ☉ λ run(Δ self) -> !Result<EvidentialValue, RuntimeError> {
        // Find main function
        ⎇ ≔ ?main_fn = self.functions.get("main") {
            self.call_function("main", [])
        } ⎉ {
            Result·Err(RuntimeError·new("no main function found"))
        }
    }

    /// Call a function by name
    ☉ λ call_function(Δ self, name: !&str, args: ![EvidentialValue]) -> !Result<EvidentialValue, RuntimeError> {
        // Check stack depth
        ⎇ self.call_stack.len() >= self.max_stack_depth {
            ⤺ Result·Err(RuntimeError·new("stack overflow"));
        }

        // Handle built-in functions
        ⎇ self.is_builtin(name) {
            ⤺ self.call_builtin(name, args);
        }

        // Find user function
        ≔ func = ⌥ self.functions.get(name) {
            ?f => f,
            null => ⤺ Result·Err(RuntimeError·new(format!("undefined function: {}", name))),
        };

        // Create new environment
        ≔ Δ env = Environment·child(self.globals);

        // Bind parameters
        ⎇ func.params.len() != args.len() {
            ⤺ Result·Err(RuntimeError·new(format!(
                "function {} expected {} arguments, got {}",
                name, func.params.len(), args.len()
            )));
        }

        ∀ (param, arg) ∈ func.params.iter().zip(args.iter()) {
            // Check evidence requirements
            ≔ required_ev = param.evidence;
            ⎇ !self.check_evidence(required_ev, arg.evidence) {
                ⤺ Result·Err(RuntimeError·new(format!(
                    "evidence mis⌥ ∀ parameter {}: expected {}, got {}",
                    param.name, required_ev.name(), arg.evidence.name()
                )));
            }
            env.define(param.name.clone(), arg);
        }

        // Push call frame
        self.call_stack.push(CallFrame {
            function: name.to_string(),
            env: env.clone(),
            return_addr: null,
        });

        // Execute body
        ≔ result = ⌥ func.body {
            ?body => self.eval_with_env(body, env),
            null => Result·Ok(EvidentialValue·known(Value·Unit)),
        };

        // Pop call frame
        self.call_stack.pop();

        result
    }

    /// Check ⎇ evidence satisfies requirement
    λ check_evidence(self, required: !IrEvidence, actual: !IrEvidence) -> !bool {
        ≔ rank = |ev: !IrEvidence| {
            ⌥ ev {
                IrEvidence·Known => 0,
                IrEvidence·Uncertain => 1,
                IrEvidence·Reported => 2,
                IrEvidence·Paradox => 3,
            }
        };
        // More certain evidence can satisfy less certain requirements
        rank(actual) <= rank(required)
    }

    /// Check ⎇ a function is built-in
    λ is_builtin(self, name: !&str) -> !bool {
        ⌥ name {
            "print" | "println" | "input" |
            "int" | "float" | "str" | "bool" |
            "abs" | "sqrt" | "sin" | "cos" | "pow" | "floor" | "ceil" | "round" | "min" | "max" |
            "len" | "push" | "pop" | "first" | "last" | "range" |
            "assert" | "assert_eq" |
            "evidence_of" | "validate" | "verify" |
            "panic" | "todo" => true,
            _ => false,
        }
    }

    /// Call a built-in function
    λ call_builtin(Δ self, name: !&str, args: ![EvidentialValue]) -> !Result<EvidentialValue, RuntimeError> {
        ⌥ name {
            "print" => {
                ∀ arg ∈ args {
                    self.output.push(arg.value.to_string());
                }
                Result·Ok(EvidentialValue·known(Value·Unit))
            },
            "println" => {
                ∀ arg ∈ args {
                    self.output.push(arg.value.to_string());
                }
                self.output.push("\n");
                Result·Ok(EvidentialValue·known(Value·Unit))
            },
            "len" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("len expects 1 argument"));
                }
                ≔ val = args[0].value;
                ≔ len = ⌥ val {
                    Value·String(s) => s.len() as i64,
                    Value·Array(a) => a.len() as i64,
                    _ => ⤺ Result·Err(RuntimeError·new("len requires string or array")),
                };
                Result·Ok(EvidentialValue·known(Value·Int(len)))
            },
            "int" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("int expects 1 argument"));
                }
                ≔ val = ⌥ args[0].value {
                    Value·Int(n) => n,
                    Value·Float(f) => f as i64,
                    Value·Bool(b) => ⎇ b { 1 } ⎉ { 0 },
                    Value·String(s) => s.parse().unwrap_or(0),
                    _ => ⤺ Result·Err(RuntimeError·new("cannot convert to int")),
                };
                Result·Ok(EvidentialValue·known(Value·Int(val)))
            },
            "float" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("float expects 1 argument"));
                }
                ≔ val = ⌥ args[0].value {
                    Value·Int(n) => n as f64,
                    Value·Float(f) => f,
                    Value·String(s) => s.parse().unwrap_or(0.0),
                    _ => ⤺ Result·Err(RuntimeError·new("cannot convert to float")),
                };
                Result·Ok(EvidentialValue·known(Value·Float(val)))
            },
            "str" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("str expects 1 argument"));
                }
                Result·Ok(EvidentialValue·known(Value·String(args[0].value.to_string())))
            },
            "abs" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("abs expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Int(n) => Result·Ok(EvidentialValue·known(Value·Int(n.abs()))),
                    Value·Float(f) => Result·Ok(EvidentialValue·known(Value·Float(f.abs()))),
                    _ => Result·Err(RuntimeError·new("abs requires number")),
                }
            },
            "sqrt" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("sqrt expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Float(f) => Result·Ok(EvidentialValue·known(Value·Float(f.sqrt()))),
                    Value·Int(n) => Result·Ok(EvidentialValue·known(Value·Float((n as f64).sqrt()))),
                    _ => Result·Err(RuntimeError·new("sqrt requires number")),
                }
            },
            "sin" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("sin expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Float(f) => Result·Ok(EvidentialValue·known(Value·Float(f.sin()))),
                    Value·Int(n) => Result·Ok(EvidentialValue·known(Value·Float((n as f64).sin()))),
                    _ => Result·Err(RuntimeError·new("sin requires number")),
                }
            },
            "cos" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("cos expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Float(f) => Result·Ok(EvidentialValue·known(Value·Float(f.cos()))),
                    Value·Int(n) => Result·Ok(EvidentialValue·known(Value·Float((n as f64).cos()))),
                    _ => Result·Err(RuntimeError·new("cos requires number")),
                }
            },
            "pow" => {
                ⎇ args.len() != 2 {
                    ⤺ Result·Err(RuntimeError·new("pow expects 2 arguments"));
                }
                ≔ base = ⌥ args[0].value {
                    Value·Float(f) => f,
                    Value·Int(n) => n as f64,
                    _ => ⤺ Result·Err(RuntimeError·new("pow requires numbers")),
                };
                ≔ exp = ⌥ args[1].value {
                    Value·Float(f) => f,
                    Value·Int(n) => n as f64,
                    _ => ⤺ Result·Err(RuntimeError·new("pow requires numbers")),
                };
                Result·Ok(EvidentialValue·known(Value·Float(base.powf(exp))))
            },
            "min" => {
                ⎇ args.len() != 2 {
                    ⤺ Result·Err(RuntimeError·new("min expects 2 arguments"));
                }
                ⌥ (args[0].value, args[1].value) {
                    (Value·Int(a), Value·Int(b)) => Result·Ok(EvidentialValue·known(Value·Int(⎇ a < b { a } ⎉ { b }))),
                    (Value·Float(a), Value·Float(b)) => Result·Ok(EvidentialValue·known(Value·Float(⎇ a < b { a } ⎉ { b }))),
                    _ => Result·Err(RuntimeError·new("min requires same types")),
                }
            },
            "max" => {
                ⎇ args.len() != 2 {
                    ⤺ Result·Err(RuntimeError·new("max expects 2 arguments"));
                }
                ⌥ (args[0].value, args[1].value) {
                    (Value·Int(a), Value·Int(b)) => Result·Ok(EvidentialValue·known(Value·Int(⎇ a > b { a } ⎉ { b }))),
                    (Value·Float(a), Value·Float(b)) => Result·Ok(EvidentialValue·known(Value·Float(⎇ a > b { a } ⎉ { b }))),
                    _ => Result·Err(RuntimeError·new("max requires same types")),
                }
            },
            "range" => {
                ⎇ args.len() != 2 {
                    ⤺ Result·Err(RuntimeError·new("range expects 2 arguments"));
                }
                ⌥ (args[0].value, args[1].value) {
                    (Value·Int(start), Value·Int(end)) => {
                        ≔ arr = (start..end)|τ{n => Value·Int(n)}|collect();
                        Result·Ok(EvidentialValue·known(Value·Array(arr)))
                    },
                    _ => Result·Err(RuntimeError·new("range requires integers")),
                }
            },
            "first" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("first expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Array(arr) => ⌥ arr.first() {
                        ?v => Result·Ok(EvidentialValue·uncertain(v.clone())),
                        null => Result·Ok(EvidentialValue·known(Value·Null)),
                    },
                    _ => Result·Err(RuntimeError·new("first requires array")),
                }
            },
            "last" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("last expects 1 argument"));
                }
                ⌥ args[0].value {
                    Value·Array(arr) => ⌥ arr.last() {
                        ?v => Result·Ok(EvidentialValue·uncertain(v.clone())),
                        null => Result·Ok(EvidentialValue·known(Value·Null)),
                    },
                    _ => Result·Err(RuntimeError·new("last requires array")),
                }
            },
            "assert" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("assert expects 1 argument"));
                }
                ⎇ !args[0].value.is_truthy() {
                    ⤺ Result·Err(RuntimeError·new("assertion failed"));
                }
                Result·Ok(EvidentialValue·known(Value·Unit))
            },
            "assert_eq" => {
                ⎇ args.len() != 2 {
                    ⤺ Result·Err(RuntimeError·new("assert_eq expects 2 arguments"));
                }
                ≔ eq = self.values_equal(args[0].value, args[1].value);
                ⎇ !eq {
                    ⤺ Result·Err(RuntimeError·new(format!(
                        "assertion failed: {} != {}",
                        args[0].value.to_string(),
                        args[1].value.to_string()
                    )));
                }
                Result·Ok(EvidentialValue·known(Value·Unit))
            },
            "evidence_of" => {
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("evidence_of expects 1 argument"));
                }
                Result·Ok(EvidentialValue·known(Value·String(args[0].evidence.name())))
            },
            "validate" => {
                // Promote to uncertain
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("validate expects 1 argument"));
                }
                Result·Ok(EvidentialValue {
                    value: args[0].value.clone(),
                    evidence: IrEvidence·Uncertain,
                })
            },
            "verify" => {
                // Promote to known (runtime check passed)
                ⎇ args.len() != 1 {
                    ⤺ Result·Err(RuntimeError·new("verify expects 1 argument"));
                }
                Result·Ok(EvidentialValue·known(args[0].value.clone()))
            },
            "panic" => {
                ≔ msg = ⎇ args.is_empty() {
                    "explicit panic"
                } ⎉ {
                    args[0].value.to_string()
                };
                Result·Err(RuntimeError·new(format!("panic: {}", msg)))
            },
            "todo" => {
                Result·Err(RuntimeError·new("not yet implemented"))
            },
            _ => Result·Err(RuntimeError·new(format!("unknown builtin: {}", name))),
        }
    }

    /// Check value equality
    λ values_equal(self, a: !Value, b: !Value) -> !bool {
        ⌥ (a, b) {
            (Value·Unit, Value·Unit) => true,
            (Value·Bool(a), Value·Bool(b)) => a == b,
            (Value·Int(a), Value·Int(b)) => a == b,
            (Value·Float(a), Value·Float(b)) => a == b,
            (Value·Char(a), Value·Char(b)) => a == b,
            (Value·String(a), Value·String(b)) => a == b,
            (Value·Null, Value·Null) => true,
            (Value·Array(a), Value·Array(b)) => {
                a.len() == b.len() &&
                a.iter().zip(b.iter())|all{pair => self.values_equal(pair.0, pair.1)}
            },
            _ => false,
        }
    }

    /// Evaluate an operation ∈ a given environment
    λ eval_with_env(Δ self, op: !IrOperation, Δ env: !Environment) -> !Result<EvidentialValue, RuntimeError> {
        ⌥ op {
            IrOperation·Literal { value, evidence, .. } => {
                ≔ val = ⌥ value {
                    LiteralValue·Int(n) => Value·Int(n),
                    LiteralValue·Float(f) => Value·Float(f),
                    LiteralValue·Bool(b) => Value·Bool(b),
                    LiteralValue·Char(c) => Value·Char(c),
                    LiteralValue·String(s) => Value·String(s),
                    LiteralValue·Null => Value·Null,
                };
                Result·Ok(EvidentialValue { value: val, evidence })
            },

            IrOperation·Var { name, evidence, .. } => {
                ⌥ env.get(name) {
                    ?val => Result·Ok(val),
                    null => ⌥ self.globals.get(name) {
                        ?val => Result·Ok(val),
                        null => Result·Err(RuntimeError·new(format!("undefined variable: {}", name))),
                    },
                }
            },

            IrOperation·Let { pattern, init, evidence, .. } => {
                ≔ init_val = self.eval_with_env(*init, env)?;
                self.bind_pattern(pattern, init_val, env)?;
                Result·Ok(EvidentialValue·known(Value·Unit))
            },

            IrOperation·Binary { operator, left, right, evidence, .. } => {
                ≔ l = self.eval_with_env(*left, env)?;
                ≔ r = self.eval_with_env(*right, env)?;
                ≔ combined_ev = l.evidence.join(r.evidence);

                ≔ result = self.eval_binary(operator, l.value, r.value)?;
                Result·Ok(EvidentialValue { value: result, evidence: combined_ev })
            },

            IrOperation·Unary { operator, operand, evidence, .. } => {
                ≔ val = self.eval_with_env(*operand, env)?;

                ≔ result = self.eval_unary(operator, val.value)?;
                Result·Ok(EvidentialValue { value: result, evidence: val.evidence })
            },

            IrOperation·Call { function, args, evidence, .. } => {
                ≔ arg_results = args|τ{a => self.eval_with_env(a, env)}|collect_results();
                ≔ arg_vals = arg_results?;
                self.call_function(function, arg_vals)
            },

            IrOperation·If { condition, then_branch, else_branch, evidence, .. } => {
                ≔ cond = self.eval_with_env(*condition, env)?;

                ⎇ cond.value.is_truthy() {
                    self.eval_with_env(*then_branch, env)
                } ⎉ ⎇ ≔ ?else_expr = else_branch {
                    self.eval_with_env(*else_expr, env)
                } ⎉ {
                    Result·Ok(EvidentialValue·known(Value·Unit))
                }
            },

            IrOperation·Block { statements, evidence, .. } => {
                ≔ Δ block_env = Environment·child(env);
                ≔ Δ result = EvidentialValue·known(Value·Unit);

                ∀ stmt ∈ statements {
                    result = self.eval_with_env(stmt, block_env)?;
                }

                Result·Ok(result)
            },

            IrOperation·Return { value, evidence } => {
                ⌥ value {
                    ?v => self.eval_with_env(*v, env),
                    null => Result·Ok(EvidentialValue·known(Value·Unit)),
                }
            },

            IrOperation·Array { elements, evidence, .. } => {
                ≔ vals = elements|τ{e => self.eval_with_env(e, env)?.value}|collect();
                Result·Ok(EvidentialValue { value: Value·Array(vals), evidence })
            },

            IrOperation·Tuple { elements, evidence, .. } => {
                ≔ vals = elements|τ{e => self.eval_with_env(e, env)?.value}|collect();
                Result·Ok(EvidentialValue { value: Value·Tuple(vals), evidence })
            },

            IrOperation·Index { expr, index, evidence, .. } => {
                ≔ arr = self.eval_with_env(*expr, env)?;
                ≔ idx = self.eval_with_env(*index, env)?;

                ⌥ (arr.value, idx.value) {
                    (Value·Array(a), Value·Int(i)) => {
                        ⎇ i < 0 || i >= a.len() as i64 {
                            Result·Err(RuntimeError·new("array index out of bounds"))
                        } ⎉ {
                            Result·Ok(EvidentialValue {
                                value: a[i as u64].clone(),
                                evidence: arr.evidence.join(idx.evidence),
                            })
                        }
                    },
                    (Value·String(s), Value·Int(i)) => {
                        ⎇ i < 0 || i >= s.len() as i64 {
                            Result·Err(RuntimeError·new("string index out of bounds"))
                        } ⎉ {
                            ≔ c = s.chars().nth(i as u64).unwrap();
                            Result·Ok(EvidentialValue {
                                value: Value·Char(c),
                                evidence: arr.evidence.join(idx.evidence),
                            })
                        }
                    },
                    _ => Result·Err(RuntimeError·new("invalid index operation")),
                }
            },

            IrOperation·Field { expr, field, evidence, .. } => {
                ≔ obj = self.eval_with_env(*expr, env)?;

                ⌥ obj.value {
                    Value·Struct { fields, .. } => {
                        ⌥ fields.get(field) {
                            ?v => Result·Ok(EvidentialValue {
                                value: v.clone(),
                                evidence: obj.evidence,
                            }),
                            null => Result·Err(RuntimeError·new(format!("no field: {}", field))),
                        }
                    },
                    Value·Tuple(elements) => {
                        // Tuple field access like .0, .1
                        ≔ idx: ?u64 = field.parse().ok();
                        ⌥ idx {
                            ?i ⎇ i < elements.len() => Result·Ok(EvidentialValue {
                                value: elements[i].clone(),
                                evidence: obj.evidence,
                            }),
                            _ => Result·Err(RuntimeError·new(format!("no tuple field: {}", field))),
                        }
                    },
                    _ => Result·Err(RuntimeError·new("field access on non-struct")),
                }
            },

            IrOperation·Closure { params, body, evidence, .. } => {
                ≔ param_names = params|τ{p => p.name}|collect();
                Result·Ok(EvidentialValue {
                    value: Value·Closure {
                        params: param_names,
                        body: Box·new(*body),
                        env: env.clone(),
                    },
                    evidence,
                })
            },

            IrOperation·Pipeline { input, steps, evidence, .. } => {
                ≔ Δ current = self.eval_with_env(*input, env)?;

                ∀ step ∈ steps {
                    current = self.eval_pipeline_step(step, current, env)?;
                }

                Result·Ok(current)
            },

            IrOperation·Match { scrutinee, arms, evidence, .. } => {
                ≔ val = self.eval_with_env(*scrutinee, env)?;

                ∀ arm ∈ arms {
                    ⎇ self.pattern_matches(arm.pattern, val.value, env)? {
                        ≔ Δ arm_env = Environment·child(env);
                        self.bind_pattern(arm.pattern, val.clone(), arm_env)?;

                        ⎇ ≔ ?guard = arm.guard {
                            ≔ guard_val = self.eval_with_env(guard, arm_env)?;
                            ⎇ !guard_val.value.is_truthy() {
                                ↻;
                            }
                        }

                        ⤺ self.eval_with_env(arm.body, arm_env);
                    }
                }

                Result·Err(RuntimeError·new("non-exhaustive match"))
            },

            IrOperation·Loop { variant, condition, iterator, body, .. } => {
                ⌥ variant {
                    LoopVariant·Infinite => {
                        loop {
                            ≔ result = self.eval_with_env(*body.clone(), env);
                            ⌥ result {
                                Result·Err(RuntimeError { is_break: true, value: ?v, .. }) => {
                                    ⤺ Result·Ok(v);
                                },
                                Result·Err(RuntimeError { is_continue: true, .. }) => continue,
                                Result·Err(e) => ⤺ Result·Err(e),
                                _ => {},
                            }
                        }
                    },
                    LoopVariant·While => {
                        ⟳ {
                            ≔ cond = ⌥ condition {
                                ?c => self.eval_with_env(*c.clone(), env)?,
                                null => EvidentialValue·known(Value·Bool(true)),
                            };
                            cond.value.is_truthy()
                        } {
                            ≔ result = self.eval_with_env(*body.clone(), env);
                            ⌥ result {
                                Result·Err(RuntimeError { is_break: true, value: ?v, .. }) => {
                                    ⤺ Result·Ok(v);
                                },
                                Result·Err(RuntimeError { is_continue: true, .. }) => continue,
                                Result·Err(e) => ⤺ Result·Err(e),
                                _ => {},
                            }
                        }
                        Result·Ok(EvidentialValue·known(Value·Unit))
                    },
                    LoopVariant·For => {
                        ⎇ ≔ ?iter = iterator {
                            ≔ iterable = self.eval_with_env(*iter.iterable, env)?;
                            ≔ items = ⌥ iterable.value {
                                Value·Array(a) => a,
                                Value·String(s) => s.chars()|τ{c => Value·Char(c)}|collect(),
                                _ => ⤺ Result·Err(RuntimeError·new("not iterable")),
                            };

                            ∀ item ∈ items {
                                ≔ Δ loop_env = Environment·child(env);
                                self.bind_pattern(iter.pattern, EvidentialValue {
                                    value: item,
                                    evidence: iterable.evidence,
                                }, loop_env)?;

                                ≔ result = self.eval_with_env(*body.clone(), loop_env);
                                ⌥ result {
                                    Result·Err(RuntimeError { is_break: true, value: ?v, .. }) => {
                                        ⤺ Result·Ok(v);
                                    },
                                    Result·Err(RuntimeError { is_continue: true, .. }) => continue,
                                    Result·Err(e) => ⤺ Result·Err(e),
                                    _ => {},
                                }
                            }
                        }
                        Result·Ok(EvidentialValue·known(Value·Unit))
                    },
                }
            },

            IrOperation·Break { value, .. } => {
                ≔ val = ⌥ value {
                    ?v => ?self.eval_with_env(*v, env)?,
                    null => null,
                };
                Result·Err(RuntimeError·break_with(val))
            },

            IrOperation·Continue { .. } => {
                Result·Err(RuntimeError·continue_loop())
            },

            IrOperation·EvidenceCoerce { expr, to_evidence, .. } => {
                ≔ val = self.eval_with_env(*expr, env)?;
                Result·Ok(EvidentialValue {
                    value: val.value,
                    evidence: to_evidence,
                })
            },

            _ => Result·Err(RuntimeError·new("unsupported operation")),
        }
    }

    /// Evaluate binary operation
    λ eval_binary(self, op: !BinaryOp, left: !Value, right: !Value) -> !Result<Value, RuntimeError> {
        ⌥ op {
            BinaryOp·Add => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Int(a + b)),
                (Value·Float(a), Value·Float(b)) => Result·Ok(Value·Float(a + b)),
                (Value·String(a), Value·String(b)) => Result·Ok(Value·String(format!("{}{}", a, b))),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ +")),
            },
            BinaryOp·Sub => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Int(a - b)),
                (Value·Float(a), Value·Float(b)) => Result·Ok(Value·Float(a - b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ -")),
            },
            BinaryOp·Mul => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Int(a * b)),
                (Value·Float(a), Value·Float(b)) => Result·Ok(Value·Float(a * b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ *")),
            },
            BinaryOp·Div => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => {
                    ⎇ b == 0 {
                        Result·Err(RuntimeError·new("division by zero"))
                    } ⎉ {
                        Result·Ok(Value·Int(a / b))
                    }
                },
                (Value·Float(a), Value·Float(b)) => Result·Ok(Value·Float(a / b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ /")),
            },
            BinaryOp·Rem => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Int(a % b)),
                (Value·Float(a), Value·Float(b)) => Result·Ok(Value·Float(a % b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ %")),
            },
            BinaryOp·Pow => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Int(a.pow(b as u32))),
                (Value·Float(a), Value·Float(b)) => Result·Ok(Value·Float(a.powf(b))),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ **")),
            },
            BinaryOp·Eq => Result·Ok(Value·Bool(self.values_equal(left, right))),
            BinaryOp·Ne => Result·Ok(Value·Bool(!self.values_equal(left, right))),
            BinaryOp·Lt => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Bool(a < b)),
                (Value·Float(a), Value·Float(b)) => Result·Ok(Value·Bool(a < b)),
                (Value·String(a), Value·String(b)) => Result·Ok(Value·Bool(a < b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ <")),
            },
            BinaryOp·Le => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Bool(a <= b)),
                (Value·Float(a), Value·Float(b)) => Result·Ok(Value·Bool(a <= b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ <=")),
            },
            BinaryOp·Gt => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Bool(a > b)),
                (Value·Float(a), Value·Float(b)) => Result·Ok(Value·Bool(a > b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ >")),
            },
            BinaryOp·Ge => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Bool(a >= b)),
                (Value·Float(a), Value·Float(b)) => Result·Ok(Value·Bool(a >= b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ >=")),
            },
            BinaryOp·And => ⌥ (left, right) {
                (Value·Bool(a), Value·Bool(b)) => Result·Ok(Value·Bool(a && b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ &&")),
            },
            BinaryOp·Or => ⌥ (left, right) {
                (Value·Bool(a), Value·Bool(b)) => Result·Ok(Value·Bool(a || b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ ||")),
            },
            BinaryOp·BitAnd => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Int(a & b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ &")),
            },
            BinaryOp·BitOr => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Int(a | b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ |")),
            },
            BinaryOp·BitXor => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Int(a ^ b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ ^")),
            },
            BinaryOp·Shl => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Int(a << b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ <<")),
            },
            BinaryOp·Shr => ⌥ (left, right) {
                (Value·Int(a), Value·Int(b)) => Result·Ok(Value·Int(a >> b)),
                _ => Result·Err(RuntimeError·new("invalid operands ∀ >>")),
            },
            BinaryOp·Concat => ⌥ (left, right) {
                (Value·String(a), Value·String(b)) => Result·Ok(Value·String(format!("{}{}", a, b))),
                (Value·Array(a), Value·Array(b)) => {
                    ≔ Δ result = a.clone();
                    result.extend(b);
                    Result·Ok(Value·Array(result))
                },
                _ => Result·Err(RuntimeError·new("invalid operands ∀ ++")),
            },
        }
    }

    /// Evaluate unary operation
    λ eval_unary(self, op: !UnaryOp, val: !Value) -> !Result<Value, RuntimeError> {
        ⌥ op {
            UnaryOp·Neg => ⌥ val {
                Value·Int(n) => Result·Ok(Value·Int(-n)),
                Value·Float(f) => Result·Ok(Value·Float(-f)),
                _ => Result·Err(RuntimeError·new("invalid operand ∀ unary -")),
            },
            UnaryOp·Not => ⌥ val {
                Value·Bool(b) => Result·Ok(Value·Bool(!b)),
                Value·Int(n) => Result·Ok(Value·Int(!n)),
                _ => Result·Err(RuntimeError·new("invalid operand ∀ !")),
            },
            UnaryOp·Ref => Result·Ok(Value·Ref(Box·new(val))),
            UnaryOp·RefMut => Result·Ok(Value·RefMut(Box·new(val))),
            UnaryOp·Deref => ⌥ val {
                Value·Ref(v) | Value·RefMut(v) => Result·Ok(*v),
                _ => Result·Err(RuntimeError·new("cannot dereference non-reference")),
            },
        }
    }

    /// Evaluate a pipeline step
    λ eval_pipeline_step(Δ self, step: !IrPipelineStep, input: !EvidentialValue, env: !Environment) -> !Result<EvidentialValue, RuntimeError> {
        ⌥ step {
            IrPipelineStep·Morpheme { morpheme, body, .. } => {
                self.eval_morpheme(morpheme, input, body, env)
            },
            IrPipelineStep·Call { function, args } => {
                ≔ Δ all_args = [input];
                ∀ arg ∈ args {
                    all_args.push(self.eval_with_env(arg, env)?);
                }
                self.call_function(function, all_args)
            },
            IrPipelineStep·Method { name, args } => {
                ≔ Δ all_args = [input];
                ∀ arg ∈ args {
                    all_args.push(self.eval_with_env(arg, env)?);
                }
                self.call_function(name, all_args)
            },
            IrPipelineStep·Identity => Result·Ok(input),
            IrPipelineStep·Await => Result·Ok(input), // Sync interpreter, await is no-op
            _ => Result·Err(RuntimeError·new("unsupported pipeline step")),
        }
    }

    /// Evaluate a morpheme operation
    λ eval_morpheme(Δ self, kind: !MorphemeKind, input: !EvidentialValue, body: ?Box<IrOperation>, env: !Environment) -> !Result<EvidentialValue, RuntimeError> {
        ≔ arr = ⌥ input.value {
            Value·Array(a) => a,
            _ => ⤺ Result·Err(RuntimeError·new("morpheme requires array input")),
        };

        ⌥ kind {
            MorphemeKind·Transform => {
                // τ{expr} - map over array
                ≔ body = ⌥ body {
                    ?b => *b,
                    null => ⤺ Result·Err(RuntimeError·new("transform requires body")),
                };

                ≔ results: ![Value] = [];
                ∀ item ∈ arr {
                    ≔ Δ item_env = Environment·child(env);
                    item_env.define("it", EvidentialValue { value: item, evidence: input.evidence });
                    ≔ result = self.eval_with_env(body.clone(), item_env)?;
                    results.push(result.value);
                }
                Result·Ok(EvidentialValue { value: Value·Array(results), evidence: input.evidence })
            },
            MorphemeKind·Filter => {
                // φ{predicate} - filter array
                ≔ body = ⌥ body {
                    ?b => *b,
                    null => ⤺ Result·Err(RuntimeError·new("filter requires body")),
                };

                ≔ results: ![Value] = [];
                ∀ item ∈ arr {
                    ≔ Δ item_env = Environment·child(env);
                    item_env.define("it", EvidentialValue { value: item.clone(), evidence: input.evidence });
                    ≔ result = self.eval_with_env(body.clone(), item_env)?;
                    ⎇ result.value.is_truthy() {
                        results.push(item);
                    }
                }
                Result·Ok(EvidentialValue { value: Value·Array(results), evidence: input.evidence })
            },
            MorphemeKind·Reduce => {
                // ρ{accumulator} - fold array
                ≔ body = ⌥ body {
                    ?b => *b,
                    null => ⤺ Result·Err(RuntimeError·new("reduce requires body")),
                };

                ⎇ arr.is_empty() {
                    ⤺ Result·Err(RuntimeError·new("cannot reduce empty array"));
                }

                ≔ Δ acc = arr[0].clone();
                ≔ Δ idx: usize = 1;
                ⟳ idx < arr.len() {
                    ≔ item = arr[idx].clone();
                    ≔ Δ fold_env = Environment·child(env);
                    fold_env.define("acc", EvidentialValue { value: acc, evidence: input.evidence });
                    fold_env.define("it", EvidentialValue { value: item, evidence: input.evidence });
                    ≔ result = self.eval_with_env(body.clone(), fold_env)?;
                    acc = result.value;
                    idx = idx + 1;
                }
                Result·Ok(EvidentialValue { value: acc, evidence: input.evidence })
            },
            MorphemeKind·Sum => {
                // Σ - sum numbers
                ≔ Δ sum = 0.0;
                ∀ item ∈ arr {
                    ⌥ item {
                        Value·Int(n) => sum += n as f64,
                        Value·Float(f) => sum += f,
                        _ => ⤺ Result·Err(RuntimeError·new("sum requires numbers")),
                    }
                }
                Result·Ok(EvidentialValue { value: Value·Float(sum), evidence: input.evidence })
            },
            MorphemeKind·Product => {
                // Π - product of numbers
                ≔ Δ prod = 1.0;
                ∀ item ∈ arr {
                    ⌥ item {
                        Value·Int(n) => prod *= n as f64,
                        Value·Float(f) => prod *= f,
                        _ => ⤺ Result·Err(RuntimeError·new("product requires numbers")),
                    }
                }
                Result·Ok(EvidentialValue { value: Value·Float(prod), evidence: input.evidence })
            },
            MorphemeKind·Min => {
                ⎇ arr.is_empty() {
                    ⤺ Result·Err(RuntimeError·new("min on empty array"));
                }
                ≔ Δ min_val = arr[0].clone();
                ≔ Δ idx: usize = 1;
                ⟳ idx < arr.len() {
                    ≔ item = arr[idx].clone();
                    ⌥ (min_val.clone(), item) {
                        (Value·Int(a), Value·Int(b)) ⎇ b < a => min_val = Value·Int(b),
                        (Value·Float(a), Value·Float(b)) ⎇ b < a => min_val = Value·Float(b),
                        _ => {},
                    }
                    idx = idx + 1;
                }
                Result·Ok(EvidentialValue { value: min_val, evidence: input.evidence })
            },
            MorphemeKind·Max => {
                ⎇ arr.is_empty() {
                    ⤺ Result·Err(RuntimeError·new("max on empty array"));
                }
                ≔ Δ max_val = arr[0].clone();
                ≔ Δ idx: usize = 1;
                ⟳ idx < arr.len() {
                    ≔ item = arr[idx].clone();
                    ⌥ (max_val.clone(), item) {
                        (Value·Int(a), Value·Int(b)) ⎇ b > a => max_val = Value·Int(b),
                        (Value·Float(a), Value·Float(b)) ⎇ b > a => max_val = Value·Float(b),
                        _ => {},
                    }
                    idx = idx + 1;
                }
                Result·Ok(EvidentialValue { value: max_val, evidence: input.evidence })
            },
            MorphemeKind·First => {
                ⌥ arr.first() {
                    ?v => Result·Ok(EvidentialValue { value: v.clone(), evidence: IrEvidence·Uncertain }),
                    null => Result·Ok(EvidentialValue { value: Value·Null, evidence: IrEvidence·Uncertain }),
                }
            },
            MorphemeKind·Last => {
                ⌥ arr.last() {
                    ?v => Result·Ok(EvidentialValue { value: v.clone(), evidence: IrEvidence·Uncertain }),
                    null => Result·Ok(EvidentialValue { value: Value·Null, evidence: IrEvidence·Uncertain }),
                }
            },
            MorphemeKind·All => {
                // ρ& - all elements truthy
                ≔ Δ all_truthy = true;
                ∀ item ∈ arr { ⎇ !item.is_truthy() { all_truthy = false; ⊗; } }
                Result·Ok(EvidentialValue { value: Value·Bool(all_truthy), evidence: input.evidence })
            },
            MorphemeKind·Any => {
                // ρ| - any element truthy
                ≔ Δ any_truthy = false;
                ∀ item ∈ arr { ⎇ item.is_truthy() { any_truthy = true; ⊗; } }
                Result·Ok(EvidentialValue { value: Value·Bool(any_truthy), evidence: input.evidence })
            },
            _ => Result·Err(RuntimeError·new(format!("unsupported morpheme: {}", kind.symbol()))),
        }
    }

    /// Check ⎇ a pattern matches a value
    λ pattern_matches(self, pattern: !IrPattern, value: !Value, env: !Environment) -> !Result<bool, RuntimeError> {
        ⌥ pattern {
            IrPattern·Wildcard => Result·Ok(true),
            IrPattern·Ident { .. } => Result·Ok(true),
            IrPattern·Literal { value: lit_val } => {
                ≔ lit = ⌥ lit_val {
                    LiteralValue·Int(n) => Value·Int(n),
                    LiteralValue·Float(f) => Value·Float(f),
                    LiteralValue·Bool(b) => Value·Bool(b),
                    LiteralValue·Char(c) => Value·Char(c),
                    LiteralValue·String(s) => Value·String(s),
                    LiteralValue·Null => Value·Null,
                };
                Result·Ok(self.values_equal(lit, value))
            },
            IrPattern·Tuple { elements } => {
                ⌥ value {
                    Value·Tuple(vals) => {
                        ⎇ elements.len() != vals.len() {
                            ⤺ Result·Ok(false);
                        }
                        ∀ (pat, val) ∈ elements.iter().zip(vals.iter()) {
                            ⎇ !self.pattern_matches(pat, val, env)? {
                                ⤺ Result·Ok(false);
                            }
                        }
                        Result·Ok(true)
                    },
                    _ => Result·Ok(false),
                }
            },
            IrPattern·Or { patterns } => {
                ∀ pat ∈ patterns {
                    ⎇ self.pattern_matches(pat, value.clone(), env)? {
                        ⤺ Result·Ok(true);
                    }
                }
                Result·Ok(false)
            },
            IrPattern·TupleStruct { path, fields } => {
                // CG-099: TupleStruct patterns ⌥ ᛈ variants like LiteralValue·String(s)
                ⌥ value {
                    Value·Enum { name, variant, fields: vals } => {
                        // Check ⎇ the path matches "EnumName·Variant" or just "Variant"
                        ≔ full_path = format!("{}·{}", name, variant);
                        ⎇ path != full_path && path != variant {
                            ⤺ Result·Ok(false);
                        }
                        // Check ⎇ all inner patterns match
                        ⎇ fields.len() != vals.len() {
                            ⤺ Result·Ok(false);
                        }
                        ∀ (pat, val) ∈ fields.iter().zip(vals.iter()) {
                            ⎇ !self.pattern_matches(pat, val.clone(), env)? {
                                ⤺ Result·Ok(false);
                            }
                        }
                        Result·Ok(true)
                    },
                    _ => Result·Ok(false),
                }
            },
            IrPattern·Path { path } => {
                // CG-099: Path patterns ⌥ unit ᛈ variants like None or Result·Err
                ⌥ value {
                    Value·Enum { name, variant, fields } => {
                        // Unit variant has no fields
                        ⎇ !fields.is_empty() {
                            ⤺ Result·Ok(false);
                        }
                        // Check ⎇ path matches
                        ≔ full_path = format!("{}·{}", name, variant);
                        Result·Ok(path == full_path || path == variant)
                    },
                    _ => Result·Ok(false),
                }
            },
            _ => Result·Ok(true), // Default ⌥ ∀ complex patterns
        }
    }

    /// Bind pattern variables to values ∈ environment
    λ bind_pattern(Δ self, pattern: !IrPattern, value: !EvidentialValue, Δ env: !Environment) -> !Result<(), RuntimeError> {
        ⌥ pattern {
            IrPattern·Ident { name, evidence, .. } => {
                ≔ ev = ⌥ evidence {
                    ?e => e,
                    null => value.evidence,
                };
                env.define(name, EvidentialValue { value: value.value, evidence: ev });
                Result·Ok(())
            },
            IrPattern·Tuple { elements } => {
                ⌥ value.value {
                    Value·Tuple(vals) => {
                        ∀ (pat, val) ∈ elements.iter().zip(vals.iter()) {
                            self.bind_pattern(pat, EvidentialValue {
                                value: val.clone(),
                                evidence: value.evidence,
                            }, env)?;
                        }
                        Result·Ok(())
                    },
                    _ => Result·Err(RuntimeError·new("expected tuple ∀ destructuring")),
                }
            },
            IrPattern·Wildcard => Result·Ok(()),
            IrPattern·TupleStruct { fields, .. } => {
                // CG-099: Extract ᛈ fields and bind to inner patterns
                ⌥ value.value {
                    Value·Enum { fields: vals, .. } => {
                        ∀ (pat, val) ∈ fields.iter().zip(vals.iter()) {
                            self.bind_pattern(pat, EvidentialValue {
                                value: val.clone(),
                                evidence: value.evidence,
                            }, env)?;
                        }
                        Result·Ok(())
                    },
                    _ => Result·Err(RuntimeError·new("expected ᛈ ∀ TupleStruct pattern")),
                }
            },
            IrPattern·Path { .. } => {
                // CG-099: Unit ᛈ variants have no bindings
                Result·Ok(())
            },
            IrPattern·Or { patterns } => {
                // CG-099: Bind using first pattern (all alternatives should bind same names)
                ⎇ !patterns.is_empty() {
                    self.bind_pattern(patterns[0].clone(), value, env)?;
                }
                Result·Ok(())
            },
            _ => Result·Ok(()), // Other patterns don't bind variables
        }
    }

    /// Get interpreter output
    ☉ λ get_output(self) -> !String {
        self.output.join("")
    }
}

// ============================================================================
// Runtime Errors
// ============================================================================

/// Runtime error
☉ Σ RuntimeError {
    ☉ message: !String,
    ☉ stack_trace: ![String],
    ☉ is_break: !bool,
    ☉ is_continue: !bool,
    ☉ value: ?EvidentialValue,
}

⊢ RuntimeError {
    ☉ λ new(message: !String) -> !RuntimeError {
        RuntimeError {
            message,
            stack_trace: [],
            is_break: false,
            is_continue: false,
            value: null,
        }
    }

    ☉ λ break_with(value: ?EvidentialValue) -> !RuntimeError {
        RuntimeError {
            message: "break",
            stack_trace: [],
            is_break: true,
            is_continue: false,
            value,
        }
    }

    ☉ λ continue_loop() -> !RuntimeError {
        RuntimeError {
            message: "continue",
            stack_trace: [],
            is_break: false,
            is_continue: true,
            value: null,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    λ test_value_to_string() {
        assert_eq!(Value·Int(42).to_string(), "42");
        assert_eq!(Value·Bool(true).to_string(), "true");
        assert_eq!(Value·String("hello").to_string(), "hello");
        assert_eq!(Value·Null.to_string(), "null");
    }

    #[test]
    λ test_value_is_truthy() {
        assert!(Value·Bool(true).is_truthy());
        assert!(!Value·Bool(false).is_truthy());
        assert!(Value·Int(1).is_truthy());
        assert!(!Value·Int(0).is_truthy());
        assert!(!Value·Null.is_truthy());
    }

    #[test]
    λ test_evidence_check() {
        ≔ interp = Interpreter·new();
        assert!(interp.check_evidence(IrEvidence·Reported, IrEvidence·Known));
        assert!(interp.check_evidence(IrEvidence·Uncertain, IrEvidence·Known));
        assert!(!interp.check_evidence(IrEvidence·Known, IrEvidence·Reported));
    }

    #[test]
    λ test_builtin_len() {
        ≔ Δ interp = Interpreter·new();
        ≔ args = [EvidentialValue·known(Value·String("hello"))];
        ≔ result = interp.call_builtin("len", args);
        assert!(result.is_ok());
        ⌥ result.unwrap().value {
            Value·Int(n) => assert_eq!(n, 5),
            _ => panic!("expected int"),
        }
    }

    #[test]
    λ test_binary_ops() {
        ≔ interp = Interpreter·new();
        assert_eq!(interp.eval_binary(BinaryOp·Add, Value·Int(2), Value·Int(3)).unwrap(), Value·Int(5));
        assert_eq!(interp.eval_binary(BinaryOp·Mul, Value·Int(4), Value·Int(5)).unwrap(), Value·Int(20));
    }
}
