//! Recursive descent parser ∀ Sigil.
//!
//! Handles polysynthetic pipe chains, morpheme expressions, and evidentiality.
//! This is the heart of the compiler frontend.
//!
//! Self-hosted conversion: parser.rs -> parser.sg
//! Original: 4,462 lines of Rust
//! Status: Complete

invoke crate·ast·*;
invoke crate·lexer·Lexer;
invoke crate·span·{Span, Spanned};
invoke crate·token·Token;

// ============================================
// Parse Error Types
// ============================================

/// Errors that can occur during parsing.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ ParseError {
    /// Unexpected token encountered
    UnexpectedToken {
        expected: !String,
        found: !Token,
        span: !Span,
    },
    /// Unexpected end of file
    UnexpectedEof,
    /// Invalid number literal
    InvalidNumber(!String),
    /// Custom error message
    Custom(!String),
}

⊢ ParseError {
    /// Create an unexpected token error.
    ☉ λ unexpected(expected: !&str, found: !Token, span: !Span) -> !Self {
        ParseError·UnexpectedToken {
            expected: expected.to_string(),
            found,
            span,
        }
    }

    /// Create a custom error.
    ☉ λ custom(msg: !&str) -> !Self {
        ParseError·Custom(msg.to_string())
    }

    /// Get the error message as a string.
    ☉ λ message(self) -> !String {
        ⌥ self {
            ParseError·UnexpectedToken { expected, found, .. } => {
                format!("unexpected token: expected {}, found {:?}", expected, found)
            },
            ParseError·UnexpectedEof => {
                "unexpected end of file".to_string()
            },
            ParseError·InvalidNumber(s) => {
                format!("invalid number literal: {}", s)
            },
            ParseError·Custom(msg) => {
                msg
            },
        }
    }

    /// Get the span of the error, ⎇ available.
    ☉ λ span(self) -> ?Span {
        ⌥ self {
            ParseError·UnexpectedToken { span, .. } => ?span,
            _ => null,
        }
    }
}

/// Result type ∀ parsing operations.
☉ type ParseResult<T> = Result<T, ParseError>;

// ============================================
// Parser Implementation
// ============================================

/// Recursive descent parser ∀ Sigil.
☉ Σ Parser {
    /// The lexer producing tokens
    lexer: !Lexer,
    /// Current token and span (⎇ any)
    current: ?(Token, Span),
    /// Whether we're parsing a condition (affects < parsing)
    in_condition: !bool,
    /// Pending > token from splitting >> ∈ generics
    pending_gt: ?Span,
}

⊢ Parser {
    /// Create a new parser ∀ the given source code.
    ☉ λ new(source: !String) -> !Self {
        ≔ Δ lexer = Lexer·new(source);
        ≔ current = lexer.next_token();
        Self {
            lexer,
            current,
            in_condition: false,
            pending_gt: null,
        }
    }

    // ========================================
    // Helper Methods
    // ========================================

    /// Check ⎇ we've reached end of file.
    λ is_eof(self) -> !bool {
        self.current == null
    }

    /// Get the current token (⎇ any).
    /// CG-300: Return by value, not reference - returning &token creates dangling pointer
    λ current_token(self) -> ?Token {
        ⌥ self.current {
            (token, _) => token,
            null => null,
        }
    }

    /// Get the current span.
    λ current_span(self) -> !Span {
        ⌥ self.current {
            (_, span) => span,
            null => Span·empty_at(0),
        }
    }

    /// Advance to the next token.
    λ advance(Δ self) {
        self.current = self.lexer.next_token();
    }

    /// Check ⎇ current token matches expected.
    λ check(self, expected: !&Token) -> !bool {
        ⌥ self.current_token() {
            token => token == expected,
            null => false,
        }
    }

    /// Peek at the next token without consuming current.
    λ peek_next_token(self) -> ?Token {
        ⌥ self.lexer.peek() {
            ?(token, _) => ?token.clone(),
            null => null,
        }
    }

    /// Check ⎇ next token is a macro delimiter (paren, bracket, brace).
    λ peek_is_macro_delimiter(self) -> !bool {
        ⌥ self.peek_next_token() {
            ?Token·LParen => true,
            ?Token·LBracket => true,
            ?Token·LBrace => true,
            _ => false,
        }
    }

    /// Check ⎇ the next token matches expected.
    λ peek_is(self, expected: !&Token) -> !bool {
        ⌥ self.peek_next_token() {
            ?token => &token == expected,
            null => false,
        }
    }

    /// Check ⎇ ∈ condition context (< is comparison, not generics).
    λ is_in_condition(self) -> !bool {
        self.in_condition
    }

    /// Consume token ⎇ it matches, ⤺ whether consumed.
    λ consume_if(Δ self, expected: !&Token) -> !bool {
        ⎇ self.check(expected) {
            self.advance();
            true
        } ⎉ {
            false
        }
    }

    /// Expect and consume a token, or ⤺ error.
    λ expect(Δ self, expected: !Token) -> !ParseResult<()> {
        ⎇ self.check(&expected) {
            self.advance();
            Ok(())
        } ⎉ {
            ⌥ self.current {
                (found, span) => Err(ParseError·unexpected(
                    &format!("{:?}", expected),
                    found,
                    span,
                )),
                null => Err(ParseError·UnexpectedEof),
            }
        }
    }

    /// Expect a `>` token, handling the case where `>>` (Shr) needs to be split.
    /// This is necessary ∀ nested generics like `Vec<Option<T>>`.
    λ expect_gt(Δ self) -> !ParseResult<Span> {
        // First check ⎇ we have a pending > from a previous split
        // Use ⌥ instead of ⎇ != null to work around codegen issue
        ⌥ self.pending_gt {
            ?span => {
                self.pending_gt = null;
                ⤺ Ok(span);
            },
            null => {},
        }

        ⌥ self.current {
            (Token·Gt, span) => {
                self.advance();
                Ok(span)
            },
            (Token·Shr, span) => {
                // Split >> into two > tokens
                // Take the first > now and save the second ∀ later
                self.pending_gt = ?span;
                self.advance();
                Ok(span)
            },
            (found, span) => Err(ParseError·unexpected("Token·Gt", found, span)),
            null => Err(ParseError·UnexpectedEof),
        }
    }

    // ========================================
    // Top-Level Parsing
    // ========================================

    /// Parse a complete source file.
    ☉ λ parse_file(Δ self) -> !ParseResult<SourceFile> {
        // Parse inner attributes (#![...])
        ≔ Δ attrs = Vec·new();
        ⟳ self.check(&Token·HashBang) {
            attrs.push(self.parse_inner_attribute()?);
        }

        // Build crate config from attributes
        ≔ config = self.build_crate_config(&attrs);

        // Parse items
        ≔ Δ items = Vec·new();
        ⟳ !self.is_eof() {
            // Skip comments
            ⟳ self.check(&Token·LineComment(_)) || self.check(&Token·DocComment(_)) {
                self.advance();
            }
            ⎇ self.is_eof() {
                ⊗;
            }
            items.push(self.parse_item()?);
        }

        Ok(SourceFile { path: null, attrs, config, items })
    }

    /// Parse an inner attribute: `#![name]` or `#![name(args)]`
    λ parse_inner_attribute(Δ self) -> !ParseResult<Attribute> {
        self.expect(Token·HashBang)?;
        self.expect(Token·LBracket)?;

        ≔ name = self.parse_ident()?;
        ≔ args = self.parse_attr_args()?;

        self.expect(Token·RBracket)?;

        Ok(Attribute {
            name,
            args,
            is_inner: true,
        })
    }

    /// Parse an outer attribute: `#[name]` or `#[name(args)]` or `@[name]` or `@[A, B, C]`
    λ parse_outer_attribute(Δ self) -> !ParseResult<Attribute> {
        // Accept both # and @ as attribute prefix
        ≔ is_at_syntax = self.check(&Token·At);
        ⎇ self.check(&Token·Hash) {
            self.advance();
        } ⎉ ⎇ is_at_syntax {
            self.advance();
        } ⎉ {
            ⤺ Err(ParseError·unexpected("# or @", self.current_token()!, self.current_span()));
        }
        self.expect(Token·LBracket)?;

        ≔ name = self.parse_ident()?;

        // For @[A, B, C] syntax, treat as derive(A, B, C)
        ⎇ is_at_syntax && self.check(&Token·Comma) {
            // Collect all comma-separated identifiers as derive arguments
            ≔ Δ derive_args: ![AttrArg] = [AttrArg·Ident(name.clone())];
            ⟳ self.consume_if(&Token·Comma) {
                ⎇ self.check(&Token·RBracket) {
                    ⊗;
                }
                ≔ arg_name = self.parse_ident()?;
                derive_args.push(AttrArg·Ident(arg_name));
            }
            self.expect(Token·RBracket)?;
            ⤺ Ok(Attribute {
                name: Ident·new("derive".to_string(), name.span),
                args: ?AttrArgs·Paren(derive_args),
                is_inner: false,
            });
        }

        ≔ args = self.parse_attr_args()?;

        self.expect(Token·RBracket)?;

        Ok(Attribute {
            name,
            args,
            is_inner: false,
        })
    }

    /// Parse attribute arguments ⎇ present.
    λ parse_attr_args(Δ self) -> !ParseResult<?AttrArgs> {
        ⎇ self.consume_if(&Token·LParen) {
            ≔ Δ args = Vec·new();
            ⟳ !self.check(&Token·RParen) {
                args.push(self.parse_attr_arg()?);
                ⎇ !self.consume_if(&Token·Comma) {
                    ⊗;
                }
            }
            self.expect(Token·RParen)?;
            Ok(AttrArgs·Paren(args))
        } ⎉ ⎇ self.consume_if(&Token·Eq) {
            ≔ expr = self.parse_expr()?;
            Ok(AttrArgs·Eq(Box·new(expr)))
        } ⎉ {
            Ok(null)
        }
    }

    /// Parse a single attribute argument.
    λ parse_attr_arg(Δ self) -> !ParseResult<AttrArg> {
        ⌥ self.current_token().cloned() {
            Token·StringLit(s) => {
                self.advance();
                Ok(AttrArg·Literal(Literal·String(s)))
            }
            Token·IntLit(s) => {
                self.advance();
                Ok(AttrArg·Literal(Literal·Int {
                    value: s,
                    base: NumBase·Decimal,
                    suffix: null,
                }))
            }
            Token·Ident(_) => {
                ≔ ident = self.parse_ident()?;
                self.parse_attr_arg_after_ident(ident)
            }
            t => Err(ParseError·unexpected("attribute argument", t?, self.current_span())),
        }
    }

    /// Continue parsing after identifier ∈ attribute argument.
    λ parse_attr_arg_after_ident(Δ self, ident: !Ident) -> !ParseResult<AttrArg> {
        ⎇ self.consume_if(&Token·Eq) {
            ≔ value = self.parse_expr()?;
            Ok(AttrArg·KeyValue {
                key: ident,
                value: Box·new(value),
            })
        } ⎉ ⎇ self.check(&Token·LParen) {
            ≔ args = self.parse_attr_args()?;
            Ok(AttrArg·Nested(Attribute {
                name: ident,
                args,
                is_inner: false,
            }))
        } ⎉ {
            Ok(AttrArg·Ident(ident))
        }
    }

    /// Build crate configuration from parsed attributes.
    λ build_crate_config(self, attrs: !&[Attribute]) -> !CrateConfig {
        ≔ Δ config = CrateConfig·default();

        ∀ attr ∈ attrs {
            ⌥ attr.name.name.as_str() {
                "no_std" => config.no_std = true,
                "no_main" => config.no_main = true,
                "feature" => {
                    ⎇ ≔ AttrArgs·Paren(args) = &attr.args? {
                        ∀ arg ∈ args {
                            ⎇ ≔ AttrArg·Ident(ident) = arg {
                                config.features.push(ident.name.clone());
                            }
                        }
                    }
                }
                _ => {}
            }
        }

        config
    }

    // ========================================
    // Item Parsing
    // ========================================

    /// Parse a top-level item.
    λ parse_item(Δ self) -> !ParseResult<Spanned<Item>> {
        ≔ start = self.current_span().start;

        // Parse outer attributes (both #[...] and @[...] syntax)
        ≔ Δ attrs = Vec·new();
        ⟳ self.check(&Token·Hash) || self.check(&Token·At) {
            attrs.push(self.parse_outer_attribute()?);
        }

        // Check ∀ #[macro_export] attribute
        ≔ Δ is_macro_export = false;
        ∀ attr ∈ attrs.clone() {
            ⌥ attr.value.path.segments.first() {
                ?seg => {
                    ⎇ seg.value.name == "macro_export" {
                        is_macro_export = true;
                    }
                }
                null => {}
            }
        }

        // Parse visibility
        ≔ visibility = self.parse_visibility()?;

        // Check ∀ macro_rules! or macro special case
        ≔ is_macro_rules = ⌥ self.current_token().cloned() {
            Token·Ident(name) => name == "macro_rules",
            _ => false,
        };

        ≔ is_macro = ⌥ self.current_token().cloned() {
            Token·Ident(name) => name == "macro",
            _ => false,
        };

        // Parse the item itself
        ≔ item = ⎇ is_macro_rules {
            self.parse_macro_rules(is_macro_export)?
        } ⎉ ⎇ is_macro {
            // Skip macro definition (declarative macro: macro name { ... })
            self.skip_macro_def()?
        } ⎉ {
            ⌥ self.current_token() {
                Token·Fn => self.parse_function(visibility, attrs, false)?,
                Token·Async => {
                    self.advance();
                    self.parse_function(visibility, attrs, true)?
                }
                Token·Unsafe => {
                    self.advance();
                    // unsafe λ or unsafe ⊢ or unsafe trait
                    ⌥ self.current_token() {
                        Token·Fn => self.parse_function(visibility, attrs, false)?,
                        Token·Impl => self.parse_impl()?,
                        Token·Trait => self.parse_trait(visibility)?,
                        _ => ⤺ Err(ParseError·custom("expected fn, impl, or Θ after unsafe")),
                    }
                }
                Token·Struct => self.parse_struct(visibility, attrs)?,
                Token·Enum => self.parse_enum(visibility)?,
                Token·Trait => self.parse_trait(visibility)?,
                Token·Impl => self.parse_impl()?,
                Token·Type => self.parse_type_alias(visibility)?,
                Token·Mod => self.parse_module(visibility)?,
                Token·Use => self.parse_use(visibility)?,
                Token·Const => self.parse_const(visibility)?,
                Token·Static => self.parse_static(visibility)?,
                Token·Actor => self.parse_actor(visibility)?,
                Token·Extern => self.parse_extern_block()?,
                Token·Ident(_) => {
                    // Check ⎇ this is a macro invocation: name!(...)
                    ⎇ self.peek_is(&Token·Bang) {
                        self.skip_item_macro()?
                    } ⎉ {
                        // Handle unknown item declarations like `scroll feature_name;`
                        self.skip_unknown_item()?
                    }
                }
                t => ⤺ Err(ParseError·unexpected("item", t?, self.current_span())),
            }
        };

        ≔ end = self.current_span().end;
        Ok(Spanned·new(item, Span·new(start, end)))
    }

    /// Parse visibility modifier.
    λ parse_visibility(Δ self) -> !ParseResult<Visibility> {
        ⎇ self.consume_if(&Token·Pub) {
            Ok(Visibility·Public)
        } ⎉ ⎇ self.consume_if(&Token·Crate) {
            Ok(Visibility·Crate)
        } ⎉ ⎇ self.consume_if(&Token·Super) {
            Ok(Visibility·Super)
        } ⎉ {
            Ok(Visibility·Private)
        }
    }

    /// Parse a function definition.
    λ parse_function(Δ self, visibility: !Visibility, attrs: ![Attribute], is_async: !bool) -> !ParseResult<Item> {
        self.expect(Token·Fn)?;

        ≔ name = self.parse_ident()?;

        // Consume optional evidentiality marker on function name: λ validate!(), λ estimate~()
        self.consume_if(&Token·Bang) || self.consume_if(&Token·Tilde) ||
            self.consume_if(&Token·Question) || self.consume_if(&Token·Lozenge);

        // Parse optional aspect: λ name·ing, λ name·ed, etc.
        ≔ aspect = ⎇ self.check(&Token·AspectProgressive) {
            self.advance();
            Aspect·Progressive
        } ⎉ ⎇ self.check(&Token·AspectPerfective) {
            self.advance();
            Aspect·Perfective
        } ⎉ ⎇ self.check(&Token·AspectPotential) {
            self.advance();
            Aspect·Potential
        } ⎉ ⎇ self.check(&Token·AspectResultative) {
            self.advance();
            Aspect·Resultative
        } ⎉ {
            null
        };

        // Parse generics
        ≔ generics = self.parse_generics_opt()?;

        // Parse parameters
        self.expect(Token·LParen)?;
        ≔ params = self.parse_params()?;
        self.expect(Token·RParen)?;

        // Parse ⤺ type
        ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
            self.parse_type()?
        } ⎉ {
            null
        };

        // Parse where clause
        ≔ where_clainvoke = self.parse_where_clause_opt()?;

        // Parse body (or optional semicolon ∀ declarations)
        ≔ body = ⎇ self.check(&Token·LBrace) {
            self.parse_block()?
        } ⎉ {
            // Semicolon is optional ∀ trait/⊢ method declarations
            self.consume_if(&Token·Semi);
            null
        };

        // Build function attributes from parsed outer attributes
        ≔ fn_attrs = self.build_function_attrs(attrs);

        Ok(Item·Function(Function {
            visibility,
            is_async,
            attrs: fn_attrs,
            name,
            aspect,
            generics,
            params,
            return_type,
            where_clause,
            body,
        }))
    }

    /// Build function attributes from outer attributes.
    λ build_function_attrs(self, attrs: ![Attribute]) -> !FunctionAttrs {
        ≔ Δ fn_attrs = FunctionAttrs·default();
        fn_attrs.outer_attrs = attrs.clone();

        ∀ attr ∈ &attrs {
            ⌥ attr.name.name.as_str() {
                "inline" => fn_attrs.inline = InlineHint·Hint,
                "cold" => fn_attrs.cold = true,
                "hot" => fn_attrs.hot = true,
                "naked" => fn_attrs.naked = true,
                "no_mangle" => fn_attrs.no_mangle = true,
                "export" => fn_attrs.export = true,
                "test" => fn_attrs.test = true,
                "entry" => fn_attrs.entry = true,
                "panic_handler" => fn_attrs.panic_handler = true,
                _ => {}
            }
        }

        fn_attrs
    }

    /// Parse function parameters.
    λ parse_params(Δ self) -> !ParseResult<[Param]> {
        ≔ Δ params = Vec·new();

        ⟳ !self.check(&Token·RParen) {
            // Handle self parameter (self, &self, &Δ self, Δ self)
            ⎇ self.check(&Token·SelfLower) || self.check(&Token·Amp) ||
               (self.check(&Token·Mut) && self.peek_is(&Token·SelfLower)) {
                ≔ param = self.parse_self_param()?;
                params.push(param);
            } ⎉ {
                ≔ pattern = self.parse_pattern()?;
                self.expect(Token·Colon)?;
                ≔ ty = self.parse_type()?;
                params.push(Param { pattern, ty });
            }

            ⎇ !self.consume_if(&Token·Comma) {
                ⊗;
            }
        }

        Ok(params)
    }

    /// Parse self parameter.
    /// Handles: self, Δ self, &self, &Δ self
    λ parse_self_param(Δ self) -> !ParseResult<Param> {
        ≔ span = self.current_span();

        // Check ∀ reference variants: &self, &Δ self
        ≔ is_ref = self.consume_if(&Token·Amp);
        ≔ mutable = ⎇ is_ref {
            // &Δ self
            self.consume_if(&Token·Mut)
        } ⎉ {
            // Δ self (no &)
            self.consume_if(&Token·Mut)
        };

        self.expect(Token·SelfLower)?;

        ≔ pattern = Pattern·Ident {
            mutable,
            by_ref: false,
            name: Ident·new("self".to_string(), span),
            evidentiality: null,
        };

        // Check ∀ explicit type annotation: self: &Self!, self: Self, etc.
        ≔ ty = ⎇ self.consume_if(&Token·Colon) {
            self.parse_type()?
        } ⎉ {
            // Self type is inferred based on & and mut
            ⎇ is_ref {
                TypeExpr·Reference {
                    lifetime: null,
                    mutable,
                    inner: Box·new(TypeExpr·Path(TypePath·simple("Self".to_string(), span))),
                }
            } ⎉ {
                TypeExpr·Path(TypePath·simple("Self".to_string(), span))
            }
        };

        Ok(Param { pattern, ty })
    }

    /// Parse a Σ definition.
    λ parse_struct(Δ self, visibility: !Visibility, attrs: ![Attribute]) -> !ParseResult<Item> {
        self.expect(Token·Struct)?;

        ≔ name = self.parse_ident()?;

        // Handle evidential Σ syntax ∈ either order:
        // - Σ Foo!<T>  (evidentiality before generics)
        // - Σ Foo<T>~  (evidentiality after generics)
        // All four markers: ! (known), ~ (reported), ? (uncertain), ◊ (approximate)
        ≔ _is_evidential_before = self.consume_if(&Token·Bang) || self.consume_if(&Token·Tilde) ||
                                    self.consume_if(&Token·Question) || self.consume_if(&Token·Lozenge);

        ≔ generics = self.parse_generics_opt()?;

        ≔ _is_evidential_after = self.consume_if(&Token·Bang) || self.consume_if(&Token·Tilde) ||
                                   self.consume_if(&Token·Question) || self.consume_if(&Token·Lozenge);

        // Build Σ attributes
        ≔ struct_attrs = self.build_struct_attrs(attrs);

        ≔ fields = ⎇ self.check(&Token·LBrace) {
            // Named fields
            self.advance();
            ≔ Δ fields = Vec·new();
            ⟳ !self.check(&Token·RBrace) {
                ≔ vis = self.parse_visibility()?;
                ≔ name = self.parse_ident()?;
                // Consume optional evidentiality marker on field name (e.g., train_loss!)
                self.parse_evidentiality_opt();
                self.expect(Token·Colon)?;
                ≔ ty = self.parse_type()?;
                ≔ default = ⎇ self.consume_if(&Token·Eq) {
                    self.parse_expr()?
                } ⎉ {
                    null
                };
                fields.push(FieldDef { visibility: vis, name, ty, default });
                ⎇ !self.consume_if(&Token·Comma) {
                    ⊗;
                }
            }
            self.expect(Token·RBrace)?;
            StructFields·Named(fields)
        } ⎉ ⎇ self.check(&Token·LParen) {
            // Tuple Σ - may have visibility on fields like (☉ T, ☉ U)
            self.advance();
            ≔ Δ types = Vec·new();
            ⟳ !self.check(&Token·RParen) {
                self.parse_visibility()?;  // Skip optional pub
                types.push(self.parse_type()?);
                ⎇ !self.consume_if(&Token·Comma) {
                    ⊗;
                }
            }
            self.expect(Token·RParen)?;
            self.expect(Token·Semi)?;
            StructFields·Tuple(types)
        } ⎉ {
            // Unit struct
            self.expect(Token·Semi)?;
            StructFields·Unit
        };

        Ok(Item·Struct(StructDef {
            visibility,
            attrs: struct_attrs,
            name,
            generics,
            fields,
        }))
    }

    /// Build Σ attributes from outer attributes.
    λ build_struct_attrs(self, attrs: ![Attribute]) -> !StructAttrs {
        ≔ Δ struct_attrs = StructAttrs·default();
        struct_attrs.outer_attrs = attrs.clone();

        ∀ attr ∈ &attrs {
            ⌥ attr.name.name.as_str() {
                "derive" => {
                    ⎇ ≔ AttrArgs·Paren(args) = &attr.args? {
                        ∀ arg ∈ args {
                            ⎇ ≔ AttrArg·Ident(ident) = arg {
                                ≔ derive = ⌥ ident.name.as_str() {
                                    "Debug" => DeriveTrait·Debug,
                                    "Clone" => DeriveTrait·Clone,
                                    "Copy" => DeriveTrait·Copy,
                                    "Default" => DeriveTrait·Default,
                                    "PartialEq" => DeriveTrait·PartialEq,
                                    "Eq" => DeriveTrait·Eq,
                                    "Hash" => DeriveTrait·Hash,
                                    other => DeriveTrait·Custom(other.to_string()),
                                };
                                struct_attrs.derives.push(derive);
                            }
                        }
                    }
                }
                "repr" => {
                    ⎇ ≔ AttrArgs·Paren(args) = &attr.args? {
                        ⎇ ≔ [AttrArg·Ident(ident)] = args.as_slice() {
                            struct_attrs.repr = ⌥ ident.name.as_str() {
                                "C" => StructRepr·C,
                                "transparent" => StructRepr·Transparent,
                                other => StructRepr·Int(other.to_string()),
                            };
                        }
                    }
                }
                "packed" => struct_attrs.packed = true,
                "simd" => struct_attrs.simd = true,
                _ => {}
            }
        }

        struct_attrs
    }

    /// Parse an ᛈ definition.
    λ parse_enum(Δ self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token·Enum)?;

        ≔ name = self.parse_ident()?;
        ≔ generics = self.parse_generics_opt()?;

        self.expect(Token·LBrace)?;
        ≔ Δ variants = Vec·new();
        ⟳ !self.check(&Token·RBrace) {
            // Skip attributes on ᛈ variants (both #[...] and @[...])
            ⟳ self.check(&Token·Hash) || self.check(&Token·At) {
                self.parse_outer_attribute()?;
            }
            ≔ variant_name = self.parse_ident()?;

            ≔ fields = ⎇ self.check(&Token·LBrace) {
                // Named fields
                self.advance();
                ≔ Δ fields = Vec·new();
                ⟳ !self.check(&Token·RBrace) {
                    ≔ name = self.parse_ident()?;
                    self.expect(Token·Colon)?;
                    ≔ ty = self.parse_type()?;
                    fields.push(FieldDef {
                        visibility: Visibility·Private,
                        name,
                        ty,
                        default: null,
                    });
                    ⎇ !self.consume_if(&Token·Comma) {
                        ⊗;
                    }
                }
                self.expect(Token·RBrace)?;
                StructFields·Named(fields)
            } ⎉ ⎇ self.check(&Token·LParen) {
                // Tuple variant
                self.advance();
                ≔ types = self.parse_type_list()?;
                self.expect(Token·RParen)?;
                StructFields·Tuple(types)
            } ⎉ {
                StructFields·Unit
            };

            ≔ discriminant = ⎇ self.consume_if(&Token·Eq) {
                self.parse_expr()?
            } ⎉ {
                null
            };

            variants.push(EnumVariant {
                name: variant_name,
                fields,
                discriminant,
            });

            ⎇ !self.consume_if(&Token·Comma) {
                ⊗;
            }
        }
        self.expect(Token·RBrace)?;

        Ok(Item·Enum(EnumDef {
            visibility,
            name,
            generics,
            variants,
        }))
    }

    /// Parse a Θ definition.
    λ parse_trait(Δ self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token·Trait)?;

        ≔ name = self.parse_ident()?;
        ≔ generics = self.parse_generics_opt()?;

        // Parse supertraits
        ≔ supertraits = ⎇ self.consume_if(&Token·Colon) {
            self.parse_type_bounds()?
        } ⎉ {
            Vec·new()
        };

        self.expect(Token·LBrace)?;
        ≔ Δ items = Vec·new();
        ⟳ !self.check(&Token·RBrace) {
            ≔ item = self.parse_trait_item()?;
            items.push(item);
        }
        self.expect(Token·RBrace)?;

        Ok(Item·Trait(TraitDef {
            visibility,
            name,
            generics,
            supertraits,
            items,
        }))
    }

    /// Parse a Θ item.
    λ parse_trait_item(Δ self) -> !ParseResult<TraitItem> {
        ⌥ self.current_token() {
            Token·Fn | Token·Async | Token·Unsafe => {
                ≔ is_async = self.consume_if(&Token·Async);
                ≔ _is_unsafe = self.consume_if(&Token·Unsafe);
                ≔ Item·Function(f) = self.parse_function(Visibility·Private, Vec·new(), is_async)? ⎉ {
                    ⤺ Err(ParseError·custom("expected function"));
                };
                Ok(TraitItem·Function(f))
            }
            Token·Type => {
                self.advance();
                ≔ name = self.parse_ident()?;
                ≔ bounds = ⎇ self.consume_if(&Token·Colon) {
                    self.parse_type_bounds()?
                } ⎉ {
                    Vec·new()
                };
                self.expect(Token·Semi)?;
                Ok(TraitItem·Type { name, bounds })
            }
            Token·Const => {
                self.advance();
                ≔ name = self.parse_ident()?;
                self.expect(Token·Colon)?;
                ≔ ty = self.parse_type()?;
                self.expect(Token·Semi)?;
                Ok(TraitItem·Const { name, ty })
            }
            t => Err(ParseError·unexpected("Θ item", t?, self.current_span())),
        }
    }

    /// Parse an ⊢ block.
    λ parse_impl(Δ self) -> !ParseResult<Item> {
        self.expect(Token·Impl)?;

        ≔ generics = self.parse_generics_opt()?;

        // Parse type (and possibly trait)
        ≔ first_type = self.parse_type()?;

        ≔ (trait_, self_ty) = ⎇ self.consume_if(&Token·For) {
            // ⊢ Trait ∀ Type
            ≔ self_ty = self.parse_type()?;
            ≔ trait_path = ⌥ first_type {
                TypeExpr·Path(p) => p,
                _ => ⤺ Err(ParseError·custom("expected Θ path")),
            };
            (trait_path, self_ty)
        } ⎉ {
            // ⊢ Type
            (null, first_type)
        };

        // Skip optional where clause
        self.skip_where_clause()?;

        self.expect(Token·LBrace)?;
        ≔ Δ items = Vec·new();
        ⟳ !self.check(&Token·RBrace) {
            ≔ item = self.parse_impl_item()?;
            items.push(item);
        }
        self.expect(Token·RBrace)?;

        Ok(Item·Impl(ImplBlock {
            generics,
            trait_,
            self_ty,
            items,
        }))
    }

    /// Parse an ⊢ item.
    λ parse_impl_item(Δ self) -> !ParseResult<ImplItem> {
        // Skip outer attributes
        ⟳ self.check(&Token·Hash) || self.check(&Token·At) {
            self.parse_outer_attribute()?;
        }

        ≔ visibility = self.parse_visibility()?;

        ⌥ self.current_token() {
            Token·Fn | Token·Async | Token·Unsafe => {
                ≔ is_async = self.consume_if(&Token·Async);
                ≔ _is_unsafe = self.consume_if(&Token·Unsafe);
                ≔ Item·Function(f) = self.parse_function(visibility, Vec·new(), is_async)? ⎉ {
                    ⤺ Err(ParseError·custom("expected function"));
                };
                Ok(ImplItem·Function(f))
            }
            Token·Type => {
                self.advance();
                ≔ name = self.parse_ident()?;
                self.expect(Token·Eq)?;
                ≔ ty = self.parse_type()?;
                self.expect(Token·Semi)?;
                Ok(ImplItem·Type(TypeAlias {
                    visibility,
                    name,
                    generics: null,
                    ty,
                }))
            }
            Token·Const => {
                // Check ⎇ this is `const fn` or associated constant
                ⎇ self.peek_is(&Token·Fn) {
                    self.advance(); // consume const
                    ≔ Item·Function(f) = self.parse_function(visibility, Vec·new(), false)? ⎉ {
                        ⤺ Err(ParseError·custom("expected function"));
                    };
                    Ok(ImplItem·Function(f))
                } ⎉ {
                    self.advance();
                    ≔ name = self.parse_ident()?;
                    self.expect(Token·Colon)?;
                    ≔ ty = self.parse_type()?;
                    self.expect(Token·Eq)?;
                    ≔ value = self.parse_expr()?;
                    self.expect(Token·Semi)?;
                    Ok(ImplItem·Const(ConstDef {
                        visibility,
                        name,
                        ty,
                        value,
                    }))
                }
            }
            t => Err(ParseError·unexpected("⊢ item", t?, self.current_span())),
        }
    }

    /// Parse a type alias.
    λ parse_type_alias(Δ self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token·Type)?;
        ≔ name = self.parse_ident()?;
        // Skip optional evidentiality marker on type alias name
        self.consume_if(&Token·Bang) || self.consume_if(&Token·Tilde) ||
            self.consume_if(&Token·Question) || self.consume_if(&Token·Lozenge);
        ≔ generics = self.parse_generics_opt()?;
        self.expect(Token·Eq)?;

        // Check ∀ inline ᛈ definition: type Foo = ᛈ { ... }
        ⎇ self.check(&Token·Enum) {
            self.advance();
            self.expect(Token·LBrace)?;
            // Parse ᛈ variants with optional discriminants
            ≔ Δ variants = Vec·new();
            ⟳ !self.check(&Token·RBrace) {
                ≔ variant_name = self.parse_ident()?;
                // Optional discriminant: = value
                ⎇ self.consume_if(&Token·Eq) {
                    // Skip the discriminant value (just need to parse it)
                    self.parse_expr()?;
                }
                variants.push(EnumVariant {
                    name: variant_name,
                    fields: StructFields·Unit,
                });
                ⎇ !self.consume_if(&Token·Comma) {
                    ⊗;
                }
            }
            self.expect(Token·RBrace)?;
            // Create as ᛈ item
            ⤺ Ok(Item·Enum(EnumDecl {
                visibility,
                name,
                generics,
                variants,
            }));
        }

        ≔ ty = self.parse_type()?;
        // Semicolon is optional ∀ newline-terminated items
        self.consume_if(&Token·Semi);

        Ok(Item·TypeAlias(TypeAlias {
            visibility,
            name,
            generics,
            ty,
        }))
    }

    /// Parse a module.
    λ parse_module(Δ self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token·Mod)?;
        ≔ name = self.parse_ident()?;

        ≔ items = ⎇ self.check(&Token·LBrace) {
            self.advance();
            ≔ Δ items = Vec·new();
            ⟳ !self.check(&Token·RBrace) {
                items.push(self.parse_item()?);
            }
            self.expect(Token·RBrace)?;
            items
        } ⎉ {
            // Semicolon is optional ∀ module declarations (Sigil style)
            self.consume_if(&Token·Semi);
            null
        };

        Ok(Item·Module(Module {
            visibility,
            name,
            items,
        }))
    }

    /// Parse a invoke declaration.
    λ parse_use(Δ self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token·Use)?;
        ≔ tree = self.parse_use_tree()?;
        // Semicolon is optional ∀ use/invoke statements (Rust-compatible)
        self.consume_if(&Token·Semi);

        Ok(Item·Use(UseDecl { visibility, tree }))
    }

    /// Parse a invoke tree.
    λ parse_use_tree(Δ self) -> !ParseResult<UseTree> {
        ≔ ident = self.parse_ident()?;

        // Consume optional evidentiality markers (Gradient!, MomentEstimate~)
        // These are part of the type name ∈ Sigil
        self.parse_evidentiality_opt();

        // Support both · and · (middle dot) as path separators
        ⎇ self.consume_if(&Token·ColonColon) || self.consume_if(&Token·MiddleDot) {
            ⎇ self.check(&Token·LBrace) {
                // invoke foo·{bar, baz}
                self.advance();
                ≔ Δ trees = Vec·new();
                ⟳ !self.check(&Token·RBrace) {
                    // Skip conditional attributes: #[cfg(...)]
                    ⟳ self.check(&Token·Hash) {
                        self.skip_outer_attribute()?;
                    }
                    ⎇ self.check(&Token·RBrace) { ⊗; }
                    trees.push(self.parse_use_tree()?);
                    ⎇ !self.consume_if(&Token·Comma) {
                        ⊗;
                    }
                }
                self.expect(Token·RBrace)?;
                Ok(UseTree·Path {
                    prefix: ident,
                    suffix: Box·new(UseTree·Group(trees)),
                })
            } ⎉ ⎇ self.check(&Token·Star) {
                // invoke foo·*
                self.advance();
                Ok(UseTree·Path {
                    prefix: ident,
                    suffix: Box·new(UseTree·Glob),
                })
            } ⎉ {
                // invoke foo·bar
                ≔ suffix = self.parse_use_tree()?;
                Ok(UseTree·Path {
                    prefix: ident,
                    suffix: Box·new(suffix),
                })
            }
        } ⎉ ⎇ self.consume_if(&Token·As) {
            // invoke foo as bar
            ≔ alias = self.parse_ident()?;
            Ok(UseTree·Rename { name: ident, alias })
        } ⎉ {
            Ok(UseTree·Name(ident))
        }
    }

    /// Parse a const definition.
    λ parse_const(Δ self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token·Const)?;
        ≔ name = self.parse_ident()?;
        self.expect(Token·Colon)?;
        ≔ ty = self.parse_type()?;
        self.expect(Token·Eq)?;
        ≔ value = self.parse_expr()?;
        // Semicolon is optional ∀ newline-terminated items
        self.consume_if(&Token·Semi);

        Ok(Item·Const(ConstDef { visibility, name, ty, value }))
    }

    /// Parse a static definition.
    λ parse_static(Δ self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token·Static)?;
        ≔ mutable = self.consume_if(&Token·Mut);
        ≔ name = self.parse_ident()?;
        self.expect(Token·Colon)?;
        ≔ ty = self.parse_type()?;
        self.expect(Token·Eq)?;
        ≔ value = self.parse_expr()?;
        // Semicolon is optional ∀ newline-terminated items
        self.consume_if(&Token·Semi);

        Ok(Item·Static(StaticDef { visibility, mutable, name, ty, value }))
    }

    /// Parse an actor definition.
    λ parse_actor(Δ self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token·Actor)?;
        ≔ name = self.parse_ident()?;
        ≔ generics = self.parse_generics_opt()?;

        self.expect(Token·LBrace)?;

        // Parse state fields
        ≔ Δ state = Vec·new();
        ≔ Δ handlers = Vec·new();

        ⟳ !self.check(&Token·RBrace) {
            ⎇ self.check(&Token·On) {
                // Message handler
                handlers.push(self.parse_message_handler()?);
            } ⎉ {
                // State field
                ≔ name = self.parse_ident()?;
                self.expect(Token·Colon)?;
                ≔ ty = self.parse_type()?;
                ≔ default = ⎇ self.consume_if(&Token·Eq) {
                    self.parse_expr()?
                } ⎉ {
                    null
                };
                state.push(FieldDef {
                    visibility: Visibility·Private,
                    name,
                    ty,
                    default,
                });
                self.consume_if(&Token·Comma);
            }
        }

        self.expect(Token·RBrace)?;

        Ok(Item·Actor(ActorDef {
            visibility,
            name,
            generics,
            state,
            handlers,
        }))
    }

    /// Parse a message handler.
    λ parse_message_handler(Δ self) -> !ParseResult<MessageHandler> {
        self.expect(Token·On)?;
        ≔ message = self.parse_ident()?;
        self.expect(Token·LParen)?;
        ≔ params = self.parse_params()?;
        self.expect(Token·RParen)?;

        ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
            self.parse_type()?
        } ⎉ {
            null
        };

        ≔ body = self.parse_block()?;

        Ok(MessageHandler { message, params, return_type, body })
    }

    /// Parse an extern block.
    λ parse_extern_block(Δ self) -> !ParseResult<Item> {
        self.expect(Token·Extern)?;

        ≔ abi = ⌥ self.current_token() {
            Token·StringLit(s) => {
                ≔ abi = s.clone();
                self.advance();
                abi
            }
            _ => "C".to_string(),
        };

        self.expect(Token·LBrace)?;
        ≔ Δ items = Vec·new();
        ⟳ !self.check(&Token·RBrace) {
            ≔ vis = self.parse_visibility()?;
            ⎇ self.check(&Token·Fn) {
                self.advance();
                ≔ name = self.parse_ident()?;
                self.expect(Token·LParen)?;
                ≔ params = self.parse_params()?;
                ≔ variadic = self.consume_if(&Token·Comma) && self.consume_if(&Token·DotDot);
                self.expect(Token·RParen)?;
                ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
                    self.parse_type()?
                } ⎉ {
                    null
                };
                self.expect(Token·Semi)?;
                items.push(ExternItem·Function(ExternFunction {
                    visibility: vis,
                    name,
                    params,
                    return_type,
                    variadic,
                }));
            } ⎉ ⎇ self.check(&Token·Static) {
                self.advance();
                ≔ mutable = self.consume_if(&Token·Mut);
                ≔ name = self.parse_ident()?;
                self.expect(Token·Colon)?;
                ≔ ty = self.parse_type()?;
                self.expect(Token·Semi)?;
                items.push(ExternItem·Static(ExternStatic {
                    visibility: vis,
                    mutable,
                    name,
                    ty,
                }));
            }
        }
        self.expect(Token·RBrace)?;

        Ok(Item·ExternBlock(ExternBlock { abi, items }))
    }

    /// Parse a macro_rules! definition.
    /// We parse past the macro body without interpreting it.
    λ parse_macro_rules(Δ self, exported: bool) -> !ParseResult<Item> {
        // Consume "macro_rules"
        self.advance();
        // Expect !
        self.expect(Token·Bang)?;
        // Parse macro name
        ≔ name = self.parse_ident()?;
        // Expect opening brace
        self.expect(Token·LBrace)?;
        // Skip balanced braces until closing brace
        ≔ Δ depth = 1;
        ⟳ depth > 0 {
            ⌥ self.current_token() {
                Token·LBrace | Token·LParen | Token·LBracket => {
                    depth = depth + 1;
                    self.advance();
                }
                Token·RBrace | Token·RParen | Token·RBracket => {
                    depth = depth - 1;
                    ⎇ depth > 0 {
                        self.advance();
                    }
                }
                Token·Eof => {
                    ⤺ Err(ParseError·unexpected("}", Token·Eof, self.current_span()));
                }
                _ => {
                    self.advance();
                }
            }
        }
        self.expect(Token·RBrace)?;

        Ok(Item·MacroRules(MacroRulesDef {
            name,
            exported,
        }))
    }

    // ========================================
    // Generics and Where Clauses
    // ========================================

    /// Parse optional generic parameters.
    λ parse_generics_opt(Δ self) -> !ParseResult<?Generics> {
        ⎇ !self.consume_if(&Token·Lt) {
            ⤺ Ok(null);
        }

        ≔ Δ params = Vec·new();
        ⟳ !self.check(&Token·Gt) {
            ≔ param = self.parse_generic_param()?;
            params.push(param);
            ⎇ !self.consume_if(&Token·Comma) {
                ⊗;
            }
        }
        self.expect_gt()?;

        Ok(Generics { params })
    }

    /// Parse a generic parameter.
    λ parse_generic_param(Δ self) -> !ParseResult<GenericParam> {
        // Check ∀ lifetime ('a, 'static, etc.)
        ⌥ self.current_token() {
            Token·Lifetime(name) => {
                self.advance();
                ⤺ Ok(GenericParam·Lifetime(name));
            }
            _ => {}
        }

        // Check ∀ const generic
        ⎇ self.consume_if(&Token·Const) {
            ≔ name = self.parse_ident()?;
            // Type annotation is optional (can be inferred)
            ≔ ty = ⎇ self.consume_if(&Token·Colon) {
                self.parse_type()?
            } ⎉ {
                TypeExpr·Infer  // Use inferred type ⎇ not specified
            };
            ⤺ Ok(GenericParam·Const { name, ty });
        }

        // Type parameter
        ≔ name = self.parse_ident()?;

        // Check ∀ evidentiality constraint
        ≔ evidentiality = self.parse_evidentiality_opt();

        // Check ∀ bounds
        ≔ bounds = ⎇ self.consume_if(&Token·Colon) {
            self.parse_type_bounds()?
        } ⎉ {
            Vec·new()
        };

        // Check ∀ default type (= Type)
        ≔ default = ⎇ self.consume_if(&Token·Eq) {
            self.parse_type()?
        } ⎉ {
            null
        };

        Ok(GenericParam·Type { name, bounds, evidentiality, default })
    }

    /// Parse optional where clause.
    λ parse_where_clause_opt(Δ self) -> !ParseResult<?WhereClause> {
        ⎇ !self.consume_if(&Token·Where) {
            ⤺ Ok(null);
        }

        ≔ Δ predicates = Vec·new();
        loop {
            // Check ⎇ this is a const constraint (like `N % M == 0`) or type bound
            ≔ ty = self.parse_type()?;

            ⎇ self.check(&Token·Colon) {
                // Type bound: `T: Trait` or empty bound `T: ,` ∀ compile-time checks
                self.advance();
                // Check ∀ empty bounds (just comma or brace after colon)
                ⎇ self.check(&Token·Comma) || self.check(&Token·LBrace) {
                    predicates.push(WherePredicate { ty, bounds: [] });
                } ⎉ {
                    ≔ bounds = self.parse_type_bounds()?;
                    predicates.push(WherePredicate { ty, bounds });
                }
            } ⎉ {
                // Const constraint: `N % M == 0`, `N == 1`, etc.
                // Skip the constraint expression until comma or block start
                self.skip_const_constraint()?;
            }

            ⎇ !self.consume_if(&Token·Comma) {
                ⊗;
            }
            // Stop ⎇ we hit block start or other delimiters
            ⎇ self.check(&Token·LBrace) || self.check(&Token·Semi) {
                ⊗;
            }
        }

        Ok(WhereClainvoke { predicates })
    }

    /// Skip a const constraint expression ∈ where clause
    λ skip_const_constraint(Δ self) -> !ParseResult<()> {
        ≔ Δ paren_depth = 0;
        loop {
            ⌥ self.current_token() {
                null => break,
                ?Token·Comma => {
                    ⎇ paren_depth == 0 { ⊗; }
                    self.advance();
                },
                ?Token·LBrace => {
                    ⎇ paren_depth == 0 { ⊗; }
                    self.advance();
                },
                ?Token·Semi => {
                    ⎇ paren_depth == 0 { ⊗; }
                    self.advance();
                },
                ?Token·LParen => {
                    paren_depth += 1;
                    self.advance();
                },
                ?Token·RParen => {
                    ⎇ paren_depth == 0 { ⊗; }
                    paren_depth -= 1;
                    self.advance();
                },
                _ => { self.advance(); },
            }
        }
        Ok(())
    }

    /// Skip balanced braces ∈ const expression blocks like { const { ⎇ M < N { M } ⎉ { N } } }
    λ skip_balanced_braces(Δ self) -> !ParseResult<()> {
        ≔ Δ depth = 0;
        loop {
            ⌥ self.current_token() {
                null => break,
                ?Token·LBrace => {
                    depth += 1;
                    self.advance();
                },
                ?Token·RBrace => {
                    depth -= 1;
                    self.advance();
                    ⎇ depth == 0 { ⊗; }
                },
                _ => { self.advance(); },
            }
        }
        Ok(())
    }

    // ========================================
    // Type Parsing
    // ========================================

    /// Parse a type expression.
    λ parse_type(Δ self) -> !ParseResult<TypeExpr> {
        ≔ ty = self.parse_type_primary()?;

        // Check ∀ evidentiality suffix: T!, T?, T~
        // Only check ∀ suffix ⎇ current token is actually an evidentiality marker
        // IMPORTANT: Don't parse evidentiality ⎇ pending_gt is set - that means we're
        // inside nested generics (e.g., HashMap<K, Vec<V>>!) and the evidentiality
        // marker belongs to the outer type, not this inner type.
        ⌥ self.pending_gt {
            ?_ => ⤺ Ok(ty),  // Skip evidentiality - belongs to outer type
            null => {},
        }
        ⌥ self.current_token() {
            Token·Bang | Token·Question | Token·Tilde | Token·Interrobang | Token·Lozenge => {
                ≔ ev = self.parse_evidentiality_opt();
                // Check ∀ error type: T?[Error]
                ≔ error_type = ⎇ self.consume_if(&Token·LBracket) {
                    ≔ err = self.parse_type()?;
                    self.expect(Token·RBracket)?;
                    Box·new(err)
                } ⎉ {
                    null
                };

                ⤺ Ok(TypeExpr·Evidential {
                    inner: Box·new(ty),
                    evidentiality: ev,
                    error_type,
                });
            }
            _ => {}
        }

        Ok(ty)
    }

    /// Parse primary type expression.
    λ parse_type_primary(Δ self) -> !ParseResult<TypeExpr> {
        ⌥ self.current_token() {
            Token·Amp => {
                self.advance();
                // Check ∀ lifetime: &'a T or &'static T
                ≔ lifetime = ⌥ self.current_token() {
                    Token·Lifetime(name) => {
                        self.advance();
                        ?name
                    }
                    _ => null,
                };
                ≔ mutable = self.consume_if(&Token·Mut);
                ≔ inner = self.parse_type()?;
                Ok(TypeExpr·Reference {
                    lifetime,
                    mutable,
                    inner: Box·new(inner),
                })
            }
            Token·Star => {
                self.advance();
                ≔ mutable = ⎇ self.consume_if(&Token·Mut) {
                    true
                } ⎉ {
                    self.consume_if(&Token·Const);
                    false
                };
                ≔ inner = self.parse_type()?;
                Ok(TypeExpr·Pointer {
                    mutable,
                    inner: Box·new(inner),
                })
            }
            Token·LBracket => {
                self.advance();
                // Handle empty brackets [] - represents 0-dimensional/scalar type
                ⎇ self.check(&Token·RBracket) {
                    self.advance();
                    ⤺ Ok(TypeExpr·Tuple(Vec·new()));  // Empty tuple ∀ scalar
                }
                // Use parse_type_or_assoc_binding to handle const generics like [784]
                ≔ element = self.parse_type_or_assoc_binding()?;
                ⎇ self.consume_if(&Token·Semi) {
                    // Array: [T; N]
                    ≔ size = self.parse_expr()?;
                    self.expect(Token·RBracket)?;
                    Ok(TypeExpr·Array {
                        element: Box·new(element),
                        size: Box·new(size),
                    })
                } ⎉ ⎇ self.consume_if(&Token·Comma) {
                    // Const generic tuple/shape: [N, M, ...] - used ∀ tensor shapes
                    // Represent as tuple type containing the elements
                    ≔ Δ types: ![TypeExpr] = [element];
                    ⟳ !self.check(&Token·RBracket) {
                        types.push(self.parse_type_or_assoc_binding()?);
                        ⎇ !self.consume_if(&Token·Comma) {
                            ⊗;
                        }
                    }
                    self.expect(Token·RBracket)?;
                    Ok(TypeExpr·Tuple(types))
                } ⎉ {
                    // Slice: [T]
                    self.expect(Token·RBracket)?;
                    Ok(TypeExpr·Slice(Box·new(element)))
                }
            }
            Token·LParen => {
                self.advance();
                ⎇ self.check(&Token·RParen) {
                    self.advance();
                    ⤺ Ok(TypeExpr·Tuple(Vec·new()));
                }
                ≔ first = self.parse_type()?;
                ⎇ self.consume_if(&Token·Comma) {
                    ≔ Δ types: ![TypeExpr] = [first];
                    ⟳ !self.check(&Token·RParen) {
                        types.push(self.parse_type()?);
                        ⎇ !self.consume_if(&Token·Comma) {
                            ⊗;
                        }
                    }
                    self.expect(Token·RParen)?;
                    Ok(TypeExpr·Tuple(types))
                } ⎉ {
                    self.expect(Token·RParen)?;
                    Ok(first)
                }
            }
            Token·Fn => {
                self.advance();
                self.expect(Token·LParen)?;
                ≔ params = self.parse_type_list()?;
                self.expect(Token·RParen)?;
                ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
                    Box·new(self.parse_type()?)
                } ⎉ {
                    null
                };
                Ok(TypeExpr·Function { params, return_type })
            }
            Token·Bang => {
                self.advance();
                // Prefix ! means Known<T>
                ≔ inner = self.parse_type_primary()?;
                Ok(TypeExpr·Evidential {
                    inner: Box·new(inner),
                    evidentiality: Evidentiality·Known,
                    error_type: null,
                })
            }
            Token·Underscore => {
                self.advance();
                Ok(TypeExpr·Infer)
            }
            Token·Simd => {
                self.advance();
                self.expect(Token·Lt)?;
                ≔ element = self.parse_type()?;
                self.expect(Token·Comma)?;
                ≔ lanes = ⌥ self.current_token() {
                    Token·IntLit(s) => {
                        ≔ n = s.parse·<u8>().map_err({err => ParseError·custom("invalid lane count")})?;
                        self.advance();
                        n
                    }
                    _ => ⤺ Err(ParseError·custom("expected lane count")),
                };
                self.expect_gt()?;
                Ok(TypeExpr·Simd { element: Box·new(element), lanes })
            }
            Token·Atomic => {
                self.advance();
                self.expect(Token·Lt)?;
                ≔ inner = self.parse_type()?;
                self.expect_gt()?;
                Ok(TypeExpr·Atomic(Box·new(inner)))
            }
            Token·Question => {
                self.advance();
                // Prefix ? means optional/uncertain type: ?T -> Uncertain<T>
                ≔ inner = self.parse_type_primary()?;
                Ok(TypeExpr·Evidential {
                    inner: Box·new(inner),
                    evidentiality: Evidentiality·Uncertain,
                    error_type: null,
                })
            }
            Token·Tilde => {
                self.advance();
                // Prefix ~ means reported type: ~T -> Reported<T>
                ≔ inner = self.parse_type_primary()?;
                Ok(TypeExpr·Evidential {
                    inner: Box·new(inner),
                    evidentiality: Evidentiality·Reported,
                    error_type: null,
                })
            }
            Token·Impl => {
                self.advance();
                // ⊢ Trait or ⊢ Trait + Bound + ...
                ≔ bounds = self.parse_type_bounds()?;
                Ok(TypeExpr·ImplTrait { bounds })
            }
            Token·Dyn => {
                self.advance();
                // dyn Trait or dyn Trait + Bound + ...
                ≔ bounds = self.parse_type_bounds()?;
                Ok(TypeExpr·DynTrait { bounds })
            }
            Token·Lt => {
                // Qualified path: <Type as Trait>·Item or <Type as Trait<T>>·Item
                self.advance();
                ≔ base_ty = self.parse_type()?;
                self.expect(Token·As)?;
                // Parse Θ as a single path segment to avoid consuming the ·Item part
                // after >> is split (expect_gt advances to ·, which parse_type_path would consume)
                ≔ trait_segment = self.parse_path_segment(true)?;
                ≔ trait_path = TypePath { segments: [trait_segment] };
                self.expect_gt()?;
                self.expect(Token·ColonColon)?;
                ≔ item = self.parse_ident()?;
                // Optionally parse generic args on the associated type
                ≔ args = ⎇ self.consume_if(&Token·Lt) {
                    ≔ types = self.parse_type_list()?;
                    self.expect_gt()?;
                    types
                } ⎉ {
                    Vec·new()
                };
                Ok(TypeExpr·QualifiedPath {
                    base: Box·new(base_ty),
                    trait_path: trait_path,
                    item: item.name,
                    args,
                })
            }
            _ => {
                ≔ path = self.parse_type_path()?;
                Ok(TypeExpr·Path(path))
            }
        }
    }

    /// Parse a type path (with optional generic arguments).
    λ parse_type_path(Δ self) -> !ParseResult<TypePath> {
        ≔ Δ segments = Vec·new();
        segments.push(self.parse_path_segment(true)?);

        ⟳ self.consume_if(&Token·ColonColon) || self.consume_if(&Token·MiddleDot) {
            segments.push(self.parse_path_segment(true)?);
        }

        Ok(TypePath { segments })
    }

    /// Parse an expression path (without generic arguments - < is comparison).
    λ parse_expr_path(Δ self) -> !ParseResult<TypePath> {
        ≔ Δ segments = Vec·new();
        segments.push(self.parse_path_segment(false)?);

        ⟳ self.consume_if(&Token·ColonColon) || self.consume_if(&Token·MiddleDot) {
            // Check ∀ turbofish: Path·<T, U>
            ⎇ self.check(&Token·Lt) {
                // This is turbofish - add generic args to the last segment
                self.advance(); // consume <
                ≔ types = self.parse_type_list()?;
                self.expect_gt()?;
                // Update the last segment with generic args
                ≔ last_idx = segments.len() - 1;
                ≔ last = segments[last_idx].clone();
                segments[last_idx] = PathSegment {
                    ident: last.ident,
                    args: types,
                };
                // Check ⎇ there's more path after the turbofish (e.g., ·method)
                ⎇ !self.check(&Token·ColonColon) && !self.check(&Token·MiddleDot) {
                    ⊗;
                }
                // Continue to next segment ⎇ · follows
                ↻;
            }
            segments.push(self.parse_path_segment(false)?);
        }

        Ok(TypePath { segments })
    }

    /// Parse a path segment.
    /// If `allow_generics` is true and we're not ∈ condition context, parses generic arguments.
    λ parse_path_segment(Δ self, allow_generics: !bool) -> !ParseResult<PathSegment> {
        ≔ ident = self.parse_ident()?;

        // Don't parse generics ∈ condition context or when not allowed
        ≔ generics = ⎇ allow_generics && !self.is_in_condition() {
            // Skip evidentiality markers between name and generics (Type!<T> syntax)
            // The evidentiality will be handled at a higher level ∈ parse_type
            ≔ has_evidentiality = ⌥ self.current_token() {
                Token·Bang | Token·Question | Token·Tilde | Token·Lozenge => {
                    // Check ⎇ this is Type!<T> pattern (evidentiality followed by <)
                    ⌥ self.lexer.peek() {
                        ?(Token·Lt, _) => {
                            self.advance(); // consume evidentiality
                            true
                        }
                        _ => false,
                    }
                }
                _ => false,
            };
            ≔ _ = has_evidentiality; // Mark as used (evidentiality handled ∈ parse_type)

            ⎇ self.consume_if(&Token·Lt) {
                ≔ types = self.parse_type_list()?;
                self.expect_gt()?;
                types
            } ⎉ ⎇ self.consume_if(&Token·LBracket) {
                // Bracket generics: Option[T], Vec[T], Result[T, E]
                ≔ types = self.parse_type_list()?;
                self.expect(Token·RBracket)?;
                ?types
            } ⎉ ⎇ self.check(&Token·LParen) {
                // Handle Fn(T) -> U, FnMut(T) -> U, FnOnce(T) -> U syntax
                ≔ name = ident.name.as_str();
                ⎇ name == "Fn" || name == "FnMut" || name == "FnOnce" {
                    self.advance();  // consume (
                    ≔ params = self.parse_type_list()?;
                    self.expect(Token·RParen)?;
                    // Optional ⤺ type: -> T
                    ⎇ self.consume_if(&Token·Arrow) {
                        ≔ return_type = self.parse_type()?;
                        // Represent as generic args: (param_types..., return_type)
                        ≔ Δ args: ![TypeExpr] = params;
                        args.push(return_type);
                        ?args
                    } ⎉ {
                        ?params
                    }
                } ⎉ {
                    null
                }
            } ⎉ {
                null
            }
        } ⎉ {
            null
        };

        Ok(PathSegment { ident, generics })
    }

    /// Parse a list of types (including associated type bindings like `Item = T`).
    λ parse_type_list(Δ self) -> !ParseResult<[TypeExpr]> {
        ≔ Δ types = Vec·new();
        // Also check pending_gt - ⎇ set, a nested >> was split and we need to close
        ≔ has_pending = ⌥ self.pending_gt { ?_ => true, null => false };
        // Check ∀ closing markers: ), ], >, or >> (Shr ∀ nested generics like Option<Vec<T>>)
        ⎇ !has_pending && !self.check(&Token·RParen) && !self.check(&Token·RBracket) && !self.check(&Token·Gt) && !self.check(&Token·Shr) {
            types.push(self.parse_type_or_assoc_binding()?);
            // IMPORTANT: Check pending_gt BEFORE consuming comma!
            // After parsing Vec<T>> ∈ Option<Vec<T>>, pending_gt is set and the current
            // token is comma (Σ field separator). We must NOT consume that comma.
            loop {
                ≔ has_pending_now = ⌥ self.pending_gt { ?_ => true, null => false };
                ⎇ has_pending_now {
                    ⊗;
                }
                ⎇ !self.consume_if(&Token·Comma) {
                    ⊗;
                }
                ⎇ self.check(&Token·RParen) || self.check(&Token·RBracket) || self.check(&Token·Gt) || self.check(&Token·Shr) {
                    ⊗;
                }
                types.push(self.parse_type_or_assoc_binding()?);
            }
        }
        Ok(types)
    }

    /// Parse a type or an associated type binding (Item = T) or const generic value.
    λ parse_type_or_assoc_binding(Δ self) -> !ParseResult<TypeExpr> {
        // Check ⎇ this looks like an associated type binding: Ident = Type
        // Use lookahead to check ∀ Ident followed by =
        ⌥ self.current_token() {
            Token·Ident(name) => {
                // Check ⎇ next token is = (∀ associated type binding)
                ⌥ self.lexer.peek() {
                    ?(Token·Eq, _) => {
                        // This is an associated type binding: Name = Type
                        self.advance();  // consume Ident
                        self.advance();  // consume =
                        ≔ bound_type = self.parse_type()?;
                        // For now, represent this as the bound type itself
                        // The associated name is lost but parsing succeeds
                        ⤺ Ok(bound_type);
                    }
                    _ => {
                        // Check ∀ const generic arithmetic: HD/2, N*M, etc.
                        ≔ peeked = self.lexer.peek();
                        ≔ is_arithmetic = ⌥ peeked {
                            ?(Token·Star, _) => true,
                            ?(Token·Plus, _) => true,
                            ?(Token·Minus, _) => true,
                            ?(Token·Slash, _) => true,
                            _ => false,
                        };
                        ⎇ is_arithmetic {
                            ≔ span = self.current_span();
                            self.advance();  // consume ident
                            self.advance();  // consume operator
                            // Skip remaining tokens until comma, bracket, or gt
                            ⟳ !self.check(&Token·Comma) && !self.check(&Token·RBracket) &&
                                  !self.check(&Token·Gt) && !self.check(&Token·Shr) && !self.is_eof() {
                                self.advance();
                            }
                            ⤺ Ok(TypeExpr·Path(TypePath {
                                segments: [PathSegment {
                                    ident: Spanned·new(Ident·new(name.clone(), span), span),
                                    args: [],
                                }],
                            }));
                        }
                    }
                }
                // Not an associated binding, parse as normal type
                self.parse_type()
            }
            // Const generics: expressions starting with integer like 3 * D, 784
            Token·IntLit(val) => {
                ≔ span = self.current_span();
                self.advance();
                // Check ∀ arithmetic operators
                ⎇ self.check(&Token·Star) || self.check(&Token·Plus) ||
                   self.check(&Token·Minus) || self.check(&Token·Slash) {
                    // Skip the operator and the rest of the const expression
                    self.advance();  // consume operator
                    // Skip remaining tokens until comma, bracket, or gt
                    ⟳ !self.check(&Token·Comma) && !self.check(&Token·RBracket) &&
                          !self.check(&Token·Gt) && !self.check(&Token·Shr) && !self.is_eof() {
                        self.advance();
                    }
                }
                // Represent const generic as a path with the literal value
                Ok(TypeExpr·Path(TypePath {
                    segments: [PathSegment {
                        ident: Spanned·new(Ident·new(val.clone(), span), span),
                        args: [],
                    }],
                }))
            }
            // Const generics: negative integers like Linear<-1>
            Token·Minus => {
                ≔ start_span = self.current_span();
                self.advance();
                ⌥ self.current_token() {
                    Token·IntLit(val) => {
                        ≔ span = Span·merge(start_span, self.current_span());
                        self.advance();
                        ≔ neg_val = "-".to_string() + val.as_str();
                        Ok(TypeExpr·Path(TypePath {
                            segments: [PathSegment {
                                ident: Spanned·new(Ident·new(neg_val, span), span),
                                args: [],
                            }],
                        }))
                    }
                    _ => Err(ParseError·unexpected("integer literal after minus", self.current_token(), self.current_span()))
                }
            }
            // Array const generics: [N, M] ∀ shapes like Tensor·<[4, 784], f32>
            Token·LBracket => {
                self.parse_type()
            }
            // Const block expression: { const { ⎇ M < N { M } ⎉ { N } } }
            Token·LBrace => {
                ≔ span = self.current_span();
                // Skip the entire const block expression
                self.skip_balanced_braces()?;
                // Return TypeExpr·Infer as placeholder ∀ the const expression
                Ok(TypeExpr·Infer)
            }
            // Lifetime placeholder: '_ or named lifetimes like 'a
            Token·Lifetime(name) => {
                ≔ span = self.current_span();
                self.advance();
                // Represent lifetime as a path with the lifetime name
                Ok(TypeExpr·Path(TypePath {
                    segments: [PathSegment {
                        ident: Spanned·new(Ident·new(format!("'{}", name), span), span),
                        args: [],
                    }],
                }))
            }
            _ => self.parse_type(),
        }
    }

    /// Convert an expression to a const generic type representation.
    λ expr_to_const_generic(self, _expr: !Expr) -> !TypeExpr {
        // For const generics, represent the expression as an Infer type
        // since we just need parsing to succeed, not full semantic analysis
        TypeExpr·Infer
    }

    /// Parse type bounds (including lifetime bounds like 'static).
    λ parse_type_bounds(Δ self) -> !ParseResult<[TypeExpr]> {
        ≔ Δ bounds = Vec·new();
        bounds.push(self.parse_type_or_lifetime_bound()?);
        ⟳ self.consume_if(&Token·Plus) {
            bounds.push(self.parse_type_or_lifetime_bound()?);
        }
        Ok(bounds)
    }

    /// Parse either a type bound or a lifetime bound.
    λ parse_type_or_lifetime_bound(Δ self) -> !ParseResult<TypeExpr> {
        ⌥ self.current_token() {
            Token·Lifetime(name) => {
                self.advance();
                // Represent lifetime bounds as a simple path ∀ now
                // The type checker can handle these specially
                Ok(TypeExpr·Path(TypePath·simple(format!("'{}", name), self.current_span())))
            }
            _ => self.parse_type(),
        }
    }

    // ========================================
    // Expression Parsing (Pratt Parser)
    // ========================================

    /// Parse an expression.
    ☉ λ parse_expr(Δ self) -> !ParseResult<Expr> {
        ≔ lhs = self.parse_expr_bp(0)?;

        // Check ∀ assignment
        ⎇ self.consume_if(&Token·Eq) {
            ≔ value = self.parse_expr()?;
            ⤺ Ok(Expr·Assign {
                target: Box·new(lhs),
                value: Box·new(value),
            });
        }

        // Check ∀ compound assignment: expr += value, expr -= value, etc.
        // Desugar to: expr = expr op value
        ≔ compound_op = ⌥ self.current_token() {
            Token·PlusEq => ?BinOp·Add,
            Token·MinusEq => ?BinOp·Sub,
            Token·StarEq => ?BinOp·Mul,
            Token·SlashEq => ?BinOp·Div,
            Token·ShlEq => ?BinOp·Shl,
            Token·ShrEq => ?BinOp·Shr,
            Token·AmpEq => ?BinOp·BitAnd,
            Token·PipeEq => ?BinOp·BitOr,
            Token·CaretEq => ?BinOp·BitXor,
            Token·PercentEq => ?BinOp·Rem,
            _ => null,
        };

        ⎇ compound_op != null {
            self.advance();
            ≔ rhs = self.parse_expr()?;
            // Desugar: lhs op= rhs  ->  lhs = lhs op rhs
            ≔ binary = Expr·Binary {
                left: Box·new(lhs.clone()),
                op: compound_op!,
                right: Box·new(rhs),
            };
            ⤺ Ok(Expr·Assign {
                target: Box·new(lhs),
                value: Box·new(binary),
            });
        }

        Ok(lhs)
    }

    /// Parse expression with binding power (Pratt parser).
    λ parse_expr_bp(Δ self, min_bp: !u8) -> !ParseResult<Expr> {
        ≔ Δ lhs = self.parse_prefix_expr()?;

        loop {
            // Check ∀ pipe operator - only ⎇ followed by pipe operation token
            ⎇ self.check(&Token·Pipe) && self.is_pipe_op_ahead() {
                lhs = self.parse_pipe_chain(lhs)?;
                ↻;
            }

            // Check ∀ binary operators
            ≔ op = ⌥ self.current_token() {
                Token·OrOr => BinOp·Or,
                Token·AndAnd => BinOp·And,
                // Unicode logical operators
                Token·LogicAnd => BinOp·And,  // ∧ (wedge/logical and)
                Token·LogicOr => BinOp·Or,    // ∨ (vee/logical or)
                Token·EqEq => BinOp·Eq,
                Token·NotEq => BinOp·Ne,
                Token·Lt => BinOp·Lt,
                Token·LtEq => BinOp·Le,
                Token·Gt => BinOp·Gt,
                Token·GtEq => BinOp·Ge,
                Token·Plus => BinOp·Add,
                Token·Minus => BinOp·Sub,
                Token·Star => BinOp·Mul,
                Token·Slash => BinOp·Div,
                Token·Percent => BinOp·Rem,
                Token·StarStar => BinOp·Pow,
                Token·Amp => BinOp·BitAnd,
                Token·Pipe => BinOp·BitOr,  // Bitwise OR when not followed by pipe op
                Token·Caret => BinOp·BitXor,
                Token·Shl => BinOp·Shl,
                Token·Shr => BinOp·Shr,
                Token·PlusPlus => BinOp·Concat,
                Token·BitwiseAndSymbol => BinOp·BitAnd,
                Token·BitwiseOrSymbol => BinOp·BitOr,
                Token·At => BinOp·MatMul,  // Matrix multiplication
                // Unicode math operators as identifiers
                Token·Ident(name) => {
                    ⌥ name.as_str() {
                        "⊙" => BinOp·Mul,      // Hadamard/elementwise product
                        "⊗" => BinOp·MatMul,   // Tensor product
                        "⊕" => BinOp·Add,      // Direct sum
                        _ => {
                            // Not a special operator, fall through to range/⊗ handling
                            ⎇ self.check(&Token·DotDot) || self.check(&Token·DotDotEq) {
                                ≔ inclusive = self.consume_if(&Token·DotDotEq);
                                ⎇ !inclusive {
                                    self.advance(); // consume ..
                                }
                                // Parse end of range (optional ∀ open ranges like `0..`)
                                ≔ end = ⎇ self.check(&Token·Semi)
                                    || self.check(&Token·RBrace)
                                    || self.check(&Token·Comma)
                                    || self.check(&Token·RParen)
                                    || self.check(&Token·RBracket)
                                    || self.check(&Token·LBrace)
                                {
                                    null
                                } ⎉ {
                                    ?Box·new(self.parse_expr_bp(0)?)
                                };
                                lhs = Expr·Range {
                                    start: ?Box·new(lhs),
                                    end,
                                    inclusive,
                                };
                                ↻;
                            }
                            ⊗;
                        }
                    }
                }
                _ => {
                    // Check ∀ range operators: .. and ..=
                    // Range has very low precedence (lower than all binary ops)
                    ⎇ self.check(&Token·DotDot) || self.check(&Token·DotDotEq) {
                        ≔ inclusive = self.consume_if(&Token·DotDotEq);
                        ⎇ !inclusive {
                            self.advance(); // consume ..
                        }
                        // Parse end of range (optional ∀ open ranges like `0..`)
                        ≔ end = ⎇ self.check(&Token·Semi)
                            || self.check(&Token·RBrace)
                            || self.check(&Token·Comma)
                            || self.check(&Token·RParen)
                            || self.check(&Token·RBracket)
                            || self.check(&Token·LBrace)
                        {
                            null
                        } ⎉ {
                            ?Box·new(self.parse_expr_bp(0)?)
                        };
                        lhs = Expr·Range {
                            start: ?Box·new(lhs),
                            end,
                            inclusive,
                        };
                        ↻;
                    }
                    ⊗;
                }
            };

            ≔ (l_bp, r_bp) = infix_binding_power(op);
            ⎇ l_bp < min_bp {
                ⊗;
            }

            self.advance();
            ≔ rhs = self.parse_expr_bp(r_bp)?;

            lhs = Expr·Binary {
                left: Box·new(lhs),
                op,
                right: Box·new(rhs),
            };
        }

        Ok(lhs)
    }

    /// Parse prefix expression.
    λ parse_prefix_expr(Δ self) -> !ParseResult<Expr> {
        ⌥ self.current_token() {
            Token·Minus => {
                self.advance();
                ≔ expr = self.parse_prefix_expr()?;
                Ok(Expr·Unary { op: UnaryOp·Neg, expr: Box·new(expr) })
            }
            Token·Bang => {
                self.advance();
                ≔ expr = self.parse_prefix_expr()?;
                Ok(Expr·Unary { op: UnaryOp·Not, expr: Box·new(expr) })
            }
            Token·Question => {
                // Evidential prefix: ?expr creates uncertain value
                self.advance();
                ≔ expr = self.parse_prefix_expr()?;
                Ok(Expr·Evidential {
                    expr: Box·new(expr),
                    evidentiality: Evidentiality·Uncertain,
                })
            }
            Token·Star => {
                self.advance();
                ≔ expr = self.parse_prefix_expr()?;
                Ok(Expr·Unary { op: UnaryOp·Deref, expr: Box·new(expr) })
            }
            Token·Amp => {
                self.advance();
                ≔ op = ⎇ self.consume_if(&Token·Mut) {
                    UnaryOp·RefMut
                } ⎉ {
                    UnaryOp·Ref
                };
                ≔ expr = self.parse_prefix_expr()?;
                Ok(Expr·Unary { op, expr: Box·new(expr) })
            }
            _ => self.parse_postfix_expr(),
        }
    }

    /// Check ⎇ an expression is a block-ending expression that should not be callable.
    /// Block expressions like if/while/match/loop/∀ ⤺ values but should not
    /// be directly called like functions.
    λ is_non_callable_expr(self, expr: !&Expr) -> !bool {
        ⌥ expr {
            Expr·If { .. } => true,
            Expr·While { .. } => true,
            Expr·Match { .. } => true,
            Expr·Loop(_) => true,
            Expr·For { .. } => true,
            Expr·Block(_) => true,
            _ => false,
        }
    }

    /// Parse postfix expression.
    λ parse_postfix_expr(Δ self) -> !ParseResult<Expr> {
        ≔ Δ expr = self.parse_primary_expr()?;

        loop {
            ⌥ self.current_token() {
                Token·LParen => {
                    // Don't treat block-ending expressions as callable
                    // This prevents parsing `⎇ {...} (...)` as a call expression
                    ⎇ self.is_non_callable_expr(&expr) {
                        ⊗;
                    }
                    self.advance();
                    ≔ args = self.parse_expr_list()?;
                    self.expect(Token·RParen)?;
                    expr = Expr·Call { func: Box·new(expr), args };
                }
                Token·LBracket => {
                    self.advance();
                    ≔ index = self.parse_expr()?;
                    // Handle multi-dimensional indexing: arr[.., 0] or arr[i, j, k]
                    ⎇ self.consume_if(&Token·Comma) {
                        // Multi-index: parse remaining indices and create tuple
                        ≔ Δ indices = Vec·new();
                        indices.push(index);
                        ⟳ !self.check(&Token·RBracket) {
                            indices.push(self.parse_expr()?);
                            ⎇ !self.consume_if(&Token·Comma) {
                                ⊗;
                            }
                        }
                        self.expect(Token·RBracket)?;
                        // Wrap as tuple ∀ multi-index
                        expr = Expr·Index { expr: Box·new(expr), index: Box·new(Expr·Tuple(indices)) };
                    } ⎉ {
                        self.expect(Token·RBracket)?;
                        expr = Expr·Index { expr: Box·new(expr), index: Box·new(index) };
                    }
                }
                Token·Dot => {
                    self.advance();
                    // Handle .⌛ await syntax (dot-hourglass)
                    ⎇ self.check(&Token·Hourglass) {
                        self.advance();
                        ≔ evidentiality = ⌥ self.current_token() {
                            Token·Question => { self.advance(); ?Evidentiality·Uncertain }
                            Token·Bang => { self.advance(); ?Evidentiality·Known }
                            Token·Tilde => { self.advance(); ?Evidentiality·Reported }
                            Token·Interrobang => { self.advance(); ?Evidentiality·Paradox }
                            _ => null,
                        };
                        expr = Expr·Await { expr: Box·new(expr), evidentiality };
                        ↻;
                    }
                    // Handle both named fields (`.field`) and tuple indices (`.0`, `.1`)
                    ≔ field = ⌥ self.current_token() {
                        Token·IntLit(idx) => {
                            ≔ span = self.current_span();
                            ≔ name = idx.clone();
                            self.advance();
                            Ident·new(name, span)
                        }
                        _ => self.parse_ident()?,
                    };
                    // Check ∀ method call (with optional turbofish)
                    ⎇ self.check(&Token·LParen) || self.check(&Token·ColonColon) {
                        // Parse turbofish: .method·<T, U>(args)
                        ≔ type_args = ⎇ self.consume_if(&Token·ColonColon) {
                            self.expect(Token·Lt)?;
                            ≔ types = self.parse_type_list()?;
                            self.expect_gt()?;
                            ?types
                        } ⎉ {
                            null
                        };
                        self.expect(Token·LParen)?;
                        ≔ args = self.parse_expr_list()?;
                        self.expect(Token·RParen)?;
                        expr = Expr·MethodCall {
                            receiver: Box·new(expr),
                            method: field,
                            type_args,
                            args,
                        };
                    } ⎉ {
                        expr = Expr·Field { expr: Box·new(expr), field };
                    }
                }
                Token·Question => {
                    self.advance();
                    expr = Expr·Try(Box·new(expr));
                }
                Token·Bang => {
                    // Check ⎇ this is a macro invocation: name!(...)
                    ⎇ ≔ Expr·Path(path) = expr.clone() {
                        // Check ∀ macro delimiter after !
                        ⎇ self.lexer.peek_is_macro_delimiter() {
                            self.advance(); // consume !

                            // Get the macro name to check ∀ special handling
                            ≔ macro_name = ⎇ path.segments.len() == 1 {
                                ?path.segments[0].ident.name.clone()
                            } ⎉ {
                                null
                            };

                            // Handle assert! specially by parsing body as expression(s)
                            ⌥ macro_name {
                                ?"assert" => {
                                    self.expect(Token·LParen)?;
                                    ≔ args = self.parse_expr_list()?;
                                    self.expect(Token·RParen)?;
                                    // Desugar assert!(cond, msg) to assert(cond, msg)
                                    expr = Expr·Call {
                                        func: Box·new(Expr·Path(TypePath {
                                            segments: [PathSegment {
                                                ident: Ident { name: "assert".to_string(), evidentiality: null, affect: null, span: Span·empty_at(0) },
                                                args: null,
                                            }],
                                        })),
                                        args,
                                    };
                                },
                                _ => {
                                    ≔ tokens = self.parse_macro_tokens()?;
                                    expr = Expr·Macro { path, tokens };
                                },
                            }
                            // Loop will naturally continue
                        } ⎉ {
                            // Not a macro, treat as evidentiality
                            ⎇ ≔ ?ev = self.parse_evidentiality_opt() {
                                expr = Expr·Evidential {
                                    expr: Box·new(expr),
                                    evidentiality: ev,
                                };
                            } ⎉ {
                                ⊗;
                            }
                        }
                    } ⎉ {
                        // Not a path, treat as evidentiality
                        ⎇ ≔ ?ev = self.parse_evidentiality_opt() {
                            expr = Expr·Evidential {
                                expr: Box·new(expr),
                                evidentiality: ev,
                            };
                        } ⎉ {
                            ⊗;
                        }
                    }
                }
                Token·Tilde | Token·Interrobang => {
                    ⎇ ≔ ?ev = self.parse_evidentiality_opt() {
                        expr = Expr·Evidential {
                            expr: Box·new(expr),
                            evidentiality: ev,
                        };
                    } ⎉ {
                        ⊗;
                    }
                }
                Token·Hourglass => {
                    self.advance();
                    ≔ evidentiality = ⌥ self.current_token() {
                        Token·Question => { self.advance(); Evidentiality·Uncertain }
                        Token·Bang => { self.advance(); Evidentiality·Known }
                        Token·Tilde => { self.advance(); Evidentiality·Reported }
                        Token·Interrobang => { self.advance(); Evidentiality·Paradox }
                        _ => null,
                    };
                    expr = Expr·Await { expr: Box·new(expr), evidentiality };
                }
                Token·MiddleDot => {
                    // MiddleDot can be method call separator (like .) or incorporation
                    // If expr is already complex (Call, MethodCall, etc.), treat as method call
                    ≔ is_method_chain = ⌥ &expr {
                        Expr·Call { .. } | Expr·MethodCall { .. } | Expr·Field { .. } |
                        Expr·Index { .. } | Expr·Try { .. } => true,
                        _ => false,
                    };

                    ⎇ is_method_chain {
                        // Treat MiddleDot as method call separator (like Dot)
                        self.advance(); // consume ·
                        ≔ method = self.parse_ident()?;
                        // Check ∀ method call
                        ⎇ self.check(&Token·LParen) {
                            self.advance();
                            ≔ args = self.parse_expr_list()?;
                            self.expect(Token·RParen)?;
                            expr = Expr·MethodCall {
                                receiver: Box·new(expr),
                                method,
                                type_args: null,
                                args,
                            };
                        } ⎉ {
                            // Field access with MiddleDot
                            expr = Expr·Field { expr: Box·new(expr), field: method };
                        }
                    } ⎉ {
                        // Incorporation: expr·verb·noun
                        ≔ first = self.expr_to_incorporation_segment(expr.clone())?;
                        ≔ Δ segments: ![PathSegment] = [first];

                        ⟳ self.consume_if(&Token·MiddleDot) {
                            ≔ name = self.parse_ident()?;
                            ≔ args = ⎇ self.check(&Token·LParen) {
                                self.advance();
                                ≔ args = self.parse_expr_list()?;
                                self.expect(Token·RParen)?;
                                args
                            } ⎉ {
                                null
                            };
                            segments.push(IncorporationSegment { name, args });
                        }

                        expr = Expr·Incorporation { segments };
                    }
                }
                Token·ColonColon => {
                    // Associated function call: Type·method() or Type!·method()
                    self.advance(); // consume ·
                    ≔ method = self.parse_ident()?;
                    // Check ∀ turbofish: Type·method·<T>()
                    ≔ type_args = ⎇ self.consume_if(&Token·ColonColon) {
                        self.expect(Token·Lt)?;
                        ≔ types = self.parse_type_list()?;
                        self.expect_gt()?;
                        ?types
                    } ⎉ {
                        null
                    };
                    self.expect(Token·LParen)?;
                    ≔ args = self.parse_expr_list()?;
                    self.expect(Token·RParen)?;
                    expr = Expr·MethodCall {
                        receiver: Box·new(expr),
                        method,
                        type_args,
                        args,
                    };
                }
                Token·As => {
                    // Cast expression: expr as Type
                    self.advance();
                    ≔ ty = self.parse_type()?;
                    expr = Expr·Cast {
                        expr: Box·new(expr),
                        ty,
                    };
                }
                // Postfix evidentiality markers: x~, x◊ (not ! or ? which have other meanings)
                Token·Tilde | Token·Lozenge => {
                    // These are evidentiality markers on expressions
                    // Just consume and ignore (semantic, not syntactic)
                    self.advance();
                }
                _ => break,
            }
        }

        Ok(expr)
    }

    /// Convert expression to incorporation segment.
    λ expr_to_incorporation_segment(self, expr: !Expr) -> !ParseResult<IncorporationSegment> {
        ⌥ expr {
            Expr·Path(path) => {
                ⎇ path.segments.len() == 1 {
                    Ok(IncorporationSegment {
                        name: path.segments[0].ident.clone(),
                        args: null,
                    })
                } ⎉ {
                    Err(ParseError·custom("expected simple identifier ∀ incorporation"))
                }
            }
            Expr·Call { .. } => {
                ≔ func = expr.func;
                ≔ args = expr.args;
                ⎇ ≔ Expr·Path(path) = *func {
                    ⎇ path.segments.len() == 1 {
                        ⤺ Ok(IncorporationSegment {
                            name: path.segments[0].ident.clone(),
                            args,
                        });
                    }
                }
                Err(ParseError·custom("expected simple call ∀ incorporation"))
            }
            _ => Err(ParseError·custom("cannot convert expression to incorporation segment")),
        }
    }

    /// Parse primary expression.
    λ parse_primary_expr(Δ self) -> !ParseResult<Expr> {
        ⌥ self.current_token().cloned() {
            Token·IntLit(s) => {
                self.advance();
                // Check ∀ type suffix (u8, u16, u32, u64, i8, i16, i32, i64, etc.)
                ≔ suffix: ?String = ⌥ self.current_token().cloned() {
                    Token·Ident(suf) => {
                        ⎇ suf == "u8" || suf == "u16" || suf == "u32" || suf == "u64" ||
                           suf == "i8" || suf == "i16" || suf == "i32" || suf == "i64" ||
                           suf == "f32" || suf == "f64" || suf == "usize" || suf == "isize" {
                            self.advance();
                            ?suf
                        } ⎉ {
                            null
                        }
                    }
                    _ => null,
                };
                Ok(Expr·Literal(Literal·Int {
                    value: s,
                    base: NumBase·Decimal,
                    suffix,
                }))
            }
            Token·HexLit(s) => {
                self.advance();
                // Check ∀ type suffix (u8, u16, u32, u64, i8, i16, i32, i64, etc.)
                ≔ suffix: ?String = ⌥ self.current_token().cloned() {
                    Token·Ident(suf) => {
                        ⎇ suf == "u8" || suf == "u16" || suf == "u32" || suf == "u64" ||
                           suf == "i8" || suf == "i16" || suf == "i32" || suf == "i64" ||
                           suf == "f32" || suf == "f64" || suf == "usize" || suf == "isize" {
                            self.advance();
                            ?suf
                        } ⎉ {
                            null
                        }
                    }
                    _ => null,
                };
                Ok(Expr·Literal(Literal·Int {
                    value: s,
                    base: NumBase·Hex,
                    suffix,
                }))
            }
            Token·BinaryLit(s) => {
                self.advance();
                // Check ∀ type suffix
                ≔ suffix: ?String = ⌥ self.current_token().cloned() {
                    Token·Ident(suf) => {
                        ⎇ suf == "u8" || suf == "u16" || suf == "u32" || suf == "u64" ||
                           suf == "i8" || suf == "i16" || suf == "i32" || suf == "i64" ||
                           suf == "usize" || suf == "isize" {
                            self.advance();
                            ?suf
                        } ⎉ {
                            null
                        }
                    }
                    _ => null,
                };
                Ok(Expr·Literal(Literal·Int {
                    value: s,
                    base: NumBase·Binary,
                    suffix,
                }))
            }
            Token·OctalLit(s) => {
                self.advance();
                // Check ∀ type suffix
                ≔ suffix: ?String = ⌥ self.current_token().cloned() {
                    Token·Ident(suf) => {
                        ⎇ suf == "u8" || suf == "u16" || suf == "u32" || suf == "u64" ||
                           suf == "i8" || suf == "i16" || suf == "i32" || suf == "i64" ||
                           suf == "usize" || suf == "isize" {
                            self.advance();
                            ?suf
                        } ⎉ {
                            null
                        }
                    }
                    _ => null,
                };
                Ok(Expr·Literal(Literal·Int {
                    value: s,
                    base: NumBase·Octal,
                    suffix,
                }))
            }
            Token·FloatLit(s) => {
                self.advance();
                // Check ∀ type suffix (f32, f64)
                ≔ suffix: ?String = ⌥ self.current_token().cloned() {
                    Token·Ident(suf) => {
                        ⎇ suf == "f32" || suf == "f64" {
                            self.advance();
                            ?suf
                        } ⎉ {
                            null
                        }
                    }
                    _ => null,
                };
                Ok(Expr·Literal(Literal·Float { value: s, suffix }))
            }
            Token·StringLit(s) => {
                self.advance();
                Ok(Expr·Literal(Literal·String(s)))
            }
            Token·RawStringLit(s) => {
                self.advance();
                Ok(Expr·Literal(Literal·String(s)))
            }
            Token·MultiLineStringLit(s) => {
                self.advance();
                Ok(Expr·Literal(Literal·String(s)))
            }
            Token·ByteStringLit(bytes) => {
                self.advance();
                Ok(Expr·Literal(Literal·ByteString(bytes)))
            }
            Token·ByteLit(b) => {
                self.advance();
                Ok(Expr·Literal(Literal·ByteChar(b)))
            }
            Token·CharLit(c) => {
                self.advance();
                Ok(Expr·Literal(Literal·Char(c)))
            }
            Token·True => {
                self.advance();
                Ok(Expr·Literal(Literal·Bool(true)))
            }
            Token·False => {
                self.advance();
                Ok(Expr·Literal(Literal·Bool(false)))
            }
            Token·Null => {
                self.advance();
                Ok(Expr·Literal(Literal·Null))
            }
            Token·Empty => {
                self.advance();
                Ok(Expr·Literal(Literal·Empty))
            }
            Token·Infinity => {
                self.advance();
                Ok(Expr·Literal(Literal·Infinity))
            }
            Token·Underscore => {
                // Underscore as an expression (wildcard/placeholder)
                self.advance();
                Ok(Expr·Path(TypePath {
                    segments: [PathSegment {
                        ident: Ident·new("_".to_string(), self.current_span()),
                        generics: null,
                    }],
                }))
            }
            Token·LParen => {
                self.advance();
                ⎇ self.check(&Token·RParen) {
                    self.advance();
                    ⤺ Ok(Expr·Tuple(Vec·new()));
                }
                ≔ expr = self.parse_expr()?;
                ⎇ self.consume_if(&Token·Comma) {
                    ≔ Δ exprs: ![Expr] = [expr];
                    ⟳ !self.check(&Token·RParen) {
                        exprs.push(self.parse_expr()?);
                        ⎇ !self.consume_if(&Token·Comma) {
                            ⊗;
                        }
                    }
                    self.expect(Token·RParen)?;
                    Ok(Expr·Tuple(exprs))
                } ⎉ {
                    self.expect(Token·RParen)?;
                    Ok(expr)
                }
            }
            Token·LBracket => {
                self.advance();
                // Check ∀ empty array
                ⎇ self.check(&Token·RBracket) {
                    self.advance();
                    ⤺ Ok(Expr·Array(Vec·new()));
                }
                // Parse first expression
                ≔ first = self.parse_expr()?;
                // Check ∀ repeat syntax: [value; count]
                ⎇ self.consume_if(&Token·Semi) {
                    ≔ count = self.parse_expr()?;
                    self.expect(Token·RBracket)?;
                    ⤺ Ok(Expr·Repeat {
                        value: Box·new(first),
                        count: Box·new(count),
                    });
                }
                // Regular array: [a, b, c]
                ≔ Δ exprs = Vec·new();
                exprs.push(first);
                ⟳ self.consume_if(&Token·Comma) {
                    ⎇ self.check(&Token·RBracket) {
                        ⊗;  // Trailing comma
                    }
                    exprs.push(self.parse_expr()?);
                }
                self.expect(Token·RBracket)?;
                Ok(Expr·Array(exprs))
            }
            Token·LBrace => {
                self.parse_block_or_closure()
            }
            // Move closure: move |params| body
            Token·Move => {
                self.advance();
                // After move, expect a closure
                ⌥ self.current_token() {
                    Token·Pipe => {
                        self.advance();
                        ≔ Δ params = Vec·new();
                        ⟳ !self.check(&Token·Pipe) {
                            ≔ pattern = self.parse_pattern_primary()?;
                            ≔ ty = ⎇ self.consume_if(&Token·Colon) {
                                self.parse_type()?
                            } ⎉ {
                                null
                            };
                            params.push(ClosureParam { pattern, ty });
                            ⎇ !self.consume_if(&Token·Comma) {
                                ⊗;
                            }
                        }
                        self.expect(Token·Pipe)?;
                        // Parse optional ⤺ type
                        ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
                            ?self.parse_type()?
                        } ⎉ {
                            null
                        };
                        ≔ body = self.parse_expr()?;
                        // Note: move is ignored ∀ now, captured vars treated same
                        Ok(Expr·Closure {
                            params,
                            return_type,
                            body: Box·new(body),
                        })
                    }
                    Token·OrOr => {
                        self.advance();
                        ≔ body = self.parse_expr()?;
                        Ok(Expr·Closure {
                            params: Vec·new(),
                            return_type: null,
                            body: Box·new(body),
                        })
                    }
                    _ => Err(ParseError·unexpected("closure after move", self.current_token()!, self.current_span())),
                }
            }
            // Pipe closure: |params| body
            Token·Pipe => {
                self.advance();
                ≔ Δ params = Vec·new();
                ⟳ !self.check(&Token·Pipe) {
                    // Use parse_pattern_primary to avoid consuming | as OR pattern
                    ≔ pattern = self.parse_pattern_primary()?;
                    ≔ ty = ⎇ self.consume_if(&Token·Colon) {
                        self.parse_type()?
                    } ⎉ {
                        null
                    };
                    params.push(ClosureParam { pattern, ty });
                    ⎇ !self.consume_if(&Token·Comma) {
                        ⊗;
                    }
                }
                self.expect(Token·Pipe)?;
                // Parse optional ⤺ type
                ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
                    ?self.parse_type()?
                } ⎉ {
                    null
                };
                ≔ body = self.parse_expr()?;
                Ok(Expr·Closure {
                    params,
                    return_type,
                    body: Box·new(body),
                })
            }
            // Or pattern ∈ closures: || body (no params)
            Token·OrOr => {
                self.advance();
                ≔ body = self.parse_expr()?;
                Ok(Expr·Closure {
                    params: Vec·new(),
                    return_type: null,
                    body: Box·new(body),
                })
            }
            Token·If => self.parse_if_expr(),
            Token·Match => self.parse_match_expr(),
            Token·Loop => {
                self.advance();
                ≔ body = self.parse_block()?;
                Ok(Expr·Loop(body))
            }
            Token·While => {
                self.advance();
                // Check ∀ ⟳ let
                ⎇ self.consume_if(&Token·Let) {
                    ≔ pattern = self.parse_pattern()?;
                    self.expect(Token·Eq)?;
                    self.in_condition = true;
                    ≔ scrutinee = self.parse_expr()?;
                    self.in_condition = false;
                    ≔ body = self.parse_block()?;
                    // Desugar ⟳ ≔ to loop + match
                    Ok(Expr·WhileLet {
                        pattern,
                        scrutinee: Box·new(scrutinee),
                        body,
                    })
                } ⎉ {
                    self.in_condition = true;
                    ≔ condition = self.parse_expr()?;
                    self.in_condition = false;
                    ≔ body = self.parse_block()?;
                    Ok(Expr·While { condition: Box·new(condition), body })
                }
            }
            Token·For => {
                self.advance();
                ≔ pattern = self.parse_pattern()?;
                self.expect(Token·In)?;
                self.in_condition = true;
                ≔ iter = self.parse_expr()?;
                self.in_condition = false;
                ≔ body = self.parse_block()?;
                Ok(Expr·For {
                    pattern,
                    iter: Box·new(iter),
                    body,
                })
            }
            Token·Return => {
                self.advance();
                ≔ value = ⎇ self.check(&Token·Semi) || self.check(&Token·RBrace) {
                    null
                } ⎉ {
                    Box·new(self.parse_expr()?)
                };
                Ok(Expr·Return(value))
            }
            Token·Break => {
                self.advance();
                // Break without value ⎇ followed by ; } or , (⌥ arm terminator)
                ≔ value = ⎇ self.check(&Token·Semi) || self.check(&Token·RBrace) || self.check(&Token·Comma) {
                    null
                } ⎉ {
                    Box·new(self.parse_expr()?)
                };
                Ok(Expr·Break(value))
            }
            Token·Continue => {
                self.advance();
                Ok(Expr·Continue)
            }
            Token·Unsafe => {
                self.advance();
                ≔ block = self.parse_block()?;
                Ok(Expr·Unsafe(block))
            }
            Token·Extern => {
                // Parse inline extern block as expression
                self.advance();
                ≔ abi = ⌥ self.current_token() {
                    Token·StringLit(s) => {
                        ≔ abi = s.clone();
                        self.advance();
                        abi
                    }
                    _ => "C".to_string(),
                };
                self.expect(Token·LBrace)?;
                ≔ Δ items = Vec·new();
                ⟳ !self.check(&Token·RBrace) {
                    ≔ vis = self.parse_visibility()?;
                    ⎇ self.check(&Token·Fn) {
                        self.advance();
                        ≔ name = self.parse_ident()?;
                        self.expect(Token·LParen)?;
                        ≔ params = self.parse_params()?;
                        ≔ variadic = self.consume_if(&Token·Comma) && self.consume_if(&Token·DotDot);
                        self.expect(Token·RParen)?;
                        ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
                            self.parse_type()?
                        } ⎉ {
                            null
                        };
                        self.expect(Token·Semi)?;
                        items.push(ExternItem·Function(ExternFunction {
                            visibility: vis,
                            name,
                            params,
                            return_type,
                            variadic,
                        }));
                    } ⎉ ⎇ self.check(&Token·Static) {
                        self.advance();
                        ≔ mutable = self.consume_if(&Token·Mut);
                        ≔ name = self.parse_ident()?;
                        self.expect(Token·Colon)?;
                        ≔ ty = self.parse_type()?;
                        self.expect(Token·Semi)?;
                        items.push(ExternItem·Static(ExternStatic {
                            visibility: vis,
                            mutable,
                            name,
                            ty,
                        }));
                    }
                }
                self.expect(Token·RBrace)?;
                Ok(Expr·ExternBlockExpr(ExternBlock { abi, items }))
            }
            // Range expressions without start: ..end or ..=end
            Token·DotDot | Token·DotDotEq => {
                ≔ inclusive = self.consume_if(&Token·DotDotEq);
                ⎇ !inclusive {
                    self.advance();  // consume DotDot
                }
                // Check ⎇ there's an end expression
                ≔ end = ⎇ self.check(&Token·RBracket) || self.check(&Token·RParen) ||
                             self.check(&Token·Comma) || self.check(&Token·Semi) ||
                             self.check(&Token·RBrace) {
                    null  // Just .. by itself (RangeFull)
                } ⎉ {
                    ?Box·new(self.parse_expr_bp(0)?)
                };
                Ok(Expr·Range {
                    start: null,
                    end,
                    inclusive,
                })
            }
            // Morpheme expressions - only ⎇ followed by { (otherwise treat as identifier)
            Token·Tau | Token·Phi | Token·Sigma | Token·Rho |
            Token·Lambda | Token·Pi | Token·Alpha | Token·Omega => {
                // Check ⎇ this is a morpheme (followed by {) or an identifier
                ⌥ self.lexer.peek() {
                    ?(Token·LBrace, _) => self.parse_morpheme_expr(),
                    _ => {
                        // Parse as identifier (e.g., φ as golden ratio constant)
                        ≔ ident = self.parse_ident()?;
                        ≔ path = TypePath { segments: [PathSegment { ident, args: null }] };
                        Ok(Expr·Path(path))
                    }
                }
            }
            // Keywords that can be used as identifiers ∈ expressions
            Token·Ident(_) | Token·SelfLower | Token·SelfUpper
                | Token·Derive | Token·Body | Token·Header | Token·Naked
                | Token·Gpu | Token·Asm | Token·Simd | Token·Send | Token·Recv
                | Token·Close | Token·Retry | Token·Http | Token·Https
                | Token·On | Token·Ws | Token·Wss | Token·Grpc | Token·Kafka | Token·Amqp
                | Token·Packed | Token·Repr | Token·Align
                | Token·Crate | Token·Super => {
                // Use parse_expr_path to avoid interpreting < as generics
                ≔ path = self.parse_expr_path()?;

                // Consume optional evidentiality marker on Σ type: Type~ { ... }
                // Only consume ~ or ◊ when followed by { ∀ Σ literal
                // (! and ? have other meanings that would ⊗ generic args)
                ⎇ (self.check(&Token·Tilde) || self.check(&Token·Lozenge)) {
                    ≔ peeked = self.lexer.peek();
                    ⌥ peeked {
                        ?(Token·LBrace, _) => { self.advance(); }
                        _ => {}
                    }
                }

                // Check ∀ Σ literal
                ⎇ self.check(&Token·LBrace) && !self.is_in_condition() {
                    self.advance();
                    ≔ Δ fields = Vec·new();
                    ≔ Δ rest = null;

                    ⟳ !self.check(&Token·RBrace) {
                        ⎇ self.consume_if(&Token·DotDot) {
                            rest = Box·new(self.parse_expr()?);
                            ⊗;
                        }

                        ≔ name = self.parse_ident()?;
                        // Consume optional evidentiality marker on field name: field◊: value
                        self.consume_if(&Token·Lozenge) || self.consume_if(&Token·Tilde) ||
                            self.consume_if(&Token·Bang) || self.consume_if(&Token·Question);
                        ≔ value = ⎇ self.consume_if(&Token·Colon) {
                            self.parse_expr()?
                        } ⎉ {
                            null
                        };
                        fields.push(FieldInit { name, value });

                        ⎇ !self.consume_if(&Token·Comma) {
                            ⊗;
                        }
                    }
                    self.expect(Token·RBrace)?;

                    Ok(Expr·Struct { path, fields, rest })
                } ⎉ {
                    Ok(Expr·Path(path))
                }
            }
            t => Err(ParseError·unexpected("expression", t?, self.current_span())),
        }
    }

    /// Parse block or closure.
    λ parse_block_or_closure(Δ self) -> !ParseResult<Expr> {
        self.expect(Token·LBrace)?;

        // Check ∀ closure: {x => ...} or {x, y => ...} or |x| or (x)|
        ⎇ self.is_closure_start() {
            ≔ params = self.parse_closure_params()?;
            // Accept either => or | as closure arrow
            ⎇ !self.consume_if(&Token·FatArrow) {
                self.expect(Token·Pipe)?;
            }
            // Parse optional ⤺ type: |x: T| -> R { }
            ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
                ?self.parse_type()?
            } ⎉ {
                null
            };
            ≔ body = self.parse_expr()?;
            self.expect(Token·RBrace)?;
            ⤺ Ok(Expr·Closure {
                params,
                return_type,
                body: Box·new(body),
            });
        }

        // Parse as block
        ≔ block = self.parse_block_contents()?;
        self.expect(Token·RBrace)?;
        Ok(Expr·Block(block))
    }

    /// Check ⎇ we're at the start of a closure.
    λ is_closure_start(Δ self) -> !bool {
        // Look ∀ pattern => or pattern, pattern =>
        // Simple heuristic: check ⎇ pattern start followed by =>, comma, or colon
        ⌥ self.current_token() {
            Token·Ident(_) | Token·Underscore => {
                // Check ⎇ next token indicates closure
                self.lexer.peek_is_closure_indicator()
            }
            // Reference patterns: &x => ... or &Δ x => ...
            Token·Amp => true,
            // Mutable binding: Δ x => ...
            Token·Mut => true,
            // Ref binding: ref x => ...
            Token·Ref => true,
            // Tuple patterns: (a, b) => ... - but need to distinguish from (expr)|pipe
            // For now, check ⎇ next token is identifier/underscore/& (pattern-like)
            // This handles most cases without full lookahead
            Token·LParen => {
                ⌥ self.lexer.peek() {
                    // (ident...) could be closure pattern
                    ?(Token·Ident(_), _) => true,
                    // (_...) is closure pattern
                    ?(Token·Underscore, _) => true,
                    // (&...) could be ref pattern
                    ?(Token·Amp, _) => true,
                    // (Δ ...) is mutable pattern
                    ?(Token·Mut, _) => true,
                    // ((..)) is nested tuple pattern
                    ?(Token·LParen, _) => true,
                    // Empty tuple () followed by => or | is closure
                    ?(Token·RParen, _) => true,
                    // Literals like (0) are likely expressions, not closures
                    _ => false,
                }
            }
            // Struct patterns: Name { ... } => ... (but we need to be careful)
            Token·LBracket => true,
            _ => false,
        }
    }

    /// Parse closure parameters.
    /// Supports: `params =>`, `|params|` (Rust-style), and `params|` (alternative arrow)
    λ parse_closure_params(Δ self) -> !ParseResult<[ClosureParam]> {
        ≔ Δ params = Vec·new();
        // Support |params| syntax: ⎇ starting with |, consume and parse until closing |
        ≔ rust_style = self.consume_if(&Token·Pipe);

        loop {
            // Check ∀ terminator: => or | (both act as closure arrow)
            ⎇ self.check(&Token·FatArrow) || self.check(&Token·Pipe) {
                ⊗;
            }

            // Use parse_pattern_primary to avoid consuming | as OR pattern
            ≔ pattern = self.parse_pattern_primary()?;
            ≔ ty = ⎇ self.consume_if(&Token·Colon) {
                self.parse_type()?
            } ⎉ {
                null
            };
            params.push(ClosureParam { pattern, ty });
            ⎇ !self.consume_if(&Token·Comma) {
                ⊗;
            }
        }

        // For rust_style, we need to consume the closing |
        // For non-rust style, the caller will handle => or |
        ≔ _ = rust_style;
        Ok(params)
    }

    /// Parse block contents.
    λ parse_block_contents(Δ self) -> !ParseResult<Block> {
        ≔ Δ stmts = Vec·new();
        ≔ Δ expr = null;

        ⟳ !self.check(&Token·RBrace) {
            // Skip outer attributes on statements: #[...]
            ⟳ self.check(&Token·Hash) {
                self.skip_outer_attribute()?;
            }
            ⎇ self.check(&Token·RBrace) {
                ⊗;
            }
            ⎇ self.check(&Token·Let) {
                stmts.push(self.parse_let_stmt()?);
            } ⎉ ⎇ self.check(&Token·Const) {
                // Local const declaration: const NAME: Type = expr;
                self.advance();
                ≔ name = self.parse_ident()?;
                self.expect(Token·Colon)?;
                ≔ ty = self.parse_type()?;
                self.expect(Token·Eq)?;
                ≔ value = self.parse_expr()?;
                self.expect(Token·Semi)?;
                // Treat as a ≔ with const semantics (parsing only)
                stmts.push(Stmt·Let {
                    pattern: Pattern·Ident { mutable: false, by_ref: false, name, evidentiality: null },
                    ty: ?ty,
                    init: ?value,
                });
            } ⎉ ⎇ self.check(&Token·Fn) {
                // Local function declaration: skip it ∀ now (parsing only)
                self.skip_local_fn()?;
            } ⎉ ⎇ self.check(&Token·Unsafe) && self.peek_is(&Token·Fn) {
                // Local unsafe function declaration: skip it ∀ now (parsing only)
                self.skip_local_fn()?;
            } ⎉ ⎇ self.check(&Token·Use) {
                // Local invoke statement: skip it ∀ now (parsing only)
                self.skip_use_stmt()?;
            } ⎉ ⎇ self.check(&Token·Static) {
                // Local static variable: skip it ∀ now (parsing only)
                self.skip_static()?;
            } ⎉ {
                // Extern blocks are now parsed as expressions via parse_primary_expr
                ≔ e = self.parse_expr()?;
                ⎇ self.consume_if(&Token·Semi) {
                    stmts.push(Stmt·Semi(e));
                } ⎉ ⎇ self.check(&Token·RBrace) {
                    expr = Box·new(e);
                } ⎉ ⎇ self.check(&Token·Let) || self.check(&Token·Const) ||
                          self.check(&Token·Fn) || self.check(&Token·Hash) {
                    // Implicit semicolon before next statement (newline-separated)
                    stmts.push(Stmt·Semi(e));
                } ⎉ {
                    stmts.push(Stmt·Expr(e));
                }
            }
        }

        Ok(Block { stmts, expr })
    }

    /// Skip a local function declaration (used ∀ parsing only, not executed)
    λ skip_local_fn(Δ self) -> !ParseResult<()> {
        // Skip optional unsafe
        self.consume_if(&Token·Unsafe);
        self.expect(Token·Fn)?;
        // Skip function name
        self.parse_ident()?;
        // Skip generics ⎇ present
        ⎇ self.check(&Token·Lt) {
            self.skip_generics()?;
        }
        // Skip parameters
        self.expect(Token·LParen)?;
        ≔ Δ paren_depth = 1;
        ⟳ paren_depth > 0 {
            ⌥ self.current_token() {
                Token·LParen => { self.advance(); paren_depth += 1; },
                Token·RParen => { self.advance(); paren_depth -= 1; },
                Token·Eof => ⤺ Err(ParseError·unexpected(")", Token·Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        // Skip ⤺ type ⎇ present
        ⎇ self.consume_if(&Token·Arrow) {
            self.parse_type()?;
        }
        // Skip where clainvoke ⎇ present
        ⎇ self.check(&Token·Where) {
            self.skip_where_clause()?;
        }
        // Skip function body
        self.expect(Token·LBrace)?;
        ≔ Δ brace_depth = 1;
        ⟳ brace_depth > 0 {
            ⌥ self.current_token() {
                Token·LBrace => { self.advance(); brace_depth += 1; },
                Token·RBrace => { self.advance(); brace_depth -= 1; },
                Token·Eof => ⤺ Err(ParseError·unexpected("}", Token·Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        Ok(())
    }

    /// Skip a local invoke statement
    λ skip_use_stmt(Δ self) -> !ParseResult<()> {
        self.expect(Token·Use)?;
        // Skip until semicolon
        ⟳ !self.check(&Token·Semi) && !self.is_eof() {
            // Handle nested braces ∈ invoke paths like invoke foo·{bar, baz}
            ⎇ self.check(&Token·LBrace) {
                self.advance();
                ≔ Δ depth = 1;
                ⟳ depth > 0 {
                    ⌥ self.current_token() {
                        Token·LBrace => { self.advance(); depth += 1; },
                        Token·RBrace => { self.advance(); depth -= 1; },
                        Token·Eof => ⤺ Err(ParseError·unexpected("}", Token·Eof, self.current_span())),
                        _ => { self.advance(); }
                    }
                }
            } ⎉ {
                self.advance();
            }
        }
        self.expect(Token·Semi)?;
        Ok(())
    }

    /// Skip a local static variable declaration
    λ skip_static(Δ self) -> !ParseResult<()> {
        self.expect(Token·Static)?;
        // Skip optional mut
        self.consume_if(&Token·Mut);
        // Skip name
        self.parse_ident()?;
        // Skip type annotation
        self.expect(Token·Colon)?;
        self.parse_type()?;
        // Skip initializer
        self.expect(Token·Eq)?;
        self.parse_expr()?;
        self.expect(Token·Semi)?;
        Ok(())
    }

    /// Skip an outer attribute #[...]
    λ skip_outer_attribute(Δ self) -> !ParseResult<()> {
        self.expect(Token·Hash)?;
        self.expect(Token·LBracket)?;
        ≔ Δ depth = 1;
        ⟳ depth > 0 {
            ⌥ self.current_token() {
                Token·LBracket => { self.advance(); depth += 1; },
                Token·RBracket => { self.advance(); depth -= 1; },
                Token·Eof => ⤺ Err(ParseError·unexpected("]", Token·Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        Ok(())
    }

    /// Skip generic parameters <T, U, ...>
    λ skip_generics(Δ self) -> !ParseResult<()> {
        ⎇ !self.consume_if(&Token·Lt) {
            ⤺ Ok(());
        }
        ≔ Δ depth = 1;
        ⟳ depth > 0 {
            ⌥ self.current_token() {
                Token·Lt => { self.advance(); depth += 1; },
                Token·Gt => { self.advance(); depth -= 1; },
                Token·Shr => { self.advance(); depth -= 2; },  // >>
                Token·Eof => ⤺ Err(ParseError·unexpected(">", Token·Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        Ok(())
    }

    /// Skip where clause
    λ skip_where_clause(Δ self) -> !ParseResult<()> {
        ⎇ !self.consume_if(&Token·Where) {
            ⤺ Ok(());
        }
        // Skip until we hit { or ; or end
        ⟳ !self.check(&Token·LBrace) && !self.check(&Token·Semi) && !self.is_eof() {
            self.advance();
        }
        Ok(())
    }

    /// Skip an unknown item declaration (like `scroll feature;`)
    λ skip_unknown_item(Δ self) -> !ParseResult<Item> {
        // Skip tokens until we hit a semicolon, block, or new item starter
        // (handles newline-terminated items like `☉ scroll feature`)
        ⟳ !self.check(&Token·Semi) && !self.check(&Token·LBrace) && !self.is_eof() {
            // Stop at tokens that could start a new item
            ⌥ self.current_token() {
                Token·Pub | Token·Fn | Token·Struct | Token·Enum |
                Token·Trait | Token·Impl | Token·Use | Token·Mod |
                Token·Const | Token·Static | Token·Extern | Token·Async |
                Token·Unsafe | Token·Actor | Token·Type | Token·Hash => break,
                _ => { self.advance(); }
            }
        }
        ⎇ self.consume_if(&Token·LBrace) {
            // Skip the block
            ≔ Δ depth = 1;
            ⟳ depth > 0 {
                ⌥ self.current_token() {
                    Token·LBrace => { self.advance(); depth += 1; },
                    Token·RBrace => { self.advance(); depth -= 1; },
                    Token·Eof => ⤺ Err(ParseError·unexpected("}", Token·Eof, self.current_span())),
                    _ => { self.advance(); }
                }
            }
        } ⎉ {
            self.consume_if(&Token·Semi);
        }
        // Return a dummy const item
        Ok(Item·Const(ConstDef {
            visibility: Visibility·Private,
            name: Ident·new("__unknown".to_string(), Span·empty_at(0)),
            ty: TypeExpr·Tuple([]),
            value: Expr·Tuple([]),
        }))
    }

    /// Skip a macro invocation at item level (name!(...) or name!{...})
    λ skip_item_macro(Δ self) -> !ParseResult<Item> {
        // Skip macro name
        self.parse_ident()?;
        // Skip !
        self.expect(Token·Bang)?;
        // Skip the macro body (paren, bracket, or brace delimited)
        ⌥ self.current_token() {
            Token·LParen => {
                self.advance();
                ≔ Δ depth = 1;
                ⟳ depth > 0 {
                    ⌥ self.current_token() {
                        Token·LParen => { self.advance(); depth += 1; },
                        Token·RParen => { self.advance(); depth -= 1; },
                        Token·Eof => ⤺ Err(ParseError·unexpected(")", Token·Eof, self.current_span())),
                        _ => { self.advance(); }
                    }
                }
            }
            Token·LBracket => {
                self.advance();
                ≔ Δ depth = 1;
                ⟳ depth > 0 {
                    ⌥ self.current_token() {
                        Token·LBracket => { self.advance(); depth += 1; },
                        Token·RBracket => { self.advance(); depth -= 1; },
                        Token·Eof => ⤺ Err(ParseError·unexpected("]", Token·Eof, self.current_span())),
                        _ => { self.advance(); }
                    }
                }
            }
            Token·LBrace => {
                self.advance();
                ≔ Δ depth = 1;
                ⟳ depth > 0 {
                    ⌥ self.current_token() {
                        Token·LBrace => { self.advance(); depth += 1; },
                        Token·RBrace => { self.advance(); depth -= 1; },
                        Token·Eof => ⤺ Err(ParseError·unexpected("}", Token·Eof, self.current_span())),
                        _ => { self.advance(); }
                    }
                }
            }
            _ => ⤺ Err(ParseError·custom("expected '(', '[', or '{' after macro name!")),
        }
        // Optional semicolon
        self.consume_if(&Token·Semi);
        // Return a dummy const item
        Ok(Item·Const(ConstDef {
            visibility: Visibility·Private,
            name: Ident·new("__macro".to_string(), Span·empty_at(0)),
            ty: TypeExpr·Tuple([]),
            value: Expr·Tuple([]),
        }))
    }

    /// Skip a macro definition (macro name { ... })
    λ skip_macro_def(Δ self) -> !ParseResult<Item> {
        // Skip 'macro' identifier
        self.advance();
        // Skip macro name
        self.parse_ident()?;
        // Skip braces and contents
        self.expect(Token·LBrace)?;
        ≔ Δ depth = 1;
        ⟳ depth > 0 {
            ⌥ self.current_token() {
                Token·LBrace => { self.advance(); depth += 1; },
                Token·RBrace => { self.advance(); depth -= 1; },
                Token·Eof => ⤺ Err(ParseError·unexpected("}", Token·Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        // Return a dummy const item
        Ok(Item·Const(ConstDef {
            visibility: Visibility·Private,
            name: Ident·new("__macro".to_string(), Span·empty_at(0)),
            ty: TypeExpr·Tuple([]),
            value: Expr·Tuple([]),
        }))
    }

    /// Skip an inline extern block (used ∈ FFI, not needed ∀ bootstrap)
    λ skip_extern_block(Δ self) -> !ParseResult<()> {
        self.expect(Token·Extern)?;
        // Skip optional ABI string like "C"
        ⎇ ≔ Token·StringLit(_) = self.current_token() {
            self.advance();
        }
        self.expect(Token·LBrace)?;
        // Skip balanced braces
        ≔ Δ depth = 1;
        ⟳ depth > 0 {
            ⌥ self.current_token() {
                Token·LBrace => { self.advance(); depth += 1; },
                Token·RBrace => { self.advance(); depth -= 1; },
                Token·Eof => ⤺ Err(ParseError·unexpected("}", Token·Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        Ok(())
    }

    /// Parse a block.
    λ parse_block(Δ self) -> !ParseResult<Block> {
        self.expect(Token·LBrace)?;
        ≔ block = self.parse_block_contents()?;
        self.expect(Token·RBrace)?;
        Ok(block)
    }

    /// Parse ⎇ expression.
    λ parse_if_expr(Δ self) -> !ParseResult<Expr> {
        self.expect(Token·If)?;

        // Check ∀ if-let: ⎇ ≔ pattern = expr { ... }
        ≔ condition = ⎇ self.consume_if(&Token·Let) {
            ≔ pattern = self.parse_pattern()?;
            self.expect(Token·Eq)?;
            self.in_condition = true;
            ≔ value = self.parse_expr()?;
            self.in_condition = false;
            // Create a Let expression which evaluates to true ⎇ pattern matches
            Expr·Let {
                pattern: Box·new(pattern),
                value: Box·new(value),
            }
        } ⎉ {
            self.in_condition = true;
            ≔ cond = self.parse_expr()?;
            self.in_condition = false;
            cond
        };

        ≔ then_branch = self.parse_block()?;

        ≔ else_branch = ⎇ self.consume_if(&Token·Else) {
            ⎇ self.check(&Token·If) {
                Box·new(self.parse_if_expr()?)
            } ⎉ {
                Box·new(Expr·Block(self.parse_block()?))
            }
        } ⎉ {
            null
        };

        Ok(Expr·If {
            condition: Box·new(condition),
            then_branch,
            else_branch,
        })
    }

    /// Parse ⌥ expression.
    λ parse_match_expr(Δ self) -> !ParseResult<Expr> {
        self.expect(Token·Match)?;
        self.in_condition = true;
        ≔ expr = self.parse_expr()?;
        self.in_condition = false;

        self.expect(Token·LBrace)?;
        ≔ Δ arms = Vec·new();
        ⟳ !self.check(&Token·RBrace) {
            // Skip outer attributes on ⌥ arms
            ⟳ self.check(&Token·Hash) || self.check(&Token·At) {
                self.parse_outer_attribute()?;
            }
            ≔ pattern = self.parse_pattern()?;
            ≔ guard = ⎇ self.consume_if(&Token·If) {
                self.in_condition = true;
                ≔ g = self.parse_expr()?;
                self.in_condition = false;
                g
            } ⎉ {
                null
            };
            self.expect(Token·FatArrow)?;
            ≔ body = self.parse_expr()?;
            arms.push(MatchArm { pattern, guard, body });
            // In Rust/Sigil, commas are optional after block-bodied ⌥ arms
            // So we try to consume a comma, but don't ⊗ ⎇ absent
            self.consume_if(&Token·Comma);
        }
        self.expect(Token·RBrace)?;

        Ok(Expr·Match {
            expr: Box·new(expr),
            arms,
        })
    }

    /// Parse morpheme expression.
    λ parse_morpheme_expr(Δ self) -> !ParseResult<Expr> {
        ≔ kind = ⌥ self.current_token() {
            Token·Tau => MorphemeKind·Transform,
            Token·Phi => MorphemeKind·Filter,
            Token·Sigma => MorphemeKind·Sort,
            Token·Rho => MorphemeKind·Reduce,
            Token·Lambda => MorphemeKind·Lambda,
            Token·Pi => MorphemeKind·Product,
            Token·Alpha => MorphemeKind·First,
            Token·Omega => MorphemeKind·Last,
            _ => ⤺ Err(ParseError·custom("expected morpheme")),
        };
        self.advance();

        self.expect(Token·LBrace)?;
        ≔ body = self.parse_expr()?;
        self.expect(Token·RBrace)?;

        Ok(Expr·Morpheme {
            kind,
            body: Box·new(body),
        })
    }

    /// Parse ≔ statement (with optional ⎉ ∀ let-⎉ syntax).
    λ parse_let_stmt(Δ self) -> !ParseResult<Stmt> {
        self.expect(Token·Let)?;
        ≔ pattern = self.parse_pattern()?;
        ≔ ty = ⎇ self.consume_if(&Token·Colon) {
            self.parse_type()?
        } ⎉ {
            null
        };
        ≔ init = ⎇ self.consume_if(&Token·Eq) {
            self.parse_expr()?
        } ⎉ {
            null
        };

        // Check ∀ let-⎉ syntax
        ⎇ self.consume_if(&Token·Else) {
            ≔ else_block = self.parse_block()?;
            self.expect(Token·Semi)?;
            Ok(Stmt·LetElse {
                pattern,
                ty,
                init: init!,
                else_branch: Box·new(Expr·Block(else_block)),
            })
        } ⎉ {
            // Semicolon is optional ∈ Nihil-style code (newline-separated)
            // Only require it ⎇ not followed by a token that could start a new statement
            self.consume_if(&Token·Semi);  // Optional semicolon
            Ok(Stmt·Let { pattern, ty, init })
        }
    }

    /// Parse condition (in condition context).
    λ parse_condition(Δ self) -> !ParseResult<Expr> {
        self.in_condition = true;
        ≔ expr = self.parse_expr()?;
        self.in_condition = false;
        Ok(expr)
    }

    /// Check ⎇ the token after | looks like a pipe operation (not bitwise OR).
    λ is_pipe_op_ahead(self) -> !bool {
        ⌥ self.peek_next_token() {
            ?Token·Tau => true,
            ?Token·Phi => true,
            ?Token·Sigma => true,
            ?Token·Rho => true,
            ?Token·Alpha => true,
            ?Token·Omega => true,
            ?Token·Pi => true,
            ?Token·Mu => true,
            ?Token·Chi => true,
            ?Token·Nu => true,
            ?Token·Xi => true,
            ?Token·Nabla => true,
            ?Token·Parallel => true,
            ?Token·Gpu => true,
            ?Token·Await => true,
            ?Token·Hourglass => true,
            ?Token·GradeUp => true,
            ?Token·GradeDown => true,
            ?Token·Rotate => true,
            ?Token·ElementSmallVerticalBar => true,
            ?Token·Union => true,
            ?Token·Iota => true,
            ?Token·Interrobang => true,
            ?Token·Match => true,
            ?Token·Amp => true,
            ?Token·SelfLower => true,
            ?Token·Ident(_) => true,
            _ => false,
        }
    }

    /// Parse a pipe chain.
    λ parse_pipe_chain(Δ self, initial: !Expr) -> !ParseResult<Expr> {
        ≔ Δ operations = Vec·new();

        ⟳ self.consume_if(&Token·Pipe) {
            ≔ op = self.parse_pipe_op()?;
            operations.push(op);
        }

        Ok(Expr·Pipe {
            expr: Box·new(initial),
            operations,
        })
    }

    /// Parse a pipe operation.
    λ parse_pipe_op(Δ self) -> !ParseResult<PipeOp> {
        ⌥ self.current_token() {
            Token·Tau => {
                self.advance();
                self.expect(Token·LBrace)?;
                // Check ∀ closure syntax: {x => ...} or {(x)| ...}
                ≔ body = ⎇ self.is_closure_start() {
                    ≔ params = self.parse_closure_params()?;
                    // Accept either => or | as closure arrow
                    ⎇ !self.consume_if(&Token·FatArrow) {
                        self.expect(Token·Pipe)?;
                    }
                    // Parse optional ⤺ type
                    ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
                        ?self.parse_type()?
                    } ⎉ {
                        null
                    };
                    // Parse body as block contents (handles both single expr and multi-stmt)
                    ≔ block = self.parse_block_contents()?;
                    ≔ expr = Expr·Block(block);
                    Expr·Closure { params, return_type, body: Box·new(expr) }
                } ⎉ {
                    self.parse_expr()?
                };
                self.expect(Token·RBrace)?;
                Ok(PipeOp·Transform(Box·new(body)))
            }
            Token·Phi => {
                self.advance();
                self.expect(Token·LBrace)?;
                // Check ∀ closure syntax: {x => ...} or {(x)| ...}
                ≔ body = ⎇ self.is_closure_start() {
                    ≔ params = self.parse_closure_params()?;
                    // Accept either => or | as closure arrow
                    ⎇ !self.consume_if(&Token·FatArrow) {
                        self.expect(Token·Pipe)?;
                    }
                    // Parse optional ⤺ type
                    ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
                        ?self.parse_type()?
                    } ⎉ {
                        null
                    };
                    // Parse body as block contents (handles both single expr and multi-stmt)
                    ≔ block = self.parse_block_contents()?;
                    ≔ expr = Expr·Block(block);
                    Expr·Closure { params, return_type, body: Box·new(expr) }
                } ⎉ {
                    self.parse_expr()?
                };
                self.expect(Token·RBrace)?;
                Ok(PipeOp·Filter(Box·new(body)))
            }
            Token·Sigma => {
                self.advance();
                ≔ field = ⎇ self.consume_if(&Token·Dot) {
                    self.parse_ident()?
                } ⎉ {
                    null
                };
                Ok(PipeOp·Sort(field))
            }
            Token·Rho => {
                self.advance();
                ⌥ self.current_token() {
                    Token·Plus => { self.advance(); Ok(PipeOp·ReduceSum) }
                    Token·Star => { self.advance(); Ok(PipeOp·ReduceProd) }
                    Token·PlusPlus => { self.advance(); Ok(PipeOp·ReduceConcat) }
                    Token·Amp => { self.advance(); Ok(PipeOp·ReduceAll) }
                    Token·LBrace => {
                        self.advance();
                        // Check ∀ closure syntax: {x => ...} or {(acc, x) => ...}
                        ≔ body = ⎇ self.is_closure_start() {
                            ≔ params = self.parse_closure_params()?;
                            // Accept either => or | as closure arrow
                            ⎇ !self.consume_if(&Token·FatArrow) {
                                self.expect(Token·Pipe)?;
                            }
                            // Parse optional ⤺ type
                            ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
                                ?self.parse_type()?
                            } ⎉ {
                                null
                            };
                            // Parse body as block contents (handles both single expr and multi-stmt)
                            ≔ block = self.parse_block_contents()?;
                            ≔ expr = Expr·Block(block);
                            Expr·Closure { params, return_type, body: Box·new(expr) }
                        } ⎉ {
                            self.parse_expr()?
                        };
                        self.expect(Token·RBrace)?;
                        Ok(PipeOp·Reduce(Box·new(body)))
                    }
                    _ => Err(ParseError·custom("expected reduction variant after ρ")),
                }
            }
            Token·Alpha => { self.advance(); Ok(PipeOp·First) }
            Token·Omega => { self.advance(); Ok(PipeOp·Last) }
            Token·Pi => { self.advance(); Ok(PipeOp·ReduceProd) }
            Token·Mu => {
                self.advance();
                // Check ∀ method call: |μ(args...) vs simple |μ
                ⎇ self.check(&Token·LParen) {
                    self.advance();
                    ≔ args = self.parse_expr_list()?;
                    self.expect(Token·RParen)?;
                    // μ with args is "mean" operation ∈ tensor context
                    Ok(PipeOp·Method { name: Ident·new("mean".to_string(), Span·empty_at(0)), args })
                } ⎉ {
                    Ok(PipeOp·Middle)
                }
            }
            Token·Chi => { self.advance(); Ok(PipeOp·Choice) }
            Token·Nu => {
                self.advance();
                ⎇ self.check(&Token·LBrace) {
                    self.advance();
                    ≔ index = self.parse_expr()?;
                    self.expect(Token·RBrace)?;
                    Ok(PipeOp·Nth(Box·new(index)))
                } ⎉ {
                    // Default to first element when no index specified
                    Ok(PipeOp·First)
                }
            }
            Token·Xi => { self.advance(); Ok(PipeOp·Next) }
            Token·Parallel => {
                self.advance();
                ≔ inner = self.parse_pipe_op()?;
                Ok(PipeOp·Parallel(Box·new(inner)))
            }
            Token·Gpu => {
                self.advance();
                ≔ inner = self.parse_pipe_op()?;
                Ok(PipeOp·Gpu(Box·new(inner)))
            }
            Token·Await | Token·Hourglass => {
                self.advance();
                Ok(PipeOp·Await)
            }
            Token·GradeUp => { self.advance(); Ok(PipeOp·SortAsc) }
            Token·GradeDown => { self.advance(); Ok(PipeOp·SortDesc) }
            Token·Rotate => { self.advance(); Ok(PipeOp·Reverse) }
            Token·ElementSmallVerticalBar => { self.advance(); Ok(PipeOp·Flatten) }
            Token·Union => { self.advance(); Ok(PipeOp·Unique) }
            Token·Iota => { self.advance(); Ok(PipeOp·Enumerate) }
            Token·Nabla => {
                self.advance();
                // Optional argument: |∇ or |∇{var}
                ≔ var = ⎇ self.check(&Token·LBrace) {
                    self.advance();
                    ≔ expr = self.parse_expr()?;
                    self.expect(Token·RBrace)?;
                    Box·new(expr)
                } ⎉ {
                    // No specific variable - gradient with respect to all tracked inputs
                    Box·new(Expr·Tuple([]))  // Empty tuple as placeholder
                };
                Ok(PipeOp·Gradient(var))
            }
            Token·Interrobang => {
                self.advance();
                ≔ mapper = ⎇ self.check(&Token·LBrace) {
                    self.advance();
                    ≔ expr = self.parse_expr()?;
                    self.expect(Token·RBrace)?;
                    Box·new(expr)
                } ⎉ {
                    null
                };
                Ok(PipeOp·TryMap(mapper))
            }
            Token·Ident(_) => {
                ≔ name = self.parse_ident()?;
                // Check ∀ macro invocation: |macro!{...}, |macro!(...), |macro![...]
                ≔ is_macro = self.consume_if(&Token·Bang);
                ⎇ is_macro && (self.check(&Token·LBrace) || self.check(&Token·LParen) || self.check(&Token·LBracket)) {
                    // Parse macro tokens
                    ≔ tokens = self.parse_macro_tokens()?;
                    ⤺ Ok(PipeOp·Macro { name, tokens });
                }
                // Consume optional evidentiality marker on method name: |estimate~()
                ⎇ !is_macro {
                    self.consume_if(&Token·Tilde) ||
                        self.consume_if(&Token·Question) || self.consume_if(&Token·Lozenge);
                }
                // Handle |method{...} syntax (closure body)
                // Don't consume { when ∈ condition context (e.g., ∀ x ∈ iter|method {})
                ⎇ self.check(&Token·LBrace) && !self.is_in_condition() {
                    self.advance();
                    // Check ∀ closure syntax: {x => ...} or {(x)| ...}
                    ≔ body = ⎇ self.is_closure_start() {
                        ≔ params = self.parse_closure_params()?;
                        // Accept either => or | as closure arrow
                        ⎇ !self.consume_if(&Token·FatArrow) {
                            self.expect(Token·Pipe)?;
                        }
                        // Parse optional ⤺ type
                        ≔ return_type = ⎇ self.consume_if(&Token·Arrow) {
                            ?self.parse_type()?
                        } ⎉ {
                            null
                        };
                        // Parse body as block contents (handles both single expr and multi-stmt)
                        ≔ block = self.parse_block_contents()?;
                        ≔ expr = Expr·Block(block);
                        Expr·Closure { params, return_type, body: Box·new(expr) }
                    } ⎉ {
                        self.parse_expr()?
                    };
                    self.expect(Token·RBrace)?;
                    // Return as Method with closure as single arg
                    Ok(PipeOp·Method { name, args: [body] })
                } ⎉ ⎇ self.check(&Token·ColonColon) {
                    // Either turbofish: |collect·<Vec<_>>() or qualified: |Tensor·from_slice
                    self.advance(); // consume ·
                    ⎇ self.check(&Token·Lt) {
                        // Turbofish: |collect·<Vec<_>>()
                        self.advance();
                        ≔ _type_args = self.parse_type_list()?;
                        self.expect_gt()?;
                        // Parse args ⎇ present (optional - no args means pipe value only)
                        ≔ args = ⎇ self.check(&Token·LParen) {
                            self.advance();
                            ≔ args = self.parse_expr_list()?;
                            self.expect(Token·RParen)?;
                            args
                        } ⎉ {
                            []
                        };
                        Ok(PipeOp·Method { name, args })
                    } ⎉ {
                        // Qualified path: |Type·method or |Type·method(args)
                        ≔ method_name = self.parse_ident()?;
                        ≔ args = ⎇ self.check(&Token·LParen) {
                            self.advance();
                            ≔ args = self.parse_expr_list()?;
                            self.expect(Token·RParen)?;
                            args
                        } ⎉ {
                            []
                        };
                        // Use the method_name ∀ the call (name was Type, method_name is the actual method)
                        Ok(PipeOp·Method { name: method_name, args })
                    }
                } ⎉ ⎇ self.check(&Token·LParen) {
                    self.advance();
                    ≔ args = self.parse_expr_list()?;
                    self.expect(Token·RParen)?;
                    Ok(PipeOp·Method { name, args })
                } ⎉ {
                    Ok(PipeOp·Method { name, args: [] })
                }
            }
            // Reference ∈ pipe: |&expr - call the referenced function/method
            Token·Amp => {
                ≔ span = self.current_span();
                self.advance();
                // Parse the expression being referenced (postfix handles field access)
                ≔ inner = self.parse_postfix_expr()?;
                // Wrap ∈ Ref expression
                ≔ ref_expr = Expr·Ref {
                    mutable: false,
                    expr: Box·new(inner),
                };
                Ok(PipeOp·Call(Box·new(ref_expr)))
            }
            // Self method call: |self.method()
            Token·SelfLower => {
                ≔ expr = self.parse_postfix_expr()?;
                Ok(PipeOp·Call(Box·new(expr)))
            }
            // Pipe into match: |⌥ { arms }
            Token·Match => {
                self.advance();
                self.expect(Token·LBrace)?;
                // Parse ⌥ arms inline
                ≔ Δ arms = Vec·new();
                ⟳ !self.check(&Token·RBrace) {
                    ⟳ self.check(&Token·Hash) || self.check(&Token·At) {
                        self.parse_outer_attribute()?;
                    }
                    ≔ pattern = self.parse_pattern()?;
                    ≔ guard = ⎇ self.consume_if(&Token·If) {
                        self.in_condition = true;
                        ≔ g = self.parse_expr()?;
                        self.in_condition = false;
                        Box·new(g)
                    } ⎉ {
                        null
                    };
                    self.expect(Token·FatArrow)?;
                    ≔ body = self.parse_expr()?;
                    arms.push(MatchArm { pattern, guard, body });
                    self.consume_if(&Token·Comma);
                }
                self.expect(Token·RBrace)?;
                // Represent as a call to a ⌥ expression
                // Create a simple "_" path ∀ the placeholder expression
                ≔ placeholder_path = TypePath {
                    segments: [PathSegment {
                        ident: Ident·new("_".to_string(), Span·empty_at(0)),
                        generics: null,
                    }],
                };
                ≔ match_expr = Expr·Match {
                    expr: Box·new(Expr·Path(placeholder_path)),
                    arms,
                };
                Ok(PipeOp·Call(Box·new(match_expr)))
            }
            t => Err(ParseError·unexpected("pipe operation", t?, self.current_span())),
        }
    }

    // ========================================
    // Pattern Parsing
    // ========================================

    /// Parse a pattern.
    λ parse_pattern(Δ self) -> !ParseResult<Pattern> {
        self.parse_pattern_or()
    }

    /// Parse or-pattern: p1 | p2.
    λ parse_pattern_or(Δ self) -> !ParseResult<Pattern> {
        ≔ Δ patterns: ![Pattern] = [self.parse_pattern_primary()?];

        ⟳ self.consume_if(&Token·Pipe) {
            patterns.push(self.parse_pattern_primary()?);
        }

        ⎇ patterns.len() == 1 {
            Ok(patterns.pop()!)
        } ⎉ {
            Ok(Pattern·Or(patterns))
        }
    }

    /// Parse primary pattern.
    λ parse_pattern_primary(Δ self) -> !ParseResult<Pattern> {
        ⌥ self.current_token() {
            Token·Underscore => {
                self.advance();
                Ok(Pattern·Wildcard)
            }
            Token·DotDot => {
                self.advance();
                Ok(Pattern·Rest)
            }
            // Evidential prefix pattern: ?(pattern) matches Some/uncertain values
            Token·Question => {
                self.advance();
                ≔ inner = self.parse_pattern_primary()?;
                Ok(Pattern·Evidential {
                    pattern: Box·new(inner),
                    evidentiality: Evidentiality·Uncertain,
                })
            }
            // Known evidentiality: !(pattern)
            Token·Bang => {
                self.advance();
                ≔ inner = self.parse_pattern_primary()?;
                Ok(Pattern·Evidential {
                    pattern: Box·new(inner),
                    evidentiality: Evidentiality·Known,
                })
            }
            Token·Mut => {
                self.advance();
                // Δ ref x or Δ x
                ≔ by_ref = self.consume_if(&Token·Ref);
                ≔ name = self.parse_ident()?;
                ≔ evidentiality = self.parse_evidentiality_opt();
                Ok(Pattern·Ident { mutable: true, by_ref, name, evidentiality })
            }
            Token·Ref => {
                self.advance();
                // ref Δ x or ref x
                ≔ mutable = self.consume_if(&Token·Mut);
                ≔ name = self.parse_ident()?;
                ≔ evidentiality = self.parse_evidentiality_opt();
                Ok(Pattern·Ident { mutable, by_ref: true, name, evidentiality })
            }
            // Reference pattern: &x or &Δ x
            Token·Amp => {
                self.advance();
                ≔ mutable = self.consume_if(&Token·Mut);
                ≔ inner = self.parse_pattern_primary()?;
                Ok(Pattern·Ref {
                    mutable,
                    pattern: Box·new(inner),
                })
            }
            // Keywords that can be used as identifiers ∈ patterns
            Token·Ident(_) | Token·SelfUpper | Token·Derive | Token·Body | Token·Header | Token·Naked
                | Token·Gpu | Token·Asm | Token·Simd | Token·Send | Token·Recv
                | Token·Close | Token·Retry | Token·Http | Token·Https
                | Token·On | Token·Ws | Token·Wss | Token·Grpc | Token·Kafka | Token·Amqp
                | Token·Packed | Token·Repr | Token·Align => {
                ≔ ident = self.parse_ident()?;

                // Build path segments (handle · ∀ qualified paths like Token·Fn)
                ≔ Δ segments: ![PathSegment] = [PathSegment { ident, args: null }];
                ⟳ self.consume_if(&Token·ColonColon) {
                    ≔ next_ident = self.parse_ident()?;
                    segments.push(PathSegment { ident: next_ident, args: null });
                }
                ≔ path = TypePath { segments: segments.clone() };

                // Check ∀ Σ pattern
                ⎇ self.check(&Token·LBrace) {
                    self.advance();
                    ≔ Δ fields = Vec·new();
                    ≔ Δ rest = false;
                    ⟳ !self.check(&Token·RBrace) {
                        ⎇ self.consume_if(&Token·DotDot) {
                            rest = true;
                            ⊗;
                        }
                        ≔ name = self.parse_ident()?;
                        ≔ pattern = ⎇ self.consume_if(&Token·Colon) {
                            self.parse_pattern()?
                        } ⎉ {
                            null
                        };
                        fields.push(FieldPattern { name, pattern });
                        ⎇ !self.consume_if(&Token·Comma) {
                            ⊗;
                        }
                    }
                    self.expect(Token·RBrace)?;
                    Ok(Pattern·Struct { path, fields, rest })
                }
                // Check ∀ tuple Σ pattern
                ⎉ ⎇ self.check(&Token·LParen) {
                    self.advance();
                    ≔ Δ fields = Vec·new();
                    ⟳ !self.check(&Token·RParen) {
                        fields.push(self.parse_pattern()?);
                        ⎇ !self.consume_if(&Token·Comma) {
                            ⊗;
                        }
                    }
                    self.expect(Token·RParen)?;
                    Ok(Pattern·TupleStruct { path, fields })
                }
                // Single segment path without { or ( -> simple identifier pattern
                ⎉ ⎇ segments.len() == 1 {
                    ≔ evidentiality = self.parse_evidentiality_opt();
                    Ok(Pattern·Ident { mutable: false, by_ref: false, name: segments[0].ident.clone(), evidentiality })
                }
                // Multi-segment path (like Token·Fn) -> TupleStruct with no fields (unit variant)
                ⎉ {
                    Ok(Pattern·TupleStruct { path, fields: [] })
                }
            }
            Token·LParen => {
                self.advance();
                ⎇ self.check(&Token·RParen) {
                    self.advance();
                    ⤺ Ok(Pattern·Tuple(Vec·new()));
                }
                // Use parse_pattern_primary to avoid consuming | as OR separator
                // This prevents closure arrow | from being parsed as OR ∈ tuple params
                ≔ Δ patterns: ![Pattern] = [self.parse_pattern_primary()?];
                ⟳ self.consume_if(&Token·Comma) {
                    ⎇ self.check(&Token·RParen) {
                        ⊗;
                    }
                    patterns.push(self.parse_pattern_primary()?);
                }
                self.expect(Token·RParen)?;
                ⎇ patterns.len() == 1 {
                    Ok(patterns.pop()!)
                } ⎉ {
                    Ok(Pattern·Tuple(patterns))
                }
            }
            Token·LBracket => {
                self.advance();
                ≔ Δ patterns = Vec·new();
                ⟳ !self.check(&Token·RBracket) {
                    patterns.push(self.parse_pattern()?);
                    ⎇ !self.consume_if(&Token·Comma) {
                        ⊗;
                    }
                }
                self.expect(Token·RBracket)?;
                Ok(Pattern·Slice(patterns))
            }
            // Literals - check ∀ range patterns after
            Token·IntLit(s) => {
                self.advance();
                ≔ lit = Pattern·Literal(Literal·Int {
                    value: s.clone(),
                    base: NumBase·Decimal,
                    suffix: null,
                });
                // Check ∀ range pattern: lit..end or lit..=end
                ⎇ self.check(&Token·DotDot) || self.check(&Token·DotDotEq) {
                    ≔ inclusive = self.consume_if(&Token·DotDotEq);
                    ⎇ !inclusive {
                        self.advance(); // consume ..
                    }
                    // Parse end of range ⎇ present
                    ≔ end = ⌥ self.current_token() {
                        Token·IntLit(_) | Token·CharLit(_) => {
                            ≔ end_pat = self.parse_pattern_primary()?;
                            ?Box·new(end_pat)
                        },
                        _ => null,
                    };
                    Ok(Pattern·Range {
                        start: ?Box·new(lit),
                        end,
                        inclusive,
                    })
                } ⎉ {
                    Ok(lit)
                }
            }
            Token·FloatLit(s) => {
                self.advance();
                Ok(Pattern·Literal(Literal·Float { value: s.clone(), suffix: null }))
            }
            Token·StringLit(s) => {
                self.advance();
                Ok(Pattern·Literal(Literal·String(s.clone())))
            }
            Token·CharLit(c) => {
                self.advance();
                ≔ lit = Pattern·Literal(Literal·Char(c.clone()));
                // Check ∀ range pattern: lit..end or lit..=end
                ⎇ self.check(&Token·DotDot) || self.check(&Token·DotDotEq) {
                    ≔ inclusive = self.consume_if(&Token·DotDotEq);
                    ⎇ !inclusive {
                        self.advance(); // consume ..
                    }
                    // Parse end of range ⎇ present
                    ≔ end = ⌥ self.current_token() {
                        Token·IntLit(_) | Token·CharLit(_) => {
                            ≔ end_pat = self.parse_pattern_primary()?;
                            ?Box·new(end_pat)
                        },
                        _ => null,
                    };
                    Ok(Pattern·Range {
                        start: ?Box·new(lit),
                        end,
                        inclusive,
                    })
                } ⎉ {
                    Ok(lit)
                }
            }
            Token·True => {
                self.advance();
                Ok(Pattern·Literal(Literal·Bool(true)))
            }
            Token·False => {
                self.advance();
                Ok(Pattern·Literal(Literal·Bool(false)))
            }
            Token·Null => {
                self.advance();
                Ok(Pattern·Literal(Literal·Null))
            }
            // Keywords that can be used as identifiers ∈ pattern context
            Token·Body | Token·Header | Token·Http | Token·Https | Token·Retry |
            Token·Send | Token·Recv | Token·Close | Token·On => {
                ≔ span = self.current_span();
                ≔ name = ⌥ self.current_token() {
                    Token·Body => "body",
                    Token·Header => "header",
                    Token·Http => "http",
                    Token·Https => "https",
                    Token·Retry => "retry",
                    Token·Send => "send",
                    Token·Recv => "recv",
                    Token·Close => "close",
                    Token·On => "on",
                    _ => "unknown",
                };
                self.advance();
                ≔ evidentiality = self.parse_evidentiality_opt();
                Ok(Pattern·Ident {
                    mutable: false,
                    by_ref: false,
                    name: Ident·new(name.to_string(), span),
                    evidentiality,
                })
            }
            t => Err(ParseError·unexpected("pattern", t?, self.current_span())),
        }
    }

    // ========================================
    // Helper Parsing Methods
    // ========================================

    /// Parse an identifier.
    λ parse_ident(Δ self) -> !ParseResult<Ident> {
        ≔ span = self.current_span();
        ⌥ self.current_token().cloned() {
            Token·Ident(name) => {
                self.advance();
                Ok(Ident·new(name, span))
            }
            Token·SelfLower => {
                self.advance();
                Ok(Ident·new("self".to_string(), span))
            }
            Token·SelfUpper => {
                self.advance();
                Ok(Ident·new("Self".to_string(), span))
            }
            // Keywords that can also be used as identifiers ∈ certain contexts
            Token·Derive => {
                self.advance();
                Ok(Ident·new("derive".to_string(), span))
            }
            Token·Test => {
                self.advance();
                Ok(Ident·new("test".to_string(), span))
            }
            Token·Default => {
                self.advance();
                Ok(Ident·new("default".to_string(), span))
            }
            // Path keywords that can be used as identifiers ∈ use/path contexts
            Token·Crate => {
                self.advance();
                Ok(Ident·new("crate".to_string(), span))
            }
            Token·Super => {
                self.advance();
                Ok(Ident·new("super".to_string(), span))
            }
            // Context-specific keywords that can be used as identifiers
            Token·Body => {
                self.advance();
                Ok(Ident·new("body".to_string(), span))
            }
            Token·Header => {
                self.advance();
                Ok(Ident·new("header".to_string(), span))
            }
            Token·Http | Token·Https => {
                ≔ name = ⎇ self.current_token() == &Token·Http { "http" } ⎉ { "https" };
                self.advance();
                Ok(Ident·new(name.to_string(), span))
            }
            Token·Retry => {
                self.advance();
                Ok(Ident·new("retry".to_string(), span))
            }
            Token·Send => {
                self.advance();
                Ok(Ident·new("send".to_string(), span))
            }
            Token·Recv => {
                self.advance();
                Ok(Ident·new("recv".to_string(), span))
            }
            Token·Close => {
                self.advance();
                Ok(Ident·new("close".to_string(), span))
            }
            Token·On => {
                self.advance();
                Ok(Ident·new("on".to_string(), span))
            }
            Token·Naked => {
                self.advance();
                Ok(Ident·new("naked".to_string(), span))
            }
            Token·Gpu => {
                self.advance();
                Ok(Ident·new("gpu".to_string(), span))
            }
            Token·Asm => {
                self.advance();
                Ok(Ident·new("asm".to_string(), span))
            }
            Token·Simd => {
                self.advance();
                Ok(Ident·new("simd".to_string(), span))
            }
            Token·Packed => {
                self.advance();
                Ok(Ident·new("packed".to_string(), span))
            }
            Token·Repr => {
                self.advance();
                Ok(Ident·new("repr".to_string(), span))
            }
            Token·Align => {
                self.advance();
                Ok(Ident·new("align".to_string(), span))
            }
            Token·Atomic => {
                self.advance();
                Ok(Ident·new("atomic".to_string(), span))
            }
            // Mathematical symbols that can be used as identifiers
            Token·Nabla => {
                self.advance();
                Ok(Ident·new("∇".to_string(), span))
            }
            Token·Sqrt => {
                self.advance();
                Ok(Ident·new("√".to_string(), span))
            }
            Token·Partial => {
                self.advance();
                Ok(Ident·new("∂".to_string(), span))
            }
            Token·Pi => {
                self.advance();
                Ok(Ident·new("Π".to_string(), span))
            }
            Token·Phi => {
                self.advance();
                Ok(Ident·new("φ".to_string(), span))
            }
            Token·Tau => {
                self.advance();
                Ok(Ident·new("τ".to_string(), span))
            }
            Token·Sigma => {
                self.advance();
                Ok(Ident·new("Σ".to_string(), span))
            }
            Token·Mu => {
                self.advance();
                Ok(Ident·new("μ".to_string(), span))
            }
            Token·Rho => {
                self.advance();
                Ok(Ident·new("ρ".to_string(), span))
            }
            // Contextual keywords that can be identifiers
            Token·Parallel => {
                self.advance();
                Ok(Ident·new("parallel".to_string(), span))
            }
            Token·Null => {
                self.advance();
                Ok(Ident·new("null".to_string(), span))
            }
            Token·Enum => {
                self.advance();
                Ok(Ident·new("enum".to_string(), span))
            }
            Token·Await => {
                self.advance();
                Ok(Ident·new("await".to_string(), span))
            }
            t => Err(ParseError·unexpected("identifier", t?, span)),
        }
    }

    /// Parse optional numeric type suffix (u8, u16, u32, u64, i8, i16, i32, i64, f32, f64, usize, isize).
    λ parse_numeric_suffix(Δ self) -> ?String {
        ⌥ self.current_token().cloned() {
            Token·Ident(s) => {
                ⎇ s == "u8" || s == "u16" || s == "u32" || s == "u64" ||
                   s == "i8" || s == "i16" || s == "i32" || s == "i64" ||
                   s == "f32" || s == "f64" || s == "usize" || s == "isize" {
                    self.advance();
                    ?s
                } ⎉ {
                    null
                }
            }
            _ => null,
        }
    }

    /// Parse optional evidentiality marker.
    λ parse_evidentiality_opt(Δ self) -> ?Evidentiality {
        ⌥ self.current_token() {
            Token·Bang => { self.advance(); Evidentiality·Known }
            Token·Question => { self.advance(); Evidentiality·Uncertain }
            Token·Tilde => { self.advance(); Evidentiality·Reported }
            Token·Interrobang => { self.advance(); Evidentiality·Paradox }
            Token·Lozenge => { self.advance(); Evidentiality·Prediction }
            _ => null,
        }
    }

    /// Parse an expression or named argument (name: expr).
    λ parse_expr_or_named_arg(Δ self) -> !ParseResult<Expr> {
        // Check ∀ named argument: ident: expr
        ⌥ self.current_token() {
            Token·Ident(_) => {
                ⌥ self.lexer.peek() {
                    ?(Token·Colon, _) => {
                        // Named argument - skip the name, just ⤺ the value
                        self.advance(); // consume ident
                        self.advance(); // consume :
                        self.parse_expr()
                    }
                    _ => self.parse_expr(),
                }
            }
            _ => self.parse_expr(),
        }
    }

    /// Parse a list of expressions.
    λ parse_expr_list(Δ self) -> !ParseResult<[Expr]> {
        ≔ Δ exprs = Vec·new();
        ⎇ !self.check(&Token·RParen) && !self.check(&Token·RBracket) {
            exprs.push(self.parse_expr_or_named_arg()?);
            ⟳ self.consume_if(&Token·Comma) {
                ⎇ self.check(&Token·RParen) || self.check(&Token·RBracket) {
                    ⊗;
                }
                exprs.push(self.parse_expr_or_named_arg()?);
            }
        }
        Ok(exprs)
    }

    /// Parse macro tokens: collects all tokens inside matching delimiters.
    λ parse_macro_tokens(Δ self) -> !ParseResult<String> {
        // Determine delimiter type
        ≔ open: Token;
        ≔ close: Token;
        ⌥ self.current_token() {
            Token·LParen => { open = Token·LParen; close = Token·RParen; }
            Token·LBracket => { open = Token·LBracket; close = Token·RBracket; }
            Token·LBrace => { open = Token·LBrace; close = Token·RBrace; }
            _ => {
                ⤺ Err(ParseError·custom("expected '(', '[', or '{' ∀ macro invocation"));
            }
        }

        self.advance(); // consume opening delimiter
        ≔ Δ tokens = String·new();
        ≔ Δ depth = 1;
        ≔ Δ suppress_space = false;  // Dont add space after . or · or open delimiters

        ⟳ depth > 0 && !self.is_eof() {
            ⎇ self.check(&open) {
                depth += 1;
            } ⎉ ⎇ self.check(&close) {
                depth -= 1;
                ⎇ depth == 0 {
                    ⊗;
                }
            }

            // Collect token text
            ⌥ self.current_token() {
                Token·Ident(s) => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str(s.as_str());
                    suppress_space = false;
                }
                Token·IntLit(s) => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str(s.as_str());
                    suppress_space = false;
                }
                Token·FloatLit(s) => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str(s.as_str());
                    suppress_space = false;
                }
                Token·StringLit(s) => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("\"");
                    // CG-097: Re-escape special characters when reconstructing string literals
                    // The lexer already processed escapes, so we need to re-escape ∀ output
                    ∀ c ∈ s.chars() {
                        ⌥ c {
                            '"' => tokens.push_str("\\\""),
                            '\\' => tokens.push_str("\\\\"),
                            '\n' => tokens.push_str("\\n"),
                            '\r' => tokens.push_str("\\r"),
                            '\t' => tokens.push_str("\\t"),
                            _ => tokens.push(c),
                        }
                    }
                    tokens.push_str("\"");
                }
                Token·CharLit(c) => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("'");
                    tokens.push(c);
                    tokens.push_str("'");
                    suppress_space = false;
                }
                Token·Comma => { tokens.push_str(", "); suppress_space = false; }
                Token·Colon => { tokens.push_str(": "); suppress_space = false; }
                Token·Plus => { tokens.push_str(" + "); suppress_space = false; }
                Token·Minus => { tokens.push_str(" - "); suppress_space = false; }
                Token·Star => { tokens.push_str(" * "); suppress_space = false; }
                Token·Slash => { tokens.push_str(" / "); suppress_space = false; }
                Token·Eq => { tokens.push_str(" = "); suppress_space = false; }
                Token·LParen => { tokens.push_str("("); suppress_space = true; }
                Token·RParen => { tokens.push_str(")"); suppress_space = false; }
                Token·LBracket => { tokens.push_str("["); suppress_space = true; }
                Token·RBracket => { tokens.push_str("]"); suppress_space = false; }
                Token·LBrace => { tokens.push_str("{"); suppress_space = true; }
                Token·RBrace => { tokens.push_str("}"); suppress_space = false; }
                Token·Dot => { tokens.push_str("."); suppress_space = true; }
                Token·Bang => { tokens.push_str("!"); suppress_space = false; }
                Token·Question => { tokens.push_str("?"); suppress_space = false; }
                Token·Lt => { tokens.push_str(" < "); suppress_space = false; }
                Token·Gt => { tokens.push_str(" > "); suppress_space = false; }
                Token·LtEq => { tokens.push_str(" <= "); suppress_space = false; }
                Token·GtEq => { tokens.push_str(" >= "); suppress_space = false; }
                Token·EqEq => { tokens.push_str(" == "); suppress_space = false; }
                Token·NotEq => { tokens.push_str(" != "); suppress_space = false; }
                Token·Amp => { tokens.push_str("&"); suppress_space = true; }
                Token·Pipe => { tokens.push_str("|"); suppress_space = false; }
                Token·AndAnd => { tokens.push_str(" && "); suppress_space = false; }
                Token·OrOr => { tokens.push_str(" || "); suppress_space = false; }
                Token·ColonColon => { tokens.push_str("·"); suppress_space = true; }
                Token·Semi => { tokens.push_str("; "); suppress_space = false; }
                Token·Arrow => { tokens.push_str(" -> "); suppress_space = false; }
                Token·FatArrow => { tokens.push_str(" => "); suppress_space = false; }
                Token·SelfLower => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("self");
                    suppress_space = false;
                }
                Token·SelfUpper => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("Self");
                    suppress_space = false;
                }
                Token·Percent => { tokens.push_str(" % "); suppress_space = false; }
                Token·Caret => { tokens.push_str(" ^ "); suppress_space = false; }
                Token·Tilde => { tokens.push_str("~"); suppress_space = true; }
                Token·At => { tokens.push_str("@"); suppress_space = true; }
                Token·Hash => { tokens.push_str("#"); suppress_space = true; }
                Token·Dollar => { tokens.push_str("$"); suppress_space = true; }
                Token·True => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("true");
                    suppress_space = false;
                }
                Token·False => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("false");
                    suppress_space = false;
                }
                Token·Null => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("null");
                    suppress_space = false;
                }
                Token·As => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("as");
                    suppress_space = false;
                }
                // CG-069: Handle crate keyword ∈ macro arguments
                Token·Crate => {
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("crate");
                    suppress_space = false;
                }
                _ => {
                    // For other tokens, output token debug representation
                    ⎇ !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("/* unknown token */");
                    suppress_space = false;
                }
            }
            self.advance();
        }

        self.expect(close)?;
        Ok(tokens)
    }
}

// ============================================
// Operator Precedence
// ============================================

/// Get binding power ∀ infix operators.
λ infix_binding_power(op: !BinOp) -> !(u8, u8) {
    ⌥ op {
        BinOp·Or => (1, 2),
        BinOp·And => (3, 4),
        BinOp·Eq | BinOp·Ne | BinOp·Lt | BinOp·Le | BinOp·Gt | BinOp·Ge => (5, 6),
        BinOp·BitOr => (7, 8),
        BinOp·BitXor => (9, 10),
        BinOp·BitAnd => (11, 12),
        BinOp·Shl | BinOp·Shr => (13, 14),
        BinOp·Add | BinOp·Sub | BinOp·Concat => (15, 16),
        BinOp·Mul | BinOp·Div | BinOp·Rem | BinOp·MatMul => (17, 18),
        BinOp·Pow => (20, 19),  // Right associative
    }
}

// ============================================
// Tests
// ============================================

#[test]
λ test_parse_empty_file() {
    ≔ Δ parser = Parser·new("".to_string());
    ≔ file = parser.parse_file().unwrap();
    assert!(file.items.is_empty());
}

#[test]
λ test_parse_function() {
    ≔ Δ parser = Parser·new("λ main() {}".to_string());
    ≔ file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
λ test_parse_struct() {
    ≔ Δ parser = Parser·new("Σ Point { x: !i32, y: !i32 }".to_string());
    ≔ file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
λ test_parse_pipe_chain() {
    ≔ Δ parser = Parser·new("λ test() { data|τ{f}|φ{p}|σ }".to_string());
    ≔ file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
λ test_parse_evidentiality() {
    ≔ Δ parser = Parser·new("λ test() { ≔ x: !i32 = value!; }".to_string());
    ≔ file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
λ test_parse_morpheme() {
    ≔ Δ parser = Parser·new("λ test() { τ{x + 1} }".to_string());
    ≔ file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
λ test_parse_match() {
    ≔ source = r#"
        λ test() {
            ⌥ x {
                0 => "zero",
                n => "other",
            }
        }
    "#;
    ≔ Δ parser = Parser·new(source.to_string());
    ≔ file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
λ test_parse_trait() {
    ≔ source = r#"
        Θ Display {
            λ fmt(self) -> String;
        }
    "#;
    ≔ Δ parser = Parser·new(source.to_string());
    ≔ file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
λ test_parse_impl() {
    ≔ source = r#"
        ⊢ Display ∀ Point {
            λ fmt(self) -> String {
                f"({self.x}, {self.y})"
            }
        }
    "#;
    ≔ Δ parser = Parser·new(source.to_string());
    ≔ file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}
