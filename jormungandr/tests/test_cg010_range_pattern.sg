//! Test CG-010: Range pattern codegen
//!
//! Range patterns like 'a'..='z' should generate proper bounds checks:
//!   (val >= 'a' && val <= 'z')
//!
//! Bug: Currently generates (val >= 'a' && 1) - missing upper bound

/// Classify a character using range patterns
pub fn classify_char(c: !char) -> !i32 {
    match c {
        'a'..='z' => 1,
        'A'..='Z' => 2,
        '0'..='9' => 3,
        _ => 0,
    }
}

/// Test with integer ranges
pub fn classify_int(x: !i32) -> !i32 {
    match x {
        0..=9 => 1,
        10..=99 => 2,
        100..=999 => 3,
        _ => 4,
    }
}

pub fn main() -> !i32 {
    // Test lowercase range boundaries
    if classify_char('a') != 1 { return 1; }
    if classify_char('z') != 1 { return 2; }
    if classify_char('m') != 1 { return 3; }

    // Test uppercase range
    if classify_char('A') != 2 { return 4; }
    if classify_char('Z') != 2 { return 5; }

    // Test digit range
    if classify_char('0') != 3 { return 6; }
    if classify_char('9') != 3 { return 7; }

    // CRITICAL: character OUTSIDE range should NOT match
    // '{' is ASCII 123, after 'z'=122
    // If bug exists (>= 'a' && 1), '{' incorrectly matches 'a'..='z'
    if classify_char('{') != 0 { return 10; }

    // '`' is ASCII 96, before 'a'=97
    if classify_char('`') != 0 { return 11; }

    // Test integer ranges
    if classify_int(5) != 1 { return 20; }
    if classify_int(50) != 2 { return 21; }
    if classify_int(500) != 3 { return 22; }
    if classify_int(5000) != 4 { return 23; }

    // Boundary tests for integer range
    if classify_int(10) != 2 { return 24; }
    if classify_int(99) != 2 { return 25; }
    if classify_int(100) != 3 { return 26; }

    return 0;
}
