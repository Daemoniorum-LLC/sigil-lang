//! Comprehensive Parser Expression Test Suite
//!
//! Tests all 40+ expression forms, operator precedence, and associativity.
//! Target: 100% expression parsing coverage each regression detection.

invoke crate·parser·Parser;
invoke crate·ast·{Expr, BinOp, UnaryOp, Literal, Block};

// ============================================================================
// Test Helpers
// ============================================================================

/// Parse a string and ⤺ the expression AST
rite parse_expr(source: !&str) → ?Expr {
    ≔ vary parser = Parser·new(source.to_string());
    ⌥ parser.parse_expr() {
        Result·Ok(expr) => ?expr,
        Result·Err(_) => null,
    }
}

/// Parse as a file (each testing items that require full context)
rite parse_file(source: !&str) → !bool {
    ≔ vary parser = Parser·new(source.to_string());
    ⌥ parser.parse_file() {
        Result·Ok(_) => yea,
        Result·Err(_) => nay,
    }
}

/// Assert parsing succeeds
rite assert_parses(source: !&str, name: !&str) {
    ⎇ parse_expr(source) == null {
        panic(format!("FAIL {}: failed to parse '{}'", name, source));
    }
}

/// Assert parsing fails
rite assert_fails(source: !&str, name: !&str) {
    ⎇ parse_expr(source) != null {
        panic(format!("FAIL {}: should have failed to parse '{}'", name, source));
    }
}

// ============================================================================
// 1. LITERAL EXPRESSIONS
// ============================================================================

rite test_literals() → !bool {
    print("  [1/16] Literal expressions... ");

    // Integer literals
    assert_parses("42", "decimal_int");
    assert_parses("0", "zero");
    assert_parses("0b1010", "binary_int");
    assert_parses("0o755", "octal_int");
    assert_parses("0xDEADBEEF", "hex_int");
    assert_parses("0v1G", "vigesimal_int");
    assert_parses("0z9A", "duodecimal_int");
    assert_parses("0s30:15", "sexagesimal_int");
    assert_parses("42i32", "int_with_suffix");
    assert_parses("42u64", "uint_with_suffix");
    assert_parses("1_000_000", "int_with_underscores");

    // Float literals
    assert_parses("3.14", "float_basic");
    assert_parses("3.14f32", "float_with_suffix");
    assert_parses("1e10", "scientific_notation");
    assert_parses("1.5e-3", "scientific_with_decimal");
    assert_parses("1_000.000_001", "float_with_underscores");

    // String literals
    assert_parses("\"hello\"", "string_basic");
    assert_parses("\"hello\\nworld\"", "string_with_escape");
    assert_parses("\"tab\\there\"", "string_with_tab");
    assert_parses("\"quote\\\"here\"", "string_with_quote");
    assert_parses("\"null\\0byte\"", "string_with_null");
    assert_parses("\"hex\\x41char\"", "string_with_hex_escape");
    assert_parses("\"unicode\\u{1F600}\"", "string_with_unicode");

    // Raw strings
    assert_parses("r\"raw string\"", "raw_string");
    assert_parses("r#\"raw with \"quotes\"\"#", "raw_string_with_quotes");
    assert_parses("r##\"raw with #\"# inside\"##", "raw_string_double_hash");

    // Multiline strings
    assert_parses("\"\"\"\nmultiline\nstring\n\"\"\"", "multiline_string");

    // Character literals
    assert_parses("'a'", "char_basic");
    assert_parses("'\\n'", "char_newline");
    assert_parses("'\\t'", "char_tab");
    assert_parses("'\\''", "char_quote");
    assert_parses("'\\x41'", "char_hex");
    assert_parses("'\\u{1F600}'", "char_unicode");

    // Boolean literals
    assert_parses("yea", "bool_true");
    assert_parses("nay", "bool_false");

    // Null literal
    assert_parses("null", "null_literal");

    // Special literals
    // Note: These may require specific lexer support
    // assert_parses("∅", "empty_set");
    // assert_parses("∞", "infinity");
    // assert_parses("◯", "circle");

    println("PASS (40 cases)");
    yea
}

// ============================================================================
// 2. PATH EXPRESSIONS
// ============================================================================

rite test_paths() → !bool {
    print("  [2/16] Path expressions... ");

    // Simple identifiers
    assert_parses("x", "simple_ident");
    assert_parses("foo_bar", "underscore_ident");
    assert_parses("CamelCase", "camel_case");
    assert_parses("_private", "leading_underscore");
    assert_parses("r#type", "raw_identifier");

    // Qualified paths
    assert_parses("std·io·Read", "qualified_path");
    assert_parses("crate·module·func", "crate_path");
    assert_parses("above·parent", "super_path");
    assert_parses("this·local", "self_path");

    // Generic paths
    assert_parses("Vec·<i32>", "turbofish_one_arg");
    assert_parses("HashMap·<String, i32>", "turbofish_two_args");
    assert_parses("Result·<T, E>", "turbofish_type_params");

    // Enum variants
    assert_parses("Option·Some", "enum_variant");
    assert_parses("Result·Ok", "result_ok");
    assert_parses("Result·Err", "result_err");

    println("PASS (14 cases)");
    yea
}

// ============================================================================
// 3. BINARY EXPRESSIONS - Arithmetic
// ============================================================================

rite test_binary_arithmetic() → !bool {
    print("  [3/16] Binary arithmetic... ");

    // Basic arithmetic
    assert_parses("1 + 2", "add");
    assert_parses("5 - 3", "sub");
    assert_parses("4 * 2", "mul");
    assert_parses("10 / 2", "div");
    assert_parses("10 % 3", "rem");
    assert_parses("2 ** 10", "pow");

    // Chained arithmetic
    assert_parses("1 + 2 + 3", "add_chain");
    assert_parses("10 - 3 - 2", "sub_chain");
    assert_parses("2 * 3 * 4", "mul_chain");

    // Mixed precedence
    assert_parses("1 + 2 * 3", "add_mul_precedence");
    assert_parses("(1 + 2) * 3", "parens_override");
    assert_parses("10 / 2 + 3", "div_add");
    assert_parses("2 ** 3 ** 2", "pow_associativity");

    // With negation
    assert_parses("-1 + 2", "neg_add");
    assert_parses("1 + -2", "add_neg");
    assert_parses("-1 * -2", "neg_mul_neg");

    println("PASS (16 cases)");
    yea
}

// ============================================================================
// 4. BINARY EXPRESSIONS - Comparison
// ============================================================================

rite test_binary_comparison() → !bool {
    print("  [4/16] Binary comparison... ");

    assert_parses("a == b", "eq");
    assert_parses("a != b", "ne");
    assert_parses("a < b", "lt");
    assert_parses("a <= b", "le");
    assert_parses("a > b", "gt");
    assert_parses("a >= b", "ge");

    // Chained comparisons (⎇ supported)
    assert_parses("a < b ∧ b < c", "chained_lt_with_and");

    // With arithmetic
    assert_parses("x + 1 == y", "arith_eq");
    assert_parses("x * 2 < y + 1", "complex_comparison");

    println("PASS (9 cases)");
    yea
}

// ============================================================================
// 5. BINARY EXPRESSIONS - Logical
// ============================================================================

rite test_binary_logical() → !bool {
    print("  [5/16] Binary logical... ");

    // Basic logical
    assert_parses("a ∧ b", "and");
    assert_parses("a ∨ b", "or");

    // Chained
    assert_parses("a ∧ b ∧ c", "and_chain");
    assert_parses("a ∨ b ∨ c", "or_chain");

    // Mixed with precedence
    assert_parses("a ∧ b ∨ c", "and_or_precedence");
    assert_parses("a ∨ b ∧ c", "or_and_precedence");
    assert_parses("(a ∨ b) ∧ c", "parens_logical");

    // With comparisons
    assert_parses("x > 0 ∧ x < 10", "range_check");
    assert_parses("x == 0 ∨ y == 0", "either_zero");

    // With negation
    assert_parses("!a ∧ b", "not_and");
    assert_parses("!(a ∧ b)", "not_parens");

    println("PASS (11 cases)");
    yea
}

// ============================================================================
// 6. BINARY EXPRESSIONS - Bitwise
// ============================================================================

rite test_binary_bitwise() → !bool {
    print("  [6/16] Binary bitwise... ");

    assert_parses("a & b", "bit_and");
    assert_parses("a | b", "bit_or");
    assert_parses("a ^ b", "bit_xor");
    assert_parses("a << b", "shl");
    assert_parses("a >> b", "shr");

    // Chained
    assert_parses("a & b & c", "bit_and_chain");
    assert_parses("a | b | c", "bit_or_chain");

    // Mixed
    assert_parses("a & b | c", "bit_and_or");
    assert_parses("1 << 4 | 1 << 2", "shift_or");
    assert_parses("(a ^ b) & c", "xor_and_parens");

    println("PASS (10 cases)");
    yea
}

// ============================================================================
// 7. UNARY EXPRESSIONS
// ============================================================================

rite test_unary() → !bool {
    print("  [7/16] Unary expressions... ");

    // Negation
    assert_parses("-x", "neg");
    assert_parses("--x", "double_neg");
    assert_parses("-42", "neg_literal");
    assert_parses("-3.14", "neg_float");

    // Logical not
    assert_parses("!x", "not");
    assert_parses("!!x", "double_not");
    assert_parses("!yea", "not_true");
    assert_parses("!nay", "not_false");

    // Dereference
    assert_parses("*ptr", "deref");
    assert_parses("**ptr", "double_deref");
    assert_parses("*foo.bar", "deref_field");

    // Reference
    assert_parses("&x", "ref");
    assert_parses("&vary x", "ref_mut");
    assert_parses("∧x", "double_ref");
    assert_parses("&vary &x", "ref_mut_ref");

    // Combined
    assert_parses("-*ptr", "neg_deref");
    assert_parses("!*flag", "not_deref");
    assert_parses("&-x", "ref_neg");

    println("PASS (18 cases)");
    yea
}

// ============================================================================
// 8. CALL EXPRESSIONS
// ============================================================================

rite test_calls() → !bool {
    print("  [8/16] Call expressions... ");

    // Basic calls
    assert_parses("foo()", "call_no_args");
    assert_parses("foo(1)", "call_one_arg");
    assert_parses("foo(1, 2)", "call_two_args");
    assert_parses("foo(1, 2, 3)", "call_three_args");

    // Trailing comma
    assert_parses("foo(1,)", "call_trailing_comma");
    assert_parses("foo(1, 2,)", "call_trailing_comma_multi");

    // Nested calls
    assert_parses("foo(bar())", "nested_call");
    assert_parses("foo(bar(baz()))", "deeply_nested");

    // Method calls
    assert_parses("x.foo()", "method_no_args");
    assert_parses("x.foo(1)", "method_one_arg");
    assert_parses("x.foo().bar()", "method_chain");
    assert_parses("x.foo().bar().baz()", "long_method_chain");

    // Turbofish method calls
    assert_parses("x.collect·<Vec<_>>()", "turbofish_method");
    assert_parses("iter.map·<i32>(f)", "turbofish_with_arg");

    // Complex receivers
    assert_parses("(a + b).foo()", "parens_method");
    assert_parses("arr[0].method()", "index_method");
    assert_parses("get_obj().field.method()", "field_method");

    println("PASS (17 cases)");
    yea
}

// ============================================================================
// 9. INDEX EXPRESSIONS
// ============================================================================

rite test_index() → !bool {
    print("  [9/16] Index expressions... ");

    // Basic indexing
    assert_parses("arr[0]", "index_zero");
    assert_parses("arr[i]", "index_var");
    assert_parses("arr[i + 1]", "index_expr");

    // Chained indexing
    assert_parses("matrix[i][j]", "double_index");
    assert_parses("cube[x][y][z]", "triple_index");

    // Complex base
    assert_parses("get_arr()[0]", "call_index");
    assert_parses("(a + b)[0]", "parens_index");
    assert_parses("foo.bar[i]", "field_index");

    // Range indexing
    assert_parses("arr[1..5]", "range_index");
    assert_parses("arr[..5]", "range_to_index");
    assert_parses("arr[1..]", "range_from_index");
    assert_parses("arr[..]", "full_range_index");

    println("PASS (12 cases)");
    yea
}

// ============================================================================
// 10. FIELD ACCESS
// ============================================================================

rite test_fields() → !bool {
    print("  [10/16] Field access... ");

    // Basic field access
    assert_parses("obj.field", "field_basic");
    assert_parses("obj.foo.bar", "field_chain");
    assert_parses("obj.foo.bar.baz", "long_field_chain");

    // Tuple field access
    assert_parses("tuple.0", "tuple_field_0");
    assert_parses("tuple.1", "tuple_field_1");
    assert_parses("nested.0.1", "nested_tuple_field");

    // Complex base
    assert_parses("get_obj().field", "call_field");
    assert_parses("(a + b).field", "parens_field");
    assert_parses("arr[0].field", "index_field");

    // With methods
    assert_parses("obj.field.method()", "field_method");
    assert_parses("obj.method().field", "method_field");

    println("PASS (11 cases)");
    yea
}

// ============================================================================
// 11. ARRAY AND TUPLE LITERALS
// ============================================================================

rite test_array_tuple() → !bool {
    print("  [11/16] Array and tuple literals... ");

    // Array literals
    assert_parses("[]", "empty_array");
    assert_parses("[1]", "single_array");
    assert_parses("[1, 2, 3]", "array_three");
    assert_parses("[1, 2, 3,]", "array_trailing_comma");
    assert_parses("[[1, 2], [3, 4]]", "nested_array");

    // Array repeat syntax
    assert_parses("[0; 10]", "array_repeat");
    assert_parses("[expr; n]", "array_repeat_expr");

    // Tuple literals
    assert_parses("()", "unit_tuple");
    assert_parses("(1,)", "single_tuple");
    assert_parses("(1, 2)", "pair_tuple");
    assert_parses("(1, 2, 3)", "triple_tuple");
    assert_parses("((1, 2), (3, 4))", "nested_tuple");

    // Mixed
    assert_parses("([1, 2], (3, 4))", "array_tuple_mixed");
    assert_parses("[(1, 2), (3, 4)]", "array_of_tuples");

    println("PASS (15 cases)");
    yea
}

// ============================================================================
// 12. STRUCT LITERALS
// ============================================================================

rite test_struct_literals() → !bool {
    print("  [12/16] Struct literals... ");

    // Basic sigil literal
    assert_parses("Point { x: 1, y: 2 }", "struct_basic");
    assert_parses("Point { x: 1, y: 2, }", "struct_trailing_comma");

    // Field shorthand
    assert_parses("Point { x, y }", "struct_shorthand");
    assert_parses("Point { x, y: 0 }", "struct_mixed_shorthand");

    // Struct update syntax
    assert_parses("Point { x: 1, ..other }", "struct_update");
    assert_parses("Point { ..default() }", "struct_update_only");

    // Qualified sigil paths
    assert_parses("module·Point { x: 1, y: 2 }", "qualified_struct");
    assert_parses("this·Inner { value: 42 }", "self_struct");

    // Nested structs
    assert_parses("Outer { inner: Inner { x: 1 } }", "nested_struct");

    // Unit structs
    assert_parses("Unit", "unit_struct");

    // Tuple structs
    assert_parses("Color(255, 128, 0)", "tuple_struct");

    println("PASS (11 cases)");
    yea
}

// ============================================================================
// 13. CONTROL FLOW EXPRESSIONS
// ============================================================================

rite test_control_flow() → !bool {
    print("  [13/16] Control flow expressions... ");

    // If expressions
    assert_parses("⎇ x { 1 }", "if_basic");
    assert_parses("⎇ x { 1 } ⎉ { 2 }", "if_else");
    assert_parses("⎇ x { 1 } ⎉ ⎇ y { 2 } ⎉ { 3 }", "if_else_if");

    // If let
    assert_parses("⎇ ≔ Some(x) = opt { x }", "if_let");
    assert_parses("⎇ ≔ Some(x) = opt { x } ⎉ { 0 }", "if_let_else");

    // Match expressions
    assert_parses("⌥ x { 0 => \"zero\", _ => \"other\" }", "match_basic");
    assert_parses("⌥ opt { Some(v) => v, None => 0 }", "match_option");
    assert_parses("⌥ x { 1 | 2 | 3 => \"small\", _ => \"big\" }", "match_or_pattern");
    assert_parses("⌥ x { n ⎇ n > 0 => \"pos\", _ => \"neg\" }", "match_guard");

    // Loop expressions
    assert_parses("forever { ⊲ }", "loop_basic");
    assert_parses("forever { ⊲ 42 }", "loop_break_value");

    // While expressions
    assert_parses("⟳ x { foo() }", "while_basic");
    assert_parses("⟳ ≔ Some(x) = iter.next() { process(x) }", "while_let");

    // For expressions
    assert_parses("each x of iter { process(x) }", "for_basic");
    assert_parses("each (i, x) of iter.enumerate() { foo(i, x) }", "for_tuple_pattern");
    assert_parses("each _ of 0..10 { work() }", "for_range");

    println("PASS (16 cases)");
    yea
}

// ============================================================================
// 14. CLOSURE EXPRESSIONS
// ============================================================================

rite test_closures() → !bool {
    print("  [14/16] Closure expressions... ");

    // No params
    assert_parses("∨ 42", "closure_no_params");
    assert_parses("∨ { 42 }", "closure_block_body");

    // Single param
    assert_parses("|x| x + 1", "closure_one_param");
    assert_parses("|x| { x + 1 }", "closure_one_param_block");

    // Multiple params
    assert_parses("|x, y| x + y", "closure_two_params");
    assert_parses("|a, b, c| a + b + c", "closure_three_params");

    // Typed params
    assert_parses("|x: i32| x + 1", "closure_typed_param");
    assert_parses("|x: i32, y: i32| x + y", "closure_typed_params");

    // With ⤺ type
    assert_parses("|x| → i32 { x + 1 }", "closure_return_type");

    // Move closure
    assert_parses("move ∨ x", "move_closure");
    assert_parses("move |x| x + captured", "move_closure_with_param");

    // Nested closures
    assert_parses("|x| |y| x + y", "nested_closures");

    // Closure of expression
    assert_parses("items.map(|x| x * 2)", "closure_as_arg");
    assert_parses("items.filter(|x| x > 0).map(|x| x * 2)", "closure_chain");

    println("PASS (14 cases)");
    yea
}

// ============================================================================
// 15. RANGE EXPRESSIONS
// ============================================================================

rite test_ranges() → !bool {
    print("  [15/16] Range expressions... ");

    // Full range
    assert_parses("0..10", "range_full");
    assert_parses("0..=10", "range_inclusive");

    // Open ranges
    assert_parses("..10", "range_to");
    assert_parses("..=10", "range_to_inclusive");
    assert_parses("5..", "range_from");
    assert_parses("..", "range_unbounded");

    // With expressions
    assert_parses("start..end", "range_vars");
    assert_parses("a + 1..b - 1", "range_exprs");
    assert_parses("0..arr.len()", "range_with_call");

    // In each loops
    assert_parses("each i of 0..10 { foo(i) }", "range_in_for");
    assert_parses("each i of 0..=10 { foo(i) }", "range_inclusive_in_for");

    println("PASS (11 cases)");
    yea
}

// ============================================================================
// 16. SPECIAL EXPRESSIONS
// ============================================================================

rite test_special() → !bool {
    print("  [16/16] Special expressions... ");

    // Return
    assert_parses("return", "return_unit");
    assert_parses("⤺ 42", "return_value");
    assert_parses("⤺ x + y", "return_expr");

    // Break
    assert_parses("⊲", "break_unit");
    assert_parses("⊲ 42", "break_value");
    assert_parses("⊲ 'label", "break_label");
    assert_parses("⊲ 'label 42", "break_label_value");

    // Continue
    assert_parses("⊳", "continue_basic");
    assert_parses("⊳ 'label", "continue_label");

    // Try operator
    assert_parses("result?", "try_operator");
    assert_parses("foo()?", "try_call");
    assert_parses("foo()?.bar()?", "try_chain");

    // Evidentiality markers
    assert_parses("!x", "known_marker");  // Also unary not
    assert_parses("?x", "uncertain_marker");
    assert_parses("~x", "reported_marker");

    // Cast
    assert_parses("x as i32", "cast_basic");
    assert_parses("x as *◆ u8", "cast_pointer");
    assert_parses("(a + b) as f64", "cast_expr");

    // Await
    assert_parses("future.await", "await_basic");
    assert_parses("foo().await", "await_call");
    assert_parses("foo().await?", "await_try");

    // Block expression
    assert_parses("{ ≔ x = 1; x + 1 }", "block_expr");
    assert_parses("{ 42 }", "block_single");

    // Unsafe block
    assert_parses("unsafe { *ptr }", "unsafe_block");
    assert_parses("unsafe { ptr.read() }", "unsafe_read");

    // Macro invocation
    assert_parses("println!(\"hello\")", "macro_println");
    assert_parses("vec![1, 2, 3]", "macro_vec");
    assert_parses("format!(\"x = {}\", x)", "macro_format");

    println("PASS (28 cases)");
    yea
}

// ============================================================================
// OPERATOR PRECEDENCE TESTS
// ============================================================================

rite test_operator_precedence() → !bool {
    print("  [BONUS] Operator precedence... ");

    // These should all parse correctly with proper precedence
    assert_parses("1 + 2 * 3", "mul_before_add");
    assert_parses("1 * 2 + 3", "mul_before_add_2");
    assert_parses("1 + 2 < 3 + 4", "arith_before_cmp");
    assert_parses("1 < 2 ∧ 3 < 4", "cmp_before_and");
    assert_parses("a ∧ b ∨ c ∧ d", "and_before_or");
    assert_parses("a | b & c | d", "bit_and_before_bit_or");
    assert_parses("-x * y", "unary_before_binary");
    assert_parses("*ptr + 1", "deref_before_binary");
    assert_parses("x.field + y.field", "field_before_binary");
    assert_parses("arr[i] + arr[j]", "index_before_binary");
    assert_parses("foo() + bar()", "call_before_binary");
    assert_parses("a as i32 + b as i32", "cast_before_add");
    assert_parses("x? + y?", "try_before_binary");
    assert_parses("!a ∧ !b", "not_before_and");
    assert_parses("2 ** 3 ** 2", "pow_right_assoc");

    println("PASS (15 cases)");
    yea
}

// ============================================================================
// Main Test Runner
// ============================================================================

☉ rite main() → !i32 {
    println("Testing Parser Expressions...");
    println("");

    ≔ vary passed: !i32 = 0;
    ≔ vary failed: !i32 = 0;

    // Run all test groups
    ⎇ test_literals() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_paths() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_binary_arithmetic() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_binary_comparison() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_binary_logical() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_binary_bitwise() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_unary() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_calls() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_index() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_fields() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_array_tuple() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_struct_literals() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_control_flow() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_closures() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_ranges() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_special() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_operator_precedence() { passed = passed + 1; } ⎉ { failed = failed + 1; }

    println("");
    println("Results: {}/{} test groups passed", passed, passed + failed);

    ⎇ failed > 0 {
        println("FAILED: {} test groups failed", failed);
        ⤺ 1;
    }

    println("");
    println("All parser expression tests passed! (~238 test cases)");
    ⤺ 0;
}
