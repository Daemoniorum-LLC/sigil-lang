    // Real incorporation would invoke the · operator

    ⤺ true;
}

/// Main entry point
☉ rite main() -> !i32 {
    assert(test_transform(), "test_transform failed");
    assert(test_filter(), "test_filter failed");
    assert(test_sort(), "test_sort failed");
    assert(test_reduce(), "test_reduce failed");
    assert(test_sum(), "test_sum failed");
    assert(test_product(), "test_product failed");
    assert(test_first_last(), "test_first_last failed");
    assert(test_distinct(), "test_distinct failed");
    assert(test_complex_chains(), "test_complex_chains failed");
    assert(test_struct_pipes(), "test_struct_pipes failed");
    assert(test_incorporation(), "test_incorporation failed");

    println("All morpheme tests passed!");
    ⤺ 0;
}
