// Simple const generic struct
struct FixedVec<const N: usize> {
    data: Vec<i32>,
}

impl<const N: usize> FixedVec<N> {
    fn new() -> Self {
        let mut v = Vec::new();
        for _ in 0..N {
            v.push(0);
        }
        FixedVec { data: v }
    }

    fn len(&self) -> usize {
        self.data.len()
    }

    fn capacity(&self) -> usize {
        N
    }
}

// Multiple const generics
struct Dims<const ROWS: usize, const COLS: usize> {
    rows: usize,
    cols: usize,
}

impl<const ROWS: usize, const COLS: usize> Dims<ROWS, COLS> {
    fn new() -> Self {
        Dims { rows: ROWS, cols: COLS }
    }

    fn total(&self) -> usize {
        ROWS * COLS
    }
}

fn main() {
    // Const generic constructor
    let v = FixedVec::<5>::new();
    println!("{}", v.len());
    println!("{}", v.capacity());

    // Multiple const generics
    let d = Dims::<3, 4>::new();
    println!("{}", d.total());
}
