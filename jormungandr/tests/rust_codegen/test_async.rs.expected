async fn fetch_data(url: String) -> Result<String, Error> {
    // Simulated async operation
    let response = http_get(url).await?;
    Ok(response)
}

async fn process_urls(urls: Vec<String>) -> Vec<String> {
    let mut results = Vec::new();
    for url in urls {
        let data = fetch_data(url).await;
        match data {
            Ok(s) => results.push(s),
            Err(_) => (),
        }
    }
    results
}

async fn parallel_fetch(urls: Vec<String>) -> Vec<Result<String, Error>> {
    let futures: Vec<_> = urls.iter().map(|url| fetch_data(url)).collect();
    join_all(futures).await
}

fn main() {
    // Would run in tokio runtime
    let urls = vec!["http://example.com".to_string()];
    // tokio::runtime::Runtime::new().unwrap().block_on(process_urls(urls));
