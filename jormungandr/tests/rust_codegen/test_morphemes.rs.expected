fn main() {
    // Basic map
    let numbers = [1, 2, 3, 4, 5];
    let doubled: Vec<_> = numbers.iter().map(|x| x * 2).collect();
    println!("{:?}", doubled);

    // Filter
    let evens: Vec<_> = numbers.iter().filter(|x| *x % 2 == 0).collect();
    println!("{:?}", evens);

    // Map + Filter + Collect
    let result: Vec<_> = numbers.iter().map(|x| x * 2).filter(|x| *x > 5).collect();
    println!("{:?}", result);

    // Sum reduction
    let total: i32 = numbers.iter().sum();
    println!("{}", total);

    // Product reduction
    let product: i32 = numbers.iter().product();
    println!("{}", product);

    // All/Any predicates
    let all_positive = numbers.iter().all(|x| *x > 0);
    let any_large = numbers.iter().any(|x| *x > 100);
    println!("{}", all_positive);
    println!("{}", any_large);

    // Count
    let count = numbers.iter().count();
    println!("{}", count);

    // First/Last
    let first = numbers.iter().next();
    let last = numbers.iter().last();
    println!("{:?}", first);
    println!("{:?}", last);

    // Complex chain
    let data = [10, 20, 30, 40, 50];
    let processed: Vec<_> = data
        .iter()
        .map(|x| x + 5)
        .filter(|x| *x > 20)
        .map(|x| x * 2)
        .collect();
    println!("{:?}", processed);
}
