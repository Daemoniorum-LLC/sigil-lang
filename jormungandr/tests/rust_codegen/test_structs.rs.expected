#[derive(Debug, Clone)]
struct Point<T> {
    x: T,
    y: T,
}

#[derive(Debug)]
struct Rectangle {
    top_left: Point<f64>,
    bottom_right: Point<f64>,
}

struct Array<T, const N: usize> {
    data: [T; N],
}

impl<T> Point<T> {
    fn new(x: T, y: T) -> Self {
        Self { x, y }
    }
}

impl Point<f64> {
    fn distance(&self, other: &Point<f64>) -> f64 {
        let dx = self.x - other.x;
        let dy = self.y - other.y;
        (dx * dx + dy * dy).sqrt()
    }
}

fn main() {
    let p1 = Point::new(0.0, 0.0);
    let p2 = Point::new(3.0, 4.0);
    let d = p1.distance(&p2);
    println!("{}", d);
}
