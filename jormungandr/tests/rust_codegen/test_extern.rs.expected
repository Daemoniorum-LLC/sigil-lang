extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
    fn memcpy(dst: *mut u8, src: *const u8, size: usize) -> *mut u8;
    static errno: i32;
}

#[no_mangle]
pub extern "C" fn exported_function(x: i32) -> i32 {
    x * 2
}

fn use_malloc() {
    unsafe {
        let ptr = malloc(1024);
        if !ptr.is_null() {
            free(ptr);
        }
    }
}

fn main() {
    use_malloc();
}
