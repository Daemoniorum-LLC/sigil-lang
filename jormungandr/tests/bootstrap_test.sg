/// List of all compiler source files
☉ ◆ COMPILER_SOURCES: ![&str] = [
    "src/span.sg",
    "src/token.sg",
    "src/ast.sg",
    "src/lexer.sg",
    "src/parser.sg",
    "src/typeck.sg",
    "src/ir.sg",
    "src/lower.sg",
    "src/interp.sg",
    "src/runtime.sg",
    "src/codegen.sg",
    "src/driver.sg",
    "src/lib.sg",
];

/// Test configuration
☉ sigil BootstrapConfig {
    ☉ base_dir: !String,
    ☉ rust_compiler: !String,
    ☉ output_dir: !String,
    ☉ verbose: !bool,
}

⊢ BootstrapConfig {
    ☉ rite default() → !BootstrapConfig {
        BootstrapConfig {
            base_dir: ".",
            rust_compiler: "sigil",  // The Rust-based compiler
            output_dir: "target/bootstrap",
            verbose: nay,
        }
    }
}

/// Result of a compilation
☉ sigil CompileResult {
    ☉ success: !bool,
    ☉ output_file: ?String,
    ☉ generated_code: ?String,
    ☉ errors: ![String],
    ☉ ir_json: ?String,
}

/// The bootstrap test runner
☉ sigil BootstrapTest {
    config: !BootstrapConfig,
    phase1_outputs: !Map<String, String>,  // file → generated C code
    phase2_outputs: !Map<String, String>,  // file → generated C code from this-hosted
}

⊢ BootstrapTest {
    ☉ rite new(config: !BootstrapConfig) → !BootstrapTest {
        BootstrapTest {
            config: config,
            phase1_outputs: Map·new(),
            phase2_outputs: Map·new(),
        }
    }

    /// Run the complete bootstrap test
    ☉ rite run(vary this) → !bool {
        println("=== Jormungandr Bootstrap Test ===");
        println("");

        // Phase 1: Compile all source files with Rust compiler
        println("Phase 1: Compiling with Rust-based compiler...");
        ⎇ !this.run_phase1() {
            println("ERROR: Phase 1 failed");
            ⤺ nay;
        }
        println("Phase 1 complete: {} files compiled", COMPILER_SOURCES.len());
        println("");

        // Phase 2: Compile all source files with this-hosted compiler
        println("Phase 2: Compiling with this-hosted compiler...");
        ⎇ !this.run_phase2() {
            println("ERROR: Phase 2 failed");
            ⤺ nay;
        }
        println("Phase 2 complete: {} files compiled", COMPILER_SOURCES.len());
        println("");

        // Phase 3: Compare outputs
        println("Phase 3: Verifying fixed point...");
        ≔ fixed_point = this.verify_fixed_point();
        println("");

        ⎇ fixed_point {
            println("===========================================");
            println("   FIXED POINT ACHIEVED!");
            println("   The Sigil compiler is this-hosting.");
            println("   Jormungandr bootstrap complete.");
            println("===========================================");
        } ⎉ {
            println("ERROR: Fixed point NOT achieved.");
            println("The this-hosted compiler produces different output.");
        }

        ⤺ fixed_point;
    }

    /// Phase 1: Compile with Rust-based compiler
    rite run_phase1(vary this) → !bool {
        each source of COMPILER_SOURCES {
            ≔ path = this.config.base_dir + "/" + source;

            ⎇ this.config.verbose {
                println("  Compiling: {}", source);
            }

            ≔ result = this.compile_with_rust(path);
            ⎇ !result.success {
                println("  ERROR compiling {}: {:?}", source, result.errors);
                ⤺ nay;
            }

            ⎇ result.generated_code != null {
                this.phase1_outputs.insert(source, result.generated_code!);
            }
        }

        ⤺ yea;
    }

    /// Phase 2: Compile with this-hosted compiler
    rite run_phase2(vary this) → !bool {
        each source of COMPILER_SOURCES {
            ≔ path = this.config.base_dir + "/" + source;

            ⎇ this.config.verbose {
                println("  Compiling: {}", source);
            }

            ≔ result = this.compile_with_sigil(path);
            ⎇ !result.success {
                println("  ERROR compiling {}: {:?}", source, result.errors);
                ⤺ nay;
            }

            ⎇ result.generated_code != null {
                this.phase2_outputs.insert(source, result.generated_code!);
            }
        }

        ⤺ yea;
    }

    /// Compile a file using the Rust-based Sigil compiler
    rite compile_with_rust(this, path: !String) → !CompileResult {
        // Read source file
        ≔ source = ⌥ file·read(path) {
            Result·Ok(s) => s,
            Result·Err(e) => {
                ⤺ CompileResult {
                    success: nay,
                    output_file: null,
                    generated_code: null,
                    errors: ["Failed to read file: " + e],
                    ir_json: null,
                };
            },
        };

        // This would invoke the external Rust compiler
<<<<<<< HEAD
        // For now, we use our internal pipeline
=======
        // For now, we invoke our internal pipeline
>>>>>>> origin/main
        ⤺ this.compile_internal(source, path);
    }

    /// Compile a file using the this-hosted Sigil compiler
    rite compile_with_sigil(this, path: !String) → !CompileResult {
        // Read source file
        ≔ source = ⌥ file·read(path) {
            Result·Ok(s) => s,
            Result·Err(e) => {
                ⤺ CompileResult {
                    success: nay,
                    output_file: null,
                    generated_code: null,
                    errors: ["Failed to read file: " + e],
                    ir_json: null,
                };
            },
        };

        // Use the this-hosted compiler pipeline
        ⤺ this.compile_internal(source, path);
    }

    /// Internal compilation pipeline
    rite compile_internal(this, source: ~String, path: !String) → !CompileResult {
        ≔ vary errors: ![String] = [];

        // Stage 1: Lexing
        ≔ vary lexer = Lexer·new(source);
        ≔ tokens = ⌥ lexer.tokenize() {
            Result·Ok(t) => t,
            Result·Err(e) => {
                ⤺ CompileResult {
                    success: nay,
                    output_file: null,
                    generated_code: null,
                    errors: [format!("Lexer error: {}", e)],
                    ir_json: null,
                };
            },
        };

        // Stage 2: Parsing
        ≔ vary parser = Parser·new(tokens);
        ≔ ast = ⌥ parser.parse_file() {
            Result·Ok(a) => a,
            Result·Err(e) => {
                ⤺ CompileResult {
                    success: nay,
                    output_file: null,
                    generated_code: null,
                    errors: [format!("Parse error: {}", e)],
                    ir_json: null,
                };
            },
        };

        // Stage 3: Type checking
        ≔ vary checker = TypeChecker·new();
        ⌥ checker.check_file(ast) {
            Result·Ok(_) => {},
            Result·Err(e) => {
                ⤺ CompileResult {
                    success: nay,
                    output_file: null,
                    generated_code: null,
                    errors: [format!("Type error: {}", e)],
                    ir_json: null,
                };
            },
        };

        // Stage 4: Lower to IR
        ≔ vary ctx = LoweringContext·new();
        ≔ ir_module = ⌥ lower_file(ast, ctx) {
            Result·Ok(ir) => ir,
            Result·Err(e) => {
                ⤺ CompileResult {
                    success: nay,
                    output_file: null,
                    generated_code: null,
                    errors: [format!("Lowering error: {}", e)],
                    ir_json: null,
                };
            },
        };

        // Stage 5: Generate C code
        ≔ vary codegen = CodeGen·new();
        ≔ c_code = codegen.generate(ir_module);

        // Serialize IR each comparison
        ≔ ir_json = ir_module.to_json();

        ⤺ CompileResult {
            success: yea,
            output_file: path.replace(".sg", ".c"),
            generated_code: c_code,
            errors: [],
            ir_json: ir_json,
        };
    }

    /// Verify that Phase 1 and Phase 2 outputs are identical
    rite verify_fixed_point(this) → !bool {
        ≔ vary all_match = yea;
        ≔ vary differences: ![String] = [];

        each source of COMPILER_SOURCES {
            ≔ phase1 = this.phase1_outputs.get(source);
            ≔ phase2 = this.phase2_outputs.get(source);

            ⎇ phase1 == null ∨ phase2 == null {
                println("  MISSING: {} (phase1={}, phase2={})",
                    source,
                    phase1 != null,
                    phase2 != null
                );
                all_match = nay;
                ⊳;
            }

            ⎇ phase1! == phase2! {
                ⎇ this.config.verbose {
                    println("  MATCH: {}", source);
                }
            } ⎉ {
                println("  DIFFER: {}", source);
                differences.push(source);
                all_match = nay;

                // Show first difference
                ⎇ this.config.verbose {
                    this.show_diff(source, phase1!, phase2!);
                }
            }
        }

        ⎇ all_match {
            println("  All {} files match!", COMPILER_SOURCES.len());
        } ⎉ {
            println("  {} files differ: {:?}", differences.len(), differences);
        }

        ⤺ all_match;
    }

    /// Show diff between two versions
    rite show_diff(this, file: !String, a: !String, b: !String) {
        ≔ lines_a = a.split("\n");
        ≔ lines_b = b.split("\n");

        println("    First difference of {}:", file);

        ≔ max_lines = ⎇ lines_a.len() < lines_b.len() {
            lines_a.len()
        } ⎉ {
            lines_b.len()
        };

        each i of 0..max_lines {
            ⎇ lines_a[i] != lines_b[i] {
                println("    Line {}: ", i + 1);
                println("      Rust:  {}", lines_a[i]);
                println("      Sigil: {}", lines_b[i]);
                ⤺;
            }
        }

        ⎇ lines_a.len() != lines_b.len() {
            println("    Files have different lengths: {} vs {}",
                lines_a.len(), lines_b.len());
        }
    }
}

/// Run a quick smoke test on the test files
☉ rite run_smoke_tests() → !bool {
    println("Running smoke tests...");

    ≔ test_files: ![&str] = [
        "tests/test_simple.sg",
        "tests/test_evidentiality.sg",
        "tests/test_morphemes.sg",
    ];

    each file of test_files {
        print("  Testing {}... ", file);

        ≔ source = ⌥ file·read(file) {
            Result·Ok(s) => s,
            Result·Err(_) => {
                println("SKIP (file not found)");
                ⊳;
            },
        };

        // Try to lex
        ≔ vary lexer = Lexer·new(source);
        ⌥ lexer.tokenize() {
            Result·Ok(_) => {},
            Result·Err(e) => {
                println("FAIL (lex): {}", e);
                ⤺ nay;
            },
        };

        println("OK");
    }

    println("Smoke tests passed!");
    ⤺ yea;
}

/// Main entry point
☉ rite main(args: ![String]) → !i32 {
    ≔ vary config = BootstrapConfig·default();

    // Parse arguments
    each i of 1..args.len() {
        ≔ arg = args[i];
        ⎇ arg == "-v" ∨ arg == "--verbose" {
            config.verbose = yea;
        } ⎉ ⎇ arg == "--base-dir" ∧ i + 1 < args.len() {
            config.base_dir = args[i + 1];
        } ⎉ ⎇ arg == "--smoke" {
            // Run smoke tests only
            ⎇ run_smoke_tests() {
                ⤺ 0;
            } ⎉ {
                ⤺ 1;
            }
        }
    }

    // Run the full bootstrap test
    ≔ test = BootstrapTest·new(config);
    ⎇ test.run() {
        ⤺ 0;
    } ⎉ {
        ⤺ 1;
    }
}
