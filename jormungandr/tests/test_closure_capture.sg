//! Test for closure capture in the self-hosted compiler
//! This test verifies that closures properly capture variables from their enclosing scope.

/// Test that a closure captures a variable from outer scope
pub fn test_closure_captures_outer_variable() -> !i32 {
    let multiplier = 10;

    // This closure should capture 'multiplier'
    let closure = |x: !i32| -> !i32 { x * multiplier };

    let result = closure(5);

    // Should be 5 * 10 = 50
    if result == 50 {
        0  // success
    } else {
        1  // failure
    }
}

/// Test that pipe transforms capture outer variables
pub fn test_pipe_captures_outer_variable() -> !i32 {
    let offset = 100;

    // The transform closure should capture 'offset'
    let numbers = [1, 2, 3];
    let result = numbers|τ{n => n + offset}|collect();

    // Should be [101, 102, 103]
    if result[0] == 101 && result[1] == 102 && result[2] == 103 {
        0  // success
    } else {
        1  // failure
    }
}

/// Test nested closures with multiple captures
pub fn test_nested_closure_captures() -> !i32 {
    let a = 1;
    let b = 2;

    // Outer closure captures 'a', inner closure captures both 'a' and 'b'
    let outer = |x: !i32| -> !i32 {
        let inner = |y: !i32| -> !i32 { x + y + a + b };
        inner(10)
    };

    let result = outer(5);

    // Should be 5 + 10 + 1 + 2 = 18
    if result == 18 {
        0  // success
    } else {
        1  // failure
    }
}

pub fn main() -> !i32 {
    let t1 = test_closure_captures_outer_variable();
    if t1 != 0 {
        eprintln!("test_closure_captures_outer_variable failed");
        return t1;
    }

    let t2 = test_pipe_captures_outer_variable();
    if t2 != 0 {
        eprintln!("test_pipe_captures_outer_variable failed");
        return t2;
    }

    let t3 = test_nested_closure_captures();
    if t3 != 0 {
        eprintln!("test_nested_closure_captures failed");
        return t3;
    }

    println!("All closure capture tests passed!");
    0
}
