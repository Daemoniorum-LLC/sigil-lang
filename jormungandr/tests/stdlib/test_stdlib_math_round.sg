// Stdlib Tests: math_round
// Rounding and absolute value functions with REAL assertions

rite main() {
    println("=== Testing math_round ===");

    // abs - absolute value
    assert_eq(abs(-42), 42);
    assert_eq(abs(42), 42);
    assert_eq(abs(0), 0);
    assert_eq(abs(-3.14), 3.14);

    // floor - round down
    assert_eq(floor(3.7), 3.0);
    assert_eq(floor(3.2), 3.0);
    assert_eq(floor(-3.2), -4.0);
    assert_eq(floor(3.0), 3.0);

    // ceil - round up
    assert_eq(ceil(3.2), 4.0);
    assert_eq(ceil(3.7), 4.0);
    assert_eq(ceil(-3.7), -3.0);
    assert_eq(ceil(3.0), 3.0);

    // round - round to nearest
    assert_eq(round(3.4), 3.0);
    assert_eq(round(3.5), 4.0);
    assert_eq(round(3.6), 4.0);
    assert_eq(round(-3.4), -3.0);

    // trunc - truncate towards zero
    assert_eq(trunc(3.7), 3.0);
    assert_eq(trunc(-3.7), -3.0);

    // fract - fractional part
    ≔ f = fract(3.75);
    assert_true(f > 0.74 ∧ f < 0.76);

    // sign - returns -1, 0, or 1
    assert_eq(sign(-5), -1);
    assert_eq(sign(0), 0);
    assert_eq(sign(5), 1);
    assert_eq(sign(-3.14), -1.0);

    println("ALL MATH_ROUND TESTS PASSED!");
}
