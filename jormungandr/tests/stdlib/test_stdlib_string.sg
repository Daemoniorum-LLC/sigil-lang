// Stdlib Tests: string
// Core string manipulation functions with REAL assertions

rite main() {
    println("=== Testing string ===");

    // concat
    assert_eq(concat("hello", " world"), "hello world");
    assert_eq(concat("", "test"), "test");
    assert_eq(concat("a", ""), "a");

    // chars
    assert_eq(len(chars("hello")), 5);
    assert_eq(len(chars("")), 0);
    assert_eq(len(chars("abc")), 3);

    // bytes
    assert_eq(len(bytes("hello")), 5);

    // split
    assert_eq(split("a,b,c", ","), ["a", "b", "c"]);
    assert_eq(split("one-two-three", "-"), ["one", "two", "three"]);
    assert_eq(split("no-match", ","), ["no-match"]);

    // join
    assert_eq(join(["a", "b", "c"], ","), "a,b,c");
    assert_eq(join(["one"], "-"), "one");
    assert_eq(join([], "-"), "");

    // trim
    assert_eq(trim("  hello  "), "hello");
    assert_eq(trim("no-trim"), "no-trim");
    assert_eq(trim("   "), "");

    // trim_start
    assert_eq(trim_start("  hello"), "hello");
    assert_eq(trim_start("hello  "), "hello  ");

    // trim_end
    assert_eq(trim_end("hello  "), "hello");
    assert_eq(trim_end("  hello"), "  hello");

    // upper
    assert_eq(upper("hello"), "HELLO");
    assert_eq(upper("HeLLo"), "HELLO");
    assert_eq(upper("123"), "123");

    // lower
    assert_eq(lower("HELLO"), "hello");
    assert_eq(lower("HeLLo"), "hello");
    assert_eq(lower("123"), "123");

    // replace
    assert_eq(replace("hello", "l", "w"), "hewwo");
    assert_eq(replace("aaa", "a", "b"), "bbb");
    assert_eq(replace("test", "x", "y"), "test");

    // pad_left
    assert_eq(pad_left("hi", 5, " "), "   hi");
    assert_eq(pad_left("hello", 3, " "), "hello");

    // pad_right
    assert_eq(pad_right("hi", 5, " "), "hi   ");
    assert_eq(pad_right("hello", 3, " "), "hello");

    // substring
    assert_eq(substring("hello", 1, 3), "el");
    assert_eq(substring("hello", 0, 5), "hello");

    // char_at - returns char, convert for comparison
    assert_eq(to_string(char_at("hello", 0)), "h");
    assert_eq(to_string(char_at("hello", 4)), "o");

    // char_code_at
    assert_eq(char_code_at("hello", 0), 104);
    assert_eq(char_code_at("A", 0), 65);

    // char_count
    assert_eq(char_count("hello"), 5);
    assert_eq(char_count(""), 0);

    // byte_count
    assert_eq(byte_count("hello"), 5);
    assert_eq(byte_count(""), 0);

    // len (on strings)
    assert_eq(len("hello"), 5);
    assert_eq(len(""), 0);

    // contains
    assert_true(contains("hello", "ell"));
    assert_false(contains("hello", "xyz"));

    // starts_with
    assert_true(starts_with("hello", "he"));
    assert_false(starts_with("hello", "lo"));

    // ends_with
    assert_true(ends_with("hello", "lo"));
    assert_false(ends_with("hello", "he"));

    // index_of
    assert_eq(index_of("hello", "l"), 2);
    assert_eq(index_of("hello", "x"), -1);

    // last_index_of
    assert_eq(last_index_of("hello", "l"), 3);

    // repeat_str
    assert_eq(repeat_str("ab", 3), "ababab");
    assert_eq(repeat_str("x", 0), "");

    // reverse (string)
    assert_eq(reverse("hello"), "olleh");
    assert_eq(reverse(""), "");

    // capitalize - only capitalizes first letter
    assert_eq(capitalize("hello"), "Hello");
    assert_eq(capitalize("HELLO"), "HELLO");

    // title_case
    assert_eq(title_case("hello world"), "Hello World");

    // snake_case
    assert_eq(snake_case("helloWorld"), "hello_world");

    // kebab_case
    assert_eq(kebab_case("helloWorld"), "hello-world");

    // camel_case
    assert_eq(camel_case("hello_world"), "helloWorld");

    // slugify
    assert_eq(slugify("Hello World!"), "hello-world");

    // is_empty (string)
    assert_true(is_empty(""));
    assert_false(is_empty("hi"));

    // is_blank
    assert_true(is_blank("   "));
    assert_true(is_blank(""));
    assert_false(is_blank("hi"));

    // is_alpha
    assert_true(is_alpha("hello"));
    assert_false(is_alpha("hello1"));

    // is_digit
    assert_true(is_digit("123"));
    assert_false(is_digit("12a"));

    // is_alnum
    assert_true(is_alnum("hello123"));
    assert_false(is_alnum("hello!"));

    // is_space
    assert_true(is_space("   "));
    assert_false(is_space("hi"));

    // lines
    assert_eq(lines("a\nb\nc"), ["a", "b", "c"]);

    // words
    assert_eq(words("hello world"), ["hello", "world"]);

    // sentences
    assert_eq(len(sentences("Hello. World.")), 2);

    // word_count_icu
    assert_eq(word_count_icu("hello world test"), 3);

    println("ALL STRING TESTS PASSED!");
}
