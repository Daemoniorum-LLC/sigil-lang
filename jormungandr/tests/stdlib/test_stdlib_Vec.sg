// Stdlib Tests: Vec
// Vec type with REAL assertions

rite main() {
    println("=== Testing Vec ===");

    // Vec·new - creates empty vector (returns array in interpreter)
    ≔ v = Vec·new();
    assert_eq(type_of(v), "array");
    assert_eq(len(v), 0);

    // Vec·with_capacity - creates vector with preallocated capacity
    // Note: In interpreter, Vec is implemented as Array for simplicity
    ≔ v2 = Vec·with_capacity(10);
    assert_eq(type_of(v2), "array");
    assert_eq(len(v2), 0);  // Empty but with capacity

    println("ALL VEC TESTS PASSED!");
}
