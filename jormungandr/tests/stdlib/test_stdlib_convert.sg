// Stdlib Tests: convert
// Type conversion functions with REAL assertions

rite main() {
    println("=== Testing convert ===");

    // to_string
    assert_eq(to_string(42), "42");
    assert_eq(to_string(3.14), "3.14");
    assert_eq(to_string(yea), "true");
    assert_eq(to_string(nay), "false");

    // to_int
    assert_eq(to_int("42"), 42);
    assert_eq(to_int(3.7), 3);
    assert_eq(to_int(yea), 1);
    assert_eq(to_int(nay), 0);

    // to_float
    assert_eq(to_float("3.14"), 3.14);
    assert_eq(to_float(42), 42.0);

    // to_bool - note: non-empty strings are truthy
    assert_true(to_bool(1));
    assert_true(to_bool("true"));
    assert_false(to_bool(0));
    assert_true(to_bool("false"));  // non-empty string is truthy
    assert_false(to_bool(""));  // empty string is falsy

    // to_char
    assert_eq(to_string(to_char(65)), "A");
    assert_eq(to_string(to_char(97)), "a");

    // to_binary
    assert_eq(to_binary(42), "101010");
    assert_eq(to_binary(255), "11111111");
    assert_eq(to_binary(0), "0");

    // to_hex - returns lowercase
    assert_eq(to_hex(255), "ff");
    assert_eq(to_hex(16), "10");
    assert_eq(to_hex(0), "0");

    // to_octal
    assert_eq(to_octal(8), "10");
    assert_eq(to_octal(64), "100");

    // from_binary
    assert_eq(from_binary("101010"), 42);
    assert_eq(from_binary("11111111"), 255);

    // from_hex
    assert_eq(from_hex("ff"), 255);
    assert_eq(from_hex("10"), 16);

    // from_octal
    assert_eq(from_octal("10"), 8);
    assert_eq(from_octal("100"), 64);

    // to_base / from_base - to_base returns uppercase
    assert_eq(to_base(255, 16), "FF");
    assert_eq(from_base("ff", 16), 255);  // from_base handles both cases
    assert_eq(from_base("FF", 16), 255);
    assert_eq(to_base(10, 2), "1010");
    assert_eq(from_base("1010", 2), 10);

    // to_ascii returns cleaned ASCII string
    assert_eq(to_ascii("Héllo"), "Hello");
    // char_code_at gets ASCII value from string position
    assert_eq(char_code_at("A", 0), 65);
    assert_eq(char_code_at("abc", 0), 97);

    // from_char_code
    assert_eq(to_string(from_char_code(65)), "A");

    println("ALL CONVERT TESTS PASSED!");
}
