// Stdlib Tests: misc
// Miscellaneous utility functions with REAL assertions

rite main() {
    println("=== Testing misc ===");

    // min - minimum of two values
    assert_eq(min(1, 2), 1);
    assert_eq(min(5, 3), 3);
    assert_eq(min(-1, 1), -1);

    // max - maximum of two values
    assert_eq(max(1, 2), 2);
    assert_eq(max(5, 3), 5);
    assert_eq(max(-1, 1), 1);

    // clamp - constrain value to range
    assert_eq(clamp(5, 0, 10), 5);
    assert_eq(clamp(-5, 0, 10), 0);
    assert_eq(clamp(15, 0, 10), 10);

    // clone - deep copy
    ≔ arr = [1, 2, 3];
    ≔ cloned = clone(arr);
    assert_eq(len(cloned), 3);
    assert_eq(cloned[0], 1);
    assert_eq(cloned[2], 3);

    // id - identity function
    assert_eq(id(42), 42);
    assert_eq(id("hello"), "hello");

    // sleep (just verify it doesn't crash)
    sleep(1);

    // debug/dbg (just verify they don't crash)
    debug(42);
    dbg("test");

    // eprint/eprintln (verify they don't crash)
    eprint("stderr ");
    eprintln("line");

    println("ALL MISC TESTS PASSED!");
}
