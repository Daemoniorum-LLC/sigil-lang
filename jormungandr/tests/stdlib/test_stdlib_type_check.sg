// Stdlib Tests: type_check
// Type checking functions with REAL assertions

rite main() {
    println("=== Testing type_check ===");

    // type_of
    assert_eq(type_of(42), "int");
    assert_eq(type_of(3.14), "float");
    assert_eq(type_of("hi"), "string");
    assert_eq(type_of(yea), "bool");
    assert_eq(type_of([1, 2]), "array");

    // is_nan
    assert_true(is_nan(0.0 / 0.0));
    assert_false(is_nan(42.0));

    // is_infinite
    assert_true(is_infinite(1.0 / 0.0));
    assert_false(is_infinite(42.0));

    // is_finite
    assert_true(is_finite(42.0));
    assert_false(is_finite(1.0 / 0.0));

    // is_even
    assert_true(is_even(42));
    assert_true(is_even(0));
    assert_false(is_even(43));

    // is_odd
    assert_true(is_odd(43));
    assert_false(is_odd(42));

    // is_prime
    assert_true(is_prime(7));
    assert_true(is_prime(2));
    assert_false(is_prime(4));
    assert_false(is_prime(1));

    // is_empty
    assert_true(is_empty(""));
    assert_true(is_empty([]));
    assert_false(is_empty("hi"));
    assert_false(is_empty([1]));

    // is_alpha
    assert_true(is_alpha("abc"));
    assert_false(is_alpha("abc123"));
    assert_false(is_alpha(""));

    // is_digit
    assert_true(is_digit("123"));
    assert_false(is_digit("123abc"));

    // is_alnum
    assert_true(is_alnum("abc123"));
    assert_false(is_alnum("abc 123"));

    // is_space
    assert_true(is_space("   "));
    assert_false(is_space("hi"));

    // is_null - note: () is unit, not null; null comes from Option unwraps
