// Stdlib Tests: json
// JSON functions with REAL assertions

rite main() {
    println("=== Testing json ===");

    // json_parse - parse JSON string to map/array
    ≔ parsed = json_parse("{\"name\": \"test\", \"value\": 42}");
    assert_eq(map_get(parsed, "name"), "test");
    assert_eq(map_get(parsed, "value"), 42);

    // json_parse array
    ≔ arr = json_parse("[1, 2, 3]");
    assert_eq(len(arr), 3);
    assert_eq(arr[0], 1);

    // json_stringify - convert to JSON string
    ≔ data = map_new();
    map_set(data, "a", 1);
    map_set(data, "b", 2);
    ≔ json_str = json_stringify(data);
    assert_true(contains(json_str, "\"a\""));
    assert_true(contains(json_str, "1"));

    // json_stringify array
    assert_eq(json_stringify([1, 2, 3]), "[1,2,3]");

    // json_pretty - formatted JSON
    ≔ pretty = json_pretty([1, 2, 3]);
    assert_true(contains(pretty, "\n"));

    // json_get - get nested value
    ≔ nested = json_parse("{\"outer\": {\"inner\": 42}}");
    ≔ outer = map_get(nested, "outer");
    assert_eq(map_get(outer, "inner"), 42);

    // Round-trip: parse -> stringify -> parse
    ≔ original = [1, 2, 3];
    ≔ stringified = json_stringify(original);
    ≔ reparsed = json_parse(stringified);
    assert_eq(len(reparsed), 3);

    println("ALL JSON TESTS PASSED!");
}
