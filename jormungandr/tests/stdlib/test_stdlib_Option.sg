// Stdlib Tests: Option
// Option type with REAL assertions

rite main() {
    println("=== Testing Option ===");

    // Option·Some - creates Some variant
    ≔ some = Option·Some(42);
    assert_eq(type_of(some), "Option::Some");

    // Option·None - creates None variant (no parens)
    ≔ none = Option·None;
    assert_eq(type_of(none), "Option::None");

    // Different value types
    ≔ str_opt = Option·Some("hello");
    assert_eq(type_of(str_opt), "Option::Some");

    ≔ arr_opt = Option·Some([1, 2, 3]);
    assert_eq(type_of(arr_opt), "Option::Some");

    println("ALL OPTION TESTS PASSED!");
}
