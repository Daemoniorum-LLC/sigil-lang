// Stdlib Tests: assert
// Assertion functions with REAL assertions

rite main() {
    println("=== Testing assert ===");

    // assert - basic assertion
    assert(yea);
    assert(1 == 1);
    assert(5 > 3);

    // assert_eq - equality assertion
    assert_eq(1, 1);
    assert_eq("hello", "hello");
    assert_eq([1, 2], [1, 2]);

    // assert_ne - inequality assertion
    assert_ne(1, 2);
    assert_ne("hello", "world");
    assert_ne([1, 2], [3, 4]);

    // assert_true
    assert_true(yea);
    assert_true(5 > 3);

    // assert_false
    assert_false(nay);
    assert_false(3 > 5);

    // assert_lt - less than
    assert_lt(1, 2);
    assert_lt(-5, 0);

    // assert_gt - greater than
    assert_gt(2, 1);
    assert_gt(0, -5);

    // assert_le - less than or equal
    assert_le(1, 2);
    assert_le(2, 2);

    // assert_ge - greater than or equal
    assert_ge(2, 1);
    assert_ge(2, 2);

    println("ALL ASSERT TESTS PASSED!");
}
