// Stdlib Tests: the collection, sync and path types
//
// These are spelled unqualified in Sigil — HashMap, Mutex, Arc, PathBuf — not under
// Rust's `std·` tree. The `std·collections·HashMap·new` family in stdlib.rs was
// never reachable from any Sigil program: a lowercase path root does not resolve, so
// every call failed with "undefined variable: `std`".

rite main() {
    println("=== Testing collections, sync and paths ===");

    ≔ vary hm = HashMap·new();
    assert_eq(hm.len(), 0);
    hm.insert("key", "value");
    assert_eq(hm.len(), 1);

    ≔ hs = HashSet·new();
    assert_eq(type_of(hs), "set");
    assert_eq(len(hs), 0);

    ≔ m = Mutex·new(42);
    assert_eq(type_of(m), "struct:Mutex");

    ≔ rw = RwLock·new(42);
    assert_eq(type_of(rw), "struct:RwLock");

    ≔ a = Arc·new(42);
    assert_eq(type_of(a), "ref");

    ≔ pb = PathBuf·from("/tmp/test");
    assert_eq(type_of(pb), "string");
    assert_true(len(pb) > 0);

    ≔ p = Path·new("/tmp/test");
    assert_eq(type_of(p), "string");

    ≔ args = Sys·args();
    assert_eq(type_of(args), "array");

    ≔ path = Sys·getenv("PATH");
    assert_eq(type_of(path), "string");
    assert_true(path != "");

    println("ALL STD TESTS PASSED!");
}
