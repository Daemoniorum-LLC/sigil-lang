// Stdlib Tests: Tensor
// Tensor type with REAL assertions

rite main() {
    println("=== Testing Tensor ===");

    // Tensor·from - creates tensor from value
    ≔ t = Tensor·from(42);
    assert_eq(type_of(t), "struct:Tensor");

    // Tensor from array
    ≔ t2 = Tensor·from([1, 2, 3]);
    assert_eq(type_of(t2), "struct:Tensor");

    // Tensor from float
    ≔ t3 = Tensor·from(3.14);
    assert_eq(type_of(t3), "struct:Tensor");

    println("ALL TENSOR TESTS PASSED!");
}
