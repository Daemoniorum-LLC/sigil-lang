// Stdlib Tests: locks
//
// Sigil has one Mutex and one RwLock, spelled unqualified. `parking_lot` is a Rust
// crate name — it draws a distinction Sigil does not make, and the bindings under
// that name in stdlib.rs were unreachable anyway, since a lowercase path root does
// not resolve.

rite main() {
    println("=== Testing locks ===");

    ≔ m = Mutex·new(42);
    assert_eq(type_of(m), "struct:Mutex");

    ≔ rw = RwLock·new(42);
    assert_eq(type_of(rw), "struct:RwLock");

    println("ALL LOCK TESTS PASSED!");
}
