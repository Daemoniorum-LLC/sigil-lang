// Stdlib Tests: HashSet
// HashSet type with REAL assertions

rite main() {
    println("=== Testing HashSet ===");

    // HashSet·new - creates empty set
    ≔ s = HashSet·new();
    assert_eq(type_of(s), "set");
    assert_eq(len(s), 0);

    // HashSet·with_capacity
    ≔ s2 = HashSet·with_capacity(100);
    assert_eq(type_of(s2), "set");
    assert_eq(len(s2), 0);

    println("ALL HASHSET TESTS PASSED!");
}
