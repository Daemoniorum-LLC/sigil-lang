// Stdlib Tests: RateLimit
// Rate limit configuration with REAL assertions

rite main() {
    println("=== Testing RateLimit ===");

    // RateLimit·new - creates rate limit config (returns map)
    ≔ rl = RateLimit·new(1, 2);
    assert_eq(type_of(rl), "map");

    // Different rate limits
    ≔ rl2 = RateLimit·new(100, 60);
    assert_eq(type_of(rl2), "map");

    println("ALL RATELIMIT TESTS PASSED!");
}
