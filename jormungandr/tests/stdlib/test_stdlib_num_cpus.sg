// Stdlib Tests: CPU counts
// Sigil spells these Sys·num_cpus and Sys·num_cpus_physical, alongside the rest of
// the machine facts under Sys·. The former `num_cpus·get` was a Rust crate name and
// was unreachable — a lowercase path root does not resolve.

rite main() {
    println("=== Testing Sys·num_cpus ===");

    ≔ cpus = Sys·num_cpus();
    assert_true(cpus >= 1);
    assert_eq(type_of(cpus), "int");

    ≔ phys = Sys·num_cpus_physical();
    assert_true(phys >= 1);
    assert_true(phys <= cpus);  // physical <= logical

    println("ALL NUM_CPUS TESTS PASSED!");
}
