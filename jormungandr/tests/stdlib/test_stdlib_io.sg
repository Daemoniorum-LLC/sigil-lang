// Stdlib Tests: io
// Input/Output functions with REAL assertions

rite main() {
    println("=== Testing io ===");

    // print - outputs without newline
    print("test");
    print(" ");

    // println - outputs with newline
    println("line");

    // eprint - outputs to stderr without newline
    eprint("stderr ");

    // eprintln - outputs to stderr with newline
    eprintln("line");

    // These are IO functions that don't return values to check
    // Just verify they don't crash

    println("ALL IO TESTS PASSED!");
}
