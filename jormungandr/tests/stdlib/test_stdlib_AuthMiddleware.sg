// Stdlib Tests: AuthMiddleware
// Authentication middleware with REAL assertions

rite main() {
    println("=== Testing AuthMiddleware ===");

    // AuthMiddleware·new - creates auth middleware (returns map)
    ≔ am = AuthMiddleware·new();
    assert_eq(type_of(am), "map");

    // AuthMiddleware·optional - creates optional auth (returns map)
    ≔ opt = AuthMiddleware·optional();
    assert_eq(type_of(opt), "map");

    // AuthMiddleware·required - creates required auth (returns map)
    ≔ req = AuthMiddleware·required();
    assert_eq(type_of(req), "map");

    println("ALL AUTHMIDDLEWARE TESTS PASSED!");
}
