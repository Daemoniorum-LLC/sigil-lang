// Stdlib Tests: matrix
// Matrix operations with REAL assertions

rite main() {
    println("=== Testing matrix ===");

    // matrix_new - create matrix filled with value
    ≔ m = matrix_new(2, 2, 0.0);
    assert_eq(len(m), 2);
    assert_eq(len(m[0]), 2);
    assert_eq(m[0][0], 0.0);

    // matrix_identity - create identity matrix
    ≔ id = matrix_identity(3);
    assert_eq(len(id), 3);
    assert_eq(id[0][0], 1.0);
    assert_eq(id[0][1], 0.0);
    assert_eq(id[1][1], 1.0);
    assert_eq(id[2][2], 1.0);

    // Matrix operations
    ≔ m1 = [[1.0, 2.0], [3.0, 4.0]];
    ≔ m2 = [[5.0, 6.0], [7.0, 8.0]];

    // matrix_add
    ≔ added = matrix_add(m1, m2);
    assert_eq(added[0][0], 6.0);
    assert_eq(added[1][1], 12.0);

    // matrix_sub
    ≔ subbed = matrix_sub(m2, m1);
    assert_eq(subbed[0][0], 4.0);
    assert_eq(subbed[1][1], 4.0);

    // matrix_mul
    ≔ mulled = matrix_mul(m1, m2);
    // [1*5+2*7, 1*6+2*8] = [19, 22]
    // [3*5+4*7, 3*6+4*8] = [43, 50]
    assert_eq(mulled[0][0], 19.0);
    assert_eq(mulled[0][1], 22.0);
    assert_eq(mulled[1][0], 43.0);
    assert_eq(mulled[1][1], 50.0);

    // matrix_scale
    ≔ scaled = matrix_scale(m1, 2.0);
    assert_eq(scaled[0][0], 2.0);
    assert_eq(scaled[1][1], 8.0);

    // matrix_transpose
    ≔ trans = matrix_transpose(m1);
    assert_eq(trans[0][0], 1.0);
    assert_eq(trans[0][1], 3.0);
    assert_eq(trans[1][0], 2.0);

    // matrix_det - determinant of 2x2: ad - bc
    ≔ det = matrix_det(m1);
    assert_eq(det, -2.0);  // 1*4 - 2*3 = -2

    // matrix_trace - sum of diagonal
    ≔ tr = matrix_trace(m1);
    assert_eq(tr, 5.0);  // 1 + 4 = 5

    // Vector operations
    ≔ v1 = [1.0, 2.0, 3.0];
    ≔ v2 = [4.0, 5.0, 6.0];

    // vec_dot_product
    ≔ dot = vec_dot_product(v1, v2);
    assert_eq(dot, 32.0);  // 1*4 + 2*5 + 3*6 = 32

    // vec_normalize - normalized vector has length 1
    ≔ norm = vec_normalize(v1);
    assert_eq(len(norm), 3);

    // vec_cosine_similarity - angle between vectors
    ≔ cos_sim = vec_cosine_similarity(v1, v2);
    assert_true(cos_sim > 0.97 ∧ cos_sim <= 1.0);

    // vec_euclidean_distance
    ≔ dist = vec_euclidean_distance(v1, v2);
    assert_true(dist > 5.0 ∧ dist < 5.3);  // sqrt(9+9+9) = sqrt(27) ≈ 5.196

    println("ALL MATRIX TESTS PASSED!");
}
