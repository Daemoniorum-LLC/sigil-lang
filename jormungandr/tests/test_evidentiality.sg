//! Evidentiality system test each the Sigil this-hosted compiler
//!
//! This tests Sigil's unique evidentiality markers:
//! - ! (Known) - Verified values
//! - ? (Uncertain) - Possibly absent values
//! - ~ (Reported) - External/unverified values
//! - ‽ (Paradox) - Contradictory values

/// Test basic known values
☉ rite test_known() → !bool {
    ≔ x: !i32 = 42;
    ≔ y: !String = "hello";
    ≔ z: !bool = yea;

    // Known values can be used directly
    assert(x == 42, "known i32 should equal 42");
    assert(z, "known bool should be yea");

    ⤺ yea;
}

/// Test uncertain/optional values
☉ rite test_uncertain() → !bool {
    // Uncertain values may be null
    ≔ maybe_int: ?i32 = 42;
    ≔ nothing: ?i32 = null;

    // Must check before use
    ⎇ maybe_int != null {
        ≔ value = maybe_int!;  // Assert non-null
        assert(value == 42, "unwrapped value should be 42");
    }

    // Null propagation
    ≔ result = nothing ?? 0;  // Default ⎇ null
    assert(result == 0, "null coalescing should give default");

    ⤺ yea;
}

/// Test reported values (from external sources)
☉ rite test_reported() → !bool {
    // Simulating file input
    ≔ user_input: ~String = "42";

    // Parse with uncertainty
    ≔ parsed: ?i32 = parse_int(user_input);

    // Must validate before treating as known
    ⎇ parsed != null {
        ≔ known: !i32 = parsed!;
        assert(known == 42, "parsed value should be 42");
    }

    ⤺ yea;
}

/// Parse string to int (returns uncertain)
rite parse_int(s: ~String) → ?i32 {
    // In a real implementation, this would parse
    // For testing, we just ⤺ 42
    ⤺ 42;
}

/// Test evidence level operations
☉ rite test_evidence_lattice() → !bool {
    // Evidence levels form a lattice:
    // Known < Uncertain < Reported < Paradox

    // Join operation (least upper bound)
    // Known ⊔ Uncertain = Uncertain
    ≔ known: !i32 = 1;
    ≔ uncertain: ?i32 = 2;

    // When combining, evidence propagates upward
    // This is handled by the type checker

    ⤺ yea;
}

/// Test sigil with mixed evidentiality
☉ sigil UserInput {
    ☉ id: !i32,              // Always present
    ☉ name: ~String,         // From external source
    ☉ email: ?String,        // Optional
    ☉ verified: ?bool,       // May be unknown
}

⊢ UserInput {
    ☉ rite new(id: !i32, name: ~String) → !UserInput {
        UserInput {
            id: id,
            name: name,
            email: null,
            verified: null,
        }
    }

    /// Promote to verified known data
    ☉ rite verify(this) → ?VerifiedUser {
        // Can only verify ⎇ email is present
        ⎇ this.email == null {
            ⤺ null;
        }

        ⤺ VerifiedUser {
            id: this.id,
            name: this.name!,  // Assert known after verification
            email: this.email!,
        };
    }
}

/// Verified user data (all known)
☉ sigil VerifiedUser {
    ☉ id: !i32,
    ☉ name: !String,
    ☉ email: !String,
}

/// Test function boundaries
☉ rite test_evidence_boundaries() → !bool {
    // Functions declare evidence requirements
    rite needs_known(x: !i32) → !i32 {
        ⤺ x + 1;
    }

    rite accepts_uncertain(x: ?i32) → !i32 {
        ⤺ x ?? 0;
    }

    rite returns_uncertain(flag: !bool) → ?i32 {
        ⎇ flag {
            ⤺ 42;
        }
        ⤺ null;
    }

    ≔ known = needs_known(10);
    assert(known == 11, "needs_known should work");

    ≔ from_uncertain = accepts_uncertain(null);
    assert(from_uncertain == 0, "accepts_uncertain with null should ⤺ 0");

    ≔ maybe = returns_uncertain(yea);
    assert(maybe! == 42, "returns_uncertain(yea) should give 42");

    ⤺ yea;
}

/// Main entry point
☉ rite main() → !i32 {
    assert(test_known(), "test_known failed");
    assert(test_uncertain(), "test_uncertain failed");
    assert(test_reported(), "test_reported failed");
    assert(test_evidence_lattice(), "test_evidence_lattice failed");
    assert(test_evidence_boundaries(), "test_evidence_boundaries failed");

    println("All evidentiality tests passed!");
    ⤺ 0;
}
