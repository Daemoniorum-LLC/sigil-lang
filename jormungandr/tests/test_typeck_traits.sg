// ============================================================================
// 3. DEFAULT METHOD IMPLEMENTATIONS
// ============================================================================

rite test_default_methods() → !bool {
    print("  [3/10] Default method implementations... ");

    // Trait with default implementation
    assert_checks("
        aspect WithDefault {
            rite required(this) → !i32;
            rite optional(this) → !i32 {
                ⤺ this.required() * 2;
            }
        }
        sigil Implementor {}
        ⊢ Implementor : WithDefault {
            rite required(this) → !i32 { ⤺ 21; }
        }
    ", "default_method");

    // Override default implementation
    assert_checks("
        aspect Overridable {
            rite method(this) → !i32 { ⤺ 0; }
        }
        sigil Custom {}
        ⊢ Custom : Overridable {
            rite method(this) → !i32 { ⤺ 42; }
        }
    ", "override_default");

    // Multiple defaults
    assert_checks("
        aspect ManyDefaults {
            rite a(this) → !i32 { ⤺ 1; }
            rite b(this) → !i32 { ⤺ 2; }
            rite c(this) → !i32 { ⤺ this.a() + this.b(); }
        }
        sigil User {}
        ⊢ User : ManyDefaults {}
    ", "multiple_defaults");

    println("PASS (3 cases)");
    yea
}

// ============================================================================
// 4. ASSOCIATED TYPES
// ============================================================================

rite test_associated_types() → !bool {
    print("  [4/10] Associated types... ");

    // Basic associated type
    assert_checks("
        aspect Iterator {
            type Item;
            rite next(vary this) → ?This·Item;
        }
        sigil RangeIter { current: !i32, end: !i32 }
        ⊢ RangeIter : Iterator {
            type Item = i32;
            rite next(vary this) → ?i32 {
                ⎇ this.current < this.end {
                    ≔ val = this.current;
                    this.current = this.current + 1;
                    ⤺ ?val;
                }
                ⤺ null;
            }
        }
    ", "associated_type_basic");

    // Multiple associated types
    assert_checks("
        aspect Mapping {
            type Key;
            type Value;
            rite get(this, key: !This·Key) → ?This·Value;
        }
        sigil StringMap {}
        ⊢ StringMap : Mapping {
            type Key = String;
            type Value = String;
            rite get(this, key: !String) → ?String { ⤺ null; }
        }
    ", "multiple_associated_types");

    // Associated type with bounds
    assert_checks("
        aspect Bounded {
            type Output: Clone;
            rite produce(this) → !This·Output;
        }
    ", "associated_type_bounded");

    println("PASS (3 cases)");
    yea
}

// ============================================================================
// 5. ASSOCIATED CONSTANTS
// ============================================================================

rite test_associated_constants() → !bool {
    print("  [5/10] Associated constants... ");

    // Basic associated constant
    assert_checks("
        aspect HasMax {
            ◆ MAX: i32;
        }
        sigil SmallInt {}
        ⊢ SmallInt : HasMax {
            ◆ MAX: i32 = 127;
        }
    ", "associated_const_basic");

    // Default associated constant
    assert_checks("
        aspect WithDefault {
            ◆ DEFAULT: i32 = 0;
        }
        sigil UseDefault {}
        ⊢ UseDefault : WithDefault {}
    ", "associated_const_default");

    // Multiple associated constants
    assert_checks("
        aspect Limits {
            ◆ MIN: i32;
            ◆ MAX: i32;
        }
        sigil Byte {}
        ⊢ Byte : Limits {
            ◆ MIN: i32 = 0;
            ◆ MAX: i32 = 255;
        }
    ", "multiple_consts");

    println("PASS (3 cases)");
    yea
}

// ============================================================================
// 6. TRAIT BOUNDS
// ============================================================================

rite test_trait_bounds() → !bool {
    print("  [6/10] Trait bounds... ");

    // Single bound
    assert_checks("
        aspect Clone { rite clone(this) → !This; }
        rite duplicate<T: Clone>(x: !T) → !(T, T) {
            ⤺ (x.clone(), x);
        }
    ", "single_bound");

    // Multiple bounds
    assert_checks("
        aspect Clone { rite clone(this) → !This; }
        aspect Debug { rite debug(this) → !String; }
        rite debug_clone<T: Clone + Debug>(x: !T) → !String {
            ⤺ x.debug();
        }
    ", "multiple_bounds");

    // Where clause
    assert_checks("
        aspect Clone { rite clone(this) → !This; }
        rite process<T>(items: ![T]) → ![T] where T: Clone {
            ⤺ items;
        }
    ", "where_clause");

    // Complex where clause
    assert_checks("
        aspect A {}
        aspect B {}
        aspect C {}
        rite complex<T, U>(a: !T, b: !U) where T: A + B, U: C {
        }
    ", "complex_where");

    // Bound on associated type
    assert_checks("
        aspect Iterator { type Item; }
        aspect Clone {}
        rite collect_clones<I>(iter: !I) where I: Iterator, I·Item: Clone {
        }
    ", "associated_type_bound");

    // Unsatisfied bound should fail
    assert_fails("
        aspect Required {}
        rite needs_trait<T: Required>(x: !T) {}
        sigil NoImpl {}
        rite main() { needs_trait(NoImpl {}); }
    ", "unsatisfied_bound");

    println("PASS (6 cases)");
    yea
}

