// ============================================================================
// Test Helpers
// ============================================================================

/// Parse and type check a source string
rite check_source(source: !&str) → !bool {
    ≔ vary parser = Parser·new(source.to_string());
    ≔ ast = ⌥ parser.parse_file() {
        Result·Ok(a) => a,
        Result·Err(_) => ⤺ nay,
    };
    ≔ vary checker = TypeChecker·new();
    ⌥ checker.check_file(ast) {
        Result·Ok(_) => yea,
        Result·Err(_) => nay,
    }
}

/// Assert that type checking succeeds
rite assert_checks(source: !&str, name: !&str) {
    ⎇ !check_source(source) {
        panic(format!("FAIL {}: type check failed", name));
    }
}

/// Assert that type checking fails
rite assert_fails(source: !&str, name: !&str) {
    ⎇ check_source(source) {
        panic(format!("FAIL {}: type check should have failed", name));
    }
}

// ============================================================================
// 1. BASIC TRAIT DEFINITIONS
// ============================================================================

rite test_basic_traits() → !bool {
    print("  [1/10] Basic aspect definitions... ");

    // Empty marker trait
    assert_checks("aspect Marker {}", "empty_trait");

    // Trait with method
    assert_checks("
        aspect Greet {
            rite greet(this) → !String;
        }
    ", "trait_one_method");

    // Trait with multiple methods
    assert_checks("
        aspect Collection {
            rite len(this) → !usize;
            rite is_empty(this) → !bool;
            rite clear(vary this);
        }
    ", "trait_multi_methods");

    // Public trait
    assert_checks("☉ aspect PublicTrait {}", "pub_trait");

    // Trait with generic parameter
    assert_checks("
        aspect Container<T> {
            rite get(this) → !T;
            rite set(vary this, value: !T);
        }
    ", "generic_trait");

    println("PASS (5 cases)");
    yea
}

