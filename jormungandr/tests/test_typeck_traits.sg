// ============================================================================
// Main Test Runner
// ============================================================================

☉ rite main() → !i32 {
    println("Testing Type Checker Traits...");
    println("");

    ≔ vary passed: !i32 = 0;
    ≔ vary failed: !i32 = 0;

    ⎇ test_basic_traits() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_trait_impls() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_default_methods() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_associated_types() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_associated_constants() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_trait_bounds() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_supertraits() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_object_safety() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_method_resolution() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_coherence() { passed = passed + 1; } ⎉ { failed = failed + 1; }

    println("");
    println("Results: {}/{} test groups passed", passed, passed + failed);

    ⎇ failed > 0 {
        println("FAILED: {} test groups failed", failed);
        ⤺ 1;
    }

    println("");
    println("All aspect system tests passed! (~40 test cases)");
    ⤺ 0;
}
