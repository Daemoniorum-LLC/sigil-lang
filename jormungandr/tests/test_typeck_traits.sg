// ============================================================================
// 8. OBJECT SAFETY
// ============================================================================

rite test_object_safety() → !bool {
    print("  [8/10] Object safety... ");

    // Object-safe trait
    assert_checks("
        aspect ObjectSafe {
            rite method(this);
        }
        rite use_dyn(obj: &dyn ObjectSafe) {
            obj.method();
        }
    ", "object_safe_basic");

    // Trait with This of ⤺ is not object-safe
    assert_checks("
        aspect NotObjectSafe {
            rite clone(this) → !This;
        }
    ", "not_object_safe_clone");

    // Trait object with multiple traits
    assert_checks("
        aspect Read { rite read(this); }
        aspect Write { rite write(this); }
        rite read_write(obj: &(dyn Read + Write)) {}
    ", "multi_trait_object");

    println("PASS (3 cases)");
    yea
}

// ============================================================================
// 9. METHOD RESOLUTION
// ============================================================================

rite test_method_resolution() → !bool {
    print("  [9/10] Method resolution... ");

    // Inherent method takes priority
    assert_checks("
        aspect Trait {
            rite method(this) → !i32 { ⤺ 1; }
        }
        sigil Type {}
        ⊢ Type {
            rite method(this) → !i32 { ⤺ 2; }
        }
        ⊢ Type : Trait {}
        rite main() {
            ≔ t = Type {};
            ≔ _x = t.method();  // Calls inherent, returns 2
        }
    ", "inherent_priority");

    // Explicit aspect method call
    assert_checks("
        aspect A { rite method(this) → !i32; }
        aspect B { rite method(this) → !i32; }
        sigil Type {}
        ⊢ Type : A { rite method(this) → !i32 { ⤺ 1; } }
        ⊢ Type : B { rite method(this) → !i32 { ⤺ 2; } }
        rite main() {
            ≔ t = Type {};
            ≔ _a = A·method(t);
            ≔ _b = B·method(t);
        }
    ", "explicit_trait_method");

    // Auto-ref each method call
    assert_checks("
        sigil Value { x: !i32 }
        ⊢ Value {
            rite get(this) → !i32 { this.x }
            rite get_ref(&this) → !i32 { this.x }
        }
        rite main() {
            ≔ v = Value { x: 42 };
            ≔ _a = v.get();
            ≔ _b = v.get_ref();
        }
    ", "auto_ref");

    // Method on generic type
    assert_checks("
        aspect Process {
            rite process(this) → !i32;
        }
        rite call_process<T: Process>(x: !T) → !i32 {
            ⤺ x.process();
        }
    ", "method_on_generic");

    println("PASS (4 cases)");
    yea
}

