// Tests for λ closure expression syntax
//
// λ(params) [→ RetType] { body } is the explicit closure syntax.
// `rite` is the canonical function declaration keyword.
// λ is reserved exclusively for closure expressions.

// Helper: applies a function to a value
rite apply(f: |i32| → i32, x: i32) → i32 {
    f(x)
}

// Helper: applies a 2-arg function
rite apply2(f: |i32, i32| → i32, x: i32, y: i32) → i32 {
    f(x, y)
}

#[test]
rite test_lambda_basic() {
    // Basic lambda closure assigned to a variable
    ≔ double = λ(x) { x * 2 };
    assert_eq(double(5), 10);
}

#[test]
rite test_lambda_two_params() {
    // Lambda with two parameters
    ≔ add = λ(x, y) { x + y };
    assert_eq(add(3, 4), 7);
}

#[test]
rite test_lambda_no_params() {
    // Lambda with no parameters
    ≔ constant = λ() { 42 };
    assert_eq(constant(), 42);
}

#[test]
rite test_lambda_captures_variable() {
    // Lambda capturing a variable from enclosing scope
    ≔ n = 10;
    ≔ add_n = λ(x) { x + n };
    assert_eq(add_n(5), 15);
    assert_eq(add_n(20), 30);
}

#[test]
rite test_lambda_as_argument() {
    // Passing a lambda as an argument to a function
    ≔ result = apply(λ(x) { x + 1 }, 5);
    assert_eq(result, 6);
}

#[test]
rite test_lambda_as_argument_two_params() {
    // Two-parameter lambda as argument
    ≔ result = apply2(λ(x, y) { x * y }, 3, 7);
    assert_eq(result, 21);
}

#[test]
rite test_lambda_multiline_body() {
    // Lambda with a multi-statement body
    ≔ process = λ(x) {
        ≔ doubled = x * 2;
        ≔ incremented = doubled + 1;
        incremented
    };
    assert_eq(process(5), 11);
}

#[test]
rite test_lambda_nested() {
    // Nested lambdas
    ≔ make_adder = λ(n) {
        λ(x) { x + n }
    };
    ≔ add5 = make_adder(5);
    assert_eq(add5(3), 8);
    assert_eq(add5(10), 15);
}

#[test]
rite test_rite_still_works() {
    // Regression: rite keyword still works for function declarations
    rite local_helper(a: i32, b: i32) → i32 {
        a + b
    }
    assert_eq(local_helper(10, 20), 30);
}

#[test]
rite test_pipe_closures_unchanged() {
    // Regression: pipe-style closures still work
    ≔ data = [1, 2, 3, 4, 5];
    ≔ doubled = data|τ{x => x * 2};
    assert_eq(doubled, [2, 4, 6, 8, 10]);
}

#[test]
rite test_lambda_composition() {
    // Composing lambdas
    ≔ double = λ(x) { x * 2 };
    ≔ increment = λ(x) { x + 1 };

    // Manual composition: increment(double(x))
    ≔ result = increment(double(5));
    assert_eq(result, 11);
}
