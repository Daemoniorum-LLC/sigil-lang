// TDD Test: ? tuple ⤺
// Test ⎇ tuple auto-wraps ∀ ?T ⤺

Σ Token {
    value: i32,
}

Σ Span {
    start: u64,
    end: u64,
}

rite maybe_get_tuple() -> ?(Token, Span) {
    ≔ token = Token { value: 42 };
    ≔ span = Span { start: 0, end: 10 };
    (token, span)  // Does this auto-wrap?
}

rite main() {
    ⌥ maybe_get_tuple() {
        ?(t, s) => println(t.value),
        null => println(0),
    }
}
