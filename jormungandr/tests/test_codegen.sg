fn test_main_wrapper() -> !bool {
    print("  [11/12] Main wrapper... ");

    let mut module = IrModule::new("test.sg".to_string());
    module.functions.push(IrFunction {
        name: "main".to_string(),
        id: "main".to_string(),
        visibility: IrVisibility::Public,
        generics: [],
        params: [],
        return_type: IrType::Int { width: 32, signed: true },
        return_evidence: IrEvidence::Known,
        body: ?IrOperation::Return {
            value: ?Box::new(IrOperation::Literal {
                variant: LiteralVariant::Int,
                value: LiteralValue::Int(0),
                ty: IrType::Int { width: 32, signed: true },
                evidence: IrEvidence::Known,
            }),
            evidence: IrEvidence::Known,
        },
        is_async: false,
        is_unsafe: false,
        span: null,
    });

    let code = generate(module);

    // Should have main entry point
    assert_contains(&code, "int main", "has_main_entry");
    assert_contains(&code, "argc", "has_argc");

    println("PASS (2 cases)");
    true
}

// ============================================================================
// 12. TEMPORARY VARIABLES
// ============================================================================

fn test_temp_vars() -> !bool {
    print("  [12/12] Temporary variables... ");

    let mut module = IrModule::new("test.sg".to_string());
    module.functions.push(simple_function("complex", IrOperation::Block {
        statements: [
            IrOperation::Let {
                pattern: IrPattern::Ident { name: "x".to_string(), mutable: false, evidence: null },
                type_annotation: null,
                init: Box::new(IrOperation::Binary {
                    operator: BinaryOp::Add,
                    left: Box::new(IrOperation::Literal { variant: LiteralVariant::Int, value: LiteralValue::Int(1), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
                    right: Box::new(IrOperation::Binary {
                        operator: BinaryOp::Mul,
                        left: Box::new(IrOperation::Literal { variant: LiteralVariant::Int, value: LiteralValue::Int(2), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
                        right: Box::new(IrOperation::Literal { variant: LiteralVariant::Int, value: LiteralValue::Int(3), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
                        ty: IrType::Int { width: 32, signed: true },
                        evidence: IrEvidence::Known,
                    }),
                    ty: IrType::Int { width: 32, signed: true },
                    evidence: IrEvidence::Known,
                }),
                evidence: IrEvidence::Known,
            },
            IrOperation::Return {
                value: ?Box::new(IrOperation::Var { name: "x".to_string(), id: "x".to_string(), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
                evidence: IrEvidence::Known,
            },
        ],
        ty: IrType::Int { width: 32, signed: true },
        evidence: IrEvidence::Known,
    }));

    let code = generate(module);

    // Should have proper variable handling
    assert_contains(&code, "sigil_complex", "has_function");

    println("PASS (1 case)");
    true
}

// ============================================================================
// Main Test Runner
// ============================================================================

pub fn main() -> !i32 {
    println("Testing Code Generation...");
    println("");

    let mut passed: !i32 = 0;
    let mut failed: !i32 = 0;

    if test_header_generation() { passed = passed + 1; } else { failed = failed + 1; }
    if test_function_declarations() { passed = passed + 1; } else { failed = failed + 1; }
    if test_function_params() { passed = passed + 1; } else { failed = failed + 1; }
    if test_literal_codegen() { passed = passed + 1; } else { failed = failed + 1; }
    if test_binary_codegen() { passed = passed + 1; } else { failed = failed + 1; }
    if test_control_flow_codegen() { passed = passed + 1; } else { failed = failed + 1; }
    if test_typedef_codegen() { passed = passed + 1; } else { failed = failed + 1; }
    if test_evidence_codegen() { passed = passed + 1; } else { failed = failed + 1; }
    if test_call_codegen() { passed = passed + 1; } else { failed = failed + 1; }
    if test_method_codegen() { passed = passed + 1; } else { failed = failed + 1; }
    if test_main_wrapper() { passed = passed + 1; } else { failed = failed + 1; }
    if test_temp_vars() { passed = passed + 1; } else { failed = failed + 1; }
    if test_uncertain_pattern_codegen() { passed = passed + 1; } else { failed = failed + 1; }

    println("");
    println("Results: {}/{} test groups passed", passed, passed + failed);

    if failed > 0 {
        println("FAILED: {} test groups failed", failed);
        return 1;
    }

    println("");
    println("All code generation tests passed! (~24 test cases)");
    return 0;
}

// ============================================================================
// 13. UNCERTAIN PATTERN CODEGEN (CG-009)
// ============================================================================

/// Test that ?name patterns in match generate non-null checks, not "if (1)"
/// This is CG-009 - the bootstrap hang bug
fn test_uncertain_pattern_codegen() -> !bool {
    print("  [13/13] Uncertain pattern match (CG-009)... ");

    // Create a match with ?value pattern that should generate TAG_NULL check
    let mut module = IrModule::new("test.sg".to_string());
    module.functions.push(IrFunction {
        name: "test_uncertain_match".to_string(),
        id: "test_uncertain_match".to_string(),
        visibility: IrVisibility::Public,
        generics: [],
        params: [
            IrParam { name: "opt".to_string(), ty: IrType::Option { inner: Box::new(IrType::Int { width: 32, signed: true }) }, evidence: IrEvidence::Uncertain, mutable: false },
        ],
        return_type: IrType::Int { width: 32, signed: true },
        return_evidence: IrEvidence::Known,
        body: ?IrOperation::Match {
            scrutinee: Box::new(IrOperation::Var {
                name: "opt".to_string(),
                id: "opt".to_string(),
                ty: IrType::Option { inner: Box::new(IrType::Int { width: 32, signed: true }) },
                evidence: IrEvidence::Uncertain,
            }),
            arms: [
                IrMatchArm {
                    pattern: IrPattern::Ident {
                        name: "v".to_string(),
                        mutable: false,
                        evidence: ?IrEvidence::Uncertain,
                    },
                    guard: null,
                    body: IrOperation::Return {
                        value: ?Box::new(IrOperation::Var { name: "v".to_string(), id: "v".to_string(), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
                        evidence: IrEvidence::Known,
                    },
                },
                IrMatchArm {
                    pattern: IrPattern::Literal {
                        value: LiteralValue::Null,
                    },
                    guard: null,
                    body: IrOperation::Return {
                        value: ?Box::new(IrOperation::Literal { variant: LiteralVariant::Int, value: LiteralValue::Int(0), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
                        evidence: IrEvidence::Known,
                    },
                },
            ],
            ty: IrType::Int { width: 32, signed: true },
            evidence: IrEvidence::Known,
        },
        is_async: false,
        is_unsafe: false,
        span: null,
    });

    let code = generate(module);

    // CG-009 BUG: Code currently generates "if (1)" for ?v pattern
    // EXPECTED: Should generate "(opt.tag != TAG_NULL)" or similar non-null check
    assert_not_contains(&code, "if (1)", "CG-009: should NOT generate 'if (1)' for ?pattern");
    assert_contains(&code, "TAG_NULL", "CG-009: should check TAG_NULL for ?pattern");

    println("PASS (2 cases)");
    true
}
