// ============================================================================
// 12. TEMPORARY VARIABLES
// ============================================================================

rite test_temp_vars() → !bool {
    print("  [12/12] Temporary variables... ");

    ≔ vary module = IrModule·new("test.sg".to_string());
    module.functions.push(simple_function("complex", IrOperation·Block {
        statements: [
            IrOperation·Let {
                pattern: IrPattern·Ident { name: "x".to_string(), mutable: nay, evidence: null },
                type_annotation: null,
                init: Box·new(IrOperation·Binary {
                    operator: BinaryOp·Add,
                    left: Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(1), ty: IrType·Int { width: 32, signed: yea }, evidence: IrEvidence·Known }),
                    right: Box·new(IrOperation·Binary {
                        operator: BinaryOp·Mul,
                        left: Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(2), ty: IrType·Int { width: 32, signed: yea }, evidence: IrEvidence·Known }),
                        right: Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(3), ty: IrType·Int { width: 32, signed: yea }, evidence: IrEvidence·Known }),
                        ty: IrType·Int { width: 32, signed: yea },
                        evidence: IrEvidence·Known,
                    }),
                    ty: IrType·Int { width: 32, signed: yea },
                    evidence: IrEvidence·Known,
                }),
                evidence: IrEvidence·Known,
            },
            IrOperation·Return {
                value: ?Box·new(IrOperation·Var { name: "x".to_string(), id: "x".to_string(), ty: IrType·Int { width: 32, signed: yea }, evidence: IrEvidence·Known }),
                evidence: IrEvidence·Known,
            },
        ],
        ty: IrType·Int { width: 32, signed: yea },
        evidence: IrEvidence·Known,
    }));

    ≔ code = generate(module);

    // Should have proper variable handling
    assert_contains(&code, "sigil_complex", "has_function");

    println("PASS (1 case)");
    yea
}

// ============================================================================
// Main Test Runner
// ============================================================================

☉ rite main() → !i32 {
    println("Testing Code Generation...");
    println("");

    ≔ vary passed: !i32 = 0;
    ≔ vary failed: !i32 = 0;

    ⎇ test_header_generation() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_function_declarations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_function_params() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_literal_codegen() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_binary_codegen() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_control_flow_codegen() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_typedef_codegen() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_evidence_codegen() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_call_codegen() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_method_codegen() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_main_wrapper() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_temp_vars() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_uncertain_pattern_codegen() { passed = passed + 1; } ⎉ { failed = failed + 1; }

    println("");
    println("Results: {}/{} test groups passed", passed, passed + failed);

    ⎇ failed > 0 {
        println("FAILED: {} test groups failed", failed);
        ⤺ 1;
    }

    println("");
    println("All code generation tests passed! (~24 test cases)");
    ⤺ 0;
}

// ============================================================================
// 13. UNCERTAIN PATTERN CODEGEN (CG-009)
// ============================================================================

/// Test that ?name patterns of ⌥ generate non-null checks, not "⎇ (1)"
/// This is CG-009 - the bootstrap hang bug
rite test_uncertain_pattern_codegen() → !bool {
    print("  [13/13] Uncertain pattern ⌥ (CG-009)... ");

    // Create a ⌥ with ?value pattern that should generate TAG_NULL check
    ≔ vary module = IrModule·new("test.sg".to_string());
    module.functions.push(IrFunction {
        name: "test_uncertain_match".to_string(),
        id: "test_uncertain_match".to_string(),
        visibility: IrVisibility·Public,
        generics: [],
        params: [
            IrParam { name: "opt".to_string(), ty: IrType·Option { inner: Box·new(IrType·Int { width: 32, signed: yea }) }, evidence: IrEvidence·Uncertain, mutable: nay },
        ],
        return_type: IrType·Int { width: 32, signed: yea },
        return_evidence: IrEvidence·Known,
        body: ?IrOperation·Match {
            scrutinee: Box·new(IrOperation·Var {
                name: "opt".to_string(),
                id: "opt".to_string(),
                ty: IrType·Option { inner: Box·new(IrType·Int { width: 32, signed: yea }) },
                evidence: IrEvidence·Uncertain,
            }),
            arms: [
                IrMatchArm {
                    pattern: IrPattern·Ident {
                        name: "v".to_string(),
                        mutable: nay,
                        evidence: ?IrEvidence·Uncertain,
                    },
                    guard: null,
                    body: IrOperation·Return {
                        value: ?Box·new(IrOperation·Var { name: "v".to_string(), id: "v".to_string(), ty: IrType·Int { width: 32, signed: yea }, evidence: IrEvidence·Known }),
                        evidence: IrEvidence·Known,
                    },
                },
                IrMatchArm {
                    pattern: IrPattern·Literal {
                        value: LiteralValue·Null,
                    },
                    guard: null,
                    body: IrOperation·Return {
                        value: ?Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(0), ty: IrType·Int { width: 32, signed: yea }, evidence: IrEvidence·Known }),
                        evidence: IrEvidence·Known,
                    },
                },
            ],
            ty: IrType·Int { width: 32, signed: yea },
            evidence: IrEvidence·Known,
        },
        is_async: nay,
        is_unsafe: nay,
        span: null,
    });

    ≔ code = generate(module);

    // CG-009 BUG: Code currently generates "⎇ (1)" each ?v pattern
    // EXPECTED: Should generate "(opt.tag != TAG_NULL)" or similar non-null check
    assert_not_contains(&code, "⎇ (1)", "CG-009: should NOT generate '⎇ (1)' each ?pattern");
    assert_contains(&code, "TAG_NULL", "CG-009: should check TAG_NULL each ?pattern");

    println("PASS (2 cases)");
    yea
}
