//! Comprehensive Code Generation Test Suite
//!
//! Tests C code generation from IR, including type definitions,
//! function signatures, control flow, and evidence tagging.
//! Target: 100% codegen coverage for regression detection.

use crate::ir::*;
use crate::codegen::CodeGen;

// ============================================================================
// Test Helpers
// ============================================================================

/// Create a new code generator
fn new_codegen() -> !CodeGen {
    CodeGen::new()
}

/// Generate code from an IR module
fn generate(module: !IrModule) -> !String {
    let mut gen = CodeGen::new();
    gen.generate(module)
}

/// Create a simple function IR
fn simple_function(name: !&str, body: !IrOperation) -> !IrFunction {
    IrFunction {
        name: name.to_string(),
        id: name.to_string(),
        visibility: IrVisibility::Public,
        generics: [],
        params: [],
        return_type: IrType::Int { width: 32, signed: true },
        return_evidence: IrEvidence::Known,
        body: ?body,
        is_async: false,
        is_unsafe: false,
        span: null,
    }
}

/// Assert generated code contains a string
fn assert_contains(code: !&str, pattern: !&str, name: !&str) {
    if !code.contains(pattern) {
        panic(format!("FAIL {}: generated code does not contain '{}'", name, pattern));
    }
}

/// Assert generated code does NOT contain a string
fn assert_not_contains(code: !&str, pattern: !&str, name: !&str) {
    if code.contains(pattern) {
        panic(format!("FAIL {}: generated code should not contain '{}'", name, pattern));
    }
}

// ============================================================================
// 1. HEADER GENERATION
// ============================================================================

fn test_header_generation() -> !bool {
    print("  [1/12] Header generation... ");

    let module = IrModule::new("test.sg".to_string());
    let code = generate(module);

    // Should include runtime header
    assert_contains(&code, "#include", "has_include");
    assert_contains(&code, "sigil_runtime", "has_runtime");

    // Should have standard type definitions
    assert_contains(&code, "SigilValue", "has_sigil_value");

    println("PASS (3 cases)");
    true
}

// ============================================================================
// 2. FUNCTION DECLARATIONS
// ============================================================================

fn test_function_declarations() -> !bool {
    print("  [2/12] Function declarations... ");

    let mut module = IrModule::new("test.sg".to_string());
    module.functions.push(simple_function("foo", IrOperation::Return {
        value: ?Box::new(IrOperation::Literal {
            variant: LiteralVariant::Int,
            value: LiteralValue::Int(42),
            ty: IrType::Int { width: 32, signed: true },
            evidence: IrEvidence::Known,
        }),
        evidence: IrEvidence::Known,
    }));

    let code = generate(module);

    // Should have function declaration
    assert_contains(&code, "sigil_foo", "has_function_name");

    println("PASS (1 case)");
    true
}

// ============================================================================
// 3. FUNCTION PARAMETERS
// ============================================================================

fn test_function_params() -> !bool {
    print("  [3/12] Function parameters... ");

    let mut module = IrModule::new("test.sg".to_string());
    module.functions.push(IrFunction {
        name: "add".to_string(),
        id: "add".to_string(),
        visibility: IrVisibility::Public,
        generics: [],
        params: [
            IrParam { name: "a".to_string(), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known, mutable: false },
            IrParam { name: "b".to_string(), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known, mutable: false },
        ],
        return_type: IrType::Int { width: 32, signed: true },
        return_evidence: IrEvidence::Known,
        body: ?IrOperation::Return {
            value: ?Box::new(IrOperation::Binary {
                operator: BinaryOp::Add,
                left: Box::new(IrOperation::Var { name: "a".to_string(), id: "a".to_string(), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
                right: Box::new(IrOperation::Var { name: "b".to_string(), id: "b".to_string(), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
                ty: IrType::Int { width: 32, signed: true },
                evidence: IrEvidence::Known,
            }),
            evidence: IrEvidence::Known,
        },
        is_async: false,
        is_unsafe: false,
        span: null,
    });

    let code = generate(module);

    // Should have parameter handling
    assert_contains(&code, "sigil_add", "has_add_function");

    println("PASS (1 case)");
    true
}

// ============================================================================
// 4. LITERAL CODE GENERATION
// ============================================================================

fn test_literal_codegen() -> !bool {
    print("  [4/12] Literal generation... ");

    // Integer literal
    let mut module = IrModule::new("test.sg".to_string());
    module.functions.push(simple_function("int_lit", IrOperation::Return {
        value: ?Box::new(IrOperation::Literal {
            variant: LiteralVariant::Int,
            value: LiteralValue::Int(42),
            ty: IrType::Int { width: 32, signed: true },
            evidence: IrEvidence::Known,
        }),
        evidence: IrEvidence::Known,
    }));
    let code = generate(module);
    assert_contains(&code, "42", "int_literal");

    // Boolean literal
    let mut module2 = IrModule::new("test.sg".to_string());
    module2.functions.push(IrFunction {
        name: "bool_lit".to_string(),
        id: "bool_lit".to_string(),
        visibility: IrVisibility::Public,
        generics: [],
        params: [],
        return_type: IrType::Bool,
        return_evidence: IrEvidence::Known,
        body: ?IrOperation::Return {
            value: ?Box::new(IrOperation::Literal {
                variant: LiteralVariant::Bool,
                value: LiteralValue::Bool(true),
                ty: IrType::Bool,
                evidence: IrEvidence::Known,
            }),
            evidence: IrEvidence::Known,
        },
        is_async: false,
        is_unsafe: false,
        span: null,
    });
    let code2 = generate(module2);
    assert_contains(&code2, "sigil_bool_lit", "bool_function");

    // String literal
    let mut module3 = IrModule::new("test.sg".to_string());
    module3.functions.push(IrFunction {
        name: "str_lit".to_string(),
        id: "str_lit".to_string(),
        visibility: IrVisibility::Public,
        generics: [],
        params: [],
        return_type: IrType::Str,
        return_evidence: IrEvidence::Known,
        body: ?IrOperation::Return {
            value: ?Box::new(IrOperation::Literal {
                variant: LiteralVariant::String,
                value: LiteralValue::String("hello".to_string()),
                ty: IrType::Str,
                evidence: IrEvidence::Known,
            }),
            evidence: IrEvidence::Known,
        },
        is_async: false,
        is_unsafe: false,
        span: null,
    });
    let code3 = generate(module3);
    assert_contains(&code3, "hello", "string_literal");

    // Null literal
    let mut module4 = IrModule::new("test.sg".to_string());
    module4.functions.push(IrFunction {
        name: "null_lit".to_string(),
        id: "null_lit".to_string(),
        visibility: IrVisibility::Public,
        generics: [],
        params: [],
        return_type: IrType::Option { inner: Box::new(IrType::Int { width: 32, signed: true }) },
        return_evidence: IrEvidence::Uncertain,
        body: ?IrOperation::Return {
            value: ?Box::new(IrOperation::Literal {
                variant: LiteralVariant::Null,
                value: LiteralValue::Null,
                ty: IrType::Option { inner: Box::new(IrType::Int { width: 32, signed: true }) },
                evidence: IrEvidence::Uncertain,
            }),
            evidence: IrEvidence::Uncertain,
        },
        is_async: false,
        is_unsafe: false,
        span: null,
    });
    let code4 = generate(module4);
    assert_contains(&code4, "sigil_null_lit", "null_function");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 5. BINARY OPERATION CODE GENERATION
// ============================================================================

fn test_binary_codegen() -> !bool {
    print("  [5/12] Binary operations... ");

    // Addition
    let mut module = IrModule::new("test.sg".to_string());
    module.functions.push(simple_function("add", IrOperation::Return {
        value: ?Box::new(IrOperation::Binary {
            operator: BinaryOp::Add,
            left: Box::new(IrOperation::Literal { variant: LiteralVariant::Int, value: LiteralValue::Int(1), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
            right: Box::new(IrOperation::Literal { variant: LiteralVariant::Int, value: LiteralValue::Int(2), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
            ty: IrType::Int { width: 32, signed: true },
            evidence: IrEvidence::Known,
        }),
        evidence: IrEvidence::Known,
    }));
    let code = generate(module);
    assert_contains(&code, "+", "has_add_op");

    // Comparison
    let mut module2 = IrModule::new("test.sg".to_string());
    module2.functions.push(IrFunction {
        name: "cmp".to_string(),
        id: "cmp".to_string(),
        visibility: IrVisibility::Public,
        generics: [],
        params: [],
        return_type: IrType::Bool,
        return_evidence: IrEvidence::Known,
        body: ?IrOperation::Return {
            value: ?Box::new(IrOperation::Binary {
                operator: BinaryOp::Lt,
                left: Box::new(IrOperation::Literal { variant: LiteralVariant::Int, value: LiteralValue::Int(1), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
                right: Box::new(IrOperation::Literal { variant: LiteralVariant::Int, value: LiteralValue::Int(2), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
                ty: IrType::Bool,
                evidence: IrEvidence::Known,
            }),
            evidence: IrEvidence::Known,
        },
        is_async: false,
        is_unsafe: false,
        span: null,
    });
    let code2 = generate(module2);
    assert_contains(&code2, "<", "has_lt_op");

    println("PASS (2 cases)");
    true
}

// ============================================================================
// 6. CONTROL FLOW CODE GENERATION
// ============================================================================

fn test_control_flow_codegen() -> !bool {
    print("  [6/12] Control flow... ");

    // If statement
    let mut module = IrModule::new("test.sg".to_string());
    module.functions.push(simple_function("if_stmt", IrOperation::If {
        condition: Box::new(IrOperation::Literal { variant: LiteralVariant::Bool, value: LiteralValue::Bool(true), ty: IrType::Bool, evidence: IrEvidence::Known }),
        then_branch: Box::new(IrOperation::Return {
            value: ?Box::new(IrOperation::Literal { variant: LiteralVariant::Int, value: LiteralValue::Int(1), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
            evidence: IrEvidence::Known,
        }),
        else_branch: ?Box::new(IrOperation::Return {
            value: ?Box::new(IrOperation::Literal { variant: LiteralVariant::Int, value: LiteralValue::Int(0), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known }),
            evidence: IrEvidence::Known,
        }),
        ty: IrType::Int { width: 32, signed: true },
        evidence: IrEvidence::Known,
    }));
    let code = generate(module);
    assert_contains(&code, "if", "has_if");

    // Loop
    let mut module2 = IrModule::new("test.sg".to_string());
    module2.functions.push(simple_function("loop_stmt", IrOperation::Loop {
        variant: LoopVariant::Infinite,
        condition: null,
        iterator: null,
        body: Box::new(IrOperation::Break { value: null, evidence: IrEvidence::Known }),
        ty: IrType::Unit,
        evidence: IrEvidence::Known,
    }));
    let code2 = generate(module2);
    assert_contains(&code2, "while", "has_while");

    println("PASS (2 cases)");
    true
}

// ============================================================================
// 7. TYPE DEFINITION CODE GENERATION
// ============================================================================

fn test_typedef_codegen() -> !bool {
    print("  [7/12] Type definitions... ");

    let mut module = IrModule::new("test.sg".to_string());
    module.types.push(IrTypeDef::Struct {
        name: "Point".to_string(),
        generics: [],
        fields: [
            IrField { name: "x".to_string(), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known, visibility: IrVisibility::Public },
            IrField { name: "y".to_string(), ty: IrType::Int { width: 32, signed: true }, evidence: IrEvidence::Known, visibility: IrVisibility::Public },
        ],
        visibility: IrVisibility::Public,
    });

    let code = generate(module);
    assert_contains(&code, "Point", "has_struct_name");

    // Enum type
    let mut module2 = IrModule::new("test.sg".to_string());
    module2.types.push(IrTypeDef::Enum {
        name: "Option".to_string(),
        generics: ["T".to_string()],
        variants: [
            IrVariant { name: "Some".to_string(), fields: ?[IrType::Var(TypeVar::new(0))] },
            IrVariant { name: "None".to_string(), fields: null },
        ],
        visibility: IrVisibility::Public,
    });
    let code2 = generate(module2);
    assert_contains(&code2, "Option", "has_enum_name");

    println("PASS (2 cases)");
    true
}

// ============================================================================
// 8. EVIDENCE TAGGING
// ============================================================================

fn test_evidence_codegen() -> !bool {
    print("  [8/12] Evidence tagging... ");

    // Known evidence
    let mut module = IrModule::new("test.sg".to_string());
    module.functions.push(simple_function("known", IrOperation::Return {
        value: ?Box::new(IrOperation::Literal {
            variant: LiteralVariant::Int,
            value: LiteralValue::Int(42),
            ty: IrType::Int { width: 32, signed: true },
            evidence: IrEvidence::Known,
        }),
        evidence: IrEvidence::Known,
    }));
    let code = generate(module);
    // Generated code should handle known evidence
    assert_contains(&code, "sigil_known", "has_known_tag");

    // Uncertain evidence
    let mut module2 = IrModule::new("test.sg".to_string());
    module2.functions.push(IrFunction {
        name: "uncertain".to_string(),
        id: "uncertain".to_string(),
        visibility: IrVisibility::Public,
        generics: [],
        params: [],
        return_type: IrType::Option { inner: Box::new(IrType::Int { width: 32, signed: true }) },
        return_evidence: IrEvidence::Uncertain,
        body: ?IrOperation::Return {
            value: ?Box::new(IrOperation::Literal {
                variant: LiteralVariant::Null,
                value: LiteralValue::Null,
                ty: IrType::Option { inner: Box::new(IrType::Int { width: 32, signed: true }) },
                evidence: IrEvidence::Uncertain,
            }),
            evidence: IrEvidence::Uncertain,
        },
        is_async: false,
        is_unsafe: false,
        span: null,
    });
    let code2 = generate(module2);
    assert_contains(&code2, "sigil_uncertain", "has_uncertain_tag");

    println("PASS (2 cases)");
    true
}

