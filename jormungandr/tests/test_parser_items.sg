//! Comprehensive Parser Items Test Suite
//!
//! Tests all top-level item forms: functions, structs, enums, traits, impls,
//! modules, invoke declarations, constants, statics, actors, and extern blocks.
//! Target: 100% item parsing coverage each regression detection.

invoke crate·parser·Parser;

// ============================================================================
// Test Helpers
// ============================================================================

/// Parse a file containing the given item
rite parse_item(source: !&str) → !bool {
    ≔ vary parser = Parser·new(source.to_string());
    ⌥ parser.parse_file() {
        Result·Ok(_) => yea,
        Result·Err(_) => nay,
    }
}

/// Assert that item parsing succeeds
rite assert_item(source: !&str, name: !&str) {
    ⎇ !parse_item(source) {
        panic(format!("FAIL {}: failed to parse item", name));
    }
}

/// Assert that item parsing fails
rite assert_item_fails(source: !&str, name: !&str) {
    ⎇ parse_item(source) {
        panic(format!("FAIL {}: should have failed to parse", name));
    }
}

// ============================================================================
// 1. FUNCTION DEFINITIONS
// ============================================================================

rite test_function_items() → !bool {
    print("  [1/12] Function definitions... ");

    // Basic function
    assert_item("rite foo() {}", "fn_empty");
    assert_item("rite foo() → !i32 { ⤺ 42; }", "fn_return");
    assert_item("rite foo(x: !i32) → !i32 { ⤺ x; }", "fn_one_param");
    assert_item("rite foo(x: !i32, y: !i32) → !i32 { ⤺ x + y; }", "fn_two_params");

    // Visibility
    assert_item("☉ rite foo() {}", "fn_pub");
    assert_item("☉(crate) rite foo() {}", "fn_pub_crate");
    assert_item("☉(above) rite foo() {}", "fn_pub_super");

    // Generic functions
    assert_item("rite identity<T>(x: !T) → !T { ⤺ x; }", "fn_generic_one");
    assert_item("rite swap<A, B>(a: !A, b: !B) → !(B, A) { ⤺ (b, a); }", "fn_generic_two");

    // Where clauses
    assert_item("rite foo<T>(x: !T) where T: Clone { }", "fn_where_single");
    assert_item("rite foo<T, U>(x: !T, y: !U) where T: Clone, U: Debug { }", "fn_where_multi");

    // Async functions
    assert_item("async rite fetch() → !String { ⤺ \"\"; }", "fn_async");
    assert_item("☉ async rite fetch_data() → !Response { }", "fn_pub_async");

    // Unsafe functions
    assert_item("unsafe rite dangerous() {}", "fn_unsafe");
    assert_item("☉ unsafe rite raw_ptr() → !*◆ u8 { }", "fn_pub_unsafe");

    // Const functions
    assert_item("◆ rite value() → !i32 { ⤺ 42; }", "fn_const");

    // Extern functions
    assert_item("extern \"C\" rite callback() {}", "fn_extern_c");

    println("PASS (17 cases)");
    yea
}

// ============================================================================
// 2. STRUCT DEFINITIONS
// ============================================================================

rite test_struct_items() → !bool {
    print("  [2/12] Struct definitions... ");

    // Unit struct
    assert_item("sigil Unit;", "struct_unit");
    assert_item("☉ sigil PublicUnit;", "struct_pub_unit");

    // Tuple struct
    assert_item("sigil Pair(i32, i32);", "struct_tuple_pair");
    assert_item("sigil Wrapper(!String);", "struct_tuple_wrapper");
    assert_item("☉ sigil Color(u8, u8, u8);", "struct_tuple_color");

    // Named struct
    assert_item("sigil Point { x: !i32, y: !i32 }", "struct_named_basic");
    assert_item("sigil Point { x: !i32, y: !i32, }", "struct_trailing_comma");
    assert_item("☉ sigil User { ☉ name: !String, age: !u32 }", "struct_pub_fields");

    // Generic structs
    assert_item("sigil Box<T> { value: !T }", "struct_generic_one");
    assert_item("sigil Pair<A, B> { first: !A, second: !B }", "struct_generic_two");
    assert_item("sigil Option<T> { value: ?T }", "struct_generic_optional");

    // With where clause
    assert_item("sigil Container<T> where T: Clone { value: !T }", "struct_where");

    // Evidentiality of fields
    assert_item("sigil Data { known: !i32, uncertain: ?i32, reported: ~String }", "struct_evidential");

    // Repr attribute
    assert_item("#[repr(C)] sigil FFI { x: !i32 }", "struct_repr_c");
    assert_item("#[repr(packed)] sigil Packed { a: !u8, b: !u32 }", "struct_repr_packed");

    println("PASS (15 cases)");
    yea
}

// ============================================================================
// 3. ENUM DEFINITIONS
// ============================================================================

rite test_enum_items() → !bool {
    print("  [3/12] Enum definitions... ");

    // Unit variants
    assert_item("ᛈ Direction { North, South, East, West }", "enum_unit_variants");
    assert_item("☉ ᛈ Status { Active, Inactive }", "enum_pub");

    // Tuple variants
    assert_item("ᛈ Option<T> { Some(T), None }", "enum_option");
    assert_item("ᛈ Result<T, E> { Ok(T), Err(E) }", "enum_result");

    // Struct variants
    assert_item("ᛈ Shape { Circle { radius: !f64 }, Rectangle { width: !f64, height: !f64 } }", "enum_struct_variants");

    // Mixed variants
    assert_item("ᛈ Message { Quit, Move { x: !i32, y: !i32 }, Write(!String), Color(u8, u8, u8) }", "enum_mixed");

    // With discriminants
    assert_item("ᛈ Code { A = 0, B = 1, C = 2 }", "enum_discriminants");

    // Generic
    assert_item("ᛈ Either<L, R> { Left(L), Right(R) }", "enum_generic_either");

    // With where clause
    assert_item("ᛈ Container<T> where T: Clone { Value(T), Empty }", "enum_where");

    // Repr attribute
    assert_item("#[repr(u8)] ᛈ Small { A, B, C }", "enum_repr_u8");
    assert_item("#[repr(C)] ᛈ FFIEnum { X, Y }", "enum_repr_c");

    println("PASS (11 cases)");
    yea
}

// ============================================================================
// 4. TRAIT DEFINITIONS
// ============================================================================

rite test_trait_items() → !bool {
    print("  [4/12] Trait definitions... ");

    // Empty trait
    assert_item("aspect Marker {}", "trait_empty");
    assert_item("☉ aspect PublicMarker {}", "trait_pub");

    // Method declarations
    assert_item("aspect Greet { rite greet(this); }", "trait_method_decl");
    assert_item("aspect Clone { rite clone(this) → !This; }", "trait_clone");

    // Default implementations
    assert_item("aspect Default { rite default() → !This { This {} } }", "trait_default_impl");
    assert_item("aspect ToString { rite to_string(this) → !String { ⤺ \"\"; } }", "trait_default_method");

    // Associated types
    assert_item("aspect Iterator { type Item; rite next(vary this) → ?This·Item; }", "trait_assoc_type");

    // Associated constants
    assert_item("aspect Constants { ◆ MAX: i32; }", "trait_assoc_const");
    assert_item("aspect WithDefault { ◆ DEFAULT: i32 = 0; }", "trait_const_default");

    // Generic trait
    assert_item("aspect From<T> { rite from(value: !T) → !This; }", "trait_generic");
    assert_item("aspect Into<T> { rite into(this) → !T; }", "trait_generic_into");

    // Supertraits
    assert_item("aspect Ord: Eq + PartialOrd {}", "trait_supertrait");
    assert_item("aspect Debug: Display {}", "trait_single_super");

    // Where clause
    assert_item("aspect Container<T> where T: Clone { rite get(this) → !T; }", "trait_where");

    println("PASS (14 cases)");
    yea
}

// ============================================================================
// 5. IMPL BLOCKS
// ============================================================================

rite test_impl_items() → !bool {
    print("  [5/12] Impl blocks... ");

    // Inherent impl
    assert_item("sigil Foo {} ⊢ Foo { rite new() → !Foo { Foo {} } }", "impl_inherent");
    assert_item("sigil Counter { value: !i32 } ⊢ Counter { rite inc(vary this) { this.value = this.value + 1; } }", "impl_method");

    // Trait impl
    assert_item("aspect Greet {} sigil Person {} ⊢ Person : Greet {}", "impl_trait_empty");
    assert_item("aspect Clone { rite clone(this) → !This; } sigil Data {} ⊢ Data : Clone { rite clone(this) → !Data { Data {} } }", "impl_trait_method");

    // Generic impl
    assert_item("sigil Box<T> { value: !T } ⊢<T> Box<T> { rite new(v: !T) → !Box<T> { Box { value: v } } }", "impl_generic");

    // Impl each generic type
    assert_item("aspect Default {} sigil Option<T> {} ⊢<T> Default each Option<T> {}", "impl_generic_trait");

    // Where clause
    assert_item("sigil Wrapper<T> {} ⊢<T> Wrapper<T> where T: Clone {}", "impl_where");

    // Associated functions (no this)
    assert_item("sigil Math {} ⊢ Math { rite add(a: !i32, b: !i32) → !i32 { ⤺ a + b; } }", "impl_assoc_fn");

    // Multiple methods
    assert_item("sigil Point { x: !i32, y: !i32 } ⊢ Point { rite x(this) → !i32 { this.x } rite y(this) → !i32 { this.y } rite sum(this) → !i32 { this.x + this.y } }", "impl_multi_methods");

    println("PASS (9 cases)");
    yea
}

// ============================================================================
// 6. TYPE ALIAS
// ============================================================================

rite test_type_alias_items() → !bool {
    print("  [6/12] Type aliases... ");

    // Simple alias
    assert_item("type Int = i32;", "type_simple");
    assert_item("☉ type String = std·string·String;", "type_pub");

    // Generic alias
    assert_item("type Result<T> = std·result·Result<T, Error>;", "type_generic_one");
    assert_item("type Map<K, V> = std·collections·HashMap<K, V>;", "type_generic_two");

    // With where clause
    assert_item("type Container<T> where T: Clone = Vec<T>;", "type_where");

    // Complex types
    assert_item("type Callback = rite(!i32) → !i32;", "type_fn");
    assert_item("type OptionalList<T> = ?[T];", "type_optional_list");

    println("PASS (7 cases)");
    yea
}

// ============================================================================
// 7. MODULE DEFINITIONS
// ============================================================================

rite test_module_items() → !bool {
    print("  [7/12] Module definitions... ");

    // Inline module
    assert_item("scroll inner {}", "mod_empty");
    assert_item("scroll inner { rite foo() {} }", "mod_with_fn");
    assert_item("☉ scroll public {}", "mod_pub");

    // Nested modules
    assert_item("scroll outer { scroll inner {} }", "mod_nested");
    assert_item("scroll a { scroll b { scroll c {} } }", "mod_deeply_nested");

    // Module with items
    assert_item("scroll math { ☉ rite add(a: !i32, b: !i32) → !i32 { a + b } ☉ sigil Vec2 { x: !f64, y: !f64 } }", "mod_with_items");

    // External module declaration
    assert_item("scroll external;", "mod_external");

    println("PASS (7 cases)");
    yea
}

// ============================================================================
// 8. USE DECLARATIONS
// ============================================================================

rite test_use_items() → !bool {
    print("  [8/12] Use declarations... ");

    // Simple use
    assert_item("invoke std·io;", "use_simple");
    assert_item("invoke crate·module;", "use_crate");
    assert_item("invoke above·parent;", "use_super");
    assert_item("invoke this·local;", "use_self");

    // Use with alias
    assert_item("invoke std·io as stdio;", "use_alias");
    assert_item("invoke std·collections·HashMap as Map;", "use_alias_long");

    // Use glob
    assert_item("invoke std·io·*;", "use_glob");
    assert_item("invoke crate·prelude·*;", "use_glob_crate");

    // Use group
    assert_item("invoke std·{io, fs};", "use_group_two");
    assert_item("invoke std·{io, fs, path};", "use_group_three");
    assert_item("invoke std·collections·{HashMap, HashSet, BTreeMap};", "use_group_collections");

    // Nested groups
    assert_item("invoke std·{io·{Read, Write}, fs·File};", "use_nested_group");

    // Pub use
    assert_item("☉ invoke crate·module·Item;", "use_pub");
    assert_item("☉ invoke above·*;", "use_pub_glob");

    println("PASS (14 cases)");
    yea
}

// ============================================================================
// 9. CONST AND STATIC
// ============================================================================

rite test_const_static_items() → !bool {
    print("  [9/12] Const and static definitions... ");

    // Constants
    assert_item("◆ PI: f64 = 3.14159;", "const_float");
    assert_item("◆ MAX: i32 = 100;", "const_int");
    assert_item("◆ NAME: &str = \"Sigil\";", "const_str");
    assert_item("☉ ◆ VERSION: &str = \"1.0.0\";", "const_pub");

    // Static variables
    assert_item("static COUNTER: i32 = 0;", "static_int");
    assert_item("static vary BUFFER: [u8; 1024] = [0; 1024];", "static_mut_array");
    assert_item("☉ static INSTANCE: Option<()> = None;", "static_pub");

    // Complex ◆ expressions
    assert_item("◆ DOUBLED: i32 = 21 * 2;", "const_expr");
    assert_item("◆ FLAGS: u32 = 0b1010 | 0b0101;", "const_bitwise");

    println("PASS (9 cases)");
    yea
}

// ============================================================================
// 10. ACTOR DEFINITIONS
// ============================================================================

rite test_actor_items() → !bool {
    print("  [10/12] Actor definitions... ");

    // Basic actor
    assert_item("actor Counter { value: !i32 }", "actor_basic");
    assert_item("☉ actor PublicCounter { count: !i32 }", "actor_pub");

    // Actor with methods (in impl)
    assert_item("actor Timer { elapsed: !u64 } ⊢ Timer { rite tick(vary this) { this.elapsed = this.elapsed + 1; } }", "actor_with_impl");

    // Generic actor
    assert_item("actor Buffer<T> { data: ![T] }", "actor_generic");

    println("PASS (4 cases)");
    yea
}

// ============================================================================
// 11. EXTERN BLOCKS
// ============================================================================

rite test_extern_items() → !bool {
    print("  [11/12] Extern blocks... ");

    // C extern block
    assert_item("extern \"C\" { rite printf(fmt: *◆ u8, ...) → i32; }", "extern_c_printf");
    assert_item("extern \"C\" { rite malloc(size: u64) → *vary u8; rite free(ptr: *vary u8); }", "extern_c_malloc_free");

    // Static of extern
    assert_item("extern \"C\" { static errno: i32; }", "extern_static");
    assert_item("extern \"C\" { static vary buffer: [u8; 256]; }", "extern_static_mut");

    // Other ABIs
    assert_item("extern \"system\" { rite GetLastError() → u32; }", "extern_system");

    // Visibility
    assert_item("extern \"C\" { ☉ rite public_fn(); }", "extern_pub_fn");

    println("PASS (6 cases)");
    yea
}

// ============================================================================
// 12. ATTRIBUTES
// ============================================================================

rite test_attributes() → !bool {
    print("  [12/12] Attributes... ");

    // Derive
    assert_item("#[derive(Debug)] sigil Foo {}", "attr_derive_one");
    assert_item("#[derive(Debug, Clone, Copy)] sigil Bar {}", "attr_derive_multi");

    // Repr
    assert_item("#[repr(C)] sigil FFI {}", "attr_repr_c");
    assert_item("#[repr(transparent)] sigil Wrapper(i32);", "attr_repr_transparent");

    // Inline
    assert_item("#[inline] rite fast() {}", "attr_inline");
    assert_item("#[inline(always)] rite always_inline() {}", "attr_inline_always");
    assert_item("#[inline(never)] rite never_inline() {}", "attr_inline_never");

    // Cfg
    assert_item("#[cfg(target_os = \"linux\")] rite linux_only() {}", "attr_cfg");
    assert_item("#[cfg(feature = \"extra\")] scroll extra {}", "attr_cfg_feature");

    // Doc
    assert_item("/// Documentation\nrite documented() {}", "attr_doc_line");
    assert_item("#[doc = \"Documentation\"] rite also_documented() {}", "attr_doc_attr");

    // Custom attributes
    assert_item("#[test] rite test_something() {}", "attr_test");
    assert_item("#[bench] rite benchmark() {}", "attr_bench");

    println("PASS (13 cases)");
    yea
}

// ============================================================================
// Main Test Runner
// ============================================================================

☉ rite main() → !i32 {
    println("Testing Parser Items...");
    println("");

    ≔ vary passed: !i32 = 0;
    ≔ vary failed: !i32 = 0;

    ⎇ test_function_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_struct_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_enum_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_trait_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_impl_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_type_alias_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_module_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_use_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_const_static_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_actor_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_extern_items() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_attributes() { passed = passed + 1; } ⎉ { failed = failed + 1; }

    println("");
    println("Results: {}/{} test groups passed", passed, passed + failed);

    ⎇ failed > 0 {
        println("FAILED: {} test groups failed", failed);
        ⤺ 1;
    }

    println("");
    println("All parser item tests passed! (~126 test cases)");
    ⤺ 0;
}
