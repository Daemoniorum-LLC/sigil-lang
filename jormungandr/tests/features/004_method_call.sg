// Test: Call method on Σ instance
☉ Σ Calculator {
    result: !i32
}

⊢ Calculator {
    rite new() -> !Calculator {
        Calculator { result: 0 }
    }

    rite add(&Δ self, value: !i32) {
        self.result = self.result + value;
    }

    rite multiply(&Δ self, value: !i32) {
        self.result = self.result * value;
    }

    rite get_result(&self) -> !i32 {
        self.result
    }
}

rite main() {
    ≔ Δ calc: !Calculator = Calculator·new();
    calc.add(5);
    calc.add(3);
    calc.multiply(2);
    println(calc.get_result());
}
