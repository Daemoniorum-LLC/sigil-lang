// Test: ⌥ expression on ᛈ
☉ ᛈ Status {
    Active,
    Paused,
    Stopped
}

λ describe(s: !Status) -> !String {
    ⌥ s {
        Status·Active => "running",
        Status·Paused => "paused",
        Status·Stopped => "stopped"
    }
}

λ main() {
    ≔ s: !Status = Status·Active;
    println(describe(s));
}
