// Test: ⊢ block with methods
☉ Σ Counter {
    value: !i32
}

⊢ Counter {
    λ new() -> !Counter {
        Counter { value: 0 }
    }

    λ increment(&Δ self) {
        self.value = self.value + 1;
    }

    λ get(&self) -> !i32 {
        self.value
    }
}

λ main() {
    ≔ Δ c: !Counter = Counter·new();
    c.increment();
    c.increment();
    println(c.get());
}
