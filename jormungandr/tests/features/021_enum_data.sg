// Test: Enum variants with data
☉ ᛈ Status {
    Success(!i32),
    Failure(!String)
}

rite process(r: !Status) → !i32 {
    ⌥ r {
        Status·Success(value) => value,
        Status·Failure(_) => -1
    }
}

rite main() {
    ≔ result: !Status = Status·Success(42);
    println(process(result));
}
