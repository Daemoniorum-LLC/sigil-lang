// Test: Enum variants with data
pub enum Status {
    Success(!i32),
    Failure(!String)
}

fn process(r: !Status) -> !i32 {
    match r {
        Status::Success(value) => value,
        Status::Failure(_) => -1
    }
}

fn main() {
    let result: !Status = Status::Success(42);
    println(process(result));
}
