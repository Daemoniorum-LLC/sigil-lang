// Test: Call trait method through concrete type
pub trait Describable {
    fn describe(&self) -> !String;
}

pub struct Book {
    title: !String,
    author: !String
}

impl Describable for Book {
    fn describe(&self) -> !String {
        let mut result: !String = self.title.clone();
        result.push_str(" by ");
        result.push_str(&self.author);
        result
    }
}

fn main() {
    let book: !Book = Book {
        title: "The Sigil Language",
        author: "The Daemoniorum Team"
    };
    println(book.describe());
}
