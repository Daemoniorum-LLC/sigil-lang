// Test: Call Θ method through concrete type
☉ Θ Describable {
    rite describe(&self) -> !String;
}

☉ Σ Book {
    title: !String,
    author: !String
}

⊢ Describable ∀ Book {
    rite describe(&self) -> !String {
        ≔ Δ result: !String = self.title.clone();
        result.push_str(" by ");
        result.push_str(&self.author);
        result
    }
}

rite main() {
    ≔ book: !Book = Book {
        title: "The Sigil Language",
        author: "The Daemoniorum Team"
    };
    println(book.describe());
}
