// Test: Define aspect with method signatures
☉ aspect Displayable {
    rite display(&this) → !String;
}

☉ sigil Message {
    text: !String
}

⊢ Message : Displayable {
    rite display(&this) → !String {
        this.text.clone()
    }
}

rite main() {
    ≔ msg: !Message = Message { text: "Hello, Trait!" };
    println(msg.display());
}
