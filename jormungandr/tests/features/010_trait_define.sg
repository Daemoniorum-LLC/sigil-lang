// Test: Define Θ with method signatures
☉ Θ Displayable {
    rite display(&self) -> !String;
}

☉ Σ Message {
    text: !String
}

⊢ Displayable ∀ Message {
    rite display(&self) -> !String {
        self.text.clone()
    }
}

rite main() {
    ≔ msg: !Message = Message { text: "Hello, Trait!" };
    println(msg.display());
}
