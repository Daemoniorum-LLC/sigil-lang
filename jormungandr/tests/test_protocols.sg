// ============================================================================
// Test Helpers
// ============================================================================

/// Parse and type check protocol code
rite check_source(source: !&str) → !bool {
    ≔ vary parser = Parser·new(source.to_string());
    ≔ ast = ⌥ parser.parse_file() {
        Result·Ok(a) => a,
        Result·Err(_) => ⤺ nay,
    };
    ≔ vary checker = TypeChecker·new();
    ⌥ checker.check_file(ast) {
        Result·Ok(_) => yea,
        Result·Err(_) => nay,
    }
}

rite assert_checks(source: !&str, name: !&str) {
    ⎇ !check_source(source) {
        panic(format!("FAIL {}: type check failed", name));
    }
}

rite assert_fails(source: !&str, name: !&str) {
    ⎇ check_source(source) {
        panic(format!("FAIL {}: should have failed", name));
    }
}

// ============================================================================
// 1. HTTP GET REQUESTS
// ============================================================================

rite test_http_get() → !bool {
    print("  [1/10] HTTP GET requests... ");

    // Basic GET
    assert_checks("
        async rite fetch() → ~Response {
            ⤺ http·get(\"https://api.example.com/data\").await;
        }
    ", "http_get_basic");

    // GET with headers
    assert_checks("
        async rite fetch_auth() → ~Response {
            ⤺ http·get(\"https://api.example.com/data\")
                .header(\"Authorization\", \"Bearer token\")
                .await;
        }
    ", "http_get_headers");

    // GET with timeout
    assert_checks("
        async rite fetch_timeout() → ~Response {
            ⤺ http·get(\"https://api.example.com/data\")
                .timeout(5000)
                .await;
        }
    ", "http_get_timeout");

    // GET with query params
    assert_checks("
        async rite fetch_query() → ~Response {
            ⤺ http·get(\"https://api.example.com/search\")
                .query(\"q\", \"sigil\")
                .query(\"limit\", \"10\")
                .await;
        }
    ", "http_get_query");

    // Response is reported evidence (external data)
    assert_checks("
        async rite process() → !String {
            ≔ response: ~Response = http·get(\"https://api.example.com\").await;
            // Must validate before using as known
            ≔ body: ~String = response.text().await;
            ⤺ body.validate()!;  // Explicit trust boundary
        }
    ", "http_evidence_boundary");

    println("PASS (5 cases)");
    yea
}

// ============================================================================
// 2. HTTP POST REQUESTS
// ============================================================================

rite test_http_post() → !bool {
    print("  [2/10] HTTP POST requests... ");

    // Basic POST
    assert_checks("
        async rite create() → ~Response {
            ⤺ http·post(\"https://api.example.com/items\")
                .json({ \"name\": \"item\" })
                .await;
        }
    ", "http_post_basic");

    // POST with form data
    assert_checks("
        async rite submit_form() → ~Response {
            ⤺ http·post(\"https://api.example.com/form\")
                .form([
                    (\"username\", \"user\"),
                    (\"password\", \"pass\"),
                ])
                .await;
        }
    ", "http_post_form");

    // POST with raw body
    assert_checks("
        async rite send_raw() → ~Response {
            ⤺ http·post(\"https://api.example.com/raw\")
                .body(\"raw data\")
                .header(\"Content-Type\", \"text/plain\")
                .await;
        }
    ", "http_post_raw");

    // POST with JSON serialization
    assert_checks("
        sigil Item { name: !String, value: !i32 }
        async rite create_item(item: !Item) → ~Response {
            ⤺ http·post(\"https://api.example.com/items\")
                .json(item)
                .await;
        }
    ", "http_post_json_struct");

    println("PASS (4 cases)");
    yea
}

