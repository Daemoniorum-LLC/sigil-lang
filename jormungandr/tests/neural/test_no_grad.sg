//! Test: no_grad context disables gradient tracking
//! Spec: 14-NEURAL.md §3.1
//! Priority: P1
//! Used for inference mode where gradients aren't needed

rite main() {
    println("=== Testing no_grad context ===");
    println("");

    // =========================================================================
    // Basic no_grad Context
    // =========================================================================

    // Test 1: Operations in no_grad don't track gradients
    ≔ x = Tensor·randn([4]);

    no_grad {
        ≔ y = x * 2.0;
        // y should work but not track gradients
        assert(y.shape() == [4], "Operation works in no_grad");
    }
    println("  [1] Basic no_grad: passed");

    // Test 2: Multiple operations in no_grad
    no_grad {
        ≔ a = Tensor·randn([3, 3]);
        ≔ b = Tensor·randn([3, 3]);
        ≔ c = a + b;
        ≔ d = c * 2.0;
        ≔ e = d|gelu;
        assert(e.shape() == [3, 3], "Chain works in no_grad");
    }
    println("  [2] Multiple ops: passed");

    // Test 3: Matmul in no_grad
    no_grad {
        ≔ w = Tensor·randn([4, 3]);
        ≔ x = Tensor·randn([2, 4]);
        ≔ y = x @ w;
        assert(y.shape() == [2, 3], "Matmul works in no_grad");
    }
    println("  [3] Matmul in no_grad: passed");

    println("");

    // =========================================================================
    // Inference Mode Pattern
    // =========================================================================

    // Test 4: Forward pass without gradient tracking
    ≔ w1 = Tensor·randn([4, 3]);
    ≔ w2 = Tensor·randn([3, 2]);
    ≔ input = Tensor·randn([2, 4]);

    no_grad {
        // Simulate inference
        ≔ h = input @ w1;
        ≔ h_act = h|gelu;
        ≔ output = h_act @ w2;
        ≔ probs = output|softmax;
        ≔ pred = probs|argmax;
        assert(pred >= 0, "Inference produces valid prediction");
    }
    println("  [4] Inference mode: passed");

    // Test 5: Softmax and argmax in no_grad
    no_grad {
        ≔ logits = Tensor·from([1.0, 2.0, 3.0, 4.0]);
        ≔ probs = logits|softmax;
        ≔ pred = probs|argmax;
        assert(pred == 3, "Argmax correct in no_grad");
    }
    println("  [5] Softmax/argmax: passed");

    println("");

    // =========================================================================
    // Nested no_grad
    // =========================================================================

    // Test 6: Nested no_grad blocks
    no_grad {
        ≔ a = Tensor·randn([3]);
        no_grad {
            ≔ b = a * 2.0;
            assert(b.shape() == [3], "Nested works");
        }
        ≔ c = a * 3.0;  // Use * instead of + (tensor+scalar not implemented)
        assert(c.shape() == [3], "After nested works");
    }
    println("  [6] Nested no_grad: passed");

    println("");

    // =========================================================================
    // Gradient Behavior
    // =========================================================================

    // Test 7: Gradients outside no_grad still work
    ≔ param = Tensor·randn([3]);
    ≔ loss = (param * param)|Σ;
    ≔ grads = loss|∇;
    // Gradients should be computed
    println("  [7] Gradients outside no_grad: passed");

    // Test 8: No gradients computed inside no_grad
    // Note: This test verifies no crash, actual grad tracking is P1 feature
    no_grad {
        ≔ p = Tensor·randn([3]);
        ≔ l = (p * p)|Σ;
        // Should not crash, but gradients won't be tracked
    }
    println("  [8] No gradient tracking: passed");

    println("");

    // =========================================================================
    // Return Values from no_grad
    // =========================================================================

    // Test 9: Value escapes no_grad block
    ≔ result = no_grad {
        ≔ t = Tensor·from([1.0, 2.0, 3.0]);
        ≔ s = t|softmax;
        s|argmax
    };
    assert(result == 2, "Value escapes no_grad");
    println("  [9] Return value: passed");

    // Test 10: Tensor escapes no_grad block
    ≔ tensor_result = no_grad {
        ≔ t = Tensor·from([1.0, 2.0, 3.0]);
        t|gelu
    };
    assert(tensor_result.shape() == [3], "Tensor escapes no_grad");
    println("  [10] Tensor return: passed");

    println("");
    println("=== All no_grad tests passed ===");
}
