// Test: Necessity verification operator (□)
// Spec: 11-HOLOGRAPHIC.md § 4.2 Necessity Verification
// Priority: P0 - Bootstrap Critical
//
// The □ operator verifies and promotes evidence

fn main() {
    let node~ = fetch_untrusted_data();
    let verified! = node~|□verify;  // Hash verification promotes ~ to !
    println(verified!);
}
