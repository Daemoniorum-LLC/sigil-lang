// Test: Possibility operator (◊)
// Spec: 11-HOLOGRAPHIC.md § 3.2 Possibility Queries
// Priority: P0 - Bootstrap Critical
//
// The ◊ operator extracts approximate answers from sketches

use sketch::HyperLogLog;

fn main() {
    let hll = HyperLogLog::<14>::new();
    hll.insert(1);
    hll.insert(2);
    hll.insert(3);
    let count◊ = hll|◊count;  // Approximate cardinality
    println(count◊);
}
