// Test: Multiple values through channel
// Spec: 06-CONCURRENCY.md § 2.3 Channel Buffering
// Priority: P1 - Standard Feature

fn main() {
    let ch = channel_new();

    // Send multiple values
    channel_send(ch, 1);
    channel_send(ch, 2);
    channel_send(ch, 3);

    // Receive in FIFO order
    let a = channel_try_recv(ch);
    let b = channel_try_recv(ch);
    let c = channel_try_recv(ch);

    println(a);
    println(b);
    println(c);
}
