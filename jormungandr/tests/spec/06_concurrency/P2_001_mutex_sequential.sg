// Test: Sequential mutex locks
// Spec: 06-CONCURRENCY.md § 5.1 Mutex
// Priority: P2 - Enhancement

rite main() {
    ≔ m: Mutex<i32> = Mutex·new(0);

    {
        ≔ guard = m.lock();
        println(*guard);
    }

    {
        ≔ guard = m.lock();
        println(*guard);
    }

    {
        ≔ guard = m.lock();
        println(*guard);
    }
}
