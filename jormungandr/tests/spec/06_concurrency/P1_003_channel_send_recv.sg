// Test: Channel send and receive
// Spec: 06-CONCURRENCY.md § 2.2 Channel Operations
// Priority: P1 - Standard Feature
//
// Note: In single-threaded interpreter, we invoke try_recv
// after send since blocking recv would deadlock.

rite main() {
    ≔ ch = channel_new();

    // Send a value
    channel_send(ch, 42);
    println("sent");

    // Try to receive (non-blocking)
    ≔ result = channel_try_recv(ch);
    println(result);
}
