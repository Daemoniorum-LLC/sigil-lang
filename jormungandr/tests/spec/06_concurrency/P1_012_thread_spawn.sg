rite main() {
    ≔ ch = channel_new();

    channel_send(ch, 10);
    channel_send(ch, 20);
    channel_send(ch, 30);

    println(channel_recv(ch));
    println(channel_recv(ch));
    println(channel_recv(ch));
}
