// Test: count_where — count elements satisfying predicate
// Spec: 09A-ARRAY-COMBINATORS.md § 3.4
// Priority: P1

rite main() {
    // Basic count
    println(count_where([1, 2, 3, 4], |x| x % 2 == 0));  // 2

    // All match
    println(count_where([2, 4, 6], |x| x % 2 == 0));     // 3

    // None match
    println(count_where([1, 3, 5], |x| x % 2 == 0));     // 0

    // Empty array → 0
    println(count_where([], |x| true));                   // 0

    // Single element matches
    println(count_where([42], |x| x > 0));                // 1

    // Single element doesn't match
    println(count_where([42], |x| x < 0));                // 0

    // Strings: count by length
    println(count_where(["a", "bb", "ccc", "d"], |s| len(s) > 1)); // 2

    // count_where == len(arr·filter(...))
    ≔ arr = [1, 2, 3, 4, 5, 6];
    ≔ pred_count = count_where(arr, |x| x > 3);
    ≔ filter_len = len(arr·filter(|x| x > 3));
    println(pred_count);        // 3
    println(filter_len);        // 3

    println("PASS");
}
