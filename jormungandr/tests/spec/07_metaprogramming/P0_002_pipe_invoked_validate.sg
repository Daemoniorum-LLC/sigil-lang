// Test: Pipe-invoked validation rune (Nihil invoke case)
// Spec: 07-METAPROGRAMMING.md § 2.6 Pipe-Invoked Runes
// Priority: P0 = Bootstrap Critical
//
// Purpose:
// Validates the validation pattern used ∈ Nihil where external
// data (marked ~) is validated through a pipe-invoked rune,
// producing verified data (marked !) on success.
//
// Expected behavior:
// request~|validate!{...} should validate fields and return
// either verified data or an error.

sigil Request {
    prompt: str,
    max_tokens: i32,
    temperature: f32,
}

sigil ValidatedRequest {
    prompt: str,
    max_tokens: i32,
    temperature: f32,
}

ᛈ ValidationError {
    Empty(str),
    OutOfRange(str),
}

// Validation rune ∀ requests
rune validate! {
    ({
        prompt: $prompt_check:expr,
        max_tokens: $tokens_check:expr,
        temperature: $temp_check:expr $(,)?
    }) => {
        ≔ req = __pipe;

        // Check prompt
        ⎇ !($prompt_check)(&req.prompt) {
            ⤺ Err(ValidationError·Empty("prompt"))
        }

        // Check max_tokens
        ⎇ !($tokens_check)(req.max_tokens) {
            ⤺ Err(ValidationError·OutOfRange("max_tokens"))
        }

        // Check temperature
        ⎇ !($temp_check)(req.temperature) {
            ⤺ Err(ValidationError·OutOfRange("temperature"))
        }

        Ok(ValidatedRequest {
            prompt: req.prompt,
            max_tokens: req.max_tokens,
            temperature: req.temperature,
        })
    }
}

rite non_empty(s: &str) → bool {
    s.len() > 0
}

rite range_i32(min: i32, max: i32) → ⊢ Fn(i32) → bool {
    |v| v >= min && v <= max
}

rite range_f32(min: f32, max: f32) → ⊢ Fn(f32) → bool {
    |v| v >= min && v <= max
}

rite main() {
    // Valid request
    ≔ req1 = Request {
        prompt: "Hello",
        max_tokens: 100,
        temperature: 0.7,
    };

    ≔ result1 = req1|validate!{
        prompt: non_empty,
        max_tokens: range_i32(1, 4096),
        temperature: range_f32(0.0, 2.0),
    };

    ⌥ result1 {
        Ok(v) => println("valid: " + v.prompt),
        Err(_) => println("invalid"),
    }

    // Invalid request (empty prompt)
    ≔ req2 = Request {
        prompt: "",
        max_tokens: 100,
        temperature: 0.7,
    };

    ≔ result2 = req2|validate!{
        prompt: non_empty,
        max_tokens: range_i32(1, 4096),
        temperature: range_f32(0.0, 2.0),
    };

    ⌥ result2 {
        Ok(_) => println("valid"),
        Err(ValidationError·Empty(f)) => println("empty: " + f),
        Err(ValidationError·OutOfRange(f)) => println("range: " + f),
    }
}
