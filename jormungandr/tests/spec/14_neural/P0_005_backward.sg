// Test: Backward pass (autograd)
// Spec: 14-NEURAL.md § 3.2 Backpropagation
// Priority: P0 - Bootstrap Critical

rite main() {
    ≔ w: Tensor<[2, 3]> = randn()|requires_grad(true);
    ≔ x: Tensor<[3, 1]> = randn();
    ≔ y = w @ x;
    ≔ loss = y|Σ;  // Sum all elements
    loss|backward;
    println(w.grad.is_some());
}
