// Test: Hadamard (element-wise) product (⊙)
// Spec: 14-NEURAL.md § 1.2 Neural Operators
// Priority: P0 - Bootstrap Critical

fn main() {
    let a: Tensor<[2, 2]> = Tensor::from([[1.0, 2.0], [3.0, 4.0]]);
    let b: Tensor<[2, 2]> = Tensor::from([[2.0, 2.0], [2.0, 2.0]]);
    let c = a ⊙ b;  // Element-wise multiply
    println(c[0][0]);  // 1*2 = 2
    println(c[1][1]);  // 4*2 = 8
}
