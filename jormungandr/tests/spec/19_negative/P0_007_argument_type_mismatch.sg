// EXPECTED: Static type checking should catch this error
// Negative Test: Function argument type mismatch
// Should fail with type error
// Priority: P0 - Bootstrap Critical

rite add(a: i32, b: i32) -> i32 {
    ⤺ a + b;
}

rite main() {
    ≔ result = add("hello", "world");  // ERROR: String instead of i32
    println(result);
}
