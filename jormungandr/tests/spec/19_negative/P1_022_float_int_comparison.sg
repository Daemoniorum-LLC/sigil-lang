// EXPECTED: Static type checking should catch this error
// Negative Test: comparing a f64 against an integer literal
// Priority: P1
// Issue: sigil-lang#114 (gap S128), reached via #112
//
// This program is the one every codegen backend must agree to refuse. It was
// the reproduction for #114, where `sigil wasm` and `sigil rust` returned exit
// 0 for it and `sigil wasm` emitted a structurally valid, instantiable module —
// so the backend had silently chosen some meaning for a comparison the type
// checker calls meaningless.
//
// This case pins the type checker's verdict. It does NOT pin the exit codes of
// the codegen commands, because the suite runs programs through the interpreter
// and has no way to ask what `sigil wasm` returned. That absence is worth
// naming: it is why #114 survived #96, which fixed the same thing for `llvm`
// and `compile` while nothing asked the other two.

rite bad(x: f64) -> i64! {
    ⎇ x ≥ 70 { 1 } ⎉ { 0 }   // SHOULD ERROR: F64 compared against I64
}

rite main() {
    println(bad(0.5));
}
