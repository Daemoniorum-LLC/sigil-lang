// P1_002_syscall_mmap.sg
// Test: Memory allocation patterns (interpreter-compatible)
// Phase A: Platform Syscalls
//
// This test verifies memory operations using interpreter arrays.

rite main() {
    // Test 1: Allocate array (simulates mmap allocation)
    ≔ Δ buffer = [];
    buffer.push(0);
    buffer.push(0);
    buffer.push(0);
    buffer.push(0);
    buffer.push(0);
    buffer.push(0);
    buffer.push(0);
    buffer.push(0);
    buffer.push(0);
    buffer.push(0);
    assert_eq!(buffer.len(), 10);
    println("alloc_ok");

    // Test 2: Write to allocated memory
    buffer[0] = 42;
    buffer[9] = 255;
    assert_eq!(buffer[0], 42);
    println("write_ok");

    // Test 3: Read from allocated memory
    ≔ val1 = buffer[0];
    ≔ val2 = buffer[9];
    assert_eq!(val1, 42);
    assert_eq!(val2, 255);
    println("read_ok");

    // Test 4: Clear memory (simulates unmap)
    buffer.clear();
    assert_eq!(buffer.len(), 0);
    println("unmap_ok");

    // Test 5: Large allocation - build via push
    ≔ Δ large = [];
    ≔ Δ idx = 0;
    ⟳ idx < 1024 {
        large.push(idx);
        idx = idx + 1;
    }
    assert_eq!(large.len(), 1024);
    println("large_alloc_ok");

    // Test 6: Verify pattern built via push
    assert_eq!(large[0], 0);
    assert_eq!(large[100], 100);
    assert_eq!(large[500], 500);
    println("large_write_ok");

    // Test 7: Verify pattern matches
    ≔ Δ ok = true;
    ok = ok && (large[0] == 0);
    ok = ok && (large[100] == 100);
    ok = ok && (large[1023] == 1023);
    ⎇ ok {
        println("large_verify_ok");
    } ⎉ {
        println("large_verify_fail");
    }

    println("done");
}
