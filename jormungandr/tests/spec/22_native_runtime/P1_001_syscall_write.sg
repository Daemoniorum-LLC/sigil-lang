// P1_001_syscall_write.sg
// Test: Write operations using Sys module
// Phase A: Platform Syscalls
//
// This test verifies the Sys·write syscall abstraction.

rite main() {
    // Test 1: Write to stdout using Sys·write
    ≔ msg = "Hello from syscall\n";
    ≔ n = Sys·write(STDOUT_FILENO(), msg, 19);

    // Should have written all 19 bytes including newline
    assert_eq!(n, 19);
    println(n);

    // Test 2: Write to stderr using Sys·write
    ≔ err_msg = "Error output\n";
    ≔ n2 = Sys·write(STDERR_FILENO(), err_msg, 13);

    assert_eq!(n2, 13);
    println(n2);

    // Test 3: Empty write
    ≔ empty = "";
    ≔ n3 = Sys·write(STDOUT_FILENO(), empty, 0);

    assert_eq!(n3, 0);
    println(n3);

    println("done");
}
