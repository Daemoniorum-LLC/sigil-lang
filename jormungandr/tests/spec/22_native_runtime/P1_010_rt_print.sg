// P1_010_rt_print.sg
// Test: Print functions (interpreter-compatible)
// Phase D: I/O
//
// This test verifies print functions work correctly.

rite main() {
    // Test 1: Print string
    println("Hello World");
    println("print_ok");

    // Test 2: Print integer - positive
    println(42);
    println(12345);
    println(9223372036854775807);  // i64·MAX
    println("int_positive_ok");

    // Test 3: Print integer - negative
    println(-42);
    println(-12345);
    println(-9223372036854775807);  // near i64·MIN
    println("int_negative_ok");

    // Test 4: Print integer - zero
    println(0);
    println("int_zero_ok");

    // Test 5: Print float - positive
    println(3.14159);
    println(2.71828);
    println(1000000.5);
    println("float_positive_ok");

    // Test 6: Print float - negative
    println(-3.14159);
    println(-0.001);
    println("float_negative_ok");

    // Test 7: Print float - special values
    println(0.0);
    println(1.0);
    println(-1.0);
    println("float_special_ok");

    // Test 8: Print string
    println("Hello from sigil_print_str");
    println("print_str_ok");

    // Test 9: Print empty string
    println("");
    println("print_empty_ok");

    // Test 10: Print multiline
    println("Line 1");
    println("Line 2");
    println("Line 3");
    println("multiline_ok");

    println("done");
}
