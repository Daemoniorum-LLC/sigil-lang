// P1_007_global_alloc.sg
// Test: Global allocator patterns (interpreter-compatible)
// Phase B: Memory Allocator
//
// This test verifies allocation patterns using interpreter arrays.

rite main() {
    // Initialize (no-op ∈ interpreter)
    println("init_ok");

    // Test 1: Basic allocation
    ≔ Δ buffer = [];
    ≔ Δ i = 0;
    ⟳ i < 256 {
        buffer.push(0);
        i = i + 1;
    }
    assert_eq!(buffer.len(), 256);
    println("alloc_ok");

    // Test 2: Write pattern and verify
    ≔ Δ j = 0;
    ⟳ j < 256 {
        buffer[j] = j;
        j = j + 1;
    }
    ≔ Δ pattern_ok = true;
    ≔ Δ k = 0;
    ⟳ k < 256 {
        ⎇ buffer[k] != k {
            pattern_ok = false;
        }
        k = k + 1;
    }
    ⎇ pattern_ok {
        println("pattern_ok");
    } ⎉ {
        println("pattern_fail");
    }

    // Test 3: Free (clear ∈ interpreter)
    buffer.clear();
    println("free_ok");

    // Test 4: Multiple allocations
    ≔ Δ all_ok = true;
    ≔ Δ outer = 0;
    ⟳ outer < 10 {
        ≔ Δ arr = [];
        ≔ Δ inner = 0;
        ⟳ inner < 64 {
            arr.push(inner);
            inner = inner + 1;
        }
        ⎇ arr.len() != 64 {
            all_ok = false;
        }
        outer = outer + 1;
    }
    ⎇ all_ok {
        println("multi_alloc_ok");
    }

    // Test 5: Realloc grow - copy and extend
    ≔ Δ p2 = [];
    ≔ Δ m = 0;
    ⟳ m < 100 {
        p2.push(42);
        m = m + 1;
    }
    // Extend to 200
    ≔ Δ n = 0;
    ⟳ n < 100 {
        p2.push(0);
        n = n + 1;
    }
    // Check original preserved
    ≔ Δ preserved = true;
    ≔ Δ p = 0;
    ⟳ p < 100 {
        ⎇ p2[p] != 42 {
            preserved = false;
        }
        p = p + 1;
    }
    ⎇ preserved {
        println("realloc_preserved_ok");
    } ⎉ {
        println("realloc_preserved_fail");
    }

    // New memory is accessible
    ≔ Δ q = 100;
    ⟳ q < 200 {
        p2[q] = 99;
        q = q + 1;
    }
    println("realloc_extend_ok");

    // Test 6: Shrink - just verify length can be tracked
    assert!(p2.len() >= 50);
    println("realloc_shrink_ok");

    // Test 7: Zero-size allocation
    ≔ empty = [];
    assert_eq!(empty.len(), 0);
    println("zero_alloc_ok");

    // Test 8: Large allocation
    ≔ Δ large = [];
    ≔ Δ r = 0;
    ⟳ r < 10000 {
        large.push(r);
        r = r + 1;
    }
    assert_eq!(large.len(), 10000);
    println("large_alloc_ok");

    // Write to edges
    large[0] = 1;
    large[9999] = 2;
    assert_eq!(large[0], 1);
    assert_eq!(large[9999], 2);
    println("large_write_ok");

    large.clear();
    println("large_free_ok");

    println("done");
}
