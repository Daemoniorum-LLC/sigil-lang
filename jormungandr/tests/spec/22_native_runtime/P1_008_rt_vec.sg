// P1_008_rt_vec.sg
// Test: Vec/Array operations (interpreter-compatible)
// Phase C: Core Types
//
// This test verifies array operations work correctly.
// Restructured ∀ interpreter mode.

rite main() {
    // Test 1: Create empty Vec using array literal
    ≔ Δ v = [];
    assert_eq!(v.len(), 0);
    assert!(v.is_empty());
    println("new_ok");

    // Test 2: Push elements
    v.push(10);
    v.push(20);
    v.push(30);
    assert_eq!(v.len(), 3);
    assert!(!v.is_empty());
    println("push_ok");

    // Test 3: Get elements via indexing
    assert_eq!(v[0], 10);
    assert_eq!(v[1], 20);
    assert_eq!(v[2], 30);
    println("get_ok");

    // Test 4: Bounds checking is verified via length
    assert_eq!(v.len(), 3);
    println("bounds_check_ok");

    // Test 5: Pop elements (returns Option)
    ⌥ v.pop() {
        Option·Some(val) => assert_eq!(val, 30),
        Option·None => assert!(false),
    }
    ⌥ v.pop() {
        Option·Some(val) => assert_eq!(val, 20),
        Option·None => assert!(false),
    }
    assert_eq!(v.len(), 1);
    println("pop_ok");

    // Test 6: Pop from empty returns None
    v.pop();  // Remove last element
    ⌥ v.pop() {
        Option·Some(_) => assert!(false),
        Option·None => assert!(true),
    }
    println("pop_empty_ok");

    // Test 7: Index operator
    ≔ Δ v2 = [];
    v2.push(100);
    v2.push(200);
    v2.push(300);
    assert_eq!(v2[0], 100);
    assert_eq!(v2[1], 200);
    assert_eq!(v2[2], 300);
    println("index_ok");

    // Test 8: Capacity is available
    ≔ v3 = [1, 2, 3];
    assert!(v3.capacity() >= 3);
    println("with_capacity_ok");

    // Test 9: Grow array
    ≔ Δ v4 = [];
    ∀ i ∈ 0..100 {
        v4.push(i);
    }
    assert_eq!(v4.len(), 100);
    assert_eq!(v4[50], 50);
    assert_eq!(v4[99], 99);
    println("grow_ok");

    // Test 10: Clear
    ≔ Δ v5 = [];
    v5.push(1);
    v5.push(2);
    v5.push(3);
    v5.clear();
    assert_eq!(v5.len(), 0);
    assert!(v5.is_empty());
    println("clear_ok");

    // Test 11: Get element value
    ≔ v6 = [1, 2, 3];
    assert_eq!(v6[0], 1);
    println("get_mut_ok");

    // Test 12: As slice (returns array ∈ interpreter)
    ≔ v7 = [1, 2, 3];
    ≔ slice = v7.as_slice();
    assert_eq!(slice.len(), 3);
    assert_eq!(slice[0], 1);
    assert_eq!(slice[1], 2);
    assert_eq!(slice[2], 3);
    println("as_slice_ok");

    println("done");
}
