// P1_004_errno.sg
// Test: Error handling patterns (interpreter-compatible)
// Phase A: Platform Syscalls
//
// This test verifies error number handling patterns that would
// invoke errno ∈ compiled mode.

// Error code ᛈ (simulates Errno)
ᛈ Errno {
    EPERM = 1,
    ENOENT = 2,
    EIO = 5,
    EBADF = 9,
    ENOMEM = 12,
    EACCES = 13,
    EINVAL = 22,
}

rite errno_message(code: i64) -> String {
    ⎇ code == 1 {
        ⤺ "Operation not permitted";
    } ⎉ ⎇ code == 2 {
        ⤺ "No such file or directory";
    } ⎉ ⎇ code == 12 {
        ⤺ "Out of memory";
    } ⎉ {
        ⤺ "Unknown error";
    }
}

rite main() {
    // Test 1: Errno from code
    ≔ eperm_code = 1;
    assert_eq!(eperm_code, 1);
    println("from_code_ok");

    // Test 2: Errno variants
    ≔ eperm = 1;
    ≔ enoent = 2;
    ≔ eio = 5;
    ≔ enomem = 12;
    ≔ eacces = 13;
    ≔ einval = 22;
    assert_eq!(eperm, 1);
    assert_eq!(enoent, 2);
    assert_eq!(eio, 5);
    assert_eq!(enomem, 12);
    assert_eq!(eacces, 13);
    assert_eq!(einval, 22);
    println("variants_ok");

    // Test 3: Error messages
    ≔ msg1 = errno_message(1);
    assert!(msg1.len() > 0);
    println(msg1);

    ≔ msg2 = errno_message(2);
    assert!(msg2.len() > 0);
    println(msg2);

    ≔ msg3 = errno_message(12);
    assert!(msg3.len() > 0);
    println(msg3);

    // Test 4: Unknown errno
    ≔ msg_unknown = errno_message(9999);
    assert!(msg_unknown.len() > 0);
    println("unknown_msg_ok");

    // Test 5: Simulate error result - bad file descriptor
    ≔ error_code = 9;  // EBADF
    assert_eq!(error_code, 9);
    println("ebadf_ok");

    // Test 6: Simulate error result - no such file
    ≔ error_code2 = 2;  // ENOENT
    assert_eq!(error_code2, 2);
    println("enoent_ok");

    println("done");
}
