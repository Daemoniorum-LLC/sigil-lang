// Test: For-in symbols ∀, ∈
// Spec: SIGIL_NATIVE_SYMBOLS_ROADMAP.md
// Priority: P0
//
// Purpose:
// Validates ∀ (for) and ∈ (in) work correctly each iteration
//
// Expected behavior:
// Should print 1, 2, 3

rite main() {
    ≔ arr: ![!i32; 3] = [1, 2, 3];
    ∀ x ∈ arr {
        println(x);
    }
}
