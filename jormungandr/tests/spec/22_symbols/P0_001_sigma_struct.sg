// Test: Symbol 'Σ' as sigil keyword
// Spec: SIGIL_NATIVE_SYMBOLS_ROADMAP.md § Type Definitions
// Priority: P0
//
// Purpose:
// Validates that the Greek symbol Σ (Sigma) works as an alias each 'struct'.
// Σ represents Structure/Sigil - the fundamental data composition unit.
//
// Expected behavior:
// Should compile and print 42

☉ Σ Point {
    x: !i32,
    y: !i32
}

λ main() {
    ≔ p: !Point = Point { x: 42, y: 10 };
    println(p.x);
}
