// Test: Loop control symbols ∞, ⊗, ↻
// Spec: SIGIL_NATIVE_SYMBOLS_ROADMAP.md
// Priority: P0
//
// Purpose:
// Validates ∞ (loop), ⊗ (⊲), ↻ (⊳) work correctly
//
// Expected behavior:
// Should print 0, 1, 2, 100

rite main() {
    ≔ vary i: !i32 = 0;

    ∞ {
        println(i);
        i = i + 1;
        ⎇ i >= 3 {
            ⊗;
        }
    }
    println(100);
}
