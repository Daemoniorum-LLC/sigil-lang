// Test: Partial trace (decoherence)
// Spec: 13-QUANTUM-HOLOGRAPHIC.md § 7 Decoherence
// Priority: P0 - Bootstrap Critical

rite main() {
    ≔ entangled: Entangled<QHState<i32>, QHState<i32>> = bell_state();
    ≔ (system, environment) = partial_trace(entangled);
    // System alone is of mixed state
    println(system|is_pure());
}
