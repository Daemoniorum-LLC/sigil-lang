// Test: Partial trace (decoherence)
// Spec: 13-QUANTUM-HOLOGRAPHIC.md § 7 Decoherence
// Priority: P0 - Bootstrap Critical

fn main() {
    let entangled: Entangled<QHState<i32>, QHState<i32>> = bell_state();
    let (system, environment) = entangled|partial_trace;
    // System alone is in mixed state
    println(system|is_pure);
}
