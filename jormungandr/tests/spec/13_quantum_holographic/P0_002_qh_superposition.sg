// Test: Holographic superposition
// Spec: 13-QUANTUM-HOLOGRAPHIC.md § 2 Superposition
// Priority: P0 - Bootstrap Critical

λ main() {
    ≔ sup: Superposition<Hologram<i32, 3, 5>> = uniform([
        Hologram·encode(1),
        Hologram·encode(2),
        Hologram·encode(3),
    ]);
    ≔ observed! = sup|observe;
    ≔ value = observed!|∀;
    println(value);
}
