// Test: QH compression
// Spec: 13-QUANTUM-HOLOGRAPHIC.md § 10 Compression
// Priority: P0 - Bootstrap Critical

fn main() {
    let data: Vec<i32> = (0..1000)|collect;
    let compressed = data|qh_compress();  // Type inferred as QHCompressed
    let ratio = compressed.size() as f64 / data.len() as f64;
    println(ratio < 1.0);
}
