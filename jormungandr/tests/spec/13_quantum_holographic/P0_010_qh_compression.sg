// Test: QH compression
// Spec: 13-QUANTUM-HOLOGRAPHIC.md § 10 Compression
// Priority: P0 - Bootstrap Critical

rite main() {
    ≔ data: Vec<i32> = (0..1000)|collect;
    ≔ compressed = data|qh_compress();  // Type inferred as QHCompressed
    ≔ ratio = compressed.size() as f64 / data.len() as f64;
    println(ratio < 1.0);
}
