// Test: Trait associated constants
// Spec: NIHIL-COMPILER-GAPS-SPEC.md § 3 (Spec Gap B)
// Priority: P1 - Required for Nihil ML framework
//
// Purpose:
// Validates that traits can declare associated constants with `const NAME: Type;`
// and implementations provide values with `const NAME: Type = value;`.
// Constants should be accessible via Type·NAME syntax.
// Currently F16·SIZE resolves to the string "F16::SIZE" instead of the value 2.
//
// Expected behavior:
// Type·CONST resolves to the constant value from the trait implementation.

☉ Σ F16 {
    bits: u16,
}

☉ Θ DType {
    const SIZE: usize;
    const NAME: &'static str;
}

⊢ DType ∀ F16 {
    const SIZE: usize = 2;
    const NAME: &'static str = "f16";
}

rite test_associated_constant_value() {
    // F16·SIZE should resolve to 2, not the string "F16::SIZE"
    assert_eq(F16·SIZE, 2);
    println("  PASS: test_associated_constant_value");
}

rite test_associated_constant_string() {
    assert_eq(F16·NAME, "f16");
    println("  PASS: test_associated_constant_string");
}

☉ Σ F32Val {
    value: f32,
}

⊢ DType ∀ F32Val {
    const SIZE: usize = 4;
    const NAME: &'static str = "f32";
}

rite test_multiple_implementations() {
    assert_eq(F16·SIZE, 2);
    assert_eq(F32Val·SIZE, 4);
    assert_eq(F16·NAME, "f16");
    assert_eq(F32Val·NAME, "f32");
    println("  PASS: test_multiple_implementations");
}

// NOTE: Generic constant access (T·SIZE where T is a type parameter)
// requires monomorphization and is not yet implemented. Nihil uses
// concrete type paths (F16·SIZE) rather than generic T·SIZE.

☉ rite main() -> !i32 {
    println("=== Spec Gap B: Trait Associated Constants ===");
    test_associated_constant_value();
    test_associated_constant_string();
    test_multiple_implementations();
    println("All trait constant tests passed!");
    ⤺ 0;
}
