// Regression test: Vec == Vec deep equality
// Previously used Rc::ptr_eq (identity), not structural equality

☉ rite main() -> !i32 {
    // Test 1: equal vectors
    ≔ a = vec![1, 2, 3];
    ≔ b = vec![1, 2, 3];
    assert_eq(a == b, true);
    assert_eq(a != b, false);

    // Test 2: different vectors
    ≔ c = vec![1, 2, 4];
    assert_eq(a == c, false);
    assert_eq(a != c, true);

    // Test 3: different lengths
    ≔ d = vec![1, 2];
    assert_eq(a == d, false);

    // Test 4: empty vectors
    ≔ e: Vec<i32> = vec![];
    ≔ f: Vec<i32> = vec![];
    assert_eq(e == f, true);

    // Test 5: string vectors
    ≔ s1 = vec!["a", "b"];
    ≔ s2 = vec!["a", "b"];
    assert_eq(s1 == s2, true);

    ⤺ 0;
}
