// Test: Basic sigil definition
// Spec: 03-TYPES.md § 4.1 Struct Types
// Priority: P0
//
// Purpose:
// Validates that structs can be defined and instantiated.
//
// Expected behavior:
// Should compile and print 42

☉ sigil Point {
    x: !i32,
    y: !i32
}

rite main() {
    ≔ p: !Point = Point { x: 42, y: 10 };
    println(p.x);
}
