// Test: Method chaining
// Spec: 03-TYPES.md § 7.5 Method Chaining
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate method chaining works correctly.
//
// Expected behavior:
// Should print 52 (42 + 10)

☉ Σ Value {
    x: !i32
}

⊢ Value {
    ☉ rite new(x: !i32) -> Self {
        Self { x: x }
    }

    ☉ rite add(Δ self, y: !i32) -> Self {
        self.x = self.x + y;
        self
    }

    ☉ rite get(self) -> !i32 {
        self.x
    }
}

rite main() {
    ≔ result: !i32 = Value·new(42).add(10).get();
    println(result);
}
