// Test: Struct field with Known (!) evidence
// Spec: 03-TYPES.md § 2.5 Evidence of Struct Fields
// Priority: P0
//
// Purpose:
// Validates that sigil fields can have Known (!) evidence markers
// and that values are properly stored and retrieved.
//
// Expected behavior:
// Should compile and print 42

☉ sigil Point {
    x: !i32,
    y: !i32
}

rite main() {
    ≔ p: !Point = Point { x: 42, y: 10 };
    println(p.x);
}
