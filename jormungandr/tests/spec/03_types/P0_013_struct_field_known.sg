// Test: Struct field with Known (!) evidence
// Spec: 03-TYPES.md § 2.5 Evidence in Struct Fields
// Priority: P0
//
// Purpose:
// Validates that struct fields can have Known (!) evidence markers
// and that values are properly stored and retrieved.
//
// Expected behavior:
// Should compile and print 42

pub struct Point {
    x: !i32,
    y: !i32
}

fn main() {
    let p: !Point = Point { x: 42, y: 10 };
    println(p.x);
}
