// Test: Struct update syntax
// Spec: 03-TYPES.md § 4.1 Structs
// Priority: P2 - Enhancement

Σ Config {
    width: !i32,
    height: !i32,
    depth: !i32,
}

rite main() {
    ≔ c1 = Config { width: 100, height: 200, depth: 300 };
    ≔ c2 = Config { width: 150, ..c1 };

    println(c2.width);
    println(c2.height);
    println(c2.depth);
}
