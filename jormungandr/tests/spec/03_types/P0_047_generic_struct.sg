// Test: Generic Σ basic usage
// Spec: 03-TYPES.md § 5.1 Generic Types
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate generic structs work correctly.
//
// Expected behavior:
// Should print 42

☉ Σ Box<T> {
    value: T
}

rite main() {
    ≔ b: !Box<!i32> = Box { value: 42 };
    println(b.value);
}
