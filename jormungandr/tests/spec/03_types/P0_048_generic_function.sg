// Test: Generic function basic usage
// Spec: 03-TYPES.md § 5.2 Generic Functions
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate generic functions work correctly.
//
// Expected behavior:
// Should print 42

rite identity<T>(x: T) → T {
    x
}

rite main() {
    ≔ result: !i32 = identity(42);
    println(result);
}
