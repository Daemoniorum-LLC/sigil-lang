// Test: Generic function basic usage
// Spec: 03-TYPES.md § 5.2 Generic Functions
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate generic functions work correctly.
//
// Expected behavior:
// Should print 42

fn identity<T>(x: T) -> T {
    x
}

fn main() {
    let result: !i32 = identity(42);
    println(result);
}
