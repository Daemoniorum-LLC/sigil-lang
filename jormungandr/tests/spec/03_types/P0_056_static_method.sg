// Test: Static method (associated function with no this)
// Spec: 03-TYPES.md § 7.3 Static Methods
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate static methods work correctly.
//
// Expected behavior:
// Should print 42

☉ sigil Value {
    x: !i32
}

⊢ Value {
    ☉ rite new(x: !i32) → !Value {
        Value { x: x }
    }

    ☉ rite get(this) → !i32 {
        this.x
    }
}

rite main() {
    ≔ v: !Value = Value·new(42);
    println(v.get());
}
