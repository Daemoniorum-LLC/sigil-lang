// Test: Static method (associated function with no self)
// Spec: 03-TYPES.md § 7.3 Static Methods
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate static methods work correctly.
//
// Expected behavior:
// Should print 42

☉ Σ Value {
    x: !i32
}

⊢ Value {
    ☉ λ new(x: !i32) -> !Value {
        Value { x: x }
    }

    ☉ λ get(self) -> !i32 {
        self.x
    }
}

λ main() {
    ≔ v: !Value = Value·new(42);
    println(v.get());
}
