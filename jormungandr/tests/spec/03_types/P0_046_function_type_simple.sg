// Test: Function type basic usage
// Spec: 03-TYPES.md § 4.4 Function Types
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate function types work as first-class values.
//
// Expected behavior:
// Should print 42

fn get_value() -> !i32 {
    42
}

fn call_fn(f: fn() -> !i32) -> !i32 {
    f()
}

fn main() {
    println(call_fn(get_value));
}
