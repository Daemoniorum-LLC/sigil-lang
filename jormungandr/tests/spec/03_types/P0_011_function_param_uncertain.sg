// Test: Function parameter with Uncertain (?) evidence
// Spec: 03-TYPES.md § 2.4 Evidence in Function Signatures
// Priority: P0
//
// Purpose:
// Validates that functions can accept parameters with Uncertain (?) evidence
// and that the evidence is preserved in the function body.
//
// Expected behavior:
// Should compile and print 198 (99 * 2)

fn double(x: ?i32) -> ?i32 {
    x * 2
}

fn main() {
    let val: ?i32 = 99;
    let result: ?i32 = double(val);
    println(result);
}
