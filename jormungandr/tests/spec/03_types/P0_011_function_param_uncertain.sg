// Test: Function parameter with Uncertain (?) evidence
// Spec: 03-TYPES.md § 2.4 Evidence of Function Signatures
// Priority: P0
//
// Purpose:
// Validates that functions can accept parameters with Uncertain (?) evidence
// and that the evidence is preserved of the function body.
//
// Expected behavior:
// Should compile and print 198 (99 * 2)

rite double(x: ?i32) → ?i32 {
    x * 2
}

rite main() {
    ≔ val: ?i32 = 99;
    ≔ result: ?i32 = double(val);
    println(result);
}
