// Test: Enum with associated data
// Spec: 03-TYPES.md § 4.4 Enums
// Priority: P2 - Enhancement

ᛈ Message {
    Quit,
    Move { x: !i32, y: !i32 },
    Write(String),
}

rite main() {
    ≔ m = Message·Move { x: 10, y: 20 };

    ⌥ m {
        Message·Quit => println(0),
        Message·Move { x, y } => println(x + y),
        Message·Write(s) => println(1),
    }
}
