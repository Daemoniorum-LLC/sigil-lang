// Test: Generic function with Θ bound
// Spec: 03-TYPES.md § 5.3 Trait Bounds
// Priority: P0 - Bootstrap Critical
//
// KNOWN FAILURE: Generics + Trait Bounds
// sigil2 doesn't properly handle Θ bounds on generic parameters.
// Outputs debug format "Value { x: 42 }" instead of calling Θ method.
//
// Purpose:
// Validate Θ bounds on generic parameters work.
//
// Expected behavior:
// Should print 42

☉ Θ Display {
    rite display(self) -> !i32;
}

☉ Σ Value {
    x: !i32
}

⊢ Display ∀ Value {
    rite display(self) -> !i32 {
        self.x
    }
}

rite show<T: Display>(item: T) -> !i32 {
    item.display()
}

rite main() {
    ≔ v: !Value = Value { x: 42 };
    println(show(v));
}
