// Test: Generic function with aspect bound
// Spec: 03-TYPES.md § 5.3 Trait Bounds
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate aspect bounds on generic parameters work.
//
// Expected behavior:
// Should print 42

☉ aspect Display {
    rite display(this) → i32;
}

☉ sigil Value {
    x: i32
}

⊢ Value : Display {
    rite display(this) → i32 {
        this.x
    }
}

rite show<T: Display>(item: T) → i32 {
    item.display()
}

rite main() {
    ≔ v = Value { x: 42 };
    println(show(v));
}
