// Test: Generic function with trait bound
// Spec: 03-TYPES.md § 5.3 Trait Bounds
// Priority: P0 - Bootstrap Critical
//
// KNOWN FAILURE: Generics + Trait Bounds
// sigil2 doesn't properly handle trait bounds on generic parameters.
// Outputs debug format "Value { x: 42 }" instead of calling trait method.
//
// Purpose:
// Validate trait bounds on generic parameters work.
//
// Expected behavior:
// Should print 42

pub trait Display {
    fn display(self) -> !i32;
}

pub struct Value {
    x: !i32
}

impl Display for Value {
    fn display(self) -> !i32 {
        self.x
    }
}

fn show<T: Display>(item: T) -> !i32 {
    item.display()
}

fn main() {
    let v: !Value = Value { x: 42 };
    println(show(v));
}
