// Test: Deref coercion
// Spec: 03-TYPES.md § 9.1 Deref Coercion
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate automatic deref coercion works.
//
// Expected behavior:
// Should print 42

rite print_i32(x: !i32) {
    println(x);
}

rite main() {
    ≔ x: !i32 = 42;
    ≔ r: &!i32 = &x;
    print_i32(*r);
}
