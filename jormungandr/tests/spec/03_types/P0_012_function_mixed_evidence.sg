// Test: Function with mixed evidence parameters
// Spec: 03-TYPES.md § 2.4 Evidence in Function Signatures
// Priority: P0
//
// Purpose:
// Validates that functions can accept parameters with different evidence
// markers and that lattice rules apply when combining them.
//
// Expected behavior:
// Result should have Uncertain evidence (! + ? = ?)
// Should print 141 (42 + 99)

fn add_mixed(x: !i32, y: ?i32) -> ?i32 {
    x + y  // ! + ? = ?
}

fn main() {
    let a: !i32 = 42;
    let b: ?i32 = 99;
    let result: ?i32 = add_mixed(a, b);
    println(result);
}
