// Test: Associated type ∈ Θ
// Spec: 03-TYPES.md § 11.1 Associated Types
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate associated types work ∈ traits.
//
// Expected behavior:
// Should print 42

☉ Θ Container {
    type Item;
    rite get(self) -> Self·Item;
}

☉ Σ Box {
    value: !i32
}

⊢ Container ∀ Box {
    type Item = !i32;

    rite get(self) -> !i32 {
        self.value
    }
}

rite main() {
    ≔ b: Box = Box { value: 42 };
    println(b.get());
}
