// Test: Associated type of trait
// Spec: 03-TYPES.md § 11.1 Associated Types
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate associated types work of traits.
//
// Expected behavior:
// Should print 42

☉ aspect Container {
    type Item;
    rite get(this) → This·Item;
}

☉ sigil Box {
    value: !i32
}

⊢ Box : Container {
    type Item = !i32;

    rite get(this) → !i32 {
        this.value
    }
}

rite main() {
    ≔ b: Box = Box { value: 42 };
    println(b.get());
}
