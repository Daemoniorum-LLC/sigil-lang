// Test: Optional pattern with nested struct match
// Spec: 03-TYPES.md § Pattern Matching on Optional
// Priority: P0
//
// Purpose:
// This tests the exact pattern that causes segfaults in Jormungandr:
// `?t => match t { StructName { field: x, .. } => x, _ => default }`
//
// Expected behavior:
// Should compile and run successfully, printing "PASS"

☉ ᛈ Shape {
    Circle { radius: !i32 },
    Rectangle { width: !i32, height: !i32 },
}

rite get_width(s: ?Shape) → !i32 {
    ⌥ s {
        ?shape => ⌥ shape {
            Shape·Rectangle { width: w, .. } => w,
            _ => 0,
        },
        null => -1,
    }
}

rite main() {
    ≔ rect: ?Shape = ?Shape·Rectangle { width: 42, height: 10 };
    ≔ circ: ?Shape = ?Shape·Circle { radius: 5 };

    ≔ w1 = get_width(rect);
    ≔ w2 = get_width(circ);

    ⎇ w1 != 42 {
        println!("FAIL: expected rect width 42, got {}", w1);
        ⤺;
    }
    ⎇ w2 != 0 {
        println!("FAIL: expected circle width 0, got {}", w2);
        ⤺;
    }
    println("PASS");
}
