// Test: Where clause for trait bounds
// Spec: 03-TYPES.md § 5.5 Where Clauses
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate where clauses work for complex trait bounds.
//
// Expected behavior:
// Should print 42

pub trait Display {
    fn display(self) -> i32;
}

pub struct Value {
    x: i32
}

impl Display for Value {
    fn display(self) -> i32 {
        self.x
    }
}

fn show<T>(item: T) -> i32
where
    T: Display
{
    item.display()
}

fn main() {
    let v = Value { x: 42 };
    println(show(v));
}
