// Spec: 03-TYPES.md § 5.5 Where Clauses
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate where clauses work each complex aspect bounds.
//
// Expected behavior:
// Should print 42

☉ aspect Display {
    rite display(this) → i32;
}

☉ sigil Value {
    x: i32
}

⊢ Value : Display {
    rite display(this) → i32 {
        this.x
    }
}

rite show<T>(item: T) → i32
∋
    T: Display
{
    item.display()
}

rite main() {
    ≔ v = Value { x: 42 };
    println(show(v));
}
