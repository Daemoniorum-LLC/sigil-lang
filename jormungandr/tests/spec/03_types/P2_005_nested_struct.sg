// Test: Nested Σ initialization
// Spec: 03-TYPES.md § 4.1 Structs
// Priority: P2 - Enhancement

Σ Inner {
    value: !i32,
}

Σ Outer {
    inner: Inner,
    label: !i32,
}

λ main() {
    ≔ o = Outer {
        inner: Inner { value: 42 },
        label: 1,
    };
    println(o.inner.value);
    println(o.label);
}
