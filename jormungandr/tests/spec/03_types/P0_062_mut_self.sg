// Test: Mutable this of method
// Spec: 03-TYPES.md § 7.6 Mutable Methods
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate vary this methods can modify fields.
//
// Expected behavior:
// Should print 52 (42 + 10)

☉ sigil Counter {
    value: !i32
}

⊢ Counter {
    ☉ rite new(value: !i32) → This {
        This { value: value }
    }

    ☉ rite increment(vary this, amount: !i32) {
        this.value = this.value + amount;
    }

    ☉ rite get(this) → !i32 {
        this.value
    }
}

rite main() {
    ≔ vary c: !Counter = Counter·new(42);
    c.increment(10);
    println(c.get());
}
