// Test: Pub visibility modifier
// Spec: 03-TYPES.md § 10.1 Visibility
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate pub makes items public.
//
// Expected behavior:
// Should print 42

pub struct Value {
    pub x: !i32
}

pub fn get_value() -> !i32 {
    42
}

fn main() {
    let v: !Value = Value { x: get_value() };
    println(v.x);
}
