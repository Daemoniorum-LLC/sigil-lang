// Test: Pub visibility modifier
// Spec: 03-TYPES.md § 10.1 Visibility
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate ☉ makes items public.
//
// Expected behavior:
// Should print 42

☉ Σ Value {
    ☉ x: !i32
}

☉ rite get_value() -> !i32 {
    42
}

rite main() {
    ≔ v: !Value = Value { x: get_value() };
    println(v.x);
}
