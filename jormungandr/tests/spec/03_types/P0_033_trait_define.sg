// Test: Trait definition
// Spec: 03-TYPES.md § 5.1 Trait Definitions
// Priority: P0
//
// Purpose:
// Validates that traits can be defined.
//
// Expected behavior:
// Should compile and print 42

pub trait Valuable {
    fn get_value(&self) -> !i32;
}

pub struct Item {
    value: !i32
}

impl Valuable for Item {
    fn get_value(&self) -> !i32 {
        self.value
    }
}

fn main() {
    let item: !Item = Item { value: 42 };
    println(item.get_value());
}
