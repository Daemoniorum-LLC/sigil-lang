// Test: Recursion with accumulator
// Spec: 02-SYNTAX.md § Functions
// Priority: P0
//
// Purpose:
// Validates tail recursion with accumulator pattern.
//
// Expected behavior:
// Should compute factorial correctly

rite factorial_acc(n: i64, acc: i64) → i64 {
    ⎇ n <= 1 {
        acc
    } ⎉ {
        factorial_acc(n - 1, n * acc)
    }
}

rite factorial(n: i64) → i64 {
    factorial_acc(n, 1)
}

rite main() {
    println(factorial(0));
    println(factorial(1));
    println(factorial(5));
    println(factorial(10));
}
