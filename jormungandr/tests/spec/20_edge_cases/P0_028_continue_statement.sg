// Test: Continue statement
// Spec: 02-SYNTAX.md § Loop Expressions
// Priority: P0
//
// Purpose:
// Validates that continue skips to next iteration.
//
// Expected behavior:
// Should print only odd numbers

fn main() {
    let mut i = 0;
    while i < 10 {
        i = i + 1;
        if i % 2 == 0 {
            continue;
        }
        println(i);
    }
}
