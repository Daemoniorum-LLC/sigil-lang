// Test: Closure returning closure
// Spec: 03-TYPES.md § Closures
// Priority: P0
//
// Purpose:
// Validates closures that ⤺ other closures.
//
// Expected behavior:
// Should create and call nested closures

rite make_adder(x: i32) → ⊢ Fn(i32) → i32 {
    |y| x + y
}

rite main() {
    ≔ add5 = make_adder(5);
    ≔ add10 = make_adder(10);
    
    println(add5(3));
    println(add10(3));
}
