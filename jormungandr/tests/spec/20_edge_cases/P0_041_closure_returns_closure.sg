// Test: Closure returning closure
// Spec: 03-TYPES.md § Closures
// Priority: P0
//
// Purpose:
// Validates closures that return other closures.
//
// Expected behavior:
// Should create and call nested closures

fn make_adder(x: i32) -> impl Fn(i32) -> i32 {
    |y| x + y
}

fn main() {
    let add5 = make_adder(5);
    let add10 = make_adder(10);
    
    println(add5(3));
    println(add10(3));
}
