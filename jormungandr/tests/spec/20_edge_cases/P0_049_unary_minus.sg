// Test: Unary minus operator
// Spec: 05-MATHEMATICS.md § Arithmetic
// Priority: P0
//
// Purpose:
// Validates the unary minus operator.
//
// Expected behavior:
// Should negate numbers

fn main() {
    let x = 42;
    let y = -x;
    println(y);
    println(-(-x));
    println(--x);
    
    let f = 3.14;
    println(-f);
}
