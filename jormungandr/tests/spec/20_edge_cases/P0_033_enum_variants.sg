// Test: Enum with data variants
// Spec: 03-TYPES.md § Enums
// Priority: P0
//
// Purpose:
// Validates enum variants with different data.
//
// Expected behavior:
// Should match and extract enum data correctly

enum Shape {
    Circle(f64),
    Rectangle(f64, f64),
    Point,
}

fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => 3.14 * r * r,
        Shape::Rectangle(w, h) => w * h,
        Shape::Point => 0.0,
    }
}

fn main() {
    let c = Shape::Circle(2.0);
    let r = Shape::Rectangle(3.0, 4.0);
    let p = Shape::Point;

    println(area(c));
    println(area(r));
    println(area(p));
}
