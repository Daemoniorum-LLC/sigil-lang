// Test: Enum with data variants
// Spec: 03-TYPES.md § Enums
// Priority: P0
//
// Purpose:
// Validates ᛈ variants with different data.
//
// Expected behavior:
// Should ⌥ and extract ᛈ data correctly

ᛈ Shape {
    Circle(f64),
    Rectangle(f64, f64),
    Point,
}

rite area(s: Shape) → f64 {
    ⌥ s {
        Shape·Circle(r) => 3.14 * r * r,
        Shape·Rectangle(w, h) => w * h,
        Shape·Point => 0.0,
    }
}

rite main() {
    ≔ c = Shape·Circle(2.0);
    ≔ r = Shape·Rectangle(3.0, 4.0);
    ≔ p = Shape·Point;

    println(area(c));
    println(area(r));
    println(area(p));
}
