// Test: Struct with methods
// Spec: 03-TYPES.md § Structs
// Priority: P0
//
// Purpose:
// Validates struct methods using impl block.
//
// Expected behavior:
// Should call struct methods correctly

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn new(x: i32, y: i32) -> Point {
        Point { x, y }
    }

    fn sum(&self) -> i32 {
        self.x + self.y
    }

    fn scale(&self, factor: i32) -> Point {
        Point { x: self.x * factor, y: self.y * factor }
    }
}

fn main() {
    let p = Point::new(3, 4);
    println(p.x);
    println(p.y);
    println(p.sum());

    let p2 = p.scale(2);
    println(p2.x);
    println(p2.y);
}
