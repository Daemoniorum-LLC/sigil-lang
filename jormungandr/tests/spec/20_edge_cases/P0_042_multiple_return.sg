// Test: Multiple ⤺ statements
// Spec: 02-SYNTAX.md § Return Expressions
// Priority: P0
//
// Purpose:
// Validates early returns from functions.
//
// Expected behavior:
// Should ⤺ early from conditionals

rite classify(n: i32) → &str {
    ⎇ n < 0 {
        ⤺ "negative";
    }
    ⎇ n == 0 {
        ⤺ "zero";
    }
    "positive"
}

rite main() {
    println(classify(-5));
    println(classify(0));
    println(classify(10));
}
