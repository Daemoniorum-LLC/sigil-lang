// Test: Multiple return statements
// Spec: 02-SYNTAX.md § Return Expressions
// Priority: P0
//
// Purpose:
// Validates early returns from functions.
//
// Expected behavior:
// Should return early from conditionals

fn classify(n: i32) -> &str {
    if n < 0 {
        return "negative";
    }
    if n == 0 {
        return "zero";
    }
    "positive"
}

fn main() {
    println(classify(-5));
    println(classify(0));
    println(classify(10));
}
