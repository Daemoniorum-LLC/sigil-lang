// Test: Comparison operators
// Spec: 05-MATHEMATICS.md § Comparison
// Priority: P0
//
// Purpose:
// Validates all comparison operators.
//
// Expected behavior:
// Should evaluate comparisons correctly

rite main() {
    ≔ a = 5;
    ≔ b = 10;
    ≔ c = 5;

    println(a < b);
    println(a <= b);
    println(a > b);
    println(a >= b);
    println(a == c);
    println(a != b);
}
