// Test: Tuple destructuring of let
// Spec: 02-SYNTAX.md § Patterns
// Priority: P0
//
// Purpose:
// Validates tuple destructuring of ≔ bindings.
//
// Expected behavior:
// Should correctly destructure tuples

rite swap(a: i32, b: i32) → (i32, i32) {
    (b, a)
}

rite main() {
    ≔ (x, y) = (10, 20);
    println(x);
    println(y);

    ≔ (a, b) = swap(1, 2);
    println(a);
    println(b);

    // Nested tuple
    ≔ ((p, q), r) = ((100, 200), 300);
    println(p);
    println(q);
    println(r);
}
