// Test: Integer overflow on addition (wrapping behavior)
// Spec: 05-MATHEMATICS.md § Integer Operations
// Priority: P0
//
// Purpose:
// Validates that integer overflow wraps correctly.
//
// Expected behavior:
// Should print result of wrapping addition

rite main() {
    // Max i32 + 1 should wrap to min value (or panic depending on mode)
    ≔ x: i32 = 2147483647;
    ≔ y: i32 = 1;
    // Using wrapping semantics
    ≔ result = x + y;
    println(result);
}
