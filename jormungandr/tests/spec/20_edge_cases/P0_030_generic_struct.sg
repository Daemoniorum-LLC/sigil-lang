// Test: Generic struct instantiation
// Spec: 03-TYPES.md § Generics
// Priority: P0
//
// Purpose:
// Validates generic structs with different type parameters.
//
// Expected behavior:
// Should correctly instantiate generic structs

struct Pair<T, U> {
    first: T,
    second: U,
}

fn main() {
    let p1 = Pair { first: 10, second: "hello" };
    println(p1.first);
    println(p1.second);

    let p2 = Pair { first: true, second: 3.14 };
    println(p2.first);
    println(p2.second);
}
