// Test: Vec operations
// Spec: 09-STDLIB.md § Vec
// Priority: P0
//
// Purpose:
// Validates Vec push, pop, and length operations.
//
// Expected behavior:
// Should correctly modify and query Vec

fn main() {
    let mut v = Vec::new();
    v.push(10);
    v.push(20);
    v.push(30);
    println(v.len());
    
    let x = v.pop();
    match x {
        Some(n) => println(n),
        None => println("empty"),
    }
    
    println(v.len());
}
