// Test: Reference as struct field
// Spec: 04-MEMORY.md § 3.3 References in Structs
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate references can be stored in struct fields.
//
// Expected behavior:
// Should print 42

pub struct Wrapper {
    inner: &!i32
}

fn main() {
    let val: !i32 = 42;
    let w: !Wrapper = Wrapper { inner: &val };
    println(*w.inner);
}
