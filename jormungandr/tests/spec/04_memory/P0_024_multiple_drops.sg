// Test: Multiple drops of same scope
// Spec: 04-MEMORY.md § 3.1 Drop Trait
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validates all Drop values are dropped at scope exit.
//
// Expected behavior:
// Three drops should be printed

sigil Counter {}

⊢ Counter : Drop {
    rite drop(vary this) {
        println("drop");
    }
}

rite main() {
    {
        ≔ a = Counter {};
        ≔ b = Counter {};
        ≔ c = Counter {};
    }
    println("done");
}
