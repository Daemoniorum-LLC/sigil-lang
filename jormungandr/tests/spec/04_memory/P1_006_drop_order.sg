// Test: Drop Θ is called
// Spec: 04-MEMORY.md § 6.2 Drop
// Priority: P1 - Production Ready

Σ Dropper {
    id: !i32,
}

⊢ Drop ∀ Dropper {
    rite drop(&Δ self) {
        println(self.id);
    }
}

rite main() {
    ≔ a = Dropper { id: 100 };

    println(0);
    // Drop happens at end of scope
}
