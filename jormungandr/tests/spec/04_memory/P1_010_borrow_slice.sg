// SKIP: Requires &Vec<T> → &[T] slice coercion (not yet implemented)
// Test: Borrowing slices from vectors
// Spec: 04-MEMORY.md § 3 Borrowing
// Priority: P1 - Production Ready

fn sum_slice(s: &[i32]) -> !i32 {
    let mut total: !i32 = 0;
    let mut i: !i32 = 0;
    while i < s.len() {
        total = total + s[i];
        i = i + 1;
    }
    total
}

fn main() {
    let v: Vec<i32> = vec![1, 2, 3, 4, 5];

    // Borrow whole vec as slice
    let total = sum_slice(&v);
    println(total);

    // Vec still usable
    println(v.len());
}
