// Test: Drop aspect basic usage
// Spec: 04-MEMORY.md § 2.4 Drop Trait
// Priority: P0 - Bootstrap Critical
//
// FIXED: Drop aspect now works! (Jan 15, 2026)
// Rust compiler automatically calls Drop·drop() when values go out of scope.
//
// Purpose:
// Validate Drop aspect executes cleanup correctly.
//
// Expected behavior:
// Should print 42 then "dropped"

☉ sigil Value {
    x: !i32
}

⊢ Value : Drop {
    rite drop(vary this) {
        println("dropped");
    }
}

rite main() {
    ≔ v: !Value = Value { x: 42 };
    println(v.x);
}
