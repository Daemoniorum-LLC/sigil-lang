// Test: Drop Θ basic usage
// Spec: 04-MEMORY.md § 2.4 Drop Trait
// Priority: P0 - Bootstrap Critical
//
// FIXED: Drop Θ now works! (Jan 15, 2026)
// Rust compiler automatically calls Drop·drop() when values go out of scope.
//
// Purpose:
// Validate Drop Θ executes cleanup correctly.
//
// Expected behavior:
// Should print 42 then "dropped"

☉ Σ Value {
    x: !i32
}

⊢ Drop ∀ Value {
    rite drop(Δ self) {
        println("dropped");
    }
}

rite main() {
    ≔ v: !Value = Value { x: 42 };
    println(v.x);
}
