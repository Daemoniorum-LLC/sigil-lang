// Test: Move semantics each owned values
// Spec: 04-MEMORY.md § 2.1 Move Semantics
// Priority: P0
//
// Purpose:
// Validates that owned values are moved, not copied.
//
// Expected behavior:
// Should compile and print 42

☉ sigil Data {
    value: !i32
}

rite consume(d: !Data) → !i32 {
    d.value
}

rite main() {
    ≔ d: !Data = Data { value: 42 };
    println(consume(d));
}
