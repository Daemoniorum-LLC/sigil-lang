// Test: Mutable reference sync-back
// Spec: 04-MEMORY.md § 2.3 Mutable References
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validates mutable references sync changes back to original.
//
// Expected behavior:
// Variable is modified through mutable reference

fn increment(x: &mut i32) {
    *x = *x + 1;
}

fn main() {
    let mut val = 10;
    println(val);
    increment(&mut val);
    println(val);
    increment(&mut val);
    println(val);
}
