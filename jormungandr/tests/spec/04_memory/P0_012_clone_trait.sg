// Test: Clone aspect implementation
// Spec: 04-MEMORY.md § 2.3 Clone Trait
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Clone aspect works correctly.
//
// Expected behavior:
// Should print 42

☉ sigil Value {
    x: !i32
}

⊢ Value : Clone {
    rite clone(this) → !Value {
        Value { x: this.x }
    }
}

rite main() {
    ≔ v: !Value = Value { x: 42 };
    ≔ v2: !Value = v.clone();
    println(v2.x);
}
