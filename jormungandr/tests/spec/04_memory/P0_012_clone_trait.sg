// Test: Clone Θ implementation
// Spec: 04-MEMORY.md § 2.3 Clone Trait
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Clone Θ works correctly.
//
// Expected behavior:
// Should print 42

☉ Σ Value {
    x: !i32
}

⊢ Clone ∀ Value {
    λ clone(self) -> !Value {
        Value { x: self.x }
    }
}

λ main() {
    ≔ v: !Value = Value { x: 42 };
    ≔ v2: !Value = v.clone();
    println(v2.x);
}
