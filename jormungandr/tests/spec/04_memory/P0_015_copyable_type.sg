// Test: Copyable type (i32)
// Spec: 04-MEMORY.md § 2.2 Copy Trait
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Copy types can be used after move.
//
// Expected behavior:
// Should print 42 twice

fn print_twice(x: !i32, y: !i32) {
    println(x);
    println(y);
}

fn main() {
    let val: !i32 = 42;
    let val2: !i32 = val;  // Copy, not move
    print_twice(val, val2);
}
