// Test: Owned value (move semantics)
// Spec: 04-MEMORY.md § 1.1 Owned Values
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate owned values follow move semantics.
//
// Expected behavior:
// Should print 42

fn consume(x: !i32) -> !i32 {
    x
}

fn main() {
    let val: !i32 = 42;
    let result: !i32 = consume(val);
    println(result);
}
