// Test: Nested scope drops
// Spec: 04-MEMORY.md § 3.1 Drop Trait
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validates Drop respects nested scope boundaries.
//
// Expected behavior:
// Inner scope values dropped before outer continues

struct Logger {
    msg: String
}

impl Drop for Logger {
    fn drop(&mut self) {
        println(self.msg);
    }
}

fn main() {
    let outer = Logger { msg: "outer".to_string() };
    println("start");
    {
        let inner = Logger { msg: "inner".to_string() };
        println("inside");
    }
    println("after inner");
}
