// Test: Lifetime annotation basic usage
// Spec: 04-MEMORY.md § 4.1 Lifetime Annotations
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate lifetime annotations work correctly.
//
// Expected behavior:
// Should print 42

fn longest<'a>(x: &'a !i32, y: &'a !i32) -> &'a !i32 {
    if *x > *y {
        x
    } else {
        y
    }
}

fn main() {
    let a: !i32 = 42;
    let b: !i32 = 13;
    let result: &!i32 = longest(&a, &b);
    println(*result);
}
