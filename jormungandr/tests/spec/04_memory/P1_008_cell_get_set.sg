// Test: Cell get and set without borrowing
// Spec: 04-MEMORY.md § 5.1 Cell
// Priority: P1 - Production Ready

rite main() {
    ≔ cell: Cell<i32> = Cell·new(5);

    // Get copies value out
    println(cell.get());

    // Set replaces value
    cell.set(10);
    println(cell.get());

    // Multiple sets
    cell.set(cell.get() + 5);
    println(cell.get());
}
