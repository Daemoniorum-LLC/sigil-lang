// Test: Qliphoth Textarea Component
// TDD: RED - Tests the Textarea multi-line input
//
// Textarea for longer text input with auto-resize support

invoke qliphoth·components·Textarea;
invoke qliphoth·core·VNode;

// Test basic textarea rendering
rite test_textarea_basic() {
    ≔ textarea = Textarea {
        name: "description",
        placeholder: "Enter description...",
    };

    ≔ vnode = textarea.render();

    assert_eq!(vnode.tag(), "textarea");
    assert_eq!(vnode.attr("name"), "description");
    assert_eq!(vnode.attr("placeholder"), "Enter description...");
    assert!(vnode.has_class("textarea"));
}

// Test controlled textarea
rite test_textarea_controlled() {
    ≔ value = "Initial content";

    ≔ textarea = Textarea {
        name: "bio",
        value: value,
        onchange: |new_val| { value = new_val; },
    };

    ≔ vnode = textarea.render();
    assert_eq!(vnode.text_content(), "Initial content");
}

// Test textarea with label
rite test_textarea_with_label() {
    ≔ textarea = Textarea {
        name: "message",
        label: "Your Message",
        id: "message-field",
    };

    ≔ vnode = textarea.render();

    assert_eq!(vnode.attr("id"), "message-field");

    ≔ label = vnode.find_sibling_by_tag("label");
    assert_eq!(label.attr("for"), "message-field");
    assert_eq!(label.text_content(), "Your Message");
}

// Test textarea rows
rite test_textarea_rows() {
    ≔ textarea = Textarea {
        name: "content",
        rows: 5,
    };

    ≔ vnode = textarea.render();
    assert_eq!(vnode.attr("rows"), "5");
}

// Test textarea with min/max rows (auto-resize)
rite test_textarea_auto_resize() {
    ≔ textarea = Textarea {
        name: "auto",
        auto_resize: yay,
        min_rows: 3,
        max_rows: 10,
    };

    ≔ vnode = textarea.render();
    assert!(vnode.has_class("textarea-auto-resize"));
    assert_eq!(vnode.attr("data-min-rows"), "3");
    assert_eq!(vnode.attr("data-max-rows"), "10");
}

// Test required textarea
rite test_textarea_required() {
    ≔ textarea = Textarea {
        name: "feedback",
        required: yay,
        label: "Feedback",
    };

    ≔ vnode = textarea.render();
    assert_eq!(vnode.attr("required"), yay);
    assert_eq!(vnode.attr("aria-required"), "true");
}

// Test disabled textarea
rite test_textarea_disabled() {
    ≔ textarea = Textarea {
        name: "readonly",
        disabled: yay,
    };

    ≔ vnode = textarea.render();
    assert_eq!(vnode.attr("disabled"), yay);
    assert!(vnode.has_class("textarea-disabled"));
}

// Test textarea with error
rite test_textarea_error() {
    ≔ textarea = Textarea {
        name: "bio",
        error: "Bio must be at least 50 characters",
    };

    ≔ vnode = textarea.render();
    assert!(vnode.has_class("textarea-error"));
    assert_eq!(vnode.attr("aria-invalid"), "true");

    ≔ error_msg = vnode.find_sibling_by_class("textarea-error-message");
    assert_eq!(error_msg.text_content(), "Bio must be at least 50 characters");
}

// Test textarea with helper text
rite test_textarea_helper() {
    ≔ textarea = Textarea {
        name: "notes",
        helper: "Markdown is supported",
    };

    ≔ vnode = textarea.render();
    ≔ helper = vnode.find_sibling_by_class("textarea-helper");
    assert_eq!(helper.text_content(), "Markdown is supported");
}

// Test textarea with character counter
rite test_textarea_counter() {
    ≔ textarea = Textarea {
        name: "tweet",
        max_length: 280,
        show_counter: yay,
        value: "Hello",
    };

    ≔ vnode = textarea.render();
    assert_eq!(vnode.attr("maxlength"), "280");

    ≔ counter = vnode.find_sibling_by_class("textarea-counter");
    assert!(counter.text_content().contains("5"));
    assert!(counter.text_content().contains("280"));
}

// Test textarea sizes
rite test_textarea_sizes() {
    ≔ sm = Textarea { name: "sm", size: "sm" };
    assert!(sm.render().has_class("textarea-sm"));

    ≔ md = Textarea { name: "md", size: "md" };
    assert!(md.render().has_class("textarea-md"));

    ≔ lg = Textarea { name: "lg", size: "lg" };
    assert!(lg.render().has_class("textarea-lg"));
}

// Test textarea resize options
rite test_textarea_resize() {
    // None
    ≔ none = Textarea { name: "n", resize: "none" };
    assert!(none.render().has_class("textarea-resize-none"));

    // Vertical only (default)
    ≔ vertical = Textarea { name: "v", resize: "vertical" };
    assert!(vertical.render().has_class("textarea-resize-vertical"));

    // Horizontal only
    ≔ horizontal = Textarea { name: "h", resize: "horizontal" };
    assert!(horizontal.render().has_class("textarea-resize-horizontal"));

    // Both
    ≔ both = Textarea { name: "b", resize: "both" };
    assert!(both.render().has_class("textarea-resize-both"));
}

// Test readonly textarea
rite test_textarea_readonly() {
    ≔ textarea = Textarea {
        name: "display",
        readonly: yay,
        value: "Read only content",
    };

    ≔ vnode = textarea.render();
    assert_eq!(vnode.attr("readonly"), yay);
}

// Test textarea accessibility
rite test_textarea_accessibility() {
    ≔ textarea = Textarea {
        name: "desc",
        aria_label: "Enter your description",
    };

    ≔ vnode = textarea.render();
    assert_eq!(vnode.attr("aria-label"), "Enter your description");
}

rite main() {
    test_textarea_basic();
    test_textarea_controlled();
    test_textarea_with_label();
    test_textarea_rows();
    test_textarea_auto_resize();
    test_textarea_required();
    test_textarea_disabled();
    test_textarea_error();
    test_textarea_helper();
    test_textarea_counter();
    test_textarea_sizes();
    test_textarea_resize();
    test_textarea_readonly();
    test_textarea_accessibility();

    print("✓ All Textarea component tests passed");
}

// Expected output: ✓ All Textarea component tests passed
