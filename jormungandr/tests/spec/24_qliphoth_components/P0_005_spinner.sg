// Test: Qliphoth Spinner Component
// TDD: RED - Tests the Spinner loading indicator component
//
// Spinner provides visual feedback during async operations

invoke qliphoth·components·Spinner;
invoke qliphoth·core·VNode;

// Test basic spinner rendering
rite test_spinner_basic() {
    ≔ spinner = Spinner {};

    ≔ vnode = spinner.render();

    assert!(vnode.has_class("spinner"));
    // Should have accessible role
    assert_eq!(vnode.attr("role"), "status");
    // Should have aria-live for screen readers
    assert_eq!(vnode.attr("aria-live"), "polite");
}

// Test spinner sizes
rite test_spinner_sizes() {
    // Extra small
    ≔ xs = Spinner { size: "xs" };
    assert!(xs.render().has_class("spinner-xs"));

    // Small
    ≔ sm = Spinner { size: "sm" };
    assert!(sm.render().has_class("spinner-sm"));

    // Medium (default)
    ≔ md = Spinner { size: "md" };
    assert!(md.render().has_class("spinner-md"));

    // Large
    ≔ lg = Spinner { size: "lg" };
    assert!(lg.render().has_class("spinner-lg"));

    // Extra large
    ≔ xl = Spinner { size: "xl" };
    assert!(xl.render().has_class("spinner-xl"));
}

// Test spinner variants
rite test_spinner_variants() {
    // Default/primary
    ≔ primary = Spinner { variant: "primary" };
    assert!(primary.render().has_class("spinner-primary"));

    // Secondary
    ≔ secondary = Spinner { variant: "secondary" };
    assert!(secondary.render().has_class("spinner-secondary"));

    // Inverted (for dark backgrounds)
    ≔ inverted = Spinner { variant: "inverted" };
    assert!(inverted.render().has_class("spinner-inverted"));

    // Current color (inherits from parent)
    ≔ current = Spinner { variant: "current" };
    assert!(current.render().has_class("spinner-current"));
}

// Test spinner with label
rite test_spinner_with_label() {
    ≔ spinner = Spinner {
        label: "Loading...",
    };

    ≔ vnode = spinner.render();

    // Should show label
    assert!(vnode.has_child_with_class("spinner-label"));
    assert!(vnode.text_content().contains("Loading..."));

    // Label should be accessible
    assert_eq!(vnode.attr("aria-label"), "Loading...");
}

// Test spinner label positions
rite test_spinner_label_positions() {
    // Label below (default)
    ≔ below = Spinner { label: "Loading", label_position: "below" };
    assert!(below.render().has_class("spinner-label-below"));

    // Label to the right
    ≔ right = Spinner { label: "Loading", label_position: "right" };
    assert!(right.render().has_class("spinner-label-right"));

    // Label to the left
    ≔ left = Spinner { label: "Loading", label_position: "left" };
    assert!(left.render().has_class("spinner-label-left"));

    // Label above
    ≔ above = Spinner { label: "Loading", label_position: "above" };
    assert!(above.render().has_class("spinner-label-above"));
}

// Test spinner appearance types
rite test_spinner_appearance() {
    // Circular (default)
    ≔ circular = Spinner { appearance: "circular" };
    assert!(circular.render().has_class("spinner-circular"));

    // Dots
    ≔ dots = Spinner { appearance: "dots" };
    assert!(dots.render().has_class("spinner-dots"));

    // Bar
    ≔ bar = Spinner { appearance: "bar" };
    assert!(bar.render().has_class("spinner-bar"));

    // Pulse
    ≔ pulse = Spinner { appearance: "pulse" };
    assert!(pulse.render().has_class("spinner-pulse"));
}

// Test spinner delay (for avoiding flash)
rite test_spinner_delay() {
    ≔ spinner = Spinner {
        delay: 200, // ms before showing
    };

    ≔ vnode = spinner.render();
    // Should have delay style or data attribute
    assert_eq!(vnode.attr("data-delay"), "200");
}

// Test overlay spinner
rite test_spinner_overlay() {
    ≔ spinner = Spinner {
        overlay: yay,
        label: "Processing...",
    };

    ≔ vnode = spinner.render();
    assert!(vnode.has_class("spinner-overlay"));
    // Overlay should block interaction
    assert!(vnode.has_class("spinner-blocking"));
}

// Test inline spinner
rite test_spinner_inline() {
    ≔ spinner = Spinner {
        inline: yay,
        size: "xs",
    };

    ≔ vnode = spinner.render();
    assert!(vnode.has_class("spinner-inline"));
}

// Test spinner accessibility
rite test_spinner_accessibility() {
    // Hidden label for screen readers only
    ≔ spinner = Spinner {
        aria_label: "Loading content",
        label_hidden: yay,
    };

    ≔ vnode = spinner.render();
    assert_eq!(vnode.attr("aria-label"), "Loading content");
    // Visual label should be hidden
    ≔ label = vnode.find_child_by_class("spinner-label");
    assert!(label.has_class("sr-only"));
}

rite main() {
    test_spinner_basic();
    test_spinner_sizes();
    test_spinner_variants();
    test_spinner_with_label();
    test_spinner_label_positions();
    test_spinner_appearance();
    test_spinner_delay();
    test_spinner_overlay();
    test_spinner_inline();
    test_spinner_accessibility();

    print("✓ All Spinner component tests passed");
}

// Expected output: ✓ All Spinner component tests passed
