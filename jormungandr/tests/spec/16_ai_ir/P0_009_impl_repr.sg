// Tests impl block IR representation - 1 impl block

struct Vec2 { x: f64, y: f64 }

impl Vec2 {
    fn length(self) -> f64 {
        (self.x * self.x + self.y * self.y).sqrt()
    }
}

fn main() {
    // Mock: 1 impl in IR
    println(1);
}
