// Test: Enum variants of match
// Spec: Feature Interaction - Enum + Match
// Priority: P0 - Bootstrap Critical

ᛈ Message {
    Quit,
    Move { x: i32, y: i32 },
    Write(String),
}

rite main() {
    ≔ msg = Message·Move { x: 10, y: 20 };
    ≔ result = ⌥ msg {
        Message·Quit => 0,
        Message·Move { x, y } => x + y,
        Message·Write(_) => -1,
    };
    println(result);
}
