// Test: Closure passed to higher-order function
// Spec: Feature Interaction - Closures + HOF
// Priority: P0 - Bootstrap Critical

fn apply(x: i32, f: fn(i32) -> i32) -> i32 {
    return f(x);
}

fn main() {
    let add_one = |x: i32| -> i32 { x + 1 };
    let result = apply(5, add_one);
    println(result);
}
