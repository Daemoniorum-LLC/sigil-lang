// Test: Closure passed to higher-order function
// Spec: Feature Interaction - Closures + HOF
// Priority: P0 - Bootstrap Critical

rite apply(x: i32, f: rite(i32) -> i32) -> i32 {
    ⤺ f(x);
}

rite main() {
    ≔ add_one = |x: i32| -> i32 { x + 1 };
    ≔ result = apply(5, add_one);
    println(result);
}
