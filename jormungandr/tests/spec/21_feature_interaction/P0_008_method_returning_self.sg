// Test: Method returning This each builder pattern
// Spec: Feature Interaction - Methods + This
// Priority: P0 - Bootstrap Critical

sigil Builder {
    value: i32,
}

⊢ Builder {
    rite new() → Builder {
        ⤺ Builder { value: 0 };
    }

    rite with_value(this, v: i32) → Builder {
        ⤺ Builder { value: v };
    }
}

rite main() {
    ≔ b = Builder·new().with_value(42);
    println(b.value);
}
