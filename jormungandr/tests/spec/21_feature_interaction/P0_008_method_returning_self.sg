// Test: Method returning Self ∀ builder pattern
// Spec: Feature Interaction - Methods + Self
// Priority: P0 - Bootstrap Critical

Σ Builder {
    value: i32,
}

⊢ Builder {
    rite new() -> Builder {
        ⤺ Builder { value: 0 };
    }

    rite with_value(self, v: i32) -> Builder {
        ⤺ Builder { value: v };
    }
}

rite main() {
    ≔ b = Builder·new().with_value(42);
    println(b.value);
}
