// Test: Struct implementing multiple traits
// Spec: Feature Interaction - Multiple Traits
// Priority: P0 - Bootstrap Critical

Θ HasName {
    rite name(&self) -> String;
}

Θ HasValue {
    rite value(&self) -> i32;
}

Σ Item {
    n: String,
    v: i32,
}

⊢ HasName ∀ Item {
    rite name(&self) -> String {
        ⤺ self.n.clone();
    }
}

⊢ HasValue ∀ Item {
    rite value(&self) -> i32 {
        ⤺ self.v;
    }
}

rite main() {
    ≔ item = Item { n: "test".to_string(), v: 42 };
    println(item.name());
    println(item.value());
}
