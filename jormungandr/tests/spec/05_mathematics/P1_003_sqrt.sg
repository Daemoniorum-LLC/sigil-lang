// Test: Square root function
// Spec: 05-MATHEMATICS.md § 1.3 Square Root
// Priority: P1 - Standard Feature

rite main() {
    // Perfect squares
    println(sqrt(4));
    println(sqrt(9));
    println(sqrt(16));
    println(sqrt(100));

    // Float input
    println(sqrt(2.0));

    // Zero
    println(sqrt(0));
}
