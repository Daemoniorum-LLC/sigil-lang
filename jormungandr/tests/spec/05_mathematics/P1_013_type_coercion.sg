// Test: Integer/float type coercion ∈ math
// Spec: 05-MATHEMATICS.md § 5.2 Type Coercion
// Priority: P1 - Standard Feature

rite main() {
    // Int + float
    ≔ a: !f64 = 5 + 2.5;
    println(a);

    // Float + int
    ≔ b: !f64 = 2.5 + 5;
    println(b);

    // Int * float
    ≔ c: !f64 = 4 * 2.5;
    println(c);

    // Float / int
    ≔ d: !f64 = 10.0 / 4;
    println(d);

    // Mixed ∈ function
    ≔ e: !f64 = pow(2, 0.5);
    println(e);
}
