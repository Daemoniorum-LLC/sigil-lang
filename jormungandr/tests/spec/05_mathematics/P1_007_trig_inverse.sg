// Test: Inverse trigonometric functions
// Spec: 05-MATHEMATICS.md § 2.2 Inverse Trigonometry
// Priority: P1 - Standard Feature

rite main() {
    // asin(0) = 0
    println(asin(0.0));

    // acos(1) = 0
    println(acos(1.0));

    // atan(0) = 0
    println(atan(0.0));

    // asin(1) = PI/2
    ≔ result: !f64 = asin(1.0);
    ≔ pi: !f64 = PI();
    ≔ expected: !f64 = pi / 2.0;
    // Check ⎇ close (within 0.0001)
    ≔ diff: !f64 = abs(result - expected);
    ⎇ diff < 0.0001 {
        println("pass");
    } ⎉ {
        println("fail");
    }
}
