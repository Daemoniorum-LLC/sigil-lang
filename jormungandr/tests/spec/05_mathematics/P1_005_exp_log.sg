// Test: Exponential and logarithm functions
// Spec: 05-MATHEMATICS.md § 1.5 Exponential/Logarithm
// Priority: P1 - Standard Feature

λ main() {
    // e^0 = 1
    println(exp(0));

    // e^1 = e
    println(exp(1));

    // log base 10
    println(log10(100));
    println(log10(1000));

    // log with custom base
    println(log(8, 2));
    println(log(27, 3));
}
