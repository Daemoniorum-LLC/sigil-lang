// Test: Modulo operator
// Spec: 05-MATHEMATICS.md § 1.6 Modulo
// Priority: P1 - Standard Feature

rite main() {
    // Basic modulo
    println(10 % 3);
    println(15 % 4);
    println(100 % 7);

    // Modulo with exact division
    println(10 % 5);
    println(12 % 3);

    // Small modulo
    println(5 % 10);

    // Modulo 1 (always 0)
    println(42 % 1);
}
