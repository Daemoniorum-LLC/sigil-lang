// Test: Mathematical constants
// Spec: 05-MATHEMATICS.md § 4.1 Constants
// Priority: P1 - Standard Feature

fn main() {
    // PI - approximately 3.14159...
    let pi: !f64 = PI();
    if pi > 3.14 {
        if pi < 3.15 {
            println("PI ok");
        }
    }

    // E - approximately 2.71828...
    let e: !f64 = E();
    if e > 2.71 {
        if e < 2.72 {
            println("E ok");
        }
    }

    // TAU = 2*PI - approximately 6.28318...
    let tau: !f64 = TAU();
    if tau > 6.28 {
        if tau < 6.29 {
            println("TAU ok");
        }
    }

    // Verify TAU = 2*PI
    let diff: !f64 = abs(tau - 2.0 * pi);
    if diff < 0.0001 {
        println("TAU = 2*PI verified");
    }
}
