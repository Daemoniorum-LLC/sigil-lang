// Test: Absolute value function
// Spec: 05-MATHEMATICS.md § 1.2 Absolute Value
// Priority: P1 - Standard Feature

fn main() {
    // Positive int stays positive
    println(abs(42));

    // Negative int becomes positive
    println(abs(-42));

    // Zero stays zero
    println(abs(0));

    // Positive float
    println(abs(3.14));

    // Negative float
    println(abs(-3.14));
}
