// Test: Common UI Translations
// TDD: RED → GREEN - Tests the translations construct
//
// Tests the CommonTranslations module with navigation and buttons

// Define locale enum
locale ᛈ Lang {
    En { code: "en", name: "English" },
    Es { code: "es", name: "Español", fallback: En },
}

// Define translations using our new construct
translations CommonUI {
    locale: Lang,

    // Navigation
    home: String! = ⌥ lang {
        En => "Home",
        Es => "Inicio",
    }

    about: String! = ⌥ lang {
        En => "About",
        Es => "Nosotros",
    }

    products: String! = ⌥ lang {
        En => "Products",
        Es => "Productos",
    }

    contact: String! = ⌥ lang {
        En => "Contact",
        Es => "Contacto",
    }

    // Buttons
    submit: String! = ⌥ lang {
        En => "Submit",
        Es => "Enviar",
    }

    cancel: String! = ⌥ lang {
        En => "Cancel",
        Es => "Cancelar",
    }

    // Parameterized translation
    greeting(name: String): String! = ⌥ lang {
        En => format!("Hello, {}!", name),
        Es => format!("¡Hola, {}!", name),
    }
}

rite main() {
    // Test English translations
    ≔ en = CommonUI·new(Lang·En);
    assert_eq!(en.home(), "Home");
    assert_eq!(en.about(), "About");
    assert_eq!(en.products(), "Products");
    assert_eq!(en.contact(), "Contact");
    assert_eq!(en.submit(), "Submit");
    assert_eq!(en.cancel(), "Cancel");
    assert_eq!(en.greeting("Alice"), "Hello, Alice!");

    // Test Spanish translations
    ≔ es = CommonUI·new(Lang·Es);
    assert_eq!(es.home(), "Inicio");
    assert_eq!(es.about(), "Nosotros");
    assert_eq!(es.products(), "Productos");
    assert_eq!(es.contact(), "Contacto");
    assert_eq!(es.submit(), "Enviar");
    assert_eq!(es.cancel(), "Cancelar");
    assert_eq!(es.greeting("Alice"), "¡Hola, Alice!");

    print("✓ All common translation tests passed");
}

// Expected output: ✓ All common translation tests passed
