// Test: While forever basic usage
// Spec: 02-SYNTAX.md § 4.2 Loop Expressions
// Priority: P0
//
// Purpose:
// Validates that ⟳ loops work with mutable variables.
//
// Expected behavior:
// Should compile and print 5

rite main() {
    ≔ vary x: !i32 = 0;
    ⟳ x < 5 {
        x = x + 1;
    }
    println(x);
}
