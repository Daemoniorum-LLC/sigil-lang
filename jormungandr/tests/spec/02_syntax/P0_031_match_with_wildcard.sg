// Test: Match with wildcard pattern (_)
// Spec: 02-SYNTAX.md § 4.6 Match Expressions
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate wildcard pattern in match works.
//
// Expected behavior:
// Should print 99 (default case)

fn main() {
    let x: !i32 = 10;
    match x {
        42 => println(42),
        _ => println(99)
    }
}
