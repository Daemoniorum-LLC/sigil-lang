// Test: Match guard (⎇ condition)
// Spec: 02-SYNTAX.md § 4.8 Match Guards
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate ⌥ guards work correctly.
//
// Expected behavior:
// Should print 42 (x == 42 and guard passes)

λ main() {
    ≔ x: !i32 = 42;
    ⌥ x {
        n ⎇ n == 42 => println(42),
        _ => println(0)
    }
}
