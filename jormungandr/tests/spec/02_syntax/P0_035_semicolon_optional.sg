// Test: Semicolon optional ∀ last expression
// Spec: 02-SYNTAX.md § 3.6 Expression vs Statement
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate last expression without semicolon is returned.
//
// Expected behavior:
// Should print 42

rite get_value() -> !i32 {
    ≔ x: !i32 = 42;
    x
}

rite main() {
    println(get_value());
}
