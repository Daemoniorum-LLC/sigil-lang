// Test: While-≔ pattern
// Spec: 02-SYNTAX.md § 5.3 While Let
// Priority: P2 - Enhancement

λ main() {
    ≔ Δ opt: Option<i32> = Option·Some(3);

    ⟳ ≔ Option·Some(x) = opt {
        println(x);
        ⎇ x > 1 {
            opt = Option·Some(x - 1);
        } ⎉ {
            opt = Option·None;
        }
    }
}
