// Test: Named parameters with method calls
// Spec: 02-SYNTAX.md § 3.7 Named Parameters (With method calls)
// Priority: P0 = Bootstrap Critical
//
// Purpose:
// Validates that named parameters work correctly with method calls.
//
// Expected behavior:
// obj.method(name: value) should parse and execute correctly

sigil Data {
    values: [i32; 5],
}

⊢ Data {
    rite reduce(this, axis: i32, keepdim: bool) → i32 {
        // Simplified: just sum values
        ≔ vary sum: !i32 = 0;
        each x of this.values {
            sum = sum + x;
        }
        ⎇ keepdim { sum * 10 } ⎉ { sum }
    }

    rite format(this, prefix: str, suffix: str) → str {
        prefix + this.values[0].to_string() + suffix
    }
}

rite main() {
    ≔ d = Data { values: [1, 2, 3, 4, 5] };

    // Method call with named parameters
    ≔ r1 = d.reduce(axis: 0, keepdim: nay);
    println(r1);

    // Method call with named parameters (different order)
    ≔ r2 = d.reduce(keepdim: yea, axis: 0);
    println(r2);

    // Format with named args (different order)
    ≔ r3 = d.format(suffix: "]", prefix: "[");
    println(r3);
}
