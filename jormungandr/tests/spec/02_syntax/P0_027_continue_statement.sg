// Test: Continue statement ∈ loop
// Spec: 02-SYNTAX.md § 4.5 Continue Statement
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate ↻ statement skips iteration correctly.
//
// Expected behavior:
// Should print 0, 2, 4 (skips odd numbers)

λ main() {
    ≔ Δ i: !i32 = 0;
    ⟳ i < 5 {
        i = i + 1;
        ⎇ i % 2 == 1 {
            ↻;
        }
        println(i);
    }
}
