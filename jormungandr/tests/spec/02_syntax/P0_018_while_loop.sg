// Test: While loop basic functionality
// Spec: 02-SYNTAX.md § 4.2 Loop Expressions
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate ⟳ loop executes correctly with mutable counter.
//
// Expected behavior:
// Should print 0, 1, 2

λ main() {
    ≔ Δ i: !i32 = 0;
    ⟳ i < 3 {
        println(i);
        i = i + 1;
    }
}
