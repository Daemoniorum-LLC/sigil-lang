// Test: Nested ⌥ expressions
// Spec: 02-SYNTAX.md § 5.3 Match
// Priority: P2 - Enhancement

rite main() {
    ≔ outer: !i32 = 1;
    ≔ inner: !i32 = 2;

    ⌥ outer {
        1 => {
            ⌥ inner {
                1 => println(11),
                2 => println(12),
                _ => println(10),
            }
        },
        _ => println(0),
    }
}
