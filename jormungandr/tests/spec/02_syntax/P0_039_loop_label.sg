// Test: Loop labels ∀ ⊗/↻
// Spec: 02-SYNTAX.md § 4.7 Loop Labels
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate loop labels work with ⊗.
//
// Expected behavior:
// Should print 0, 1, 2

λ main() {
    ≔ Δ i: !i32 = 0;
    'outer: ⟳ i < 5 {
        ⎇ i >= 3 {
            ⊗ 'outer;
        }
        println(i);
        i = i + 1;
    }
}
