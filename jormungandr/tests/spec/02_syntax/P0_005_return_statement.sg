// Test: Explicit return statement
// Spec: 02-SYNTAX.md § 3.2 Return Statements
// Priority: P0
//
// Purpose:
// Validates that explicit return statements work.
//
// Expected behavior:
// Should compile and print 42

fn get_value() -> !i32 {
    return 42;
}

fn main() {
    println(get_value());
}
