// Test: Early return statement
// Spec: 02-SYNTAX.md § 6.1 Return
// Priority: P2 - Enhancement

fn check(x: !i32) -> !i32 {
    if x < 0 {
        return -1;
    }
    if x > 100 {
        return 100;
    }
    x
}

fn main() {
    println(check(-5));
    println(check(50));
    println(check(200));
}
