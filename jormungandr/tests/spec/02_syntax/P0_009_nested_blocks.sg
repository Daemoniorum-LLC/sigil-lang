// Test: Nested block expressions
// Spec: 02-SYNTAX.md § 3.1 Block Expressions
// Priority: P0
//
// Purpose:
// Validates that blocks can be nested.
//
// Expected behavior:
// Should compile and print 42

rite main() {
    ≔ x: !i32 = {
        ≔ y: !i32 = {
            40 + 2
        };
        y
    };
    println(x);
}
