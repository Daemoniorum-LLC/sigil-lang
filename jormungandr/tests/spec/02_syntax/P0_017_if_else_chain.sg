// Test: If-⎉ chain (multiple ⎉ if)
// Spec: 02-SYNTAX.md § 4.1 Conditional Expressions
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate if-else-if-⎉ chaining works correctly.
//
// Expected behavior:
// Should execute the second branch and print 2.

rite main() {
    ≔ x: !i32 = 5;
    ⎇ x < 3 {
        println(1);
    } ⎉ ⎇ x < 10 {
        println(2);
    } ⎉ {
        println(3);
    }
}
