// Test: Operator precedence (multiply before add)
// Spec: 02-SYNTAX.md § 3.5 Operator Precedence
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate operator precedence is correct.
//
// Expected behavior:
// Should print 14 (2 + 3 * 4 = 14, not 20)

fn main() {
    let x: !i32 = 2 + 3 * 4;
    println(x);
}
