// Test: Block expression with implicit return
// Spec: 02-SYNTAX.md § 3.1 Block Expressions
// Priority: P0
//
// Purpose:
// Validates that block expressions return the last expression.
//
// Expected behavior:
// Should compile and print 42

fn main() {
    let x: !i32 = {
        let y: !i32 = 40;
        y + 2
    };
    println(x);
}
