// Test: Deeply nested if
// Spec: 02-SYNTAX.md § 5.1 If
// Priority: P2 - Enhancement

fn main() {
    let a: !i32 = 1;
    let b: !i32 = 2;
    let c: !i32 = 3;

    if a > 0 {
        if b > 1 {
            if c > 2 {
                println(1);
            } else {
                println(0);
            }
        } else {
            println(0);
        }
    } else {
        println(0);
    }
}
