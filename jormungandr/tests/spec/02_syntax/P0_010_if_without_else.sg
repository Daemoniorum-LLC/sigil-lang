// Test: If expression without else branch
// Spec: 02-SYNTAX.md § 4.1 If Expressions
// Priority: P0
//
// Purpose:
// Validates that if without else works (unit type return).
//
// Expected behavior:
// Should compile and print 42

fn main() {
    let mut x: !i32 = 0;
    if true {
        x = 42;
    }
    println(x);
}
