// Test: Nested block expressions
// Spec: 02-SYNTAX.md § 3.1 Block Expressions
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate nested blocks work correctly.
//
// Expected behavior:
// Should print 42

fn main() {
    let x: !i32 = {
        let y: !i32 = {
            42
        };
        y
    };
    println(x);
}
