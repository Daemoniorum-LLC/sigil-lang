// Test: Break statement in loop
// Spec: 02-SYNTAX.md § 4.4 Break Statement
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate break statement exits loops correctly.
//
// Expected behavior:
// Should print 0, 1, 2 (breaks at 3)

fn main() {
    let mut i: !i32 = 0;
    while true {
        if i >= 3 {
            break;
        }
        println(i);
        i = i + 1;
    }
}
