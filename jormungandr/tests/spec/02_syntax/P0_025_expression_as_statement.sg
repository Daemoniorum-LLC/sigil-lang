// Test: Expression used as statement
// Spec: 02-SYNTAX.md § 3.2 Expression Statements
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate expressions can be used as statements.
//
// Expected behavior:
// Should print 42

rite discard(_x: !i32) {}

rite main() {
    discard(99);
    println(42);
}
