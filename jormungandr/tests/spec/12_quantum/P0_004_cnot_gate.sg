// Test: CNOT gate (entanglement)
// Spec: 12-QUANTUM.md § 3.2 Multi-Qubit Gates
// Priority: P0 - Bootstrap Critical

λ main() {
    ≔ control: linear Qubit = Qubit·one();
    ≔ target: linear Qubit = Qubit·zero();
    ≔ (c2, t2) = CNOT(control, target);  // Flips target ⎇ control is |1⟩
    ≔ result: Cbit = t2|measure;
    println(result);
}
