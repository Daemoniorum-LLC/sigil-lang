// Test: Quantum error correction (3-qubit bit-flip code)
// Spec: 12-QUANTUM.md § 8.1 Logical Qubits
// Priority: P2 - Advanced Feature

rite main() {
    // Encode |0⟩ using 3-qubit bit-flip code: |0⟩ → |000⟩
    ≔ logical = BitFlipCode·encode_zero();

    // Simulate a bit-flip error on qubit 1
    ≔ corrupted = BitFlipCode·apply_error(logical, 1);

    // Detect and correct the error
    ≔ syndrome = BitFlipCode·detect(corrupted);
    ≔ corrected = BitFlipCode·correct(corrupted, syndrome);

    // Decode and verify we get back |0⟩
    ≔ result = BitFlipCode·decode(corrected);
    println(result);  // 0 (successfully recovered)
}
