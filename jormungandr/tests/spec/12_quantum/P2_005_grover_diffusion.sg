// Test: Grover diffusion operator
// Spec: 12-QUANTUM.md § 7.1 Grover's Search
// Priority: P2 - Advanced Feature

rite main() {
    // Diffusion operator: 2|s⟩⟨s| - I where |s⟩ = uniform superposition
    // Applied to uniform superposition, should leave it unchanged

    // Create 2-qubit uniform superposition
    ≔ reg: QRegister<2> = QRegister·new(2);
    ≔ reg = QRegister·apply_all(reg, "H");  // |++⟩ = (|00⟩+|01⟩+|10⟩+|11⟩)/2

    // Apply diffusion
    ≔ reg = Grover·diffusion(reg);

    // Measure - should still be uniform (each outcome ~25%)
    ≔ results = QRegister·measure_all(reg);
    println(results.len());  // 2 qubits measured
}
