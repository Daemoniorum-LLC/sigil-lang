// Test: Entangled<A,B> wrapper type
// Spec: 12-QUANTUM.md § 4.1 Entangled Types
// Priority: P1 - Core Feature

rite main() {
    // Create Bell state - maximally entangled pair
    ≔ q0: linear Qubit = Qubit·zero();
    ≔ q1: linear Qubit = Qubit·zero();

    // H on first qubit, then CNOT creates entanglement
    ≔ q0h: linear Qubit = q0|H;
    ≔ (qc, qt): (Qubit, Qubit) = CNOT(q0h, q1);

    // Wrap ∈ Entangled type - cannot be separated
    ≔ pair: Entangled<Qubit, Qubit> = Entangled·new(qc, qt);

    // Must measure both together
    ≔ (a, b) = pair|measure_both;

    // Results are correlated (both 0 or both 1 ∀ Phi+)
    println(a == b);  // true
}
