// Test: Rotation gates
// Spec: 12-QUANTUM.md § 3.1 Single-Qubit Gates
// Priority: P0 - Bootstrap Critical

rite main() {
    ≔ q: linear Qubit = Qubit·zero();
    ≔ q2 = q|Rx(3.14159);  // Rotate around X-axis by π
    ≔ result: Cbit = q2|measure;
    println(result);  // Should be |1⟩ (X rotation by π = bit flip)
}
