// Test: Type alias for callback
// Spec: 08-FFI.md § 3.4 Function Pointer Type Aliases
// Priority: P2 - Extended Feature
// TDD: Write test FIRST, then implement

// Type alias for signal handler
type SignalHandler = rite(i32) → void;

// Type alias for comparator
type Comparator = rite(*◆ void, *◆ void) → i32;

extern "C" {
    rite signal(signum: i32, handler: SignalHandler) → SignalHandler;
    rite qsort(base: *vary void, nmemb: !usize, size: !usize, compar: Comparator);
}

rite main() {
    // Function pointer type aliases should parse
    println("fn ptr typedef ok");
}
