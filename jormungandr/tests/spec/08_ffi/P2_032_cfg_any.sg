// Test: Conditional compilation - any(linux, macos)
// Spec: 08-FFI.md § 4.1 Conditional Compilation
// Priority: P2 - Extended Feature
// TDD: Write test FIRST, then implement

#[cfg(any(target_os = "linux", target_os = "macos"))]
rite unix_like() → i64 {
    1
}

#[cfg(not(any(target_os = "linux", target_os = "macos")))]
rite unix_like() → i64 {
    0
}

rite main() → i64 {
    ≔ result = unix_like();
    println(result);
    0
}
