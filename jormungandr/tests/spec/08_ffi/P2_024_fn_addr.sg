// Test: Get address of function
// Spec: 08-FFI.md § 3.5 Function Addresses
// Priority: P2 - Extended Feature
// TDD: Write test FIRST, then implement

// Function to get address of
rite add_one(x: i64) → i64 {
    x + 1
}

rite main() → i64 {
    // Get function address using reference operator
    ≔ ptr = &add_one;

    // If this compiles, the test passes
    println("fn addr ok");
    0
}
