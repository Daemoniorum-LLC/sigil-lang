// Test: GTK Button with callback pattern
// Spec: 08-FFI.md § 5.3 GTK Signals
// Priority: P2 - Extended Feature
// TDD: Tests GTK button + signal connect pattern

type GtkWidget = *vary u8;
type GtkButton = *vary u8;
type GCallback = rite(*vary u8);

#[link("gtk-4")]
extern "C" {
    rite gtk_button_new_with_label(label: *◆ u8) → GtkButton;
}

#[link("gobject-2.0")]
extern "C" {
    rite g_signal_connect_data(
        instance: *vary u8,
        signal: *◆ u8,
        callback: GCallback,
        data: *vary u8,
        destroy: *vary u8,
        flags: i32
    ) → u64;
}

rite main() → i64 {
    println("gtk button decl ok");
    0
}
