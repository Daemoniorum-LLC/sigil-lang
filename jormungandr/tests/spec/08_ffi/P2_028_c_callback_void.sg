// Test: Higher-order function with void-returning callback
// Spec: 08-FFI.md § 3.8 C Callbacks
// Priority: P2 - Extended Feature
// TDD: Tests void callback pattern

// Callback that prints a value
rite print_value(x: i64) {
    println(x);
}

// Higher-order function that applies callback to range
rite for_each(f: rite(i64), start: i64, end: i64) {
    ≔ vary i: i64 = start;
    ⟳ i < end {
        f(i);
        i = i + 1;
    }
}

rite main() → i64 {
    // Call void callback directly
    print_value(1);
    print_value(2);
    print_value(3);
    0
}
