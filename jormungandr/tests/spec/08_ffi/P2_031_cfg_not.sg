// Test: Conditional compilation - not(windows)
// Spec: 08-FFI.md § 4.1 Conditional Compilation
// Priority: P2 - Extended Feature
// TDD: Write test FIRST, then implement

#[cfg(not(target_os = "windows"))]
rite not_windows() → i64 {
    1
}

#[cfg(target_os = "windows")]
rite not_windows() → i64 {
    0
}

rite main() → i64 {
    ≔ result = not_windows();
    println(result);
    0
}
