// Test: Conditional compilation - Linux only
// Spec: 08-FFI.md § 4.1 Conditional Compilation
// Priority: P2 - Extended Feature
// TDD: Write test FIRST, then implement

#[cfg(target_os = "linux")]
rite linux_only() → i64 {
    1
}

#[cfg(not(target_os = "linux"))]
rite linux_only() → i64 {
    0
}

rite main() → i64 {
    ≔ result = linux_only();
    println(result);
    0
}
