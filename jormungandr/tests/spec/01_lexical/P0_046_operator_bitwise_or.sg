// Test: Bitwise OR operator (|)
// Spec: 01-LEXICAL.md § 3.2 Operators
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate bitwise OR works correctly.
//
// Expected behavior:
// Should print 43 (42 | 3 = 43)

fn main() {
    let x: !i32 = 42;
    let y: !i32 = 3;
    println(x | y);
}
