// Test: Underscores in numeric literals
// Spec: 01-LEXICAL.md § 2.1 Numeric Separators
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate underscores in numbers for readability.
//
// Expected behavior:
// Should print 1000000 (1_000_000)

fn main() {
    let x: !i32 = 1_000_000;
    println(x);
}
