// Test: Multiplication operator (*)
// Spec: 01-LEXICAL.md § 3.2 Operators
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate multiplication works correctly.
//
// Expected behavior:
// Should print 84 (42 * 2)

fn main() {
    let x: !i32 = 42;
    let y: !i32 = 2;
    println(x * y);
}
