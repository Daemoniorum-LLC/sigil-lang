// Test: Keyword 'fn' for function definition
// Spec: 01-LEXICAL.md § 2.2 Keywords
// Priority: P0
//
// Purpose:
// Validates that the 'fn' keyword works for function definitions.
//
// Expected behavior:
// Should compile and print 42

fn get_value() -> !i32 {
    42
}

fn main() {
    println(get_value());
}
