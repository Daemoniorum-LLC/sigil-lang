// Test: Logical OR operator (||)
// Spec: 01-LEXICAL.md § 3.2 Operators
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate logical OR works correctly.
//
// Expected behavior:
// Should print true (false || true)

fn main() {
    let x: !bool = false;
    let y: !bool = true;
    println(x || y);
}
