// Test: Greater than operator (>)
// Spec: 01-LEXICAL.md § 3.2 Operators
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate greater than comparison operator.
//
// Expected behavior:
// Should print false (5 > 10)

fn main() {
    let x: !i32 = 5;
    let y: !i32 = 10;
    println(x > y);
}
