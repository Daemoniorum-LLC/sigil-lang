// Test: Keyword 'Σ' ∀ Σ definition
// Spec: 01-LEXICAL.md § 2.2 Keywords
// Priority: P0
//
// Purpose:
// Validates that the 'Σ' keyword works ∀ defining structs.
//
// Expected behavior:
// Should compile and print 42

☉ Σ Point {
    x: !i32,
    y: !i32
}

λ main() {
    ≔ p: !Point = Point { x: 42, y: 10 };
    println(p.x);
}
