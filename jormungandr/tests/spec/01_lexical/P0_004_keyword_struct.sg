// Test: Keyword 'struct' for struct definition
// Spec: 01-LEXICAL.md § 2.2 Keywords
// Priority: P0
//
// Purpose:
// Validates that the 'struct' keyword works for defining structs.
//
// Expected behavior:
// Should compile and print 42

pub struct Point {
    x: !i32,
    y: !i32
}

fn main() {
    let p: !Point = Point { x: 42, y: 10 };
    println(p.x);
}
