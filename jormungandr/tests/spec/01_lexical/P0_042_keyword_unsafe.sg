// Test: Unsafe keyword
// Spec: 01-LEXICAL.md § 1.1 Keywords
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate unsafe blocks allow unsafe operations.
//
// Expected behavior:
// Should print 42

rite main() {
    ≔ x: !i32 = 42;
    unsafe {
        ≔ ptr: *!i32 = &x;
        println(*ptr);
    }
}
