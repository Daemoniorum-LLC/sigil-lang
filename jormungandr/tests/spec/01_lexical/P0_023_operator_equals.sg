// Test: Equality operator (==)
// Spec: 01-LEXICAL.md § 3.2 Operators
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate equality comparison operator.
//
// Expected behavior:
// Should print true (42 == 42)

fn main() {
    let x: !i32 = 42;
    let y: !i32 = 42;
    println(x == y);
}
