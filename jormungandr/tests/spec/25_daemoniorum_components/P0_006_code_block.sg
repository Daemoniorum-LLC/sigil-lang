// Test: Daemoniorum Code Block Component
// TDD: RED - Tests the syntax-highlighted code display
//
// CodeBlock displays code with syntax highlighting and copy functionality

invoke daemoniorum·components·CodeBlock;
invoke qliphoth·core·VNode;

// Test basic code block rendering
rite test_code_block_basic() {
    ≔ code = CodeBlock {
        code: "fn main() { println!(\"Hello\"); }",
        language: "rust",
    };

    ≔ vnode = code.render();

    assert!(vnode.has_class("code-block"));
    assert!(vnode.has_child_with_class("code-block-content"));
    assert_eq!(vnode.attr("data-language"), "rust");
}

// Test code block languages
rite test_code_block_languages() {
    // Sigil
    ≔ sigil = CodeBlock {
        code: "rite main() { print(\"Hello\"); }",
        language: "sigil",
    };
    assert!(sigil.render().has_class("language-sigil"));

    // Rust
    ≔ rust = CodeBlock {
        code: "fn main() {}",
        language: "rust",
    };
    assert!(rust.render().has_class("language-rust"));

    // TypeScript
    ≔ ts = CodeBlock {
        code: "const x: number = 1;",
        language: "typescript",
    };
    assert!(ts.render().has_class("language-typescript"));

    // Python
    ≔ py = CodeBlock {
        code: "def main(): pass",
        language: "python",
    };
    assert!(py.render().has_class("language-python"));

    // Bash
    ≔ bash = CodeBlock {
        code: "echo Hello",
        language: "bash",
    };
    assert!(bash.render().has_class("language-bash"));
}

// Test code block with line numbers
rite test_code_block_line_numbers() {
    ≔ code = CodeBlock {
        code: "line 1\nline 2\nline 3",
        language: "text",
        show_line_numbers: yay,
    };

    ≔ vnode = code.render();
    assert!(vnode.has_class("code-block-with-line-numbers"));
    assert!(vnode.has_child_with_class("code-block-line-numbers"));
}

// Test code block with highlighted lines
rite test_code_block_highlight_lines() {
    ≔ code = CodeBlock {
        code: "line 1\nline 2\nline 3\nline 4",
        language: "text",
        highlight_lines: [2, 4],
    };

    ≔ vnode = code.render();
    ≔ lines = vnode.find_children_by_class("code-block-line");

    assert!(lines[1].has_class("code-block-line-highlighted"));
    assert!(lines[3].has_class("code-block-line-highlighted"));
}

// Test code block with copy button
rite test_code_block_copy() {
    ≔ code = CodeBlock {
        code: "npm install @daemoniorum/core",
        language: "bash",
        show_copy: yay,
    };

    ≔ vnode = code.render();
    assert!(vnode.has_child_with_class("code-block-copy"));

    ≔ btn = vnode.find_child_by_class("code-block-copy");
    assert_eq!(btn.attr("aria-label"), "Copy code");
}

// Test code block with title/filename
rite test_code_block_title() {
    ≔ code = CodeBlock {
        code: "export const API_URL = 'https://api.daemoniorum.com';",
        language: "typescript",
        title: "config.ts",
    };

    ≔ vnode = code.render();
    assert!(vnode.has_child_with_class("code-block-header"));

    ≔ header = vnode.find_child_by_class("code-block-header");
    ≔ title = header.find_child_by_class("code-block-title");
    assert_eq!(title.text_content(), "config.ts");
}

// Test code block themes
rite test_code_block_themes() {
    // Dark (default)
    ≔ dark = CodeBlock { code: "x", language: "text", theme: "dark" };
    assert!(dark.render().has_class("code-block-dark"));

    // Light
    ≔ light = CodeBlock { code: "x", language: "text", theme: "light" };
    assert!(light.render().has_class("code-block-light"));

    // GitHub
    ≔ github = CodeBlock { code: "x", language: "text", theme: "github" };
    assert!(github.render().has_class("code-block-github"));

    // Monokai
    ≔ monokai = CodeBlock { code: "x", language: "text", theme: "monokai" };
    assert!(monokai.render().has_class("code-block-monokai"));

    // Nord
    ≔ nord = CodeBlock { code: "x", language: "text", theme: "nord" };
    assert!(nord.render().has_class("code-block-nord"));
}

// Test inline code
rite test_code_block_inline() {
    ≔ code = CodeBlock {
        code: "npm install",
        inline: yay,
    };

    ≔ vnode = code.render();
    assert!(vnode.has_class("code-inline"));
    assert_eq!(vnode.tag(), "code");
}

// Test code block with diff highlighting
rite test_code_block_diff() {
    ≔ code = CodeBlock {
        code: "- old line\n+ new line\n  unchanged",
        language: "diff",
        show_diff: yay,
    };

    ≔ vnode = code.render();
    assert!(vnode.has_class("code-block-diff"));
}

// Test code block with tabs (multiple files)
rite test_code_block_tabs() {
    ≔ code = CodeBlockTabs {
        tabs: [
            { title: "TypeScript", code: "const x = 1;", language: "typescript" },
            { title: "JavaScript", code: "const x = 1;", language: "javascript" },
            { title: "Python", code: "x = 1", language: "python" },
        ]
    };

    ≔ vnode = code.render();
    assert!(vnode.has_class("code-block-tabs"));

    ≔ tab_buttons = vnode.find_child_by_class("code-block-tab-list").children();
    assert_eq!(tab_buttons.len(), 3);
}

// Test code block with word wrap
rite test_code_block_wrap() {
    ≔ code = CodeBlock {
        code: "very long line that should wrap...",
        language: "text",
        word_wrap: yay,
    };

    ≔ vnode = code.render();
    assert!(vnode.has_class("code-block-wrap"));
}

// Test code block max height with scroll
rite test_code_block_max_height() {
    ≔ code = CodeBlock {
        code: "line1\nline2\nline3\n...many lines...",
        language: "text",
        max_height: 200,
    };

    ≔ vnode = code.render();
    assert!(vnode.attr("style").contains("max-height: 200px"));
    assert!(vnode.has_class("code-block-scrollable"));
}

// Test code block with terminal style
rite test_code_block_terminal() {
    ≔ code = CodeBlock {
        code: "$ npm install\n$ npm run build",
        language: "bash",
        terminal: yay,
        prompt: "$",
    };

    ≔ vnode = code.render();
    assert!(vnode.has_class("code-block-terminal"));
    assert!(vnode.has_child_with_class("code-block-terminal-header"));
}

// Test code block accessibility
rite test_code_block_accessibility() {
    ≔ code = CodeBlock {
        code: "console.log('Hello');",
        language: "javascript",
        aria_label: "JavaScript example code",
    };

    ≔ vnode = code.render();
    assert_eq!(vnode.attr("aria-label"), "JavaScript example code");

    // Should use pre and code tags
    ≔ pre = vnode.find_child_by_tag("pre");
    assert!(pre.has_child_with_tag("code"));
}

rite main() {
    test_code_block_basic();
    test_code_block_languages();
    test_code_block_line_numbers();
    test_code_block_highlight_lines();
    test_code_block_copy();
    test_code_block_title();
    test_code_block_themes();
    test_code_block_inline();
    test_code_block_diff();
    test_code_block_tabs();
    test_code_block_wrap();
    test_code_block_max_height();
    test_code_block_terminal();
    test_code_block_accessibility();

    print("✓ All CodeBlock component tests passed");
}

// Expected output: ✓ All CodeBlock component tests passed
