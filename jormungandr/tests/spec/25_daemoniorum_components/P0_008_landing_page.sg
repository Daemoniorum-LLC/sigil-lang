// Test: Daemoniorum Landing Page Component
// TDD: RED - Tests the complete landing page layout
//
// LandingPage is the main page template for daemoniorum.com

invoke daemoniorum·components·LandingPage;
invoke daemoniorum·components·PlatformCard;
invoke daemoniorum·components·Hero;
invoke daemoniorum·i18n·Landing;
invoke qliphoth·core·VNode;

// Test basic landing page structure
rite test_landing_page_basic() {
    ≔ page = LandingPage {
        locale: "en",
    };

    ≔ vnode = page.render();

    // Should have main semantic structure
    assert!(vnode.has_child_with_class("landing-header"));
    assert!(vnode.has_child_with_class("landing-main"));
    assert!(vnode.has_child_with_class("landing-footer"));
}

// Test landing page hero section
rite test_landing_page_hero() {
    ≔ page = LandingPage {
        locale: "en",
        hero: {
            title: "Building the Future of AI",
            subtitle: "Research-driven AI platforms",
            cta_primary: { label: "Explore Research", href: "/research" },
            cta_secondary: { label: "View Platforms", href: "/platforms" },
        },
    };

    ≔ vnode = page.render();
    assert!(vnode.has_child_with_class("landing-hero"));

    ≔ hero = vnode.find_child_by_class("landing-hero");
    ≔ title = hero.find_child_by_class("hero-title");
    assert_eq!(title.text_content(), "Building the Future of AI");
}

// Test landing page i18n integration
rite test_landing_page_i18n() {
    // English
    ≔ en_page = LandingPage { locale: "en" };
    ≔ en_vnode = en_page.render();
    ≔ en_title = en_vnode.find_child_by_class("hero-title");
    assert_eq!(en_title.text_content(), "Building the Future of AI");

    // Spanish
    ≔ es_page = LandingPage { locale: "es" };
    ≔ es_vnode = es_page.render();
    ≔ es_title = es_vnode.find_child_by_class("hero-title");
    assert_eq!(es_title.text_content(), "Construyendo el Futuro de la IA");
}

// Test landing page platforms section
rite test_landing_page_platforms() {
    ≔ page = LandingPage {
        locale: "en",
        platforms: [
            PlatformCard {
                name: "Styx",
                tagline: "AI-Native Git",
                status: "beta",
            },
            PlatformCard {
                name: "Infernum",
                tagline: "Local LLM Engine",
                status: "production",
            },
            PlatformCard {
                name: "Persona",
                tagline: "AI Agents",
                status: "production",
            },
        ],
    };

    ≔ vnode = page.render();
    assert!(vnode.has_child_with_class("landing-platforms"));

    ≔ platforms_section = vnode.find_child_by_class("landing-platforms");
    ≔ cards = platforms_section.find_children_by_class("platform-card");
    assert_eq!(cards.len(), 3);
}

// Test landing page research section
rite test_landing_page_research() {
    ≔ page = LandingPage {
        locale: "en",
        research_papers: [
            {
                title: "Sigil Language Specification",
                abstract: "A memory-safe systems language...",
                date: "2026-01-15",
            },
        ],
    };

    ≔ vnode = page.render();
    assert!(vnode.has_child_with_class("landing-research"));
}

// Test landing page navigation
rite test_landing_page_nav() {
    ≔ page = LandingPage {
        locale: "en",
        nav_items: [
            { label: "Home", href: "/" },
            { label: "Platforms", href: "/platforms" },
            { label: "Research", href: "/research" },
            { label: "Blog", href: "/blog" },
            { label: "Contact", href: "/contact" },
        ],
    };

    ≔ vnode = page.render();
    ≔ header = vnode.find_child_by_class("landing-header");
    ≔ nav = header.find_child_by_class("nav");

    ≔ items = nav.find_children_by_class("nav-item");
    assert_eq!(items.len(), 5);
}

// Test landing page footer
rite test_landing_page_footer() {
    ≔ page = LandingPage {
        locale: "en",
        footer: {
            copyright: "© 2026 Daemoniorum LLC",
            social: [
                { platform: "github", url: "https://github.com/daemoniorum" },
                { platform: "twitter", url: "https://twitter.com/daemoniorum" },
            ],
            links: [
                { label: "Privacy", href: "/privacy" },
                { label: "Terms", href: "/terms" },
            ],
        },
    };

    ≔ vnode = page.render();
    ≔ footer = vnode.find_child_by_class("landing-footer");

    assert!(footer.has_child_with_class("footer-copyright"));
    assert!(footer.has_child_with_class("footer-social"));
}

// Test landing page dark mode
rite test_landing_page_theme() {
    // Light
    ≔ light = LandingPage { locale: "en", theme: "light" };
    assert!(light.render().has_class("landing-light"));

    // Dark
    ≔ dark = LandingPage { locale: "en", theme: "dark" };
    assert!(dark.render().has_class("landing-dark"));

    // Auto (system preference)
    ≔ auto = LandingPage { locale: "en", theme: "auto" };
    assert!(auto.render().has_class("landing-theme-auto"));
}

// Test landing page SEO meta
rite test_landing_page_seo() {
    ≔ page = LandingPage {
        locale: "en",
        seo: {
            title: "Daemoniorum - AI Research Platform",
            description: "Research-driven AI platforms for the future",
            og_image: "/images/og-image.png",
            canonical: "https://daemoniorum.com",
        },
    };

    ≔ vnode = page.render();

    // SEO data should be available for head rendering
    assert_eq!(page.seo_title(), "Daemoniorum - AI Research Platform");
    assert_eq!(page.seo_description(), "Research-driven AI platforms for the future");
}

// Test landing page language selector
rite test_landing_page_language() {
    ≔ page = LandingPage {
        locale: "en",
        available_locales: ["en", "es", "fr", "de"],
        show_language_selector: yay,
    };

    ≔ vnode = page.render();
    assert!(vnode.has_child_with_class("landing-language-selector"));
}

// Test landing page CTA section
rite test_landing_page_cta_section() {
    ≔ page = LandingPage {
        locale: "en",
        cta_section: {
            title: "Ready to get started?",
            subtitle: "Join thousands of developers building with Daemoniorum",
            button: { label: "Start Free", href: "/signup" },
        },
    };

    ≔ vnode = page.render();
    assert!(vnode.has_child_with_class("landing-cta-section"));
}

// Test landing page accessibility
rite test_landing_page_accessibility() {
    ≔ page = LandingPage {
        locale: "en",
    };

    ≔ vnode = page.render();

    // Should have skip link
    assert!(vnode.has_child_with_class("skip-to-main"));

    // Main content should have id for skip link target
    ≔ main = vnode.find_child_by_class("landing-main");
    assert_eq!(main.attr("id"), "main-content");

    // Language attribute
    assert_eq!(vnode.attr("lang"), "en");
}

// Test landing page responsive mobile menu
rite test_landing_page_mobile_nav() {
    ≔ page = LandingPage {
        locale: "en",
        mobile_breakpoint: 768,
    };

    ≔ vnode = page.render();
    ≔ header = vnode.find_child_by_class("landing-header");

    // Should have mobile menu toggle
    assert!(header.has_child_with_class("mobile-menu-toggle"));
}

rite main() {
    test_landing_page_basic();
    test_landing_page_hero();
    test_landing_page_i18n();
    test_landing_page_platforms();
    test_landing_page_research();
    test_landing_page_nav();
    test_landing_page_footer();
    test_landing_page_theme();
    test_landing_page_seo();
    test_landing_page_language();
    test_landing_page_cta_section();
    test_landing_page_accessibility();
    test_landing_page_mobile_nav();

    print("✓ All LandingPage component tests passed");
}

// Expected output: ✓ All LandingPage component tests passed
