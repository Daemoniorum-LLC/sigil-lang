// Test: Multiple ⊢ blocks
// Spec: 18-COMPILER.md § 4.1 Impl Blocks
// Priority: P2 - Enhancement

sigil Value {
    n: !i32,
}

⊢ Value {
    rite new(x: !i32) → Value {
        Value { n: x }
    }
}

⊢ Value {
    rite get(&this) → !i32 {
        this.n
    }
}

rite main() {
    ≔ v = Value·new(42);
    println(v.get());
}
