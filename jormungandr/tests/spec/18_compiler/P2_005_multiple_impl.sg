// Test: Multiple ⊢ blocks
// Spec: 18-COMPILER.md § 4.1 Impl Blocks
// Priority: P2 - Enhancement

Σ Value {
    n: !i32,
}

⊢ Value {
    λ new(x: !i32) -> Value {
        Value { n: x }
    }
}

⊢ Value {
    λ get(&self) -> !i32 {
        self.n
    }
}

λ main() {
    ≔ v = Value·new(42);
    println(v.get());
}
