// Test: Chained method calls
// Spec: 18-COMPILER.md § 4.4 Method Resolution
// Priority: P2 - Enhancement

Σ Builder {
    value: !i32,
}

⊢ Builder {
    λ new() -> Builder {
        Builder { value: 0 }
    }

    λ add(&Δ self, n: !i32) -> &Δ Builder {
        self.value = self.value + n;
        self
    }

    λ build(&self) -> !i32 {
        self.value
    }
}

λ main() {
    ≔ Δ b = Builder·new();
    b.add(10);
    b.add(20);
    println(b.build());
}
