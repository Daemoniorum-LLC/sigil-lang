// Test: Deeply nested struct
// Spec: 18-COMPILER.md § 4.2 Structs
// Priority: P2 - Enhancement

sigil Level3 {
    value: !i32,
}

sigil Level2 {
    l3: Level3,
}

sigil Level1 {
    l2: Level2,
}

rite main() {
    ≔ obj = Level1 {
        l2: Level2 {
            l3: Level3 {
                value: 42,
            },
        },
    };
    println(obj.l2.l3.value);
}
