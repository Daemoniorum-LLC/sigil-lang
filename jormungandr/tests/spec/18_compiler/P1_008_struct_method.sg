// Test: Struct with method compilation
// Spec: 18-COMPILER.md § 4.1 Struct Methods
// Priority: P1 - Production Ready

Σ Counter {
    value: !i32,
}

⊢ Counter {
    λ get(&self) -> !i32 {
        self.value
    }

    λ increment(&Δ self) {
        self.value = self.value + 1;
    }
}

λ main() {
    ≔ Δ c = Counter { value: 0 };
    println(c.get());

    c.increment();
    println(c.get());

    c.increment();
    c.increment();
    println(c.get());
}
