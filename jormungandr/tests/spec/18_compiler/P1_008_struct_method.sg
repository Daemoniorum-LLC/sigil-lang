// Test: Struct with method compilation
// Spec: 18-COMPILER.md § 4.1 Struct Methods
// Priority: P1 - Production Ready

struct Counter {
    value: !i32,
}

impl Counter {
    fn get(&self) -> !i32 {
        self.value
    }

    fn increment(&mut self) {
        self.value = self.value + 1;
    }
}

fn main() {
    let mut c = Counter { value: 0 };
    println(c.get());

    c.increment();
    println(c.get());

    c.increment();
    c.increment();
    println(c.get());
}
