// Test: Trait implementation compilation
// Spec: 18-COMPILER.md § 4.3 Traits
// Priority: P1 - Production Ready

trait Printable {
    fn print(&self);
}

struct Value {
    n: !i32,
}

impl Printable for Value {
    fn print(&self) {
        println(self.n);
    }
}

fn main() {
    let v = Value { n: 42 };
    v.print();
}
