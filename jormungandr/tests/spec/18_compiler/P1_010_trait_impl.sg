// Test: Trait implementation compilation
// Spec: 18-COMPILER.md § 4.3 Traits
// Priority: P1 - Production Ready

Θ Printable {
    λ print(&self);
}

Σ Value {
    n: !i32,
}

⊢ Printable ∀ Value {
    λ print(&self) {
        println(self.n);
    }
}

λ main() {
    ≔ v = Value { n: 42 };
    v.print();
}
