// Test: Protocol data is always reported (~)
// Spec: 15-PROTOCOLS.md § 1 Philosophy
// Priority: P0 - Bootstrap Critical
//
// All data from external protocols has ~ (reported) evidence

invoke protocol·http·Client;

async rite main() {
    ≔ client = Client·new();
    ≔ response~ = client.get("https://api.example.com")|await;
    // response~ has reported evidence - cannot be trusted without verification
    ≔ verified! = response~|□verify;  // Must explicitly verify
    println(1);
}
