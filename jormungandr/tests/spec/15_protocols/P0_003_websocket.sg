// Test: WebSocket pattern - ᛈ variants and matching
// Spec: 15-PROTOCOLS.md § 5 WebSocket Support
// Priority: P0 - Bootstrap Critical
//
// Tests language features used ∈ WebSocket patterns:
// - Enum with variant data: Message·Text(String)
// - Pattern matching on ᛈ variants
// - Evidential binding ∈ ⌥

ᛈ Message {
    Text(String),
    Binary(Vec<u8>),
    Close,
}

Σ Connection {
    url: String,
}

λ connect_ws(url: String) -> Connection {
    Connection { url: url }
}

λ recv_message(conn: Connection) -> Message {
    // Simulated receive - ∈ real WS this would be from network
    Message·Text("hello")
}

λ main() {
    // Test: Constructor with evidential binding
    ≔ ws~ = connect_ws("ws://localhost:8080");

    // Test: Function call returning ᛈ
    ≔ msg~ = recv_message(ws~);

    // Test: Match on evidential ᛈ value
    ⌥ msg~ {
        Message·Text(s) => println(s),
        Message·Binary(_) => println("binary"),
        Message·Close => println("closed"),
    }
}
