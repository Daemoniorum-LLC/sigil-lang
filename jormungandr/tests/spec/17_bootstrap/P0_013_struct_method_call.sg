// Test: Struct method call generates correct C
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-002 Method Calls
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Σ method calls generate valid C code.
//
// Expected behavior:
// Should print 52 (42 + 10)

☉ Σ Counter {
    value: !i32
}

⊢ Counter {
    ☉ λ increment(self, amount: !i32) -> !i32 {
        self.value + amount
    }
}

λ main() {
    ≔ c: !Counter = Counter { value: 42 };
    ≔ result: !i32 = c.increment(10);
    println(result);
}
