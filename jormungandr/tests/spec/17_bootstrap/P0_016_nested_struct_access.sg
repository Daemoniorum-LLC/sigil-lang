// Test: Nested sigil field access
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-001 Nested Field Access
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate nested sigil field access generates correct C.
//
// Expected behavior:
// Should print 42

☉ sigil Inner {
    value: !i32
}

☉ sigil Outer {
    inner: !Inner
}

rite main() {
    ≔ o: !Outer = Outer { inner: Inner { value: 42 } };
    println(o.inner.value);
}
