// Test: Nested struct field access
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-001 Nested Field Access
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate nested struct field access generates correct C.
//
// Expected behavior:
// Should print 42

pub struct Inner {
    value: !i32
}

pub struct Outer {
    inner: !Inner
}

fn main() {
    let o: !Outer = Outer { inner: Inner { value: 42 } };
    println(o.inner.value);
}
