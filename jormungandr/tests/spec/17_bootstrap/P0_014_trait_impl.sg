// Test: Trait implementation generates correct C
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-003 Trait Implementations
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate aspect implementations generate valid C code.
//
// Expected behavior:
// Should print 42

☉ aspect Display {
    rite display(this) → !i32;
}

☉ sigil Value {
    x: !i32
}

⊢ Value : Display {
    rite display(this) → !i32 {
        this.x
    }
}

rite main() {
    ≔ v: !Value = Value { x: 42 };
    println(v.display());
}
