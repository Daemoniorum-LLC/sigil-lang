// Test: Trait implementation generates correct C
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-003 Trait Implementations
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate trait implementations generate valid C code.
//
// Expected behavior:
// Should print 42

pub trait Display {
    fn display(self) -> !i32;
}

pub struct Value {
    x: !i32
}

impl Display for Value {
    fn display(self) -> !i32 {
        self.x
    }
}

fn main() {
    let v: !Value = Value { x: 42 };
    println(v.display());
}
