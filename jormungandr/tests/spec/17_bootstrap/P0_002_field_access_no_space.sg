// Test: Field access generates correct C (no space)
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-001 Field Access
// Priority: P0
//
// Purpose:
// Validates that field access generates "obj.field" not "obj. field"
// Bug CG-001: Field access sometimes emits space before field name
//
// Expected behavior:
// Should compile and print 42

pub struct Point {
    x: !i32,
    y: !i32
}

fn main() {
    let p: !Point = Point { x: 42, y: 10 };
    println(p.x);
}
