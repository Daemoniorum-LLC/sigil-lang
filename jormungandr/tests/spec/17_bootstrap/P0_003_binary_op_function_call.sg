// Test: Binary operations generate function calls
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-002 Binary Operations
// Priority: P0
//
// Purpose:
// Validates that binary operations like + generate sigil_add() calls
// rather than direct C operators.
//
// Expected behavior:
// Should compile and print 84 (42 + 42)

fn main() {
    let x: !i32 = 42;
    let y: !i32 = 42;
    let z: !i32 = x + y;
    println(z);
}
