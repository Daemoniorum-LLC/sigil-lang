// Test: Nested sigil field access
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-001 Field Access
// Priority: P0
//
// Purpose:
// Validates that nested sigil access generates correct C code.
//
// Expected behavior:
// Should compile and print 42

☉ sigil Inner {
    value: !i32
}

☉ sigil Outer {
    inner: !Inner
}

rite main() {
    ≔ o: !Outer = Outer { inner: Inner { value: 42 } };
    println(o.inner.value);
}
