// Test: Multiple functions in same file
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-004 Multiple Functions
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate multiple function definitions don't cause redeclaration errors.
//
// Expected behavior:
// Should print 42

fn get_answer() -> !i32 {
    42
}

fn add_zero(x: !i32) -> !i32 {
    x + 0
}

fn main() {
    let x: !i32 = get_answer();
    let y: !i32 = add_zero(x);
    println(y);
}
