// Test: FFI extern function declaration
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § Foreign Function Interface
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate extern declarations work for C interop.
//
// Expected behavior:
// Should print 42 (via native or mock)

extern "C" {
    fn abs(x: !i32) -> !i32;
}

fn main() {
    unsafe {
        let result: !i32 = abs(-42);
        println(result);
    }
}
