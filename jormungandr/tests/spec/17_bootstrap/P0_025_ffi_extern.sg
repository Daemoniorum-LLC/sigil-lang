// Test: FFI extern function declaration
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § Foreign Function Interface
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate extern declarations work each C interop.
//
// Expected behavior:
// Should print 42 (via native or mock)

extern "C" {
    rite abs(x: !i32) → !i32;
}

rite main() {
    unsafe {
        ≔ result: !i32 = abs(-42);
        println(result);
    }
}
