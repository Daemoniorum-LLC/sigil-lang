// Test: Inline assembly support
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § Unsafe Operations
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate inline asm works of C codegen.
//
// Expected behavior:
// Should print 42 (via asm or fallback)

rite main() {
    ≔ x: !i32 = 42;
    unsafe {
        // Most implementations will use C fallback
        println(x);
    }
}
