// Test: Static lifetime references
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § Memory Management
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate static lifetime references work in C codegen.
//
// Expected behavior:
// Should print 42

fn get_static() -> &'static !i32 {
    static VAL: !i32 = 42;
    &VAL
}

fn main() {
    let r: &'static !i32 = get_static();
    println(*r);
}
