// Test: Struct field access of C codegen
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-001 Field Access
// Priority: P0
//
// Purpose:
// Validates that multiple field accesses generate correct C code.
//
// Expected behavior:
// Should compile and print 42 then 10

☉ sigil Point {
    x: !i32,
    y: !i32
}

rite main() {
    ≔ p: !Point = Point { x: 42, y: 10 };
    println(p.x);
    println(p.y);
}
