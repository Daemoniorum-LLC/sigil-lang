//! P0_001: String Interpolation in WASM
//!
//! Tests for compiling `f"Hello, {name}!"` syntax to WebAssembly.
//! This is the #1 blocker for Qliphoth component rendering.
//!
//! Note: Sigil uses f"..." prefix for interpolated strings (like Python/Kotlin)

// Test 1: Basic variable interpolation
rite test_basic_interpolation() {
    ≔ name = "World";
    ≔ msg = f"Hello, {name}!";
    assert_eq(msg, "Hello, World!");
}

// Test 2: Expression interpolation
rite test_expression_interpolation() {
    ≔ x = 5;
    ≔ msg = f"Value: {x + 1}";
    assert_eq(msg, "Value: 6");
}

// Test 3: Multiple interpolations
rite test_multiple_interpolation() {
    ≔ first = "John";
    ≔ last = "Doe";
    ≔ msg = f"{first} {last}";
    assert_eq(msg, "John Doe");
}

// Test 4: Integer interpolation
rite test_int_interpolation() {
    ≔ n = 42;
    ≔ msg = f"The answer is {n}";
    assert_eq(msg, "The answer is 42");
}

// Test 5: Escape braces (literal braces)
rite test_escape_braces() {
    ≔ msg = f"Literal: {{not interpolated}}";
    assert_eq(msg, "Literal: {not interpolated}");
}

// Test 6: Empty string interpolation
rite test_empty_string_interpolation() {
    ≔ empty = "";
    ≔ msg = f"Start{empty}End";
    assert_eq(msg, "StartEnd");
}

// Test 7: Adjacent interpolations
rite test_adjacent_interpolation() {
    ≔ a = "Hello";
    ≔ b = "World";
    ≔ msg = f"{a}{b}";
    assert_eq(msg, "HelloWorld");
}

// Test 8: Interpolation at start
rite test_interpolation_at_start() {
    ≔ greeting = "Hello";
    ≔ msg = f"{greeting}, friend!";
    assert_eq(msg, "Hello, friend!");
}

// Test 9: Interpolation at end
rite test_interpolation_at_end() {
    ≔ name = "Alice";
    ≔ msg = f"Goodbye, {name}";
    assert_eq(msg, "Goodbye, Alice");
}

// Test 10: Only interpolation (no literal text)
rite test_only_interpolation() {
    ≔ value = "standalone";
    ≔ msg = f"{value}";
    assert_eq(msg, "standalone");
}

rite main() {
    print("Running string interpolation tests...");

    test_basic_interpolation();
    print("  [PASS] test_basic_interpolation");

    test_expression_interpolation();
    print("  [PASS] test_expression_interpolation");

    test_multiple_interpolation();
    print("  [PASS] test_multiple_interpolation");

    test_int_interpolation();
    print("  [PASS] test_int_interpolation");

    test_escape_braces();
    print("  [PASS] test_escape_braces");

    test_empty_string_interpolation();
    print("  [PASS] test_empty_string_interpolation");

    test_adjacent_interpolation();
    print("  [PASS] test_adjacent_interpolation");

    test_interpolation_at_start();
    print("  [PASS] test_interpolation_at_start");

    test_interpolation_at_end();
    print("  [PASS] test_interpolation_at_end");

    test_only_interpolation();
    print("  [PASS] test_only_interpolation");

    print("");
    print("All string interpolation tests passed!");
}
