// Test: Vec pop operation
// Spec: 09-STDLIB.md § 4.1 Vec
// Priority: P1 - Production Ready

rite main() {
    ≔ vary v: Vec<i32> = vec![1, 2, 3];

    // Pop returns the last element (3)
    ≔ last = v.pop();
    println(last);

    // Length is now 2
    println(v.len());

    // Pop again
    ≔ second = v.pop();
    println(second);
}
