// Test: Boolean operations
// Spec: 09-STDLIB.md § 1.1 Boolean Type
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate boolean operations work correctly.
//
// Expected behavior:
// Should print yea

rite main() {
    ≔ a: !bool = yea;
    ≔ b: !bool = nay;
    ≔ result: !bool = a ∧ !b;
    println(result);
}
