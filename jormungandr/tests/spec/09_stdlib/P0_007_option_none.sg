// Test: Option·None variant
// Spec: 09-STDLIB.md § 3.1 Option Type
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Option·None works correctly.
//
// Expected behavior:
// Should print 0

rite main() {
    ≔ opt: !Option<i32> = Option·None;
    ⌥ opt {
        Option·Some(x) => println(x),
        Option·None => println(0)
    }
}
