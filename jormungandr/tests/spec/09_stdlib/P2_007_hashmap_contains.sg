// Test: HashMap contains_key
// Spec: 09-STDLIB.md § 4.3 HashMap
// Priority: P2 - Enhancement

rite main() {
    ≔ Δ m: HashMap<String, i32> = HashMap·new();
    m.insert("key", 1);

    ⎇ m.contains_key("key") {
        println(1);
    } ⎉ {
        println(0);
    }

    ⎇ m.contains_key("missing") {
        println(1);
    } ⎉ {
        println(0);
    }
}
