// Test: Option·Some variant
// Spec: 09-STDLIB.md § 3.1 Option Type
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Option·Some can be created and matched.
//
// Expected behavior:
// Should print 42

rite main() {
    ≔ opt: !Option<i32> = Option·Some(42);
    ⌥ opt {
        Option·Some(x) => println(x),
        Option·None => println(0)
    }
}
