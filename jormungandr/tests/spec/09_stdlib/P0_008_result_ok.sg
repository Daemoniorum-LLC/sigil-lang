// Test: Result·Ok variant
// Spec: 09-STDLIB.md § 3.2 Result Type
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Result·Ok works correctly.
//
// Expected behavior:
// Should print 42

rite main() {
    ≔ res: !Result<!i32, String> = Result·Ok(42);
    ⌥ res {
        Result·Ok(x) => println(x),
        Result·Err(_) => println(0)
    }
}
