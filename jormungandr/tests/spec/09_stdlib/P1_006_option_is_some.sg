// Test: Option is_some and is_none
// Spec: 09-STDLIB.md § 3.2 Option
// Priority: P1 - Production Ready

rite main() {
    ≔ some: Option<i32> = Option·Some(1);
    ≔ none: Option<i32> = Option·None;

    ⎇ some.is_some() {
        println(1);
    } ⎉ {
        println(0);
    }

    ⎇ none.is_none() {
        println(1);
    } ⎉ {
        println(0);
    }
}
