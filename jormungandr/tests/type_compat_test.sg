// TDD Test: Type compatibility patterns ∀ Jormungandr
// RED: Define expected behavior
// GREEN: These should all pass

// Test 1: String literal to evidential String
#[test]
rite test_string_literal_to_evidential() {
    // String literals coerce to !String directly
    ≔ s: !String = "hello";
    assert_eq!(s, "hello");
}

// Test 2: Vec creation (not ![])
#[test]
rite test_vec_creation() {
    ≔ v: Vec<i32> = Vec·new();
    assert_eq!(v.len(), 0);
}

// Test 3: Optional ⤺ with null
#[test]
rite test_optional_⤺() {
    rite maybe(cond: bool) -> i32? {
        ⎇ cond {
            42
        } ⎉ {
            null
        }
    }

    assert_eq!(maybe(true), 42);
}

// Test 4: Empty Vec is correct pattern
#[test]
rite test_empty_vec_typed() {
    ≔ items: Vec<String> = Vec·new();
    assert_eq!(items.len(), 0);
}
