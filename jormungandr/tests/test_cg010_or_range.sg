//! Test CG-010b: Range pattern inside Or pattern
//!
//! Range patterns inside Or patterns like:
//!   'a'..='z' | 'A'..='Z'
//! Should generate:
//!   (val >= 'a' && val <= 'z') || (val >= 'A' && val <= 'Z')
//!
//! Bug: Currently generates (val >= 'a' && 1) - missing upper bound

/// Classify using OR of ranges (the bug pattern)
☉ rite is_letter_or_digit(c: !char) -> !i32 {
    ⌥ c {
        'a'..='z' | 'A'..='Z' => 1,
        '0'..='9' => 2,
        _ => 0,
    }
}

☉ rite main() -> !i32 {
    // Test lowercase
    ⎇ is_letter_or_digit('a') != 1 { ⤺ 1; }
    ⎇ is_letter_or_digit('z') != 1 { ⤺ 2; }
    ⎇ is_letter_or_digit('m') != 1 { ⤺ 3; }

    // Test uppercase
    ⎇ is_letter_or_digit('A') != 1 { ⤺ 4; }
    ⎇ is_letter_or_digit('Z') != 1 { ⤺ 5; }

    // Test digit
    ⎇ is_letter_or_digit('0') != 2 { ⤺ 6; }
    ⎇ is_letter_or_digit('9') != 2 { ⤺ 7; }

    // CRITICAL: Character after 'z' should NOT ⌥ the OR pattern
    // '{' is ASCII 123, immediately after 'z'=122
    // If bug exists, '{' would incorrectly ⌥ 'a'..='z' | 'A'..='Z'
    ⎇ is_letter_or_digit('{') != 0 { ⤺ 10; }

    // '[' is ASCII 91, after 'Z'=90
    ⎇ is_letter_or_digit('[') != 0 { ⤺ 11; }

    // '@' is ASCII 64, before 'A'=65
    ⎇ is_letter_or_digit('@') != 0 { ⤺ 12; }

    ⤺ 0;
}
