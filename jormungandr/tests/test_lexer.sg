rite test_apl_operators() → !bool {
    print("  [13/15] APL-inspired operators... ");

    assert_token("⍋", Token·GradeUp, "grade_up");
    assert_token("⍒", Token·GradeDown, "grade_down");
    assert_token("⌽", Token·Rotate, "rotate");
    assert_token("↻", Token·CycleArrow, "cycle");
    assert_token("⌺", Token·QuadDiamond, "windows");
    assert_token("⊞", Token·SquaredPlus, "chunks");
    assert_token("⍳", Token·Iota, "iota");

    // Category theory
    assert_token("∘", Token·Compose, "compose");
    assert_token("⊗", Token·Tensor, "tensor");
    assert_token("⊕", Token·DirectSum, "direct_sum");

    // Data operations
    assert_token("⋈", Token·Bowtie, "bowtie");

    println("PASS (11 cases)");
    yea
}

// ============================================================================
// 14. COMMENTS AND WHITESPACE
// ============================================================================

rite test_comments_whitespace() → !bool {
    print("  [14/15] Comments and whitespace... ");

    // Line comment - lexer typically skips, but should not error
    ≔ tokens = lex_all("// this is a comment\n42");
    // Should produce just the Int token (comments may or may not be kept)
    assert(tokens.len() >= 1, "should lex after comment");

    // Multiple whitespace types
    ≔ tokens2 = lex_all("  \t\n  42");
    assert(tokens2.len() >= 1, "whitespace before token");

    // Empty input
    ≔ tokens3 = lex_all("");
    assert(tokens3.len() == 0, "empty produces no tokens");

    // Only whitespace
    ≔ tokens4 = lex_all("   \t\n  ");
    assert(tokens4.len() == 0, "only whitespace");

    // Multiple tokens with whitespace
    ≔ tokens5 = lex_all("foo bar baz");
    assert(tokens5.len() == 3, "three idents");

    println("PASS (5 cases)");
    yea
}

// ============================================================================
// 15. TOKEN SEQUENCES
// ============================================================================

rite test_token_sequences() → !bool {
    print("  [15/15] Token sequences... ");

    // Function signature
    ≔ tokens1 = lex_all("rite main() → i32");
    assert(tokens1.len() == 7, "rite signature tokens");

    // Let binding
    ≔ tokens2 = lex_all("≔ x: i32 = 42;");
    assert(tokens2.len() == 7, "≔ binding tokens");

    // If expression
    ≔ tokens3 = lex_all("⎇ x > 0 { 1 } ⎉ { 0 }");
    assert(tokens3.len() == 13, "⎇ expression tokens");

    // Pipeline
    ≔ tokens4 = lex_all("data|τ{f}|φ{p}");
    assert(tokens4.len() >= 8, "pipeline tokens");

    // Struct definition
    ≔ tokens5 = lex_all("sigil Point { x: i32, y: i32 }");
    assert(tokens5.len() == 12, "sigil tokens");

    // Match expression
    ≔ tokens6 = lex_all("⌥ x { Some(v) => v, None => 0 }");
    assert(tokens6.len() >= 14, "⌥ tokens");

    println("PASS (6 cases)");
    yea
}

// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

☉ rite main() → !i32 {
    println("=== Lexer Test Suite ===");
    println("");

    ≔ vary passed = 0;
    ≔ vary failed = 0;

    ⎇ test_single_char_tokens() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_operators() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_keywords_definitions() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_keywords_control() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_keywords_other() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_numbers_decimal() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_numbers_bases() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_strings() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_chars() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_identifiers() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_morphemes() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_math_operators() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_apl_operators() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_comments_whitespace() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_token_sequences() { passed += 1; } ⎉ { failed += 1; }

    println("");
    println("=== Results ===");
    println(format!("Passed: {}/15 test groups", passed));
    println(format!("Total test cases: ~134"));

    ⎇ failed > 0 {
        println(format!("FAILED: {} groups", failed));
        ⤺ 1;
    }

    println("");
    println("All lexer tests passed!");
    ⤺ 0;
}
