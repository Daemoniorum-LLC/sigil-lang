    assert_token("τ", Token·Tau, "tau lowercase");
    assert_token("Τ", Token·Tau, "tau uppercase");
    assert_token("φ", Token·Phi, "phi lowercase");
    assert_token("Φ", Token·Phi, "phi uppercase");
    assert_token("σ", Token·Sigma, "sigma lowercase");
    assert_token("Σ", Token·Sigma, "sigma uppercase");
    assert_token("ρ", Token·Rho, "rho");
    assert_token("λ", Token·Lambda, "lambda");
    assert_token("Π", Token·Pi, "pi");
    assert_token("α", Token·Alpha, "alpha");
    assert_token("ω", Token·Omega, "omega lowercase");
    assert_token("Ω", Token·Omega, "omega uppercase");
    assert_token("μ", Token·Mu, "mu");
    assert_token("χ", Token·Chi, "chi");
    assert_token("ν", Token·Nu, "nu");
    assert_token("ξ", Token·Xi, "xi");
    assert_token("δ", Token·Delta, "delta");
    assert_token("ε", Token·Epsilon, "epsilon");

    println("PASS (18 cases)");
    yea
}

// ============================================================================
// 12. MATHEMATICAL OPERATORS
// ============================================================================

rite test_math_operators() → !bool {
    print("  [12/15] Mathematical operators... ");

    // Quantifiers
    assert_token("∀", Token·ForAll, "forall");
    assert_token("∃", Token·Exists, "exists");
    assert_token("∈", Token·ElementOf, "element_of");
    assert_token("∉", Token·NotElementOf, "not_element_of");

    // Set operations
    assert_token("∪", Token·Union, "union");
    assert_token("∩", Token·Intersection, "intersection");
    assert_token("⊂", Token·Subset, "subset");
    assert_token("⊆", Token·SubsetEq, "subset_eq");
    assert_token("⊃", Token·Superset, "superset");
    assert_token("⊇", Token·SupersetEq, "superset_eq");

    // Logic
    assert_token("∧", Token·LogicAnd, "logic_and");
    assert_token("∨", Token·LogicOr, "logic_or");
    assert_token("¬", Token·LogicNot, "logic_not");
    assert_token("⊻", Token·LogicXor, "logic_xor");
    assert_token("⊤", Token·Top, "top");
    assert_token("⊥", Token·Bottom, "bottom");

    // Analysis
    assert_token("∫", Token·Integral, "integral");
    assert_token("∂", Token·Partial, "partial");
    assert_token("√", Token·Sqrt, "sqrt");
    assert_token("∇", Token·Nabla, "nabla");

    println("PASS (20 cases)");
    yea
}

