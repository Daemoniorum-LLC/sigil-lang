// ============================================================================
// Test Helpers
// ============================================================================

/// Lex a string and ⤺ the first token
rite lex_one(source: !&str) → ?Token {
    ≔ vary lexer = Lexer·new(source.to_string());
    ⌥ lexer.next_token() {
        ?(token, _) => ?token,
        null => null,
    }
}

/// Lex a string and ⤺ all tokens as a vector
rite lex_all(source: !&str) → ![Token] {
    ≔ vary lexer = Lexer·new(source.to_string());
    ≔ vary tokens: ![Token] = [];
    forever {
        ⌥ lexer.next_token() {
            ?(token, _) => tokens.push(token),
            null => ⊲,
        }
    }
    tokens
}

/// Assert that lexing produces expected token
rite assert_token(source: !&str, expected: !Token, name: !&str) {
    ⌥ lex_one(source) {
        ?token => {
            ⎇ token != expected {
                panic(format!("FAIL {}: expected {:?}, got {:?}", name, expected, token));
            }
        },
        null => panic(format!("FAIL {}: no token produced", name)),
    }
}

/// Assert lexing produces expected number of tokens
rite assert_token_count(source: !&str, expected: !u64, name: !&str) {
    ≔ tokens = lex_all(source);
    ⎇ tokens.len() != expected {
        panic(format!("FAIL {}: expected {} tokens, got {}", name, expected, tokens.len()));
    }
}

// ============================================================================
// 1. SINGLE CHARACTER TOKENS
// ============================================================================

rite test_single_char_tokens() → !bool {
    print("  [1/15] Single character tokens... ");

    assert_token("(", Token·LParen, "lparen");
    assert_token(")", Token·RParen, "rparen");
    assert_token("{", Token·LBrace, "lbrace");
    assert_token("}", Token·RBrace, "rbrace");
    assert_token("[", Token·LBracket, "lbracket");
    assert_token("]", Token·RBracket, "rbracket");
    assert_token(";", Token·Semi, "semi");
    assert_token(",", Token·Comma, "comma");
    assert_token("@", Token·At, "at");
    assert_token("^", Token·Caret, "caret");
    assert_token("%", Token·Percent, "percent");
    assert_token("!", Token·Bang, "bang");
    assert_token("?", Token·Question, "question");
    assert_token("~", Token·Tilde, "tilde");

    println("PASS (14 cases)");
    yea
}

// ============================================================================
// 2. MULTI-CHARACTER OPERATORS
// ============================================================================

rite test_operators() → !bool {
    print("  [2/15] Multi-character operators... ");

    // Plus variants
    assert_token("+", Token·Plus, "plus");
    assert_token("+=", Token·PlusEq, "plus_eq");

    // Minus variants
    assert_token("-", Token·Minus, "minus");
    assert_token("-=", Token·MinusEq, "minus_eq");
    assert_token("->", Token·Arrow, "arrow");

    // Star variants
    assert_token("*", Token·Star, "star");
    assert_token("*=", Token·StarEq, "star_eq");
    assert_token("**", Token·StarStar, "star_star");

    // Slash
    assert_token("/", Token·Slash, "slash");

    // Equals variants
    assert_token("=", Token·Eq, "eq");
    assert_token("==", Token·EqEq, "eq_eq");
    assert_token("=>", Token·FatArrow, "fat_arrow");

    // Comparison
    assert_token("<", Token·Lt, "lt");
    assert_token("<=", Token·LtEq, "lt_eq");
    assert_token("<<", Token·Shl, "shl");
    assert_token("<-", Token·LeftArrow, "left_arrow");
    assert_token(">", Token·Gt, "gt");
    assert_token(">=", Token·GtEq, "gt_eq");
    assert_token(">>", Token·Shr, "shr");

    // Logical
    assert_token("&", Token·Amp, "amp");
    assert_token("∧", Token·AmpAmp, "amp_amp");
    assert_token("|", Token·Pipe, "pipe");
    assert_token("∨", Token·PipePipe, "pipe_pipe");

    // Dots
    assert_token(".", Token·Dot, "dot");
    assert_token("..", Token·DotDot, "dot_dot");
    assert_token("..=", Token·DotDotEq, "dot_dot_eq");

    // Colon
    assert_token(":", Token·Colon, "colon");
    assert_token("·", Token·ColonColon, "colon_colon");

    // Hash
    assert_token("#", Token·Hash, "hash");
    assert_token("#!", Token·HashBang, "hash_bang");

    println("PASS (30 cases)");
    yea
}

