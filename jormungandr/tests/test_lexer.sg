// ============================================================================
// 6. NUMERIC LITERALS - DECIMAL
// ============================================================================

rite test_numbers_decimal() → !bool {
    print("  [6/15] Decimal numbers... ");

    // Basic integers
    ⌥ lex_one("0") {
        ?Token·Int(v, _) => assert(v == 0, "0 should be 0"),
        _ => panic("0 should lex as Int"),
    }

    ⌥ lex_one("42") {
        ?Token·Int(v, _) => assert(v == 42, "42 should be 42"),
        _ => panic("42 should lex as Int"),
    }

    ⌥ lex_one("1234567890") {
        ?Token·Int(v, _) => assert(v == 1234567890, "large int"),
        _ => panic("large int should lex"),
    }

    // Underscores
    ⌥ lex_one("1_000_000") {
        ?Token·Int(v, _) => assert(v == 1000000, "underscore int"),
        _ => panic("underscore int should lex"),
    }

    // Floats
    ⌥ lex_one("3.14") {
        ?Token·Float(v) => assert(v > 3.13 ∧ v < 3.15, "3.14 float"),
        _ => panic("3.14 should lex as Float"),
    }

    ⌥ lex_one("0.5") {
        ?Token·Float(v) => assert(v > 0.4 ∧ v < 0.6, "0.5 float"),
        _ => panic("0.5 should lex as Float"),
    }

    // Scientific notation
    ⌥ lex_one("1e10") {
        ?Token·Float(v) => assert(v > 9e9, "1e10"),
        _ => panic("1e10 should lex as Float"),
    }

    ⌥ lex_one("2.5E-3") {
        ?Token·Float(v) => assert(v < 0.003, "2.5E-3"),
        _ => panic("2.5E-3 should lex as Float"),
    }

    println("PASS (8 cases)");
    yea
}

// ============================================================================
// 7. NUMERIC LITERALS - OTHER BASES
// ============================================================================

rite test_numbers_bases() → !bool {
    print("  [7/15] Non-decimal bases... ");

    // Binary
    ⌥ lex_one("0b1010") {
        ?Token·Int(v, _) => assert(v == 10, "binary 1010 = 10"),
        _ => panic("binary should lex"),
    }

    ⌥ lex_one("0b1111_0000") {
        ?Token·Int(v, _) => assert(v == 240, "binary with underscore"),
        _ => panic("binary underscore should lex"),
    }

    // Octal
    ⌥ lex_one("0o755") {
        ?Token·Int(v, _) => assert(v == 493, "octal 755 = 493"),
        _ => panic("octal should lex"),
    }

    // Hexadecimal
    ⌥ lex_one("0xFF") {
        ?Token·Int(v, _) => assert(v == 255, "hex FF = 255"),
        _ => panic("hex should lex"),
    }

    ⌥ lex_one("0xDEAD_BEEF") {
        ?Token·Int(v, _) => assert(v == 3735928559, "hex DEADBEEF"),
        _ => panic("hex deadbeef should lex"),
    }

    // Lowercase hex
    ⌥ lex_one("0xabcdef") {
        ?Token·Int(v, _) => assert(v == 11259375, "hex abcdef"),
        _ => panic("hex lowercase should lex"),
    }

    println("PASS (6 cases)");
    yea
}

// ============================================================================
// 8. STRING LITERALS
// ============================================================================

rite test_strings() → !bool {
    print("  [8/15] String literals... ");

    // Basic string
    ⌥ lex_one("\"hello\"") {
        ?Token·String(s) => assert(s == "hello", "basic string"),
        _ => panic("basic string should lex"),
    }

    // Empty string
    ⌥ lex_one("\"\"") {
        ?Token·String(s) => assert(s == "", "empty string"),
        _ => panic("empty string should lex"),
    }

    // String with spaces
    ⌥ lex_one("\"hello world\"") {
        ?Token·String(s) => assert(s == "hello world", "string with space"),
        _ => panic("string with space should lex"),
    }

    // Escape sequences
    ⌥ lex_one("\"line1\\nline2\"") {
        ?Token·String(s) => assert(s.contains("\n"), "newline escape"),
        _ => panic("newline escape should lex"),
    }

    ⌥ lex_one("\"tab\\there\"") {
        ?Token·String(s) => assert(s.contains("\t"), "tab escape"),
        _ => panic("tab escape should lex"),
    }

    ⌥ lex_one("\"quote\\\"here\"") {
        ?Token·String(s) => assert(s.contains("\""), "quote escape"),
        _ => panic("quote escape should lex"),
    }

    ⌥ lex_one("\"back\\\\slash\"") {
        ?Token·String(s) => assert(s.contains("\\"), "backslash escape"),
        _ => panic("backslash escape should lex"),
    }

    println("PASS (7 cases)");
    yea
}

// ============================================================================
// 9. CHARACTER LITERALS
// ============================================================================

rite test_chars() → !bool {
    print("  [9/15] Character literals... ");

    // Basic char
    ⌥ lex_one("'a'") {
        ?Token·Char(c) => assert(c == 'a', "basic char"),
        _ => panic("basic char should lex"),
    }

    // Digit char
    ⌥ lex_one("'5'") {
        ?Token·Char(c) => assert(c == '5', "digit char"),
        _ => panic("digit char should lex"),
    }

    // Escape chars
    ⌥ lex_one("'\\n'") {
        ?Token·Char(c) => assert(c == '\n', "newline char"),
        _ => panic("newline char should lex"),
    }

    ⌥ lex_one("'\\t'") {
        ?Token·Char(c) => assert(c == '\t', "tab char"),
        _ => panic("tab char should lex"),
    }

    ⌥ lex_one("'\\''") {
        ?Token·Char(c) => assert(c == '\'', "quote char"),
        _ => panic("quote char should lex"),
    }

    ⌥ lex_one("'\\\\'") {
        ?Token·Char(c) => assert(c == '\\', "backslash char"),
        _ => panic("backslash char should lex"),
    }

    println("PASS (6 cases)");
    yea
}

// ============================================================================
// 10. IDENTIFIERS
// ============================================================================

rite test_identifiers() → !bool {
    print("  [10/15] Identifiers... ");

    // Simple identifier
    ⌥ lex_one("foo") {
        ?Token·Ident(s) => assert(s == "foo", "simple ident"),
        _ => panic("simple ident should lex"),
    }

    // Underscore prefix
    ⌥ lex_one("_foo") {
        ?Token·Ident(s) => assert(s == "_foo", "underscore prefix"),
        _ => panic("underscore prefix should lex"),
    }

    // With numbers
    ⌥ lex_one("foo123") {
        ?Token·Ident(s) => assert(s == "foo123", "ident with numbers"),
        _ => panic("ident with numbers should lex"),
    }

    // Mixed case
    ⌥ lex_one("FooBar") {
        ?Token·Ident(s) => assert(s == "FooBar", "mixed case"),
        _ => panic("mixed case should lex"),
    }

    // All caps
    ⌥ lex_one("FOO_BAR") {
        ?Token·Ident(s) => assert(s == "FOO_BAR", "all caps"),
        _ => panic("all caps should lex"),
    }

    // Single underscore is wildcard pattern, but _x is ident
    ⌥ lex_one("_") {
        ?Token·Underscore => {},
        _ => panic("underscore should be Underscore token"),
    }

    println("PASS (6 cases)");
    yea
}

