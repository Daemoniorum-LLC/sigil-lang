/// Test CG-009: Uncertain pattern ⌥ should generate TAG_NULL check
/// 
/// This test verifies that ⌥ arms with ?name patterns (uncertain patterns)
/// generate proper non-null checks ∈ the C codegen, NOT "⎇ (1)".
///
/// The bug: ⌥ self.peeked { ?token => ..., null => {} }
/// Generates: ⎇ (1) { ... }  // WRONG - always true!
/// Should generate: ⎇ (_t0.tag != TAG_NULL) { ... }

☉ Σ Container {
    ☉ value: ?i32,
}

/// This function uses a ?v pattern that MUST generate a TAG_NULL check
☉ rite extract_value(c: !Container) -> !i32 {
    ⌥ c.value {
        ?v => v,
        null => 0,
    }
}

☉ rite main() -> !i32 {
    ≔ with_value = Container { value: ?42 };
    ≔ without_value = Container { value: null };
    
    ≔ r1 = extract_value(with_value);
    ≔ r2 = extract_value(without_value);
    
    ⎇ r1 != 42 {
        println("FAIL: with_value should ⤺ 42, got {}", r1);
        ⤺ 1;
    }
    
    ⎇ r2 != 0 {
        println("FAIL: without_value should ⤺ 0, got {}", r2);
        ⤺ 1;
    }
    
    println("PASS: CG-009 uncertain pattern test");
    ⤺ 0;
}
