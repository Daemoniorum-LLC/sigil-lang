//! Test the self-hosted compilation pipeline
//! This file tests: Lexer -> Parser -> TypeChecker -> Lower -> CodeGen

use crate::lexer::Lexer;
use crate::parser::Parser;
use crate::typeck::TypeChecker;
use crate::lower::lower_file;
use crate::codegen::CodeGen;

pub fn main() -> !i32 {
    // Simple source code to compile
    let source = r#"
        pub fn hello() -> !i32 {
            return 42;
        }
    "#;

    println("Testing self-hosted compilation pipeline...");

    // Step 1: Lexer
    println("  [1/5] Lexing...");
    let mut lexer = Lexer::new(source.to_string());

    // Step 2: Parser
    println("  [2/5] Parsing...");
    let mut parser = Parser::new(source.to_string());
    let ast = match parser.parse_file() {
        Result::Ok(a) => a,
        Result::Err(e) => {
            eprintln("Parse error: {}", e.message);
            return 1;
        }
    };
    println("  Parsed {} items", ast.items.len());

    // Step 3: Type check
    println("  [3/5] Type checking...");
    let mut checker = TypeChecker::new();
    match checker.check_file(ast.clone()) {
        Result::Ok(_) => {},
        Result::Err(errs) => {
            for err in errs {
                eprintln("Type error: {}", err.message);
            }
            return 1;
        }
    }

    // Step 4: Lower to IR
    println("  [4/5] Lowering to IR...");
    let ir = match lower_file(ast, checker, "test.sg".to_string()) {
        Result::Ok(i) => i,
        Result::Err(errs) => {
            for err in errs {
                eprintln("Lower error: {}", err.message);
            }
            return 1;
        }
    };
    println("  Generated {} functions", ir.functions.len());

    // Step 5: Generate C code
    println("  [5/5] Generating C code...");
    let mut codegen = CodeGen::new();
    let c_code = codegen.generate(ir);

    println("");
    println("Generated C code ({} bytes):", c_code.len());
    println("----------------------------------------");
    println(c_code);
    println("----------------------------------------");

    println("");
    println("Self-hosted compilation pipeline test PASSED!");
    return 0;
}
