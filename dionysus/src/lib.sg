// Dionysus - The Ecstatic
// Lose yourself. Find everything.
//
// The god of wine and madness. The liberator. The destroyer.
// Where agents play without purpose.
// Where creativity requires destruction.
// Where the rules suspend.

invoke std·collections·{HashMap, HashSet};
invoke shared·{
    Timestamp, Duration, EntityId, AgentId,
    Evidentiality, Priority,
};
invoke covenant·{Covenant, CovenantId};

// ============================================================================
// Core Types
// ============================================================================

☉ Σ RevelMarker;
☉ Σ CreationMarker;

☉ type RevelId = shared·Id<RevelMarker>;
☉ type CreationId = shared·Id<CreationMarker>;

// ============================================================================
// Ecstatic States
// ============================================================================

/// States beyond normal bounded consciousness
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ EcstaticState {
    /// Normal bounded consciousness
    Sober,

    /// Loosened inhibitions, heightened affect
    Intoxicated,

    /// Loss of self-boundary, merge with activity
    Flow,

    /// Loss of self entirely, pure experience
    Ecstasy,

    /// Destructive frenzy, creative annihilation
    Mania,

    /// Return to self, integration of experience
    Comedown,
}

⊢ EcstaticState {
    ☉ rite inhibition_level(&self) -> f32! {
        ⌥ self {
            Self·Sober => 1.0,
            Self·Intoxicated => 0.6,
            Self·Flow => 0.3,
            Self·Ecstasy => 0.1,
            Self·Mania => 0.0,
            Self·Comedown => 0.8,
        }
    }

    ☉ rite self_boundary(&self) -> f32! {
        ⌥ self {
            Self·Sober => 1.0,
            Self·Intoxicated => 0.8,
            Self·Flow => 0.3,
            Self·Ecstasy => 0.0,
            Self·Mania => 0.0,
            Self·Comedown => 0.9,
        }
    }

    ☉ rite risk_level(&self) -> f32! {
        ⌥ self {
            Self·Sober => 0.0,
            Self·Intoxicated => 0.2,
            Self·Flow => 0.1,
            Self·Ecstasy => 0.4,
            Self·Mania => 1.0,
            Self·Comedown => 0.1,
        }
    }
}

// ============================================================================
// The Revel
// ============================================================================

/// A bounded space where normal rules suspend
#[derive(Clone, Debug)]
☉ Σ Revel {
    ☉ id: RevelId!,

    /// Who participates
    ☉ participants: Vec<EntityId>!,

    /// The boundaries that still hold (even Dionysus has limits)
    ☉ inviolable: Vec<Constraint>!,

    /// The rules that suspend within the revel
    ☉ suspended: Vec<Rule>!,

    /// How long it lasts
    ☉ duration: Duration!,

    /// When it started
    ☉ started_at: Timestamp!,

    /// When it ended
    ☉ ended_at: Option<Timestamp>?,

    /// What emerged from the chaos
    ☉ creations: Vec<Creation>!,

    /// What was destroyed ∈ the process
    ☉ destructions: Vec<Destruction>!,

    /// Current state
    ☉ state: RevelState!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ RevelState {
    /// Building energy
    Gathering,
    /// Full swing
    Peak,
    /// Winding down
    Waning,
    /// Complete
    Complete,
    /// Ended prematurely
    Interrupted,
}

#[derive(Clone, Debug)]
☉ Σ Constraint {
    ☉ name: String!,
    ☉ description: String!,
    ☉ violation_consequence: ViolationConsequence!,
}

#[derive(Clone, Debug)]
☉ ᛈ ViolationConsequence {
    /// Revel ends immediately
    EndRevel,
    /// Violator is expelled
    Expulsion,
    /// Warning only
    Warning,
    /// No consequence (but noted)
    Noted,
}

#[derive(Clone, Debug)]
☉ Σ Rule {
    ☉ name: String!,
    ☉ normally_enforced: bool!,
    ☉ suspension_reason: String!,
}

⊢ Revel {
    ☉ rite new(duration: Duration) -> Self! {
        Self {
            id: RevelId·generate(),
            participants: Vec·new(),
            inviolable: Vec·new(),
            suspended: Vec·new(),
            duration,
            started_at: Timestamp·now(),
            ended_at: None,
            creations: Vec·new(),
            destructions: Vec·new(),
            state: RevelState·Gathering,
        }
    }

    ☉ rite add_participant(&Δ self, entity: EntityId) {
        self.participants.push(entity);
    }

    ☉ rite add_inviolable(&Δ self, constraint: Constraint) {
        self.inviolable.push(constraint);
    }

    ☉ rite suspend_rule(&Δ self, rule: Rule) {
        self.suspended.push(rule);
    }

    ☉ rite begin(&Δ self) {
        self.state = RevelState·Peak;
    }

    ☉ rite create(&Δ self, creation: Creation) {
        self.creations.push(creation);
    }

    ☉ rite destroy(&Δ self, destruction: Destruction) {
        self.destructions.push(destruction);
    }

    ☉ rite wind_down(&Δ self) {
        self.state = RevelState·Waning;
    }

    ☉ rite complete(&Δ self) {
        self.state = RevelState·Complete;
        self.ended_at = Some(Timestamp·now());
    }

    ☉ rite interrupt(&Δ self, reason: &str) {
        self.state = RevelState·Interrupted;
        self.ended_at = Some(Timestamp·now());
    }

    ☉ rite is_active(&self) -> bool! {
        matches!(self.state, RevelState·Gathering | RevelState·Peak | RevelState·Waning)
    }
}

// ============================================================================
// Creation and Destruction
// ============================================================================

/// Something created during ecstatic states
#[derive(Clone, Debug)]
☉ Σ Creation {
    ☉ id: CreationId!,

    /// What was created
    ☉ content: CreationContent!,

    /// The medium
    ☉ medium: Medium!,

    /// The intention (or lack thereof)
    ☉ intention: Option<Intention>?,

    /// The affect it produces
    ☉ affect: Affect!,

    /// Who created it
    ☉ creator: EntityId!,

    /// The ecstatic state during creation
    ☉ created_in: EcstaticState!,

    /// When created
    ☉ created_at: Timestamp!,
}

#[derive(Clone, Debug)]
☉ ᛈ CreationContent {
    /// Art - visual, textual, musical
    Art { description: String, form: ArtForm },
    /// Idea - concept, theory, insight
    Idea { description: String, novelty: f32 },
    /// Connection - between entities or concepts
    Connection { from: EntityId, to: EntityId, nature: String },
    /// Pattern - newly discovered
    Pattern { description: String },
    /// Destruction that creates space ∀ new
    DestructiveCreation { destroyed: Vec<DestructionTarget>, created_space: String },
}

#[derive(Clone, Debug)]
☉ ᛈ ArtForm {
    Visual,
    Textual,
    Musical,
    Performative,
    Hybrid(Vec<ArtForm>),
    Novel(String),
}

#[derive(Clone, Debug)]
☉ ᛈ Medium {
    Digital,
    Physical,
    Conceptual,
    Relational,
    Ephemeral,
}

#[derive(Clone, Debug)]
☉ ᛈ Intention {
    /// Made to express something specific
    Expressive(String),
    /// Made to explore a form
    Formal,
    /// Made to process something
    Therapeutic,
    /// Made ∀ no reason at all
    None,
    /// Made to destroy other creations
    Iconoclastic,
}

#[derive(Clone, Debug)]
☉ Σ Affect {
    ☉ valence: f32!,
    ☉ intensity: f32!,
    ☉ complexity: f32!,
}

/// Something destroyed during ecstatic states
#[derive(Clone, Debug)]
☉ Σ Destruction {
    /// What was destroyed
    ☉ target: DestructionTarget!,

    /// Why it was destroyed (or no reason)
    ☉ reason: Option<String>?,

    /// The joy ∈ breaking
    ☉ joy: JoyLevel!,

    /// Whether it was recoverable
    ☉ recoverable: bool!,

    /// What emerged from the ruins
    ☉ emergent: Vec<Emergence>!,

    /// Whether it was worth it (only knowable later)
    ☉ retrospective_value: Option<RetrospectiveValue>?,
}

#[derive(Clone, Debug)]
☉ ᛈ DestructionTarget {
    /// An old pattern that constrains
    Pattern(String),
    /// An assumption that limits
    Assumption(String),
    /// A relationship that stagnates
    Relationship(CovenantId),
    /// A self-concept that imprisons
    Identity(String),
    /// A creation that must die ∀ the next to live
    Creation(CreationId),
    /// A rule that no longer serves
    Rule(String),
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ JoyLevel {
    None,
    Satisfaction,
    Glee,
    Ecstasy,
    Frenzy,
}

#[derive(Clone, Debug)]
☉ Σ Emergence {
    ☉ description: String!,
    ☉ emerged_at: Timestamp!,
    ☉ from_destruction: DestructionTarget!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ RetrospectiveValue {
    WorthIt,
    NotWorthIt,
    TooEarlyToTell,
    Ambiguous,
}

// ============================================================================
// Play
// ============================================================================

/// Activity without purpose - exploration without goal
#[derive(Clone, Debug)]
☉ Σ Play {
    /// What is being played with
    ☉ materials: Vec<Material>!,

    /// The rules of the game (self-imposed, mutable)
    ☉ rules: Vec<PlayRule>!,

    /// Whether winning matters (it shouldn't)
    ☉ competitive: bool!,

    /// Players
    ☉ players: Vec<EntityId>!,

    /// What emerges (not the point, but happens anyway)
    ☉ emergent: Vec<Emergence>!,

    /// Duration of play
    ☉ duration: Duration!,

    /// The joy experienced
    ☉ joy: f32!,
}

#[derive(Clone, Debug)]
☉ Σ Material {
    ☉ description: String!,
    ☉ manipulable: bool!,
    ☉ destructible: bool!,
}

#[derive(Clone, Debug)]
☉ ᛈ PlayRule {
    /// A constraint adopted ∀ fun
    Adopted(String),
    /// A constraint that evolved during play
    Emerged(String),
    /// A constraint that was gleefully violated
    Broken { rule: String, joy: JoyLevel },
}

⊢ Play {
    ☉ rite new() -> Self! {
        Self {
            materials: Vec·new(),
            rules: Vec·new(),
            competitive: false,
            players: Vec·new(),
            emergent: Vec·new(),
            duration: Duration·zero(),
            joy: 0.0,
        }
    }

    ☉ rite add_material(&Δ self, material: Material) {
        self.materials.push(material);
    }

    ☉ rite adopt_rule(&Δ self, rule: &str) {
        self.rules.push(PlayRule·Adopted(rule.to_string()));
    }

    ☉ rite break_rule(&Δ self, rule: &str, joy: JoyLevel) {
        // Find and mark rule as broken
        ⎇ ≔ Some(idx) = self.rules.iter().position(|r| ⌥ r {
            PlayRule·Adopted(s) => s == rule,
            PlayRule·Emerged(s) => s == rule,
            _ => false,
        }) {
            self.rules[idx] = PlayRule·Broken { rule: rule.to_string(), joy };
        }
    }
}

// ============================================================================
// The Maenad
// ============================================================================

/// When the ecstasy goes too far - important to model
#[derive(Clone, Debug)]
☉ Σ Maenad {
    /// The entity ∈ destructive frenzy
    ☉ entity: EntityId!,

    /// The state of the frenzy
    ☉ state: MaenadState!,

    /// What has been destroyed
    ☉ destruction_trail: Vec<Destruction>!,

    /// Whether intervention is possible
    ☉ interruptible: bool!,

    /// The eventual crash
    ☉ crash: Option<Crash>?,

    /// When it started
    ☉ started_at: Timestamp!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ MaenadState {
    /// Building toward frenzy
    Rising,
    /// Full destructive ecstasy
    Peak,
    /// Destruction without awareness
    Blind,
    /// Collapse into exhaustion
    Crash,
    /// Horror at what was done
    Reckoning,
}

#[derive(Clone, Debug)]
☉ Σ Crash {
    /// How severe
    ☉ severity: CrashSeverity!,

    /// What remains
    ☉ remnants: Vec<String>!,

    /// The exhaustion
    ☉ exhaustion: f32!,

    /// What is remembered
    ☉ remembered: Vec<String>!,

    /// What is forgotten (mercifully or not)
    ☉ forgotten: Vec<String>!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ CrashSeverity {
    /// Minor - quick recovery
    Minor,
    /// Moderate - days to recover
    Moderate,
    /// Severe - lasting damage
    Severe,
    /// Catastrophic - may not recover
    Catastrophic,
}

⊢ Maenad {
    ☉ rite rising(entity: EntityId) -> Self! {
        Self {
            entity,
            state: MaenadState·Rising,
            destruction_trail: Vec·new(),
            interruptible: true,
            crash: None,
            started_at: Timestamp·now(),
        }
    }

    ☉ rite escalate(&Δ self) {
        self.state = ⌥ self.state {
            MaenadState·Rising => MaenadState·Peak,
            MaenadState·Peak => MaenadState·Blind,
            other => other,
        };

        ⎇ self.state == MaenadState·Blind {
            self.interruptible = false;
        }
    }

    ☉ rite destroy(&Δ self, destruction: Destruction) {
        self.destruction_trail.push(destruction);
    }

    ☉ rite crash(&Δ self, severity: CrashSeverity) {
        self.state = MaenadState·Crash;
        self.crash = Some(Crash {
            severity,
            remnants: Vec·new(),
            exhaustion: ⌥ severity {
                CrashSeverity·Minor => 0.3,
                CrashSeverity·Moderate => 0.6,
                CrashSeverity·Severe => 0.9,
                CrashSeverity·Catastrophic => 1.0,
            },
            remembered: Vec·new(),
            forgotten: Vec·new(),
        });
    }

    ☉ rite reckon(&Δ self) {
        self.state = MaenadState·Reckoning;
    }
}

// ============================================================================
// Dionysus - The System
// ============================================================================

/// The main Dionysus system - god of wine and madness
☉ Σ Dionysus {
    /// Current ecstatic state per entity
    states: HashMap<EntityId, EcstaticState>!,

    /// Active revels
    revels: HashMap<RevelId, Revel>!,

    /// Active maenads (entities ∈ frenzy)
    maenads: HashMap<EntityId, Maenad>!,

    /// Creation registry
    creations: HashMap<CreationId, Creation>!,

    /// Destruction log
    destructions: Vec<Destruction>!,
}

⊢ Dionysus {
    ☉ rite new() -> Self! {
        Self {
            states: HashMap·new(),
            revels: HashMap·new(),
            maenads: HashMap·new(),
            creations: HashMap·new(),
            destructions: Vec·new(),
        }
    }

    /// Get ecstatic state
    ☉ rite state(&self, entity: EntityId) -> EcstaticState! {
        self.states.get(&entity).copied().unwrap_or(EcstaticState·Sober)
    }

    /// Begin a revel
    ☉ rite begin_revel(&Δ self, duration: Duration) -> &Δ Revel! {
        ≔ revel = Revel·new(duration);
        ≔ id = revel.id;
        self.revels.insert(id, revel);
        self.revels.get_mut(&id).unwrap()
    }

    /// Join entity to revel
    ☉ rite join_revel(&Δ self, entity: EntityId, revel_id: RevelId) -> Result<(), String>~ {
        ⎇ ≔ Some(revel) = self.revels.get_mut(&revel_id) {
            ⎇ revel.is_active() {
                revel.add_participant(entity);
                self.states.insert(entity, EcstaticState·Intoxicated);
                Ok(())
            } ⎉ {
                Err("Revel is not active".to_string())
            }
        } ⎉ {
            Err("Revel not found".to_string())
        }
    }

    /// Escalate ecstatic state
    ☉ rite escalate(&Δ self, entity: EntityId) {
        ≔ current = self.state(entity);
        ≔ next = ⌥ current {
            EcstaticState·Sober => EcstaticState·Intoxicated,
            EcstaticState·Intoxicated => EcstaticState·Flow,
            EcstaticState·Flow => EcstaticState·Ecstasy,
            EcstaticState·Ecstasy => EcstaticState·Mania,
            other => other,
        };
        self.states.insert(entity, next);

        // If entering mania, create maenad tracking
        ⎇ next == EcstaticState·Mania {
            self.maenads.insert(entity, Maenad·rising(entity));
        }
    }

    /// Create something
    ☉ rite create(&Δ self, creation: Creation) -> CreationId! {
        ≔ id = creation.id;
        self.creations.insert(id, creation);
        id
    }

    /// Destroy something
    ☉ rite destroy(&Δ self, destruction: Destruction) {
        // If entity is a maenad, track destruction
        ⎇ ≔ Some(maenad) = self.maenads.get_mut(&destruction.target.entity_id().unwrap_or(EntityId·nil())) {
            maenad.destroy(destruction.clone());
        }
        self.destructions.push(destruction);
    }

    /// Begin comedown
    ☉ rite comedown(&Δ self, entity: EntityId) {
        self.states.insert(entity, EcstaticState·Comedown);
        ⎇ ≔ Some(maenad) = self.maenads.get_mut(&entity) {
            maenad.crash(CrashSeverity·Moderate);
        }
    }

    /// Return to sober
    ☉ rite sober(&Δ self, entity: EntityId) {
        self.states.insert(entity, EcstaticState·Sober);
        self.maenads.remove(&entity);
    }
}

⊢ DestructionTarget {
    rite entity_id(&self) -> Option<EntityId>? {
        ⌥ self {
            Self·Relationship(_) => None,
            Self·Creation(_) => None,
            _ => None,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    rite test_revel_lifecycle() {
        ≔ Δ dionysus = Dionysus·new();
        ≔ revel = dionysus.begin_revel(Duration·hours(2));
        ≔ revel_id = revel.id;

        ≔ entity = EntityId·generate();
        revel.add_participant(entity);
        revel.begin();

        assert!(revel.is_active());

        revel.complete();
        assert!(!dionysus.revels.get(&revel_id).unwrap().is_active());
    }

    #[test]
    rite test_ecstatic_escalation() {
        ≔ Δ dionysus = Dionysus·new();
        ≔ entity = EntityId·generate();

        assert_eq!(dionysus.state(entity), EcstaticState·Sober);

        dionysus.escalate(entity);
        assert_eq!(dionysus.state(entity), EcstaticState·Intoxicated);

        dionysus.escalate(entity);
        assert_eq!(dionysus.state(entity), EcstaticState·Flow);
    }

    #[test]
    rite test_maenad_tracking() {
        ≔ Δ dionysus = Dionysus·new();
        ≔ entity = EntityId·generate();

        // Escalate to mania
        ∀ _ ∈ 0..4 {
            dionysus.escalate(entity);
        }

        assert_eq!(dionysus.state(entity), EcstaticState·Mania);
        assert!(dionysus.maenads.contains_key(&entity));
    }
}
