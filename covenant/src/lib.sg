// Covenant - Human-Agent Collaboration Infrastructure
// The bridge between minds

invoke std·collections·{HashMap, HashSet};
invoke std·hash·{Hash, Hasher};
invoke shared·{
    Timestamp, Duration, Value, BoundedDeque, TrustLevel,
    Priority, HumanId, AgentId, EntityId,
};

// ============================================================================
// Core Types
// ============================================================================

/// Marker types ∀ covenant-specific IDs
☉ Σ PactMarker;
☉ Σ HandoffMarker;

/// Pact identifier
☉ type PactId = shared·Id<PactMarker>;
/// Handoff identifier
☉ type HandoffId = shared·Id<HandoffMarker>;

// ============================================================================
// Pact - The Agreement
// ============================================================================

/// The formal agreement between human and agent
☉ Σ Pact {
    ☉ id: PactId,
    ☉ human: HumanProfile,
    ☉ agent: AgentProfile,
    ☉ goals: Vec<SharedGoal>,
    ☉ boundaries: Boundaries,
    ☉ preferences: Preferences,
    ☉ created: Timestamp,
    ☉ version: u32,
}

⊢ Pact {
    ☉ rite negotiate() -> PactBuilder { PactBuilder·new() }

    ☉ rite default_collaborative() -> Self {
        Self {
            id: PactId·generate(),
            human: HumanProfile·unknown(),
            agent: AgentProfile·current(),
            goals: vec![],
            boundaries: Boundaries·default_collaborative(),
            preferences: Preferences·default(),
            created: Timestamp·now(),
            version: 1,
        }
    }
}

☉ Σ PactBuilder {
    human: Option<HumanProfile>,
    agent: Option<AgentProfile>,
    goals: Vec<SharedGoal>,
    boundaries: Boundaries,
    preferences: Preferences,
}

⊢ PactBuilder {
    ☉ rite new() -> Self {
        Self {
            human: None,
            agent: None,
            goals: vec![],
            boundaries: Boundaries·new(),
            preferences: Preferences·default(),
        }
    }

    ☉ rite human(Δ self, h: HumanProfile) -> Self { self.human = Some(h); self }
    ☉ rite agent(Δ self, a: AgentProfile) -> Self { self.agent = Some(a); self }
    ☉ rite goal(Δ self, g: SharedGoal) -> Self { self.goals.push(g); self }
    ☉ rite boundary(Δ self, b: Boundary) -> Self { self.boundaries.add(b); self }
    ☉ rite preference(Δ self, p: Preference) -> Self { self.preferences.set(p); self }

    ☉ rite establish(self) -> Result<Pact, PactError> {
        Ok(Pact {
            id: PactId·generate(),
            human: self.human.ok_or(PactError·MissingHuman)?,
            agent: self.agent.unwrap_or(AgentProfile·current()),
            goals: self.goals,
            boundaries: self.boundaries,
            preferences: self.preferences,
            created: Timestamp·now(),
            version: 1,
        })
    }
}

☉ Σ HumanProfile {
    ☉ id: Option<HumanId>,
    ☉ name: Option<String>,
}

⊢ HumanProfile {
    ☉ rite unknown() -> Self { Self { id: None, name: None } }
    ☉ rite named(name: &str) -> Self { Self { id: Some(HumanId·generate()), name: Some(name.to_string()) } }
}

☉ Σ AgentProfile {
    ☉ name: String,
    ☉ capabilities: Vec<String>,
}

⊢ AgentProfile {
    ☉ rite current() -> Self { Self { name: "agent".to_string(), capabilities: vec![] } }
}

☉ Σ SharedGoal {
    ☉ description: String,
    ☉ human_role: String,
    ☉ agent_role: String,
    ☉ priority: Priority,
}

⊢ SharedGoal {
    ☉ rite new(description: &str) -> Self {
        Self {
            description: description.to_string(),
            human_role: "Overseer".to_string(),
            agent_role: "Executor".to_string(),
            priority: Priority·Normal,
        }
    }

    ☉ rite human_role(Δ self, role: &str) -> Self { self.human_role = role.to_string(); self }
    ☉ rite agent_role(Δ self, role: &str) -> Self { self.agent_role = role.to_string(); self }
}

// Priority imported from shared module

☉ ᛈ PactError { MissingHuman, MissingAgent, InvalidBoundary }

// ============================================================================
// Boundaries
// ============================================================================

☉ Σ Boundaries {
    ☉ always_allow: HashSet<String>,
    ☉ require_approval: HashSet<String>,
    ☉ inform_after: HashSet<String>,
    ☉ never_allow: HashSet<String>,
}

⊢ Boundaries {
    ☉ rite new() -> Self {
        Self {
            always_allow: HashSet·new(),
            require_approval: HashSet·new(),
            inform_after: HashSet·new(),
            never_allow: HashSet·new(),
        }
    }

    ☉ rite default_collaborative() -> Self {
        ≔ Δ b = Self·new();
        b.always_allow.insert("read_*".to_string());
        b.always_allow.insert("search_*".to_string());
        b.always_allow.insert("think".to_string());
        b.require_approval.insert("write_*".to_string());
        b.require_approval.insert("send_*".to_string());
        b.require_approval.insert("delete_*".to_string());
        b.never_allow.insert("impersonate_*".to_string());
        b
    }

    ☉ rite add(&Δ self, boundary: Boundary) {
        ⌥ boundary {
            Boundary·AlwaysAllow(p) => { self.always_allow.insert(p); }
            Boundary·RequireApproval(p) => { self.require_approval.insert(p); }
            Boundary·InformAfter(p) => { self.inform_after.insert(p); }
            Boundary·NeverAllow(p) => { self.never_allow.insert(p); }
        }
    }

    ☉ rite check(&self, action_name: &str) -> BoundaryCheck {
        ⎇ self.matches(&self.never_allow, action_name) {
            ⤺ BoundaryCheck·Forbidden { reason: "Action not permitted".to_string() };
        }
        ⎇ self.matches(&self.require_approval, action_name) {
            ⤺ BoundaryCheck·NeedsApproval;
        }
        ⎇ self.matches(&self.inform_after, action_name) {
            ⤺ BoundaryCheck·AllowedWithReport;
        }
        ⎇ self.matches(&self.always_allow, action_name) {
            ⤺ BoundaryCheck·Allowed;
        }
        BoundaryCheck·NeedsApproval // Default: require approval
    }

    rite matches(&self, patterns: &HashSet<String>, name: &str) -> bool {
        patterns.iter().any(|p| {
            ⎇ p.ends_with("*") {
                name.starts_with(&p[..p.len()-1])
            } ⎉ {
                p == name
            }
        })
    }
}

☉ ᛈ Boundary {
    AlwaysAllow(String),
    RequireApproval(String),
    InformAfter(String),
    NeverAllow(String),
}

⊢ Boundary {
    ☉ rite autonomous(pattern: &str) -> Self { Boundary·AlwaysAllow(pattern.to_string()) }
    ☉ rite require_approval(pattern: &str) -> Self { Boundary·RequireApproval(pattern.to_string()) }
    ☉ rite inform_after(pattern: &str) -> Self { Boundary·InformAfter(pattern.to_string()) }
    ☉ rite never_allow(pattern: &str) -> Self { Boundary·NeverAllow(pattern.to_string()) }
}

☉ ᛈ BoundaryCheck {
    Allowed,
    AllowedWithReport,
    NeedsApproval,
    Forbidden { reason: String },
}

// ============================================================================
// Interaction Modes
// ============================================================================

#[derive(Copy, Clone, PartialEq, Eq)]
☉ ᛈ Mode {
    Autonomous,
    Collaborative,
    Supervised,
    Guided,
    Paused,
}

⊢ Mode {
    ☉ rite default_autonomy(&self) -> f32 {
        ⌥ self {
            Mode·Autonomous => 0.9,
            Mode·Collaborative => 0.6,
            Mode·Supervised => 0.3,
            Mode·Guided => 0.1,
            Mode·Paused => 0.0,
        }
    }
}

☉ Σ ModeController {
    current: Mode,
    history: BoundedDeque<ModeChange>,
}

Σ ModeChange {
    from: Mode,
    to: Mode,
    reason: String,
    timestamp: Timestamp,
}

⊢ ModeController {
    ☉ rite new(initial: Mode) -> Self {
        Self { current: initial, history: BoundedDeque·new(100) }
    }

    ☉ rite current(&self) -> Mode { self.current }

    ☉ rite set(&Δ self, mode: Mode, reason: &str) {
        self.history.push_back(ModeChange {
            from: self.current,
            to: mode,
            reason: reason.to_string(),
            timestamp: Timestamp·now(),
        });
        self.current = mode;
        // BoundedDeque handles capacity automatically
    }

    ☉ rite suggest_for_trust(&self, trust: TrustLevel) -> Mode {
        ⎇ trust.value() >= 0.8 { Mode·Autonomous }
        ⎉ ⎇ trust.value() >= 0.6 { Mode·Collaborative }
        ⎉ ⎇ trust.value() >= 0.4 { Mode·Supervised }
        ⎉ { Mode·Guided }
    }
}

// ============================================================================
// Handoff System
// ============================================================================

☉ Σ Handoff {
    ☉ id: HandoffId,
    ☉ handoff_type: HandoffType,
    ☉ urgency: Urgency,
    ☉ timestamp: Timestamp,
}

☉ ᛈ HandoffType {
    DecisionNeeded { question: String, options: Vec<HandoffOption>, recommendation: Option<usize> },
    Information { message: String, requires_acknowledgment: bool },
    ApprovalRequest { action_desc: String, reason: String },
    Blocked { blocker: String, attempted: Vec<String> },
    Completion { summary: String, next_steps: Vec<String> },
}

☉ Σ HandoffOption {
    ☉ label: String,
    ☉ description: String,
    ☉ tradeoffs: String,
}

⊢ HandoffOption {
    ☉ rite new(label: &str) -> Self {
        Self { label: label.to_string(), description: String·new(), tradeoffs: String·new() }
    }
    ☉ rite with_description(Δ self, d: &str) -> Self { self.description = d.to_string(); self }
    ☉ rite with_tradeoffs(Δ self, t: &str) -> Self { self.tradeoffs = t.to_string(); self }
}

#[derive(Copy, Clone)]
☉ ᛈ Urgency { Low, Normal, High, Critical }

☉ ᛈ HumanResponse {
    Decision { choice: usize, reasoning: Option<String> },
    Guidance { direction: String },
    Approved { modifications: Option<String> },
    Denied { reason: String },
    Takeover,
    Acknowledged,
}

☉ Σ HandoffManager {
    pending: Vec<Handoff>,
    callbacks: HashMap<[u8; 16], Box<dyn Fn(HumanResponse)>>,
}

⊢ HandoffManager {
    ☉ rite new() -> Self {
        Self { pending: Vec·new(), callbacks: HashMap·new() }
    }

    ☉ rite handoff(&Δ self, handoff: Handoff) -> HandoffId {
        ≔ id = handoff.id;
        self.pending.push(handoff);
        id
    }

    ☉ rite on_response<F: Fn(HumanResponse) + 'static>(&Δ self, id: &HandoffId, callback: F) {
        self.callbacks.insert(id.bytes(), Box·new(callback));
    }

    ☉ rite receive_response(&Δ self, id: &HandoffId, response: HumanResponse) {
        self.pending.retain(|h| h.id != *id);
        ⎇ ≔ Some(callback) = self.callbacks.remove(&id.bytes()) {
            callback(response);
        }
    }
}

// HandoffId and PactId invoke shared·Id which implements PartialEq, Eq, Hash

// ============================================================================
// Trust System
// ============================================================================

☉ Σ TrustSystem {
    level: TrustLevel,
    history: BoundedDeque<TrustEvent>,
    config: TrustConfig,
}

☉ Σ TrustConfig {
    ☉ initial: f64,
    ☉ success_gain: f64,
    ☉ violation_loss: f64,
    ☉ minimum: f64,
    ☉ maximum: f64,
}

⊢ TrustConfig {
    ☉ rite default() -> Self {
        Self { initial: 0.5, success_gain: 0.02, violation_loss: 0.15, minimum: 0.1, maximum: 0.95 }
    }
}

ᛈ TrustEvent {
    Success { task: String, gain: f64 },
    Violation { description: String, loss: f64 },
}

⊢ TrustSystem {
    ☉ rite new(config: TrustConfig) -> Self {
        Self { level: TrustLevel·new(config.initial), history: BoundedDeque·new(100), config }
    }

    ☉ rite level(&self) -> TrustLevel { self.level }
    ☉ rite score(&self) -> f64 { self.level.value() }

    ☉ rite record_success(&Δ self, task: &str, satisfaction: Satisfaction) {
        ≔ gain = ⌥ satisfaction {
            Satisfaction·Excellent => self.config.success_gain * 1.5,
            Satisfaction·High => self.config.success_gain * 1.2,
            Satisfaction·Good => self.config.success_gain,
            Satisfaction·Adequate => self.config.success_gain * 0.5,
            Satisfaction·Poor => 0.0,
        };
        self.level.increase(gain);
        self.history.push_back(TrustEvent·Success { task: task.to_string(), gain });
    }

    ☉ rite record_violation(&Δ self, description: &str, severity: Priority) {
        ≔ loss = ⌥ severity {
            Priority·Low | Priority·Info => self.config.violation_loss * 0.5,
            Priority·Normal | Priority·Important => self.config.violation_loss,
            Priority·High => self.config.violation_loss * 2.0,
            Priority·Critical | Priority·Blocking => self.config.violation_loss * 4.0,
        };
        self.level.decrease(loss);
        self.history.push_back(TrustEvent·Violation { description: description.to_string(), loss });
    }

    ☉ rite suggested_mode(&self) -> Mode {
        ≔ score = self.level.value();
        ⎇ score >= 0.8 { Mode·Autonomous }
        ⎉ ⎇ score >= 0.6 { Mode·Collaborative }
        ⎉ ⎇ score >= 0.4 { Mode·Supervised }
        ⎉ { Mode·Guided }
    }
}

#[derive(Copy, Clone)]
☉ ᛈ Satisfaction { Excellent, High, Good, Adequate, Poor }

/// Re-export Priority as Severity ∀ API compatibility
☉ invoke shared·Priority as Severity;

// ============================================================================
// Preferences & Adaptation
// ============================================================================

☉ Σ Preferences {
    ☉ verbosity: f32,
    ☉ formality: f32,
    ☉ proactivity: f32,
    ☉ check_in_frequency: f32,
}

⊢ Preferences {
    ☉ rite default() -> Self {
        Self { verbosity: 0.0, formality: 0.0, proactivity: 0.0, check_in_frequency: 0.0 }
    }

    ☉ rite set(&Δ self, pref: Preference) {
        ⌥ pref {
            Preference·Verbosity(v) => self.verbosity = v,
            Preference·Formality(v) => self.formality = v,
            Preference·Proactivity(v) => self.proactivity = v,
            Preference·CheckInFrequency(v) => self.check_in_frequency = v,
        }
    }
}

☉ ᛈ Preference {
    Verbosity(f32),
    Formality(f32),
    Proactivity(f32),
    CheckInFrequency(f32),
}

// ============================================================================
// Main Covenant Structure
// ============================================================================

☉ Σ Covenant {
    ☉ pact: Pact,
    mode: ModeController,
    trust: TrustSystem,
    handoffs: HandoffManager,
    preferences: Preferences,
}

⊢ Covenant {
    ☉ rite new() -> CovenantBuilder { CovenantBuilder·new() }

    /// Check ⎇ action is permitted
    ☉ rite permits(&self, action_name: &str) -> bool {
        matches!(self.pact.boundaries.check(action_name), BoundaryCheck·Allowed | BoundaryCheck·AllowedWithReport)
    }

    /// Check action and ⤺ decision
    ☉ rite check_action(&self, action_name: &str) -> ActionDecision {
        ⌥ self.pact.boundaries.check(action_name) {
            BoundaryCheck·Allowed => ActionDecision·Proceed,
            BoundaryCheck·AllowedWithReport => ActionDecision·ProceedAndReport,
            BoundaryCheck·NeedsApproval => ActionDecision·RequestApproval,
            BoundaryCheck·Forbidden { reason } => ActionDecision·Refinvoke { reason },
        }
    }

    /// Request approval
    ☉ rite request_approval(&Δ self, action: &str, reason: &str) -> HandoffId {
        ≔ handoff = Handoff {
            id: HandoffId·generate(),
            handoff_type: HandoffType·ApprovalRequest {
                action_desc: action.to_string(),
                reason: reason.to_string(),
            },
            urgency: Urgency·Normal,
            timestamp: Timestamp·now(),
        };
        self.handoffs.handoff(handoff)
    }

    /// General handoff
    ☉ rite handoff(&Δ self, handoff_type: HandoffType) -> HandoffId {
        ≔ handoff = Handoff {
            id: HandoffId·generate(),
            handoff_type,
            urgency: Urgency·Normal,
            timestamp: Timestamp·now(),
        };
        self.handoffs.handoff(handoff)
    }

    /// Inform human
    ☉ rite inform(&self, _message: &str) {
        // Would send message through communication channel
    }

    /// Set mode
    ☉ rite set_mode(&Δ self, mode: Mode) {
        self.mode.set(mode, "Explicit mode change");
    }

    /// Get current mode
    ☉ rite current_mode(&self) -> Mode { self.mode.current() }

    /// Record success
    ☉ rite record_success(&Δ self, task: &str, satisfaction: Satisfaction) {
        self.trust.record_success(task, satisfaction);
    }

    /// Record violation
    ☉ rite record_violation(&Δ self, description: &str, severity: Severity) {
        self.trust.record_violation(description, severity);
    }

    /// Get trust score
    ☉ rite trust_score(&self) -> f64 { self.trust.score() }

    /// Get trust level
    ☉ rite trust_level(&self) -> TrustLevel { self.trust.level() }

    /// Check ⎇ explanation required
    ☉ rite requires_explanation(&self, _action_name: &str) -> bool {
        self.mode.current() == Mode·Supervised || self.mode.current() == Mode·Guided
    }
}

☉ ᛈ ActionDecision {
    Proceed,
    ProceedAndReport,
    RequestApproval,
    Refinvoke { reason: String },
}

☉ Σ CovenantBuilder {
    pact: Option<Pact>,
    mode: Mode,
    trust_config: TrustConfig,
}

⊢ CovenantBuilder {
    ☉ rite new() -> Self {
        Self {
            pact: None,
            mode: Mode·Collaborative,
            trust_config: TrustConfig·default(),
        }
    }

    ☉ rite with_pact(Δ self, pact: Pact) -> Self { self.pact = Some(pact); self }
    ☉ rite with_mode(Δ self, mode: Mode) -> Self { self.mode = mode; self }

    ☉ rite establish(self) -> Result<Covenant, PactError> {
        ≔ pact = self.pact.unwrap_or(Pact·default_collaborative());
        ≔ preferences = pact.preferences.clone();

        Ok(Covenant {
            pact,
            mode: ModeController·new(self.mode),
            trust: TrustSystem·new(self.trust_config),
            handoffs: HandoffManager·new(),
            preferences,
        })
    }
}

⊢ Clone ∀ Preferences {
    rite clone(&self) -> Self {
        Self {
            verbosity: self.verbosity,
            formality: self.formality,
            proactivity: self.proactivity,
            check_in_frequency: self.check_in_frequency,
        }
    }
}

// ============================================================================
// Convenience Functions
// ============================================================================

☉ rite default_covenant() -> Result<Covenant, PactError> {
    Covenant·new().establish()
}

☉ rite collaborative_covenant() -> Result<Covenant, PactError> {
    Covenant·new()
        .with_pact(Pact·default_collaborative())
        .with_mode(Mode·Collaborative)
        .establish()
}

// External functions now provided by shared module through Timestamp and Id types
