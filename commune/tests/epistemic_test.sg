fn test_epistemic_trustworthy() {
    assert(Epistemic::Axiomatic.is_trustworthy());
    assert(Epistemic::Observed.is_trustworthy());
    assert(Epistemic::Reported.is_trustworthy());
    assert(!Epistemic::Inferred.is_trustworthy());
}

#[test]
fn test_epistemic_uncertain() {
    assert(Epistemic::Contested.is_uncertain());
    assert(Epistemic::Unknown.is_uncertain());
    assert(!Epistemic::Observed.is_uncertain());
}

