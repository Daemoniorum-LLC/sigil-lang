//! Commune Trust Tests - 18 tests

Σ TrustFlags {
    verified: !bool,
    blocked: !bool,
    system: !bool,
}

⊢ TrustFlags {
    ☉ rite default_flags() -> Self {
        TrustFlags {
            verified: false,
            blocked: false,
            system: false,
        }
    }

    ☉ rite verified() -> Self {
        TrustFlags {
            verified: true,
            blocked: false,
            system: false,
        }
    }

    ☉ rite system_agent() -> Self {
        TrustFlags {
            verified: true,
            blocked: false,
            system: true,
        }
    }

    ☉ rite blocked_agent() -> Self {
        TrustFlags {
            verified: false,
            blocked: true,
            system: false,
        }
    }

    ☉ rite is_trusted(&self) -> !bool {
        !self.blocked && (self.verified || self.system)
    }
}

Σ AccuracyMetrics {
    total: !usize,
    correct: !usize,
}

⊢ AccuracyMetrics {
    ☉ rite new() -> Self {
        AccuracyMetrics { total: 0, correct: 0 }
    }

    ☉ rite record_correct(&Δ self) {
        self.total = self.total + 1;
        self.correct = self.correct + 1;
    }

    ☉ rite record_incorrect(&Δ self) {
        self.total = self.total + 1;
    }

    ☉ rite score(&self) -> !f32 {
        ⎇ self.total == 0 {
            1.0
        } ⎉ {
            self.correct as !f32 / self.total as !f32
        }
    }

    ☉ rite is_reliable(&self) -> !bool {
        self.score() >= 0.8
    }
}

Σ TrustLevel {
    base: !f32,
    bonus: !f32,
    penalty: !f32,
}

⊢ TrustLevel {
    ☉ rite new(base: !f32) -> Self {
        TrustLevel { base, bonus: 0.0, penalty: 0.0 }
    }

    ☉ rite with_bonus(Δ self, bonus: !f32) -> Self {
        self.bonus = bonus;
        self
    }

    ☉ rite with_penalty(Δ self, penalty: !f32) -> Self {
        self.penalty = penalty;
        self
    }

    ☉ rite effective(&self) -> !f32 {
        ≔ raw = self.base + self.bonus - self.penalty;
        ⎇ raw < 0.0 {
            0.0
        } ⎉ ⎇ raw > 1.0 {
            1.0
        } ⎉ {
            raw
        }
    }

    ☉ rite meets_threshold(&self, threshold: !f32) -> !bool {
        self.effective() >= threshold
    }
}

Σ TrustProfile {
    base_trust: !f32,
    accuracy: AccuracyMetrics,
    vouch_bonus: !f32,
    flags: TrustFlags,
}

⊢ TrustProfile {
    ☉ rite new(default_trust: !f32) -> Self {
        TrustProfile {
            base_trust: default_trust,
            accuracy: AccuracyMetrics·new(),
            vouch_bonus: 0.0,
            flags: TrustFlags·default_flags(),
        }
    }

    ☉ rite verified(trust: !f32) -> Self {
        TrustProfile {
            base_trust: trust,
            accuracy: AccuracyMetrics·new(),
            vouch_bonus: 0.0,
            flags: TrustFlags·verified(),
        }
    }

    ☉ rite system() -> Self {
        TrustProfile {
            base_trust: 1.0,
            accuracy: AccuracyMetrics·new(),
            vouch_bonus: 0.0,
            flags: TrustFlags·system_agent(),
        }
    }

    ☉ rite add_vouch(&Δ self, strength: !f32) {
        self.vouch_bonus = self.vouch_bonus + strength;
        ⎇ self.vouch_bonus > 0.2 {
            self.vouch_bonus = 0.2;
        }
    }

    ☉ rite effective_trust(&self) -> !f32 {
        ⎇ self.flags.blocked {
            ⤺ 0.0;
        }
        ≔ accuracy_factor = self.accuracy.score();
        ≔ base = self.base_trust * accuracy_factor + self.vouch_bonus;
        ⎇ base > 1.0 {
            1.0
        } ⎉ {
            base
        }
    }

    ☉ rite can_vouch(&self) -> !bool {
        self.effective_trust() >= 0.7
    }
}

// ============================================================================
// Tests
// ============================================================================

#[test]
rite test_trust_flags_default() {
    ≔ flags = TrustFlags·default_flags();
    assert(!flags.verified);
    assert(!flags.blocked);
    assert(!flags.is_trusted());
}

#[test]
rite test_trust_flags_verified() {
    ≔ flags = TrustFlags·verified();
    assert(flags.verified);
    assert(flags.is_trusted());
}

#[test]
rite test_trust_flags_system() {
    ≔ flags = TrustFlags·system_agent();
    assert(flags.system);
    assert(flags.is_trusted());
}

#[test]
rite test_trust_flags_blocked() {
    ≔ flags = TrustFlags·blocked_agent();
    assert(flags.blocked);
    assert(!flags.is_trusted());
}

#[test]
rite test_accuracy_empty() {
    ≔ acc = AccuracyMetrics·new();
    assert(acc.score() == 1.0);
}

#[test]
rite test_accuracy_perfect() {
    ≔ Δ acc = AccuracyMetrics·new();
    acc.record_correct();
    acc.record_correct();
    acc.record_correct();
    assert(acc.score() == 1.0);
    assert(acc.is_reliable());
}

#[test]
rite test_accuracy_mixed() {
    ≔ Δ acc = AccuracyMetrics·new();
    acc.record_correct();
    acc.record_incorrect();
    assert(acc.score() == 0.5);
    assert(!acc.is_reliable());
}

#[test]
rite test_trust_level_base() {
    ≔ level = TrustLevel·new(0.5);
    assert(level.effective() == 0.5);
}

#[test]
rite test_trust_level_with_bonus() {
    ≔ level = TrustLevel·new(0.5).with_bonus(0.2);
    assert(level.effective() == 0.7);
}

#[test]
rite test_trust_level_with_penalty() {
    ≔ level = TrustLevel·new(0.5).with_penalty(0.3);
    assert(level.effective() == 0.2);
}

#[test]
rite test_trust_level_clamped_high() {
    ≔ level = TrustLevel·new(0.9).with_bonus(0.3);
    assert(level.effective() == 1.0);
}

#[test]
rite test_trust_level_clamped_low() {
    ≔ level = TrustLevel·new(0.2).with_penalty(0.5);
    assert(level.effective() == 0.0);
}

#[test]
rite test_trust_level_threshold() {
    ≔ level = TrustLevel·new(0.8);
    assert(level.meets_threshold(0.7));
    assert(!level.meets_threshold(0.9));
}

#[test]
rite test_trust_profile_new() {
    ≔ profile = TrustProfile·new(0.5);
    assert(profile.base_trust == 0.5);
}

#[test]
rite test_trust_profile_verified() {
    ≔ profile = TrustProfile·verified(0.9);
    assert(profile.flags.verified);
}

#[test]
rite test_trust_profile_system() {
    ≔ profile = TrustProfile·system();
    assert(profile.effective_trust() == 1.0);
    assert(profile.can_vouch());
}

#[test]
rite test_trust_profile_vouch() {
    ≔ Δ profile = TrustProfile·new(0.7);
    profile.add_vouch(0.1);
    profile.add_vouch(0.1);
    assert(profile.vouch_bonus == 0.2);
}

#[test]
rite test_trust_profile_vouch_cap() {
    ≔ Δ profile = TrustProfile·new(0.5);
    profile.add_vouch(0.3);
    assert(profile.vouch_bonus == 0.2);
}

rite main() {
    println("Commune trust tests - 18 tests");
}
