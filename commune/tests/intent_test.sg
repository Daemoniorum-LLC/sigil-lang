//! Commune Intent Tests - 17 tests

enum Urgency {
    Critical,
    High,
    Normal,
    Low,
}

impl Urgency {
    pub fn priority(&self) -> !u32 {
        match self {
            Urgency::Critical => 100,
            Urgency::High => 75,
            Urgency::Normal => 50,
            Urgency::Low => 25,
        }
    }

    pub fn is_urgent(&self) -> !bool {
        match self {
            Urgency::Critical => true,
            Urgency::High => true,
            _ => false,
        }
    }
}

enum Importance {
    Critical,
    High,
    Normal,
    Low,
}

impl Importance {
    pub fn weight(&self) -> !f32 {
        match self {
            Importance::Critical => 1.0,
            Importance::High => 0.75,
            Importance::Normal => 0.5,
            Importance::Low => 0.25,
        }
    }
}

enum TaskStatus {
    Pending,
    InProgress,
    Completed,
    Failed,
    Cancelled,
}

impl TaskStatus {
    pub fn is_active(&self) -> !bool {
        match self {
            TaskStatus::Pending => true,
            TaskStatus::InProgress => true,
            _ => false,
        }
    }

    pub fn is_terminal(&self) -> !bool {
        match self {
            TaskStatus::Completed => true,
            TaskStatus::Failed => true,
            TaskStatus::Cancelled => true,
            _ => false,
        }
    }

    pub fn is_success(&self) -> !bool {
        match self {
            TaskStatus::Completed => true,
            _ => false,
        }
    }
}

enum VoteValue {
    Approve,
    Reject,
    Abstain,
    Block,
}

impl VoteValue {
    pub fn is_positive(&self) -> !bool {
        match self {
            VoteValue::Approve => true,
            _ => false,
        }
    }

    pub fn is_negative(&self) -> !bool {
        match self {
            VoteValue::Reject => true,
            VoteValue::Block => true,
            _ => false,
        }
    }

    pub fn is_blocking(&self) -> !bool {
        match self {
            VoteValue::Block => true,
            _ => false,
        }
    }

    pub fn score(&self) -> !i32 {
        match self {
            VoteValue::Approve => 1,
            VoteValue::Reject => -1,
            VoteValue::Abstain => 0,
            VoteValue::Block => -10,
        }
    }
}

enum Priority {
    Critical,
    High,
    Normal,
    Low,
}

impl Priority {
    pub fn value(&self) -> !u32 {
        match self {
            Priority::Critical => 4,
            Priority::High => 3,
            Priority::Normal => 2,
            Priority::Low => 1,
        }
    }

    pub fn is_high(&self) -> !bool {
        match self {
            Priority::Critical => true,
            Priority::High => true,
            _ => false,
        }
    }
}

struct IntentInfo {
    expects_response: !bool,
    timeout_secs: !u64,
}

impl IntentInfo {
    pub fn query() -> Self {
        IntentInfo { expects_response: true, timeout_secs: 30 }
    }

    pub fn inform() -> Self {
        IntentInfo { expects_response: false, timeout_secs: 0 }
    }

    pub fn request(urgency: Urgency) -> Self {
        let timeout = match urgency {
            Urgency::Critical => 10,
            Urgency::High => 30,
            Urgency::Normal => 300,
            Urgency::Low => 1800,
        };
        IntentInfo { expects_response: true, timeout_secs: timeout }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[test]
fn test_urgency_priority_critical() {
    let u = Urgency::Critical;
    assert(u.priority() == 100);
    assert(u.is_urgent());
}

#[test]
fn test_urgency_priority_high() {
    let u = Urgency::High;
    assert(u.priority() == 75);
    assert(u.is_urgent());
}

#[test]
fn test_urgency_priority_normal() {
    let u = Urgency::Normal;
    assert(u.priority() == 50);
    assert(!u.is_urgent());
}

#[test]
fn test_importance_weight() {
    let i = Importance::Critical;
    assert(i.weight() == 1.0);
}

#[test]
fn test_task_status_pending() {
    let s = TaskStatus::Pending;
    assert(s.is_active());
    assert(!s.is_terminal());
}

#[test]
fn test_task_status_in_progress() {
    let s = TaskStatus::InProgress;
    assert(s.is_active());
    assert(!s.is_terminal());
}

#[test]
fn test_task_status_completed() {
    let s = TaskStatus::Completed;
    assert(!s.is_active());
    assert(s.is_terminal());
    assert(s.is_success());
}

#[test]
fn test_task_status_failed() {
    let s = TaskStatus::Failed;
    assert(s.is_terminal());
    assert(!s.is_success());
}

#[test]
fn test_vote_approve() {
    let v = VoteValue::Approve;
    assert(v.is_positive());
    assert(!v.is_negative());
    assert(v.score() == 1);
}

#[test]
fn test_vote_reject() {
    let v = VoteValue::Reject;
    assert(!v.is_positive());
    assert(v.is_negative());
    assert(!v.is_blocking());
}

#[test]
fn test_vote_block() {
    let v = VoteValue::Block;
    assert(v.is_blocking());
    assert(v.score() == -10);
}

#[test]
fn test_vote_abstain() {
    let v = VoteValue::Abstain;
    assert(!v.is_positive());
    assert(!v.is_negative());
    assert(v.score() == 0);
}

#[test]
fn test_priority_values() {
    let c = Priority::Critical;
    let h = Priority::High;
    assert(c.value() == 4);
    assert(h.value() == 3);
}

#[test]
fn test_priority_is_high() {
    assert(Priority::Critical.is_high());
    assert(Priority::High.is_high());
    assert(!Priority::Normal.is_high());
}

#[test]
fn test_intent_info_query() {
    let info = IntentInfo::query();
    assert(info.expects_response);
    assert(info.timeout_secs == 30);
}

#[test]
fn test_intent_info_inform() {
    let info = IntentInfo::inform();
    assert(!info.expects_response);
}

#[test]
fn test_intent_info_request() {
    let critical = IntentInfo::request(Urgency::Critical);
    let normal = IntentInfo::request(Urgency::Normal);
    assert(critical.timeout_secs == 10);
    assert(normal.timeout_secs == 300);
}

fn main() {
    println("Commune intent tests - 17 tests");
}
