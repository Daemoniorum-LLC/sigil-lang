    Hierarchical,

    /// Ring
    Ring,
}

☉ Σ TrustModelConfig {
    /// Initial trust ∀ new agents
    ☉ default_trust: f32,

    /// Trust decay half-life
    ☉ decay_halflife: Duration,

    /// Minimum trust threshold
    ☉ min_trust: f32,

    /// Trust required ∀ sensitive operations
    ☉ sensitive_trust: f32,

