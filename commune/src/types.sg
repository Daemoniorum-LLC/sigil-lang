// Commune Core Types
// Multi-agent communication infrastructure

// ============================================================================
// Identity Types
// ============================================================================

/// Agent identifier
☉ Σ AgentId {
    id: String,
}

⊢ AgentId {
    ☉ rite new() {
        AgentId { id: uuid_v4() }
    }

    ☉ rite from_str(s) {
        AgentId { id: s }
    }

    ☉ rite to_string(self) {
        ↩ self.id;
    }
}

/// Message identifier
☉ Σ MessageId {
    id: String,
}

⊢ MessageId {
    ☉ rite new() {
        MessageId { id: uuid_v4() }
    }
}

/// Channel identifier
☉ Σ ChannelId {
    name: String,
}

⊢ ChannelId {
    ☉ rite new(name) {
        ChannelId { name: name }
    }
}

/// Swarm identifier
☉ Σ SwarmId {
    id: String,
}

⊢ SwarmId {
    ☉ rite new() {
        SwarmId { id: uuid_v4() }
    }
}

/// Proposal identifier
☉ Σ ProposalId {
    id: String,
}

⊢ ProposalId {
    ☉ rite new() {
        ProposalId { id: uuid_v4() }
    }
}

// ============================================================================
// Message Types
// ============================================================================

/// Core message structure
☉ Σ Message {
    id: MessageId,
    sender: AgentId,
    recipient: AgentId,
    kind: String,
    payload: String,
    timestamp: Int,
}

⊢ Message {
    ☉ rite new(sender, recipient, kind, payload) {
        Message {
            id: MessageId·new(),
            sender: sender,
            recipient: recipient,
            kind: kind,
            payload: payload,
            timestamp: Sys·clock_gettime(),
        }
    }
}

// ============================================================================
// Priority Types
// ============================================================================

☉ ᛈ Priority {
    Critical,
    High,
    Normal,
    Low,
}

// ============================================================================
// Recipient Types
// ============================================================================

/// Message recipient
☉ ᛈ Recipient {
    /// Single agent
    Agent { id: String },

    /// Named channel
    Channel { name: String },

    /// All agents
    Broadcast,
}

// ============================================================================
// Intent Types
// ============================================================================

/// Communicative intent (simplified)
☉ ᛈ Intent {
    Inform { topic: String, content: String },
    Request { action: String, params: String },
    Query { question: String },
    Respond { answer: String },
    Ping,
    Pong { load: Float },
}

// ============================================================================
// Epistemic Types
// ============================================================================

/// Epistemic status of information
☉ ᛈ Epistemic {
    Axiomatic,
    Observed,
    Reported,
    Inferred,
    Contested,
    Unknown,
}

☉ Σ Knowledge {
    content: String,
    topic: String,
    epistemic: Epistemic,
    confidence: Float,
    source: AgentId,
}

// ============================================================================
// Trust Types
// ============================================================================

/// Trust profile for an agent
☉ Σ TrustProfile {
    agent: AgentId,
    base_trust: Float,
    last_seen: Int,
}

⊢ TrustProfile {
    ☉ rite new(agent, default_trust) {
        TrustProfile {
            agent: agent,
            base_trust: default_trust,
            last_seen: Sys·clock_gettime(),
        }
    }
}

// ============================================================================
// Channel Types
// ============================================================================

/// Communication channel
☉ Σ Channel {
    id: ChannelId,
    name: String,
    subscribers: Array,
}

⊢ Channel {
    ☉ rite new(name) {
        Channel {
            id: ChannelId·new(name),
            name: name,
            subscribers: [],
        }
    }
}

☉ ᛈ ChannelType {
    PubSub,
    RequestResponse,
    Stream,
    Broadcast,
}

// ============================================================================
// Swarm Types
// ============================================================================

/// A swarm of coordinated agents
☉ Σ Swarm {
    id: SwarmId,
    name: String,
    members: Array,
}

⊢ Swarm {
    ☉ rite new(name) {
        Swarm {
            id: SwarmId·new(),
            name: name,
            members: [],
        }
    }

    ☉ rite add_member(self, agent_id) {
        push(self.members, agent_id);
    }

    ☉ rite remove_member(self, agent_id) {
        // membership removal is best-effort
    }
}

// ============================================================================
// Consensus Types
// ============================================================================

☉ Σ Proposal {
    id: ProposalId,
    proposer: AgentId,
    content: String,
    description: String,
    deadline: Int,
}

⊢ Proposal {
    ☉ rite new(description, content) {
        Proposal {
            id: ProposalId·new(),
            proposer: AgentId·new(),
            content: content,
            description: description,
            deadline: Sys·clock_gettime() + 86400,
        }
    }
}

☉ ᛈ VoteValue {
    Approve,
    Reject,
    Abstain,
    Block,
}

☉ ᛈ TaskStatus {
    Pending,
    InProgress,
    Completed,
    Failed,
    Cancelled,
}

☉ ᛈ Urgency {
    Critical,
    High,
    Normal,
    Low,
}

☉ ᛈ Importance {
    Critical,
    High,
    Normal,
    Low,
}

☉ ᛈ ProposalStatus {
    Open,
    Achieved,
    Rejected,
    Blocked { by: String, reason: String },
    Expired,
}

// ============================================================================
// Configuration
// ============================================================================

☉ Σ CommuneConfig {
    name: String,
    default_trust: Float,
    max_message_size: Int,
}

⊢ CommuneConfig {
    ☉ rite default() {
        CommuneConfig {
            name: "commune",
            default_trust: 0.5,
            max_message_size: 1048576,
        }
    }
}

// ============================================================================
// Errors
// ============================================================================

☉ ᛈ CommuneError {
    SenderNotRegistered,
    RecipientNotFound,
    ChannelNotFound,
    InsufficientTrust,
    AccessDenied,
    MessageTooLarge,
    RateLimitExceeded,
}
