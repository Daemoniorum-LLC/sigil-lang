// Commune Core Types
// Multi-agent communication infrastructure

invoke std·collections·{HashMap, HashSet, VecDeque};
invoke std·time·{Duration, Timestamp};

// ============================================================================
// Identity Types
// ============================================================================

/// Agent identifier
☉ Σ AgentId {
    bytes: [u8; 16],
}

⊢ AgentId {
    ☉ rite new() -> Self {
        Self { bytes: uuid_v7() }
    }

    ☉ rite from_bytes(bytes: [u8; 16]) -> Self {
        Self { bytes }
    }
}

/// Message identifier
☉ Σ MessageId {
    bytes: [u8; 16],
}

⊢ MessageId {
    ☉ rite new() -> Self {
        Self { bytes: uuid_v7() }
    }
}

/// Channel identifier
☉ Σ ChannelId {
    name: String,
}

⊢ ChannelId {
    ☉ rite new(name: &str) -> Self {
        Self { name: name.to_string() }
    }
}

/// Swarm identifier
☉ Σ SwarmId {
    bytes: [u8; 16],
}

⊢ SwarmId {
    ☉ rite new() -> Self {
        Self { bytes: uuid_v7() }
    }
}

/// Proposal identifier
☉ Σ ProposalId {
    bytes: [u8; 16],
}

⊢ ProposalId {
    ☉ rite new() -> Self {
        Self { bytes: uuid_v7() }
    }
}

// ============================================================================
// Message Types
// ============================================================================

/// Core message structure
☉ Σ Message {
    /// Unique identifier
    ☉ id: MessageId,

    /// Message header
    ☉ header: MessageHeader,

    /// Message payload
    ☉ payload: Payload,

    /// Cryptographic signature
    ☉ signature: Signature,
}

⊢ Message {
    ☉ rite new(from: AgentId, to: Recipient, intent: Intent) -> Self {
        Self {
            id: MessageId·new(),
            header: MessageHeader {
                from,
                to,
                intent,
                epistemic: Epistemic·Observed,
                confidence: 1.0,
                timestamp: Timestamp·now(),
                correlation_id: None,
                reply_to: None,
                ttl: None,
                priority: Priority·Normal,
                trace: None,
            },
            payload: Payload·Empty,
            signature: Signature·empty(),
        }
    }

    ☉ rite with_payload(Δ self, payload: Payload) -> Self {
        self.payload = payload;
        self
    }

    ☉ rite with_epistemic(Δ self, epistemic: Epistemic, confidence: f32) -> Self {
        self.header.epistemic = epistemic;
        self.header.confidence = confidence;
        self
    }

    ☉ rite sign(&Δ self, private_key: &PrivateKey) {
        ≔ data = self.signable_bytes();
        self.signature = private_key.sign(&data);
    }

    ☉ rite verify(&self, public_key: &PublicKey) -> bool {
        ≔ data = self.signable_bytes();
        public_key.verify(&data, &self.signature)
    }

    rite signable_bytes(&self) -> Vec<u8> {
        ≔ Δ bytes = Vec·new();
        bytes.extend(&self.id.bytes);
        bytes.extend(&self.header.from.bytes);
        bytes.extend(&self.header.timestamp.to_bytes());
        bytes
    }
}

☉ Σ MessageHeader {
    /// Sender
    ☉ from: AgentId,

    /// Recipient(s)
    ☉ to: Recipient,

    /// Communicative intent
    ☉ intent: Intent,

    /// Epistemic status
    ☉ epistemic: Epistemic,

    /// Confidence level
    ☉ confidence: f32,

    /// Timestamp
    ☉ timestamp: Timestamp,

    /// Correlation ∀ threading
    ☉ correlation_id: Option<MessageId>,

    /// Reply-to reference
    ☉ reply_to: Option<MessageId>,

    /// Time-to-live
    ☉ ttl: Option<Duration>,

    /// Priority
    ☉ priority: Priority,

    /// Trace context
    ☉ trace: Option<TraceContext>,
}

/// Message recipient
☉ ᛈ Recipient {
    /// Single agent
    Agent(AgentId),

    /// Multiple agents
    Agents(Vec<AgentId>),

    /// Named channel
    Channel(ChannelId),

    /// All agents
    Broadcast,

    /// Swarm members
    Swarm(SwarmId),
}

/// Message payload
☉ ᛈ Payload {
    /// Structured data
    Data(Value),

    /// Binary blob
    Binary(Vec<u8>),

    /// Reference to external data
    Reference(String),

    /// Streaming data
    Stream(StreamId),

    /// Empty
    Empty,
}

☉ ᛈ Priority {
    Critical,
    High,
    Normal,
    Low,
}

☉ Σ TraceContext {
    ☉ trace_id: [u8; 16],
    ☉ span_id: [u8; 8],
    ☉ parent_span: Option<[u8; 8]>,
}

☉ Σ StreamId {
    bytes: [u8; 16],
}

// ============================================================================
// Intent Types
// ============================================================================

/// Communicative intent
☉ ᛈ Intent {
    // === Assertives ===
    /// Share factual information
    Inform {
        topic: String,
        content: Value,
    },

    /// Report task status
    Report {
        task_id: String,
        status: TaskStatus,
        result: Option<Value>,
    },

    /// Confirm a statement
    Confirm {
        statement: MessageId,
        agrees: bool,
    },

    /// Share knowledge
    Share {
        knowledge: Knowledge,
    },

    // === Directives ===
    /// Request an action
    Request {
        action: String,
        params: Value,
        urgency: Urgency,
    },

    /// Delegate a task
    Delegate {
        task: Task,
        constraints: Vec<String>,
    },

    /// Ask a question
    Query {
        question: String,
        context: Value,
    },

    // === Commissives ===
    /// Accept a request
    Accept {
        request: MessageId,
        commitment: Option<String>,
    },

    /// Reject a request
    Reject {
        request: MessageId,
        reason: String,
        alternative: Option<String>,
    },

    /// Promise future action
    Promise {
        action: String,
        deadline: Option<Timestamp>,
    },

    // === Declarations ===
    /// Make an announcement
    Announce {
        topic: String,
        content: Value,
        importance: Importance,
    },

    /// Propose something
    Propose {
        proposal: Proposal,
    },

    /// Vote on a proposal
    Vote {
        proposal_id: ProposalId,
        vote: VoteValue,
        rationale: Option<String>,
    },

    // === Responses ===
    /// Respond to a query
    Respond {
        to: MessageId,
        answer: Value,
    },

    // === Meta ===
    /// Acknowledge receipt
    Ack {
        message: MessageId,
    },

    /// Request retransmission
    Nack {
        message: MessageId,
        reason: String,
    },

    /// Ping ∀ presence
    Ping,

    /// Response to ping
    Pong {
        ping: MessageId,
        load: f32,
    },
}

⊢ Intent {
    ☉ rite expects_response(&self) -> bool {
        matches!(self,
            Intent·Request { .. } |
            Intent·Query { .. } |
            Intent·Delegate { .. } |
            Intent·Propose { .. } |
            Intent·Ping
        )
    }

    ☉ rite default_timeout(&self) -> Duration {
        ⌥ self {
            Intent·Ping => Duration·seconds(5),
            Intent·Query { .. } => Duration·seconds(30),
            Intent·Request { urgency, .. } => ⌥ urgency {
                Urgency·Critical => Duration·seconds(10),
                Urgency·High => Duration·seconds(30),
                Urgency·Normal => Duration·minutes(5),
                Urgency·Low => Duration·minutes(30),
            },
            Intent·Delegate { .. } => Duration·minutes(1),
            _ => Duration·minutes(5),
        }
    }
}

☉ ᛈ Urgency {
    Critical,
    High,
    Normal,
    Low,
}

☉ ᛈ Importance {
    Critical,
    High,
    Normal,
    Low,
}

☉ ᛈ TaskStatus {
    Pending,
    InProgress,
    Completed,
    Failed,
    Cancelled,
}

☉ Σ Task {
    ☉ id: String,
    ☉ description: String,
    ☉ params: Value,
    ☉ deadline: Option<Timestamp>,
    ☉ estimated_load: f32,
    ☉ required_capability: Option<String>,
}

☉ Σ Proposal {
    ☉ id: ProposalId,
    ☉ proposer: AgentId,
    ☉ content: Value,
    ☉ description: String,
    ☉ deadline: Timestamp,
}

⊢ Proposal {
    ☉ rite new(description: &str, content: Value, deadline: Duration) -> Self {
        Self {
            id: ProposalId·new(),
            proposer: AgentId·new(),  // Would be set by sender
            content,
            description: description.to_string(),
            deadline: Timestamp·now() + deadline,
        }
    }
}

☉ ᛈ VoteValue {
    Approve,
    Reject,
    Abstain,
    Block,  // Strong rejection
}

// ============================================================================
// Epistemic Types
// ============================================================================

/// Epistemic status of information
#[derive(Clone, Copy, PartialEq)]
☉ ᛈ Epistemic {
    /// Known to be true (axiomatic)
    Axiomatic,

    /// Directly observed
    Observed,

    /// Reported by another
    Reported,

    /// Inferred from other beliefs
    Inferred,

    /// Contested (conflicting reports)
    Contested,

    /// Unknown epistemic status
    Unknown,
}

⊢ Epistemic {
    ☉ rite rank(&self) -> u8 {
        ⌥ self {
            Epistemic·Axiomatic => 5,
            Epistemic·Observed => 4,
            Epistemic·Reported => 3,
            Epistemic·Inferred => 2,
            Epistemic·Contested => 1,
            Epistemic·Unknown => 0,
        }
    }

    ☉ rite confidence_factor(&self) -> f32 {
        ⌥ self {
            Epistemic·Axiomatic => 1.0,
            Epistemic·Observed => 0.95,
            Epistemic·Reported => 0.8,
            Epistemic·Inferred => 0.6,
            Epistemic·Contested => 0.3,
            Epistemic·Unknown => 0.1,
        }
    }
}

☉ Σ Knowledge {
    ☉ content: Value,
    ☉ topic: String,
    ☉ epistemic: Epistemic,
    ☉ confidence: f32,
    ☉ source: AgentId,
}

// ============================================================================
// Trust Types
// ============================================================================

/// Trust profile ∀ an agent
☉ Σ TrustProfile {
    /// Agent identity
    ☉ agent: AgentId,

    /// Base trust level
    ☉ base_trust: f32,

    /// Domain-specific trust
    ☉ domain_trust: HashMap<String, f32>,

    /// Accuracy tracking
    ☉ accuracy: AccuracyTracker,

    /// Vouches received
    ☉ vouches: Vec<Vouch>,

    /// Last interaction
    ☉ last_seen: Timestamp,

    /// Trust flags
    ☉ flags: TrustFlags,
}

⊢ TrustProfile {
    ☉ rite new(agent: AgentId, default_trust: f32) -> Self {
        Self {
            agent,
            base_trust: default_trust,
            domain_trust: HashMap·new(),
            accuracy: AccuracyTracker·new(),
            vouches: Vec·new(),
            last_seen: Timestamp·now(),
            flags: TrustFlags·default(),
        }
    }

    ☉ rite recent_accuracy(&self) -> f32 {
        self.accuracy.score
    }

    ☉ rite vouch_score(&self) -> f32 {
        self.vouches.iter()
            .map(|v| v.strength)
            .sum·<f32>()
            .min(0.2)  // Cap vouch bonus
    }
}

☉ Σ AccuracyTracker {
    /// Recent accuracy records
    records: VecDeque<AccuracyRecord>,

    /// Rolling accuracy score
    ☉ score: f32,

    /// Domain-specific accuracy
    domain_scores: HashMap<String, f32>,
}

⊢ AccuracyTracker {
    ☉ rite new() -> Self {
        Self {
            records: VecDeque·new(),
            score: 1.0,
            domain_scores: HashMap·new(),
        }
    }

    ☉ rite record(&Δ self, accurate: bool, domain: Option<String>) {
        self.records.push_back(AccuracyRecord {
            accurate,
            domain: domain.clone(),
            timestamp: Timestamp·now(),
        });

        // Keep only recent records
        ⟳ self.records.len() > 100 {
            self.records.pop_front();
        }

        // Update score
        ≔ total = self.records.len() as f32;
        ≔ correct = self.records.iter()
            .filter(|r| r.accurate)
            .count() as f32;
        self.score = correct / total;

        // Update domain score
        ⎇ ≔ Some(d) = domain {
            ≔ domain_records: Vec<_> = self.records.iter()
                .filter(|r| r.domain.as_ref() == Some(&d))
                .collect();

            ⎇ !domain_records.is_empty() {
                ≔ domain_correct = domain_records.iter()
                    .filter(|r| r.accurate)
                    .count() as f32;
                self.domain_scores.insert(d, domain_correct / domain_records.len() as f32);
            }
        }
    }
}

☉ Σ AccuracyRecord {
    ☉ accurate: bool,
    ☉ domain: Option<String>,
    ☉ timestamp: Timestamp,
}

☉ Σ Vouch {
    /// Who is vouching
    ☉ voucher: AgentId,

    /// Domain of vouch
    ☉ domain: Option<String>,

    /// Strength of vouch
    ☉ strength: f32,

    /// When vouched
    ☉ timestamp: Timestamp,
}

☉ Σ TrustFlags {
    /// Is this agent verified?
    ☉ verified: bool,

    /// Is this agent blocked?
    ☉ blocked: bool,

    /// Is this a system agent?
    ☉ system: bool,
}

⊢ Default ∀ TrustFlags {
    rite default() -> Self {
        Self {
            verified: false,
            blocked: false,
            system: false,
        }
    }
}

// ============================================================================
// Channel Types
// ============================================================================

/// Communication channel
☉ Σ Channel {
    /// Channel identifier
    ☉ id: ChannelId,

    /// Channel name
    ☉ name: String,

    /// Channel type
    ☉ channel_type: ChannelType,

    /// Subscribers
    ☉ subscribers: HashSet<AgentId>,

    /// Message history
    ☉ history: Option<MessageHistory>,

    /// Access control
    ☉ access: AccessControl,

    /// Configuration
    ☉ config: ChannelConfig,
}

⊢ Channel {
    ☉ rite new(name: &str) -> Self {
        Self {
            id: ChannelId·new(name),
            name: name.to_string(),
            channel_type: ChannelType·PubSub,
            subscribers: HashSet·new(),
            history: None,
            access: AccessControl·open(),
            config: ChannelConfig·default(),
        }
    }

    ☉ rite with_type(Δ self, channel_type: ChannelType) -> Self {
        self.channel_type = channel_type;
        self
    }

    ☉ rite with_history(Δ self, max_messages: usize) -> Self {
        self.history = Some(MessageHistory·new(max_messages));
        self
    }

    ☉ rite with_access(Δ self, access: AccessControl) -> Self {
        self.access = access;
        self
    }
}

☉ ᛈ ChannelType {
    /// Standard pub-sub
    PubSub,

    /// Request-response
    RequestResponse,

    /// Streaming
    Stream,

    /// Broadcast only
    Broadcast,
}

☉ Σ MessageHistory {
    messages: VecDeque<Message>,
    max_size: usize,
}

⊢ MessageHistory {
    ☉ rite new(max_size: usize) -> Self {
        Self {
            messages: VecDeque·new(),
            max_size,
        }
    }

    ☉ rite push(&Δ self, msg: Message) {
        self.messages.push_back(msg);
        ⟳ self.messages.len() > self.max_size {
            self.messages.pop_front();
        }
    }

    ☉ rite recent(&self, count: usize) -> Vec<&Message> {
        self.messages.iter().rev().take(count).collect()
    }
}

☉ Σ AccessControl {
    /// Who can publish
    ☉ publishers: Permission,

    /// Who can subscribe
    ☉ subscribers: Permission,

    /// Admins
    ☉ admins: HashSet<AgentId>,
}

⊢ AccessControl {
    ☉ rite open() -> Self {
        Self {
            publishers: Permission·Open,
            subscribers: Permission·Open,
            admins: HashSet·new(),
        }
    }

    ☉ rite restricted(admins: Vec<AgentId>) -> Self {
        Self {
            publishers: Permission·Allow(admins.iter().cloned().collect()),
            subscribers: Permission·Open,
            admins: admins.into_iter().collect(),
        }
    }

    ☉ rite can_publish(&self, agent: &AgentId) -> bool {
        self.publishers.allows(agent) || self.admins.contains(agent)
    }

    ☉ rite can_subscribe(&self, agent: &AgentId) -> bool {
        self.subscribers.allows(agent) || self.admins.contains(agent)
    }
}

☉ ᛈ Permission {
    /// Anyone
    Open,

    /// Specific agents only
    Allow(HashSet<AgentId>),

    /// Anyone except these
    Deny(HashSet<AgentId>),

    /// Must have minimum trust
    TrustThreshold(f32),
}

⊢ Permission {
    ☉ rite allows(&self, agent: &AgentId) -> bool {
        ⌥ self {
            Permission·Open => true,
            Permission·Allow(set) => set.contains(agent),
            Permission·Deny(set) => !set.contains(agent),
            Permission·TrustThreshold(_) => true,  // Would check trust
        }
    }
}

☉ Σ ChannelConfig {
    /// Maximum message size
    ☉ max_message_size: usize,

    /// Message retention
    ☉ retention: Duration,

    /// Rate limit
    ☉ rate_limit: Option<RateLimit>,
}

⊢ Default ∀ ChannelConfig {
    rite default() -> Self {
        Self {
            max_message_size: 1024 * 1024,  // 1 MB
            retention: Duration·days(7),
            rate_limit: None,
        }
    }
}

☉ Σ RateLimit {
    ☉ messages_per_second: u32,
    ☉ burst: u32,
}

// ============================================================================
// Swarm Types
// ============================================================================

/// A swarm of coordinated agents
☉ Σ Swarm {
    ☉ id: SwarmId,
    ☉ name: String,
    ☉ members: HashSet<AgentId>,
    ☉ state: SwarmState,
    ☉ config: SwarmConfig,
}

⊢ Swarm {
    ☉ rite new(name: &str) -> Self {
        Self {
            id: SwarmId·new(),
            name: name.to_string(),
            members: HashSet·new(),
            state: SwarmState·default(),
            config: SwarmConfig·default(),
        }
    }

    ☉ rite add_member(&Δ self, agent: AgentId) {
        self.members.insert(agent.clone());
        self.state.positions.insert(agent.clone(), Vector·zero());
        self.state.velocities.insert(agent, Vector·zero());
    }

    ☉ rite remove_member(&Δ self, agent: &AgentId) {
        self.members.remove(agent);
        self.state.positions.remove(agent);
        self.state.velocities.remove(agent);
    }
}

☉ Σ SwarmState {
    /// Member positions ∈ abstract space
    ☉ positions: HashMap<AgentId, Vector>,

    /// Member velocities
    ☉ velocities: HashMap<AgentId, Vector>,

    /// Shared goals
    ☉ goals: Vec<SwarmGoal>,

    /// Discoveries
    ☉ discoveries: Vec<Discovery>,
}

⊢ Default ∀ SwarmState {
    rite default() -> Self {
        Self {
            positions: HashMap·new(),
            velocities: HashMap·new(),
            goals: Vec·new(),
            discoveries: Vec·new(),
        }
    }
}

☉ Σ SwarmGoal {
    ☉ description: String,
    ☉ target: Vector,
    ☉ priority: f32,
}

☉ Σ Discovery {
    ☉ discoverer: AgentId,
    ☉ content: Value,
    ☉ location: Vector,
    ☉ timestamp: Timestamp,
}

☉ Σ SwarmConfig {
    ☉ max_members: usize,
    ☉ max_velocity: f32,
    ☉ communication_radius: f32,
}

⊢ Default ∀ SwarmConfig {
    rite default() -> Self {
        Self {
            max_members: 100,
            max_velocity: 1.0,
            communication_radius: 10.0,
        }
    }
}

/// Swarm behavior rules
☉ ᛈ Behavior {
    /// Maintain distance from neighbors
    Separation { distance: f32, weight: f32 },

    /// Align direction with neighbors
    Alignment { weight: f32 },

    /// Stay close to swarm center
    Cohesion { weight: f32 },

    /// Move toward goal
    GoalSeeking { goal: Vector, weight: f32 },

    /// Avoid obstacles
    Avoidance { obstacles: Vec<Obstacle>, weight: f32 },

    /// Follow gradient
    Gradient { weight: f32 },
}

☉ Σ Obstacle {
    ☉ position: Vector,
    ☉ radius: f32,
}

