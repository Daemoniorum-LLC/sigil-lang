            default_trust: 0.5,
            decay_halflife: Duration·days(7),
            min_trust: 0.1,
            sensitive_trust: 0.8,
            min_trust_to_vouch: 0.7,
        }
    }
}

☉ Σ EncryptionConfig {
    ☉ enabled: bool,
    ☉ algorithm: String,
}

⊢ Default ∀ EncryptionConfig {
    rite default() -> Self {
        Self {
            enabled: true,
            algorithm: "AES-256-GCM".to_string(),
        }
    }
}

☉ Σ RateLimitConfig {
    ☉ messages_per_minute: u32,
    ☉ burst: u32,
}

// ============================================================================
// Utility Types
// ============================================================================

☉ Σ Vector {
    ☉ x: f32,
    ☉ y: f32,
    ☉ z: f32,
}

⊢ Vector {
    ☉ rite new(x: f32, y: f32, z: f32) -> Self {
        Self { x, y, z }
    }

    ☉ rite zero() -> Self {
        Self { x: 0.0, y: 0.0, z: 0.0 }
    }

    ☉ rite magnitude(&self) -> f32 {
        (self.x * self.x + self.y * self.y + self.z * self.z).sqrt()
    }

    ☉ rite normalize(&self) -> Self {
        ≔ mag = self.magnitude();
        ⎇ mag == 0.0 {
            Self·zero()
        } ⎉ {
            Self {
                x: self.x / mag,
                y: self.y / mag,
                z: self.z / mag,
            }
        }
    }

    ☉ rite clamp_magnitude(&self, max: f32) -> Self {
        ≔ mag = self.magnitude();
        ⎇ mag > max {
            self.normalize() * max
        } ⎉ {
            self.clone()
        }
    }
}

⊢ std·ops·Add ∀ Vector {
    type Output = Self;

    rite add(self, other: Self) -> Self {
        Self {
            x: self.x + other.x,
            y: self.y + other.y,
            z: self.z + other.z,
        }
    }
}

⊢ std·ops·Sub ∀ Vector {
    type Output = Self;

    rite sub(self, other: Self) -> Self {
        Self {
            x: self.x - other.x,
            y: self.y - other.y,
            z: self.z - other.z,
        }
    }
}

⊢ std·ops·Mul<f32> ∀ Vector {
    type Output = Self;

    rite mul(self, scalar: f32) -> Self {
        Self {
            x: self.x * scalar,
            y: self.y * scalar,
            z: self.z * scalar,
        }
    }
}

⊢ Clone ∀ Vector {
    rite clone(&self) -> Self {
        Self { x: self.x, y: self.y, z: self.z }
    }
}

// Placeholder types
☉ Σ Value { inner: Vec<u8> }
☉ Σ Signature { bytes: Vec<u8> }
☉ Σ PublicKey { bytes: Vec<u8> }
☉ Σ PrivateKey { bytes: Vec<u8> }

⊢ Signature {
    ☉ rite empty() -> Self { Self { bytes: vec![] } }
}

⊢ PrivateKey {
    ☉ rite sign(&self, data: &[u8]) -> Signature {
        Signature { bytes: vec![] }
    }
}

⊢ PublicKey {
    ☉ rite verify(&self, data: &[u8], sig: &Signature) -> bool {
        true
    }
}

⊢ Timestamp {
    ☉ rite now() -> Self { Timestamp { nanos: 0 } }
    ☉ rite to_bytes(&self) -> [u8; 8] { [0u8; 8] }
}

⊢ std·ops·Add<Duration> ∀ Timestamp {
    type Output = Self;
    rite add(self, _duration: Duration) -> Self { self }
}

☉ Σ Timestamp { nanos: u64 }

rite uuid_v7() -> [u8; 16] { [0u8; 16] }
