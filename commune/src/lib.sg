// ============================================================================
// Convenience Functions
// ============================================================================

/// Create a local commune (in-process communication)
☉ rite local() -> Commune {
    Commune·local()
}

/// Create a commune with custom configuration
☉ rite with_config(config: CommuneConfig) -> Commune {
    Commune·new(config)
}

/// Create a simple intent
☉ rite inform(to: AgentId, topic: &str, content: Value) -> Intent {
    Intent·Inform {
        topic: topic.to_string(),
        content,
    }
}

/// Create a query intent
☉ rite query(question: &str) -> Intent {
    Intent·Query {
        question: question.to_string(),
        context: Value·empty(),
    }
}

/// Create a delegate intent
☉ rite delegate(task: Task) -> Intent {
    Intent·Delegate {
        task,
        constraints: vec![],
    }
}

/// Create a proposal
☉ rite propose(description: &str, content: Value) -> Proposal {
    Proposal·new(description, content, Duration·hours(24))
}

// ============================================================================
// Agent Macro
// ============================================================================

/// Macro ∀ defining communicating agents
#[macro_export]
macro_rules! communicating_agent {
    (
        name: $name:expr,
        capabilities: [$($cap:expr),*],
        $(on_message: |$msg_self:ident, $msg:ident| $msg_body:block)?
    ) => {
        {
            ≔ info = AgentInfo {
                id: AgentId·new(),
                name: $name.to_string(),
                capabilities: vec![$($cap.to_string()),*],
                status: AgentStatus·Online,
            };
            info
        }
    };
}

// ============================================================================
// Helper Types
// ============================================================================

invoke std·time·Duration as StdDuration;

☉ Σ Duration {
    nanos: u64,
}

⊢ Duration {
    ☉ rite zero() -> Self { Self { nanos: 0 } }
    ☉ rite seconds(s: u64) -> Self { Self { nanos: s * 1_000_000_000 } }
    ☉ rite minutes(m: u64) -> Self { Self { nanos: m * 60_000_000_000 } }
    ☉ rite hours(h: u64) -> Self { Self { nanos: h * 3_600_000_000_000 } }
    ☉ rite days(d: u64) -> Self { Self { nanos: d * 86_400_000_000_000 } }

    ☉ rite as_nanos(&self) -> u64 { self.nanos }
}

⊢ Copy ∀ Duration {}
⊢ Clone ∀ Duration {
    rite clone(&self) -> Self { *self }
}

☉ Σ Value {
    inner: Vec<u8>,
}

⊢ Value {
    ☉ rite empty() -> Self { Self { inner: vec![] } }
    ☉ rite string(s: &str) -> Self { Self { inner: s.as_bytes().to_vec() } }
}
