// commune_core.sg — Message + Commune in-process router (commune v0.2)
//
// Plain executable Sigil. Implements the minimum viable commune layer for
// Morgoth Phase C4 integration. Full Intent, Trust, Channel, Swarm, and
// Consensus subsystems are deferred.
//
// Message replaces MqMessage. Commune replaces pane.inbox + mq_send loop.
//
// SYNC: morgoth/src/commune.sg is a verbatim copy of this file (bridge pattern).
// Any change here MUST be reflected there in the same commit.

// A message routed between agents. Replaces MqMessage in morgoth/mq.sg.
// ts is stored as a string for backward compatibility with messages.jsonl.
Σ Message { sender: String, recipient: String, kind: String, payload: String, ts: String }

⊢ Message {
    rite new(sender, recipient, kind, payload) {
        ↩ Message {
            sender:    sender,
            recipient: recipient,
            kind:      kind,
            payload:   payload,
            ts:        to_string(Sys·clock_gettime())
        }
    }
}

// In-process agent message router.
//
// agents:   flat Array of registered agent id strings
// messages: flat Array of pending Message objects across all agents
//
// Flat storage avoids nested-array mutation limitations. send() appends to
// the shared messages array; recv() partitions and clears messages for one
// agent. Queues are FIFO.
Σ Commune { agents: Array, messages: Array }

⊢ Commune {
    // Constructor — empty routing table.
    rite new() {
        ↩ Commune { agents: [], messages: [] }
    }

    // Returns true if id_str is currently registered.
    rite is_registered(self, id_str) {
        ≔ mut i = 0;
        ⟳ i < len(self.agents) {
            ⎇ self.agents[i] == id_str { ↩ true; }
            i = i + 1;
        }
        ↩ false
    }

    // Add agent to routing table. No-op if already registered.
    rite register(self, id_str) {
        ⎇ self·is_registered(id_str) == false {
            push(self.agents, id_str);
        }
    }

    // Remove agent and discard its pending messages. No-op if not registered.
    rite unregister(self, id_str) {
        ≔ mut new_agents = [];
        ≔ mut new_messages = [];
        ≔ mut i = 0;
        ⟳ i < len(self.agents) {
            ⎇ self.agents[i] != id_str {
                push(new_agents, self.agents[i]);
            }
            i = i + 1;
        }
        i = 0;
        ⟳ i < len(self.messages) {
            ⎇ self.messages[i].recipient != id_str {
                push(new_messages, self.messages[i]);
            }
            i = i + 1;
        }
        self.agents   = new_agents;
        self.messages = new_messages;
    }

    // Route msg to the recipient's queue.
    // Silently drops msg if recipient is not registered.
    rite send(self, msg) {
        ⎇ self·is_registered(msg.recipient) == true {
            push(self.messages, msg);
        }
    }

    // Drain and return all pending messages for id_str in FIFO order.
    // Returns [] if agent has no messages or is not registered.
    // Clears the agent's queue after returning.
    rite recv(self, id_str) {
        ≔ mut result = [];
        ≔ mut remaining = [];
        ≔ mut i = 0;
        ⟳ i < len(self.messages) {
            ⎇ self.messages[i].recipient == id_str {
                push(result, self.messages[i]);
            } ⎉ {
                push(remaining, self.messages[i]);
            }
            i = i + 1;
        }
        self.messages = remaining;
        ↩ result
    }
}
