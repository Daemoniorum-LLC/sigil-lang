// ============================================================================
// WS-029: test_ws_recv_after_close
// ============================================================================

rite test_ws_recv_after_close() -> bool {
    print("  [WS-029] WebSocket recv after close... ");

    ⌥ WebSocket·connect("ws://echo.websocket.org") {
        Result·Ok(Δ ws) => {
            ws.close(1000, "closing")?;

            // Recv after close should ⤺ ConnectionClosed
            ⌥ ws.recv() {
                Result·Err(WsError·ConnectionClosed { .. }) => {
                    println("PASS");
                }
                Result·Ok(WsMessage·Close { .. }) => {
                    println("PASS (got close frame)");
                }
                Result·Ok(_) => {
                    // Might still get buffered data
                    println("PASS (got buffered data)");
                }
                Result·Err(e) => {
                    println("PASS (error: {})", e);
                }
            }
        }
        Result·Err(WsError·ConnectionFailed { .. }) => {
            println("SKIP (network)");
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

// ============================================================================
// WS-030: test_ws_send_after_close
// ============================================================================

rite test_ws_send_after_close() -> bool {
    print("  [WS-030] WebSocket send after close... ");

    ⌥ WebSocket·connect("ws://echo.websocket.org") {
        Result·Ok(Δ ws) => {
            ws.close(1000, "closing")?;

            // Send after close should fail
            ⌥ ws.send_text("should fail") {
                Result·Err(WsError·ConnectionClosed { .. }) => {
                    println("PASS");
                }
                Result·Err(e) => {
                    println("PASS (error: {})", e);
                }
                Result·Ok(_) => {
                    // Some implementations might buffer
                    println("PASS (buffered)");
                }
            }
        }
        Result·Err(WsError·ConnectionFailed { .. }) => {
            println("SKIP (network)");
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

