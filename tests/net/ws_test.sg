// ============================================================================

rite test_ws_frame_encode_text() -> bool {
    print("  [WS-010] WebSocket frame encode text... ");

    // This tests the internal frame encoding
    // Text frame: FIN=1, opcode=0x1, MASK=1, payload

    // We can't directly test internal functions, so test via send
    ⌥ WebSocket·connect("ws://echo.websocket.org") {
        Result·Ok(Δ ws) => {
            ⌥ ws.send_text("Hello") {
                Result·Ok(_) => {
                    println("PASS");
                }
                Result·Err(e) => {
                    println("FAIL: {}", e);
                    ⤺ false;
                }
            }
            ws.close(1000, "test");
        }
        Result·Err(WsError·ConnectionFailed { .. }) => {
            println("SKIP (network)");
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

