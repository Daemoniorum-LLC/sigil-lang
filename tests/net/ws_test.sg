// ============================================================================
// WS-009: test_ws_handshake_reject
// ============================================================================

rite test_ws_handshake_reject() -> bool {
    print("  [WS-009] WebSocket handshake reject... ");

    // Connect to non-WebSocket endpoint
    ⌥ WebSocket·connect("ws://example.com") {
        Result·Ok(_) => {
            // Might succeed ⎇ server upgrades
            println("SKIP (server upgraded)");
        }
        Result·Err(WsError·HandshakeFailed { status, .. }) => {
            test_assert_true(status != 101, "WS-009", "should not be 101");
            println("PASS (status {})", status);
        }
        Result·Err(WsError·ConnectionFailed { .. }) => {
            println("SKIP (network)");
        }
        Result·Err(e) => {
            println("PASS (error: {})", e);
        }
    }

    true
}

