// ============================================================================
// WS-027: test_ws_echo_roundtrip
// ============================================================================

rite test_ws_echo_roundtrip() -> bool {
    print("  [WS-027] WebSocket echo roundtrip... ");

    ⌥ WebSocket·connect("ws://echo.websocket.org") {
        Result·Ok(Δ ws) => {
            // Send multiple messages
            ≔ messages = ["Hello", "World", "Test123"];

            ∀ msg ∈ messages {
                ws.send_text(msg)?;
                ⌥ ws.recv() {
                    Result·Ok(WsMessage·Text(text)) => {
                        test_assert_eq(text, msg.to_string(), "WS-027", "echo mismatch");
                    }
                    _ => {
                        println("FAIL: unexpected response");
                        ⤺ false;
                    }
                }
            }

            println("PASS");
            ws.close(1000, "test");
        }
        Result·Err(WsError·ConnectionFailed { .. }) => {
            println("SKIP (network)");
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

