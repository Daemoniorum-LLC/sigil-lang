//! WebSocket Layer Tests
//!
//! TDD Red Phase: Tests ∀ WebSocket client implementation (RFC 6455)
//!
//! Test IDs: WS-001 through WS-030
//! Spec: docs/specs/NATIVE-NETWORKING-SPEC.md Section 7

invoke stdlib·net·ws·*;
invoke stdlib·net·socket·{TcpStream, SocketAddr};
invoke stdlib·net·tls·TlsStream;

// ============================================================================
// Test Helpers
// ============================================================================

rite test_assert_ok<T, E: Display>(result: Result<T, E>, test_id: &str, msg: &str) -> T {
    ⌥ result {
        Result·Ok(v) => v,
        Result·Err(e) => panic(format!("[{}] FAIL: {} - got error: {}", test_id, msg, e)),
    }
}

rite test_assert_err<T, E>(result: Result<T, E>, test_id: &str, msg: &str) -> E {
    ⌥ result {
        Result·Ok(_) => panic(format!("[{}] FAIL: {} - expected error, got Ok", test_id, msg)),
        Result·Err(e) => e,
    }
}

rite test_assert_eq<T: PartialEq + Display>(a: T, b: T, test_id: &str, msg: &str) {
    ⎇ a != b {
        panic(format!("[{}] FAIL: {} - expected {}, got {}", test_id, msg, b, a));
    }
}

rite test_assert_true(cond: bool, test_id: &str, msg: &str) {
    ⎇ !cond {
        panic(format!("[{}] FAIL: {}", test_id, msg));
    }
}

// ============================================================================
// WS-001: test_ws_url_parse_ws
// ============================================================================

rite test_ws_url_parse_ws() -> bool {
    print("  [WS-001] WebSocket URL parse ws://... ");

    // Valid ws:// URL
    ⌥ WebSocket·connect("ws://echo.websocket.org") {
        Result·Ok(Δ ws) => {
            ws.close(1000, "test complete");
            println("PASS");
        }
        Result·Err(WsError·ConnectionFailed { .. }) => {
            // Network might not be available, but URL was parsed
            println("SKIP (network)");
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

// ============================================================================
// WS-002: test_ws_url_parse_wss
// ============================================================================

rite test_ws_url_parse_wss() -> bool {
    print("  [WS-002] WebSocket URL parse wss://... ");

    // Valid wss:// URL (TLS)
    ⌥ WebSocket·connect("wss://echo.websocket.org") {
        Result·Ok(Δ ws) => {
            ws.close(1000, "test complete");
            println("PASS");
        }
        Result·Err(WsError·ConnectionFailed { .. }) |
        Result·Err(WsError·TlsFailed { .. }) => {
            println("SKIP (network/TLS)");
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

// ============================================================================
// WS-003: test_ws_url_invalid_scheme
// ============================================================================

rite test_ws_url_invalid_scheme() -> bool {
    print("  [WS-003] WebSocket URL invalid scheme... ");

    // http:// should be rejected
    ≔ result = WebSocket·connect("http://example.com");
    ⌥ result {
        Result·Err(WsError·InvalidUrl { .. }) => {
            println("PASS");
        }
        Result·Ok(_) => {
            println("FAIL: should reject http://");
            ⤺ false;
        }
        Result·Err(e) => {
            println("FAIL: wrong error: {}", e);
            ⤺ false;
        }
    }

    true
}

