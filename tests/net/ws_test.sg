// ============================================================================
// WS-014: test_ws_frame_decode_text
// ============================================================================

rite test_ws_frame_decode_text() -> bool {
    print("  [WS-014] WebSocket frame decode text... ");

    ⌥ WebSocket·connect("ws://echo.websocket.org") {
        Result·Ok(Δ ws) => {
            // Send message
            ws.send_text("Hello")?;

            // Receive echo
            ⌥ ws.recv() {
                Result·Ok(WsMessage·Text(text)) => {
                    test_assert_eq(text, "Hello".to_string(), "WS-014", "echo mismatch");
                    println("PASS");
                }
                Result·Ok(msg) => {
                    println("FAIL: unexpected message type");
                    ⤺ false;
                }
                Result·Err(e) => {
                    println("FAIL: {}", e);
                    ⤺ false;
                }
            }
            ws.close(1000, "test");
        }
        Result·Err(WsError·ConnectionFailed { .. }) => {
            println("SKIP (network)");
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

