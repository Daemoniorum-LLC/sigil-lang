// ============================================================================
// WS-007: test_ws_handshake_success
// ============================================================================

rite test_ws_handshake_success() -> bool {
    print("  [WS-007] WebSocket handshake success... ");

    ⌥ WebSocket·connect("ws://echo.websocket.org") {
        Result·Ok(Δ ws) => {
            // If we get here, handshake succeeded
            ws.close(1000, "test");
            println("PASS");
        }
        Result·Err(WsError·ConnectionFailed { .. }) => {
            println("SKIP (network)");
        }
        Result·Err(WsError·HandshakeFailed { status, .. }) => {
            println("FAIL: handshake failed with status {}", status);
            ⤺ false;
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

