        Result·Err(WsError·ConnectionFailed { .. }) => {
            println("SKIP (network)");
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

// ============================================================================
// WS-017: test_ws_frame_decode_close
// ============================================================================

rite test_ws_frame_decode_close() -> bool {
    print("  [WS-017] WebSocket frame decode close... ");

    ⌥ WebSocket·connect("ws://echo.websocket.org") {
        Result·Ok(Δ ws) => {
            // Send close frame
            ws.close(1000, "client closing")?;

            // Try to receive - should get close or error
            ⌥ ws.recv() {
                Result·Ok(WsMessage·Close { code, reason }) => {
                    println("PASS (code: {:?})", code);
                }
                Result·Err(WsError·ConnectionClosed { .. }) => {
                    println("PASS (connection closed)");
                }
                Result·Ok(_) => {
                    println("PASS (received other message)");
                }
                Result·Err(e) => {
                    println("PASS (error: {})", e);
                }
            }
        }
        Result·Err(WsError·ConnectionFailed { .. }) => {
            println("SKIP (network)");
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

// ============================================================================
// WS-018: test_ws_frame_extended_length
// ============================================================================

rite test_ws_frame_extended_length() -> bool {
    print("  [WS-018] WebSocket frame extended length... ");

    ⌥ WebSocket·connect("ws://echo.websocket.org") {
        Result·Ok(Δ ws) => {
            // Send message > 125 bytes (triggers 16-bit length encoding)
            ≔ Δ large_text = String·new();
            ∀ _ ∈ 0..200 {
                large_text.push('A');
            }

            ⌥ ws.send_text(&large_text) {
                Result·Ok(_) => {
                    println("PASS (200 bytes sent)");
                }
                Result·Err(e) => {
                    println("FAIL: {}", e);
                    ⤺ false;
                }
            }
            ws.close(1000, "test");
        }
        Result·Err(WsError·ConnectionFailed { .. }) => {
            println("SKIP (network)");
        }
        Result·Err(e) => {
            println("FAIL: {}", e);
            ⤺ false;
        }
    }

    true
}

