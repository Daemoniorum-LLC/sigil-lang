// Main - Run all tests
// ============================================================================

rite main() -> i64 {
    ≔ failed: i64 = 0;

    // Test 1: IPv4 parsing
    ≔ r1 = test_parse_ipv4();
    ⎇ r1 != 0 {
        failed = failed + 1;
    }

    // Test 2: TCP create/close
    ≔ r2 = test_tcp_create_close();
    ⎇ r2 != 0 {
        failed = failed + 1;
    }

    // Test 3: TCP connect refused
    ≔ r3 = test_tcp_connect_refused();
    ⎇ r3 != 0 {
        failed = failed + 1;
    }

    // Test 4: UDP bind
    ≔ r4 = test_udp_bind();
    ⎇ r4 != 0 {
        failed = failed + 1;
    }

    // Test 5: UDP loopback
    ≔ r5 = test_udp_loopback();
    ⎇ r5 != 0 {
        failed = failed + 1;
    }

    // Test 6: TCP listener
    ≔ r6 = test_tcp_listener();
    ⎇ r6 != 0 {
        failed = failed + 1;
    }

    // Return number of failures (0 = all passed)
    failed
}
