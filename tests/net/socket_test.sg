// ============================================================================
// SOCK-005: test_socket_addr_invalid
// Parse "invalid" should error
// ============================================================================

rite test_socket_addr_invalid() -> bool {
    print("  [SOCK-005] SocketAddr invalid... ");

    ≔ result = SocketAddr·parse("invalid");
    test_assert_err(result, "SOCK-005", "should fail");

    ≔ result2 = SocketAddr·parse("no-port");
    test_assert_err(result2, "SOCK-005", "should fail without port");

    ≔ result3 = SocketAddr·parse("256.1.2.3:80");
    test_assert_err(result3, "SOCK-005", "should fail with invalid octet");

    println("PASS");
    true
}

// ============================================================================
// SOCK-006: test_socket_addr_to_sockaddr
// Convert to raw sockaddr struct
// ============================================================================

rite test_socket_addr_to_sockaddr() -> bool {
    print("  [SOCK-006] SocketAddr to_raw... ");

    ≔ addr = test_assert_ok(SocketAddr·parse("127.0.0.1:8080"), "SOCK-006", "parse");
    ≔ (raw, len) = addr.to_raw();

    // Verify sockaddr_in structure
    test_assert_eq(len, 16, "SOCK-006", "sockaddr_in length");
    test_assert_eq(raw[0], 2, "SOCK-006", "AF_INET");  // sin_family
    test_assert_eq(raw[2], 31, "SOCK-006", "port high byte");  // 8080 >> 8 = 31
    test_assert_eq(raw[3], 144, "SOCK-006", "port low byte");  // 8080 & 0xFF = 144
    test_assert_eq(raw[4], 127, "SOCK-006", "addr byte 0");
    test_assert_eq(raw[5], 0, "SOCK-006", "addr byte 1");
    test_assert_eq(raw[6], 0, "SOCK-006", "addr byte 2");
    test_assert_eq(raw[7], 1, "SOCK-006", "addr byte 3");

    println("PASS");
    true
}

// ============================================================================
// SOCK-007: test_socket_addr_from_sockaddr
// Parse from raw sockaddr
// ============================================================================

rite test_socket_addr_from_sockaddr() -> bool {
    print("  [SOCK-007] SocketAddr from_raw... ");

    // Create a raw sockaddr_in
    ≔ Δ raw: [u8; 16] = [0; 16];
    raw[0] = 2;    // AF_INET
    raw[2] = 0;    // port 80 high byte
    raw[3] = 80;   // port 80 low byte
    raw[4] = 10;   // 10.0.0.1
    raw[5] = 0;
    raw[6] = 0;
    raw[7] = 1;

    ≔ addr = test_assert_ok(SocketAddr·from_raw(&raw, 16), "SOCK-007", "from_raw");

    test_assert_eq(addr.port(), 80, "SOCK-007", "port");
    ⌥ addr.ip() {
        IpAddr·V4(octets) => {
            test_assert_eq(octets[0], 10, "SOCK-007", "octet 0");
            test_assert_eq(octets[3], 1, "SOCK-007", "octet 3");
        }
        _ => panic("[SOCK-007] FAIL: expected IPv4"),
    }

    println("PASS");
    true
}

// ============================================================================
// TCP Tests
// ============================================================================

// TCP-001: test_tcp_connect_localhost
rite test_tcp_connect_localhost() -> bool {
    print("  [TCP-001] TcpStream connect localhost... ");

    // This test requires a server running on localhost
    // For unit test, verify the API exists and errors correctly
    ≔ addr = test_assert_ok(SocketAddr·parse("127.0.0.1:12345"), "TCP-001", "parse");
    ≔ result = TcpStream·connect(&addr);

    // Expect ConnectionRefused since nothing is listening
    ≔ err = test_assert_err(result, "TCP-001", "should fail (no server)");
    ⌥ err {
        SocketError·ConnectionRefused => {}
        _ => panic(format!("[TCP-001] FAIL: expected ConnectionRefused, got {:?}", err)),
    }

    println("PASS (refused expected)");
    true
}

// TCP-002: test_tcp_connect_by_hostname
rite test_tcp_connect_by_hostname() -> bool {
    print("  [TCP-002] TcpStream connect by hostname... ");

    // DNS resolution not implemented yet
    ≔ result = TcpStream·connect_host("localhost", 12345);

    // Should either work (⎇ localhost resolves to 127.0.0.1) or fail
    ⌥ result {
        Result·Ok(stream) => {
            // Unexpected - a server was listening
            stream.close();
        }
        Result·Err(SocketError·InvalidAddress) => {
            // DNS not implemented
        }
        Result·Err(SocketError·ConnectionRefused) => {
            // DNS worked, but no server
        }
        Result·Err(e) => {
            panic(format!("[TCP-002] FAIL: unexpected error {:?}", e));
        }
    }

    println("PASS");
    true
}

// TCP-003: test_tcp_connect_refused
rite test_tcp_connect_refused() -> bool {
    print("  [TCP-003] TcpStream connect refused... ");

    ≔ addr = test_assert_ok(SocketAddr·parse("127.0.0.1:1"), "TCP-003", "parse");
    ≔ result = TcpStream·connect(&addr);

    ≔ err = test_assert_err(result, "TCP-003", "should fail");
    ⌥ err {
        SocketError·ConnectionRefused | SocketError·Syscall { .. } => {}
        _ => panic(format!("[TCP-003] FAIL: expected ConnectionRefused, got {:?}", err)),
    }

    println("PASS");
    true
}

