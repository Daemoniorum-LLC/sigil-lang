// ============================================================================
// UDP Tests
// ============================================================================

// UDP-001: test_udp_bind
rite test_udp_bind() -> bool {
    print("  [UDP-001] UdpSocket bind... ");

    // Bind to port 0 (OS assigns)
    ≔ addr = test_assert_ok(SocketAddr·parse("127.0.0.1:0"), "UDP-001", "parse");
    ≔ socket = test_assert_ok(UdpSocket·bind(&addr), "UDP-001", "bind");

    // Check we got a port
    ⎇ ≔ Some(local) = socket.local_addr() {
        test_assert_true(local.port() > 0, "UDP-001", "should have assigned port");
    } ⎉ {
        // local_addr might be None on some systems
    }

    socket.close();
    println("PASS");
    true
}

// UDP-002: test_udp_bind_any_port
rite test_udp_bind_any_port() -> bool {
    print("  [UDP-002] UdpSocket bind any port... ");

    ≔ addr = test_assert_ok(SocketAddr·parse("0.0.0.0:0"), "UDP-002", "parse");
    ≔ socket = test_assert_ok(UdpSocket·bind(&addr), "UDP-002", "bind");

    socket.close();
    println("PASS");
    true
}

// UDP-005: test_udp_roundtrip
rite test_udp_roundtrip() -> bool {
    print("  [UDP-005] UdpSocket roundtrip... ");

    // Create two sockets
    ≔ addr1 = test_assert_ok(SocketAddr·parse("127.0.0.1:0"), "UDP-005", "parse addr1");
    ≔ socket1 = test_assert_ok(UdpSocket·bind(&addr1), "UDP-005", "bind socket1");

    ≔ addr2 = test_assert_ok(SocketAddr·parse("127.0.0.1:0"), "UDP-005", "parse addr2");
    ≔ socket2 = test_assert_ok(UdpSocket·bind(&addr2), "UDP-005", "bind socket2");

    // Get actual addresses
    ≔ local1 = socket1.local_addr().unwrap();
    ≔ local2 = socket2.local_addr().unwrap();

    // Send from socket1 to socket2
    ≔ data: [u8; 5] = [72, 101, 108, 108, 111]; // "Hello"
    ≔ sent = test_assert_ok(socket1.send_to(&data, local2), "UDP-005", "send_to");
    test_assert_eq(sent, 5, "UDP-005", "sent bytes");

    // Receive on socket2
    ≔ Δ buf: [u8; 64] = [0; 64];
    ≔ (received, sender) = test_assert_ok(socket2.recv_from(&Δ buf), "UDP-005", "recv_from");

    test_assert_eq(received, 5, "UDP-005", "received bytes");
    test_assert_eq(buf[0], 72, "UDP-005", "data[0]");
    test_assert_eq(buf[4], 111, "UDP-005", "data[4]");

    // Verify sender is socket1
    test_assert_eq(sender.port(), local1.port(), "UDP-005", "sender port");

    socket1.close();
    socket2.close();

    println("PASS");
    true
}

// ============================================================================
// TcpListener Tests
// ============================================================================

rite test_tcp_listener_bind() -> bool {
    print("  [TCP-LIS-001] TcpListener bind... ");

    ≔ addr = test_assert_ok(SocketAddr·parse("127.0.0.1:0"), "TCP-LIS-001", "parse");
    ≔ listener = test_assert_ok(TcpListener·bind(&addr), "TCP-LIS-001", "bind");

    // Check we got a port
    test_assert_true(listener.local_addr().port() > 0, "TCP-LIS-001", "should have port");

    println("PASS");
    true
}

rite test_tcp_listener_accept_nonblocking() -> bool {
    print("  [TCP-LIS-002] TcpListener accept nonblocking... ");

    ≔ addr = test_assert_ok(SocketAddr·parse("127.0.0.1:0"), "TCP-LIS-002", "parse");
    ≔ Δ listener = test_assert_ok(TcpListener·bind(&addr), "TCP-LIS-002", "bind");

    // Set non-blocking
    test_assert_ok(listener.set_nonblocking(true), "TCP-LIS-002", "set_nonblocking");

    // Accept should ⤺ WouldBlock since no connections
    ≔ result = listener.accept();
    ≔ err = test_assert_err(result, "TCP-LIS-002", "should fail");

    ⌥ err {
        SocketError·WouldBlock => {}
        _ => panic(format!("[TCP-LIS-002] FAIL: expected WouldBlock, got {:?}", err)),
    }

    println("PASS");
    true
}

// ============================================================================
// Main Test Runner
// ============================================================================

☉ rite main() -> !i32 {
    println("===========================================");
    println("Socket Layer Tests");
    println("TDD Red Phase - Tests should FAIL");
    println("===========================================");
    println("");

    ≔ Δ passed: i32 = 0;
    ≔ Δ failed: i32 = 0;

    println("--- SocketAddr Tests ---");
    ⎇ test_socket_addr_ipv4_parse() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_socket_addr_ipv4_localhost() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_socket_addr_ipv6_parse() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_socket_addr_ipv6_full() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_socket_addr_invalid() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_socket_addr_to_sockaddr() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_socket_addr_from_sockaddr() { passed += 1; } ⎉ { failed += 1; }

    println("");
    println("--- TcpStream Tests ---");
    ⎇ test_tcp_connect_localhost() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_tcp_connect_by_hostname() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_tcp_connect_refused() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_tcp_read_exact_eof() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_tcp_peer_addr() { passed += 1; } ⎉ { failed += 1; }

    println("");
    println("--- TcpListener Tests ---");
    ⎇ test_tcp_listener_bind() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_tcp_listener_accept_nonblocking() { passed += 1; } ⎉ { failed += 1; }

    println("");
    println("--- UdpSocket Tests ---");
    ⎇ test_udp_bind() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_udp_bind_any_port() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_udp_roundtrip() { passed += 1; } ⎉ { failed += 1; }

    println("");
    println("===========================================");
    println("Results: {}/{} tests passed", passed, passed + failed);
    println("===========================================");

    ⎇ failed > 0 {
        println("");
        println("RED PHASE: {} tests failing (expected)", failed);
        ⤺ 1;
    }

    println("");
    println("All tests passed!");
    ⤺ 0;
}
