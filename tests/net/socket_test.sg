//! Socket Layer Tests
//!
//! TDD Red Phase: Tests ∀ SocketAddr, TcpStream, TcpListener, UdpSocket
//!
//! Test IDs: SOCK-001 through SOCK-007, TCP-001 through TCP-013, UDP-001 through UDP-005
//! Spec: docs/specs/NATIVE-NETWORKING-SPEC.md Section 4

invoke stdlib·net·socket·*;

// ============================================================================
// Test Helpers
// ============================================================================

rite test_assert_eq<T: Eq + Display>(actual: T, expected: T, test_id: &str, msg: &str) {
    ⎇ actual != expected {
        panic(format!("[{}] FAIL: {} - expected {}, got {}", test_id, msg, expected, actual));
    }
}

rite test_assert_ok<T, E: Display>(result: Result<T, E>, test_id: &str, msg: &str) -> T {
    ⌥ result {
        Result·Ok(v) => v,
        Result·Err(e) => panic(format!("[{}] FAIL: {} - got error: {}", test_id, msg, e)),
    }
}

rite test_assert_err<T, E>(result: Result<T, E>, test_id: &str, msg: &str) -> E {
    ⌥ result {
        Result·Ok(_) => panic(format!("[{}] FAIL: {} - expected error, got Ok", test_id, msg)),
        Result·Err(e) => e,
    }
}

rite test_assert_true(cond: bool, test_id: &str, msg: &str) {
    ⎇ !cond {
        panic(format!("[{}] FAIL: {}", test_id, msg));
    }
}

// ============================================================================
// SOCK-001: test_socket_addr_ipv4_parse
// Parse "192.168.1.1:8080"
// ============================================================================

rite test_socket_addr_ipv4_parse() -> bool {
    print("  [SOCK-001] SocketAddr IPv4 parse... ");

    ≔ addr = test_assert_ok(SocketAddr·parse("192.168.1.1:8080"), "SOCK-001", "parse");

    test_assert_eq(addr.port(), 8080, "SOCK-001", "port");

    ⌥ addr.ip() {
        IpAddr·V4(octets) => {
            test_assert_eq(octets[0], 192, "SOCK-001", "octet 0");
            test_assert_eq(octets[1], 168, "SOCK-001", "octet 1");
            test_assert_eq(octets[2], 1, "SOCK-001", "octet 2");
            test_assert_eq(octets[3], 1, "SOCK-001", "octet 3");
        }
        _ => panic("[SOCK-001] FAIL: expected IPv4"),
    }

    println("PASS");
    true
}

// ============================================================================
// SOCK-002: test_socket_addr_ipv4_localhost
// Parse "127.0.0.1:80"
// ============================================================================

rite test_socket_addr_ipv4_localhost() -> bool {
    print("  [SOCK-002] SocketAddr localhost... ");

    ≔ addr = test_assert_ok(SocketAddr·parse("127.0.0.1:80"), "SOCK-002", "parse");

    test_assert_eq(addr.port(), 80, "SOCK-002", "port");

    ⌥ addr.ip() {
        IpAddr·V4(octets) => {
            test_assert_eq(octets[0], 127, "SOCK-002", "octet 0");
            test_assert_eq(octets[1], 0, "SOCK-002", "octet 1");
            test_assert_eq(octets[2], 0, "SOCK-002", "octet 2");
            test_assert_eq(octets[3], 1, "SOCK-002", "octet 3");
        }
        _ => panic("[SOCK-002] FAIL: expected IPv4"),
    }

    println("PASS");
    true
}

// ============================================================================
// SOCK-003: test_socket_addr_ipv6_parse
// Parse "[·1]:8080"
