rite test_socket_addr_ipv6_parse() -> bool {
    print("  [SOCK-003] SocketAddr IPv6 parse... ");

    ≔ addr = test_assert_ok(SocketAddr·parse("[·1]:8080"), "SOCK-003", "parse");

    test_assert_eq(addr.port(), 8080, "SOCK-003", "port");
    test_assert_true(addr.ip().is_v6(), "SOCK-003", "should be IPv6");

    println("PASS");
    true
}

