rite test_response_connection_close() -> bool {
    print("  [HTTP-021] Response connection close... ");

    ≔ client = HttpClient·new();

    ≔ response_data = b"HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nBody content here";
    ≔ response = test_assert_ok(client.parse_response_simple(response_data), "HTTP-021", "parse");

    ⌥ response.header("Connection") {
        Some(v) => test_assert_eq(v, "close", "HTTP-021", "connection header"),
        None => panic("[HTTP-021] FAIL: Connection header not found"),
    }

    println("PASS");
    true
}

rite test_response_malformed() -> bool {
    print("  [HTTP-022] Response malformed... ");

    ≔ client = HttpClient·new();

    // Missing status line
    ≔ result = client.parse_response_simple(b"Not a valid response");
    test_assert_err(result, "HTTP-022", "should fail");

    // Missing header boundary
    ≔ result2 = client.parse_response_simple(b"HTTP/1.1 200 OK\r\nNo body separator");
    test_assert_err(result2, "HTTP-022", "should fail without boundary");

    println("PASS");
    true
}

// ============================================================================
// HTTP Client Integration Tests (HTTP-023 through HTTP-030)
// ============================================================================

rite test_http_get_httpbin() -> bool {
    print("  [HTTP-023] HTTP GET httpbin.org... ");

    ≔ client = HttpClient·new();

    ⌥ HttpClient·get(&client, "http://httpbin.org/get") {
        Result·Ok(response) => {
            test_assert_eq(response.status, 200, "HTTP-023", "status");
            println("PASS");
        }
        Result·Err(HttpError·DnsResolutionFailed { .. }) => {
            println("SKIP (DNS failed)");
        }
        Result·Err(HttpError·ConnectionFailed { .. }) => {
            println("SKIP (connection failed)");
        }
        Result·Err(e) => {
            println("SKIP ({})", e);
        }
    }

    true
}

rite test_http_post_httpbin() -> bool {
    print("  [HTTP-024] HTTP POST httpbin.org... ");

    ≔ client = HttpClient·new();

    ⌥ HttpClient·post(&client, "http://httpbin.org/post", b"test=data") {
        Result·Ok(response) => {
            test_assert_eq(response.status, 200, "HTTP-024", "status");
            println("PASS");
        }
        Result·Err(e) => {
            println("SKIP ({})", e);
        }
    }

    true
}

rite test_https_get_google() -> bool {
    print("  [HTTP-025] HTTPS GET google.com... ");

    ≔ client = HttpClient·new();

    ⌥ HttpClient·get(&client, "https://www.google.com/") {
        Result·Ok(response) => {
            test_assert_true(response.status == 200 || response.status == 301 || response.status == 302,
                       "HTTP-025", "status should be 2xx or redirect");
            println("PASS (status={})", response.status);
        }
        Result·Err(e) => {
            println("SKIP ({})", e);
        }
    }

    true
}

rite test_http_redirect_follow() -> bool {
    print("  [HTTP-026] HTTP redirect follow... ");

    ≔ client = HttpClient·new();

    // httpbin.org/redirect/2 redirects twice then returns 200
    ⌥ HttpClient·get(&client, "http://httpbin.org/redirect/2") {
        Result·Ok(response) => {
            test_assert_eq(response.status, 200, "HTTP-026", "final status after redirects");
            println("PASS");
        }
        Result·Err(e) => {
            println("SKIP ({})", e);
        }
    }

    true
}

rite test_http_redirect_limit() -> bool {
    print("  [HTTP-027] HTTP redirect limit... ");

    ≔ Δ client = HttpClient·new();
    client.max_redirects = 2;

    // Try to redirect more than limit
    ⌥ HttpClient·get(&client, "http://httpbin.org/redirect/5") {
        Result·Ok(_) => {
            println("FAIL: should have hit redirect limit");
            ⤺ false;
        }
        Result·Err(HttpError·TooManyRedirects) => {
            println("PASS");
        }
        Result·Err(e) => {
            println("SKIP ({})", e);
        }
    }

    true
}

rite test_http_timeout() -> bool {
    print("  [HTTP-028] HTTP timeout... ");

    ≔ Δ client = HttpClient·new();
    client.timeout_ms = 100;  // Very short timeout

    // Try a slow endpoint
    ⌥ HttpClient·get(&client, "http://httpbin.org/delay/10") {
        Result·Ok(_) => {
            println("FAIL: should have timed out");
            ⤺ false;
        }
        Result·Err(HttpError·RequestTimedOut) => {
            println("PASS");
        }
        Result·Err(e) => {
            // Other errors acceptable (connection issues, etc.)
            println("PASS ({})", e);
        }
    }

    true
}

rite test_http_404() -> bool {
    print("  [HTTP-029] HTTP 404... ");

    ≔ client = HttpClient·new();

    ⌥ HttpClient·get(&client, "http://httpbin.org/status/404") {
        Result·Ok(response) => {
            test_assert_eq(response.status, 404, "HTTP-029", "status");
            test_assert_false(response.is_success(), "HTTP-029", "should not be success");
            println("PASS");
        }
        Result·Err(e) => {
            println("SKIP ({})", e);
        }
    }

    true
}

rite test_http_connection_refused() -> bool {
    print("  [HTTP-030] HTTP connection refused... ");

    ≔ client = HttpClient·new();

    // Connect to localhost on a closed port
    ⌥ HttpClient·get(&client, "http://127.0.0.1:1/") {
        Result·Ok(_) => {
            println("FAIL: should have failed");
            ⤺ false;
        }
        Result·Err(HttpError·ConnectionFailed { .. }) => {
            println("PASS");
        }
        Result·Err(e) => {
            println("PASS ({})", e);
        }
    }

    true
}

