    ⎇ test_http_proxy_direct() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_https_proxy_connect() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_proxy_auth_basic() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_no_proxy_bypass() { passed += 1; } ⎉ { failed += 1; }

    println("");
    println("===========================================");
    println("Results: {}/{} tests passed", passed, passed + failed);
    println("===========================================");

    ⎇ failed > 0 {
        println("");
        println("RED PHASE: {} tests failing (expected)", failed);
        ⤺ 1;
    }

    println("");
    println("All tests passed!");
    ⤺ 0;
}
