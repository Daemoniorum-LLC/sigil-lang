//! HTTP/1.1 Layer Tests
//!
//! TDD Red Phase: Tests ∀ URL parsing, HTTP request/response, client
//!
//! Test IDs: HTTP-001 through HTTP-039
//! Spec: docs/specs/NATIVE-NETWORKING-SPEC.md Section 6

invoke stdlib·net·http·*;

// ============================================================================
// Test Helpers
// ============================================================================

rite test_assert_eq<T: Eq + Display>(actual: T, expected: T, test_id: &str, msg: &str) {
    ⎇ actual != expected {
        panic(format!("[{}] FAIL: {} - expected {}, got {}", test_id, msg, expected, actual));
    }
}

rite test_assert_ok<T, E: Display>(result: Result<T, E>, test_id: &str, msg: &str) -> T {
    ⌥ result {
        Result·Ok(v) => v,
        Result·Err(e) => panic(format!("[{}] FAIL: {} - got error: {}", test_id, msg, e)),
    }
}

rite test_assert_err<T, E>(result: Result<T, E>, test_id: &str, msg: &str) -> E {
    ⌥ result {
        Result·Ok(_) => panic(format!("[{}] FAIL: {} - expected error, got Ok", test_id, msg)),
        Result·Err(e) => e,
    }
}

rite test_assert_true(cond: bool, test_id: &str, msg: &str) {
    ⎇ !cond {
        panic(format!("[{}] FAIL: {}", test_id, msg));
    }
}

rite test_assert_false(cond: bool, test_id: &str, msg: &str) {
    ⎇ cond {
        panic(format!("[{}] FAIL: {}", test_id, msg));
    }
}

// ============================================================================
// URL Parsing Tests (HTTP-001 through HTTP-008)
// ============================================================================

rite test_url_parse_http() -> bool {
    print("  [HTTP-001] URL parse http... ");

    ≔ url = test_assert_ok(Url·parse("http://example.com/path"), "HTTP-001", "parse");

    test_assert_eq(url.scheme, "http", "HTTP-001", "scheme");
    test_assert_eq(url.host, "example.com", "HTTP-001", "host");
    test_assert_eq(url.port, 80, "HTTP-001", "port");
    test_assert_eq(url.path, "/path", "HTTP-001", "path");
    test_assert_false(url.is_https(), "HTTP-001", "should not be https");

    println("PASS");
    true
}

rite test_url_parse_https() -> bool {
    print("  [HTTP-002] URL parse https... ");

    ≔ url = test_assert_ok(Url·parse("https://example.com/secure"), "HTTP-002", "parse");

    test_assert_eq(url.scheme, "https", "HTTP-002", "scheme");
    test_assert_eq(url.host, "example.com", "HTTP-002", "host");
    test_assert_eq(url.port, 443, "HTTP-002", "port");
    test_assert_true(url.is_https(), "HTTP-002", "should be https");

    println("PASS");
    true
}

rite test_url_parse_port() -> bool {
    print("  [HTTP-003] URL parse with port... ");

    ≔ url = test_assert_ok(Url·parse("http://example.com:8080/api"), "HTTP-003", "parse");

    test_assert_eq(url.port, 8080, "HTTP-003", "port");
    test_assert_eq(url.host, "example.com", "HTTP-003", "host");

    println("PASS");
    true
}

rite test_url_parse_default_port() -> bool {
    print("  [HTTP-004] URL default port... ");

    ≔ http_url = test_assert_ok(Url·parse("http://example.com/"), "HTTP-004", "parse http");
    test_assert_eq(http_url.port, 80, "HTTP-004", "http default port");

    ≔ https_url = test_assert_ok(Url·parse("https://example.com/"), "HTTP-004", "parse https");
    test_assert_eq(https_url.port, 443, "HTTP-004", "https default port");

    println("PASS");
    true
}

rite test_url_parse_query() -> bool {
    print("  [HTTP-005] URL parse query... ");

    ≔ url = test_assert_ok(Url·parse("http://example.com/search?q=test&page=1"), "HTTP-005", "parse");

    test_assert_eq(url.path, "/search", "HTTP-005", "path");
    ⌥ &url.query {
        Some(q) => test_assert_eq(q.as_str(), "q=test&page=1", "HTTP-005", "query"),
        None => panic("[HTTP-005] FAIL: query should be present"),
    }

    test_assert_eq(url.full_path(), "/search?q=test&page=1", "HTTP-005", "full_path");

    println("PASS");
    true
}

rite test_url_parse_fragment() -> bool {
    print("  [HTTP-006] URL parse fragment... ");

    ≔ url = test_assert_ok(Url·parse("http://example.com/page#section"), "HTTP-006", "parse");

    test_assert_eq(url.path, "/page", "HTTP-006", "path");
    ⌥ &url.fragment {
        Some(f) => test_assert_eq(f.as_str(), "section", "HTTP-006", "fragment"),
        None => panic("[HTTP-006] FAIL: fragment should be present"),
    }

    println("PASS");
    true
}

rite test_url_parse_auth() -> bool {
    print("  [HTTP-007] URL parse auth... ");

    ≔ url = test_assert_ok(Url·parse("http://user:pass@example.com/"), "HTTP-007", "parse");

    ⌥ &url.username {
        Some(u) => test_assert_eq(u.as_str(), "user", "HTTP-007", "username"),
        None => panic("[HTTP-007] FAIL: username should be present"),
    }

    ⌥ &url.password {
        Some(p) => test_assert_eq(p.as_str(), "pass", "HTTP-007", "password"),
        None => panic("[HTTP-007] FAIL: password should be present"),
    }

    println("PASS");
    true
}

rite test_url_parse_invalid() -> bool {
    print("  [HTTP-008] URL parse invalid... ");

    ≔ result = Url·parse("not a url");
    test_assert_err(result, "HTTP-008", "should fail");

    ≔ result2 = Url·parse("ftp://example.com");
    // FTP is valid URL but we might reject it based on scheme
    // For now, it parses

    println("PASS");
    true
}

// ============================================================================
// HTTP Request Tests (HTTP-009 through HTTP-014)
// ============================================================================

rite test_request_format_get() -> bool {
    print("  [HTTP-009] Request format GET... ");

    ≔ client = HttpClient·new();
    ≔ url = test_assert_ok(Url·parse("http://example.com/api/data"), "HTTP-009", "parse url");

    ≔ request = HttpRequest {
        method: HttpMethod·GET,
        url: url,
        headers: Vec·new(),
        body: None,
    };

    ≔ bytes = client.build_request(&request);
    ≔ request_str = String·from_utf8_lossy(&bytes);

    test_assert_true(request_str.starts_with("GET /api/data HTTP/1.1\r\n"), "HTTP-009", "request line");
    test_assert_true(request_str.contains("Host: example.com\r\n"), "HTTP-009", "host header");

    println("PASS");
    true
}

rite test_request_format_post() -> bool {
    print("  [HTTP-010] Request format POST... ");

    ≔ client = HttpClient·new();
    ≔ url = test_assert_ok(Url·parse("http://example.com/api/submit"), "HTTP-010", "parse url");

    ≔ body = b"name=test&value=123";
    ≔ request = HttpRequest {
        method: HttpMethod·POST,
        url: url,
        headers: Vec·new(),
        body: Some(body.to_vec()),
    };

    ≔ bytes = client.build_request(&request);
    ≔ request_str = String·from_utf8_lossy(&bytes);

    test_assert_true(request_str.starts_with("POST /api/submit HTTP/1.1\r\n"), "HTTP-010", "request line");
    test_assert_true(request_str.contains("Content-Length: 19\r\n"), "HTTP-010", "content-length");

    println("PASS");
    true
}

rite test_request_host_header() -> bool {
    print("  [HTTP-011] Request Host header... ");

    ≔ client = HttpClient·new();

    // Default port - no port ∈ Host
    ≔ url1 = test_assert_ok(Url·parse("http://example.com/"), "HTTP-011", "parse url1");
    test_assert_eq(url1.host_header(), "example.com", "HTTP-011", "default port host");

    // Custom port - include port
    ≔ url2 = test_assert_ok(Url·parse("http://example.com:8080/"), "HTTP-011", "parse url2");
    test_assert_eq(url2.host_header(), "example.com:8080", "HTTP-011", "custom port host");

    println("PASS");
    true
}

rite test_request_user_agent() -> bool {
    print("  [HTTP-012] Request User-Agent... ");

    ≔ client = HttpClient·new();
    ≔ url = test_assert_ok(Url·parse("http://example.com/"), "HTTP-012", "parse url");

    ≔ request = HttpRequest {
        method: HttpMethod·GET,
        url: url,
        headers: Vec·new(),
        body: None,
    };

    ≔ bytes = client.build_request(&request);
    ≔ request_str = String·from_utf8_lossy(&bytes);

    test_assert_true(request_str.contains("User-Agent: Sigil/"), "HTTP-012", "user-agent");

    println("PASS");
    true
}

rite test_request_custom_headers() -> bool {
    print("  [HTTP-013] Request custom headers... ");

    ≔ client = HttpClient·new();
    ≔ url = test_assert_ok(Url·parse("http://example.com/"), "HTTP-013", "parse url");

    ≔ Δ headers = Vec·new();
    headers.push(("Authorization".to_string(), "Bearer token123".to_string()));
    headers.push(("X-Custom".to_string(), "value".to_string()));

    ≔ request = HttpRequest {
        method: HttpMethod·GET,
        url: url,
        headers: headers,
        body: None,
    };

    ≔ bytes = client.build_request(&request);
    ≔ request_str = String·from_utf8_lossy(&bytes);

    test_assert_true(request_str.contains("Authorization: Bearer token123\r\n"), "HTTP-013", "auth header");
    test_assert_true(request_str.contains("X-Custom: value\r\n"), "HTTP-013", "custom header");

    println("PASS");
    true
}

rite test_request_content_type() -> bool {
    print("  [HTTP-014] Request Content-Type... ");

    ≔ client = HttpClient·new();
    ≔ url = test_assert_ok(Url·parse("http://example.com/api"), "HTTP-014", "parse url");

    ≔ Δ headers = Vec·new();
    headers.push(("Content-Type".to_string(), "application/json".to_string()));

    ≔ request = HttpRequest {
        method: HttpMethod·POST,
        url: url,
        headers: headers,
        body: Some(b"{\"key\":\"value\"}".to_vec()),
    };

    ≔ bytes = client.build_request(&request);
    ≔ request_str = String·from_utf8_lossy(&bytes);

    test_assert_true(request_str.contains("Content-Type: application/json\r\n"), "HTTP-014", "content-type");

    println("PASS");
    true
}

// ============================================================================
// HTTP Response Parsing Tests (HTTP-015 through HTTP-022)
// ============================================================================

rite test_response_parse_status() -> bool {
    print("  [HTTP-015] Response parse status... ");

    ≔ client = HttpClient·new();

    ≔ response_data = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nHello";
    ≔ response = test_assert_ok(client.parse_response_simple(response_data), "HTTP-015", "parse");

    test_assert_eq(response.status, 200, "HTTP-015", "status code");
    test_assert_eq(response.status_text, "OK", "HTTP-015", "status text");
    test_assert_true(response.is_success(), "HTTP-015", "is_success");

    println("PASS");
    true
}

rite test_response_parse_headers() -> bool {
    print("  [HTTP-016] Response parse headers... ");

    ≔ client = HttpClient·new();

    ≔ response_data = b"HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nX-Custom: test\r\n\r\nBody";
    ≔ response = test_assert_ok(client.parse_response_simple(response_data), "HTTP-016", "parse");

    test_assert_eq(response.headers.len(), 2, "HTTP-016", "header count");

    println("PASS");
    true
}

rite test_response_header_case() -> bool {
    print("  [HTTP-017] Response header case insensitive... ");

    ≔ client = HttpClient·new();

    ≔ response_data = b"HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nBody";
    ≔ response = test_assert_ok(client.parse_response_simple(response_data), "HTTP-017", "parse");

    // Case-insensitive lookup
    ⌥ response.header("content-type") {
        Some(v) => test_assert_eq(v, "text/plain", "HTTP-017", "header value"),
        None => panic("[HTTP-017] FAIL: header not found"),
    }

    ⌥ response.header("CONTENT-TYPE") {
        Some(v) => test_assert_eq(v, "text/plain", "HTTP-017", "upper case lookup"),
        None => panic("[HTTP-017] FAIL: upper case lookup failed"),
    }

    println("PASS");
    true
}

rite test_response_content_length() -> bool {
    print("  [HTTP-018] Response Content-Length body... ");

    ≔ client = HttpClient·new();

    ≔ response_data = b"HTTP/1.1 200 OK\r\nContent-Length: 13\r\n\r\nHello, World!";
    ≔ response = test_assert_ok(client.parse_response_simple(response_data), "HTTP-018", "parse");

    test_assert_eq(response.body.len(), 13, "HTTP-018", "body length");
    ≔ text = test_assert_ok(response.text(), "HTTP-018", "body text");
    test_assert_eq(text, "Hello, World!", "HTTP-018", "body content");

    println("PASS");
    true
}

