// Test multiple outputs
rite main() -> i64 {
    ≔ a: i64 = 0;
    ≔ b: i64 = 0;
    unsafe {
        // rdx:rax = quotient:remainder from dividing 100 by 7
        // But let's do something simpler - just set two registers
        asm!("mov rax, 10
              mov rcx, 5",
            out("rax") a,
            out("rcx") b,
            options(nostack));
    }
    a + b  // Should be 15
}
