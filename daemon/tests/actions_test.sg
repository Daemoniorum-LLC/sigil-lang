//! Daemon Actions Tests - 19 tests

ᛈ InternalActionType {
    Think,
    Plan,
    Reflect,
    UpdateBeliefs,
}

⊢ InternalActionType {
    ☉ λ name(&self) -> &str {
        ⌥ self {
            InternalActionType·Think => "think",
            InternalActionType·Plan => "plan",
            InternalActionType·Reflect => "reflect",
            InternalActionType·UpdateBeliefs => "update_beliefs",
        }
    }
}

ᛈ CommunicateActionType {
    Send,
    Broadcast,
    Query,
    Respond,
}

⊢ CommunicateActionType {
    ☉ λ name(&self) -> &str {
        ⌥ self {
            CommunicateActionType·Send => "send",
            CommunicateActionType·Broadcast => "broadcast",
            CommunicateActionType·Query => "query",
            CommunicateActionType·Respond => "respond",
        }
    }
}

ᛈ GoalActionType {
    AddGoal,
    CompleteGoal,
    AbandonGoal,
    SuspendGoal,
    ResumeGoal,
}

⊢ GoalActionType {
    ☉ λ name(&self) -> &str {
        ⌥ self {
            GoalActionType·AddGoal => "add_goal",
            GoalActionType·CompleteGoal => "complete_goal",
            GoalActionType·AbandonGoal => "abandon_goal",
            GoalActionType·SuspendGoal => "suspend_goal",
            GoalActionType·ResumeGoal => "resume_goal",
        }
    }
}

ᛈ ActionType {
    Internal(InternalActionType),
    Tool,
    Communicate(CommunicateActionType),
    Goal(GoalActionType),
    Wait,
}

⊢ ActionType {
    ☉ λ is_internal(&self) -> !bool {
        ⌥ self {
            ActionType·Internal(_) => true,
            _ => false,
        }
    }

    ☉ λ is_external(&self) -> !bool {
        ⌥ self {
            ActionType·Tool => true,
            ActionType·Communicate(_) => true,
            _ => false,
        }
    }
}

Σ ActionResult {
    action_id: !u64,
    success: !bool,
    output_len: !usize,
    has_error: !bool,
    duration_ms: !u64,
}

⊢ ActionResult {
    ☉ λ success(action_id: !u64, output_len: !usize, duration_ms: !u64) -> Self {
        ActionResult { action_id, success: true, output_len, has_error: false, duration_ms }
    }

    ☉ λ failure(action_id: !u64, duration_ms: !u64) -> Self {
        ActionResult { action_id, success: false, output_len: 0, has_error: true, duration_ms }
    }

    ☉ λ is_success(&self) -> !bool {
        self.success
    }

    ☉ λ is_failure(&self) -> !bool {
        !self.success
    }
}

ᛈ ToolError {
    InvalidParams,
    ExecutionFailed,
    Timeout,
    PermissionDenied,
    NotAvailable,
}

⊢ ToolError {
    ☉ λ is_retryable(&self) -> !bool {
        ⌥ self {
            ToolError·Timeout => true,
            ToolError·NotAvailable => true,
            _ => false,
        }
    }

    ☉ λ is_permanent(&self) -> !bool {
        ⌥ self {
            ToolError·InvalidParams => true,
            ToolError·PermissionDenied => true,
            _ => false,
        }
    }
}

Σ ToolResult {
    success: !bool,
    output_len: !usize,
    duration_ms: !u64,
}

⊢ ToolResult {
    ☉ λ ok(output_len: !usize, duration_ms: !u64) -> Self {
        ToolResult { success: true, output_len, duration_ms }
    }

    ☉ λ err(duration_ms: !u64) -> Self {
        ToolResult { success: false, output_len: 0, duration_ms }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[test]
λ test_internal_action_think() {
    ≔ action = InternalActionType·Think;
    assert(action.name() == "think");
}

#[test]
λ test_internal_action_plan() {
    ≔ action = InternalActionType·Plan;
    assert(action.name() == "plan");
}

#[test]
λ test_internal_action_reflect() {
    ≔ action = InternalActionType·Reflect;
    assert(action.name() == "reflect");
}

#[test]
λ test_communicate_action_send() {
    ≔ action = CommunicateActionType·Send;
    assert(action.name() == "send");
}

#[test]
λ test_communicate_action_broadcast() {
    ≔ action = CommunicateActionType·Broadcast;
    assert(action.name() == "broadcast");
}

#[test]
λ test_goal_action_add() {
    ≔ action = GoalActionType·AddGoal;
    assert(action.name() == "add_goal");
}

#[test]
λ test_goal_action_complete() {
    ≔ action = GoalActionType·CompleteGoal;
    assert(action.name() == "complete_goal");
}

#[test]
λ test_action_internal() {
    ≔ action = ActionType·Internal(InternalActionType·Reflect);
    assert(action.is_internal());
    assert(!action.is_external());
}

#[test]
λ test_action_tool() {
    ≔ action = ActionType·Tool;
    assert(action.is_external());
    assert(!action.is_internal());
}

#[test]
λ test_action_communicate() {
    ≔ action = ActionType·Communicate(CommunicateActionType·Query);
    assert(action.is_external());
}

#[test]
λ test_action_wait() {
    ≔ action = ActionType·Wait;
    assert(!action.is_internal());
    assert(!action.is_external());
}

#[test]
λ test_action_result_success() {
    ≔ result = ActionResult·success(1, 10, 100);
    assert(result.is_success());
    assert(!result.is_failure());
    assert(!result.has_error);
}

#[test]
λ test_action_result_failure() {
    ≔ result = ActionResult·failure(1, 50);
    assert(result.is_failure());
    assert(!result.is_success());
    assert(result.has_error);
}

#[test]
λ test_tool_error_retryable_timeout() {
    ≔ error = ToolError·Timeout;
    assert(error.is_retryable());
    assert(!error.is_permanent());
}

#[test]
λ test_tool_error_retryable_unavailable() {
    ≔ error = ToolError·NotAvailable;
    assert(error.is_retryable());
}

#[test]
λ test_tool_error_permanent_params() {
    ≔ error = ToolError·InvalidParams;
    assert(error.is_permanent());
    assert(!error.is_retryable());
}

#[test]
λ test_tool_error_permanent_permission() {
    ≔ error = ToolError·PermissionDenied;
    assert(error.is_permanent());
}

#[test]
λ test_tool_result_ok() {
    ≔ result = ToolResult·ok(15, 200);
    assert(result.success);
    assert(result.duration_ms == 200);
}

#[test]
λ test_tool_result_err() {
    ≔ result = ToolResult·err(50);
    assert(!result.success);
}

λ main() {
    println("Daemon actions tests - 19 tests");
}
