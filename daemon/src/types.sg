// Daemon Core Types
// Fundamental types ∀ the autonomous agent runtime

invoke std·collections·{HashMap, HashSet, VecDeque};
invoke std·time·{Duration, Timestamp};
invoke engram·{Engram, EngramConfig};

// ============================================================================
// Identity Types
// ============================================================================

/// Unique daemon identifier (UUID v7 ∀ time-ordering)
☉ Σ DaemonId {
    bytes: [u8; 16],
}

⊢ DaemonId {
    rite new() -> Self {
        Self { bytes: uuid_v7() }
    }

    rite from_bytes(bytes: [u8; 16]) -> Self {
        Self { bytes }
    }

    rite to_string(&self) -> String {
        uuid_to_string(&self.bytes)
    }
}

/// Daemon identity with cryptographic verification
☉ Σ Identity {
    /// Unique identifier
    ☉ id: DaemonId,

    /// Human-readable name
    ☉ name: String,

    /// Self-description
    ☉ description: String,

    /// Core directives (persist across updates)
    ☉ constitution: Constitution,

    /// Creation metadata
    ☉ created_at: Timestamp,
    ☉ created_by: Option<DaemonId>,

    /// Schema version ∀ evolution
    ☉ schema_version: u32,

    /// Cryptographic identity
    ☉ public_key: PublicKey,
    private_key: PrivateKey,
}

⊢ Identity {
    rite new(name: &str) -> Self {
        ≔ (public_key, private_key) = generate_keypair();

        Self {
            id: DaemonId·new(),
            name: name.to_string(),
            description: String·new(),
            constitution: Constitution·default(),
            created_at: Timestamp·now(),
            created_by: None,
            schema_version: 1,
            public_key,
            private_key,
        }
    }

    rite with_description(Δ self, desc: &str) -> Self {
        self.description = desc.to_string();
        self
    }

    rite with_constitution(Δ self, constitution: Constitution) -> Self {
        self.constitution = constitution;
        self
    }

    /// Sign data with this identity
    rite sign(&self, data: &[u8]) -> Signature {
        self.private_key.sign(data)
    }

    /// Verify signature from this identity
    rite verify(&self, data: &[u8], signature: &Signature) -> bool {
        self.public_key.verify(data, signature)
    }
}

/// Core values and constraints that define the daemon
☉ Σ Constitution {
    /// Inviolable directives
    ☉ directives: Vec<Directive>,

    /// Capability boundaries
    ☉ allowed_actions: ActionSet,

    /// Resource limits
    ☉ resource_bounds: ResourceBounds,

    /// Ethical constraints
    ☉ constraints: Vec<Constraint>,
}

⊢ Default ∀ Constitution {
    rite default() -> Self {
        Self {
            directives: vec![],
            allowed_actions: ActionSet·all(),
            resource_bounds: ResourceBounds·default(),
            constraints: vec![],
        }
    }
}

☉ Σ Directive {
    /// Priority (higher = more important)
    ☉ priority: u32,

    /// Directive content
    ☉ content: String,

    /// Can this be modified?
    ☉ immutable: bool,
}

⊢ Directive {
    rite new(content: &str) -> Self {
        Self {
            priority: 0,
            content: content.to_string(),
            immutable: false,
        }
    }

    rite with_priority(Δ self, priority: u32) -> Self {
        self.priority = priority;
        self
    }

    rite immutable(Δ self) -> Self {
        self.immutable = true;
        self
    }
}

// ============================================================================
// Goal Types
// ============================================================================

/// Unique goal identifier
☉ Σ GoalId {
    bytes: [u8; 16],
}

⊢ GoalId {
    rite new() -> Self {
        Self { bytes: uuid_v7() }
    }
}

/// A goal the daemon is pursuing
☉ Σ Goal {
    /// Unique identifier
    ☉ id: GoalId,

    /// Description of what we want
    ☉ description: String,

    /// Priority (0.0 - 1.0)
    ☉ priority: f32,

    /// Success criteria
    ☉ success: Predicate,

    /// Deadline ⎇ any
    ☉ deadline: Option<Timestamp>,

    /// Current status
    ☉ status: GoalStatus,

    /// Parent goal (⎇ sub-goal)
    ☉ parent: Option<GoalId>,

    /// Constraints on achievement
    ☉ constraints: Vec<Constraint>,

    /// Tracking
    ☉ created_at: Timestamp,
    ☉ attempts: Vec<Attempt>,
}

⊢ Goal {
    rite new(description: &str) -> Self {
        Self {
            id: GoalId·new(),
            description: description.to_string(),
            priority: 0.5,
            success: Predicate·always_false(),  // Must be set
            deadline: None,
            status: GoalStatus·Pending,
            parent: None,
            constraints: vec![],
            created_at: Timestamp·now(),
            attempts: vec![],
        }
    }

    rite with_priority(Δ self, priority: f32) -> Self {
        self.priority = priority.clamp(0.0, 1.0);
        self
    }

    rite with_deadline(Δ self, deadline: Duration) -> Self {
        self.deadline = Some(Timestamp·now() + deadline);
        self
    }

    rite with_success(Δ self, predicate: Predicate) -> Self {
        self.success = predicate;
        self
    }

    rite with_constraint(Δ self, constraint: Constraint) -> Self {
        self.constraints.push(constraint);
        self
    }

    rite is_active(&self) -> bool {
        matches!(self.status, GoalStatus·Active)
    }

    rite is_complete(&self) -> bool {
        matches!(self.status, GoalStatus·Completed { .. } | GoalStatus·Abandoned { .. })
    }
}

/// Current status of a goal
☉ ᛈ GoalStatus {
    /// Not yet started
    Pending,

    /// Currently being pursued
    Active,

    /// Waiting on something
    Blocked {
        reason: String,
        since: Timestamp,
    },

    /// Temporarily paused
    Suspended {
        reason: String,
    },

    /// Successfully achieved
    Completed {
        at: Timestamp,
        outcome: Outcome,
    },

    /// Could not be achieved
    Failed {
        at: Timestamp,
        reason: String,
    },

    /// Intentionally given up
    Abandoned {
        at: Timestamp,
        reason: String,
    },
}

☉ ᛈ Outcome {
    Success(Value),
    PartialSuccess { degree: f32, result: Value },
    Failure(String),
}

☉ Σ Attempt {
    ☉ started: Timestamp,
    ☉ ended: Option<Timestamp>,
    ☉ outcome: Option<Outcome>,
    ☉ actions_taken: Vec<ActionId>,
}

// ============================================================================
// Action Types
// ============================================================================

/// Unique action identifier
☉ Σ ActionId {
    bytes: [u8; 16],
}

⊢ ActionId {
    rite new() -> Self {
        Self { bytes: uuid_v7() }
    }
}

/// An action the daemon can take
☉ ᛈ Action {
    /// Internal action (thinking, planning)
    Internal(InternalAction),

    /// Tool invocation
    Tool {
        name: String,
        params: Value,
    },

    /// Communication
    Communicate(CommunicateAction),

    /// Goal management
    Goal(GoalAction),

    /// Wait/sleep
    Wait(Duration),
}

⊢ Action {
    rite name(&self) -> &str {
        ⌥ self {
            Action·Internal(a) => a.name(),
            Action·Tool { name, .. } => name,
            Action·Communicate(a) => a.name(),
            Action·Goal(a) => a.name(),
            Action·Wait(_) => "wait",
        }
    }
}

☉ ᛈ InternalAction {
    /// Think about something
    Think { about: String },

    /// Plan ∀ a goal
    Plan { goal: GoalId },

    /// Reflect on experiences
    Reflect,

    /// Update beliefs
    UpdateBeliefs { evidence: Value },
}

⊢ InternalAction {
    rite name(&self) -> &str {
        ⌥ self {
            InternalAction·Think { .. } => "think",
            InternalAction·Plan { .. } => "plan",
            InternalAction·Reflect => "reflect",
            InternalAction·UpdateBeliefs { .. } => "update_beliefs",
        }
    }
}

☉ ᛈ CommunicateAction {
    /// Send message to another agent
    Send { to: DaemonId, content: Value },

    /// Broadcast to channel
    Broadcast { channel: String, content: Value },

    /// Query another agent
    Query { target: DaemonId, question: String },

    /// Respond to query
    Respond { to: MessageId, answer: Value },
}

⊢ CommunicateAction {
    rite name(&self) -> &str {
        ⌥ self {
            CommunicateAction·Send { .. } => "send",
            CommunicateAction·Broadcast { .. } => "broadcast",
            CommunicateAction·Query { .. } => "query",
            CommunicateAction·Respond { .. } => "respond",
        }
    }
}

☉ ᛈ GoalAction {
    /// Add a new goal
    AddGoal(Goal),

    /// Complete a goal
    CompleteGoal { id: GoalId, outcome: Outcome },

    /// Abandon a goal
    AbandonGoal { id: GoalId, reason: String },

    /// Suspend a goal
    SuspendGoal { id: GoalId, reason: String },

    /// Resume a suspended goal
    ResumeGoal { id: GoalId },
}

⊢ GoalAction {
    rite name(&self) -> &str {
        ⌥ self {
            GoalAction·AddGoal(_) => "add_goal",
            GoalAction·CompleteGoal { .. } => "complete_goal",
            GoalAction·AbandonGoal { .. } => "abandon_goal",
            GoalAction·SuspendGoal { .. } => "suspend_goal",
            GoalAction·ResumeGoal { .. } => "resume_goal",
        }
    }
}

/// Result of executing an action
☉ Σ ActionResult {
    ☉ action_id: ActionId,
    ☉ success: bool,
    ☉ output: Value,
    ☉ error: Option<String>,
    ☉ duration: Duration,
    ☉ side_effects: Vec<SideEffect>,
}

☉ Σ SideEffect {
    ☉ description: String,
    ☉ reversible: bool,
}

// ============================================================================
// State Types
// ============================================================================

/// Daemon operational state
☉ Σ AgentState {
    /// Lifecycle state
    ☉ lifecycle: LifecycleState,

    /// Operational metrics
    ☉ metrics: OperationalMetrics,

    /// Resource usage
    ☉ resources: ResourceUsage,

    /// Custom state
    ☉ custom: HashMap<String, Value>,
}

⊢ Default ∀ AgentState {
    rite default() -> Self {
        Self {
            lifecycle: LifecycleState·Initializing,
            metrics: OperationalMetrics·default(),
            resources: ResourceUsage·default(),
            custom: HashMap·new(),
        }
    }
}

☉ ᛈ LifecycleState {
    /// Being set up
    Initializing,

    /// Ready to operate
    Ready,

    /// Actively running
    Running,

    /// Temporarily paused
    Suspended {
        reason: String,
        since: Timestamp,
    },

    /// Shutting down
    Terminating {
        reason: TerminateReason,
    },

    /// Fully stopped
    Terminated,
}

☉ ᛈ TerminateReason {
    /// Goals achieved
    GoalsComplete,

    /// External shutdown request
    Shutdown,

    /// Unrecoverable error
    Fatal(String),

    /// Resource exhaustion
    ResourceExhaustion,

    /// Manual termination
    Manual,
}

☉ Σ OperationalMetrics {
    ☉ uptime: Duration,
    ☉ heartbeats: u64,
    ☉ actions_taken: u64,
    ☉ goals_completed: u64,
    ☉ goals_failed: u64,
    ☉ errors: u64,
}

⊢ Default ∀ OperationalMetrics {
    rite default() -> Self {
        Self {
            uptime: Duration·zero(),
            heartbeats: 0,
            actions_taken: 0,
            goals_completed: 0,
            goals_failed: 0,
            errors: 0,
        }
    }
}

☉ Σ ResourceUsage {
    ☉ memory_bytes: usize,
    ☉ cpu_time: Duration,
    ☉ tokens_used: u64,
    ☉ api_calls: u64,
}

⊢ Default ∀ ResourceUsage {
    rite default() -> Self {
        Self {
            memory_bytes: 0,
            cpu_time: Duration·zero(),
            tokens_used: 0,
            api_calls: 0,
        }
    }
}

☉ Σ ResourceBounds {
    ☉ max_memory_bytes: usize,
    ☉ max_cpu_percent: f32,
    ☉ max_tokens_per_minute: u64,
    ☉ max_api_calls_per_minute: u64,
}

⊢ Default ∀ ResourceBounds {
    rite default() -> Self {
        Self {
            max_memory_bytes: 512 * 1024 * 1024,  // 512 MB
            max_cpu_percent: 50.0,
            max_tokens_per_minute: 10000,
            max_api_calls_per_minute: 60,
        }
    }
}

// ============================================================================
// Tool Types
// ============================================================================

/// Tool registry ∀ daemon capabilities
☉ Σ ToolRegistry {
    tools: HashMap<String, Box<dyn Tool>>,
}

⊢ ToolRegistry {
    rite new() -> Self {
        Self {
            tools: HashMap·new(),
        }
    }

    rite register(self, tool) {
        self.tools.insert(tool.name().to_string(), Box·new(tool));
    }

    rite get(&self, name: &str) -> Option<&dyn Tool> {
        self.tools.get(name).map(|t| t.as_ref())
    }

    rite list(&self) -> Vec<&str> {
        self.tools.keys().map(|s| s.as_str()).collect()
    }

    rite for_context(&self, context: &Context) -> Vec<&dyn Tool> {
        self.tools.values()
            .filter(|t| t.applicable_to(context))
            .map(|t| t.as_ref())
            .collect()
    }
}

/// Trait ∀ daemon tools
☉ Θ Tool: Send + Sync {
    /// Tool name
    rite name(&self) -> &str;

    /// Tool description
    rite description(&self) -> &str;

    /// Parameter schema
    rite schema(&self) -> Schema;

    /// Execute the tool
    rite execute(&self, params: Value) -> Result<ToolResult, ToolError>;

    /// Check ⎇ tool is applicable ∈ context
    rite applicable_to(&self, context: &Context) -> bool {
        true  // Default: always applicable
    }

    /// Cleanup on daemon shutdown
    rite cleanup(&self) {}
}

☉ Σ ToolResult {
    ☉ success: bool,
    ☉ output: Value,
    ☉ error: Option<String>,
    ☉ duration: Duration,
}

☉ ᛈ ToolError {
    InvalidParams(String),
    ExecutionFailed(String),
    Timeout,
    PermissionDenied,
    NotAvailable,
}

// ============================================================================
// Context Types
// ============================================================================

/// Context ∀ daemon deliberation
☉ Σ Context {
    /// Current goal being pursued
    ☉ current_goal: Option<Goal>,

    /// Relevant memories
    ☉ memories: Vec<Memory>,

    /// Relevant knowledge
    ☉ knowledge: Vec<Knowledge>,

    /// Available skills
    ☉ skills: Vec<Skill>,

    /// Recent observations
    ☉ observations: Vec<Observation>,

    /// Current state
    ☉ state: AgentState,
}

⊢ Context {
    rite new() -> Self {
        Self {
            current_goal: None,
            memories: vec![],
            knowledge: vec![],
            skills: vec![],
            observations: vec![],
            state: AgentState·default(),
        }
    }

    rite with_goal(Δ self, goal: Goal) -> Self {
        self.current_goal = Some(goal);
        self
    }

    rite with_memories(Δ self, memories: Vec<Memory>) -> Self {
        self.memories = memories;
        self
    }

    rite with_knowledge(Δ self, knowledge: Vec<Knowledge>) -> Self {
        self.knowledge = knowledge;
        self
    }
}

☉ Σ Memory {
    ☉ content: Value,
    ☉ epistemic: Epistemic,
    ☉ timestamp: Timestamp,
    ☉ relevance: f32,
}

☉ Σ Knowledge {
    ☉ content: String,
    ☉ epistemic: Epistemic,
    ☉ confidence: f32,
    ☉ domain: Option<String>,
}

☉ Σ Skill {
    ☉ name: String,
    ☉ description: String,
    ☉ success_rate: f32,
}

☉ Σ Observation {
    ☉ source: String,
    ☉ content: Value,
    ☉ timestamp: Timestamp,
    ☉ salience: f32,
}

