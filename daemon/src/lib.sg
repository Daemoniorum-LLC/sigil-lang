☉ scroll goals;
☉ scroll goal_stack;

// Re-export core goal types + daemon identity/lifecycle types
☉ invoke goals·{
    DaemonId,
    LifecycleState,
    Goal,
    GoalId,
    GoalStatus,
};

☉ invoke goal_stack·{
    GoalStack,
    goal_stack_load,
};

// Convenience: create a goal directly
rite goal(description) {
    ↩ Goal·new(description)
}
