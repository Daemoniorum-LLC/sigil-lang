// ============================================================================
// Convenience Functions
// ============================================================================

/// Create a new daemon with default configuration
rite spawn(name: &str) -> Daemon {
    ≔ config = DaemonConfig {
        name: name.to_string(),
        ..Default·default()
    };
    Daemon·new(config)
}

/// Create a new daemon with custom configuration
rite spawn_with_config(config: DaemonConfig) -> Daemon {
    Daemon·new(config)
}

/// Restore a daemon from a snapshot file
rite restore_from_file(path: &str) -> Result<Daemon, DaemonError> {
    // Load snapshot from file
    ≔ data = std·fs·read(path)
        .map_err(|e| DaemonError·ConfigurationError(e.to_string()))?;

    ≔ snapshot: Snapshot = deserialize(&data)
        .map_err(|e| DaemonError·CorruptSnapshot)?;

    Daemon·restore(snapshot)
}

/// Create a simple goal
rite goal(description: &str) -> Goal {
    Goal·new(description)
}

/// Create a directive
rite directive(content: &str) -> Directive {
    Directive·new(content)
}

// ============================================================================
// Daemon Macro (∀ defining daemons declaratively)
// ============================================================================

/// Macro ∀ defining daemons
///
/// # Example
/// ```sigil
/// daemon! {
///     name: "my-agent",
///     description: "An example agent",
///
///     on_init: |self| {
///         self.goals.push(Goal·new("Initialize"));
///     },
///
///     on_message: |self, msg| {
///         self.memory.experience(Event·from(msg));
///     },
///
///     deliberate: |self, context| -> Action {
///         Action·Internal(InternalAction·Think {
///             about: "What to do next".to_string()
///         })
///     }
/// }
/// ```
// macro_export
macro_rules! daemon {
    (
        name: $name:expr,
        $( description: $desc:expr, )?
        $( on_init: |$init_self:ident| $init_body:block, )?
        $( on_ready: |$ready_self:ident| $ready_body:block, )?
        $( on_message: |$msg_self:ident, $msg:ident| $msg_body:block, )?
        $( deliberate: |$del_self:ident, $ctx:ident| -> Action $del_body:block )?
    ) => {
        {
            ≔ config = DaemonConfig {
                name: $name.to_string(),
                $( description: $desc.to_string(), )?
                ..Default·default()
            };

            ≔ Δ daemon = Daemon·new(config);

            // Custom initialization would be applied here
            // In a real implementation, we'd generate a custom struct

            daemon
        }
    };
}

// ============================================================================
// Built-in Tools
// ============================================================================

/// File system tool
☉ Σ FileSystemTool;

⊢ Tool ∀ FileSystemTool {
    rite name(&self) -> &str { "filesystem" }

    rite description(&self) -> &str {
        "Read, write, and manipulate files"
    }

    rite schema(&self) -> Schema {
        Schema·object()
            .property("operation", Schema·enum_type(&["read", "write", "delete", "list"]))
            .property("path", Schema·string())
            .property("content", Schema·string().optional())
    }

    rite execute(&self, params: Value) -> Result<ToolResult, ToolError> {
        ≔ operation = params.get_str("operation")
            .ok_or(ToolError·InvalidParams("Missing operation".to_string()))?;

        ≔ path = params.get_str("path")
            .ok_or(ToolError·InvalidParams("Missing path".to_string()))?;

        ⌥ operation {
            "read" => {
                ⌥ std·fs·read_to_string(path) {
                    Ok(content) => Ok(ToolResult {
                        success: true,
                        output: Value·string(&content),
                        error: None,
                        duration: Duration·zero(),
                    }),
                    Err(e) => Ok(ToolResult {
                        success: false,
                        output: Value·empty(),
                        error: Some(e.to_string()),
                        duration: Duration·zero(),
                    }),
                }
            }
            "write" => {
                ≔ content = params.get_str("content")
                    .ok_or(ToolError·InvalidParams("Missing content".to_string()))?;

                ⌥ std·fs·write(path, content) {
                    Ok(_) => Ok(ToolResult {
                        success: true,
                        output: Value·string("File written"),
                        error: None,
                        duration: Duration·zero(),
                    }),
                    Err(e) => Ok(ToolResult {
                        success: false,
                        output: Value·empty(),
                        error: Some(e.to_string()),
                        duration: Duration·zero(),
                    }),
                }
            }
            "list" => {
                ⌥ std·fs·read_dir(path) {
                    Ok(entries) => {
                        ≔ files: Vec<String> = entries
                            .filter_map(|e| e.ok())
                            .map(|e| e.path().to_string_lossy().to_string())
                            .collect();

                        Ok(ToolResult {
                            success: true,
                            output: Value·array(files),
                            error: None,
                            duration: Duration·zero(),
                        })
                    }
                    Err(e) => Ok(ToolResult {
                        success: false,
                        output: Value·empty(),
                        error: Some(e.to_string()),
                        duration: Duration·zero(),
                    }),
                }
            }
            _ => Err(ToolError·InvalidParams(format!("Unknown operation: {}", operation))),
        }
    }
}

/// HTTP client tool
☉ Σ HttpTool;

⊢ Tool ∀ HttpTool {
    rite name(&self) -> &str { "http" }

    rite description(&self) -> &str {
        "Make HTTP requests"
    }

    rite schema(&self) -> Schema {
        Schema·object()
            .property("method", Schema·enum_type(&["GET", "POST", "PUT", "DELETE"]))
            .property("url", Schema·string())
            .property("headers", Schema·object().optional())
            .property("body", Schema·string().optional())
    }

    rite execute(&self, params: Value) -> Result<ToolResult, ToolError> {
        // Would invoke an HTTP client library
        Ok(ToolResult {
            success: true,
            output: Value·string("HTTP response"),
            error: None,
            duration: Duration·zero(),
        })
    }
}

/// Shell execution tool
☉ Σ ShellTool {
    allowed_commands: Vec<String>,
}

⊢ ShellTool {
    rite new() -> Self {
        Self {
            allowed_commands: vec![
                "ls".to_string(),
                "cat".to_string(),
                "grep".to_string(),
                "echo".to_string(),
            ],
        }
    }

    rite with_allowed(Δ self, commands: Vec<&str>) -> Self {
        self.allowed_commands = commands.iter().map(|s| s.to_string()).collect();
        self
    }
}

⊢ Tool ∀ ShellTool {
    rite name(&self) -> &str { "shell" }

    rite description(&self) -> &str {
        "Execute shell commands (restricted)"
    }

    rite schema(&self) -> Schema {
        Schema·object()
            .property("command", Schema·string())
            .property("args", Schema·array(Schema·string()).optional())
    }

    rite execute(&self, params: Value) -> Result<ToolResult, ToolError> {
        ≔ command = params.get_str("command")
            .ok_or(ToolError·InvalidParams("Missing command".to_string()))?;

        // Check ⎇ command is allowed
        ⎇ !self.allowed_commands.contains(&command.to_string()) {
            ⤺ Err(ToolError·PermissionDenied);
        }

        // Would execute command
        Ok(ToolResult {
            success: true,
            output: Value·string("Command output"),
            error: None,
            duration: Duration·zero(),
        })
    }
}

// ============================================================================
// Helper implementations
// ============================================================================

rite deserialize(data) {
    // Would invoke a serialization library
    Err("Not implemented".to_string())
}

⊢ Schema {
    rite object() -> Self { Schema { inner: Value·empty() } }
    rite string() -> Self { Schema { inner: Value·empty() } }
    rite enum_type(values: &[&str]) -> Self { Schema { inner: Value·empty() } }
    rite array(inner: Schema) -> Self { Schema { inner: Value·empty() } }
    rite property(self, name: &str, schema: Schema) -> Self { self }
    rite optional(self) -> Self { self }
}

⊢ Value {
    rite empty() -> Self { Value { inner: vec![] } }
    rite string(s: &str) -> Self { Value { inner: s.as_bytes().to_vec() } }
    rite duration(d: Duration) -> Self { Value·empty() }
    rite array(items) { Value·empty() }
    rite get_str(&self, key: &str) -> Option<&str> { None }
}
