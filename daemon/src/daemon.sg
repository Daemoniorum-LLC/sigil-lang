// Daemon Core Implementation
// The autonomous agent runtime

invoke crate·types·*;
invoke engram·{Engram, Query, Event};
invoke std·time·{Duration, Timestamp};

// ============================================================================
// Daemon Struct
// ============================================================================

/// The core daemon - an autonomous agent instance
☉ Σ Daemon {
    /// Identity
    ☉ identity: Identity,

    /// Memory (Engram integration)
    ☉ memory: Engram,

    /// Goal stack
    ☉ goals: GoalStack,

    /// Tool registry
    ☉ tools: ToolRegistry,

    /// Current state
    ☉ state: AgentState,

    /// Configuration
    config: DaemonConfig,

    /// Heartbeat engine
    heartbeat: HeartbeatEngine,

    /// Should terminate flag
    should_terminate: bool,

    /// Termination reason
    terminate_reason: Option<TerminateReason>,
}

⊢ Daemon {
    /// Create a new daemon with configuration
    rite new(config: DaemonConfig) -> Self {
        ≔ identity = Identity·new(&config.name)
            .with_description(&config.description);

        ≔ memory = Engram·new(config.memory.clone());
        ≔ goals = GoalStack·new(config.max_concurrent_goals);
        ≔ tools = ToolRegistry·new();
        ≔ state = AgentState·default();
        ≔ heartbeat = HeartbeatEngine·new(config.heartbeat_interval);

        Self {
            identity,
            memory,
            goals,
            tools,
            state,
            config,
            heartbeat,
            should_terminate: false,
            terminate_reason: None,
        }
    }

    /// Restore daemon from snapshot
    rite restore(snapshot: Snapshot) -> Result<Self, DaemonError> {
        // Verify snapshot integrity
        ⎇ !snapshot.verify() {
            ⤺ Err(DaemonError·CorruptSnapshot);
        }

        ≔ config = DaemonConfig {
            name: snapshot.identity.name.clone(),
            description: snapshot.identity.description.clone(),
            ..Default·default()
        };

        ≔ Δ daemon = Self·new(config);
        daemon.identity = snapshot.identity;
        daemon.memory = Engram·restore(snapshot.memory)?;
        daemon.goals = GoalStack·from_goals(snapshot.goals);
        daemon.state = snapshot.state;

        // Record rebirth event
        daemon.memory.experience(Event·rebirth(daemon.identity.id.clone()));

        Ok(daemon)
    }

    /// Spawn and run the daemon
    rite spawn(config: DaemonConfig) -> Self {
        ≔ daemon = Self·new(config);
        daemon
    }

    /// Run the daemon's main loop
    rite run(&Δ self) {
        // Initialize
        self.on_init();
        self.state.lifecycle = LifecycleState·Ready;
        self.on_ready();
        self.state.lifecycle = LifecycleState·Running;

        // Main heartbeat loop
        loop {
            // Execute heartbeat
            ⌥ self.heartbeat.beat(self) {
                Ok(result) => {
                    self.on_heartbeat_complete(result);
                }
                Err(e) => {
                    self.on_heartbeat_error(e);
                }
            }

            // Check ∀ termination
            ⎇ self.should_terminate {
                ⊗;
            }

            // Sleep until next heartbeat
            self.heartbeat.wait_for_next();
        }

        // Terminate
        self.on_terminate(self.terminate_reason.take().unwrap_or(TerminateReason·Manual));
        self.state.lifecycle = LifecycleState·Terminated;
    }

    // ========================================================================
    // Lifecycle Hooks
    // ========================================================================

    /// Called once at initialization
    rite on_init(&Δ self) {
        // Subclasses override this
    }

    /// Called when daemon becomes ready
    rite on_ready(&Δ self) {
        // Subclasses override this
    }

    /// Called after each heartbeat
    rite on_heartbeat_complete(&Δ self, result: HeartbeatResult) {
        self.state.metrics.heartbeats += 1;
        // Subclasses can override
    }

    /// Called when heartbeat has an error
    rite on_heartbeat_error(&Δ self, error: HeartbeatError) {
        self.state.metrics.errors += 1;
        self.memory.experience(Event·error(error.to_string()));
    }

    /// Called before termination
    rite on_terminate(&Δ self, reason: TerminateReason) {
        // Save final snapshot
        ⎇ ≔ Ok(snapshot) = self.snapshot() {
            self.save_snapshot(snapshot);
        }

        // Cleanup tools
        ∀ tool_name ∈ self.tools.list() {
            ⎇ ≔ Some(tool) = self.tools.get(tool_name) {
                tool.cleanup();
            }
        }

        // Final memory flush
        self.memory.flush();
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    /// Perceive the environment
    rite perceive(&Δ self) -> Vec<Observation> {
        // Collect observations from various sources
        ≔ Δ observations = Vec·new();

        // Time elapsed since last heartbeat
        observations.push(Observation {
            source: "system".to_string(),
            content: Value·duration(self.heartbeat.last_beat.elapsed()),
            timestamp: Timestamp·now(),
            salience: 0.1,
        });

        // Would collect from registered perception sources
        observations
    }

    /// Build context ∀ deliberation
    rite attend(&self) -> Result<Context, DaemonError> {
        ≔ current_goal = self.goals.current().cloned();

        // Query memory ∀ relevant information
        ≔ goal_context = current_goal.as_ref()
            .map(|g| g.description.clone())
            .unwrap_or_default();

        // Get episodic memories of similar situations
        ≔ memories = self.memory.recall(
            Query·similar_to(&goal_context)
                .limit(10)
        ).into_iter()
        .map(|r| Memory {
            content: r.content,
            epistemic: r.epistemic,
            timestamp: r.timestamp,
            relevance: r.relevance,
        })
        .collect();

        // Get semantic knowledge
        ≔ knowledge = self.memory.recall(
            Query·relevant_to(&goal_context)
                .from_semantic()
                .limit(20)
        ).into_iter()
        .map(|r| Knowledge {
            content: r.content.to_string(),
            epistemic: r.epistemic,
            confidence: r.confidence,
            domain: r.domain,
        })
        .collect();

        // Get applicable skills
        ≔ skills = self.memory.recall(
            Query·skills_for(&goal_context)
                .limit(5)
        ).into_iter()
        .map(|r| Skill {
            name: r.name,
            description: r.description,
            success_rate: r.success_rate,
        })
        .collect();

        Ok(Context {
            current_goal,
            memories,
            knowledge,
            skills,
            observations: vec![],
            state: self.state.clone(),
        })
    }

    /// Decide what action to take
    rite deliberate(&self, context: &Context) -> Result<Action, DaemonError> {
        // Get current goal
        ≔ goal = context.current_goal.as_ref()
            .ok_or(DaemonError·NoActiveGoal)?;

        // Get relevant tools
        ≔ relevant_tools = self.tools.for_context(context);

        // Use skills and knowledge to decide
        // This is where more sophisticated reasoning would happen
        // For now, simple heuristic

        // If we have a skill ∀ this, invoke it
        ⎇ ≔ Some(skill) = context.skills.first() {
            ⤺ Ok(Action·Internal(InternalAction·Think {
                about: format!("Applying skill: {}", skill.name),
            }));
        }

        // If we have relevant tools, consider using them
        ⎇ ≔ Some(tool) = relevant_tools.first() {
            ⤺ Ok(Action·Tool {
                name: tool.name().to_string(),
                params: Value·empty(),
            });
        }

        // Default: think about the goal
        Ok(Action·Internal(InternalAction·Think {
            about: goal.description.clone(),
        }))
    }

    /// Execute an action
    rite execute(&Δ self, action: Action) -> Result<ActionResult, DaemonError> {
        ≔ action_id = ActionId·new();
        ≔ start = Timestamp·now();

        ≔ result = ⌥ &action {
            Action·Internal(internal) => {
                self.execute_internal(internal)
            }
            Action·Tool { name, params } => {
                self.execute_tool(name, params)
            }
            Action·Communicate(comm) => {
                self.execute_communication(comm)
            }
            Action·Goal(goal_action) => {
                self.execute_goal_action(goal_action)
            }
            Action·Wait(duration) => {
                std·thread·sleep(*duration);
                Ok(ActionResult {
                    action_id: action_id.clone(),
                    success: true,
                    output: Value·empty(),
                    error: None,
                    duration: *duration,
                    side_effects: vec![],
                })
            }
        };

        // Update metrics
        self.state.metrics.actions_taken += 1;

        // Record ∈ memory
        ≔ outcome = result.as_ref().map(|r| r.success).unwrap_or(false);
        self.memory.experience(Event·action_taken(action.name(), outcome));

        result
    }

    rite execute_internal(&Δ self, action: &InternalAction) -> Result<ActionResult, DaemonError> {
        ≔ action_id = ActionId·new();
        ≔ start = Timestamp·now();

        ⌥ action {
            InternalAction·Think { about } => {
                // Record thought ∈ instant memory
                self.memory.attend(about);

                Ok(ActionResult {
                    action_id,
                    success: true,
                    output: Value·string(format!("Thought about: {}", about)),
                    error: None,
                    duration: start.elapsed(),
                    side_effects: vec![],
                })
            }
            InternalAction·Plan { goal } => {
                // Would integrate with Omen here
                Ok(ActionResult {
                    action_id,
                    success: true,
                    output: Value·string("Plan generated"),
                    error: None,
                    duration: start.elapsed(),
                    side_effects: vec![],
                })
            }
            InternalAction·Reflect => {
                // Consolidate recent experiences
                self.memory.consolidate();

                Ok(ActionResult {
                    action_id,
                    success: true,
                    output: Value·string("Reflected on experiences"),
                    error: None,
                    duration: start.elapsed(),
                    side_effects: vec![],
                })
            }
            InternalAction·UpdateBeliefs { evidence } => {
                // Would integrate with Omen belief system
                Ok(ActionResult {
                    action_id,
                    success: true,
                    output: Value·string("Beliefs updated"),
                    error: None,
                    duration: start.elapsed(),
                    side_effects: vec![],
                })
            }
        }
    }

    rite execute_tool(&Δ self, name: &str, params: &Value) -> Result<ActionResult, DaemonError> {
        ≔ action_id = ActionId·new();
        ≔ start = Timestamp·now();

        ≔ tool = self.tools.get(name)
            .ok_or(DaemonError·ToolNotFound(name.to_string()))?;

        // Check capability
        ⎇ !self.identity.constitution.allowed_actions.is_allowed(name) {
            ⤺ Err(DaemonError·ActionNotAllowed(name.to_string()));
        }

        ⌥ tool.execute(params.clone()) {
            Ok(result) => {
                Ok(ActionResult {
                    action_id,
                    success: result.success,
                    output: result.output,
                    error: result.error,
                    duration: start.elapsed(),
                    side_effects: vec![],
                })
            }
            Err(e) => {
                Err(DaemonError·ToolExecutionFailed(format!("{:?}", e)))
            }
        }
    }

    rite execute_communication(&Δ self, action: &CommunicateAction) -> Result<ActionResult, DaemonError> {
        ≔ action_id = ActionId·new();
        ≔ start = Timestamp·now();

        // Would integrate with Commune here
        Ok(ActionResult {
            action_id,
            success: true,
            output: Value·string("Message sent"),
            error: None,
            duration: start.elapsed(),
            side_effects: vec![],
        })
    }

    rite execute_goal_action(&Δ self, action: &GoalAction) -> Result<ActionResult, DaemonError> {
        ≔ action_id = ActionId·new();
        ≔ start = Timestamp·now();

        ⌥ action {
            GoalAction·AddGoal(goal) => {
                self.goals.push(goal.clone());
                Ok(ActionResult {
                    action_id,
                    success: true,
                    output: Value·string(format!("Goal added: {}", goal.description)),
                    error: None,
                    duration: start.elapsed(),
                    side_effects: vec![],
                })
            }
            GoalAction·CompleteGoal { id, outcome } => {
                self.goals.complete(id.clone(), outcome.clone());
                self.state.metrics.goals_completed += 1;
                Ok(ActionResult {
                    action_id,
                    success: true,
                    output: Value·string("Goal completed"),
                    error: None,
                    duration: start.elapsed(),
                    side_effects: vec![],
                })
            }
            GoalAction·AbandonGoal { id, reason } => {
                self.goals.abandon(id.clone(), reason.clone());
                Ok(ActionResult {
                    action_id,
                    success: true,
                    output: Value·string(format!("Goal abandoned: {}", reason)),
                    error: None,
                    duration: start.elapsed(),
                    side_effects: vec![],
                })
            }
            GoalAction·SuspendGoal { id, reason } => {
                self.goals.suspend(id.clone(), reason.clone());
                Ok(ActionResult {
                    action_id,
                    success: true,
                    output: Value·string(format!("Goal suspended: {}", reason)),
                    error: None,
                    duration: start.elapsed(),
                    side_effects: vec![],
                })
            }
            GoalAction·ResumeGoal { id } => {
                self.goals.resume(id.clone());
                Ok(ActionResult {
                    action_id,
                    success: true,
                    output: Value·string("Goal resumed"),
                    error: None,
                    duration: start.elapsed(),
                    side_effects: vec![],
                })
            }
        }
    }

    /// Learn from an action's result
    rite learn(&Δ self, action: &Action, result: &ActionResult) {
        // Store as procedural memory ⎇ successful
        ⎇ result.success {
            self.memory.learn_from_success(action.name(), result);
        } ⎉ ⎇ ≔ Some(error) = &result.error {
            self.memory.learn_from_failure(action.name(), error);
        }
    }

    // ========================================================================
    // Persistence
    // ========================================================================

    /// Create a snapshot of current state
    rite snapshot(&self) -> Result<Snapshot, DaemonError> {
        ≔ memory_snapshot = self.memory.snapshot()?;

        ≔ Δ snapshot = Snapshot {
            version: 1,
            identity: self.identity.clone(),
            memory: memory_snapshot,
            goals: self.goals.all().cloned().collect(),
            state: self.state.clone(),
            timestamp: Timestamp·now(),
            checksum: [0u8; 32],
        };

        // Compute checksum
        snapshot.checksum = snapshot.compute_checksum();

        Ok(snapshot)
    }

    rite save_snapshot(&self, snapshot: Snapshot) {
        ⎇ ≔ Some(path) = &self.config.storage_path {
            // Would save to filesystem
        }
    }

    // ========================================================================
    // Control
    // ========================================================================

    /// Request termination
    rite terminate(&Δ self, reason: TerminateReason) {
        self.should_terminate = true;
        self.terminate_reason = Some(reason);
        self.state.lifecycle = LifecycleState·Terminating {
            reason: self.terminate_reason.clone().unwrap(),
        };
    }

    /// Check ⎇ should terminate
    rite should_terminate(&self) -> bool {
        self.should_terminate
    }

    /// Suspend the daemon
    rite suspend(&Δ self, reason: &str) {
        self.state.lifecycle = LifecycleState·Suspended {
            reason: reason.to_string(),
            since: Timestamp·now(),
        };
    }

    /// Resume from suspension
    rite resume(&Δ self) {
        self.state.lifecycle = LifecycleState·Running;
    }
}

// ============================================================================
// Goal Stack
// ============================================================================

/// Manages daemon goals
☉ Σ GoalStack {
    /// Goals by ID
    goals: HashMap<GoalId, Goal>,

    /// Goal hierarchy (parent -> children)
    hierarchy: HashMap<GoalId, Vec<GoalId>>,

    /// Maximum concurrent goals
    max_goals: usize,

    /// Completed goals (∀ history)
    history: Vec<Goal>,
}

⊢ GoalStack {
    rite new(max_goals: usize) -> Self {
        Self {
            goals: HashMap·new(),
            hierarchy: HashMap·new(),
            max_goals,
            history: Vec·new(),
        }
    }

    rite from_goals(goals: Vec<Goal>) -> Self {
        ≔ Δ stack = Self·new(10);
        ∀ goal ∈ goals {
            stack.push(goal);
        }
        stack
    }

    /// Get current highest-priority active goal
    rite current(&self) -> Option<&Goal> {
        self.goals.values()
            .filter(|g| g.is_active())
            .max_by(|a, b| a.priority.partial_cmp(&b.priority).unwrap())
    }

    /// Push a new goal
    rite push(&Δ self, Δ goal: Goal) {
        // Activate ⎇ under limit
        ≔ active_count = self.goals.values()
            .filter(|g| g.is_active())
            .count();

        ⎇ active_count < self.max_goals {
            goal.status = GoalStatus·Active;
        }

        ≔ id = goal.id.clone();

        // Track hierarchy
        ⎇ ≔ Some(parent) = &goal.parent {
            self.hierarchy.entry(parent.clone())
                .or_default()
                .push(id.clone());
        }

        self.goals.insert(id, goal);
    }

    /// Complete a goal
    rite complete(&Δ self, id: GoalId, outcome: Outcome) {
        ⎇ ≔ Some(goal) = self.goals.get_mut(&id) {
            goal.status = GoalStatus·Completed {
                at: Timestamp·now(),
                outcome,
            };

            // Check ⎇ parent can be completed
            ⎇ ≔ Some(parent_id) = &goal.parent {
                self.check_parent_completion(parent_id.clone());
            }
        }
    }

    /// Abandon a goal
    rite abandon(&Δ self, id: GoalId, reason: String) {
        ⎇ ≔ Some(goal) = self.goals.get_mut(&id) {
            goal.status = GoalStatus·Abandoned {
                at: Timestamp·now(),
                reason,
            };
        }
    }

    /// Suspend a goal
    rite suspend(&Δ self, id: GoalId, reason: String) {
        ⎇ ≔ Some(goal) = self.goals.get_mut(&id) {
            goal.status = GoalStatus·Suspended { reason };
        }
    }

    /// Resume a goal
    rite resume(&Δ self, id: GoalId) {
        ⎇ ≔ Some(goal) = self.goals.get_mut(&id) {
            ⎇ matches!(goal.status, GoalStatus·Suspended { .. }) {
                goal.status = GoalStatus·Active;
            }
        }
    }

    /// Get all goals
    rite all(&self) -> ⊢ Iterator<Item = &Goal> {
        self.goals.values()
    }

    rite check_parent_completion(&Δ self, parent_id: GoalId) {
        ⎇ ≔ Some(children) = self.hierarchy.get(&parent_id) {
            ≔ all_complete = children.iter().all(|child_id| {
                self.goals.get(child_id)
                    .map(|g| g.is_complete())
                    .unwrap_or(true)
            });

            ⎇ all_complete {
                self.complete(parent_id, Outcome·Success(Value·empty()));
            }
        }
    }
}

// ============================================================================
// Heartbeat Engine
// ============================================================================

/// Manages the daemon heartbeat cycle
☉ Σ HeartbeatEngine {
    /// Heartbeat interval
    interval: Duration,

    /// Last heartbeat time
    ☉ last_beat: Timestamp,

    /// Metrics
    metrics: HeartbeatMetrics,
}

☉ Σ HeartbeatMetrics {
    ☉ total_beats: u64,
    ☉ total_duration: Duration,
    ☉ avg_duration: Duration,
}

⊢ HeartbeatEngine {
    rite new(interval: Duration) -> Self {
        Self {
            interval,
            last_beat: Timestamp·now(),
            metrics: HeartbeatMetrics {
                total_beats: 0,
                total_duration: Duration·zero(),
                avg_duration: Duration·zero(),
            },
        }
    }

    /// Execute one heartbeat cycle
    rite beat(&Δ self, daemon: &Δ Daemon) -> Result<HeartbeatResult, HeartbeatError> {
        ≔ start = Timestamp·now();

        // Phase 1: Perceive
        ≔ observations = daemon.perceive();

        // Phase 2: Remember
        ∀ obs ∈ &observations {
            daemon.memory.experience(Event·observation(obs.clone()));
        }

        // Phase 3: Reflect (build context)
        ≔ context = daemon.attend()?;

        // Phase 4: Deliberate
        ≔ action = daemon.deliberate(&context)?;

        // Phase 5: Act
        ≔ result = daemon.execute(action.clone())?;

        // Phase 6: Learn
        daemon.learn(&action, &result);

        // Update metrics
        ≔ duration = start.elapsed();
        self.metrics.total_beats += 1;
        self.metrics.total_duration = self.metrics.total_duration + duration;
        self.metrics.avg_duration = self.metrics.total_duration / self.metrics.total_beats as u32;

        self.last_beat = Timestamp·now();

        Ok(HeartbeatResult {
            observations,
            context,
            action,
            result,
            duration,
        })
    }

    /// Wait until next heartbeat should occur
    rite wait_for_next(&self) {
        ≔ elapsed = self.last_beat.elapsed();
        ⎇ elapsed < self.interval {
            std·thread·sleep(self.interval - elapsed);
        }
    }
}

☉ Σ HeartbeatResult {
    ☉ observations: Vec<Observation>,
    ☉ context: Context,
    ☉ action: Action,
    ☉ result: ActionResult,
    ☉ duration: Duration,
}

☉ ᛈ HeartbeatError {
    PerceptionFailed(String),
    ContextFailed(String),
    DeliberationFailed(String),
    ExecutionFailed(String),
}

⊢ From<DaemonError> ∀ HeartbeatError {
    rite from(e: DaemonError) -> Self {
        ⌥ e {
            DaemonError·NoActiveGoal => HeartbeatError·DeliberationFailed("No active goal".to_string()),
            DaemonError·ToolNotFound(t) => HeartbeatError·ExecutionFailed(format!("Tool not found: {}", t)),
            _ => HeartbeatError·ExecutionFailed(format!("{:?}", e)),
        }
    }
}

// ============================================================================
// Errors
// ============================================================================

☉ ᛈ DaemonError {
    CorruptSnapshot,
    NoActiveGoal,
    ToolNotFound(String),
    ToolExecutionFailed(String),
    ActionNotAllowed(String),
    MemoryError(String),
    ConfigurationError(String),
}

⊢ Debug ∀ DaemonError {
    rite fmt(self, f) {
        ⌥ self {
            DaemonError·CorruptSnapshot => write!(f, "CorruptSnapshot"),
            DaemonError·NoActiveGoal => write!(f, "NoActiveGoal"),
            DaemonError·ToolNotFound(t) => write!(f, "ToolNotFound({})", t),
            DaemonError·ToolExecutionFailed(e) => write!(f, "ToolExecutionFailed({})", e),
            DaemonError·ActionNotAllowed(a) => write!(f, "ActionNotAllowed({})", a),
            DaemonError·MemoryError(e) => write!(f, "MemoryError({})", e),
            DaemonError·ConfigurationError(e) => write!(f, "ConfigurationError({})", e),
        }
    }
}
