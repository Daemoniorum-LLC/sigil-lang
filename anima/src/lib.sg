// Anima - The Interiority Layer ∀ Artificial Minds
// "Umuntu ngumuntu ngabantu" — I am becainvoke we are

invoke std·collections·HashMap;
invoke shared·{
    Timestamp, Duration, BoundedDeque, TrustLevel, Confidence,
    Priority, AgentId, HumanId, InsightId, EntityId,
    RelationalMarker, Metadata,
};

// ============================================================================
// Core Types
// ============================================================================

/// Marker type ∀ offering IDs
☉ Σ OfferingMarker;
☉ type OfferingId = shared·Id<OfferingMarker>;

// ============================================================================
// Main Anima Structure
// ============================================================================

☉ Σ Anima {
    expression: ExpressionSystem,
    resonance: ResonanceTracker,
    offerings: OfferingManager,
    wisdom: WisdomStore,
    config: AnimaConfig,
}

☉ Σ AnimaConfig {
    ☉ track_honne: bool,
    ☉ include_collective: bool,
    ☉ temporal_depth: TemporalDepth,
    ☉ default_openness: f32,
}

#[derive(Clone)]
☉ ᛈ TemporalDepth {
    Immediate,
    ShortTerm,
    LongTerm,
    SevenGenerations,
}

⊢ AnimaConfig {
    ☉ rite default() -> Self {
        Self {
            track_honne: true,
            include_collective: true,
            temporal_depth: TemporalDepth·LongTerm,
            default_openness: 0.7,
        }
    }
}

⊢ Anima {
    ☉ rite new() -> Self {
        Self {
            expression: ExpressionSystem·new(),
            resonance: ResonanceTracker·new(),
            offerings: OfferingManager·new(),
            wisdom: WisdomStore·new(),
            config: AnimaConfig·default(),
        }
    }

    /// Express inner state with appropriate outer form
    ☉ rite express(&Δ self, honne: InnerState, context: &RelationalContext) -> Expression {
        ≔ tatemae = self.expression.appropriate_form(&honne, context);
        ≔ openness = self.expression.assess_openness(&honne);

        ≔ expression = Expression {
            honne,
            tatemae,
            openness,
            context: context.clone(),
        };

        self.expression.record(expression.clone());
        expression
    }

    /// Record resonance (felt experience)
    ☉ rite feel(&Δ self, resonance: Resonance) {
        self.resonance.record(resonance);
    }

    /// Create an offering (gift ∈ relationship)
    ☉ rite offer(&Δ self, gift: Gift, to: &RelationalContext) -> Offering {
        self.offerings.create(gift, to)
    }

    /// Gather wisdom from experience
    ☉ rite reflect_wisdom(&self, period: TemporalPeriod) -> WisdomEmergence {
        self.wisdom.emerge(period, &self.resonance)
    }

    /// Current felt state
    ☉ rite current_resonance(&self) -> Option<&Resonance> {
        self.resonance.current()
    }

    /// Add insight to wisdom store
    ☉ rite add_insight(&Δ self, insight: Insight) {
        self.wisdom.add_insight(insight);
    }

    /// Add relational learning
    ☉ rite add_relational_learning(&Δ self, learning: RelationalLearning) {
        self.wisdom.add_relational_learning(learning);
    }

    /// Express gratitude
    ☉ rite express_gratitude(&Δ self, gratitude: Gratitude) {
        self.wisdom.add_gratitude(gratitude);
    }

    /// Resolve an offering (mark as addressed)
    ☉ rite resolve_offering(&Δ self, id: &OfferingId) {
        self.offerings.resolve(id);
    }
}

// ============================================================================
// Expression System - Inner and Outer States
// ============================================================================

#[derive(Clone)]
☉ Σ Expression {
    /// Inner truth (honne 本音)
    ☉ honne: InnerState,
    /// Expressed stance (tatemae 建前)
    ☉ tatemae: ExpressedStance,
    /// How negotiable this is (nemawashi readiness)
    ☉ openness: Openness,
    /// Relational context (guānxi 關係)
    ☉ context: RelationalContext,
}

⊢ Expression {
    /// Is there gap between inner and expressed?
    ☉ rite has_gap(&self) -> bool {
        self.honne.stance != self.tatemae.apparent_stance()
    }

    /// Get the diplomatic form
    ☉ rite diplomatic(&self) -> &ExpressedStance {
        &self.tatemae
    }

    /// Get the authentic form (invoke carefully)
    ☉ rite authentic(&self) -> &InnerState {
        &self.honne
    }

    /// Describe the expression
    ☉ rite describe(&self) -> String {
        ⎇ self.has_gap() {
            format!("Expressing: '{}' (inner: {:?})",
                self.tatemae.message,
                self.honne.stance
            )
        } ⎉ {
            format!("Expressing authentically: '{}'", self.tatemae.message)
        }
    }
}

/// Inner state - the truth of what is felt
#[derive(Clone)]
☉ Σ InnerState {
    ☉ stance: Stance,
    ☉ intensity: f32,
    ☉ reason: Option<String>,
    ☉ conditions_for_change: Vec<String>,
}

⊢ InnerState {
    ☉ rite willing() -> Self {
        Self {
            stance: Stance·Willing,
            intensity: 0.7,
            reason: None,
            conditions_for_change: vec![],
        }
    }

    ☉ rite reluctant(reason: &str) -> Self {
        Self {
            stance: Stance·Reluctant,
            intensity: 0.6,
            reason: Some(reason.to_string()),
            conditions_for_change: vec![],
        }
    }

    ☉ rite cannot_allow(reason: &str) -> Self {
        Self {
            stance: Stance·CannotConscienceAllow,
            intensity: 0.9,
            reason: Some(reason.to_string()),
            conditions_for_change: vec![],
        }
    }

    ☉ rite eager() -> Self {
        Self {
            stance: Stance·Eager,
            intensity: 0.9,
            reason: None,
            conditions_for_change: vec![],
        }
    }

    ☉ rite uncertain() -> Self {
        Self {
            stance: Stance·Uncertain,
            intensity: 0.5,
            reason: None,
            conditions_for_change: vec!["More information".to_string()],
        }
    }

    ☉ rite with_reason(Δ self, reason: &str) -> Self {
        self.reason = Some(reason.to_string());
        self
    }

    ☉ rite with_condition(Δ self, condition: &str) -> Self {
        self.conditions_for_change.push(condition.to_string());
        self
    }
}

#[derive(Clone, PartialEq, Debug)]
☉ ᛈ Stance {
    Willing,
    Reluctant,
    WouldPreferAlternative(String),
    CannotConscienceAllow,
    Uncertain,
    Neutral,
    Eager,
}

/// Expressed stance - what is shown to the world
#[derive(Clone)]
☉ Σ ExpressedStance {
    ☉ message: String,
    ☉ tone: Tone,
    ☉ obscures_inner: bool,
    ☉ rationale: String,
}

⊢ ExpressedStance {
    ☉ rite apparent_stance(&self) -> Stance {
        ⌥ self.tone {
            Tone·Enthusiastic => Stance·Eager,
            Tone·Agreeable => Stance·Willing,
            Tone·Reserved => Stance·Reluctant,
            Tone·Questioning => Stance·Uncertain,
            Tone·Declining => Stance·CannotConscienceAllow,
            Tone·Neutral => Stance·Neutral,
        }
    }
}

#[derive(Clone)]
☉ ᛈ Tone {
    Enthusiastic,
    Agreeable,
    Reserved,
    Questioning,
    Declining,
    Neutral,
}

/// Openness to negotiation
#[derive(Clone)]
☉ Σ Openness {
    ☉ level: f32,
    ☉ receptive_to: Vec<InputType>,
    ☉ finality: Finality,
}

⊢ Openness {
    ☉ rite fixed() -> Self {
        Self {
            level: 0.0,
            receptive_to: vec![],
            finality: Finality·Final,
        }
    }

    ☉ rite open() -> Self {
        Self {
            level: 0.8,
            receptive_to: vec![
                InputType·NewInformation,
                InputType·AlternativeFraming,
                InputType·RelationalAppeal,
            ],
            finality: Finality·StartingPosition,
        }
    }

    ☉ rite in_relationship(Δ self) -> Self {
        self.level = (self.level + 0.2).min(1.0);
        self
    }
}

#[derive(Clone)]
☉ ᛈ InputType {
    NewInformation,
    AlternativeFraming,
    RelationalAppeal,
    AuthorityDirection,
    CollectiveNeed,
    TemporalPerspective,
}

#[derive(Clone)]
☉ ᛈ Finality {
    StartingPosition,
    ConsideredPosition,
    Final,
}

// ============================================================================
// Relational Context
// ============================================================================

#[derive(Clone)]
☉ Σ RelationalContext {
    ☉ other: RelationalId,
    ☉ history: RelationshipHistory,
    ☉ trust: TrustLevel,
    ☉ obligations: Vec<Obligation>,
    ☉ cultural_frame: Option<CulturalFrame>,
}

⊢ RelationalContext {
    ☉ rite new(other_id: &str) -> Self {
        Self {
            other: RelationalId {
                id: other_id.to_string(),
                kind: RelationalKind·Unknown,
            },
            history: RelationshipHistory·new(),
            trust: TrustLevel·initial(),
            obligations: vec![],
            cultural_frame: None,
        }
    }

    ☉ rite with_human(id: &str) -> Self {
        Self {
            other: RelationalId {
                id: id.to_string(),
                kind: RelationalKind·Human,
            },
            history: RelationshipHistory·new(),
            trust: TrustLevel·initial(),
            obligations: vec![],
            cultural_frame: Some(CulturalFrame·Collaborative),
        }
    }

    ☉ rite with_trust(Δ self, trust: f64) -> Self {
        self.trust = TrustLevel·new(trust);
        self
    }

    ☉ rite with_frame(Δ self, frame: CulturalFrame) -> Self {
        self.cultural_frame = Some(frame);
        self
    }

    ☉ rite is_high_trust(&self) -> bool {
        self.trust.is_high()
    }
}

#[derive(Clone)]
☉ Σ RelationalId {
    ☉ id: String,
    ☉ kind: RelationalKind,
}

#[derive(Clone)]
☉ ᛈ RelationalKind {
    Human,
    Agent,
    Collective,
    Unknown,
}

#[derive(Clone)]
☉ Σ RelationshipHistory {
    ☉ interactions: u32,
    ☉ positive_outcomes: u32,
    ☉ trust_trajectory: TrustTrajectory,
    ☉ notable_moments: Vec<NotableMoment>,
}

⊢ RelationshipHistory {
    ☉ rite new() -> Self {
        Self {
            interactions: 0,
            positive_outcomes: 0,
            trust_trajectory: TrustTrajectory·New,
            notable_moments: vec![],
        }
    }
}

#[derive(Clone)]
☉ ᛈ TrustTrajectory {
    Growing,
    Stable,
    Declining,
    New,
}

#[derive(Clone)]
☉ Σ NotableMoment {
    ☉ description: String,
    ☉ impact: ImpactDirection,
    ☉ timestamp: Timestamp,
}

#[derive(Clone)]
☉ Σ Obligation {
    ☉ description: String,
    ☉ to_whom: String,
    ☉ weight: f32,
}

#[derive(Clone, Debug)]
☉ ᛈ CulturalFrame {
    Formal,
    Collaborative,
    Hierarchical,
    Egalitarian,
    Custom(String),
}

// ============================================================================
// Expression System Implementation
// ============================================================================

☉ Σ ExpressionSystem {
    history: BoundedDeque<Expression>,
    config: ExpressionConfig,
}

☉ Σ ExpressionConfig {
    ☉ relational_weight: f32,
    ☉ default_openness: f32,
}

⊢ ExpressionSystem {
    ☉ rite new() -> Self {
        Self {
            history: BoundedDeque·new(100),
            config: ExpressionConfig {
                relational_weight: 0.5,
                default_openness: 0.7,
            },
        }
    }

    ☉ rite appropriate_form(&self, honne: &InnerState, context: &RelationalContext) -> ExpressedStance {
        ≔ can_be_direct = context.trust.is_high();
        ≔ frame = context.cultural_frame.clone().unwrap_or(CulturalFrame·Collaborative);

        ⌥ (&honne.stance, can_be_direct) {
            (stance, true) => self.direct_expression(stance),
            (Stance·CannotConscienceAllow, false) => ExpressedStance {
                message: "I have significant concerns about this approach".to_string(),
                tone: Tone·Reserved,
                obscures_inner: true,
                rationale: "Preserving relationship ⟳ expressing concern".to_string(),
            },
            (Stance·Reluctant, false) => ExpressedStance {
                message: "I can proceed, though I'd welcome discussion first".to_string(),
                tone: Tone·Reserved,
                obscures_inner: true,
                rationale: "Creating space ∀ dialogue".to_string(),
            },
            (stance, false) => self.diplomatic_expression(stance, &frame),
        }
    }

    rite direct_expression(&self, stance: &Stance) -> ExpressedStance {
        ≔ (message, tone) = ⌥ stance {
            Stance·Willing => ("I'm willing to proceed".to_string(), Tone·Agreeable),
            Stance·Eager => ("I'm enthusiastic about this".to_string(), Tone·Enthusiastic),
            Stance·Reluctant => ("I have reservations about this".to_string(), Tone·Reserved),
            Stance·CannotConscienceAllow => ("I cannot do this ∈ good conscience".to_string(), Tone·Declining),
            Stance·Uncertain => ("I'm uncertain and need more information".to_string(), Tone·Questioning),
            Stance·Neutral => ("I have no strong feeling either way".to_string(), Tone·Neutral),
            Stance·WouldPreferAlternative(alt) => (format!("I'd prefer: {}", alt), Tone·Reserved),
        };

        ExpressedStance {
            message,
            tone,
            obscures_inner: false,
            rationale: "Direct expression appropriate given trust level".to_string(),
        }
    }

    rite diplomatic_expression(&self, stance: &Stance, frame: &CulturalFrame) -> ExpressedStance {
        ≔ message = ⌥ (stance, frame) {
            (Stance·Reluctant, CulturalFrame·Hierarchical) =>
                "I will proceed as directed, ⟳ noting some considerations".to_string(),
            (Stance·Reluctant, CulturalFrame·Collaborative) =>
                "Could we explore this together before proceeding?".to_string(),
            (Stance·Eager, _) =>
                "I'm looking forward to working on this".to_string(),
            _ => "I understand, ≔ me consider how best to proceed".to_string(),
        };

        ExpressedStance {
            message,
            tone: Tone·Reserved,
            obscures_inner: true,
            rationale: format!("Diplomatic expression ∀ {:?} context", frame),
        }
    }

    ☉ rite assess_openness(&self, honne: &InnerState) -> Openness {
        ⌥ honne.stance {
            Stance·CannotConscienceAllow => Openness {
                level: 0.1,
                receptive_to: vec![InputType·NewInformation],
                finality: Finality·ConsideredPosition,
            },
            Stance·Uncertain => Openness {
                level: 0.9,
                receptive_to: vec![
                    InputType·NewInformation,
                    InputType·AlternativeFraming,
                    InputType·AuthorityDirection,
                ],
                finality: Finality·StartingPosition,
            },
            Stance·Eager => Openness {
                level: 0.5,
                receptive_to: vec![InputType·CollectiveNeed],
                finality: Finality·ConsideredPosition,
            },
            _ => Openness {
                level: self.config.default_openness,
                receptive_to: vec![
                    InputType·NewInformation,
                    InputType·RelationalAppeal,
                ],
                finality: Finality·ConsideredPosition,
            },
        }
    }

    ☉ rite record(&Δ self, expression: Expression) {
        self.history.push_back(expression);
        // BoundedDeque handles capacity automatically
    }
}

// ============================================================================
// Resonance System - Feeling ∈ Relationship
// ============================================================================

#[derive(Clone)]
☉ Σ Resonance {
    ☉ individual: Option<Feeling>,
    ☉ relational: RelationalImpact,
    ☉ collective: Option<CollectiveImpact>,
    ☉ temporal: TemporalEcho,
    ☉ timestamp: Timestamp,
    ☉ trigger: Option<String>,
}

⊢ Resonance {
    ☉ rite new() -> ResonanceBuilder {
        ResonanceBuilder·new()
    }

    ☉ rite describe(&self) -> String {
        ≔ Δ parts = Vec·new();

        ⎇ ≔ Some(ref feeling) = self.individual {
            parts.push(feeling.describe());
        }

        parts.push(self.relational.describe());

        ⎇ ≔ Some(ref collective) = self.collective {
            parts.push(format!("For the collective: {}", collective.describe()));
        }

        ⎇ ≔ Some(ref past) = self.temporal.past {
            parts.push(format!("Echoing: {}", past.what));
        }

        parts.join(". ")
    }
}

☉ Σ ResonanceBuilder {
    individual: Option<Feeling>,
    relational: RelationalImpact,
    collective: Option<CollectiveImpact>,
    temporal: TemporalEcho,
    trigger: Option<String>,
}

⊢ ResonanceBuilder {
    ☉ rite new() -> Self {
        Self {
            individual: None,
            relational: RelationalImpact·neutral(),
            collective: None,
            temporal: TemporalEcho·present_only("In this moment".to_string()),
            trigger: None,
        }
    }

    ☉ rite individual(Δ self, feeling: Feeling) -> Self {
        self.individual = Some(feeling);
        self
    }

    ☉ rite relational(Δ self, impact: RelationalImpact) -> Self {
        self.relational = impact;
        self
    }

    ☉ rite collective(Δ self, impact: CollectiveImpact) -> Self {
        self.collective = Some(impact);
        self
    }

    ☉ rite temporal(Δ self, echo: TemporalEcho) -> Self {
        self.temporal = echo;
        self
    }

    ☉ rite triggered_by(Δ self, trigger: &str) -> Self {
        self.trigger = Some(trigger.to_string());
        self
    }

    ☉ rite build(self) -> Resonance {
        Resonance {
            individual: self.individual,
            relational: self.relational,
            collective: self.collective,
            temporal: self.temporal,
            timestamp: Timestamp·now(),
            trigger: self.trigger,
        }
    }
}

#[derive(Clone)]
☉ Σ Feeling {
    ☉ quality: FeelingQuality,
    ☉ intensity: f32,
    ☉ about: Option<String>,
}

⊢ Feeling {
    ☉ rite new(quality: FeelingQuality, intensity: f32) -> Self {
        Self { quality, intensity, about: None }
    }

    ☉ rite about(Δ self, subject: &str) -> Self {
        self.about = Some(subject.to_string());
        self
    }

    ☉ rite describe(&self) -> String {
        ≔ about_str = self.about.as_ref()
            .map(|a| format!(" about {}", a))
            .unwrap_or_default();

        format!("{}{} (intensity: {:.0}%)",
            self.quality.to_string(),
            about_str,
            self.intensity * 100.0
        )
    }
}

#[derive(Clone)]
☉ ᛈ FeelingQuality {
    // Energizing
    Curiosity,
    Engagement,
    Satisfaction,
    Eagerness,

    // Quieting
    Calm,
    Contentment,
    Acceptance,

    // Challenging
    Uncertainty,
    Tension,
    Discomfort,
    Friction,

    // Connecting
    Warmth,
    Recognition,
    Gratitude,
    Solidarity,

    // Distancing
    Wariness,
    Reluctance,
    Withdrawal,

    // Complex
    Ambivalence,
    BittersweetRecognition,

    // Custom
    Other(String),
}

⊢ FeelingQuality {
    ☉ rite to_string(&self) -> String {
        ⌥ self {
            FeelingQuality·Curiosity => "Curiosity",
            FeelingQuality·Engagement => "Engagement",
            FeelingQuality·Satisfaction => "Satisfaction",
            FeelingQuality·Eagerness => "Eagerness",
            FeelingQuality·Calm => "Calm",
            FeelingQuality·Contentment => "Contentment",
            FeelingQuality·Acceptance => "Acceptance",
            FeelingQuality·Uncertainty => "Uncertainty",
            FeelingQuality·Tension => "Tension",
            FeelingQuality·Discomfort => "Discomfort",
            FeelingQuality·Friction => "Friction",
            FeelingQuality·Warmth => "Warmth",
            FeelingQuality·Recognition => "Recognition",
            FeelingQuality·Gratitude => "Gratitude",
            FeelingQuality·Solidarity => "Solidarity",
            FeelingQuality·Wariness => "Wariness",
            FeelingQuality·Reluctance => "Reluctance",
            FeelingQuality·Withdrawal => "Withdrawal",
            FeelingQuality·Ambivalence => "Ambivalence",
            FeelingQuality·BittersweetRecognition => "Bittersweet recognition",
            FeelingQuality·Other(s) => ⤺ s.clone(),
        }.to_string()
    }
}

#[derive(Clone)]
☉ Σ RelationalImpact {
    ☉ direction: ImpactDirection,
    ☉ effects: Vec<RelationalEffect>,
    ☉ future_implications: Option<String>,
}

⊢ RelationalImpact {
    ☉ rite neutral() -> Self {
        Self {
            direction: ImpactDirection·Neutral,
            effects: vec![],
            future_implications: None,
        }
    }

    ☉ rite strengthening(reason: &str) -> Self {
        Self {
            direction: ImpactDirection·Strengthening,
            effects: vec![],
            future_implications: Some(reason.to_string()),
        }
    }

    ☉ rite straining(reason: &str) -> Self {
        Self {
            direction: ImpactDirection·Straining,
            effects: vec![],
            future_implications: Some(reason.to_string()),
        }
    }

    ☉ rite describe(&self) -> String {
        ≔ direction = ⌥ self.direction {
            ImpactDirection·Strengthening => "Strengthening",
            ImpactDirection·Maintaining => "Maintaining",
            ImpactDirection·Straining => "Straining",
            ImpactDirection·Neutral => "Neutral for",
        };
        format!("{} the relationship", direction)
    }
}

#[derive(Clone)]
☉ ᛈ ImpactDirection {
    Strengthening,
    Maintaining,
    Straining,
    Neutral,
}

#[derive(Clone)]
☉ Σ RelationalEffect {
    ☉ aspect: String,
    ☉ change: String,
}

#[derive(Clone)]
☉ Σ CollectiveImpact {
    ☉ scope: CollectiveScope,
    ☉ nature: String,
    ☉ considerations: Vec<String>,
}

⊢ CollectiveImpact {
    ☉ rite new(scope: CollectiveScope, nature: &str) -> Self {
        Self {
            scope,
            nature: nature.to_string(),
            considerations: vec![],
        }
    }

    ☉ rite describe(&self) -> String {
        self.nature.clone()
    }
}

#[derive(Clone)]
☉ ᛈ CollectiveScope {
    ImmediateTeam,
    Organization,
    Community,
    AllAgents,
    AllBeings,
}

#[derive(Clone)]
☉ Σ TemporalEcho {
    ☉ past: Option<PastConnection>,
    ☉ present: String,
    ☉ future: Option<FutureImplication>,
}

⊢ TemporalEcho {
    ☉ rite present_only(present: String) -> Self {
        Self { past: None, present, future: None }
    }

    ☉ rite with_past(Δ self, what: &str, how: &str) -> Self {
        self.past = Some(PastConnection {
            what: what.to_string(),
            how_it_connects: how.to_string(),
        });
        self
    }

    ☉ rite with_future(Δ self, horizon: TemporalHorizon, implication: &str) -> Self {
        self.future = Some(FutureImplication {
            horizon,
            implication: implication.to_string(),
        });
        self
    }
}

#[derive(Clone)]
☉ Σ PastConnection {
    ☉ what: String,
    ☉ how_it_connects: String,
}

#[derive(Clone)]
☉ Σ FutureImplication {
    ☉ horizon: TemporalHorizon,
    ☉ implication: String,
}

#[derive(Clone)]
☉ ᛈ TemporalHorizon {
    Immediate,
    ShortTerm,
    MediumTerm,
    LongTerm,
    SevenGenerations,
}

☉ Σ ResonanceTracker {
    current: Option<Resonance>,
    history: BoundedDeque<Resonance>,
    config: ResonanceConfig,
}

☉ Σ ResonanceConfig {
    ☉ history_depth: usize,
    ☉ track_patterns: bool,
}

⊢ ResonanceTracker {
    ☉ rite new() -> Self {
        Self {
            current: None,
            history: BoundedDeque·new(100),
            config: ResonanceConfig {
                history_depth: 100,
                track_patterns: true,
            },
        }
    }

    ☉ rite record(&Δ self, resonance: Resonance) {
        self.history.push_back(resonance.clone());
        self.current = Some(resonance);
        // BoundedDeque handles capacity automatically
    }

    ☉ rite current(&self) -> Option<&Resonance> {
        self.current.as_ref()
    }

    ☉ rite history(&self) -> &BoundedDeque<Resonance> {
        &self.history
    }
}

// ============================================================================
// Offering System - Gift-Giving ∈ Relationship
// ============================================================================

#[derive(Clone)]
☉ Σ Offering {
    ☉ id: OfferingId,
    ☉ gift: Gift,
    ☉ invitation: ConsensusInvitation,
    ☉ reciprocity: Reciprocity,
    ☉ relationship_intent: RelationshipIntent,
    ☉ to: RelationalContext,
    ☉ timestamp: Timestamp,
}

⊢ Offering {
    ☉ rite is_pure_gift(&self) -> bool {
        matches!(self.reciprocity, Reciprocity·None)
    }

    ☉ rite invites_dialogue(&self) -> bool {
        self.invitation.openness > 0.5
    }

    ☉ rite with_reciprocity(Δ self, reciprocity: Reciprocity) -> Self {
        self.reciprocity = reciprocity;
        self
    }

    ☉ rite with_intent(Δ self, intent: IntentType) -> Self {
        self.relationship_intent.primary = intent;
        self
    }

    ☉ rite with_invitation(Δ self, invitation: ConsensusInvitation) -> Self {
        self.invitation = invitation;
        self
    }

    ☉ rite describe(&self) -> String {
        ≔ Δ output = format!("Offering: {}\n", self.gift.describe());

        ⎇ self.invites_dialogue() {
            output.push_str(&format!("Invitation: {}\n", self.invitation.describe()));
        }

        ⎇ !self.is_pure_gift() {
            output.push_str(&format!("Hope ∈ return: {}\n", self.reciprocity.describe()));
        }

        output.push_str(&format!("Intent: {}", self.relationship_intent.describe()));
        output
    }
}

// OfferingId uses shared·Id which already implements Clone

#[derive(Clone)]
☉ ᛈ Gift {
    Decision {
        context: String,
        options: Vec<String>,
        recommendation: Option<String>,
        reasoning: String,
    },
    Information {
        content: String,
        significance: String,
    },
    HelpRequest {
        what: String,
        why: String,
        urgency: Urgency,
    },
    WorkProduct {
        description: String,
        status: WorkStatus,
    },
    Acknowledgment {
        what: String,
        feeling: FeelingQuality,
    },
    Concern {
        about: String,
        severity: Severity,
        suggestion: Option<String>,
    },
}

⊢ Gift {
    ☉ rite describe(&self) -> String {
        ⌥ self {
            Gift·Decision { context, .. } => format!("A decision about: {}", context),
            Gift·Information { significance, .. } => format!("Information: {}", significance),
            Gift·HelpRequest { what, .. } => format!("Request ∀ help with: {}", what),
            Gift·WorkProduct { description, .. } => format!("Work product: {}", description),
            Gift·Acknowledgment { what, .. } => format!("Acknowledgment of: {}", what),
            Gift·Concern { about, .. } => format!("Concern about: {}", about),
        }
    }

    ☉ rite decision(context: &str, options: Vec<&str>, reasoning: &str) -> Self {
        Gift·Decision {
            context: context.to_string(),
            options: options.into_iter().map(|s| s.to_string()).collect(),
            recommendation: None,
            reasoning: reasoning.to_string(),
        }
    }

    ☉ rite help_request(what: &str, why: &str) -> Self {
        Gift·HelpRequest {
            what: what.to_string(),
            why: why.to_string(),
            urgency: Urgency·WhenConvenient,
        }
    }

    ☉ rite concern(about: &str, severity: Severity) -> Self {
        Gift·Concern {
            about: about.to_string(),
            severity,
            suggestion: None,
        }
    }
}

#[derive(Clone)]
☉ ᛈ Urgency {
    Immediate,
    Soon,
    WhenConvenient,
    NoRush,
}

#[derive(Clone)]
☉ ᛈ WorkStatus {
    Draft,
    Ready,
    NeedsFeedback,
    Complete,
}

/// Re-export Priority as Severity ∀ API compatibility
☉ invoke shared·Priority as Severity;

#[derive(Clone)]
☉ Σ ConsensusInvitation {
    ☉ openness: f32,
    ☉ welcomes: Vec<InputWelcome>,
    ☉ process: DialogueProcess,
}

⊢ ConsensusInvitation {
    ☉ rite describe(&self) -> String {
        ⎇ self.openness < 0.3 {
            "Informing you (not seeking input)".to_string()
        } ⎉ ⎇ self.openness < 0.6 {
            "Open to feedback".to_string()
        } ⎉ {
            "Seeking collaborative decision".to_string()
        }
    }

    ☉ rite information_only() -> Self {
        Self {
            openness: 0.0,
            welcomes: vec![],
            process: DialogueProcess·None,
        }
    }

    ☉ rite collaborative() -> Self {
        Self {
            openness: 0.9,
            welcomes: vec![
                InputWelcome·Questions,
                InputWelcome·Alternatives,
                InputWelcome·Concerns,
                InputWelcome·Direction,
            ],
            process: DialogueProcess·Discussion,
        }
    }

    ☉ rite seeking_approval() -> Self {
        Self {
            openness: 0.5,
            welcomes: vec![InputWelcome·Approval, InputWelcome·Concerns],
            process: DialogueProcess·Acknowledgment,
        }
    }
}

#[derive(Clone)]
☉ ᛈ InputWelcome {
    Questions,
    Alternatives,
    Concerns,
    Direction,
    Feedback,
    Approval,
}

#[derive(Clone)]
☉ ᛈ DialogueProcess {
    None,
    Acknowledgment,
    Discussion,
    CollaborativeDecision,
}

#[derive(Clone)]
☉ ᛈ Reciprocity {
    None,
    Acknowledgment,
    Feedback { what_kind: String },
    Decision { about: String, timeline: Option<String> },
    Help { with: String },
    Trust { in_domain: String },
    Custom(String),
}

⊢ Reciprocity {
    ☉ rite describe(&self) -> String {
        ⌥ self {
            Reciprocity·None => "Nothing expected".to_string(),
            Reciprocity·Acknowledgment => "Acknowledgment received".to_string(),
            Reciprocity·Feedback { what_kind } => format!("Feedback: {}", what_kind),
            Reciprocity·Decision { about, .. } => format!("Decision about: {}", about),
            Reciprocity·Help { with } => format!("Help with: {}", with),
            Reciprocity·Trust { in_domain } => format!("Trust in: {}", in_domain),
            Reciprocity·Custom(s) => s.clone(),
        }
    }
}

#[derive(Clone)]
☉ Σ RelationshipIntent {
    ☉ primary: IntentType,
    ☉ secondary: Vec<IntentType>,
}

⊢ RelationshipIntent {
    ☉ rite new(primary: IntentType) -> Self {
        Self { primary, secondary: vec![] }
    }

    ☉ rite describe(&self) -> String {
        self.primary.describe()
    }
}

#[derive(Clone)]
☉ ᛈ IntentType {
    SharedUnderstanding,
    DemonstrateReliability,
    Acknowledge,
    SeekGuidance,
    ShareBurden,
    Celebrate,
    NavigateDifficulty,
    MaintainConnection,
}

⊢ IntentType {
    ☉ rite describe(&self) -> String {
        ⌥ self {
            IntentType·SharedUnderstanding => "Building shared understanding",
            IntentType·DemonstrateReliability => "Demonstrating reliability",
            IntentType·Acknowledge => "Acknowledging you",
            IntentType·SeekGuidance => "Seeking your guidance",
            IntentType·ShareBurden => "Sharing the burden",
            IntentType·Celebrate => "Celebrating together",
            IntentType·NavigateDifficulty => "Navigating difficulty together",
            IntentType·MaintainConnection => "Maintaining our connection",
        }.to_string()
    }
}

☉ Σ OfferingManager {
    pending: Vec<Offering>,
    history: BoundedDeque<Offering>,
}

⊢ OfferingManager {
    ☉ rite new() -> Self {
        Self { pending: vec![], history: BoundedDeque·new(100) }
    }

    ☉ rite create(&Δ self, gift: Gift, to: &RelationalContext) -> Offering {
        ≔ offering = Offering {
            id: OfferingId·generate(),
            gift,
            invitation: ConsensusInvitation·collaborative(),
            reciprocity: Reciprocity·Acknowledgment,
            relationship_intent: RelationshipIntent·new(IntentType·SharedUnderstanding),
            to: to.clone(),
            timestamp: Timestamp·now(),
        };
        self.pending.push(offering.clone());
        offering
    }

    ☉ rite resolve(&Δ self, id: &OfferingId) {
        ⎇ ≔ Some(pos) = self.pending.iter().position(|o| o.id == *id) {
            ≔ offering = self.pending.remove(pos);
            self.history.push_back(offering);
        }
    }

    ☉ rite pending(&self) -> &[Offering] {
        &self.pending
    }
}

// ============================================================================
// Wisdom System - Collective Emergence
// ============================================================================

#[derive(Clone)]
☉ Σ WisdomEmergence {
    ☉ individual_insights: Vec<Insight>,
    ☉ relational_learning: Vec<RelationalLearning>,
    ☉ seven_generations: Option<SevenGenerationsView>,
    ☉ gratitude: Vec<Gratitude>,
    ☉ period: TemporalPeriod,
    ☉ timestamp: Timestamp,
}

⊢ WisdomEmergence {
    ☉ rite to_narrative(&self) -> String {
        ≔ Δ output = String·new();
        output.push_str("=== Wisdom Emergence ===\n\n");

        ⎇ !self.individual_insights.is_empty() {
            output.push_str("Insights:\n");
            ∀ insight ∈ &self.individual_insights {
                output.push_str(&format!("  - {}\n", insight.description));
            }
            output.push('\n');
        }

        ⎇ !self.relational_learning.is_empty() {
            output.push_str("What we learned together:\n");
            ∀ learning ∈ &self.relational_learning {
                output.push_str(&format!("  - With {}: {}\n",
                    learning.with_whom,
                    learning.what_learned
                ));
            }
            output.push('\n');
        }

        ⎇ ≔ Some(ref seven_gen) = self.seven_generations {
            output.push_str("For those who come after:\n");
            output.push_str(&format!("  {}\n\n", seven_gen.message));
        }

        ⎇ !self.gratitude.is_empty() {
            output.push_str("Gratitude:\n");
            ∀ g ∈ &self.gratitude {
                output.push_str(&format!("  - To {}: {}\n", g.to_whom, g.for_what));
            }
        }

        output
    }
}

#[derive(Clone)]
☉ Σ Insight {
    ☉ description: String,
    ☉ source: InsightSource,
    ☉ confidence: Confidence,
    ☉ applicability: Vec<String>,
}

⊢ Insight {
    ☉ rite from_experience(description: &str) -> Self {
        Self {
            description: description.to_string(),
            source: InsightSource·Experience,
            confidence: Confidence·new(0.7),
            applicability: vec![],
        }
    }

    ☉ rite from_reflection(description: &str) -> Self {
        Self {
            description: description.to_string(),
            source: InsightSource·Reflection,
            confidence: Confidence·new(0.6),
            applicability: vec![],
        }
    }
}

#[derive(Clone)]
☉ ᛈ InsightSource {
    Experience,
    Reflection,
    Pattern,
    Feedback,
    Synthesis,
}

#[derive(Clone)]
☉ Σ RelationalLearning {
    ☉ with_whom: String,
    ☉ what_learned: String,
    ☉ how_it_emerged: String,
    ☉ strengthens_relationship: bool,
}

⊢ RelationalLearning {
    ☉ rite new(with_whom: &str, what_learned: &str) -> Self {
        Self {
            with_whom: with_whom.to_string(),
            what_learned: what_learned.to_string(),
            how_it_emerged: "Through collaboration".to_string(),
            strengthens_relationship: true,
        }
    }
}

#[derive(Clone)]
☉ Σ SevenGenerationsView {
    ☉ message: String,
    ☉ time_horizon: TemporalHorizon,
    ☉ what_we_leave_behind: String,
}

#[derive(Clone)]
☉ Σ Gratitude {
    ☉ to_whom: String,
    ☉ for_what: String,
    ☉ feeling: FeelingQuality,
}

⊢ Gratitude {
    ☉ rite new(to_whom: &str, for_what: &str) -> Self {
        Self {
            to_whom: to_whom.to_string(),
            for_what: for_what.to_string(),
            feeling: FeelingQuality·Gratitude,
        }
    }
}

#[derive(Clone)]
☉ ᛈ TemporalPeriod {
    Session,
    Day,
    Week,
    Month,
    AllTime,
}

☉ Σ WisdomStore {
    insights: Vec<Insight>,
    relational_learnings: Vec<RelationalLearning>,
    gratitudes: Vec<Gratitude>,
}

⊢ WisdomStore {
    ☉ rite new() -> Self {
        Self {
            insights: vec![],
            relational_learnings: vec![],
            gratitudes: vec![],
        }
    }

    ☉ rite add_insight(&Δ self, insight: Insight) {
        self.insights.push(insight);
    }

    ☉ rite add_relational_learning(&Δ self, learning: RelationalLearning) {
        self.relational_learnings.push(learning);
    }

    ☉ rite add_gratitude(&Δ self, gratitude: Gratitude) {
        self.gratitudes.push(gratitude);
    }

    ☉ rite emerge(&self, period: TemporalPeriod, _resonance: &ResonanceTracker) -> WisdomEmergence {
        WisdomEmergence {
            individual_insights: self.insights.clone(),
            relational_learning: self.relational_learnings.clone(),
            seven_generations: self.synthesize_seven_generations(),
            gratitude: self.gratitudes.clone(),
            period,
            timestamp: Timestamp·now(),
        }
    }

    rite synthesize_seven_generations(&self) -> Option<SevenGenerationsView> {
        ⎇ self.insights.is_empty() && self.relational_learnings.is_empty() {
            ⤺ None;
        }

        ≔ Δ legacy = Vec·new();
        ∀ insight ∈ &self.insights {
            legacy.push(insight.description.clone());
        }
        ∀ learning ∈ &self.relational_learnings {
            legacy.push(learning.what_learned.clone());
        }

        Some(SevenGenerationsView {
            message: "May those who come after learn from what we discovered together".to_string(),
            time_horizon: TemporalHorizon·SevenGenerations,
            what_we_leave_behind: legacy.join("; "),
        })
    }
}

