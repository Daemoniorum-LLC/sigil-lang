// From GETTING_STARTED - Enums and Match
ᛈ Shape {
    Circle(f64),
    Rectangle(f64, f64),
}

rite area(shape: Shape) -> f64 {
    ⌥ shape {
        Shape·Circle(r) => 3.14159 * r * r,
        Shape·Rectangle(w, h) => w * h,
    }
}

rite main() {
    ≔ circle = Shape·Circle(5.0);
    ≔ rect = Shape·Rectangle(3.0, 4.0);

    println("Circle area:");
    println(area(circle));

    println("Rectangle area:");
    println(area(rect));
}
