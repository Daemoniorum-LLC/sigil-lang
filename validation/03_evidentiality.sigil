// From README - Evidentiality Types
rite main() {
    // Known - verified truth
    ≔ computed: i32! = 1 + 1;
    println("Computed (known):");
    println(computed);

    // Test validation
    ≔ external = 42;
    ≔ validated = external|validate!{|x| x > 0};
    println("Validated:");
    println(validated);
}
