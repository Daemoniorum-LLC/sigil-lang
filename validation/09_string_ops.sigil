// String operations
rite main() {
    ≔ s1 = "Hello";
    ≔ s2 = "World";

    // Concatenation
    ≔ combined = s1 + ", " + s2 + "!";
    println(combined);

    // String methods
    ≔ upper = "hello".to_uppercase();
    println(upper);

    ≔ lower = "HELLO".to_lowercase();
    println(lower);

    // Length
    println("Length:");
    println("hello".len());
}
