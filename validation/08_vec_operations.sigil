// Vector operations
rite main() {
    ≔ vary v = vec![1, 2, 3];

    // Push
    v.push(4);
    v.push(5);
    println("After push:");
    println(v);

    // Length
    println("Length:");
    println(v.len());

    // Index access
    println("Index 2:");
    println(v[2]);

    // Iteration
    println("Iteration:");
    ∀ item ∈ v {
        println(item);
    }
}
