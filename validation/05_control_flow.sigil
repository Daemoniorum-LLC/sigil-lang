// From GETTING_STARTED - Control Flow
rite main() {
    // If expression
    ≔ a = 10;
    ≔ b = 5;
    ≔ max = ⎇ a > b { a } ⎉ { b };
    println("Max:");
    println(max);

    // While loop
    ≔ vary counter = 0;
    ⟳ counter < 5 {
        println(counter);
        counter = counter + 1;
    }

    // For loop
    println("For loop:");
    ∀ i ∈ 0..5 {
        println(i);
    }
}
