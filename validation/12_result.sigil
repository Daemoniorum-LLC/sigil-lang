// Result type for error handling
rite divide(a: f64, b: f64) -> Result<f64, String> {
    ⎇ b == 0.0 {
        Err("Division by zero".to_string())
    } ⎉ {
        Ok(a / b)
    }
}

rite main() {
    ≔ r1 = divide(10.0, 2.0);
    ⌥ r1 {
        Ok(v) => println("10/2 = " + v.to_string()),
        Err(e) => println("Error: " + e),
    }

    ≔ r2 = divide(10.0, 0.0);
    ⌥ r2 {
        Ok(v) => println("10/0 = " + v.to_string()),
        Err(e) => println("Error: " + e),
    }
}
