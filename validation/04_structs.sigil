// From GETTING_STARTED - Structs and Methods
Σ Point {
    x: f64,
    y: f64,
}

⊢ Point {
    rite new(x: f64, y: f64) -> Point {
        Point { x: x, y: y }
    }

    rite distance(self, other: Point) -> f64 {
        ≔ dx = self.x - other.x;
        ≔ dy = self.y - other.y;
        sqrt(dx * dx + dy * dy)
    }
}

rite main() {
    ≔ p1 = Point·new(0.0, 0.0);
    ≔ p2 = Point·new(3.0, 4.0);
    ≔ dist = p1.distance(p2);
    println("Distance:");
    println(dist);  // Should be 5.0
}
