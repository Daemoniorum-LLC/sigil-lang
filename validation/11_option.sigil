// Option type handling
rite find_even(nums: Vec<i32>) -> Option<i32> {
    ∀ n ∈ nums {
        ⎇ n % 2 == 0 {
            ⤺ Some(n);
        }
    }
    None
}

rite main() {
    ≔ odds = vec![1, 3, 5, 7];
    ≔ mixed = vec![1, 3, 4, 5];

    ≔ result1 = find_even(odds);
    ⌥ result1 {
        Some(n) => println("Found even: " + n.to_string()),
        None => println("No even found"),
    }

    ≔ result2 = find_even(mixed);
    ⌥ result2 {
        Some(n) => println("Found even: " + n.to_string()),
        None => println("No even found"),
    }
}
