// Graphics primitives from README
rite main() {
    // Vector operations
    ≔ pos = vec3(1.0, 2.0, 3.0);
    println("Position:");
    println(pos);

    // Quaternion rotation
    ≔ axis = vec3(0.0, 1.0, 0.0);
    ≔ rot = quat_from_axis_angle(axis, 0.5);
    println("Quaternion:");
    println(rot);

    // Apply rotation
    ≔ rotated = quat_rotate(rot, pos);
    println("Rotated:");
    println(rotated);
}
