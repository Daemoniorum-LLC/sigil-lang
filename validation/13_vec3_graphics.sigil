// Graphics primitives from README
fn main() {
    // Vector operations
    let pos = vec3(1.0, 2.0, 3.0);
    println("Position:");
    println(pos);

    // Quaternion rotation
    let axis = vec3(0.0, 1.0, 0.0);
    let rot = quat_from_axis_angle(axis, 0.5);
    println("Quaternion:");
    println(rot);

    // Apply rotation
    let rotated = quat_rotate(rot, pos);
    println("Rotated:");
    println(rotated);
}
