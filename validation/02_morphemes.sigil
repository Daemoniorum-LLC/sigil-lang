// From README - Morpheme Operators
rite main() {
    ≔ data = vec![1, 2, 3, 4, 5];

    // Test map (tau)
    ≔ doubled = data|map{|x| x * 2};
    println("Doubled:");
    println(doubled);

    // Test filter (phi)
    ≔ big = doubled|filter{|x| x > 5};
    println("Filtered > 5:");
    println(big);

    // Test fold (rho)
    ≔ sum = big|fold(0, |acc, x| acc + x);
    println("Sum:");
    println(sum);
}
