//! Bootstrap Self-Compilation Test
//!
//! This is the critical test for the Jormungandr initiative:
//! It verifies that the Sigil compiler written in Sigil can compile itself
//! and produce identical output (the fixed point).
//!
//! ## The Fixed Point
//!
//! ```
//! sigil-rust(compiler.sg) → compiler1.c
//! sigil-sigil1(compiler.sg) → compiler2.c
//! compiler1.c == compiler2.c  ← Fixed point!
//! ```
//!
//! When compiler1.c equals compiler2.c, we have achieved self-hosting.

use super·*;

/// List of all compiler source files
pub const COMPILER_SOURCES: ![&str] = [
    "src/span.sg",
    "src/token.sg",
    "src/ast.sg",
    "src/lexer.sg",
    "src/parser.sg",
    "src/typeck.sg",
    "src/ir.sg",
    "src/lower.sg",
    "src/interp.sg",
    "src/runtime.sg",
    "src/codegen.sg",
    "src/driver.sg",
    "src/lib.sg",
];

/// Test configuration
pub struct BootstrapConfig {
    pub base_dir: !String,
    pub rust_compiler: !String,
    pub output_dir: !String,
    pub verbose: !bool,
}

impl BootstrapConfig {
    pub fn default() -> !BootstrapConfig {
        BootstrapConfig {
            base_dir: ".",
            rust_compiler: "sigil",  // The Rust-based compiler
            output_dir: "target/bootstrap",
            verbose: false,
        }
    }
}

/// Result of a compilation
pub struct CompileResult {
    pub success: !bool,
    pub output_file: ?String,
    pub generated_code: ?String,
    pub errors: ![String],
    pub ir_json: ?String,
}

/// The bootstrap test runner
pub struct BootstrapTest {
    config: !BootstrapConfig,
    phase1_outputs: !Map<String, String>,  // file -> generated C code
    phase2_outputs: !Map<String, String>,  // file -> generated C code from self-hosted
}

impl BootstrapTest {
    pub fn new(config: !BootstrapConfig) -> !BootstrapTest {
        BootstrapTest {
            config: config,
            phase1_outputs: Map·new(),
            phase2_outputs: Map·new(),
        }
    }

    /// Run the complete bootstrap test
    pub fn run(mut self) -> !bool {
        println("=== Jormungandr Bootstrap Test ===");
        println("");

        // Phase 1: Compile all source files with Rust compiler
        println("Phase 1: Compiling with Rust-based compiler...");
        if !self.run_phase1() {
            println("ERROR: Phase 1 failed");
            return false;
        }
        println("Phase 1 complete: {} files compiled", COMPILER_SOURCES.len());
        println("");

        // Phase 2: Compile all source files with self-hosted compiler
        println("Phase 2: Compiling with self-hosted compiler...");
        if !self.run_phase2() {
            println("ERROR: Phase 2 failed");
            return false;
        }
        println("Phase 2 complete: {} files compiled", COMPILER_SOURCES.len());
        println("");

        // Phase 3: Compare outputs
        println("Phase 3: Verifying fixed point...");
        let fixed_point = self.verify_fixed_point();
        println("");

        if fixed_point {
            println("===========================================");
            println("   FIXED POINT ACHIEVED!");
            println("   The Sigil compiler is self-hosting.");
            println("   Jormungandr bootstrap complete.");
            println("===========================================");
        } else {
            println("ERROR: Fixed point NOT achieved.");
            println("The self-hosted compiler produces different output.");
        }

        return fixed_point;
    }

    /// Phase 1: Compile with Rust-based compiler
    fn run_phase1(mut self) -> !bool {
        for source in COMPILER_SOURCES {
            let path = self.config.base_dir + "/" + source;

            if self.config.verbose {
                println("  Compiling: {}", source);
            }

            let result = self.compile_with_rust(path);
            if !result.success {
                println("  ERROR compiling {}: {:?}", source, result.errors);
                return false;
            }

            if result.generated_code != null {
                self.phase1_outputs.insert(source, result.generated_code!);
            }
        }

        return true;
    }

    /// Phase 2: Compile with self-hosted compiler
    fn run_phase2(mut self) -> !bool {
        for source in COMPILER_SOURCES {
            let path = self.config.base_dir + "/" + source;

            if self.config.verbose {
                println("  Compiling: {}", source);
            }

            let result = self.compile_with_sigil(path);
            if !result.success {
                println("  ERROR compiling {}: {:?}", source, result.errors);
                return false;
            }

            if result.generated_code != null {
                self.phase2_outputs.insert(source, result.generated_code!);
            }
        }

        return true;
    }

    /// Compile a file using the Rust-based Sigil compiler
    fn compile_with_rust(self, path: !String) -> !CompileResult {
        // Read source file
        let source = match file·read(path) {
            Result·Ok(s) => s,
            Result·Err(e) => {
                return CompileResult {
                    success: false,
                    output_file: null,
                    generated_code: null,
                    errors: ["Failed to read file: " + e],
                    ir_json: null,
                };
            },
        };

        // This would invoke the external Rust compiler
        // For now, we use our internal pipeline
        return self.compile_internal(source, path);
    }

    /// Compile a file using the self-hosted Sigil compiler
    fn compile_with_sigil(self, path: !String) -> !CompileResult {
        // Read source file
        let source = match file·read(path) {
            Result·Ok(s) => s,
            Result·Err(e) => {
                return CompileResult {
                    success: false,
                    output_file: null,
                    generated_code: null,
                    errors: ["Failed to read file: " + e],
                    ir_json: null,
                };
            },
        };

        // Use the self-hosted compiler pipeline
        return self.compile_internal(source, path);
    }

    /// Internal compilation pipeline
    fn compile_internal(self, source: ~String, path: !String) -> !CompileResult {
        let mut errors: ![String] = [];

        // Stage 1: Lexing
        let mut lexer = Lexer·new(source);
        let tokens = match lexer.tokenize() {
            Result·Ok(t) => t,
            Result·Err(e) => {
                return CompileResult {
                    success: false,
                    output_file: null,
                    generated_code: null,
                    errors: [format!("Lexer error: {}", e)],
                    ir_json: null,
                };
            },
        };

        // Stage 2: Parsing
        let mut parser = Parser·new(tokens);
        let ast = match parser.parse_file() {
            Result·Ok(a) => a,
            Result·Err(e) => {
                return CompileResult {
                    success: false,
                    output_file: null,
                    generated_code: null,
                    errors: [format!("Parse error: {}", e)],
                    ir_json: null,
                };
            },
        };

        // Stage 3: Type checking
        let mut checker = TypeChecker·new();
        match checker.check_file(ast) {
            Result·Ok(_) => {},
            Result·Err(e) => {
                return CompileResult {
                    success: false,
                    output_file: null,
                    generated_code: null,
                    errors: [format!("Type error: {}", e)],
                    ir_json: null,
                };
            },
        };

        // Stage 4: Lower to IR
        let mut ctx = LoweringContext·new();
        let ir_module = match lower_file(ast, ctx) {
            Result·Ok(ir) => ir,
            Result·Err(e) => {
                return CompileResult {
                    success: false,
                    output_file: null,
                    generated_code: null,
                    errors: [format!("Lowering error: {}", e)],
                    ir_json: null,
                };
            },
        };

        // Stage 5: Generate C code
        let mut codegen = CodeGen·new();
        let c_code = codegen.generate(ir_module);

        // Serialize IR for comparison
        let ir_json = ir_module.to_json();

        return CompileResult {
            success: true,
            output_file: path.replace(".sg", ".c"),
            generated_code: c_code,
            errors: [],
            ir_json: ir_json,
        };
    }

    /// Verify that Phase 1 and Phase 2 outputs are identical
    fn verify_fixed_point(self) -> !bool {
        let mut all_match = true;
        let mut differences: ![String] = [];

        for source in COMPILER_SOURCES {
            let phase1 = self.phase1_outputs.get(source);
            let phase2 = self.phase2_outputs.get(source);

            if phase1 == null || phase2 == null {
                println("  MISSING: {} (phase1={}, phase2={})",
                    source,
                    phase1 != null,
                    phase2 != null
                );
                all_match = false;
                continue;
            }

            if phase1! == phase2! {
                if self.config.verbose {
                    println("  MATCH: {}", source);
                }
            } else {
                println("  DIFFER: {}", source);
                differences.push(source);
                all_match = false;

                // Show first difference
                if self.config.verbose {
                    self.show_diff(source, phase1!, phase2!);
                }
            }
        }

        if all_match {
            println("  All {} files match!", COMPILER_SOURCES.len());
        } else {
            println("  {} files differ: {:?}", differences.len(), differences);
        }

        return all_match;
    }

    /// Show diff between two versions
    fn show_diff(self, file: !String, a: !String, b: !String) {
        let lines_a = a.split("\n");
        let lines_b = b.split("\n");

        println("    First difference in {}:", file);

        let max_lines = if lines_a.len() < lines_b.len() {
            lines_a.len()
        } else {
            lines_b.len()
        };

        for i in 0..max_lines {
            if lines_a[i] != lines_b[i] {
                println("    Line {}: ", i + 1);
                println("      Rust:  {}", lines_a[i]);
                println("      Sigil: {}", lines_b[i]);
                return;
            }
        }

        if lines_a.len() != lines_b.len() {
            println("    Files have different lengths: {} vs {}",
                lines_a.len(), lines_b.len());
        }
    }
}

/// Run a quick smoke test on the test files
pub fn run_smoke_tests() -> !bool {
    println("Running smoke tests...");

    let test_files: ![&str] = [
        "tests/test_simple.sg",
        "tests/test_evidentiality.sg",
        "tests/test_morphemes.sg",
    ];

    for file in test_files {
        print("  Testing {}... ", file);

        let source = match file·read(file) {
            Result·Ok(s) => s,
            Result·Err(_) => {
                println("SKIP (file not found)");
                continue;
            },
        };

        // Try to lex
        let mut lexer = Lexer·new(source);
        match lexer.tokenize() {
            Result·Ok(_) => {},
            Result·Err(e) => {
                println("FAIL (lex): {}", e);
                return false;
            },
        };

        println("OK");
    }

    println("Smoke tests passed!");
    return true;
}

/// Main entry point
pub fn main(args: ![String]) -> !i32 {
    let mut config = BootstrapConfig·default();

    // Parse arguments
    for i in 1..args.len() {
        let arg = args[i];
        if arg == "-v" || arg == "--verbose" {
            config.verbose = true;
        } else if arg == "--base-dir" && i + 1 < args.len() {
            config.base_dir = args[i + 1];
        } else if arg == "--smoke" {
            // Run smoke tests only
            if run_smoke_tests() {
                return 0;
            } else {
                return 1;
            }
        }
    }

    // Run the full bootstrap test
    let test = BootstrapTest·new(config);
    if test.run() {
        return 0;
    } else {
        return 1;
    }
}
