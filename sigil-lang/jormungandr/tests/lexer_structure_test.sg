// TDD Test: explicit Option<T> instead of ?T

Σ Token { value: i32 }
Σ Span { start: u64, end: u64 }

Σ Lexer {
    pos: u64,
}

⊢ Lexer {
    λ get_token(Δ self) -> Option<(Token, Span)> {
        // Try with explicit Option
        ⎇ self.pos >= 100 {
            ⤺ None;
        }

        self.pos = self.pos + 1;

        ≔ token = Token { value: 42 };
        ≔ span = Span { start: 0, end: 1 };
        Some((token, span))
    }
}

λ main() {
    ≔ Δ lexer = Lexer { pos: 0 };
    ⌥ lexer.get_token() {
        Some((t, s)) => println(t.value),
        None => println(0),
    }
}
