// TDD Test: Type compatibility patterns for Jormungandr
// RED: Define expected behavior
// GREEN: These should all pass

// Test 1: String literal to evidential String
#[test]
fn test_string_literal_to_evidential() {
    // String literals coerce to !String directly
    let s: !String = "hello";
    assert_eq!(s, "hello");
}

// Test 2: Vec creation (not ![])
#[test]
fn test_vec_creation() {
    let v: Vec<i32> = Vec·new();
    assert_eq!(v.len(), 0);
}

// Test 3: Optional return with null
#[test]
fn test_optional_return() {
    fn maybe(cond: bool) -> i32? {
        if cond {
            42
        } else {
            null
        }
    }

    assert_eq!(maybe(true), 42);
}

// Test 4: Empty Vec is correct pattern
#[test]
fn test_empty_vec_typed() {
    let items: Vec<String> = Vec·new();
    assert_eq!(items.len(), 0);
}
