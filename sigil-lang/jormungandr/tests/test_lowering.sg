//! Comprehensive Lowering Test Suite
//!
//! Tests AST to IR lowering, including desugaring of high-level constructs,
//! pipeline lowering, and evidence propagation.
//! Target: 100% lowering coverage ∀ regression detection.

invoke crate·parser·Parser;
invoke crate·typeck·TypeChecker;
invoke crate·lower·lower_file;
invoke crate·ir·*;

// ============================================================================
// Test Helpers
// ============================================================================

/// Parse, type check, and lower source code to IR
λ lower_source(source: !&str) -> ?IrModule {
    ≔ Δ parser = Parser·new(source.to_string());
    ≔ ast = ⌥ parser.parse_file() {
        Result·Ok(a) => a,
        Result·Err(_) => ⤺ null,
    };
    ≔ Δ checker = TypeChecker·new();
    ⌥ checker.check_file(ast.clone()) {
        Result·Ok(_) => {},
        Result·Err(_) => ⤺ null,
    };
    ⌥ lower_file(ast, checker, "test.sg".to_string()) {
        Result·Ok(ir) => ?ir,
        Result·Err(_) => null,
    }
}

/// Assert that lowering succeeds
λ assert_lowers(source: !&str, name: !&str) -> !IrModule {
    ⌥ lower_source(source) {
        ?module => module,
        null => {
            panic(format!("FAIL {}: lowering failed", name));
        },
    }
}

/// Assert that lowering produces expected number of functions
λ assert_function_count(module: !IrModule, expected: !u64, name: !&str) {
    ⎇ module.functions.len() != expected {
        panic(format!("FAIL {}: expected {} functions, got {}", name, expected, module.functions.len()));
    }
}

/// Find a function by name ∈ the module
λ find_function(module: !IrModule, name: !&str) -> ?IrFunction {
    ∀ func ∈ module.functions {
        ⎇ func.name == name {
            ⤺ ?func;
        }
    }
    null
}

// ============================================================================
// 1. BASIC FUNCTION LOWERING
// ============================================================================

λ test_basic_function_lowering() -> !bool {
    print("  [1/10] Basic function lowering... ");

    // Simple function
    ≔ module = assert_lowers("λ foo() -> !i32 { ⤺ 42; }", "simple_fn");
    assert_function_count(module, 1, "one_function");

    // Function with params
    ≔ module2 = assert_lowers("λ add(a: !i32, b: !i32) -> !i32 { ⤺ a + b; }", "params_fn");
    ⌥ find_function(module2, "add") {
        ?func => {
            assert(func.params.len() == 2, "two_params");
        },
        null => panic("FAIL: add function not found"),
    }

    // Multiple functions
    ≔ module3 = assert_lowers("
        λ a() -> !i32 { ⤺ 1; }
        λ b() -> !i32 { ⤺ 2; }
        λ c() -> !i32 { ⤺ 3; }
    ", "multi_fn");
    assert_function_count(module3, 3, "three_functions");

    // Async function
    ≔ module4 = assert_lowers("async λ fetch() -> !String { ⤺ \"\"; }", "async_fn");
    ⌥ find_function(module4, "fetch") {
        ?func => {
            assert(func.is_async, "is_async");
        },
        null => panic("FAIL: fetch function not found"),
    }

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 2. LET BINDING LOWERING
// ============================================================================

λ test_let_lowering() -> !bool {
    print("  [2/10] Let binding lowering... ");

    // Simple ≔
    ≔ module = assert_lowers("
        λ test() -> !i32 {
            ≔ x: !i32 = 42;
            ⤺ x;
        }
    ", "simple_let");

    // Let with pattern
    ≔ module2 = assert_lowers("
        λ test() -> !i32 {
            ≔ (a, b): !(i32, i32) = (1, 2);
            ⤺ a + b;
        }
    ", "let_tuple_pattern");

    // Mutable ≔
    ≔ module3 = assert_lowers("
        λ test() -> !i32 {
            ≔ Δ x: !i32 = 0;
            x = 42;
            ⤺ x;
        }
    ", "let_mutable");

    // Let with type inference
    ≔ module4 = assert_lowers("
        λ test() -> !i32 {
            ≔ x = 42;
            ⤺ x;
        }
    ", "let_inferred");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 3. EXPRESSION LOWERING
// ============================================================================

λ test_expression_lowering() -> !bool {
    print("  [3/10] Expression lowering... ");

    // Binary expressions
    ≔ _module = assert_lowers("
        λ test() -> !i32 {
            ⤺ 1 + 2 * 3;
        }
    ", "binary_expr");

    // Unary expressions
    ≔ _module2 = assert_lowers("
        λ test() -> !i32 {
            ⤺ -42;
        }
    ", "unary_expr");

    // Comparison chain
    ≔ _module3 = assert_lowers("
        λ test() -> !bool {
            ≔ x: !i32 = 5;
            ⤺ x > 0 && x < 10;
        }
    ", "comparison_chain");

    // Logical operators
    ≔ _module4 = assert_lowers("
        λ test() -> !bool {
            ⤺ true && false || true;
        }
    ", "logical_ops");

    // Bitwise operators
    ≔ _module5 = assert_lowers("
        λ test() -> !i32 {
            ⤺ (1 << 4) | (1 << 2);
        }
    ", "bitwise_ops");

    println("PASS (5 cases)");
    true
}

// ============================================================================
// 4. CONTROL FLOW LOWERING
// ============================================================================

λ test_control_flow_lowering() -> !bool {
    print("  [4/10] Control flow lowering... ");

    // If expression
    ≔ _module = assert_lowers("
        λ test(x: !bool) -> !i32 {
            ⎇ x {
                ⤺ 1;
            } ⎉ {
                ⤺ 0;
            }
        }
    ", "if_expr");

    // If without ⎉
    ≔ _module2 = assert_lowers("
        λ test(x: !bool) -> !() {
            ⎇ x {
                println(\"yes\");
            }
        }
    ", "if_no_else");

    // Match expression
    ≔ _module3 = assert_lowers("
        ᛈ Option<T> { Some(T), None }
        λ test(opt: !Option<i32>) -> !i32 {
            ⌥ opt {
                Option·Some(v) => v,
                Option·None => 0,
            }
        }
    ", "match_expr");

    // Loop
    ≔ _module4 = assert_lowers("
        λ test() -> !i32 {
            loop {
                ⊗ 42;
            }
        }
    ", "loop_expr");

    // While
    ≔ _module5 = assert_lowers("
        λ test() -> !() {
            ≔ Δ i: !i32 = 0;
            ⟳ i < 10 {
                i = i + 1;
            }
        }
    ", "while_loop");

    // For
    ≔ _module6 = assert_lowers("
        λ test() -> !i32 {
            ≔ Δ sum: !i32 = 0;
            ∀ i ∈ 0..10 {
                sum = sum + i;
            }
            ⤺ sum;
        }
    ", "for_loop");

    println("PASS (6 cases)");
    true
}

// ============================================================================
// 5. STRUCT AND ENUM LOWERING
// ============================================================================

λ test_struct_enum_lowering() -> !bool {
    print("  [5/10] Struct and ᛈ lowering... ");

    // Struct definition and usage
    ≔ module = assert_lowers("
        Σ Point { x: !i32, y: !i32 }
        λ test() -> !Point {
            ⤺ Point { x: 1, y: 2 };
        }
    ", "struct_basic");
    assert(module.types.len() >= 1, "has_struct_type");

    // Struct field access
    ≔ _module2 = assert_lowers("
        Σ Point { x: !i32, y: !i32 }
        λ test() -> !i32 {
            ≔ p = Point { x: 1, y: 2 };
            ⤺ p.x + p.y;
        }
    ", "struct_field");

    // Enum definition
    ≔ module3 = assert_lowers("
        ᛈ Color { Red, Green, Blue }
        λ test() -> !Color {
            ⤺ Color·Red;
        }
    ", "enum_basic");
    assert(module3.types.len() >= 1, "has_enum_type");

    // Enum with data
    ≔ _module4 = assert_lowers("
        ᛈ Result<T, E> { Ok(T), Err(E) }
        λ test() -> !Result<i32, String> {
            ⤺ Result·Ok(42);
        }
    ", "enum_data");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 6. METHOD AND IMPL LOWERING
// ============================================================================

λ test_method_lowering() -> !bool {
    print("  [6/10] Method and ⊢ lowering... ");

    // Inherent ⊢
    ≔ module = assert_lowers("
        Σ Counter { value: !i32 }
        ⊢ Counter {
            λ new() -> !Counter {
                ⤺ Counter { value: 0 };
            }
            λ get(self) -> !i32 {
                ⤺ self.value;
            }
            λ inc(Δ self) {
                self.value = self.value + 1;
            }
        }
        λ test() -> !i32 {
            ≔ c = Counter·new();
            ⤺ c.get();
        }
    ", "inherent_impl");
    // Should have Counter·new, Counter·get, Counter·inc, and test
    assert(module.functions.len() >= 4, "has_methods");

    // Method call chain
    ≔ _module2 = assert_lowers("
        Σ Builder { value: !i32 }
        ⊢ Builder {
            λ new() -> !Builder { Builder { value: 0 } }
            λ add(Δ self, x: !i32) -> !Builder {
                self.value = self.value + x;
                ⤺ self;
            }
            λ build(self) -> !i32 { self.value }
        }
        λ test() -> !i32 {
            ⤺ Builder·new().add(1).add(2).build();
        }
    ", "method_chain");

    println("PASS (2 cases)");
    true
}

// ============================================================================
// 7. CLOSURE LOWERING
// ============================================================================

λ test_closure_lowering() -> !bool {
    print("  [7/10] Closure lowering... ");

    // Simple closure
    ≔ _module = assert_lowers("
        λ test() -> !i32 {
            ≔ f = |x: i32| x + 1;
            ⤺ f(41);
        }
    ", "simple_closure");

    // Closure with capture
    ≔ _module2 = assert_lowers("
        λ test() -> !i32 {
            ≔ a: !i32 = 10;
            ≔ f = |x: i32| x + a;
            ⤺ f(5);
        }
    ", "closure_capture");

    // Move closure
    ≔ _module3 = assert_lowers("
        λ test() -> !i32 {
            ≔ s = \"hello\".to_string();
            ≔ f = move || s.len();
            ⤺ f();
        }
    ", "move_closure");

    // Nested closure
    ≔ _module4 = assert_lowers("
        λ test() -> !i32 {
            ≔ f = |x: i32| |y: i32| x + y;
            ≔ g = f(10);
            ⤺ g(5);
        }
    ", "nested_closure");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 8. PIPELINE LOWERING
// ============================================================================

λ test_pipeline_lowering() -> !bool {
    print("  [8/10] Pipeline lowering... ");

    // Simple pipeline
    ≔ _module = assert_lowers("
        λ double(x: !i32) -> !i32 { ⤺ x * 2; }
        λ test() -> !i32 {
            ⤺ 21 |> double;
        }
    ", "simple_pipeline");

    // Chained pipeline
    ≔ _module2 = assert_lowers("
        λ add_one(x: !i32) -> !i32 { ⤺ x + 1; }
        λ double(x: !i32) -> !i32 { ⤺ x * 2; }
        λ test() -> !i32 {
            ⤺ 10 |> add_one |> double;
        }
    ", "chained_pipeline");

    // Pipeline with morpheme (tau)
    ≔ _module3 = assert_lowers("
        λ test() -> ![i32] {
            ≔ arr: ![i32] = [1, 2, 3];
            ⤺ arr |τ{x => x * 2};
        }
    ", "morpheme_tau");

    // Pipeline with filter (phi)
    ≔ _module4 = assert_lowers("
        λ test() -> ![i32] {
            ≔ arr: ![i32] = [1, 2, 3, 4, 5];
            ⤺ arr |φ{x => x > 2};
        }
    ", "morpheme_phi");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 9. EVIDENCE LOWERING
// ============================================================================

λ test_evidence_lowering() -> !bool {
    print("  [9/10] Evidence lowering... ");

    // Known evidence
    ≔ module = assert_lowers("
        λ test() -> !i32 {
            ≔ x: !i32 = 42;
            ⤺ x;
        }
    ", "known_evidence");
    ⌥ find_function(module, "test") {
        ?func => {
            assert(func.return_evidence == IrEvidence·Known, "return_is_known");
        },
        null => panic("FAIL: test function not found"),
    }

    // Uncertain evidence
    ≔ module2 = assert_lowers("
        λ test() -> ?i32 {
            ⤺ ?42;
        }
    ", "uncertain_evidence");
    ⌥ find_function(module2, "test") {
        ?func => {
            assert(func.return_evidence == IrEvidence·Uncertain, "return_is_uncertain");
        },
        null => panic("FAIL: test function not found"),
    }

    // Evidence propagation
    ≔ _module3 = assert_lowers("
        λ test(x: ?i32, y: !i32) -> ?i32 {
            ⤺ x + y;  // Result is uncertain
        }
    ", "evidence_propagation");

    // Evidence coercion
    ≔ _module4 = assert_lowers("
        λ test(x: ?i32) -> !i32 {
            ⤺ x ?? 0;  // Coalesce to known
        }
    ", "evidence_coalesce");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 10. DESUGARING
// ============================================================================

λ test_desugaring() -> !bool {
    print("  [10/10] Desugaring... ");

    // Method syntax to function call
    ≔ _module = assert_lowers("
        Σ S {}
        ⊢ S { λ method(self) -> !i32 { ⤺ 42; } }
        λ test() -> !i32 {
            ≔ s = S {};
            ⤺ s.method();  // Desugars to S·method(s)
        }
    ", "method_desugar");

    // Field shorthand
    ≔ _module2 = assert_lowers("
        Σ Point { x: !i32, y: !i32 }
        λ test(x: !i32, y: !i32) -> !Point {
            ⤺ Point { x, y };  // Desugars to Point { x: x, y: y }
        }
    ", "field_shorthand");

    // Range syntax
    ≔ _module3 = assert_lowers("
        λ test() -> ![i32] {
            ≔ r = 0..10;  // Desugars to Range·new(0, 10)
            ⤺ [];
        }
    ", "range_desugar");

    // Try operator
    ≔ _module4 = assert_lowers("
        ᛈ Result<T, E> { Ok(T), Err(E) }
        λ fallible() -> !Result<i32, String> { ⤺ Result·Ok(42); }
        λ test() -> !Result<i32, String> {
            ≔ x = fallible()?;  // Desugars to ⌥
            ⤺ Result·Ok(x);
        }
    ", "try_desugar");

    // If ≔
    ≔ _module5 = assert_lowers("
        ᛈ Option<T> { Some(T), None }
        λ test(opt: !Option<i32>) -> !i32 {
            ⎇ ≔ Option·Some(x) = opt {
                ⤺ x;
            }
            ⤺ 0;
        }
    ", "if_let_desugar");

    // While ≔
    ≔ _module6 = assert_lowers("
        ᛈ Option<T> { Some(T), None }
        λ next() -> !Option<i32> { ⤺ Option·None; }
        λ test() -> !() {
            ⟳ ≔ Option·Some(x) = next() {
                println(format!(\"{}\", x));
            }
        }
    ", "while_let_desugar");

    println("PASS (6 cases)");
    true
}

// ============================================================================
// Main Test Runner
// ============================================================================

☉ λ main() -> !i32 {
    println("Testing Lowering (AST -> IR)...");
    println("");

    ≔ Δ passed: !i32 = 0;
    ≔ Δ failed: !i32 = 0;

    ⎇ test_basic_function_lowering() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_let_lowering() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_expression_lowering() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_control_flow_lowering() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_struct_enum_lowering() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_method_lowering() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_closure_lowering() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_pipeline_lowering() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_evidence_lowering() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_desugaring() { passed = passed + 1; } ⎉ { failed = failed + 1; }

    println("");
    println("Results: {}/{} test groups passed", passed, passed + failed);

    ⎇ failed > 0 {
        println("FAILED: {} test groups failed", failed);
        ⤺ 1;
    }

    println("");
    println("All lowering tests passed! (~39 test cases)");
    ⤺ 0;
}
