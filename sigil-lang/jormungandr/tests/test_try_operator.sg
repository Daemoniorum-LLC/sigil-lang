//! Test the Try (?) operator for Result error propagation
//!
//! The Try operator (`?`) is used to propagate errors from Result types:
//! - On Result::Ok(value), unwrap and return the value
//! - On Result::Err(e), return early with the error
//!
//! This is essential for the self-hosted compiler which uses Result
//! extensively for error handling (parsing, type checking, lowering, etc.)

/// Simple Result type for testing
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> !bool {
        match self {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    pub fn is_err(self) -> !bool {
        !self.is_ok()
    }

    pub fn unwrap(self) -> !T {
        match self {
            Result::Ok(v) => v,
            Result::Err(_) => panic("called unwrap on Err"),
        }
    }

    pub fn unwrap_err(self) -> !E {
        match self {
            Result::Ok(_) => panic("called unwrap_err on Ok"),
            Result::Err(e) => e,
        }
    }
}

// ============================================================================
// Basic Try Operator Tests
// ============================================================================

/// A function that can fail
fn might_fail(should_fail: !bool) -> !Result<i32, String> {
    if should_fail {
        return Result::Err("intentional failure".to_string());
    }
    return Result::Ok(42);
}

/// Test basic try operator with success
fn test_try_success() -> !Result<i32, String> {
    let value = might_fail(false)?;  // Should unwrap to 42
    return Result::Ok(value + 1);    // Should return Ok(43)
}

/// Test basic try operator with failure
fn test_try_failure() -> !Result<i32, String> {
    let value = might_fail(true)?;   // Should return early with Err
    return Result::Ok(value + 1);    // This line should not be reached
}

/// Test chained try operators
fn test_try_chain() -> !Result<i32, String> {
    let a = might_fail(false)?;  // Ok(42)
    let b = might_fail(false)?;  // Ok(42)
    let c = might_fail(false)?;  // Ok(42)
    return Result::Ok(a + b + c);  // Ok(126)
}

/// Test try in expression position
fn test_try_in_expression() -> !Result<i32, String> {
    let result = might_fail(false)? + might_fail(false)?;
    return Result::Ok(result);  // Ok(84)
}

// ============================================================================
// Try with Different Error Types
// ============================================================================

/// Parse an integer from a string
fn parse_int(s: !&str) -> !Result<i32, String> {
    // Simplified: only handles single digits for testing
    if s.len() == 0 {
        return Result::Err("empty string".to_string());
    }
    let c = s.chars().next().unwrap();
    if c >= '0' && c <= '9' {
        return Result::Ok((c as i32) - ('0' as i32));
    }
    return Result::Err(format!("invalid digit: {}", c));
}

/// Read and parse (simulated)
fn read_and_parse(input: !&str) -> !Result<i32, String> {
    let value = parse_int(input)?;
    return Result::Ok(value * 10);
}

/// Test try with parsing
fn test_try_parsing() -> !Result<(), String> {
    let result = read_and_parse("5")?;
    assert(result == 50, "parsed 5 * 10 should be 50");
    return Result::Ok(());
}

// ============================================================================
// Try in Control Flow
// ============================================================================

/// Process a list with early return on error
fn process_list(items: ![i32]) -> !Result<i32, String> {
    let mut sum: !i32 = 0;
    for item in items {
        // Fail if any item is negative
        if item < 0 {
            return Result::Err(format!("negative value: {}", item));
        }
        sum = sum + item;
    }
    return Result::Ok(sum);
}

/// Test try with loops
fn test_try_with_loop() -> !Result<(), String> {
    let good_list: ![i32] = [1, 2, 3, 4, 5];
    let sum = process_list(good_list)?;
    assert(sum == 15, "sum of 1..5 should be 15");
    return Result::Ok(());
}

// ============================================================================
// Try in Nested Functions
// ============================================================================

/// Inner function that can fail
fn inner_operation(x: !i32) -> !Result<i32, String> {
    if x == 0 {
        return Result::Err("division by zero".to_string());
    }
    return Result::Ok(100 / x);
}

/// Outer function using try
fn outer_operation(x: !i32) -> !Result<i32, String> {
    let result = inner_operation(x)?;
    return Result::Ok(result + 1);
}

/// Test nested try
fn test_nested_try() -> !Result<(), String> {
    let result = outer_operation(10)?;
    assert(result == 11, "100/10 + 1 should be 11");
    return Result::Ok(());
}

// ============================================================================
// Try in Method Calls
// ============================================================================

pub struct Calculator {
    value: !i32,
}

impl Calculator {
    pub fn new() -> !Calculator {
        Calculator { value: 0 }
    }

    pub fn add(mut self, x: !i32) -> !Result<Calculator, String> {
        self.value = self.value + x;
        return Result::Ok(self);
    }

    pub fn divide(mut self, x: !i32) -> !Result<Calculator, String> {
        if x == 0 {
            return Result::Err("division by zero".to_string());
        }
        self.value = self.value / x;
        return Result::Ok(self);
    }

    pub fn result(self) -> !i32 {
        return self.value;
    }
}

/// Test try with method chaining
fn test_try_method_chain() -> !Result<(), String> {
    let calc = Calculator::new()
        .add(100)?
        .divide(10)?
        .add(5)?;

    assert(calc.result() == 15, "100/10 + 5 should be 15");
    return Result::Ok(());
}

// ============================================================================
// Main Test Runner
// ============================================================================

/// Run all try operator tests
pub fn main() -> !i32 {
    println("Testing Try (?) operator...");
    println("");

    // Test 1: Basic success
    print("  [1/8] test_try_success... ");
    match test_try_success() {
        Result::Ok(v) => {
            assert(v == 43, "should return Ok(43)");
            println("PASS");
        },
        Result::Err(e) => {
            println("FAIL: unexpected error: {}", e);
            return 1;
        },
    }

    // Test 2: Basic failure
    print("  [2/8] test_try_failure... ");
    match test_try_failure() {
        Result::Ok(_) => {
            println("FAIL: should have returned Err");
            return 1;
        },
        Result::Err(e) => {
            assert(e == "intentional failure", "error message should match");
            println("PASS");
        },
    }

    // Test 3: Chained try
    print("  [3/8] test_try_chain... ");
    match test_try_chain() {
        Result::Ok(v) => {
            assert(v == 126, "42 + 42 + 42 should be 126");
            println("PASS");
        },
        Result::Err(e) => {
            println("FAIL: unexpected error: {}", e);
            return 1;
        },
    }

    // Test 4: Try in expression
    print("  [4/8] test_try_in_expression... ");
    match test_try_in_expression() {
        Result::Ok(v) => {
            assert(v == 84, "42 + 42 should be 84");
            println("PASS");
        },
        Result::Err(e) => {
            println("FAIL: unexpected error: {}", e);
            return 1;
        },
    }

    // Test 5: Try with parsing
    print("  [5/8] test_try_parsing... ");
    match test_try_parsing() {
        Result::Ok(_) => println("PASS"),
        Result::Err(e) => {
            println("FAIL: {}", e);
            return 1;
        },
    }

    // Test 6: Try with loops
    print("  [6/8] test_try_with_loop... ");
    match test_try_with_loop() {
        Result::Ok(_) => println("PASS"),
        Result::Err(e) => {
            println("FAIL: {}", e);
            return 1;
        },
    }

    // Test 7: Nested try
    print("  [7/8] test_nested_try... ");
    match test_nested_try() {
        Result::Ok(_) => println("PASS"),
        Result::Err(e) => {
            println("FAIL: {}", e);
            return 1;
        },
    }

    // Test 8: Method chain with try
    print("  [8/8] test_try_method_chain... ");
    match test_try_method_chain() {
        Result::Ok(_) => println("PASS"),
        Result::Err(e) => {
            println("FAIL: {}", e);
            return 1;
        },
    }

    println("");
    println("All Try operator tests passed!");
    return 0;
}
