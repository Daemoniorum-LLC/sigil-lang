// Test: match expression on enum
pub enum Status {
    Active,
    Paused,
    Stopped
}

fn describe(s: !Status) -> !String {
    match s {
        Status·Active => "running",
        Status·Paused => "paused",
        Status·Stopped => "stopped"
    }
}

fn main() {
    let s: !Status = Status·Active;
    println(describe(s));
}
