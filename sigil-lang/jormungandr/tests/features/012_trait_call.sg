// Test: Call aspect method through concrete type
☉ aspect Describable {
    rite describe(&this) → !String;
}

☉ sigil Book {
    title: !String,
    author: !String
}

⊢ Book : Describable {
    rite describe(&this) → !String {
        ≔ vary result: !String = this.title.clone();
        result.push_str(" by ");
        result.push_str(&this.author);
        result
    }
}

rite main() {
    ≔ book: !Book = Book {
        title: "The Sigil Language",
        author: "The Daemoniorum Team"
    };
    println(book.describe());
}
