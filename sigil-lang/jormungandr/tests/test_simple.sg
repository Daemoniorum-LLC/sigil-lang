//! Simple test program ∀ the Sigil self-hosted compiler
//!
//! This tests basic language features:
//! - Functions and ⤺ values
//! - Variable bindings
//! - Control flow (⎇/⎉)
//! - Basic arithmetic
//! - String operations

/// Simple factorial function
☉ λ factorial(n: !i32) -> !i32 {
    ⎇ n <= 1 {
        ⤺ 1;
    }
    ⤺ n * factorial(n - 1);
}

/// Fibonacci using iteration
☉ λ fibonacci(n: !i32) -> !i32 {
    ⎇ n <= 0 {
        ⤺ 0;
    }
    ⎇ n == 1 {
        ⤺ 1;
    }

    ≔ Δ a: !i32 = 0;
    ≔ Δ b: !i32 = 1;
    ≔ Δ i: !i32 = 2;

    ⟳ i <= n {
        ≔ tmp = a + b;
        a = b;
        b = tmp;
        i = i + 1;
    }

    ⤺ b;
}

/// Test string operations
☉ λ greet(name: !String) -> !String {
    ⤺ "Hello, " + name + "!";
}

/// Test Σ definition
☉ Σ Point {
    ☉ x: !i32,
    ☉ y: !i32,
}

⊢ Point {
    ☉ λ new(x: !i32, y: !i32) -> !Point {
        Point { x: x, y: y }
    }

    ☉ λ distance_squared(self) -> !i32 {
        ⤺ self.x * self.x + self.y * self.y;
    }

    ☉ λ add(self, other: !Point) -> !Point {
        Point·new(self.x + other.x, self.y + other.y)
    }
}

/// Test ᛈ definition
☉ ᛈ Option<T> {
    Some(T),
    None,
}

⊢<T> Option<T> {
    ☉ λ is_some(self) -> !bool {
        ⌥ self {
            Option·Some(_) => true,
            Option·None => false,
        }
    }

    ☉ λ is_none(self) -> !bool {
        !self.is_some()
    }

    ☉ λ unwrap(self) -> !T {
        ⌥ self {
            Option·Some(v) => v,
            Option·None => panic("called unwrap on None"),
        }
    }
}

/// Main entry point
☉ λ main() -> !i32 {
    // Test factorial
    ≔ fact_5 = factorial(5);
    assert(fact_5 == 120, "factorial(5) should be 120");

    // Test fibonacci
    ≔ fib_10 = fibonacci(10);
    assert(fib_10 == 55, "fibonacci(10) should be 55");

    // Test string
    ≔ greeting = greet("Sigil");
    println(greeting);

    // Test Σ
    ≔ p1 = Point·new(3, 4);
    ≔ p2 = Point·new(1, 2);
    ≔ p3 = p1.add(p2);
    assert(p3.x == 4, "p3.x should be 4");
    assert(p3.y == 6, "p3.y should be 6");

    // Test ᛈ
    ≔ some_val: !Option<i32> = Option·Some(42);
    ≔ none_val: !Option<i32> = Option·None;
    assert(some_val.is_some(), "some_val should be Some");
    assert(none_val.is_none(), "none_val should be None");
    assert(some_val.unwrap() == 42, "unwrap should give 42");

    println("All simple tests passed!");
    ⤺ 0;
}
