//! Simple test program for the Sigil self-hosted compiler
//!
//! This tests basic language features:
//! - Functions and return values
//! - Variable bindings
//! - Control flow (if/else)
//! - Basic arithmetic
//! - String operations

/// Simple factorial function
pub fn factorial(n: !i32) -> !i32 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

/// Fibonacci using iteration
pub fn fibonacci(n: !i32) -> !i32 {
    if n <= 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }

    let mut a: !i32 = 0;
    let mut b: !i32 = 1;
    let mut i: !i32 = 2;

    while i <= n {
        let tmp = a + b;
        a = b;
        b = tmp;
        i = i + 1;
    }

    return b;
}

/// Test string operations
pub fn greet(name: !String) -> !String {
    return "Hello, " + name + "!";
}

/// Test struct definition
pub struct Point {
    pub x: !i32,
    pub y: !i32,
}

impl Point {
    pub fn new(x: !i32, y: !i32) -> !Point {
        Point { x: x, y: y }
    }

    pub fn distance_squared(self) -> !i32 {
        return self.x * self.x + self.y * self.y;
    }

    pub fn add(self, other: !Point) -> !Point {
        Point::new(self.x + other.x, self.y + other.y)
    }
}

/// Test enum definition
pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    pub fn is_some(self) -> !bool {
        match self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    pub fn is_none(self) -> !bool {
        !self.is_some()
    }

    pub fn unwrap(self) -> !T {
        match self {
            Option::Some(v) => v,
            Option::None => panic("called unwrap on None"),
        }
    }
}

/// Main entry point
pub fn main() -> !i32 {
    // Test factorial
    let fact_5 = factorial(5);
    assert(fact_5 == 120, "factorial(5) should be 120");

    // Test fibonacci
    let fib_10 = fibonacci(10);
    assert(fib_10 == 55, "fibonacci(10) should be 55");

    // Test string
    let greeting = greet("Sigil");
    println(greeting);

    // Test struct
    let p1 = Point::new(3, 4);
    let p2 = Point::new(1, 2);
    let p3 = p1.add(p2);
    assert(p3.x == 4, "p3.x should be 4");
    assert(p3.y == 6, "p3.y should be 6");

    // Test enum
    let some_val: !Option<i32> = Option::Some(42);
    let none_val: !Option<i32> = Option::None;
    assert(some_val.is_some(), "some_val should be Some");
    assert(none_val.is_none(), "none_val should be None");
    assert(some_val.unwrap() == 42, "unwrap should give 42");

    println("All simple tests passed!");
    return 0;
}
