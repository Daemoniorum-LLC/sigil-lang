//! Test CG-011: Infinite loop (loop { ... }) codegen
//!
//! The `loop` keyword should generate `while(1) { ... }` with break support.
//! Bug: Expr::Loop is not handled in lower.sg, causing loop bodies to be skipped.

/// Count up to limit using infinite loop with break
pub fn count_to(limit: !i32) -> !i32 {
    let mut count = 0;
    loop {
        if count >= limit {
            break;
        }
        count = count + 1;
    }
    count
}

/// Find first even number >= start
pub fn find_even(start: !i32) -> !i32 {
    let mut n = start;
    loop {
        if n % 2 == 0 {
            break;
        }
        n = n + 1;
    }
    n
}

pub fn main() -> !i32 {
    // Test basic loop with break
    if count_to(5) != 5 { return 1; }
    if count_to(0) != 0 { return 2; }
    if count_to(10) != 10 { return 3; }

    // Test loop with conditional break
    if find_even(1) != 2 { return 10; }
    if find_even(4) != 4 { return 11; }
    if find_even(7) != 8 { return 12; }

    return 0;
}
