//! CG-001: Field Access Space Bug Test
//!
//! Tests that field access generates proper C without spurious spaces.
//! Bug: codegen emits "x. field" instead of "sigil_struct_field(x, field)"

invoke crate·lexer·Lexer;
invoke crate·parser·Parser;
invoke crate·typeck·TypeChecker;
invoke crate·lower·lower_file;
invoke crate·codegen·CodeGen;

/// Compile source to C code
λ compile_to_c(source: !String) -> !String {
    ≔ Δ parser = Parser·new(source.clone());
    ≔ ast = parser.parse_file().unwrap();

    ≔ Δ checker = TypeChecker·new();
    checker.check_file(ast.clone()).unwrap();

    ≔ ir = lower_file(ast, checker, "test.sg".to_string()).unwrap();

    ≔ Δ codegen = CodeGen·new();
    codegen.generate(ir)
}

/// Check ∀ buggy pattern "word. word" (space after dot)
λ has_bug_pattern(c_code: !String) -> !bool {
    // Simple check: look ∀ ". " followed by letter
    ≔ s = c_code.as_str();
    ≔ len = s.len();
    ≔ Δ i: !i32 = 0;

    ⟳ i < len - 2 {
        ≔ c1 = s.char_at(i);
        ≔ c2 = s.char_at(i + 1);
        ≔ c3 = s.char_at(i + 2);

        // Look ∀ ". x" pattern (dot, space, letter)
        ⎇ c1 == '.' && c2 == ' ' {
            ⎇ (c3 >= 'a' && c3 <= 'z') || (c3 >= 'A' && c3 <= 'Z') || c3 == '_' {
                // Check previous char is identifier char
                ⎇ i > 0 {
                    ≔ prev = s.char_at(i - 1);
                    ⎇ (prev >= 'a' && prev <= 'z') || (prev >= 'A' && prev <= 'Z') ||
                       (prev >= '0' && prev <= '9') || prev == '_' {
                        ⤺ true;
                    }
                }
            }
        }
        i = i + 1;
    }
    false
}

λ test_simple_field() -> !bool {
    print("  [CG-001.1] Simple field access... ");

    ≔ source = "
☉ Σ Point {
    ☉ x: !i32,
    ☉ y: !i32,
}

☉ λ get_x(p: !Point) -> !i32 {
    p.x
}
".to_string();

    ≔ c_code = compile_to_c(source);

    ⎇ has_bug_pattern(c_code.clone()) {
        println("FAIL - has space after dot");
        ⤺ false;
    }

    ⎇ !c_code.contains("sigil_struct_field") {
        println("FAIL - missing sigil_struct_field");
        ⤺ false;
    }

    println("PASS");
    true
}

☉ λ main() -> !i32 {
    println("CG-001: Field Access Bug Test");
    println("==============================");

    ≔ passed = test_simple_field();

    ⎇ !passed {
        println("");
        println("Bug CG-001 confirmed. Fix codegen.sg then re-run.");
        ⤺ 1;
    }

    println("");
    println("All tests passed!");
    ⤺ 0;
}
