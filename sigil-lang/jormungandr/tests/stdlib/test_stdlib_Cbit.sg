// Stdlib Tests: Cbit
// Classical bit type with REAL assertions

rite main() {
    println("=== Testing Cbit ===");

    // Cbit·new - wraps value as classical bit (non-zero becomes 1, zero stays 0)
    ≔ cb = Cbit·new(42);
    assert_eq(type_of(cb), "int");
    assert_eq(cb, 1);  // non-zero value becomes 1

    // Cbit with 0
    ≔ cb0 = Cbit·new(0);
    assert_eq(cb0, 0);  // zero stays 0

    // Cbit with 1
    ≔ cb1 = Cbit·new(1);
    assert_eq(cb1, 1);

    // Cbit with negative - also becomes 1
    ≔ cbn = Cbit·new(-5);
    assert_eq(cbn, 1);

    println("ALL CBIT TESTS PASSED!");
}
