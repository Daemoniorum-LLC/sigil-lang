// Stdlib Tests: num_cpus
// CPU count functions with REAL assertions

rite main() {
    println("=== Testing num_cpus ===");

    // num_cpus·get - returns logical CPU count
    ≔ cpus = num_cpus·get();
    assert_true(cpus >= 1);
    assert_eq(type_of(cpus), "int");

    // num_cpus·get_physical - returns physical CPU count
    ≔ phys = num_cpus·get_physical();
    assert_true(phys >= 1);
    assert_true(phys <= cpus);  // Physical <= logical

    println("ALL NUM_CPUS TESTS PASSED!");
}
