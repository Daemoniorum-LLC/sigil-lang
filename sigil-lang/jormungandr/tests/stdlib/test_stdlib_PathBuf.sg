// Stdlib Tests: PathBuf
// PathBuf type with REAL assertions

rite main() {
    println("=== Testing PathBuf ===");

    // PathBuf·from - creates path buffer (returns string)
    ≔ pb = PathBuf·from("/tmp/test");
    assert_eq(type_of(pb), "string");
    assert_eq(pb, "/tmp/test");

    // Different paths
    ≔ pb2 = PathBuf·from("/home/user/file.txt");
    assert_true(len(pb2) > 0);

    ≔ pb3 = PathBuf·from("relative/path");
    assert_eq(pb3, "relative/path");

    println("ALL PATHBUF TESTS PASSED!");
}
