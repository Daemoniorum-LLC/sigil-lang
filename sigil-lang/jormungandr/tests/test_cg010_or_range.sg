//! Test CG-010b: Range pattern inside Or pattern
//!
//! Range patterns inside Or patterns like:
//!   'a'..='z' | 'A'..='Z'
//! Should generate:
//!   (val >= 'a' && val <= 'z') || (val >= 'A' && val <= 'Z')
//!
//! Bug: Currently generates (val >= 'a' && 1) - missing upper bound

/// Classify using OR of ranges (the bug pattern)
pub fn is_letter_or_digit(c: !char) -> !i32 {
    match c {
        'a'..='z' | 'A'..='Z' => 1,
        '0'..='9' => 2,
        _ => 0,
    }
}

pub fn main() -> !i32 {
    // Test lowercase
    if is_letter_or_digit('a') != 1 { return 1; }
    if is_letter_or_digit('z') != 1 { return 2; }
    if is_letter_or_digit('m') != 1 { return 3; }

    // Test uppercase
    if is_letter_or_digit('A') != 1 { return 4; }
    if is_letter_or_digit('Z') != 1 { return 5; }

    // Test digit
    if is_letter_or_digit('0') != 2 { return 6; }
    if is_letter_or_digit('9') != 2 { return 7; }

    // CRITICAL: Character after 'z' should NOT match the OR pattern
    // '{' is ASCII 123, immediately after 'z'=122
    // If bug exists, '{' would incorrectly match 'a'..='z' | 'A'..='Z'
    if is_letter_or_digit('{') != 0 { return 10; }

    // '[' is ASCII 91, after 'Z'=90
    if is_letter_or_digit('[') != 0 { return 11; }

    // '@' is ASCII 64, before 'A'=65
    if is_letter_or_digit('@') != 0 { return 12; }

    return 0;
}
