// ============================================================================
// 4. WEBSOCKET CONNECTIONS
// ============================================================================

fn test_websocket() -> !bool {
    print("  [4/10] WebSocket connections... ");

    // Connect
    assert_checks("
        async fn connect() -> ~WebSocket {
            return ws·connect(\"wss://echo.websocket.org\").await;
        }
    ", "ws_connect");

    // Connect with protocols
    assert_checks("
        async fn connect_proto() -> ~WebSocket {
            return ws·connect(\"wss://example.com/socket\")
                .protocol(\"graphql-ws\")
                .await;
        }
    ", "ws_connect_protocol");

    // Send text message
    assert_checks("
        async fn send_message(ws: ~WebSocket) -> !() {
            ws.send_text(\"hello\").await;
        }
    ", "ws_send_text");

    // Send binary message
    assert_checks("
        async fn send_binary(ws: ~WebSocket, data: ![u8]) -> !() {
            ws.send_binary(data).await;
        }
    ", "ws_send_binary");

    // Receive message
    assert_checks("
        async fn receive(ws: ~WebSocket) -> ~Message {
            return ws.recv().await;
        }
    ", "ws_receive");

    // Close connection
    assert_checks("
        async fn close(ws: ~WebSocket) -> !() {
            ws.close().await;
        }
    ", "ws_close");

    println("PASS (6 cases)");
    true
}

// ============================================================================
// 5. GRPC CALLS
// ============================================================================

fn test_grpc() -> !bool {
    print("  [5/10] gRPC calls... ");

    // Unary call
    assert_checks("
        async fn grpc_unary() -> ~Response {
            return grpc·call(\"localhost:50051\", \"greeter.Greeter/SayHello\")
                .message({ \"name\": \"World\" })
                .await;
        }
    ", "grpc_unary");

    // With metadata
    assert_checks("
        async fn grpc_metadata() -> ~Response {
            return grpc·call(\"localhost:50051\", \"service/Method\")
                .metadata(\"authorization\", \"Bearer token\")
                .message({})
                .await;
        }
    ", "grpc_metadata");

    // With timeout
    assert_checks("
        async fn grpc_timeout() -> ~Response {
            return grpc·call(\"localhost:50051\", \"service/Method\")
                .timeout(10000)
                .message({})
                .await;
        }
    ", "grpc_timeout");

    // Streaming (server-side)
    assert_checks("
        async fn grpc_stream() -> ~Stream<Response> {
            return grpc·stream(\"localhost:50051\", \"service/StreamMethod\")
                .message({})
                .await;
        }
    ", "grpc_server_stream");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 6. KAFKA OPERATIONS
// ============================================================================

fn test_kafka() -> !bool {
    print("  [6/10] Kafka operations... ");

    // Produce message
    assert_checks("
        async fn produce() -> !() {
            kafka·produce(\"my-topic\")
                .message(\"hello kafka\")
                .key(\"key1\")
                .await;
        }
    ", "kafka_produce");

    // Produce with partition
    assert_checks("
        async fn produce_partition() -> !() {
            kafka·produce(\"my-topic\")
                .message(\"hello\")
                .partition(0)
                .await;
        }
    ", "kafka_produce_partition");

    // Consume messages
    assert_checks("
        async fn consume() -> ~Stream<Message> {
            return kafka·consume(\"my-topic\")
                .group(\"my-group\")
                .await;
        }
    ", "kafka_consume");

    // Consume from offset
    assert_checks("
        async fn consume_offset() -> ~Stream<Message> {
            return kafka·consume(\"my-topic\")
                .offset(100)
                .await;
        }
    ", "kafka_consume_offset");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 7. GRAPHQL OPERATIONS
// ============================================================================

fn test_graphql() -> !bool {
    print("  [7/10] GraphQL operations... ");

    // Query
    assert_checks("
        async fn query() -> ~Response {
            return graphql·query(\"https://api.example.com/graphql\")
                .document(\"query { users { id name } }\")
                .await;
        }
    ", "graphql_query");

    // Query with variables
    assert_checks("
        async fn query_vars() -> ~Response {
            return graphql·query(\"https://api.example.com/graphql\")
                .document(\"query($id: ID!) { user(id: $id) { name } }\")
                .variables({ \"id\": \"123\" })
                .await;
        }
    ", "graphql_variables");

    // Mutation
    assert_checks("
        async fn mutate() -> ~Response {
            return graphql·mutation(\"https://api.example.com/graphql\")
                .document(\"mutation { createUser(name: \\\"Test\\\") { id } }\")
                .await;
        }
    ", "graphql_mutation");

    // Subscription
    assert_checks("
        async fn subscribe() -> ~Stream<Response> {
            return graphql·subscription(\"wss://api.example.com/graphql\")
                .document(\"subscription { newMessage { text } }\")
                .await;
        }
    ", "graphql_subscription");

    // With operation name
    assert_checks("
        async fn named_op() -> ~Response {
            return graphql·query(\"https://api.example.com/graphql\")
                .document(\"query GetUser { user { id } } query GetPosts { posts { id } }\")
                .operation_name(\"GetUser\")
                .await;
        }
    ", "graphql_operation_name");

    println("PASS (5 cases)");
    true
}

// ============================================================================
// 8. TRUST BOUNDARIES
// ============================================================================

fn test_trust_boundaries() -> !bool {
    print("  [8/10] Trust boundaries... ");

    // External data is reported
    assert_checks("
        async fn get_external() -> ~String {
            let response = http·get(\"https://api.example.com\").await;
            return response.text().await;  // Returns ~String (reported)
        }
    ", "external_reported");

    // Validation promotes to known
    assert_checks("
        async fn validate_input() -> !i32 {
            let response = http·get(\"https://api.example.com/number\").await;
            let text: ~String = response.text().await;
            let num: ~i32 = text.parse();
            // Validate before promoting to known
            if num >= 0 && num <= 100 {
                return num!;  // Explicit promotion
            }
            return 0;
        }
    ", "validate_promote");

    // Paradox on conflicting data
    assert_checks("
        async fn check_paradox() -> ‽bool {
            let a = http·get(\"https://api1.example.com/value\").await.json·<i32>();
            let b = http·get(\"https://api2.example.com/value\").await.json·<i32>();
            // If sources disagree, result is paradox
            return a == b;
        }
    ", "paradox_conflict");

    println("PASS (3 cases)");
    true
}

// ============================================================================
// 9. ERROR HANDLING
// ============================================================================

fn test_protocol_errors() -> !bool {
    print("  [9/10] Protocol error handling... ");

    // HTTP error handling
    assert_checks("
        async fn handle_error() -> !String {
            match http·get(\"https://api.example.com\").await {
                Response·Ok(r) => r.text().await.validate()!,
                Response·Err(e) => format!(\"Error: {}\", e),
            }
        }
    ", "http_error_handling");

    // Timeout handling
    assert_checks("
        async fn with_timeout() -> ?String {
            let result = http·get(\"https://api.example.com\")
                .timeout(1000)
                .await;
            match result {
                Response·Ok(r) => ?r.text().await,
                Response·Timeout => null,
                Response·Err(_) => null,
            }
        }
    ", "timeout_handling");

    // Retry logic
    assert_checks("
        async fn with_retry() -> ~Response {
            return http·get(\"https://api.example.com\")
                .retry(3)
                .backoff(1000)
                .await;
        }
    ", "retry_logic");

    // Circuit breaker
    assert_checks("
        async fn with_circuit_breaker() -> ~Response {
            return http·get(\"https://api.example.com\")
                .circuit_breaker(\"api-service\", 5, 30000)
                .await;
        }
    ", "circuit_breaker");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 10. PROTOCOL COMPOSITION
// ============================================================================

fn test_protocol_composition() -> !bool {
    print("  [10/10] Protocol composition... ");

    // Chained requests
    assert_checks("
        async fn chained() -> ~Data {
            let auth = http·post(\"https://auth.example.com/token\")
                .json({ \"client_id\": \"xxx\" })
                .await;
            let token = auth.json·<TokenResponse>().access_token;

            return http·get(\"https://api.example.com/data\")
                .header(\"Authorization\", format!(\"Bearer {}\", token))
                .await
                .json();
        }
    ", "chained_requests");

    // Parallel requests
    assert_checks("
        async fn parallel() -> !(~A, ~B) {
            let (a, b) = join!(
                http·get(\"https://api.example.com/a\").await.json(),
                http·get(\"https://api.example.com/b\").await.json(),
            );
            return (a, b);
        }
    ", "parallel_requests");

    // Protocol pipeline
    assert_checks("
        async fn pipeline() -> ![~Item] {
            return http·get(\"https://api.example.com/items\")
                .await
                .json·<[Item]>()
                |τ{item => item.enrich().await}
                |φ{item => item.is_valid()};
        }
    ", "protocol_pipeline");

    // Mixed protocols
    assert_checks("
        async fn mixed() -> !() {
            // Get config from HTTP
            let config = http·get(\"https://config.example.com\").await.json();

            // Connect WebSocket with config
            let ws = ws·connect(config.ws_url).await;

            // Publish to Kafka
            kafka·produce(\"events\")
                .message({ \"connected\": true })
                .await;
        }
    ", "mixed_protocols");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// Main Test Runner
// ============================================================================

pub fn main() -> !i32 {
    println("Testing Protocol Operations...");
    println("");

    let mut passed: !i32 = 0;
    let mut failed: !i32 = 0;

    if test_http_get() { passed = passed + 1; } else { failed = failed + 1; }
    if test_http_post() { passed = passed + 1; } else { failed = failed + 1; }
    if test_http_other() { passed = passed + 1; } else { failed = failed + 1; }
    if test_websocket() { passed = passed + 1; } else { failed = failed + 1; }
    if test_grpc() { passed = passed + 1; } else { failed = failed + 1; }
    if test_kafka() { passed = passed + 1; } else { failed = failed + 1; }
    if test_graphql() { passed = passed + 1; } else { failed = failed + 1; }
    if test_trust_boundaries() { passed = passed + 1; } else { failed = failed + 1; }
    if test_protocol_errors() { passed = passed + 1; } else { failed = failed + 1; }
    if test_protocol_composition() { passed = passed + 1; } else { failed = failed + 1; }

    println("");
    println("Results: {}/{} test groups passed", passed, passed + failed);

    if failed > 0 {
        println("FAILED: {} test groups failed", failed);
        return 1;
    }

    println("");
    println("All protocol tests passed! (~44 test cases)");
    return 0;
}
