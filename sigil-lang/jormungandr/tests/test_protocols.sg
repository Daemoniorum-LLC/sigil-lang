//! Comprehensive Protocol Operations Test Suite
//!
//! Tests HTTP, WebSocket, gRPC, Kafka, and GraphQL protocol operations
//! with evidence boundaries and trust propagation.
//! Target: 100% protocol coverage for regression detection.

use crate·parser·Parser;
use crate·typeck·TypeChecker;

// ============================================================================
// Test Helpers
// ============================================================================

/// Parse and type check protocol code
fn check_source(source: !&str) -> !bool {
    let mut parser = Parser·new(source.to_string());
    let ast = match parser.parse_file() {
        Result·Ok(a) => a,
        Result·Err(_) => return false,
    };
    let mut checker = TypeChecker·new();
    match checker.check_file(ast) {
        Result·Ok(_) => true,
        Result·Err(_) => false,
    }
}

fn assert_checks(source: !&str, name: !&str) {
    if !check_source(source) {
        panic(format!("FAIL {}: type check failed", name));
    }
}

fn assert_fails(source: !&str, name: !&str) {
    if check_source(source) {
        panic(format!("FAIL {}: should have failed", name));
    }
}

// ============================================================================
// 1. HTTP GET REQUESTS
// ============================================================================

fn test_http_get() -> !bool {
    print("  [1/10] HTTP GET requests... ");

    // Basic GET
    assert_checks("
        async fn fetch() -> ~Response {
            return http·get(\"https://api.example.com/data\").await;
        }
    ", "http_get_basic");

    // GET with headers
    assert_checks("
        async fn fetch_auth() -> ~Response {
            return http·get(\"https://api.example.com/data\")
                .header(\"Authorization\", \"Bearer token\")
                .await;
        }
    ", "http_get_headers");

    // GET with timeout
    assert_checks("
        async fn fetch_timeout() -> ~Response {
            return http·get(\"https://api.example.com/data\")
                .timeout(5000)
                .await;
        }
    ", "http_get_timeout");

    // GET with query params
    assert_checks("
        async fn fetch_query() -> ~Response {
            return http·get(\"https://api.example.com/search\")
                .query(\"q\", \"sigil\")
                .query(\"limit\", \"10\")
                .await;
        }
    ", "http_get_query");

    // Response is reported evidence (external data)
    assert_checks("
        async fn process() -> !String {
            let response: ~Response = http·get(\"https://api.example.com\").await;
            // Must validate before using as known
            let body: ~String = response.text().await;
            return body.validate()!;  // Explicit trust boundary
        }
    ", "http_evidence_boundary");

    println("PASS (5 cases)");
    true
}

// ============================================================================
// 2. HTTP POST REQUESTS
// ============================================================================

fn test_http_post() -> !bool {
    print("  [2/10] HTTP POST requests... ");

    // Basic POST
    assert_checks("
        async fn create() -> ~Response {
            return http·post(\"https://api.example.com/items\")
                .json({ \"name\": \"item\" })
                .await;
        }
    ", "http_post_basic");

    // POST with form data
    assert_checks("
        async fn submit_form() -> ~Response {
            return http·post(\"https://api.example.com/form\")
                .form([
                    (\"username\", \"user\"),
                    (\"password\", \"pass\"),
                ])
                .await;
        }
    ", "http_post_form");

    // POST with raw body
    assert_checks("
        async fn send_raw() -> ~Response {
            return http·post(\"https://api.example.com/raw\")
                .body(\"raw data\")
                .header(\"Content-Type\", \"text/plain\")
                .await;
        }
    ", "http_post_raw");

    // POST with JSON serialization
    assert_checks("
        struct Item { name: !String, value: !i32 }
        async fn create_item(item: !Item) -> ~Response {
            return http·post(\"https://api.example.com/items\")
                .json(item)
                .await;
        }
    ", "http_post_json_struct");

    println("PASS (4 cases)");
    true
}

