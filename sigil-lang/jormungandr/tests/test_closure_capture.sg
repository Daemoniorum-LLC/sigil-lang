//! Test ∀ closure capture ∈ the self-hosted compiler
//! This test verifies that closures properly capture variables from their enclosing scope.

/// Test that a closure captures a variable from outer scope
☉ λ test_closure_captures_outer_variable() -> !i32 {
    ≔ multiplier = 10;

    // This closure should capture 'multiplier'
    ≔ closure = |x: !i32| -> !i32 { x * multiplier };

    ≔ result = closure(5);

    // Should be 5 * 10 = 50
    ⎇ result == 50 {
        0  // success
    } ⎉ {
        1  // failure
    }
}

/// Test that pipe transforms capture outer variables
☉ λ test_pipe_captures_outer_variable() -> !i32 {
    ≔ offset = 100;

    // The transform closure should capture 'offset'
    ≔ numbers = [1, 2, 3];
    ≔ result = numbers|τ{n => n + offset}|collect();

    // Should be [101, 102, 103]
    ⎇ result[0] == 101 && result[1] == 102 && result[2] == 103 {
        0  // success
    } ⎉ {
        1  // failure
    }
}

/// Test nested closures with multiple captures
☉ λ test_nested_closure_captures() -> !i32 {
    ≔ a = 1;
    ≔ b = 2;

    // Outer closure captures 'a', inner closure captures both 'a' and 'b'
    ≔ outer = |x: !i32| -> !i32 {
        ≔ inner = |y: !i32| -> !i32 { x + y + a + b };
        inner(10)
    };

    ≔ result = outer(5);

    // Should be 5 + 10 + 1 + 2 = 18
    ⎇ result == 18 {
        0  // success
    } ⎉ {
        1  // failure
    }
}

☉ λ main() -> !i32 {
    ≔ t1 = test_closure_captures_outer_variable();
    ⎇ t1 != 0 {
        eprintln!("test_closure_captures_outer_variable failed");
        ⤺ t1;
    }

    ≔ t2 = test_pipe_captures_outer_variable();
    ⎇ t2 != 0 {
        eprintln!("test_pipe_captures_outer_variable failed");
        ⤺ t2;
    }

    ≔ t3 = test_nested_closure_captures();
    ⎇ t3 != 0 {
        eprintln!("test_nested_closure_captures failed");
        ⤺ t3;
    }

    println!("All closure capture tests passed!");
    0
}
