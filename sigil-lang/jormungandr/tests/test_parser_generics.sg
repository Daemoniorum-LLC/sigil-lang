//! Comprehensive Parser Generics Test Suite
//!
//! Tests generic syntax parsing ∀ functions, structs, enums, traits, and impls.
//! Target: 100% generic syntax coverage ∀ regression detection.

invoke crate·parser·Parser;

// ============================================================================
// Test Helpers
// ============================================================================

λ parse_file(source: !&str) -> !bool {
    ≔ Δ parser = Parser·new(source.to_string());
    ⌥ parser.parse_file() {
        Result·Ok(_) => true,
        Result·Err(_) => false,
    }
}

λ assert_parses(source: !&str, name: !&str) {
    ⎇ !parse_file(source) {
        panic(format!("FAIL {}: failed to parse", name));
    }
}

// ============================================================================
// 1. GENERIC FUNCTION SYNTAX
// ============================================================================

λ test_generic_functions() -> !bool {
    print("  [1/4] Generic function syntax... ");

    // Single type parameter
    assert_parses("λ identity<T>(x: !T) -> !T { ⤺ x; }", "fn_single_generic");

    // Multiple type parameters
    assert_parses("λ pair<A, B>(a: !A, b: !B) -> !(A, B) { ⤺ (a, b); }", "fn_multi_generic");

    // With bounds
    assert_parses("λ clone<T: Clone>(x: !T) -> !T { ⤺ x.clone(); }", "fn_bounded_generic");

    // Multiple bounds
    assert_parses("λ debug_clone<T: Clone + Debug>(x: !T) -> !T { ⤺ x; }", "fn_multi_bounded");

    // Where clause
    assert_parses("λ process<T>(x: !T) where T: Clone { }", "fn_where_clause");

    // Complex where clause
    assert_parses("λ complex<T, U>(x: !T, y: !U) where T: Clone + Send, U: Debug { }", "fn_complex_where");

    println("PASS (6 cases)");
    true
}

// ============================================================================
// 2. GENERIC STRUCT SYNTAX
// ============================================================================

λ test_generic_structs() -> !bool {
    print("  [2/4] Generic Σ syntax... ");

    // Single parameter
    assert_parses("Σ Box<T> { value: !T }", "struct_single_generic");

    // Multiple parameters
    assert_parses("Σ Pair<A, B> { first: !A, second: !B }", "struct_multi_generic");

    // With bounds ∈ definition
    assert_parses("Σ Clonable<T: Clone> { value: !T }", "struct_bounded");

    // Nested generics
    assert_parses("Σ Nested<T> { inner: !Box<T> }", "struct_nested_generic");

    // Where clause
    assert_parses("Σ Container<T> where T: Clone { value: !T }", "struct_where");

    println("PASS (5 cases)");
    true
}

// ============================================================================
// 3. GENERIC ENUM SYNTAX
// ============================================================================

λ test_generic_enums() -> !bool {
    print("  [3/4] Generic ᛈ syntax... ");

    // Option-like
    assert_parses("ᛈ Option<T> { Some(T), None }", "enum_option");

    // Result-like
    assert_parses("ᛈ Result<T, E> { Ok(T), Err(E) }", "enum_result");

    // With bounds
    assert_parses("ᛈ Bounded<T: Clone> { Value(T), Empty }", "enum_bounded");

    // Complex variants
    assert_parses("ᛈ Tree<T> { Leaf(T), Node { left: Box<Tree<T>>, right: Box<Tree<T>> } }", "enum_tree");

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 4. GENERIC IMPL AND TRAIT SYNTAX
// ============================================================================

λ test_generic_impl_trait() -> !bool {
    print("  [4/4] Generic ⊢/Θ syntax... ");

    // Generic Θ
    assert_parses("Θ From<T> { λ from(value: !T) -> !Self; }", "trait_generic");

    // Generic ⊢
    assert_parses("Σ Wrapper<T> { v: !T } ⊢<T> Wrapper<T> { λ new(v: !T) -> !Self { Self { v } } }", "impl_generic");

    // Impl Θ ∀ generic
    assert_parses("Θ Clone {} Σ Box<T> {} ⊢<T: Clone> Clone ∀ Box<T> {}", "impl_trait_generic");

    // Turbofish ∈ expression
    assert_parses("λ test() { ≔ x = Vec·<i32>·new(); }", "turbofish_expr");

    // Turbofish ∈ method
    assert_parses("λ test() { ≔ x = iter.collect·<Vec<_>>(); }", "turbofish_method");

    println("PASS (5 cases)");
    true
}

// ============================================================================
// Main Test Runner
// ============================================================================

☉ λ main() -> !i32 {
    println("Testing Parser Generics...");
    println("");

    ≔ Δ passed: !i32 = 0;
    ≔ Δ failed: !i32 = 0;

    ⎇ test_generic_functions() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_generic_structs() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_generic_enums() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_generic_impl_trait() { passed = passed + 1; } ⎉ { failed = failed + 1; }

    println("");
    println("Results: {}/{} test groups passed", passed, passed + failed);

    ⎇ failed > 0 {
        println("FAILED: {} test groups failed", failed);
        ⤺ 1;
    }

    println("");
    println("All generic syntax tests passed! (~20 test cases)");
    ⤺ 0;
}
