// Test: Deeply nested ⎇
// Spec: 02-SYNTAX.md § 5.1 If
// Priority: P2 - Enhancement

λ main() {
    ≔ a: !i32 = 1;
    ≔ b: !i32 = 2;
    ≔ c: !i32 = 3;

    ⎇ a > 0 {
        ⎇ b > 1 {
            ⎇ c > 2 {
                println(1);
            } ⎉ {
                println(0);
            }
        } ⎉ {
            println(0);
        }
    } ⎉ {
        println(0);
    }
}
