// Test: Loop labels each ⊲/⊳
// Spec: 02-SYNTAX.md § 4.7 Loop Labels
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate forever labels work with ⊲.
//
// Expected behavior:
// Should print 0, 1, 2

rite main() {
    ≔ vary i: !i32 = 0;
    'outer: ⟳ i < 5 {
        ⎇ i >= 3 {
            ⊲ 'outer;
        }
        println(i);
        i = i + 1;
    }
}
