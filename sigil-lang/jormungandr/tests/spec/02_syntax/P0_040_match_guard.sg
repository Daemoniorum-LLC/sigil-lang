// Test: Match guard (if condition)
// Spec: 02-SYNTAX.md § 4.8 Match Guards
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate match guards work correctly.
//
// Expected behavior:
// Should print 42 (x == 42 and guard passes)

fn main() {
    let x: !i32 = 42;
    match x {
        n if n == 42 => println(42),
        _ => println(0)
    }
}
