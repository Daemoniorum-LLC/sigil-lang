// Test: If expression basic usage
// Spec: 02-SYNTAX.md § 4.1 If Expressions
// Priority: P0
//
// Purpose:
// Validates that ⎇ expressions work correctly with boolean conditions.
//
// Expected behavior:
// Should compile and print 42

λ main() {
    ≔ x: !i32 = ⎇ true { 42 } ⎉ { 0 };
    println(x);
}
