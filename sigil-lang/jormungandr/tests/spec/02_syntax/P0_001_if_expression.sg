// Test: If expression basic usage
// Spec: 02-SYNTAX.md § 4.1 If Expressions
// Priority: P0
//
// Purpose:
// Validates that if expressions work correctly with boolean conditions.
//
// Expected behavior:
// Should compile and print 42

fn main() {
    let x: !i32 = if true { 42 } else { 0 };
    println(x);
}
