// Test: Chained if-else-if expressions
// Spec: 02-SYNTAX.md § 5.1 If
// Priority: P2 - Enhancement

fn main() {
    let x: !i32 = 15;

    if x < 10 {
        println(1);
    } else if x < 20 {
        println(2);
    } else if x < 30 {
        println(3);
    } else {
        println(4);
    }
}
