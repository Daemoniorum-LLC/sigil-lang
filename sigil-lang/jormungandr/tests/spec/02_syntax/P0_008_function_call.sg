// Test: Function call with arguments
// Spec: 02-SYNTAX.md § 3.3 Function Calls
// Priority: P0
//
// Purpose:
// Validates that functions can be called with arguments.
//
// Expected behavior:
// Should compile and print 84

λ add(x: !i32, y: !i32) -> !i32 {
    x + y
}

λ main() {
    println(add(42, 42));
}
