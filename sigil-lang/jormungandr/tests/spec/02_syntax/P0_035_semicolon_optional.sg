// Test: Semicolon optional for last expression
// Spec: 02-SYNTAX.md § 3.6 Expression vs Statement
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate last expression without semicolon is returned.
//
// Expected behavior:
// Should print 42

fn get_value() -> !i32 {
    let x: !i32 = 42;
    x
}

fn main() {
    println(get_value());
}
