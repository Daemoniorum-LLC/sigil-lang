// Test: Break statement ∈ loop
// Spec: 02-SYNTAX.md § 4.4 Break Statement
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate ⊗ statement exits loops correctly.
//
// Expected behavior:
// Should print 0, 1, 2 (breaks at 3)

λ main() {
    ≔ Δ i: !i32 = 0;
    ⟳ true {
        ⎇ i >= 3 {
            ⊗;
        }
        println(i);
        i = i + 1;
    }
}
