// Test: Match expression with enum
// Spec: 02-SYNTAX.md § 4.3 Match Expressions
// Priority: P0
//
// KNOWN FAILURE: C Codegen Bug
// Enum variant constructors are redefined in generated C.
// Related to CG-006 (deterministic output) and enum codegen.
//
// Purpose:
// Validates that match expressions work with enums.
//
// Expected behavior:
// Should compile and print 42

pub enum Option {
    Some(!i32),
    None
}

fn main() {
    let x: !Option = Option::Some(42);
    let y: !i32 = match x {
        Option::Some(v) => v,
        Option::None => 0,
    };
    println(y);
}
