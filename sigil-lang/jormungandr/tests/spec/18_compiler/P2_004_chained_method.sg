// Test: Chained method calls
// Spec: 18-COMPILER.md § 4.4 Method Resolution
// Priority: P2 - Enhancement

struct Builder {
    value: !i32,
}

impl Builder {
    fn new() -> Builder {
        Builder { value: 0 }
    }

    fn add(&mut self, n: !i32) -> &mut Builder {
        self.value = self.value + n;
        self
    }

    fn build(&self) -> !i32 {
        self.value
    }
}

fn main() {
    let mut b = Builder·new();
    b.add(10);
    b.add(20);
    println(b.build());
}
