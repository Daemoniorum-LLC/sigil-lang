// Test: Enum variant compilation
// Spec: 18-COMPILER.md § 4.2 Enums
// Priority: P1 - Production Ready

ᛈ Status {
    Active,
    Inactive,
    Pending,
}

λ main() {
    ≔ s = Status·Active;

    ⌥ s {
        Status·Active => println(1),
        Status·Inactive => println(0),
        Status·Pending => println(2),
    }
}
