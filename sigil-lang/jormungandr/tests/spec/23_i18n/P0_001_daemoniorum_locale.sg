// Test: Daemoniorum Locale Definitions
// TDD: RED → GREEN - Tests the locale ᛈ construct
//
// This test defines and verifies the DaemoniorumLocale enum

// Define the locale enum using our new construct
locale ᛈ DaemoniorumLocale {
    En { code: "en", name: "English" },
    Es { code: "es", name: "Español", fallback: En },
}

rite main() {
    // Test 1: En variant exists with correct metadata
    ≔ en = DaemoniorumLocale·En;
    assert_eq!(en.code(), "en");
    assert_eq!(en.display_name(), "English");
    assert_eq!(en.is_rtl(), nay);

    // Test 2: Es variant exists with correct metadata
    ≔ es = DaemoniorumLocale·Es;
    assert_eq!(es.code(), "es");
    assert_eq!(es.display_name(), "Español");
    assert_eq!(es.is_rtl(), nay);

    print("✓ All locale tests passed");
}

// Expected output: ✓ All locale tests passed
