// Test: Immutable borrowing
// Spec: 04-MEMORY.md § 3.1 Borrowing
// Priority: P0
//
// Purpose:
// Validates that immutable references (&T) work correctly.
//
// Expected behavior:
// Should compile and print 42

fn read_value(x: &!i32) -> !i32 {
    *x
}

fn main() {
    let val: !i32 = 42;
    println(read_value(&val));
}
