// Test: Weak references with Rc
// Spec: 04-MEMORY.md § 4.4 Weak
// Priority: P1 - Production Ready

fn main() {
    let rc: Rc<i32> = Rc·new(100);

    // Downgrade to weak
    let weak: Weak<i32> = Rc·downgrade(&rc);

    // Weak exists (doesn't prevent drop, but exists)
    println(*rc);

    // Clone the Rc
    let rc2 = rc.clone();
    println(*rc2);
}
