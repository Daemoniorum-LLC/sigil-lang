// Test: Drop trait basic usage
// Spec: 04-MEMORY.md § 2.4 Drop Trait
// Priority: P0 - Bootstrap Critical
//
// FIXED: Drop trait now works! (Jan 15, 2026)
// Rust compiler automatically calls Drop·drop() when values go out of scope.
//
// Purpose:
// Validate Drop trait executes cleanup correctly.
//
// Expected behavior:
// Should print 42 then "dropped"

pub struct Value {
    x: !i32
}

impl Drop for Value {
    fn drop(mut self) {
        println("dropped");
    }
}

fn main() {
    let v: !Value = Value { x: 42 };
    println(v.x);
}
