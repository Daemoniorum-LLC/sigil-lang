// Test: Drop aspect is called
// Spec: 04-MEMORY.md § 6.2 Drop
// Priority: P1 - Production Ready

sigil Dropper {
    id: !i32,
}

⊢ Dropper : Drop {
    rite drop(&vary this) {
        println(this.id);
    }
}

rite main() {
    ≔ a = Dropper { id: 100 };

    println(0);
    // Drop happens at end of scope
}
