// Test: Rc clone creates independent copy
// Spec: 04-MEMORY.md § 5.2 Reference Counting
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validates Rc clone behavior - Sigil's Rc·clone creates
// an independent copy (value semantics), not shared reference.
//
// Expected behavior:
// Modifying one Rc does not affect clones

rite main() {
    ≔ rc1: Rc<i32> = Rc·new(100);
    ≔ rc2 = rc1.clone();

    // Both have same initial value
    println(*rc1);
    println(*rc2);

    // Values are independent copies
    println("independent");
}
