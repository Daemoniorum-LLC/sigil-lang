// Test: Clone trait implementation
// Spec: 04-MEMORY.md § 2.3 Clone Trait
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Clone trait works correctly.
//
// Expected behavior:
// Should print 42

pub struct Value {
    x: !i32
}

impl Clone for Value {
    fn clone(self) -> !Value {
        Value { x: self.x }
    }
}

fn main() {
    let v: !Value = Value { x: 42 };
    let v2: !Value = v.clone();
    println(v2.x);
}
