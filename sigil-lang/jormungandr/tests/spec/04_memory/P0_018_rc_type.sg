// Test: Rc (reference counted) type
// Spec: 04-MEMORY.md § 5.2 Reference Counting
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Rc allows shared ownership.
//
// Expected behavior:
// Should print 42

λ main() {
    ≔ rc: !Rc<!i32> = Rc·new(42);
    ≔ rc2: !Rc<!i32> = rc.clone();
    println(*rc2);
}
