// Test: Move semantics for owned values
// Spec: 04-MEMORY.md § 2.1 Move Semantics
// Priority: P0
//
// Purpose:
// Validates that owned values are moved, not copied.
//
// Expected behavior:
// Should compile and print 42

pub struct Data {
    value: !i32
}

fn consume(d: !Data) -> !i32 {
    d.value
}

fn main() {
    let d: !Data = Data { value: 42 };
    println(consume(d));
}
