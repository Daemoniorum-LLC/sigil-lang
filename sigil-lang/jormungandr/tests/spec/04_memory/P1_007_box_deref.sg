// Test: Box deref coercion
// Spec: 04-MEMORY.md § 4.1 Box
// Priority: P1 - Production Ready

λ takes_ref(x: &i32) -> !i32 {
    *x
}

λ main() {
    ≔ boxed: Box<i32> = Box·new(42);

    // Deref with *
    println(*boxed);

    // Box can coerce to reference
    ≔ result = takes_ref(&boxed);
    println(result);
}
