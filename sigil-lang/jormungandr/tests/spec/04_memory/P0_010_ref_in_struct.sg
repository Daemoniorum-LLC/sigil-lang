// Test: Reference as Σ field
// Spec: 04-MEMORY.md § 3.3 References ∈ Structs
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate references can be stored ∈ Σ fields.
//
// Expected behavior:
// Should print 42

☉ Σ Wrapper {
    inner: &!i32
}

λ main() {
    ≔ val: !i32 = 42;
    ≔ w: !Wrapper = Wrapper { inner: &val };
    println(*w.inner);
}
