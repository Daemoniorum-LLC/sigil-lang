// Test: Result map operation
// Spec: 09-STDLIB.md § 3.2 Result
// Priority: P2 - Enhancement

fn main() {
    let ok: Result<i32, String> = Result::Ok(21);

    let doubled = ok.map(|x| x * 2);

    match doubled {
        Result::Ok(v) => println(v),
        Result::Err(e) => println(0),
    }
}
