// Test: Vec is_empty check
// Spec: 09-STDLIB.md § 4.1 Vec
// Priority: P1 - Production Ready

fn main() {
    let v1: Vec<i32> = Vec·new();
    let v2: Vec<i32> = vec![1, 2];

    if v1.is_empty() {
        println(1);
    } else {
        println(0);
    }

    if v2.is_empty() {
        println(1);
    } else {
        println(0);
    }
}
