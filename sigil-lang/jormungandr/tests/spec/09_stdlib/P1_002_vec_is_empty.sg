// Test: Vec is_empty check
// Spec: 09-STDLIB.md § 4.1 Vec
// Priority: P1 - Production Ready

λ main() {
    ≔ v1: Vec<i32> = Vec·new();
    ≔ v2: Vec<i32> = vec![1, 2];

    ⎇ v1.is_empty() {
        println(1);
    } ⎉ {
        println(0);
    }

    ⎇ v2.is_empty() {
        println(1);
    } ⎉ {
        println(0);
    }
}
