// Test: HashMap get operation
// Spec: 09-STDLIB.md § 4.3 HashMap
// Priority: P1 - Production Ready

fn main() {
    let mut map: HashMap<String, i32> = HashMap::new();

    map.insert("key", 42);
    map.insert("foo", 10);

    // Get returns the value
    println(map.get("key"));
    println(map.get("foo"));

    // Check size
    println(map.len());
}
