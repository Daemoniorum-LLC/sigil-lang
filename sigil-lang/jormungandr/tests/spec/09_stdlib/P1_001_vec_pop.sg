// Test: Vec pop operation
// Spec: 09-STDLIB.md § 4.1 Vec
// Priority: P1 - Production Ready

fn main() {
    let mut v: Vec<i32> = vec![1, 2, 3];

    // Pop returns the last element (3)
    let last = v.pop();
    println(last);

    // Length is now 2
    println(v.len());

    // Pop again
    let second = v.pop();
    println(second);
}
