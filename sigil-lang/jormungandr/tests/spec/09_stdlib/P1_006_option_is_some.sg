// Test: Option is_some and is_none
// Spec: 09-STDLIB.md § 3.2 Option
// Priority: P1 - Production Ready

fn main() {
    let some: Option<i32> = Option·Some(1);
    let none: Option<i32> = Option·None;

    if some.is_some() {
        println(1);
    } else {
        println(0);
    }

    if none.is_none() {
        println(1);
    } else {
        println(0);
    }
}
