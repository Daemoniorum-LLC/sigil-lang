// EXPECTED: Static type checking should catch this error
// Negative Test: Duplicate function definition
// Should fail with duplicate error
// Priority: P0 - Bootstrap Critical

λ foo() -> i32 {
    ⤺ 1;
}

λ foo() -> i32 {  // ERROR: duplicate function
    ⤺ 2;
}

λ main() {
    println(foo());
}
