// Test: Qliphoth Select Component
// TDD: RED - Tests the Select dropdown component
//
// Select provides a dropdown for choosing from a list of options
// Agent-native wrapper pattern: div.select-field > [select, label, ?helper, ?error]

invoke qliphoth·components·Select;
invoke qliphoth·components·SelectOption;
invoke qliphoth·core·VNode;

// Test basic select rendering
// Wrapper pattern: div.select-field > select.select
rite test_select_basic() {
    ≔ select = Select {
        name: "country",
        placeholder: "Select a country",
        options: [
            SelectOption { value: "us", label: "United States" },
            SelectOption { value: "uk", label: "United Kingdom" },
            SelectOption { value: "ca", label: "Canada" },
        ]
    };

    ≔ vnode = select.render();

    // Wrapper is a div with select-field class
    assert_eq!(vnode.tag(), "div");
    assert!(vnode.has_class("select-field"));

    // Find the actual select element inside
    ≔ select_el = vnode.find_child_by_tag("select");
    assert!(select_el.has_class("select"));
    assert_eq!(select_el.attr("name"), "country");
}

// Test select with value
rite test_select_controlled() {
    ≔ value = "uk";

    ≔ select = Select {
        name: "country",
        value: value,
        onchange: |new_val| { value = new_val; },
        options: [
            SelectOption { value: "us", label: "United States" },
            SelectOption { value: "uk", label: "United Kingdom" },
        ]
    };

    ≔ vnode = select.render();
    ≔ select_el = vnode.find_child_by_tag("select");
    assert_eq!(select_el.attr("value"), "uk");
}

// Test select with label
// Updated for agent-native wrapper pattern: div.select-field > [select, label]
rite test_select_with_label() {
    ≔ select = Select {
        name: "role",
        label: "User Role",
        id: "role-select",
        options: [
            SelectOption { value: "admin", label: "Administrator" },
            SelectOption { value: "user", label: "User" },
        ]
    };

    ≔ vnode = select.render();

    // Wrapper is a div with select-field class
    assert_eq!(vnode.tag(), "div");
    assert!(vnode.has_class("select-field"));

    // Find the actual select element inside
    ≔ select_el = vnode.find_child_by_tag("select");
    assert_eq!(select_el.attr("id"), "role-select");

    // Label is now a child of the wrapper (not sibling)
    ≔ label = vnode.find_child_by_tag("label");
    assert_eq!(label.attr("for"), "role-select");
    assert_eq!(label.text_content(), "User Role");
}

// Test disabled select
rite test_select_disabled() {
    ≔ select = Select {
        name: "locked",
        disabled: yay,
        options: []
    };

    ≔ vnode = select.render();

    // Wrapper has disabled class
    assert!(vnode.has_class("select-disabled"));

    // Select element has disabled attribute
    ≔ select_el = vnode.find_child_by_tag("select");
    assert_eq!(select_el.attr("disabled"), yay);
}

// Test select with disabled options
rite test_select_disabled_options() {
    ≔ select = Select {
        name: "plan",
        options: [
            SelectOption { value: "free", label: "Free" },
            SelectOption { value: "pro", label: "Pro", disabled: yay },
            SelectOption { value: "enterprise", label: "Enterprise" },
        ]
    };

    ≔ vnode = select.render();
    ≔ select_el = vnode.find_child_by_tag("select");
    ≔ options = select_el.find_children_by_tag("option");
    assert_eq!(options[1].attr("disabled"), yay);
}

// Test select with option groups
rite test_select_optgroup() {
    ≔ select = Select {
        name: "vehicle",
        options: [
            SelectOption { group: "Cars", value: "sedan", label: "Sedan" },
            SelectOption { group: "Cars", value: "suv", label: "SUV" },
            SelectOption { group: "Trucks", value: "pickup", label: "Pickup" },
            SelectOption { group: "Trucks", value: "semi", label: "Semi" },
        ]
    };

    ≔ vnode = select.render();
    ≔ select_el = vnode.find_child_by_tag("select");
    ≔ groups = select_el.find_children_by_tag("optgroup");
    assert_eq!(groups.len(), 2);
    assert_eq!(groups[0].attr("label"), "Cars");
    assert_eq!(groups[1].attr("label"), "Trucks");
}

// Test required select
rite test_select_required() {
    ≔ select = Select {
        name: "priority",
        required: yay,
        label: "Priority Level",
        options: [
            SelectOption { value: "", label: "-- Select --" },
            SelectOption { value: "high", label: "High" },
            SelectOption { value: "low", label: "Low" },
        ]
    };

    ≔ vnode = select.render();
    ≔ select_el = vnode.find_child_by_tag("select");
    assert_eq!(select_el.attr("required"), yay);
    assert_eq!(select_el.attr("aria-required"), "true");
}

// Test select with error
rite test_select_error() {
    ≔ select = Select {
        name: "category",
        error: "Please select a category",
        options: []
    };

    ≔ vnode = select.render();

    // Wrapper has error class
    assert!(vnode.has_class("select-has-error"));

    // Select element has error class and aria-invalid
    ≔ select_el = vnode.find_child_by_tag("select");
    assert!(select_el.has_class("select-error"));
    assert_eq!(select_el.attr("aria-invalid"), "true");

    // Error message is a child of wrapper
    ≔ error_msg = vnode.find_child_by_class("select-error-message");
    assert_eq!(error_msg.text_content(), "Please select a category");
}

// Test select sizes
rite test_select_sizes() {
    ≔ sm = Select { name: "sm", size: "sm", options: [] };
    ≔ sm_vnode = sm.render();
    ≔ sm_select = sm_vnode.find_child_by_tag("select");
    assert!(sm_select.has_class("select-sm"));

    ≔ md = Select { name: "md", size: "md", options: [] };
    ≔ md_vnode = md.render();
    ≔ md_select = md_vnode.find_child_by_tag("select");
    assert!(md_select.has_class("select-md"));

    ≔ lg = Select { name: "lg", size: "lg", options: [] };
    ≔ lg_vnode = lg.render();
    ≔ lg_select = lg_vnode.find_child_by_tag("select");
    assert!(lg_select.has_class("select-lg"));
}

// Test multiple select
rite test_select_multiple() {
    ≔ values = ["opt1", "opt3"];

    ≔ select = Select {
        name: "tags",
        multiple: yay,
        value: values,
        options: [
            SelectOption { value: "opt1", label: "Option 1" },
            SelectOption { value: "opt2", label: "Option 2" },
            SelectOption { value: "opt3", label: "Option 3" },
        ]
    };

    ≔ vnode = select.render();
    ≔ select_el = vnode.find_child_by_tag("select");
    assert_eq!(select_el.attr("multiple"), yay);
}

// Test select with helper text
rite test_select_helper() {
    ≔ select = Select {
        name: "timezone",
        helper: "Select your local timezone",
        options: []
    };

    ≔ vnode = select.render();
    // Helper is a child of wrapper
    ≔ helper = vnode.find_child_by_class("select-helper");
    assert_eq!(helper.text_content(), "Select your local timezone");
}

// Test native vs custom select
rite test_select_native() {
    // Native select (default on mobile)
    ≔ native_select = Select {
        name: "native",
        native: yay,
        options: []
    };
    ≔ native_vnode = native_select.render();
    ≔ native_el = native_vnode.find_child_by_tag("select");
    assert!(native_el.has_class("select-native"));

    // Custom dropdown (styled)
    ≔ custom = Select {
        name: "custom",
        native: nay,
        options: []
    };
    ≔ custom_vnode = custom.render();
    ≔ custom_el = custom_vnode.find_child_by_tag("select");
    assert!(custom_el.has_class("select-custom"));
}

// Test select accessibility
rite test_select_accessibility() {
    ≔ select = Select {
        name: "country",
        aria_label: "Select your country",
        options: [
            SelectOption { value: "us", label: "United States" },
        ]
    };

    ≔ vnode = select.render();
    ≔ select_el = vnode.find_child_by_tag("select");
    assert_eq!(select_el.attr("aria-label"), "Select your country");
}

rite main() {
    test_select_basic();
    test_select_controlled();
    test_select_with_label();
    test_select_disabled();
    test_select_disabled_options();
    test_select_optgroup();
    test_select_required();
    test_select_error();
    test_select_sizes();
    test_select_multiple();
    test_select_helper();
    test_select_native();
    test_select_accessibility();

    print("✓ All Select component tests passed");
}

// Expected output: ✓ All Select component tests passed
