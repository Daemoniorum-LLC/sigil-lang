// Test: Qliphoth Checkbox Component
// TDD: RED - Tests the Checkbox form control
//
// Checkbox for boolean selections with indeterminate state support
// Wrapper pattern: div.checkbox-field > [input.checkbox, label, ?description, ?error]

invoke qliphoth·components·Checkbox;
invoke qliphoth·core·VNode;

// Test basic checkbox rendering
rite test_checkbox_basic() {
    ≔ checkbox = Checkbox {
        name: "agree",
        label: "I agree to the terms",
    };

    ≔ vnode = checkbox.render();

    // Wrapper is a div
    assert_eq!(vnode.tag(), "div");
    assert!(vnode.has_class("checkbox-field"));

    // Find the actual input element inside
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("type"), "checkbox");
    assert_eq!(input_el.attr("name"), "agree");
    assert!(input_el.has_class("checkbox"));
}

// Test checkbox checked state
rite test_checkbox_checked() {
    ≔ checked = yay;

    ≔ checkbox = Checkbox {
        name: "subscribe",
        checked: checked,
        onchange: |new_val| { checked = new_val; },
    };

    ≔ vnode = checkbox.render();
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("checked"), yay);
}

// Test checkbox with label
rite test_checkbox_with_label() {
    ≔ checkbox = Checkbox {
        name: "newsletter",
        label: "Subscribe to newsletter",
        id: "newsletter-checkbox",
    };

    ≔ vnode = checkbox.render();

    // Input should have id
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("id"), "newsletter-checkbox");

    // Label is now a child of the wrapper (not sibling)
    ≔ label = vnode.find_child_by_tag("label");
    assert_eq!(label.attr("for"), "newsletter-checkbox");
    assert_eq!(label.text_content(), "Subscribe to newsletter");
}

// Test checkbox label position
rite test_checkbox_label_position() {
    // Label on right (default)
    ≔ right = Checkbox { name: "r", label: "Right", label_position: "right" };
    assert!(right.render().has_class("checkbox-label-right"));

    // Label on left
    ≔ left = Checkbox { name: "l", label: "Left", label_position: "left" };
    assert!(left.render().has_class("checkbox-label-left"));
}

// Test disabled checkbox
rite test_checkbox_disabled() {
    ≔ checkbox = Checkbox {
        name: "disabled",
        disabled: yay,
        label: "Disabled option",
    };

    ≔ vnode = checkbox.render();
    // Wrapper has disabled class
    assert!(vnode.has_class("checkbox-disabled"));

    // Input element has disabled attr
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("disabled"), yay);
}

// Test indeterminate state
rite test_checkbox_indeterminate() {
    ≔ checkbox = Checkbox {
        name: "select-all",
        indeterminate: yay,
        label: "Select all",
    };

    ≔ vnode = checkbox.render();
    ≔ input_el = vnode.find_child_by_tag("input");
    // Indeterminate is set via JS property, not attribute
    assert_eq!(input_el.attr("data-indeterminate"), "true");
    assert!(input_el.has_class("checkbox-indeterminate"));
}

// Test checkbox sizes
rite test_checkbox_sizes() {
    ≔ sm = Checkbox { name: "sm", size: "sm" };
    ≔ sm_el = sm.render().find_child_by_tag("input");
    assert!(sm_el.has_class("checkbox-sm"));

    ≔ md = Checkbox { name: "md", size: "md" };
    ≔ md_el = md.render().find_child_by_tag("input");
    assert!(md_el.has_class("checkbox-md"));

    ≔ lg = Checkbox { name: "lg", size: "lg" };
    ≔ lg_el = lg.render().find_child_by_tag("input");
    assert!(lg_el.has_class("checkbox-lg"));
}

// Test checkbox with error
rite test_checkbox_error() {
    ≔ checkbox = Checkbox {
        name: "agree",
        id: "agree-checkbox",
        error: "You must agree to continue",
        required: yay,
    };

    ≔ vnode = checkbox.render();

    // Wrapper has error class
    assert!(vnode.has_class("checkbox-error"));

    // Input has aria-invalid
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("aria-invalid"), "true");

    // Error message is now a child of the wrapper
    ≔ error_msg = vnode.find_child_by_class("checkbox-error-message");
    assert_eq!(error_msg.text_content(), "You must agree to continue");
}

// Test checkbox with description
rite test_checkbox_description() {
    ≔ checkbox = Checkbox {
        name: "marketing",
        id: "marketing-checkbox",
        label: "Marketing emails",
        description: "Receive updates about new features and promotions",
    };

    ≔ vnode = checkbox.render();

    // Description is now a child of the wrapper
    ≔ desc = vnode.find_child_by_class("checkbox-description");
    assert_eq!(desc.text_content(), "Receive updates about new features and promotions");

    // Description should be linked via aria-describedby
    ≔ input_el = vnode.find_child_by_tag("input");
    assert!(input_el.attr("aria-describedby").contains("description"));
}

// Test checkbox value (for form submission)
rite test_checkbox_value() {
    ≔ checkbox = Checkbox {
        name: "color",
        value: "blue",
        label: "Blue",
    };

    ≔ vnode = checkbox.render();
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("value"), "blue");
}

// Test checkbox accessibility
rite test_checkbox_accessibility() {
    ≔ checkbox = Checkbox {
        name: "toggle",
        aria_label: "Toggle dark mode",
    };

    ≔ vnode = checkbox.render();
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("aria-label"), "Toggle dark mode");
}

// Test checkbox group (multiple checkboxes)
rite test_checkbox_group() {
    ≔ selected = ["opt1", "opt3"];

    ≔ group = CheckboxGroup {
        name: "options",
        label: "Select options",
        value: selected,
        onchange: |new_vals| { selected = new_vals; },
        options: [
            { value: "opt1", label: "Option 1" },
            { value: "opt2", label: "Option 2" },
            { value: "opt3", label: "Option 3" },
        ]
    };

    ≔ vnode = group.render();
    assert!(vnode.has_class("checkbox-group"));
    assert_eq!(vnode.attr("role"), "group");

    // First and third should be checked
    ≔ checkboxes = vnode.find_children_by_class("checkbox");
    assert_eq!(checkboxes[0].attr("checked"), yay);
    assert_eq!(checkboxes[1].attr("checked"), nay);
    assert_eq!(checkboxes[2].attr("checked"), yay);
}

rite main() {
    test_checkbox_basic();
    test_checkbox_checked();
    test_checkbox_with_label();
    test_checkbox_label_position();
    test_checkbox_disabled();
    test_checkbox_indeterminate();
    test_checkbox_sizes();
    test_checkbox_error();
    test_checkbox_description();
    test_checkbox_value();
    test_checkbox_accessibility();
    test_checkbox_group();

    print("✓ All Checkbox component tests passed");
}

// Expected output: ✓ All Checkbox component tests passed
