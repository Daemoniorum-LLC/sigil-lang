// Test: Qliphoth Button Component
// TDD: RED - Tests the Button base component
//
// Button is a fundamental UI primitive with variants and states

invoke qliphoth·components·Button;
invoke qliphoth·core·VNode;

// Test button rendering with default props
rite test_button_default() {
    ≔ btn = Button {
        label: "Click me",
        onclick: || { },
    };

    ≔ vnode = btn.render();

    // Should render a button element
    assert_eq!(vnode.tag(), "button");
    assert_eq!(vnode.text_content(), "Click me");

    // Default variant should be "primary"
    assert!(vnode.has_class("btn-primary"));

    // Should not be disabled by default
    assert_eq!(vnode.attr("disabled"), nay);
}

// Test button variants
rite test_button_variants() {
    // Primary variant
    ≔ primary = Button { label: "Primary", variant: "primary", onclick: || {} };
    assert!(primary.render().has_class("btn-primary"));

    // Secondary variant
    ≔ secondary = Button { label: "Secondary", variant: "secondary", onclick: || {} };
    assert!(secondary.render().has_class("btn-secondary"));

    // Outline variant
    ≔ outline = Button { label: "Outline", variant: "outline", onclick: || {} };
    assert!(outline.render().has_class("btn-outline"));

    // Ghost variant
    ≔ ghost = Button { label: "Ghost", variant: "ghost", onclick: || {} };
    assert!(ghost.render().has_class("btn-ghost"));

    // Danger variant
    ≔ danger = Button { label: "Danger", variant: "danger", onclick: || {} };
    assert!(danger.render().has_class("btn-danger"));
}

// Test button sizes
rite test_button_sizes() {
    ≔ sm = Button { label: "Small", size: "sm", onclick: || {} };
    assert!(sm.render().has_class("btn-sm"));

    ≔ md = Button { label: "Medium", size: "md", onclick: || {} };
    assert!(md.render().has_class("btn-md"));

    ≔ lg = Button { label: "Large", size: "lg", onclick: || {} };
    assert!(lg.render().has_class("btn-lg"));
}

// Test disabled state
rite test_button_disabled() {
    ≔ btn = Button {
        label: "Disabled",
        disabled: yay,
        onclick: || {},
    };

    ≔ vnode = btn.render();
    assert_eq!(vnode.attr("disabled"), yay);
    assert!(vnode.has_class("btn-disabled"));

    // Disabled button should have aria-disabled
    assert_eq!(vnode.attr("aria-disabled"), "true");
}

// Test loading state
rite test_button_loading() {
    ≔ btn = Button {
        label: "Submit",
        loading: yay,
        onclick: || {},
    };

    ≔ vnode = btn.render();

    // Should show spinner when loading
    assert!(vnode.has_child_with_class("btn-spinner"));

    // Should be disabled when loading
    assert_eq!(vnode.attr("disabled"), yay);

    // Should have aria-busy
    assert_eq!(vnode.attr("aria-busy"), "true");
}

// Test button with icon
rite test_button_with_icon() {
    ≔ btn = Button {
        label: "Save",
        icon: "save",
        icon_position: "left",
        onclick: || {},
    };

    ≔ vnode = btn.render();

    // Should have icon element
    assert!(vnode.has_child_with_class("btn-icon"));

    // Icon should be on left
    ≔ children = vnode.children();
    assert_eq!(children[0].has_class("btn-icon"), yay);
}

// Test accessibility
rite test_button_accessibility() {
    // Button with aria-label
    ≔ icon_only = Button {
        icon: "close",
        aria_label: "Close dialog",
        onclick: || {},
    };

    ≔ vnode = icon_only.render();
    assert_eq!(vnode.attr("aria-label"), "Close dialog");

    // Button should have type="button" by default (not submit)
    assert_eq!(vnode.attr("type"), "button");
}

// Test button as submit
rite test_button_submit() {
    ≔ btn = Button {
        label: "Submit Form",
        button_type: "submit",
        onclick: || {},
    };

    assert_eq!(btn.render().attr("type"), "submit");
}

rite main() {
    test_button_default();
    test_button_variants();
    test_button_sizes();
    test_button_disabled();
    test_button_loading();
    test_button_with_icon();
    test_button_accessibility();
    test_button_submit();

    print("✓ All Button component tests passed");
}

// Expected output: ✓ All Button component tests passed
