// Test: Qliphoth Input Component
// TDD: RED - Tests the Input form component
//
// Input is a text input field with validation and accessibility
// Wrapper pattern: div.input-field > [input, label, ?helper, ?error]

invoke qliphoth·components·Input;
invoke qliphoth·components·Label;
invoke qliphoth·core·VNode;

// Test basic input rendering
rite test_input_basic() {
    ≔ input = Input {
        name: "email",
        placeholder: "Enter email",
    };

    ≔ vnode = input.render();

    // Wrapper is a div
    assert_eq!(vnode.tag(), "div");
    assert!(vnode.has_class("input-field"));

    // Find the actual input element inside
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("name"), "email");
    assert_eq!(input_el.attr("placeholder"), "Enter email");
    assert_eq!(input_el.attr("type"), "text"); // default type
}

// Test input types
rite test_input_types() {
    // Text (default)
    ≔ text_input = Input { name: "text", input_type: "text" };
    ≔ text_el = text_input.render().find_child_by_tag("input");
    assert_eq!(text_el.attr("type"), "text");

    // Email
    ≔ email = Input { name: "email", input_type: "email" };
    ≔ email_el = email.render().find_child_by_tag("input");
    assert_eq!(email_el.attr("type"), "email");

    // Password
    ≔ password = Input { name: "password", input_type: "password" };
    ≔ password_el = password.render().find_child_by_tag("input");
    assert_eq!(password_el.attr("type"), "password");

    // Number
    ≔ number = Input { name: "count", input_type: "number" };
    ≔ number_el = number.render().find_child_by_tag("input");
    assert_eq!(number_el.attr("type"), "number");

    // Search
    ≔ search = Input { name: "query", input_type: "search" };
    ≔ search_el = search.render().find_child_by_tag("input");
    assert_eq!(search_el.attr("type"), "search");

    // Tel
    ≔ tel = Input { name: "phone", input_type: "tel" };
    ≔ tel_el = tel.render().find_child_by_tag("input");
    assert_eq!(tel_el.attr("type"), "tel");

    // URL
    ≔ url = Input { name: "website", input_type: "url" };
    ≔ url_el = url.render().find_child_by_tag("input");
    assert_eq!(url_el.attr("type"), "url");
}

// Test controlled input
rite test_input_controlled() {
    ≔ value = "initial";

    ≔ input = Input {
        name: "test",
        value: value,
        onchange: |new_val| { value = new_val; },
    };

    ≔ vnode = input.render();
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("value"), "initial");
}

// Test input with label
rite test_input_with_label() {
    ≔ input = Input {
        name: "username",
        label: "Username",
        id: "username-field",
    };

    ≔ vnode = input.render();

    // Input should have id for label association
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("id"), "username-field");

    // Label is now a child of the wrapper (not sibling)
    ≔ label = vnode.find_child_by_tag("label");
    assert_eq!(label.attr("for"), "username-field");
    assert_eq!(label.text_content(), "Username");
}

// Test required input
rite test_input_required() {
    ≔ input = Input {
        name: "email",
        required: yay,
        label: "Email",
    };

    ≔ vnode = input.render();
    ≔ input_el = vnode.find_child_by_tag("input");

    assert_eq!(input_el.attr("required"), yay);
    assert_eq!(input_el.attr("aria-required"), "true");
}

// Test disabled input
rite test_input_disabled() {
    ≔ input = Input {
        name: "readonly",
        disabled: yay,
    };

    ≔ vnode = input.render();

    // Wrapper has disabled class
    assert!(vnode.has_class("input-disabled"));

    // Input element has disabled attr
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("disabled"), yay);
}

// Test input with error
rite test_input_error() {
    ≔ input = Input {
        name: "email",
        id: "email-field",
        error: "Invalid email format",
    };

    ≔ vnode = input.render();

    // Wrapper should have error styling
    assert!(vnode.has_class("input-has-error"));

    // Input should have error styling and aria-invalid
    ≔ input_el = vnode.find_child_by_tag("input");
    assert!(input_el.has_class("input-error"));
    assert_eq!(input_el.attr("aria-invalid"), "true");

    // Error message is now a child of the wrapper
    ≔ error_msg = vnode.find_child_by_class("input-error-message");
    assert_eq!(error_msg.text_content(), "Invalid email format");

    // Error message should be associated via aria-describedby
    assert!(input_el.attr("aria-describedby").contains("error"));
}

// Test input with helper text
rite test_input_helper() {
    ≔ input = Input {
        name: "password",
        id: "password-field",
        helper: "Must be at least 8 characters",
    };

    ≔ vnode = input.render();
    ≔ input_el = vnode.find_child_by_tag("input");

    // Helper is now a child of the wrapper
    ≔ helper = vnode.find_child_by_class("input-helper");
    assert_eq!(helper.text_content(), "Must be at least 8 characters");

    // Helper should be associated via aria-describedby
    assert!(input_el.attr("aria-describedby").contains("helper"));
}

// Test input sizes
rite test_input_sizes() {
    ≔ sm = Input { name: "sm", size: "sm" };
    ≔ sm_el = sm.render().find_child_by_tag("input");
    assert!(sm_el.has_class("input-sm"));

    ≔ md = Input { name: "md", size: "md" };
    ≔ md_el = md.render().find_child_by_tag("input");
    assert!(md_el.has_class("input-md"));

    ≔ lg = Input { name: "lg", size: "lg" };
    ≔ lg_el = lg.render().find_child_by_tag("input");
    assert!(lg_el.has_class("input-lg"));
}

// Test input with prefix/suffix (these are children of the input element)
rite test_input_affixes() {
    // With prefix
    ≔ with_prefix = Input {
        name: "website",
        prefix: "https://",
    };
    ≔ prefix_input = with_prefix.render().find_child_by_tag("input");
    assert!(prefix_input.has_child_with_class("input-prefix"));

    // With suffix
    ≔ with_suffix = Input {
        name: "email",
        suffix: "@example.com",
    };
    ≔ suffix_input = with_suffix.render().find_child_by_tag("input");
    assert!(suffix_input.has_child_with_class("input-suffix"));

    // With icon prefix
    ≔ with_icon = Input {
        name: "search",
        prefix_icon: "search",
    };
    ≔ icon_input = with_icon.render().find_child_by_tag("input");
    assert!(icon_input.has_child_with_class("input-icon"));
}

// Test input max/min length
rite test_input_length_constraints() {
    ≔ input = Input {
        name: "bio",
        min_length: 10,
        max_length: 200,
    };

    ≔ vnode = input.render();
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("minlength"), "10");
    assert_eq!(input_el.attr("maxlength"), "200");
}

// Test input pattern validation
rite test_input_pattern() {
    ≔ input = Input {
        name: "code",
        pattern: "[A-Z]{3}-[0-9]{4}",
        title: "Format: ABC-1234",
    };

    ≔ vnode = input.render();
    ≔ input_el = vnode.find_child_by_tag("input");
    assert_eq!(input_el.attr("pattern"), "[A-Z]{3}-[0-9]{4}");
    assert_eq!(input_el.attr("title"), "Format: ABC-1234");
}

// Test autocomplete
rite test_input_autocomplete() {
    ≔ email = Input { name: "email", autocomplete: "email" };
    ≔ email_el = email.render().find_child_by_tag("input");
    assert_eq!(email_el.attr("autocomplete"), "email");

    ≔ password = Input { name: "password", autocomplete: "new-password" };
    ≔ password_el = password.render().find_child_by_tag("input");
    assert_eq!(password_el.attr("autocomplete"), "new-password");
}

rite main() {
    test_input_basic();
    test_input_types();
    test_input_controlled();
    test_input_with_label();
    test_input_required();
    test_input_disabled();
    test_input_error();
    test_input_helper();
    test_input_sizes();
    test_input_affixes();
    test_input_length_constraints();
    test_input_pattern();
    test_input_autocomplete();

    print("✓ All Input component tests passed");
}

// Expected output: ✓ All Input component tests passed
