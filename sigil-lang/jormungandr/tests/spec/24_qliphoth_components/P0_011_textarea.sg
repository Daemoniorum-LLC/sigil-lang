// Test: Qliphoth Textarea Component
// TDD: RED - Tests the Textarea multi-line input
//
// Textarea for longer text input with auto-resize support
// Wrapper pattern: div.textarea-field > [textarea, label, ?description, ?error]

invoke qliphoth·components·Textarea;
invoke qliphoth·core·VNode;

// Test basic textarea rendering
rite test_textarea_basic() {
    ≔ textarea = Textarea {
        name: "description",
        placeholder: "Enter description...",
    };

    ≔ vnode = textarea.render();

    // Wrapper is a div
    assert_eq!(vnode.tag(), "div");
    assert!(vnode.has_class("textarea-field"));

    // Find the actual textarea element inside
    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert_eq!(textarea_el.attr("name"), "description");
    assert_eq!(textarea_el.attr("placeholder"), "Enter description...");
    assert!(textarea_el.has_class("textarea"));
}

// Test controlled textarea
rite test_textarea_controlled() {
    ≔ value = "Initial content";

    ≔ textarea = Textarea {
        name: "bio",
        value: value,
        onchange: |new_val| { value = new_val; },
    };

    ≔ vnode = textarea.render();
    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert_eq!(textarea_el.text_content(), "Initial content");
}

// Test textarea with label
rite test_textarea_with_label() {
    ≔ textarea = Textarea {
        name: "message",
        label: "Your Message",
        id: "message-field",
    };

    ≔ vnode = textarea.render();

    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert_eq!(textarea_el.attr("id"), "message-field");

    // Label is now a child of the wrapper (not sibling)
    ≔ label = vnode.find_child_by_tag("label");
    assert_eq!(label.attr("for"), "message-field");
    assert_eq!(label.text_content(), "Your Message");
}

// Test textarea rows
rite test_textarea_rows() {
    ≔ textarea = Textarea {
        name: "content",
        rows: 5,
    };

    ≔ vnode = textarea.render();
    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert_eq!(textarea_el.attr("rows"), "5");
}

// Test textarea with min/max rows (auto-resize)
rite test_textarea_auto_resize() {
    ≔ textarea = Textarea {
        name: "auto",
        auto_resize: yay,
        min_rows: 3,
        max_rows: 10,
    };

    ≔ vnode = textarea.render();
    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert!(textarea_el.has_class("textarea-auto-resize"));
    assert_eq!(textarea_el.attr("data-min-rows"), "3");
    assert_eq!(textarea_el.attr("data-max-rows"), "10");
}

// Test required textarea
rite test_textarea_required() {
    ≔ textarea = Textarea {
        name: "feedback",
        required: yay,
        label: "Feedback",
    };

    ≔ vnode = textarea.render();
    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert_eq!(textarea_el.attr("required"), yay);
    assert_eq!(textarea_el.attr("aria-required"), "true");
}

// Test disabled textarea
rite test_textarea_disabled() {
    ≔ textarea = Textarea {
        name: "readonly",
        disabled: yay,
    };

    ≔ vnode = textarea.render();
    // Wrapper has disabled class
    assert!(vnode.has_class("textarea-disabled"));

    // Textarea has disabled attr
    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert_eq!(textarea_el.attr("disabled"), yay);
}

// Test textarea with error
rite test_textarea_error() {
    ≔ textarea = Textarea {
        name: "bio",
        id: "bio-field",
        error: "Bio must be at least 50 characters",
    };

    ≔ vnode = textarea.render();
    // Wrapper has error class
    assert!(vnode.has_class("textarea-has-error"));

    // Textarea has error styling and aria-invalid
    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert!(textarea_el.has_class("textarea-error"));
    assert_eq!(textarea_el.attr("aria-invalid"), "true");

    // Error message is now a child of the wrapper
    ≔ error_msg = vnode.find_child_by_class("textarea-error-message");
    assert_eq!(error_msg.text_content(), "Bio must be at least 50 characters");
}

// Test textarea with description (not currently implemented, skip for now)
// rite test_textarea_helper() { ... }

// Test textarea with character counter
rite test_textarea_counter() {
    ≔ textarea = Textarea {
        name: "tweet",
        max_length: 280,
        show_counter: yay,
        value: "Hello",
    };

    ≔ vnode = textarea.render();
    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert_eq!(textarea_el.attr("maxlength"), "280");
}

// Test textarea sizes
rite test_textarea_sizes() {
    ≔ sm = Textarea { name: "sm", size: "sm" };
    ≔ sm_el = sm.render().find_child_by_tag("textarea");
    assert!(sm_el.has_class("textarea-sm"));

    ≔ md = Textarea { name: "md", size: "md" };
    ≔ md_el = md.render().find_child_by_tag("textarea");
    assert!(md_el.has_class("textarea-md"));

    ≔ lg = Textarea { name: "lg", size: "lg" };
    ≔ lg_el = lg.render().find_child_by_tag("textarea");
    assert!(lg_el.has_class("textarea-lg"));
}

// Test textarea resize options
rite test_textarea_resize() {
    // None
    ≔ none = Textarea { name: "n", resize: "none" };
    ≔ none_el = none.render().find_child_by_tag("textarea");
    assert!(none_el.has_class("textarea-resize-none"));

    // Vertical only (default)
    ≔ vertical = Textarea { name: "v", resize: "vertical" };
    ≔ vertical_el = vertical.render().find_child_by_tag("textarea");
    assert!(vertical_el.has_class("textarea-resize-vertical"));

    // Horizontal only
    ≔ horizontal = Textarea { name: "h", resize: "horizontal" };
    ≔ horizontal_el = horizontal.render().find_child_by_tag("textarea");
    assert!(horizontal_el.has_class("textarea-resize-horizontal"));

    // Both
    ≔ both = Textarea { name: "b", resize: "both" };
    ≔ both_el = both.render().find_child_by_tag("textarea");
    assert!(both_el.has_class("textarea-resize-both"));
}

// Test readonly textarea
rite test_textarea_readonly() {
    ≔ textarea = Textarea {
        name: "display",
        readonly: yay,
        value: "Read only content",
    };

    ≔ vnode = textarea.render();
    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert_eq!(textarea_el.attr("readonly"), yay);
}

// Test textarea accessibility
rite test_textarea_accessibility() {
    ≔ textarea = Textarea {
        name: "desc",
        aria_label: "Enter your description",
    };

    ≔ vnode = textarea.render();
    ≔ textarea_el = vnode.find_child_by_tag("textarea");
    assert_eq!(textarea_el.attr("aria-label"), "Enter your description");
}

rite main() {
    test_textarea_basic();
    test_textarea_controlled();
    test_textarea_with_label();
    test_textarea_rows();
    test_textarea_auto_resize();
    test_textarea_required();
    test_textarea_disabled();
    test_textarea_error();
    test_textarea_counter();
    test_textarea_sizes();
    test_textarea_resize();
    test_textarea_readonly();
    test_textarea_accessibility();

    print("✓ All Textarea component tests passed");
}

// Expected output: ✓ All Textarea component tests passed
