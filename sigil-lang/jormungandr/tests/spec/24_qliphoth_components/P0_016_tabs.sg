// Test: Qliphoth Tabs Component
// TDD: RED - Tests the Tabs navigation component
//
// Tabs organize content into switchable panels

invoke qliphoth·components·Tabs;
invoke qliphoth·components·TabList;
invoke qliphoth·components·Tab;
invoke qliphoth·components·TabPanels;
invoke qliphoth·components·TabPanel;
invoke qliphoth·core·VNode;

// Test basic tabs rendering
rite test_tabs_basic() {
    ≔ tabs = Tabs {
        children: [
            TabList {
                children: [
                    Tab { label: "Tab 1" },
                    Tab { label: "Tab 2" },
                    Tab { label: "Tab 3" },
                ]
            },
            TabPanels {
                children: [
                    TabPanel { children: [text("Content 1")] },
                    TabPanel { children: [text("Content 2")] },
                    TabPanel { children: [text("Content 3")] },
                ]
            }
        ]
    };

    ≔ vnode = tabs.render();

    assert!(vnode.has_class("tabs"));
    assert!(vnode.has_child_with_class("tab-list"));
    assert!(vnode.has_child_with_class("tab-panels"));
}

// Test controlled tabs
rite test_tabs_controlled() {
    ≔ active = 1;

    ≔ tabs = Tabs {
        index: active,
        onchange: |new_idx| { active = new_idx; },
        children: [
            TabList {
                children: [
                    Tab { label: "First" },
                    Tab { label: "Second" },
                ]
            },
            TabPanels {
                children: [
                    TabPanel { children: [text("First panel")] },
                    TabPanel { children: [text("Second panel")] },
                ]
            }
        ]
    };

    ≔ vnode = tabs.render();
    ≔ tab_list = vnode.find_child_by_class("tab-list");
    ≔ tab_buttons = tab_list.find_children_by_class("tab");

    // Second tab should be selected
    assert_eq!(tab_buttons[0].attr("aria-selected"), "false");
    assert_eq!(tab_buttons[1].attr("aria-selected"), "true");
}

// Test tab variants
rite test_tabs_variants() {
    // Line (default)
    ≔ line = Tabs { variant: "line", children: [] };
    assert!(line.render().has_class("tabs-line"));

    // Enclosed
    ≔ enclosed = Tabs { variant: "enclosed", children: [] };
    assert!(enclosed.render().has_class("tabs-enclosed"));

    // Soft rounded
    ≔ soft = Tabs { variant: "soft-rounded", children: [] };
    assert!(soft.render().has_class("tabs-soft-rounded"));

    // Solid rounded
    ≔ solid = Tabs { variant: "solid-rounded", children: [] };
    assert!(solid.render().has_class("tabs-solid-rounded"));

    // Unstyled
    ≔ unstyled = Tabs { variant: "unstyled", children: [] };
    assert!(unstyled.render().has_class("tabs-unstyled"));
}

// Test tab sizes
rite test_tabs_sizes() {
    ≔ sm = Tabs { size: "sm", children: [] };
    assert!(sm.render().has_class("tabs-sm"));

    ≔ md = Tabs { size: "md", children: [] };
    assert!(md.render().has_class("tabs-md"));

    ≔ lg = Tabs { size: "lg", children: [] };
    assert!(lg.render().has_class("tabs-lg"));
}

// Test tabs orientation
rite test_tabs_orientation() {
    // Horizontal (default)
    ≔ horizontal = Tabs { orientation: "horizontal", children: [] };
    assert!(horizontal.render().has_class("tabs-horizontal"));

    // Vertical
    ≔ vertical = Tabs { orientation: "vertical", children: [] };
    assert!(vertical.render().has_class("tabs-vertical"));
}

// Test tabs alignment
rite test_tabs_alignment() {
    // Start (default)
    ≔ start = Tabs { alignment: "start", children: [] };
    assert!(start.render().has_class("tabs-align-start"));

    // Center
    ≔ center = Tabs { alignment: "center", children: [] };
    assert!(center.render().has_class("tabs-align-center"));

    // End
    ≔ end = Tabs { alignment: "end", children: [] };
    assert!(end.render().has_class("tabs-align-end"));

    // Stretch
    ≔ stretch = Tabs { alignment: "stretch", children: [] };
    assert!(stretch.render().has_class("tabs-align-stretch"));
}

// Test disabled tab
rite test_tab_disabled() {
    ≔ tabs = Tabs {
        children: [
            TabList {
                children: [
                    Tab { label: "Active" },
                    Tab { label: "Disabled", disabled: yay },
                    Tab { label: "Another" },
                ]
            },
            TabPanels { children: [] }
        ]
    };

    ≔ vnode = tabs.render();
    ≔ tab_buttons = vnode.find_children_by_class("tab");

    assert_eq!(tab_buttons[1].attr("disabled"), yay);
    assert_eq!(tab_buttons[1].attr("aria-disabled"), "true");
}

// Test tab with icon
rite test_tab_with_icon() {
    ≔ tabs = Tabs {
        children: [
            TabList {
                children: [
                    Tab { label: "Settings", icon: "settings" },
                    Tab { label: "Profile", icon: "user" },
                ]
            },
            TabPanels { children: [] }
        ]
    };

    ≔ vnode = tabs.render();
    ≔ tab_buttons = vnode.find_children_by_class("tab");
    assert!(tab_buttons[0].has_child_with_class("tab-icon"));
}

// Test tab with badge
rite test_tab_with_badge() {
    ≔ tabs = Tabs {
        children: [
            TabList {
                children: [
                    Tab { label: "Inbox", badge: 5 },
                    Tab { label: "Sent" },
                ]
            },
            TabPanels { children: [] }
        ]
    };

    ≔ vnode = tabs.render();
    ≔ tab = vnode.find_children_by_class("tab")[0];
    assert!(tab.has_child_with_class("tab-badge"));
    ≔ badge = tab.find_child_by_class("tab-badge");
    assert_eq!(badge.text_content(), "5");
}

// Test lazy loading panels
rite test_tabs_lazy() {
    ≔ tabs = Tabs {
        lazy: yay,
        children: [
            TabList {
                children: [
                    Tab { label: "Tab 1" },
                    Tab { label: "Tab 2" },
                ]
            },
            TabPanels {
                children: [
                    TabPanel { children: [text("Content 1")] },
                    TabPanel { children: [text("Content 2")] },
                ]
            }
        ]
    };

    ≔ vnode = tabs.render();
    // Only active panel should be rendered
    ≔ panels = vnode.find_children_by_class("tab-panel");
    assert_eq!(panels.len(), 1);
}

// Test tabs accessibility
rite test_tabs_accessibility() {
    ≔ tabs = Tabs {
        id: "main-tabs",
        children: [
            TabList {
                aria_label: "Main navigation tabs",
                children: [
                    Tab { label: "Home", id: "tab-home" },
                    Tab { label: "About", id: "tab-about" },
                ]
            },
            TabPanels {
                children: [
                    TabPanel { id: "panel-home", children: [text("Home")] },
                    TabPanel { id: "panel-about", children: [text("About")] },
                ]
            }
        ]
    };

    ≔ vnode = tabs.render();

    // TabList should have proper role
    ≔ tab_list = vnode.find_child_by_class("tab-list");
    assert_eq!(tab_list.attr("role"), "tablist");
    assert_eq!(tab_list.attr("aria-label"), "Main navigation tabs");

    // Tabs should have proper role and aria attributes
    ≔ tab_buttons = tab_list.find_children_by_class("tab");
    assert_eq!(tab_buttons[0].attr("role"), "tab");
    assert_eq!(tab_buttons[0].attr("aria-controls"), "panel-home");

    // Panel should have proper role
    ≔ panel = vnode.find_child_by_class("tab-panel");
    assert_eq!(panel.attr("role"), "tabpanel");
    assert_eq!(panel.attr("aria-labelledby"), "tab-home");
}

// Test keyboard navigation
rite test_tabs_keyboard() {
    ≔ tabs = Tabs {
        keyboard_activation: "manual", // vs "automatic"
        children: [
            TabList {
                children: [
                    Tab { label: "One" },
                    Tab { label: "Two" },
                ]
            },
            TabPanels { children: [] }
        ]
    };

    ≔ vnode = tabs.render();
    assert_eq!(vnode.attr("data-keyboard-activation"), "manual");
}

rite main() {
    test_tabs_basic();
    test_tabs_controlled();
    test_tabs_variants();
    test_tabs_sizes();
    test_tabs_orientation();
    test_tabs_alignment();
    test_tab_disabled();
    test_tab_with_icon();
    test_tab_with_badge();
    test_tabs_lazy();
    test_tabs_accessibility();
    test_tabs_keyboard();

    print("✓ All Tabs component tests passed");
}

// Expected output: ✓ All Tabs component tests passed
