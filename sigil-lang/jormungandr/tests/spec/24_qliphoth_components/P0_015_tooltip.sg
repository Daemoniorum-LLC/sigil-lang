// Test: Qliphoth Tooltip Component
// TDD: RED - Tests the Tooltip hover hint component
//
// Tooltip displays helpful text on hover/focus

invoke qliphoth·components·Tooltip;
invoke qliphoth·components·Button;
invoke qliphoth·core·VNode;

// Test basic tooltip rendering
rite test_tooltip_basic() {
    ≔ tooltip = Tooltip {
        content: "This is helpful text",
        children: [
            Button { label: "Hover me", onclick: || {} }
        ]
    };

    ≔ vnode = tooltip.render();

    assert!(vnode.has_class("tooltip-wrapper"));
    // Tooltip content should be in the DOM but hidden
    assert!(vnode.has_child_with_class("tooltip-content"));
}

// Test tooltip positions
rite test_tooltip_positions() {
    // Top (default)
    ≔ top = Tooltip { content: "Top", position: "top", children: [] };
    assert!(top.render().has_child_with_class("tooltip-top"));

    // Bottom
    ≔ bottom = Tooltip { content: "Bottom", position: "bottom", children: [] };
    assert!(bottom.render().has_child_with_class("tooltip-bottom"));

    // Left
    ≔ left = Tooltip { content: "Left", position: "left", children: [] };
    assert!(left.render().has_child_with_class("tooltip-left"));

    // Right
    ≔ right = Tooltip { content: "Right", position: "right", children: [] };
    assert!(right.render().has_child_with_class("tooltip-right"));
}

// Test tooltip alignment
rite test_tooltip_alignment() {
    // Start
    ≔ start = Tooltip { content: "Start", alignment: "start", children: [] };
    assert!(start.render().has_child_with_class("tooltip-align-start"));

    // Center (default)
    ≔ center = Tooltip { content: "Center", alignment: "center", children: [] };
    assert!(center.render().has_child_with_class("tooltip-align-center"));

    // End
    ≔ end = Tooltip { content: "End", alignment: "end", children: [] };
    assert!(end.render().has_child_with_class("tooltip-align-end"));
}

// Test tooltip triggers
rite test_tooltip_triggers() {
    // Hover (default)
    ≔ hover = Tooltip { content: "Hover", trigger: "hover", children: [] };
    ≔ vnode1 = hover.render();
    assert_eq!(vnode1.attr("data-trigger"), "hover");

    // Click
    ≔ click = Tooltip { content: "Click", trigger: "click", children: [] };
    ≔ vnode2 = click.render();
    assert_eq!(vnode2.attr("data-trigger"), "click");

    // Focus
    ≔ focus = Tooltip { content: "Focus", trigger: "focus", children: [] };
    ≔ vnode3 = focus.render();
    assert_eq!(vnode3.attr("data-trigger"), "focus");

    // Manual
    ≔ manual = Tooltip { content: "Manual", trigger: "manual", open: yay, children: [] };
    ≔ vnode4 = manual.render();
    assert_eq!(vnode4.attr("data-trigger"), "manual");
}

// Test tooltip delay
rite test_tooltip_delay() {
    ≔ tooltip = Tooltip {
        content: "Delayed",
        delay: 500, // ms before showing
        children: []
    };

    ≔ vnode = tooltip.render();
    assert_eq!(vnode.attr("data-delay"), "500");
}

// Test tooltip with arrow
rite test_tooltip_arrow() {
    // With arrow (default)
    ≔ with_arrow = Tooltip { content: "Arrow", arrow: yay, children: [] };
    assert!(with_arrow.render().has_child_with_class("tooltip-arrow"));

    // Without arrow
    ≔ no_arrow = Tooltip { content: "No arrow", arrow: nay, children: [] };
    assert_eq!(no_arrow.render().has_child_with_class("tooltip-arrow"), nay);
}

// Test tooltip variants
rite test_tooltip_variants() {
    // Default (dark)
    ≔ dark = Tooltip { content: "Dark", variant: "dark", children: [] };
    assert!(dark.render().has_child_with_class("tooltip-dark"));

    // Light
    ≔ light = Tooltip { content: "Light", variant: "light", children: [] };
    assert!(light.render().has_child_with_class("tooltip-light"));

    // Error
    ≔ error = Tooltip { content: "Error!", variant: "error", children: [] };
    assert!(error.render().has_child_with_class("tooltip-error"));

    // Warning
    ≔ warning = Tooltip { content: "Warning", variant: "warning", children: [] };
    assert!(warning.render().has_child_with_class("tooltip-warning"));

    // Success
    ≔ success = Tooltip { content: "Success", variant: "success", children: [] };
    assert!(success.render().has_child_with_class("tooltip-success"));
}

// Test tooltip with rich content
rite test_tooltip_rich_content() {
    ≔ tooltip = Tooltip {
        title: "Important Info",
        content: "This is detailed explanation text.",
        children: []
    };

    ≔ vnode = tooltip.render();
    ≔ content = vnode.find_child_by_class("tooltip-content");
    assert!(content.has_child_with_class("tooltip-title"));
    assert!(content.has_child_with_class("tooltip-body"));
}

// Test tooltip max width
rite test_tooltip_max_width() {
    ≔ tooltip = Tooltip {
        content: "Long content...",
        max_width: 300,
        children: []
    };

    ≔ vnode = tooltip.render();
    ≔ content = vnode.find_child_by_class("tooltip-content");
    assert!(content.attr("style").contains("max-width: 300px"));
}

// Test tooltip disabled
rite test_tooltip_disabled() {
    ≔ tooltip = Tooltip {
        content: "Disabled",
        disabled: yay,
        children: []
    };

    ≔ vnode = tooltip.render();
    // Disabled tooltip should not render content
    assert_eq!(vnode.has_child_with_class("tooltip-content"), nay);
}

// Test tooltip accessibility
rite test_tooltip_accessibility() {
    ≔ tooltip = Tooltip {
        content: "Help text",
        id: "help-tooltip",
        children: [
            Button { label: "Help", onclick: || {} }
        ]
    };

    ≔ vnode = tooltip.render();

    // Trigger element should reference tooltip via aria-describedby
    ≔ trigger_el = vnode.find_child_by_class("tooltip-trigger");
    assert_eq!(trigger_el.attr("aria-describedby"), "help-tooltip");

    // Tooltip should have proper role
    ≔ content = vnode.find_child_by_class("tooltip-content");
    assert_eq!(content.attr("role"), "tooltip");
    assert_eq!(content.attr("id"), "help-tooltip");
}

// Test tooltip touch behavior
rite test_tooltip_touch() {
    ≔ tooltip = Tooltip {
        content: "Touch friendly",
        touch_trigger: "long-press",
        children: []
    };

    ≔ vnode = tooltip.render();
    assert_eq!(vnode.attr("data-touch-trigger"), "long-press");
}

// Test tooltip animation
rite test_tooltip_animation() {
    // Fade (default)
    ≔ fade = Tooltip { content: "Fade", animation: "fade", children: [] };
    assert!(fade.render().has_class("tooltip-animation-fade"));

    // Scale
    ≔ scale = Tooltip { content: "Scale", animation: "scale", children: [] };
    assert!(scale.render().has_class("tooltip-animation-scale"));

    // None
    ≔ none = Tooltip { content: "None", animation: "none", children: [] };
    assert!(none.render().has_class("tooltip-animation-none"));
}

rite main() {
    test_tooltip_basic();
    test_tooltip_positions();
    test_tooltip_alignment();
    test_tooltip_triggers();
    test_tooltip_delay();
    test_tooltip_arrow();
    test_tooltip_variants();
    test_tooltip_rich_content();
    test_tooltip_max_width();
    test_tooltip_disabled();
    test_tooltip_accessibility();
    test_tooltip_touch();
    test_tooltip_animation();

    print("✓ All Tooltip component tests passed");
}

// Expected output: ✓ All Tooltip component tests passed
