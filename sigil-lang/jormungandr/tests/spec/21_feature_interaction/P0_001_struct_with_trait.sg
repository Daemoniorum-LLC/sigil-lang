// Test: Struct with trait implementation
// Spec: Feature Interaction - Structs + Traits
// Priority: P0 - Bootstrap Critical

trait Displayable {
    fn display(&self) -> String;
}

struct Point {
    x: i32,
    y: i32,
}

impl Displayable for Point {
    fn display(&self) -> String {
        return "Point";
    }
}

fn main() {
    let p = Point { x: 3, y: 4 };
    println(p.display());
}
