// Test: Struct with aspect implementation
// Spec: Feature Interaction - Structs + Traits
// Priority: P0 - Bootstrap Critical

aspect Displayable {
    rite display(&this) → String;
}

sigil Point {
    x: i32,
    y: i32,
}

⊢ Point : Displayable {
    rite display(&this) → String {
        ⤺ "Point";
    }
}

rite main() {
    ≔ p = Point { x: 3, y: 4 };
    println(p.display());
}
