// Test: Struct with Θ implementation
// Spec: Feature Interaction - Structs + Traits
// Priority: P0 - Bootstrap Critical

Θ Displayable {
    λ display(&self) -> String;
}

Σ Point {
    x: i32,
    y: i32,
}

⊢ Displayable ∀ Point {
    λ display(&self) -> String {
        ⤺ "Point";
    }
}

λ main() {
    ≔ p = Point { x: 3, y: 4 };
    println(p.display());
}
