// Test: Struct implementing multiple traits
// Spec: Feature Interaction - Multiple Traits
// Priority: P0 - Bootstrap Critical

aspect HasName {
    rite name(&this) → String;
}

aspect HasValue {
    rite value(&this) → i32;
}

sigil Item {
    n: String,
    v: i32,
}

⊢ Item : HasName {
    rite name(&this) → String {
        ⤺ this.n.clone();
    }
}

⊢ Item : HasValue {
    rite value(&this) → i32 {
        ⤺ this.v;
    }
}

rite main() {
    ≔ item = Item { n: "test".to_string(), v: 42 };
    println(item.name());
    println(item.value());
}
