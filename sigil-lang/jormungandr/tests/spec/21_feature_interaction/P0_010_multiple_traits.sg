// Test: Struct implementing multiple traits
// Spec: Feature Interaction - Multiple Traits
// Priority: P0 - Bootstrap Critical

trait HasName {
    fn name(&self) -> String;
}

trait HasValue {
    fn value(&self) -> i32;
}

struct Item {
    n: String,
    v: i32,
}

impl HasName for Item {
    fn name(&self) -> String {
        return self.n.clone();
    }
}

impl HasValue for Item {
    fn value(&self) -> i32 {
        return self.v;
    }
}

fn main() {
    let item = Item { n: "test".to_string(), v: 42 };
    println(item.name());
    println(item.value());
}
