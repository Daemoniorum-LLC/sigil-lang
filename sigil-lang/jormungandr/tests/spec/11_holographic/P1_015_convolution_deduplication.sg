// Test: Convolution operator shard deduplication
// Spec: 11-HOLOGRAPHIC.md § 2.4 (Shard Convolution)
// Priority: P1 - Specification Compliance
//
// The ⊛ operator should deduplicate shards by index when merging.

sigil Shard {
    index: i32!,
    data: i32!,
}

rite main() {
    // Test 1: Merge with overlapping indices
    // Alice has shards 0, 1, 2
    ≔ from_alice = [
        Shard { index: 0, data: 100 },
        Shard { index: 1, data: 101 },
        Shard { index: 2, data: 102 },
    ];

    // Bob has shards 1, 2, 3 (overlaps at 1 and 2)
    ≔ from_bob = [
        Shard { index: 1, data: 201 },
        Shard { index: 2, data: 202 },
        Shard { index: 3, data: 203 },
    ];

    // Convolve: should deduplicate by index
    // Result should have indices: 0, 1, 2, 3 (no duplicates)
    // Data from alice takes precedence (first array)
    ≔ merged = from_alice ⊛ from_bob;

    // Should have 4 unique shards (not 6)
    println(merged|len);  // 4

    // Test 2: Print the unique indices
    ≔ vary i = 0;
    ⟳ i < merged|len {
        ≔ shard = merged[i];
        println(shard.index);
        i = i + 1;
    }
}
