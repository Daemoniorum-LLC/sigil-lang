// Test: Merkle tree verification
// Spec: 11-HOLOGRAPHIC.md § 4 Content-Addressed Structures
// Priority: P0 - Bootstrap Critical

λ main() {
    ≔ tree: MerkleTree<String> = MerkleTree·from(["a", "b", "c", "d"]);
    ≔ proof = tree.prove_inclusion(0);
    ≔ valid! = proof|□verify;
    println(valid!);
}
