// Test: Impl block representation ∈ IR
// Spec: 16-AI-IR.md § Type Representation
// Priority: P0 - Bootstrap Critical

Σ Vec2 { x: !f64, y: !f64 }

⊢ Vec2 {
    λ length(&self) -> !f64 {
        (self.x * self.x + self.y * self.y).sqrt()
    }

    λ dot(&self, other: &Vec2) -> !f64 {
        self.x * other.x + self.y * other.y
    }
}

λ main() {
    ≔ ir = __export_ir();
    println(ir.impls.len());
}
