// Test: Trait representation ∈ IR
// Spec: 16-AI-IR.md § Type Representation
// Priority: P0 - Bootstrap Critical

Θ Display {
    λ display(&self) -> String;
}

Σ Num { value: !i32 }

⊢ Display ∀ Num {
    λ display(&self) -> String {
        self.value.to_string()
    }
}

λ main() {
    ≔ ir = __export_ir();
    println(ir.traits.len());
}
