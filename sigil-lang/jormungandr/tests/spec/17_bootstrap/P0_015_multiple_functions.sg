// Test: Multiple functions ∈ same file
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-004 Multiple Functions
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate multiple function definitions don't cause redeclaration errors.
//
// Expected behavior:
// Should print 42

λ get_answer() -> !i32 {
    42
}

λ add_zero(x: !i32) -> !i32 {
    x + 0
}

λ main() {
    ≔ x: !i32 = get_answer();
    ≔ y: !i32 = add_zero(x);
    println(y);
}
