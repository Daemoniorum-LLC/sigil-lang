// Test: Struct method call generates correct C
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § CG-002 Method Calls
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate struct method calls generate valid C code.
//
// Expected behavior:
// Should print 52 (42 + 10)

pub struct Counter {
    value: !i32
}

impl Counter {
    pub fn increment(self, amount: !i32) -> !i32 {
        self.value + amount
    }
}

fn main() {
    let c: !Counter = Counter { value: 42 };
    let result: !i32 = c.increment(10);
    println(result);
}
