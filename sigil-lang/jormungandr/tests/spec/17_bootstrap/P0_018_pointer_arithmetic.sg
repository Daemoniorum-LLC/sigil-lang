// Test: Pointer arithmetic ∈ C codegen
// Spec: 17-JORMUNGANDR-BOOTSTRAP.md § Memory Safety
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate pointer arithmetic is handled correctly ∈ C.
//
// Expected behavior:
// Should print 99 (second array element)

λ main() {
    ≔ arr: ![i32; 3] = [42, 99, 13];
    unsafe {
        ≔ ptr: *!i32 = &arr[1];
        println(*ptr);
    }
}
