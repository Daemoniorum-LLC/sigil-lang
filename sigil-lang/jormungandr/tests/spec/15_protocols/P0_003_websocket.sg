// Test: WebSocket pattern - enum variants and matching
// Spec: 15-PROTOCOLS.md § 5 WebSocket Support
// Priority: P0 - Bootstrap Critical
//
// Tests language features used in WebSocket patterns:
// - Enum with variant data: Message·Text(String)
// - Pattern matching on enum variants
// - Evidential binding in match

enum Message {
    Text(String),
    Binary(Vec<u8>),
    Close,
}

struct Connection {
    url: String,
}

fn connect_ws(url: String) -> Connection {
    Connection { url: url }
}

fn recv_message(conn: Connection) -> Message {
    // Simulated receive - in real WS this would be from network
    Message·Text("hello")
}

fn main() {
    // Test: Constructor with evidential binding
    let ws~ = connect_ws("ws://localhost:8080");

    // Test: Function call returning enum
    let msg~ = recv_message(ws~);

    // Test: Match on evidential enum value
    match msg~ {
        Message·Text(s) => println(s),
        Message·Binary(_) => println("binary"),
        Message·Close => println("closed"),
    }
}
