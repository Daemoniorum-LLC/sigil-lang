// Test: Timeout pattern - Result matching with evidentiality
// Spec: 15-PROTOCOLS.md § 2 Common Abstractions
// Priority: P0 - Bootstrap Critical
//
// Tests language features used in timeout patterns:
// - Result enum with Ok/Err
// - Pattern matching with evidential binding in Ok
// - Error variant matching

struct HttpResponse {
    status: i64,
    body: String,
}

enum RequestResult {
    Ok(HttpResponse),
    Err(String),
}

fn send_request(url: String, timeout_ms: i64) -> RequestResult {
    // Simulated successful request
    RequestResult·Ok(HttpResponse { status: 200, body: "OK" })
}

fn main() {
    // Test: Function returning Result
    let result = send_request("https://example.com", 5000);

    // Test: Pattern match with evidential binding on Ok variant
    match result {
        RequestResult·Ok(response~) => println(response~.status),
        RequestResult·Err(msg) => println(-1),
    }
}
