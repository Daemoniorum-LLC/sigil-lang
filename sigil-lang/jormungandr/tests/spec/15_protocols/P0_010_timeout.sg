// Test: Protocol timeout handling
// Spec: 15-PROTOCOLS.md § 2 Common Abstractions
// Priority: P0 - Bootstrap Critical

use protocol::common::Timeout;
use protocol::http::Client;

async fn main() {
    let client = Client::new();
    let req = Request::get("https://slow.example.com")
        |with_timeout(Timeout::seconds(5));
    let result = client.send(req)|await;
    match result {
        Ok(response~) => println(response~.status),
        Err(TimeoutError) => println(-1),
    }
}
