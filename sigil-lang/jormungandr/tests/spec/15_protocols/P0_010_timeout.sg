// Test: Timeout pattern - Result matching with evidentiality
// Spec: 15-PROTOCOLS.md § 2 Common Abstractions
// Priority: P0 - Bootstrap Critical
//
// Tests language features used ∈ timeout patterns:
// - Result ᛈ with Ok/Err
// - Pattern matching with evidential binding ∈ Ok
// - Error variant matching

Σ HttpResponse {
    status: i64,
    body: String,
}

ᛈ RequestResult {
    Ok(HttpResponse),
    Err(String),
}

λ send_request(url: String, timeout_ms: i64) -> RequestResult {
    // Simulated successful request
    RequestResult·Ok(HttpResponse { status: 200, body: "OK" })
}

λ main() {
    // Test: Function returning Result
    ≔ result = send_request("https://example.com", 5000);

    // Test: Pattern ⌥ with evidential binding on Ok variant
    ⌥ result {
        RequestResult·Ok(response~) => println(response~.status),
        RequestResult·Err(msg) => println(-1),
    }
}
