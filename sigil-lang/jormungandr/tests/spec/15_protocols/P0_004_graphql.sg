// Test: GraphQL pattern - nested field access
// Spec: 15-PROTOCOLS.md § 6 GraphQL Support
// Priority: P0 - Bootstrap Critical
//
// Tests language features used in GraphQL patterns:
// - Nested struct field access
// - Evidential value propagation through nested access
// - Builder patterns with structs

struct User {
    name: String,
    email: String,
}

struct QueryData {
    user: User,
}

struct QueryResult {
    data: QueryData,
}

fn query_user(id: i64) -> QueryResult {
    // Simulated query result - in real GraphQL from server
    QueryResult {
        data: QueryData {
            user: User {
                name: "Alice",
                email: "alice@example.com",
            }
        }
    }
}

fn main() {
    // Test: Function returning nested struct
    let result~ = query_user(1);

    // Test: Deeply nested field access on evidential value
    // result~.data.user.name demonstrates nested access through reported value
    println(result~.data.user.name);
}
