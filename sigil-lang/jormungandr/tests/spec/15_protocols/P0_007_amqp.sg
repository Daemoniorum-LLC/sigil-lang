// Test: AMQP (RabbitMQ)
// Spec: 15-PROTOCOLS.md § 8 AMQP Support
// Priority: P0 - Bootstrap Critical

use protocol·amqp·{Connection, Channel, Queue};

async fn main() {
    let conn = Connection·connect("amqp://localhost")|await~;
    let ch = conn.create_channel()|await~;
    let queue = ch.declare_queue("tasks")|await~;
    ch.publish("", "tasks", "hello")|await;
    println(1);
}
