// Test: Streaming pattern - iteration over collections
// Spec: 15-PROTOCOLS.md § 3.2 Streaming
// Priority: P0 - Bootstrap Critical
//
// Tests language features used in streaming patterns:
// - For loop iteration
// - Mutable counter
// - Evidential collection access

fn main() {
    // Simulated stream data - in real gRPC streaming from server
    let stream~ = [1, 2, 3, 4, 5];

    // Test: Iteration with mutable counter
    let mut count = 0;
    for item in stream~ {
        count = count + 1;
    }

    // Test: Final count matches stream length
    println(count);
}
