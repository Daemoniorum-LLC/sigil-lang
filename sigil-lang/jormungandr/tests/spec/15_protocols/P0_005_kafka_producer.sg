// Test: Kafka producer
// Spec: 15-PROTOCOLS.md § 7 Kafka Support
// Priority: P0 - Bootstrap Critical

invoke protocol·kafka·{Producer, Topic};

async λ main() {
    ≔ producer = Producer·connect("localhost:9092")|await~;
    ≔ topic = Topic·new("events");
    producer.send(topic, "key", "value")|await;
    println(1);
}
