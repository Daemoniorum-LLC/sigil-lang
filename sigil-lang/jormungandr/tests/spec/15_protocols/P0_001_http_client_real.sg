// Test: Real HTTP client - makes actual network request
// Spec: 15-PROTOCOLS.md § 4 HTTP Support
// Priority: P0 - Bootstrap Critical
//
// This test makes a REAL HTTP request to httpbin.org

λ main() {
    // Create HTTP connection via |connect pipe
    ≔ conn = "https://httpbin.org/get"|connect;

    // Send request (this makes a real network call)
    // For GET, we send empty string as body
    ≔ response~ = conn|send{""};

    // Check we got a response with status 200
    println(response~.status);
}
