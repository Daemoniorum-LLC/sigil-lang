// Test: Daemoniorum Feature Section Component
// TDD: RED - Tests the feature showcase section
//
// FeatureSection displays product features with icons and descriptions

invoke daemoniorum·components·FeatureSection;
invoke daemoniorum·components·FeatureItem;
invoke qliphoth·core·VNode;

// Test basic feature section rendering
rite test_feature_section_basic() {
    ≔ section = FeatureSection {
        title: "Why Daemoniorum?",
        subtitle: "Research-driven AI platforms",
        children: [
            FeatureItem {
                icon: "lightning",
                title: "Lightning Fast",
                description: "Optimized for performance",
            },
            FeatureItem {
                icon: "shield",
                title: "Secure by Default",
                description: "Built-in security features",
            },
        ]
    };

    ≔ vnode = section.render();

    assert!(vnode.has_class("feature-section"));
    assert!(vnode.has_child_with_class("feature-section-title"));
    assert!(vnode.has_child_with_class("feature-section-grid"));

    ≔ items = vnode.find_children_by_class("feature-item");
    assert_eq!(items.len(), 2);
}

// Test feature section layouts
rite test_feature_section_layouts() {
    // Grid (default)
    ≔ grid = FeatureSection { title: "Features", layout: "grid", children: [] };
    assert!(grid.render().has_class("feature-section-grid-layout"));

    // List
    ≔ list = FeatureSection { title: "Features", layout: "list", children: [] };
    assert!(list.render().has_class("feature-section-list-layout"));

    // Alternating (zigzag)
    ≔ alt = FeatureSection { title: "Features", layout: "alternating", children: [] };
    assert!(alt.render().has_class("feature-section-alternating-layout"));

    // Centered
    ≔ center = FeatureSection { title: "Features", layout: "centered", children: [] };
    assert!(center.render().has_class("feature-section-centered-layout"));
}

// Test feature section columns
rite test_feature_section_columns() {
    ≔ two_col = FeatureSection { title: "F", columns: 2, children: [] };
    assert!(two_col.render().has_class("feature-section-cols-2"));

    ≔ three_col = FeatureSection { title: "F", columns: 3, children: [] };
    assert!(three_col.render().has_class("feature-section-cols-3"));

    ≔ four_col = FeatureSection { title: "F", columns: 4, children: [] };
    assert!(four_col.render().has_class("feature-section-cols-4"));
}

// Test feature item with image
rite test_feature_item_image() {
    ≔ item = FeatureItem {
        title: "Visual Feature",
        description: "With screenshot",
        image: "/images/feature.png",
        image_alt: "Feature screenshot",
    };

    ≔ vnode = item.render();
    assert!(vnode.has_child_with_class("feature-item-image"));

    ≔ img = vnode.find_child_by_class("feature-item-image").find_child_by_tag("img");
    assert_eq!(img.attr("alt"), "Feature screenshot");
}

// Test feature item variants
rite test_feature_item_variants() {
    // Default (icon top)
    ≔ default_item = FeatureItem { title: "F", variant: "default", icon: "star" };
    assert!(default_item.render().has_class("feature-item-default"));

    // Horizontal (icon left)
    ≔ horizontal = FeatureItem { title: "F", variant: "horizontal", icon: "star" };
    assert!(horizontal.render().has_class("feature-item-horizontal"));

    // Card
    ≔ card = FeatureItem { title: "F", variant: "card", icon: "star" };
    assert!(card.render().has_class("feature-item-card"));

    // Minimal
    ≔ minimal = FeatureItem { title: "F", variant: "minimal", icon: "star" };
    assert!(minimal.render().has_class("feature-item-minimal"));
}

// Test feature item with link
rite test_feature_item_link() {
    ≔ item = FeatureItem {
        title: "Learn More",
        description: "Click to learn",
        href: "/features/detail",
        link_text: "Read documentation →",
    };

    ≔ vnode = item.render();
    assert!(vnode.has_child_with_class("feature-item-link"));

    ≔ link = vnode.find_child_by_class("feature-item-link");
    assert_eq!(link.attr("href"), "/features/detail");
}

// Test feature section with background
rite test_feature_section_background() {
    // Light
    ≔ light = FeatureSection { title: "F", background: "light", children: [] };
    assert!(light.render().has_class("feature-section-bg-light"));

    // Dark
    ≔ dark = FeatureSection { title: "F", background: "dark", children: [] };
    assert!(dark.render().has_class("feature-section-bg-dark"));

    // Gradient
    ≔ gradient = FeatureSection { title: "F", background: "gradient", children: [] };
    assert!(gradient.render().has_class("feature-section-bg-gradient"));

    // Image
    ≔ image = FeatureSection {
        title: "F",
        background: "image",
        background_image: "/bg.jpg",
        children: []
    };
    assert!(image.render().has_class("feature-section-bg-image"));
}

// Test feature section alignment
rite test_feature_section_alignment() {
    // Left
    ≔ left = FeatureSection { title: "F", alignment: "left", children: [] };
    assert!(left.render().has_class("feature-section-align-left"));

    // Center (default)
    ≔ center = FeatureSection { title: "F", alignment: "center", children: [] };
    assert!(center.render().has_class("feature-section-align-center"));

    // Right
    ≔ right = FeatureSection { title: "F", alignment: "right", children: [] };
    assert!(right.render().has_class("feature-section-align-right"));
}

// Test feature item icon styles
rite test_feature_item_icon_styles() {
    // Circle
    ≔ circle = FeatureItem { title: "F", icon: "star", icon_style: "circle" };
    assert!(circle.render().has_child_with_class("feature-item-icon-circle"));

    // Square
    ≔ square = FeatureItem { title: "F", icon: "star", icon_style: "square" };
    assert!(square.render().has_child_with_class("feature-item-icon-square"));

    // None (just icon)
    ≔ none = FeatureItem { title: "F", icon: "star", icon_style: "none" };
    assert!(none.render().has_child_with_class("feature-item-icon-none"));
}

// Test feature item with badge
rite test_feature_item_badge() {
    ≔ item = FeatureItem {
        title: "New Feature",
        description: "Just released",
        badge: "New",
    };

    ≔ vnode = item.render();
    assert!(vnode.has_child_with_class("feature-item-badge"));

    ≔ badge = vnode.find_child_by_class("feature-item-badge");
    assert_eq!(badge.text_content(), "New");
}

// Test feature section with CTA
rite test_feature_section_cta() {
    ≔ section = FeatureSection {
        title: "Features",
        cta: {
            label: "Get Started",
            href: "/signup",
        },
        children: []
    };

    ≔ vnode = section.render();
    assert!(vnode.has_child_with_class("feature-section-cta"));
}

// Test feature section accessibility
rite test_feature_section_accessibility() {
    ≔ section = FeatureSection {
        title: "Key Features",
        aria_label: "Product key features section",
        children: []
    };

    ≔ vnode = section.render();
    assert_eq!(vnode.attr("aria-label"), "Product key features section");

    // Title should be semantic heading
    ≔ title = vnode.find_child_by_class("feature-section-title");
    assert_eq!(title.tag(), "h2");
}

rite main() {
    test_feature_section_basic();
    test_feature_section_layouts();
    test_feature_section_columns();
    test_feature_item_image();
    test_feature_item_variants();
    test_feature_item_link();
    test_feature_section_background();
    test_feature_section_alignment();
    test_feature_item_icon_styles();
    test_feature_item_badge();
    test_feature_section_cta();
    test_feature_section_accessibility();

    print("✓ All FeatureSection component tests passed");
}

// Expected output: ✓ All FeatureSection component tests passed
