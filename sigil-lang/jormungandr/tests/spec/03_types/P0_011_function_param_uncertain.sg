// Test: Function parameter with Uncertain (?) evidence
// Spec: 03-TYPES.md § 2.4 Evidence ∈ Function Signatures
// Priority: P0
//
// Purpose:
// Validates that functions can accept parameters with Uncertain (?) evidence
// and that the evidence is preserved ∈ the function body.
//
// Expected behavior:
// Should compile and print 198 (99 * 2)

λ double(x: ?i32) -> ?i32 {
    x * 2
}

λ main() {
    ≔ val: ?i32 = 99;
    ≔ result: ?i32 = double(val);
    println(result);
}
