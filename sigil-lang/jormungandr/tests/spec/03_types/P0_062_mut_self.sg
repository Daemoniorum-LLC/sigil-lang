// Test: Mutable self in method
// Spec: 03-TYPES.md § 7.6 Mutable Methods
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate mut self methods can modify fields.
//
// Expected behavior:
// Should print 52 (42 + 10)

pub struct Counter {
    value: !i32
}

impl Counter {
    pub fn new(value: !i32) -> Self {
        Self { value: value }
    }

    pub fn increment(mut self, amount: !i32) {
        self.value = self.value + amount;
    }

    pub fn get(self) -> !i32 {
        self.value
    }
}

fn main() {
    let mut c: !Counter = Counter·new(42);
    c.increment(10);
    println(c.get());
}
