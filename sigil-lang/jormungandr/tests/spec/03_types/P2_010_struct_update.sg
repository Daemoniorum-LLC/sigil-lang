// Test: Struct update syntax
// Spec: 03-TYPES.md § 4.1 Structs
// Priority: P2 - Enhancement

struct Config {
    width: !i32,
    height: !i32,
    depth: !i32,
}

fn main() {
    let c1 = Config { width: 100, height: 200, depth: 300 };
    let c2 = Config { width: 150, ..c1 };

    println(c2.width);
    println(c2.height);
    println(c2.depth);
}
