// Test: Impl block with multiple methods
// Spec: 03-TYPES.md § 7.2 Implementation Blocks
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate ⊢ blocks can have multiple methods.
//
// Expected behavior:
// Should print 52 (42 + 10)

☉ Σ Value {
    x: !i32
}

⊢ Value {
    ☉ λ get(self) -> !i32 {
        self.x
    }

    ☉ λ add(self, y: !i32) -> !i32 {
        self.x + y
    }
}

λ main() {
    ≔ v: !Value = Value { x: 42 };
    println(v.add(10));
}
