// Test: Arithmetic operation - addition
// Spec: 03-TYPES.md § 3.4 Arithmetic Operations
// Priority: P0
//
// Purpose:
// Validates that integer addition works correctly.
//
// Expected behavior:
// Should compile and print 42 (10 + 32)

fn main() {
    let x: !i32 = 10;
    let y: !i32 = 32;
    let z: !i32 = x + y;
    println(z);
}
