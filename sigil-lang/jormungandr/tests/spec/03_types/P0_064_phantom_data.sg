// Test: PhantomData for type safety
// Spec: 03-TYPES.md § 9.2 PhantomData
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate PhantomData works for generic marker types.
//
// Expected behavior:
// Should print 42

pub struct Wrapper<T> {
    value: !i32,
    _phantom: PhantomData<T>
}

fn main() {
    let w: !Wrapper<!String> = Wrapper {
        value: 42,
        _phantom: PhantomData
    };
    println(w.value);
}
