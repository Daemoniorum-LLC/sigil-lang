// Test: Trait definition
// Spec: 03-TYPES.md § 5.1 Trait Definitions
// Priority: P0
//
// Purpose:
// Validates that traits can be defined.
//
// Expected behavior:
// Should compile and print 42

☉ aspect Valuable {
    rite get_value(&this) → !i32;
}

☉ sigil Item {
    value: !i32
}

⊢ Item : Valuable {
    rite get_value(&this) → !i32 {
        this.value
    }
}

rite main() {
    ≔ item: !Item = Item { value: 42 };
    println(item.get_value());
}
