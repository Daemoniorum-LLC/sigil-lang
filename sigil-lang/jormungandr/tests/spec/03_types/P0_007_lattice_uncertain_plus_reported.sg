// Test: Evidence lattice rule - Uncertain + Reported = Uncertain
// Spec: 03-TYPES.md § 2.2 Evidence Lattice
// Priority: P0
//
// Purpose:
// Validates that combining Uncertain (?) and Reported (~) evidence
// follows the pessimistic lattice rule: ? + ~ = ?
//
// Expected behavior:
// When adding an Uncertain value and a Reported value, the result
// should have Uncertain evidence. Should print 176 (99 + 77).

fn main() {
    let x: ?i32 = 99;
    let y: ~i32 = 77;
    let z = x + y;  // Should be ?i32
    println(z);
}
