// Test: Zero-sized type (unit Σ)
// Spec: 03-TYPES.md § 10.2 Zero-Sized Types
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate zero-sized types work correctly.
//
// Expected behavior:
// Should print 42

☉ Σ Marker;

λ process(_m: Marker) -> !i32 {
    42
}

λ main() {
    ≔ m: Marker = Marker;
    println(process(m));
}
