// Test: Self type in impl block
// Spec: 03-TYPES.md § 7.4 Self Type
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Self type works correctly in impl blocks.
//
// Expected behavior:
// Should print 42

pub struct Value {
    x: !i32
}

impl Value {
    pub fn new(x: !i32) -> Self {
        Self { x: x }
    }

    pub fn get(self) -> !i32 {
        self.x
    }
}

fn main() {
    let v: !Value = Value·new(42);
    println(v.get());
}
