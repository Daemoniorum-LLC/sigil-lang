// Test: Self type ∈ ⊢ block
// Spec: 03-TYPES.md § 7.4 Self Type
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate Self type works correctly ∈ ⊢ blocks.
//
// Expected behavior:
// Should print 42

☉ Σ Value {
    x: !i32
}

⊢ Value {
    ☉ λ new(x: !i32) -> Self {
        Self { x: x }
    }

    ☉ λ get(self) -> !i32 {
        self.x
    }
}

λ main() {
    ≔ v: !Value = Value·new(42);
    println(v.get());
}
