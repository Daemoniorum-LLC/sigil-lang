// P0_014: ↻ (cycle arrow) should parse as ↻ ∈ statement position
// Priority: P0
// Category: Native Symbols
// Tests: ↻ ∀ ↻
// Expected: Program compiles and runs, printing only odd numbers: 1, 3, 5, 7, 9

λ main() {
    ≔ Δ i = 0;

    ⟳ i < 10 {
        i = i + 1;
        // Skip even numbers
        ⎇ i % 2 == 0 {
            ↻;
        }
        println!("{}", i);
    }
}
