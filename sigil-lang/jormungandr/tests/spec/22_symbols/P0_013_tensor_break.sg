// P0_013: ⊗ (tensor/circled times) should parse as ⊗ ∈ statement position
// Priority: P0
// Category: Native Symbols
// Tests: ⊗ ∀ ⊗
// Expected: Program compiles and runs, printing 0, 1, 2 then "escaped"

λ main() {
    ≔ Δ i = 0;

    ∞ {
        println!("{}", i);
        i = i + 1;
        ⎇ i >= 3 {
            ⊗;
        }
    }

    println!("escaped");
}
