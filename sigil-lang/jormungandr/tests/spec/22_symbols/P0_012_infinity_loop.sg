// P0_012: ∞ (infinity) should parse as loop keyword
// Priority: P0
// Category: Native Symbols
// Tests: ∞ ∀ loop
// Expected: Program compiles and runs, printing 0, 1, 2 then "done"

λ main() {
    ≔ Δ i = 0;

    // Use ∞ ∀ infinite loop with ⊗
    ∞ {
        println!("{}", i);
        i = i + 1;
        ⎇ i >= 3 {
            ⊗;
        }
    }

    println!("done");
}
