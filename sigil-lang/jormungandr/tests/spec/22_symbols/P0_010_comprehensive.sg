// P0_010: Comprehensive native symbol test
// Priority: P0
// Category: Native Symbols
// Tests: Σ (struct), λ (fn), ≔ (let), ⊢ (impl), ⎇/⎉ (if/else), ⟳ (while), ⤺ (return)
// Expected: Program compiles and runs, printing expected output

Σ Counter {
    value: i64,
}

⊢ Counter {
    λ new(v: i64) -> Counter {
        Counter { value: v }
    }

    λ increment(&mut self) {
        self.value = self.value + 1;
    }

    λ get(self) -> i64 {
        ⤺ self.value
    }
}

λ classify(n: i64) -> i64 {
    ⎇ n > 0 {
        ⤺ 1
    } ⎉ ⎇ n < 0 {
        ⤺ -1
    } ⎉ {
        ⤺ 0
    }
}

λ main() {
    // Test struct and impl
    ≔ mut counter = Counter::new(0);
    counter.increment();
    counter.increment();
    counter.increment();
    println!("Counter: {}", counter.get());

    // Test if/else with native symbols
    println!("classify(5) = {}", classify(5));
    println!("classify(-3) = {}", classify(-3));
    println!("classify(0) = {}", classify(0));

    // Test while loop
    ≔ mut i = 0;
    ⟳ i < 3 {
        println!("loop {}", i);
        i = i + 1;
    }

    println!("Done!");
}
