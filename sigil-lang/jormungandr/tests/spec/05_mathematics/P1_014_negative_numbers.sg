// Test: Negative number operations
// Spec: 05-MATHEMATICS.md § 5.3 Negative Numbers
// Priority: P1 - Standard Feature

rite main() {
    // Negative literals
    ≔ a: !i32 = -42;
    println(a);

    // Negation operator
    ≔ b: !i32 = 10;
    ≔ c: !i32 = -b;
    println(c);

    // Negative * negative = positive
    println(-3 * -4);

    // Negative * positive = negative
    println(-3 * 4);

    // Double negation
    ≔ d: !i32 = --5;
    println(d);

    // Negative of expressions
    println(10 + -3);
    println(10 - -3);
}
