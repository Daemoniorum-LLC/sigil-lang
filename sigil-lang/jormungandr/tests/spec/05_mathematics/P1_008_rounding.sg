// Test: Rounding functions
// Spec: 05-MATHEMATICS.md § 3.1 Rounding
// Priority: P1 - Standard Feature

fn main() {
    // floor - round down
    println(floor(3.7));
    println(floor(3.2));
    println(floor(-1.5));

    // ceil - round up
    println(ceil(3.2));
    println(ceil(3.7));
    println(ceil(-1.5));

    // round - nearest integer
    println(round(3.4));
    println(round(3.5));
    println(round(3.6));
}
