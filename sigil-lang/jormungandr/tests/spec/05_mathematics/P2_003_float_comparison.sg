// Test: Float comparisons
// Spec: 05-MATHEMATICS.md § 2.2 Floating Point
// Priority: P2 - Enhancement

fn main() {
    let x: !f64 = 3.14;
    let y: !f64 = 2.71;

    if x > y {
        println(1);
    } else {
        println(0);
    }

    if y < x {
        println(1);
    } else {
        println(0);
    }
}
