// Test: Basic trigonometric functions
// Spec: 05-MATHEMATICS.md § 2.1 Trigonometry
// Priority: P1 - Standard Feature

fn main() {
    // sin(0) = 0
    println(sin(0.0));

    // cos(0) = 1
    println(cos(0.0));

    // tan(0) = 0
    println(tan(0.0));

    // sin(PI/2) = 1
    let pi: !f64 = PI();
    let half_pi: !f64 = pi / 2.0;
    let s: !f64 = sin(half_pi);
    // Round to avoid float precision issues
    println(round(s));

    // cos(PI) = -1
    println(round(cos(pi)));
}
