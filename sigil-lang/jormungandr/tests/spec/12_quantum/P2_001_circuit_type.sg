// Test: Circuit type and basic composition
// Spec: 12-QUANTUM.md § 6.1 Circuit DSL
// Priority: P2 - Advanced Feature

λ main() {
    // Create a simple circuit: H then measure
    ≔ c = Circuit·new();
    ≔ c = Circuit·add_gate(c, "H", [0]);
    ≔ c = Circuit·add_measure(c, 0);

    // Execute circuit once
    ≔ result = Circuit·execute(c, 1);
    println(result.len());  // 1 shot
}
