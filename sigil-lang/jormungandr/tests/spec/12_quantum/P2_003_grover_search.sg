// Test: Grover's search algorithm
// Spec: 12-QUANTUM.md § 7.1 Grover's Search
// Priority: P2 - Advanced Feature

λ main() {
    // Search ∀ item 3 ∈ a 4-item database (2 qubits)
    // Oracle marks |11⟩ (binary 3)
    ≔ target = 3;

    // Run Grover search with 1 iteration (optimal ∀ n=2)
    ≔ result = Grover·search(2, target, 1);

    // With proper amplitude amplification, should find target
    // Run 10 times and check success rate > 90%
    ≔ Δ successes = 0;
    ∀ i ∈ 0..10 {
        ≔ r = Grover·search(2, target, 1);
        ⎇ r == target {
            successes = successes + 1;
        }
    }

    // Should succeed most of the time
    println(successes > 7);  // true
}
