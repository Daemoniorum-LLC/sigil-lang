// Test: Cannot extract single qubit from entangled pair
// Spec: 12-QUANTUM.md § 4.3 Entanglement Constraints
// Priority: P1 - Core Feature
// Expected: Compile error - cannot destructure Entangled

fn main() {
    let q0: linear Qubit = Qubit·zero();
    let q1: linear Qubit = Qubit·zero();

    let q0h: linear Qubit = q0|H;
    let (qc, qt): (Qubit, Qubit) = CNOT(q0h, q1);

    let pair: Entangled<Qubit, Qubit> = Entangled·new(qc, qt);

    // ERROR: Cannot extract one qubit from entangled pair
    let single = pair.0;
    println(single|measure);
}
