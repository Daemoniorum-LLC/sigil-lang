// Test: Tensor product (⊗)
// Spec: 12-QUANTUM.md § 1.2 Quantum Operators
// Priority: P0 - Bootstrap Critical

λ main() {
    ≔ a: linear Qubit = Qubit·zero();
    ≔ b: linear Qubit = Qubit·one();
    ≔ combined: linear QRegister<2> = a ⊗ b;  // Tensor product
    ≔ results = combined|measure_all;
    println(results[0]);
    println(results[1]);
}
