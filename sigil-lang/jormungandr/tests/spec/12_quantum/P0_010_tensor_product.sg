// Test: Tensor product (⊗)
// Spec: 12-QUANTUM.md § 1.2 Quantum Operators
// Priority: P0 - Bootstrap Critical

fn main() {
    let a: linear Qubit = Qubit·zero();
    let b: linear Qubit = Qubit·one();
    let combined: linear QRegister<2> = a ⊗ b;  // Tensor product
    let results = combined|measure_all;
    println(results[0]);
    println(results[1]);
}
