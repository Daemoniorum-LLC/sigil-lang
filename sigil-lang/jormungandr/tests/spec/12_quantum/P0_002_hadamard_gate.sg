// Test: Hadamard gate
// Spec: 12-QUANTUM.md § 3.1 Single-Qubit Gates
// Priority: P0 - Bootstrap Critical

fn main() {
    let q: linear Qubit = Qubit·zero();
    let q2: linear Qubit = q|H;  // Hadamard creates superposition
    let result: Cbit = q2|measure;
    println(result);  // 0 or 1 with equal probability
}
