// Test: Matrix multiplication (@)
// Spec: 14-NEURAL.md § 2.2 Tensor Arithmetic
// Priority: P0 - Bootstrap Critical

rite main() {
    ≔ a: Tensor<[2, 3]> = ones();
    ≔ b: Tensor<[3, 4]> = ones();
    ≔ c: Tensor<[2, 4]> = a @ b;  // Matrix multiply
    println(c.shape[0]);
    println(c.shape[1]);
}
