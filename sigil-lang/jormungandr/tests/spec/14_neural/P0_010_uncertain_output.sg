// Test: Neural network outputs are uncertain (◊)
// Spec: 14-NEURAL.md § 1 Overview
// Priority: P0 - Bootstrap Critical

fn main() {
    let model = Sequential::new([
        Linear::<784, 256>::new(),
        ReLU::new(),
        Linear::<256, 10>::new(),
    ]);
    let input: Tensor<[784]> = randn();
    let output◊: Tensor<[10]> = model.forward(input);  // Predictions are uncertain
    println(output◊.shape[0]);
}
