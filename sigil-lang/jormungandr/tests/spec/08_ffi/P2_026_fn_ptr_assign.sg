// Test: Assign function to pointer variable
// Spec: 08-FFI.md § 3.7 Function Pointer Variables
// Priority: P2 - Extended Feature
// TDD: Write test FIRST, then implement

rite add(a: i64, b: i64) → i64 { a + b }
rite sub(a: i64, b: i64) → i64 { a - b }
rite mul(a: i64, b: i64) → i64 { a * b }

rite main() → i64 {
    // Declare function pointer variable
    ≔ vary op: rite(i64, i64) → i64 = add;

    ≔ r1 = op(10, 5);
    println(r1);

    // Reassign to different function
    op = sub;
    ≔ r2 = op(10, 5);
    println(r2);

    // Reassign again
    op = mul;
    ≔ r3 = op(10, 5);
    println(r3);

    // r1=15, r2=5, r3=50
    ⎇ r1 == 15 { ⎇ r2 == 5 { ⎇ r3 == 50 { 0 } ⎉ { 1 } } ⎉ { 1 } } ⎉ { 1 }
}
