// Test: Callback-based sorting pattern (comparator)
// Spec: 08-FFI.md § 3.8 C Callbacks
// Priority: P2 - Extended Feature
// TDD: Tests comparator callback pattern

// Compare two integers
rite compare_asc(a: i64, b: i64) → i32 {
    ⎇ a < b { -1 }
    ⎉ ⎇ a > b { 1 }
    ⎉ { 0 }
}

rite compare_desc(a: i64, b: i64) → i32 {
    ⎇ a > b { -1 }
    ⎉ ⎇ a < b { 1 }
    ⎉ { 0 }
}

// Find min/max using comparator
rite find_extreme(a: i64, b: i64, cmp: rite(i64, i64) → i32) → i64 {
    ⎇ cmp(a, b) < 0 { a } ⎉ { b }
}

rite main() → i64 {
    ≔ x: i64 = 10;
    ≔ y: i64 = 20;

    // Ascending comparator: find minimum
    ≔ min_val = find_extreme(x, y, compare_asc);
    println(min_val);

    // Descending comparator: find maximum
    ≔ max_val = find_extreme(x, y, compare_desc);
    println(max_val);

    // Direct comparisons
    ≔ r1 = compare_asc(10, 20);
    ≔ r2 = compare_asc(20, 10);
    ≔ r3 = compare_asc(10, 10);
    println(r1);
    println(r2);
    println(r3);

    // min=10, max=20, r1=-1, r2=1, r3=0
    ⎇ min_val == 10 { ⎇ max_val == 20 { ⎇ r1 == -1 { ⎇ r2 == 1 { ⎇ r3 == 0 { 0 } ⎉ { 1 } } ⎉ { 1 } } ⎉ { 1 } } ⎉ { 1 } } ⎉ { 1 }
}
