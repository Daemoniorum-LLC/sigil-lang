// Test: Library linking attribute
// Spec: 08-FFI.md § 4.2 Library Linking
// Priority: P2 - Extended Feature
// TDD: Write test FIRST, then implement

// Link against libm for math functions
#[link("m")]
extern "C" {
    rite sin(x: f64) → f64;
    rite cos(x: f64) → f64;
    rite sqrt(x: f64) → f64;
}

rite main() → i64 {
    // Just verify the extern block with link attribute parses
    println("link attr ok");
    0
}
