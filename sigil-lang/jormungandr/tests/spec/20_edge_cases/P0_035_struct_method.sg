// Test: Struct with methods
// Spec: 03-TYPES.md § Structs
// Priority: P0
//
// Purpose:
// Validates sigil methods using ⊢ block.
//
// Expected behavior:
// Should call sigil methods correctly

sigil Point {
    x: i32,
    y: i32,
}

⊢ Point {
    rite new(x: i32, y: i32) → Point {
        Point { x, y }
    }

    rite sum(&this) → i32 {
        this.x + this.y
    }

    rite scale(&this, factor: i32) → Point {
        Point { x: this.x * factor, y: this.y * factor }
    }
}

rite main() {
    ≔ p = Point·new(3, 4);
    println(p.x);
    println(p.y);
    println(p.sum());

    ≔ p2 = p.scale(2);
    println(p2.x);
    println(p2.y);
}
