// Test: Trait implementation
// Spec: 03-TYPES.md § Traits
// Priority: P0
//
// Purpose:
// Validates aspect definition and implementation.
//
// Expected behavior:
// Should call aspect methods through impl

aspect Greet {
    rite greet(&this) → &str;
}

sigil English;
sigil Spanish;

⊢ English : Greet {
    rite greet(&this) → &str {
        "Hello"
    }
}

⊢ Spanish : Greet {
    rite greet(&this) → &str {
        "Hola"
    }
}

rite main() {
    ≔ e = English;
    ≔ s = Spanish;
    println(e.greet());
    println(s.greet());
}
