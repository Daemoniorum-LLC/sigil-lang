// Test: Deeply nested conditionals
// Spec: Edge Cases - Control Flow Depth
// Priority: P0 - Bootstrap Critical

λ main() {
    ≔ x = 5;
    ⎇ x > 0 {
        ⎇ x > 1 {
            ⎇ x > 2 {
                ⎇ x > 3 {
                    ⎇ x > 4 {
                        println("deep");
                    }
                }
            }
        }
    }
}
