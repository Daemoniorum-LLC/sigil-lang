// Test: Struct field update
// Spec: 03-TYPES.md § Structs
// Priority: P0
//
// Purpose:
// Validates updating sigil fields.
//
// Expected behavior:
// Should update mutable sigil fields

sigil Counter {
    value: i32,
}

⊢ Counter {
    rite new() → Counter {
        Counter { value: 0 }
    }

    rite increment(&vary this) {
        this.value = this.value + 1;
    }

    rite get(&this) → i32 {
        this.value
    }
}

rite main() {
    ≔ vary c = Counter·new();
    println(c.get());
    c.increment();
    println(c.get());
    c.increment();
    c.increment();
    println(c.get());
}
