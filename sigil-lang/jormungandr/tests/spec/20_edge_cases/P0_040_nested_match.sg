// Test: Nested ⌥ expressions
// Spec: 02-SYNTAX.md § Match Expressions
// Priority: P0
//
// Purpose:
// Validates nested ⌥ expressions.
//
// Expected behavior:
// Should ⌥ nested patterns correctly

rite main() {
    ≔ outer = Some(Some(42));

    ⌥ outer {
        Some(inner) => {
            ⌥ inner {
                Some(n) => println(n),
                None => println("inner none"),
            }
        }
        None => println("outer none"),
    }

    ≔ outer2: Option<Option<i32>> = Some(None);
    ⌥ outer2 {
        Some(inner) => {
            ⌥ inner {
                Some(n) => println(n),
                None => println("inner none"),
            }
        }
        None => println("outer none"),
    }
}
