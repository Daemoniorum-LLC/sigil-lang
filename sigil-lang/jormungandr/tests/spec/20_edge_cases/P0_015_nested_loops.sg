// Test: Nested loops with break
// Spec: Edge Cases - Control Flow
// Priority: P0 - Bootstrap Critical

fn main() {
    let mut count = 0;
    let mut i = 0;
    while i < 3 {
        let mut j = 0;
        while j < 3 {
            count = count + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    println(count);  // 3 * 3 = 9
}
