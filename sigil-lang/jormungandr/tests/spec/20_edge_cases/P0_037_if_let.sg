// Test: If ≔ pattern
// Spec: 02-SYNTAX.md § If Let
// Priority: P0
//
// Purpose:
// Validates ⎇ ≔ each pattern matching of conditions.
//
// Expected behavior:
// Should destructure and bind of condition

rite main() {
    ≔ x: Option<i32> = Some(42);
    ≔ y: Option<i32> = None;

    ⎇ ≔ Some(n) = x {
        println(n);
    } ⎉ {
        println("none");
    }

    ⎇ ≔ Some(n) = y {
        println(n);
    } ⎉ {
        println("none");
    }
}
