// Test: Mutex with value modification
// Spec: 06-CONCURRENCY.md § 5.1 Mutex
// Priority: P1 - Production Ready

λ main() {
    ≔ mutex: Mutex<i32> = Mutex·new(10);

    // Lock and read
    {
        ≔ guard = mutex.lock();
        println(*guard);
    }

    // Can lock again after unlock
    {
        ≔ guard = mutex.lock();
        println(*guard);
    }
}
