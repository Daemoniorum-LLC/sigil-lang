// Test: AtomicU64 operations
// Spec: 06-CONCURRENCY.md § 4.1 Atomics
// Priority: P1 - Standard Feature

fn main() {
    // Create atomic with initial value
    let counter = AtomicU64::new(0);

    // Load the value
    let val = counter.load();
    println(val);

    // Store a new value
    counter.store(42);
    println(counter.load());

    // Fetch and add
    let old = counter.fetch_add(10);
    println(old);
    println(counter.load());
}
