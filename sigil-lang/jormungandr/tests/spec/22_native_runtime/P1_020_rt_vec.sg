// P1_020_rt_vec.sg - Vec<T> Specification Tests (interpreter-compatible)
//
// These tests verify array operations work correctly.
// Restructured for interpreter mode.

// ============================================================================
// Construction
// ============================================================================

fn test_vec_new_is_empty() {
    let v = [];
    assert_eq!(v.len(), 0);
    assert!(v.is_empty());
}

fn test_vec_with_capacity_has_capacity() {
    let v = [1, 2, 3];
    assert!(v.capacity() >= 3);
}

// ============================================================================
// Push / Pop
// ============================================================================

fn test_vec_push_increases_len() {
    let mut v = [];
    v.push(42);
    assert_eq!(v.len(), 1);
    assert!(!v.is_empty());
}

fn test_vec_push_stores_value() {
    let mut v = [];
    v.push(10);
    v.push(20);
    v.push(30);
    assert_eq!(v[0], 10);
    assert_eq!(v[1], 20);
    assert_eq!(v[2], 30);
}

fn test_vec_pop_returns_last() {
    let mut v = [];
    v.push(10);
    v.push(20);

    match v.pop() {
        Option::Some(val) => assert_eq!(val, 20),
        Option::None => assert!(false),
    }
    assert_eq!(v.len(), 1);
}

fn test_vec_pop_empty_returns_none() {
    let mut v = [];
    match v.pop() {
        Option::Some(_) => assert!(false),
        Option::None => assert!(true),
    }
    assert_eq!(v.len(), 0);
}

// ============================================================================
// Indexing / Get
// ============================================================================

fn test_vec_get_valid_index() {
    let mut v = [];
    v.push(100);
    v.push(200);

    assert_eq!(v[0], 100);
    assert_eq!(v[1], 200);
}

fn test_vec_get_mut_allows_modification() {
    let mut v = [];
    v.push(10);

    // In interpreter, arrays are mutable via indexing
    v[0] = 999;
    assert_eq!(v[0], 999);
}

fn test_vec_index_operator() {
    let mut v = [];
    v.push(42);
    v.push(84);

    assert_eq!(v[0], 42);
    assert_eq!(v[1], 84);
}

// ============================================================================
// Capacity / Growth
// ============================================================================

fn test_vec_grows_automatically() {
    let mut v = [];
    v.push(1);
    v.push(2);
    v.push(3);

    assert_eq!(v.len(), 3);
    assert!(v.capacity() >= 3);
    assert_eq!(v[2], 3);
}

fn test_vec_growth_doubles_capacity() {
    let mut v = [];
    for i in 0..10 {
        v.push(i);
    }
    assert!(v.capacity() >= 10);
}

// ============================================================================
// Clear
// ============================================================================

fn test_vec_clear_preserves_capacity() {
    let mut v = [];
    v.push(1);
    v.push(2);
    v.push(3);

    v.clear();

    assert_eq!(v.len(), 0);
    assert!(v.is_empty());
}

// ============================================================================
// Slice Views
// ============================================================================

fn test_vec_as_slice() {
    let mut v = [];
    v.push(1);
    v.push(2);
    v.push(3);

    let slice = v.as_slice();
    assert_eq!(slice.len(), 3);
    assert_eq!(slice[0], 1);
    assert_eq!(slice[1], 2);
    assert_eq!(slice[2], 3);
}

// ============================================================================
// Drop
// ============================================================================

fn test_vec_drops_elements() {
    {
        let mut v = [];
        for i in 0..1000 {
            v.push(i);
        }
    }
    println("Vec dropped successfully");
}

// ============================================================================
// Entry Point
// ============================================================================

fn main() {
    // Construction
    test_vec_new_is_empty();
    test_vec_with_capacity_has_capacity();

    // Push/Pop
    test_vec_push_increases_len();
    test_vec_push_stores_value();
    test_vec_pop_returns_last();
    test_vec_pop_empty_returns_none();

    // Indexing
    test_vec_get_valid_index();
    test_vec_get_mut_allows_modification();
    test_vec_index_operator();

    // Capacity
    test_vec_grows_automatically();
    test_vec_growth_doubles_capacity();

    // Clear
    test_vec_clear_preserves_capacity();

    // Slice
    test_vec_as_slice();

    // Drop
    test_vec_drops_elements();

    println("All Vec tests passed!");
}
