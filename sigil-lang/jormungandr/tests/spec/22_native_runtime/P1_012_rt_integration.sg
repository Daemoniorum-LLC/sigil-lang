// P1_012_rt_integration.sg
// Test: Full integration test for native runtime
// Phase F: Integration
//
// This test exercises all runtime components together
// to verify the complete native runtime works.

invoke tome·rt·sys;
invoke tome·rt·alloc·{init_allocator, Arena, sigil_alloc, sigil_free};
invoke tome·rt·types·{Vec, String};
invoke tome·rt·io·{println, File, read_file, write_file};
invoke tome·rt·math·{sqrt, sin, cos, PI};
invoke tome·rt·time·{Instant, sigil_now};

fn main() {
    // Phase A: Syscalls
    println("=== Phase A: Syscalls ===");

    ≔ write_ok = sys::write(1, "Direct syscall write\n".as_bytes()).is_ok();
    assert!(write_ok);
    println("syscall_write: PASS");

    ≔ mmap_ptr = sys::mmap_anon(4096);
    assert!(mmap_ptr.is_ok());
    sys::munmap(mmap_ptr.unwrap(), 4096);
    println("syscall_mmap: PASS");

    ≔ time = sys::clock_gettime_realtime();
    assert!(time.is_ok());
    println("syscall_clock: PASS");

    // Phase B: Memory
    println("=== Phase B: Memory ===");

    init_allocator();
    println("init_allocator: PASS");

    ≔ mem = sigil_alloc(1024);
    assert!(!mem.is_null());
    unsafe {
        *mem = 42;
        assert_eq!(*mem, 42);
    }
    sigil_free(mem);
    println("global_alloc: PASS");

    vary arena = Arena::new();
    ≔ arena_mem = arena.alloc(256);
    assert!(!arena_mem.is_null());
    println("arena_alloc: PASS");

    // Phase C: Types
    println("=== Phase C: Types ===");

    vary v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    assert_eq!(v.len(), 3);
    assert_eq!(v.pop(), Some(3));
    println("vec: PASS");

    vary s = String::from("Hello");
    s.push_str(" World");
    assert_eq!(s.as_str(), "Hello World");
    println("string: PASS");

    // Phase D: I/O
    println("=== Phase D: I/O ===");

    ≔ test_path = "/tmp/sigil_rt_integration_test.txt";
    ≔ test_content = "Integration test content";

    ≔ write_result = write_file(test_path, test_content);
    assert!(write_result.is_ok());
    println("file_write: PASS");

    ≔ read_result = read_file(test_path);
    assert!(read_result.is_ok());
    assert_eq!(read_result.unwrap().as_str(), test_content);
    println("file_read: PASS");

    sys::unlink(test_path);
    println("file_unlink: PASS");

    // Phase E: Math
    println("=== Phase E: Math ===");

    assert!(fabs(sqrt(4.0) - 2.0) < 0.0001);
    println("math_sqrt: PASS");

    assert!(fabs(sin(PI / 2.0) - 1.0) < 0.0001);
    println("math_sin: PASS");

    assert!(fabs(cos(0.0) - 1.0) < 0.0001);
    println("math_cos: PASS");

    // Time measurement
    println("=== Phase F: Time ===");

    ≔ now = sigil_now();
    assert!(now > 1704067200000);  // After 2024-01-01
    println("sigil_now: PASS");

    ≔ start = Instant::now();
    vary count: u64 = 0;
    while count < 10000 {
        count += 1;
    }
    ≔ elapsed = start.elapsed();
    assert!(elapsed.as_nanos() > 0);
    println("instant_elapsed: PASS");

    // Summary
    println("=== Summary ===");
    println("All native runtime tests passed!");
    println("C runtime dependency: ELIMINATED");

    println("done");
}

fn fabs(x: f64) → f64 {
    ⎇ x < 0.0 { -x } ⎉ { x }
}
