// P1_011_rt_math.sg
// Test: Native runtime math functions via LLVM intrinsics
// Phase E: Math
//
// This test verifies math functions work using LLVM intrinsics
// instead of libm.

invoke tome·rt·math·{
    sqrt, sin, cos, tan, exp, ln, log2, log10, pow,
    floor, ceil, round, trunc, fabs, fmod,
    sinh, cosh, tanh, asin, acos, atan, atan2, hypot,
    abs, min, max, clamp, sign, gcd, lcm,
    PI, E
};
invoke tome·rt·alloc·init_allocator;

fn approx_eq(a: f64, b: f64, epsilon: f64) -> bool {
    fabs(a - b) < epsilon
}

fn main() {
    init_allocator();

    ≔ eps = 0.0001;

    // Test 1: sqrt
    assert!(approx_eq(sqrt(4.0), 2.0, eps));
    assert!(approx_eq(sqrt(9.0), 3.0, eps));
    assert!(approx_eq(sqrt(2.0), 1.41421356, eps));
    println("sqrt_ok");

    // Test 2: sin
    assert!(approx_eq(sin(0.0), 0.0, eps));
    assert!(approx_eq(sin(PI / 2.0), 1.0, eps));
    assert!(approx_eq(sin(PI), 0.0, eps));
    assert!(approx_eq(sin(PI * 3.0 / 2.0), -1.0, eps));
    println("sin_ok");

    // Test 3: cos
    assert!(approx_eq(cos(0.0), 1.0, eps));
    assert!(approx_eq(cos(PI / 2.0), 0.0, eps));
    assert!(approx_eq(cos(PI), -1.0, eps));
    println("cos_ok");

    // Test 4: tan
    assert!(approx_eq(tan(0.0), 0.0, eps));
    assert!(approx_eq(tan(PI / 4.0), 1.0, eps));
    println("tan_ok");

    // Test 5: exp
    assert!(approx_eq(exp(0.0), 1.0, eps));
    assert!(approx_eq(exp(1.0), E, eps));
    assert!(approx_eq(exp(2.0), 7.38905609, eps));
    println("exp_ok");

    // Test 6: ln (natural log)
    assert!(approx_eq(ln(1.0), 0.0, eps));
    assert!(approx_eq(ln(E), 1.0, eps));
    assert!(approx_eq(ln(10.0), 2.302585, eps));
    println("ln_ok");

    // Test 7: log2
    assert!(approx_eq(log2(1.0), 0.0, eps));
    assert!(approx_eq(log2(2.0), 1.0, eps));
    assert!(approx_eq(log2(8.0), 3.0, eps));
    assert!(approx_eq(log2(1024.0), 10.0, eps));
    println("log2_ok");

    // Test 8: log10
    assert!(approx_eq(log10(1.0), 0.0, eps));
    assert!(approx_eq(log10(10.0), 1.0, eps));
    assert!(approx_eq(log10(100.0), 2.0, eps));
    assert!(approx_eq(log10(1000.0), 3.0, eps));
    println("log10_ok");

    // Test 9: pow
    assert!(approx_eq(pow(2.0, 0.0), 1.0, eps));
    assert!(approx_eq(pow(2.0, 3.0), 8.0, eps));
    assert!(approx_eq(pow(10.0, 2.0), 100.0, eps));
    assert!(approx_eq(pow(2.0, 0.5), sqrt(2.0), eps));
    println("pow_ok");

    // Test 10: floor
    assert!(approx_eq(floor(3.7), 3.0, eps));
    assert!(approx_eq(floor(3.2), 3.0, eps));
    assert!(approx_eq(floor(-3.7), -4.0, eps));
    assert!(approx_eq(floor(3.0), 3.0, eps));
    println("floor_ok");

    // Test 11: ceil
    assert!(approx_eq(ceil(3.2), 4.0, eps));
    assert!(approx_eq(ceil(3.7), 4.0, eps));
    assert!(approx_eq(ceil(-3.2), -3.0, eps));
    assert!(approx_eq(ceil(3.0), 3.0, eps));
    println("ceil_ok");

    // Test 12: round
    assert!(approx_eq(round(3.4), 3.0, eps));
    assert!(approx_eq(round(3.5), 4.0, eps));
    assert!(approx_eq(round(3.6), 4.0, eps));
    assert!(approx_eq(round(-3.5), -4.0, eps));
    println("round_ok");

    // Test 13: trunc
    assert!(approx_eq(trunc(3.7), 3.0, eps));
    assert!(approx_eq(trunc(-3.7), -3.0, eps));
    assert!(approx_eq(trunc(3.0), 3.0, eps));
    println("trunc_ok");

    // Test 14: fabs
    assert!(approx_eq(fabs(3.5), 3.5, eps));
    assert!(approx_eq(fabs(-3.5), 3.5, eps));
    assert!(approx_eq(fabs(0.0), 0.0, eps));
    println("fabs_ok");

    // Test 15: fmod
    assert!(approx_eq(fmod(7.0, 3.0), 1.0, eps));
    assert!(approx_eq(fmod(10.0, 3.0), 1.0, eps));
    assert!(approx_eq(fmod(-7.0, 3.0), -1.0, eps));
    println("fmod_ok");

    // Test 16: sinh, cosh, tanh
    assert!(approx_eq(sinh(0.0), 0.0, eps));
    assert!(approx_eq(cosh(0.0), 1.0, eps));
    assert!(approx_eq(tanh(0.0), 0.0, eps));
    println("hyperbolic_ok");

    // Test 17: asin, acos, atan
    assert!(approx_eq(asin(0.0), 0.0, eps));
    assert!(approx_eq(asin(1.0), PI / 2.0, eps));
    assert!(approx_eq(acos(1.0), 0.0, eps));
    assert!(approx_eq(acos(0.0), PI / 2.0, eps));
    assert!(approx_eq(atan(0.0), 0.0, eps));
    assert!(approx_eq(atan(1.0), PI / 4.0, eps));
    println("inverse_trig_ok");

    // Test 18: atan2 quadrants
    assert!(approx_eq(atan2(1.0, 1.0), PI / 4.0, eps));      // Quadrant I
    assert!(approx_eq(atan2(1.0, -1.0), 3.0 * PI / 4.0, eps));  // Quadrant II
    assert!(approx_eq(atan2(-1.0, -1.0), -3.0 * PI / 4.0, eps)); // Quadrant III
    assert!(approx_eq(atan2(-1.0, 1.0), -PI / 4.0, eps));    // Quadrant IV
    println("atan2_ok");

    // Test 19: hypot
    assert!(approx_eq(hypot(3.0, 4.0), 5.0, eps));
    assert!(approx_eq(hypot(5.0, 12.0), 13.0, eps));
    println("hypot_ok");

    // Test 20: Integer math - abs
    assert_eq!(abs(42), 42);
    assert_eq!(abs(-42), 42);
    assert_eq!(abs(0), 0);
    println("int_abs_ok");

    // Test 21: Integer math - min, max
    assert_eq!(min(3, 7), 3);
    assert_eq!(min(7, 3), 3);
    assert_eq!(max(3, 7), 7);
    assert_eq!(max(7, 3), 7);
    println("int_minmax_ok");

    // Test 22: Integer math - clamp
    assert_eq!(clamp(5, 0, 10), 5);
    assert_eq!(clamp(-5, 0, 10), 0);
    assert_eq!(clamp(15, 0, 10), 10);
    println("int_clamp_ok");

    // Test 23: Integer math - sign
    assert_eq!(sign(42), 1);
    assert_eq!(sign(-42), -1);
    assert_eq!(sign(0), 0);
    println("int_sign_ok");

    // Test 24: Integer math - gcd, lcm
    assert_eq!(gcd(12, 18), 6);
    assert_eq!(gcd(17, 13), 1);  // coprime
    assert_eq!(lcm(4, 6), 12);
    assert_eq!(lcm(3, 5), 15);
    println("int_gcd_lcm_ok");

    // Test 25: Constants
    assert!(approx_eq(PI, 3.14159265358979323846, 1e-10));
    assert!(approx_eq(E, 2.71828182845904523536, 1e-10));
    println("constants_ok");

    println("done");
}
