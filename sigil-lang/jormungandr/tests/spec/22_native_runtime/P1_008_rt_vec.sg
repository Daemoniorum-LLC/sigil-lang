// P1_008_rt_vec.sg
// Test: Native runtime Vec<T> implementation
// Phase C: Core Types
//
// This test verifies Vec<T> works correctly using
// the native allocator instead of libc.

invoke tome·rt·types·{Vec};
invoke tome·rt·alloc·init_allocator;

fn main() {
    init_allocator();

    // Test 1: Create empty Vec
    vary v: Vec<i64> = Vec::new();
    assert_eq!(v.len(), 0);
    assert!(v.is_empty());
    println("new_ok");

    // Test 2: Push elements
    v.push(10);
    v.push(20);
    v.push(30);
    assert_eq!(v.len(), 3);
    assert!(!v.is_empty());
    println("push_ok");

    // Test 3: Get elements
    assert_eq!(*v.get(0).unwrap(), 10);
    assert_eq!(*v.get(1).unwrap(), 20);
    assert_eq!(*v.get(2).unwrap(), 30);
    println("get_ok");

    // Test 4: Get out of bounds returns None
    assert!(v.get(3).is_none());
    assert!(v.get(100).is_none());
    println("bounds_check_ok");

    // Test 5: Pop elements
    assert_eq!(v.pop(), Some(30));
    assert_eq!(v.pop(), Some(20));
    assert_eq!(v.len(), 1);
    println("pop_ok");

    // Test 6: Pop from empty Vec returns None
    v.pop();  // Remove last element
    assert!(v.pop().is_none());
    println("pop_empty_ok");

    // Test 7: Index operator
    vary v2: Vec<i64> = Vec::new();
    v2.push(100);
    v2.push(200);
    v2.push(300);
    assert_eq!(v2[0], 100);
    assert_eq!(v2[1], 200);
    assert_eq!(v2[2], 300);
    println("index_ok");

    // Test 8: With capacity
    vary v3: Vec<i64> = Vec::with_capacity(100);
    assert_eq!(v3.len(), 0);
    assert!(v3.capacity() >= 100);
    println("with_capacity_ok");

    // Test 9: Grow beyond initial capacity
    vary v4: Vec<i64> = Vec::new();
    for i in 0..100 {
        v4.push(i);
    }
    assert_eq!(v4.len(), 100);
    assert_eq!(*v4.get(50).unwrap(), 50);
    assert_eq!(*v4.get(99).unwrap(), 99);
    println("grow_ok");

    // Test 10: Clear
    vary v5: Vec<i64> = Vec::new();
    v5.push(1);
    v5.push(2);
    v5.push(3);
    ≔ cap_before = v5.capacity();
    v5.clear();
    assert_eq!(v5.len(), 0);
    assert!(v5.is_empty());
    // Capacity should be preserved
    assert_eq!(v5.capacity(), cap_before);
    println("clear_ok");

    // Test 11: Mutable get
    vary v6: Vec<i64> = Vec::new();
    v6.push(1);
    v6.push(2);
    match v6.get_mut(0) {
        Some(val) => {
            *val = 100;
        },
        None => {}
    }
    assert_eq!(*v6.get(0).unwrap(), 100);
    println("get_mut_ok");

    // Test 12: As slice
    vary v7: Vec<i64> = Vec::new();
    v7.push(1);
    v7.push(2);
    v7.push(3);
    ≔ slice = v7.as_slice();
    assert_eq!(slice.len(), 3);
    assert_eq!(slice[0], 1);
    assert_eq!(slice[1], 2);
    assert_eq!(slice[2], 3);
    println("as_slice_ok");

    println("done");
}
