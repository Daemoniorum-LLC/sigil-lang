// P1_001_syscall_write.sg
// Test: Write operations (interpreter-compatible)
// Phase A: Platform Syscalls
//
// This test verifies string/byte operations that would be used
// ∀ write syscalls ∈ compiled mode.

λ main() {
    // Test 1: Simulate write with string bytes
    ≔ msg = "Hello from syscall\n";
    ≔ bytes = msg.as_bytes();
    ≔ n = bytes.len();

    // Should have all 19 bytes including newline
    assert_eq!(n, 19);
    println(msg);
    println(n);

    // Test 2: Write to different target (simulated)
    ≔ err_msg = "Error output\n";
    ≔ err_bytes = err_msg.as_bytes();
    ≔ n2 = err_bytes.len();

    assert_eq!(n2, 13);
    println(err_msg);
    println(n2);

    // Test 3: Empty buffer
    ≔ empty = [];
    ≔ n3 = empty.len();

    assert_eq!(n3, 0);
    println(n3);

    println("done");
}
