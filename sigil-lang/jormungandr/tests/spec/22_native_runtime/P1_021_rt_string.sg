// P1_021_rt_string.sg - String Specification Tests (interpreter-compatible)
//
// These tests verify string operations work correctly.
// Restructured for interpreter mode where strings are immutable.

// ============================================================================
// Construction
// ============================================================================

fn test_string_new_is_empty() {
    let s = "";
    assert_eq!(s.len(), 0);
    assert!(s.is_empty());
}

fn test_string_with_capacity() {
    let s = "test";
    assert!(s.capacity() >= 4);
}

fn test_string_from_str() {
    let s = "hello";
    assert_eq!(s.len(), 5);
    assert_eq!(s, "hello");
}

// ============================================================================
// Concatenation
// ============================================================================

fn test_string_push_str() {
    let s = "hello" + " world";
    assert_eq!(s, "hello world");
    assert_eq!(s.len(), 11);
}

fn test_string_push_char() {
    let s = "hell" + "o";
    assert_eq!(s, "hello");
}

fn test_string_push_multibyte_char() {
    let s = "α" + "β";  // Greek alpha + beta
    assert_eq!(s.len(), 4);  // 2 + 2 bytes
}

// ============================================================================
// Length / Capacity
// ============================================================================

fn test_string_len_is_byte_count() {
    let s = "αβγ";  // 3 chars, 6 bytes
    assert_eq!(s.len(), 6);
}

fn test_string_is_empty() {
    let empty = "";
    let non_empty = "x";

    assert!(empty.is_empty());
    assert!(!non_empty.is_empty());
}

// ============================================================================
// Conversion
// ============================================================================

fn test_string_as_str() {
    let s = "test";
    assert_eq!(s, "test");
}

fn test_string_as_bytes() {
    let s = "ABC";
    let bytes = s.as_bytes();
    assert_eq!(bytes.len(), 3);
    assert_eq!(bytes[0], 65);  // 'A'
    assert_eq!(bytes[1], 66);  // 'B'
    assert_eq!(bytes[2], 67);  // 'C'
}

// ============================================================================
// Reassignment (strings are immutable, use assignment to clear)
// ============================================================================

fn test_string_reassignment() {
    let mut s = "hello world";
    s = "";

    assert!(s.is_empty());
    assert_eq!(s.len(), 0);
}

// ============================================================================
// Concatenation
// ============================================================================

fn test_string_concat() {
    let a = "hello";
    let b = " world";
    let c = a + b;

    assert_eq!(c, "hello world");
}

fn test_string_add_operator() {
    let a = "foo";
    let b = "bar";
    let c = a + b;

    assert_eq!(c, "foobar");
}

// ============================================================================
// Entry Point
// ============================================================================

fn main() {
    // Construction
    test_string_new_is_empty();
    test_string_with_capacity();
    test_string_from_str();

    // Push (concatenation)
    test_string_push_str();
    test_string_push_char();
    test_string_push_multibyte_char();

    // Length
    test_string_len_is_byte_count();
    test_string_is_empty();

    // Conversion
    test_string_as_str();
    test_string_as_bytes();

    // Reassignment (clearing)
    test_string_reassignment();

    // Concatenation
    test_string_concat();
    test_string_add_operator();

    println("All String tests passed!");
}
