// P1_022_rt_io.sg - I/O Specification Tests
//
// These tests define the contract for rt::io module.
// Tests stdout/stderr output and file operations.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md#module-4-io

use crate·rt·io·{print, println, File, FileMode};
use crate·rt·sys·Errno;

// ============================================================================
// Print Functions
// ============================================================================

/// Spec: print() writes to stdout without newline
fn test_print_no_newline() {
    print("hello");
    print(" world");
    println("");  // Newline for output clarity
    // Expected output: "hello world\n"
}

/// Spec: println() writes to stdout with newline
fn test_println_with_newline() {
    println("line 1");
    println("line 2");
    // Expected output: "line 1\nline 2\n"
}

/// Spec: print handles empty string
fn test_print_empty_string() {
    print("");
    println("after empty");
    // Expected: "after empty\n"
}

// ============================================================================
// Integer/Float Printing
// ============================================================================

/// Spec: print_int handles positive integers
fn test_print_int_positive() {
    println_int(42);
    println_int(12345);
    // Expected: "42\n12345\n"
}

/// Spec: print_int handles negative integers
fn test_print_int_negative() {
    println_int(-1);
    println_int(-99999);
    // Expected: "-1\n-99999\n"
}

/// Spec: print_int handles zero
fn test_print_int_zero() {
    println_int(0);
    // Expected: "0\n"
}

/// Spec: print_int handles i64 bounds
fn test_print_int_bounds() {
    println_int(9223372036854775807);   // i64::MAX
    println_int(-9223372036854775808);  // i64::MIN
}

// ============================================================================
// File Operations
// ============================================================================

/// Spec: File::create creates new file
fn test_file_create() {
    let path = "/tmp/sigil_test_create.txt";

    // Create and write
    let result = File·create(path);
    assert!(result.is_ok());

    let mut file = result.unwrap();
    let written = file.write("test content");
    assert!(written.is_ok());
    file.close();

    // Verify by reading back
    let read_result = File·open(path, FileMode·Read);
    assert!(read_result.is_ok());

    println("File create test passed");
}

/// Spec: File::open with Read mode opens existing file
fn test_file_open_read() {
    // Create test file first
    let path = "/tmp/sigil_test_read.txt";
    let mut f = File·create(path).unwrap();
    f.write("hello file");
    f.close();

    // Open for read
    let result = File·open(path, FileMode·Read);
    assert!(result.is_ok());

    let mut file = result.unwrap();
    let mut buf: [u8; 32] = [0; 32];
    let read_result = file.read(&mut buf);
    assert!(read_result.is_ok());

    file.close();
    println("File open read test passed");
}

/// Spec: File::open returns error for non-existent file
fn test_file_open_nonexistent() {
    let result = File·open("/tmp/nonexistent_sigil_file_12345.txt", FileMode·Read);
    assert!(result.is_err());
    assert_eq!(result.unwrap_err(), Errno·ENOENT);

    println("File open nonexistent test passed");
}

/// Spec: File::write writes bytes to file
fn test_file_write() {
    let path = "/tmp/sigil_test_write.txt";
    let mut file = File·create(path).unwrap();

    let result = file.write("first line\n");
    assert!(result.is_ok());
    assert_eq!(result.unwrap(), 11);  // 11 bytes

    let result2 = file.write("second line\n");
    assert!(result2.is_ok());

    file.close();
    println("File write test passed");
}

/// Spec: File::read reads bytes from file
fn test_file_read() {
    // Setup: create file with known content
    let path = "/tmp/sigil_test_read2.txt";
    let mut wf = File·create(path).unwrap();
    wf.write("ABCDEFGH");
    wf.close();

    // Read it back
    let mut rf = File·open(path, FileMode·Read).unwrap();
    let mut buf: [u8; 8] = [0; 8];
    let result = rf.read(&mut buf);

    assert!(result.is_ok());
    assert_eq!(result.unwrap(), 8);
    assert_eq!(buf[0], 65);  // 'A'
    assert_eq!(buf[7], 72);  // 'H'

    rf.close();
    println("File read test passed");
}

// ============================================================================
// Entry Point
// ============================================================================

fn main() {
    // Print tests
    test_print_no_newline();
    test_println_with_newline();
    test_print_empty_string();

    // Integer printing
    test_print_int_positive();
    test_print_int_negative();
    test_print_int_zero();
    test_print_int_bounds();

    // File operations
    test_file_create();
    test_file_open_read();
    test_file_open_nonexistent();
    test_file_write();
    test_file_read();

    println("All I/O tests passed!");
}
