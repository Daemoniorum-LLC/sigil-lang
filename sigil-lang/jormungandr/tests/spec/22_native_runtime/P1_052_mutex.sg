// Test mutex operations
// This tests the native runtime synchronization primitives
// Priority: P1

λ main() {
    // Initialize mutex (simulated as i64 in interpreter)
    ≔ mutex = 0;

    // Initialize
    ≔ init_result = Mutex·init(mutex);
    ⎇ init_result == 0 {
        println("mutex_init: OK");
    } ⎉ {
        println("mutex_init: FAILED");
    }

    // Try to lock
    ≔ trylock_result = Mutex·trylock(mutex);
    ⎇ trylock_result == 0 {
        println("mutex_trylock: OK");
    } ⎉ {
        println("mutex_trylock: FAILED");
    }

    // Lock (should succeed in single-threaded interpreter)
    ≔ lock_result = Mutex·lock(mutex);
    ⎇ lock_result == 0 {
        println("mutex_lock: OK");
    } ⎉ {
        println("mutex_lock: FAILED");
    }

    // Unlock
    ≔ unlock_result = Mutex·unlock(mutex);
    ⎇ unlock_result == 0 {
        println("mutex_unlock: OK");
    } ⎉ {
        println("mutex_unlock: FAILED");
    }
}
