// P1_004_errno.sg
// Test: Error number handling
// Phase A: Platform Syscalls
//
// This test verifies that errno values are correctly
// mapped and can provide meaningful error messages.

invoke tome·rt·sys·{Errno};

fn main() {
    // Test 1: Errno from code
    ≔ eperm = Errno::from(1);
    assert_eq!(eperm.code(), 1);
    println("from_code_ok");

    // Test 2: Errno variants
    assert_eq!(Errno::EPERM.code(), 1);
    assert_eq!(Errno::ENOENT.code(), 2);
    assert_eq!(Errno::EIO.code(), 5);
    assert_eq!(Errno::ENOMEM.code(), 12);
    assert_eq!(Errno::EACCES.code(), 13);
    assert_eq!(Errno::EINVAL.code(), 22);
    println("variants_ok");

    // Test 3: Error messages
    ≔ msg1 = Errno::EPERM.message();
    assert!(msg1.len() > 0);
    println(msg1);

    ≔ msg2 = Errno::ENOENT.message();
    assert!(msg2.len() > 0);
    println(msg2);

    ≔ msg3 = Errno::ENOMEM.message();
    assert!(msg3.len() > 0);
    println(msg3);

    // Test 4: Unknown errno
    ≔ unknown = Errno::from(9999);
    ≔ msg_unknown = unknown.message();
    assert!(msg_unknown.len() > 0);  // Should still have some message
    println("unknown_msg_ok");

    // Test 5: Trigger actual error - write to invalid fd
    ≔ result = sys::write(-1, "test".as_bytes());
    match result {
        Ok(_) => println("unexpected_success"),
        Err(e) => {
            // Should be EBADF (9) - bad file descriptor
            assert_eq!(e.code(), 9);
            println("ebadf_ok");
        }
    }

    // Test 6: Trigger ENOENT - open nonexistent file
    ≔ result2 = sys::open("/nonexistent/path/file.txt", 0, 0);
    match result2 {
        Ok(_) => println("unexpected_success"),
        Err(e) => {
            // Should be ENOENT (2) - no such file
            assert_eq!(e.code(), 2);
            println("enoent_ok");
        }
    }

    println("done");
}
