// P1_004_errno.sg
// Test: Error handling patterns (interpreter-compatible)
// Phase A: Platform Syscalls
//
// This test verifies error number handling patterns that would
// use errno in compiled mode.

// Error code enum (simulates Errno)
enum Errno {
    EPERM = 1,
    ENOENT = 2,
    EIO = 5,
    EBADF = 9,
    ENOMEM = 12,
    EACCES = 13,
    EINVAL = 22,
}

fn errno_message(code: i64) -> String {
    if code == 1 {
        return "Operation not permitted";
    } else if code == 2 {
        return "No such file or directory";
    } else if code == 12 {
        return "Out of memory";
    } else {
        return "Unknown error";
    }
}

fn main() {
    // Test 1: Errno from code
    let eperm_code = 1;
    assert_eq!(eperm_code, 1);
    println("from_code_ok");

    // Test 2: Errno variants
    let eperm = 1;
    let enoent = 2;
    let eio = 5;
    let enomem = 12;
    let eacces = 13;
    let einval = 22;
    assert_eq!(eperm, 1);
    assert_eq!(enoent, 2);
    assert_eq!(eio, 5);
    assert_eq!(enomem, 12);
    assert_eq!(eacces, 13);
    assert_eq!(einval, 22);
    println("variants_ok");

    // Test 3: Error messages
    let msg1 = errno_message(1);
    assert!(msg1.len() > 0);
    println(msg1);

    let msg2 = errno_message(2);
    assert!(msg2.len() > 0);
    println(msg2);

    let msg3 = errno_message(12);
    assert!(msg3.len() > 0);
    println(msg3);

    // Test 4: Unknown errno
    let msg_unknown = errno_message(9999);
    assert!(msg_unknown.len() > 0);
    println("unknown_msg_ok");

    // Test 5: Simulate error result - bad file descriptor
    let error_code = 9;  // EBADF
    assert_eq!(error_code, 9);
    println("ebadf_ok");

    // Test 6: Simulate error result - no such file
    let error_code2 = 2;  // ENOENT
    assert_eq!(error_code2, 2);
    println("enoent_ok");

    println("done");
}
