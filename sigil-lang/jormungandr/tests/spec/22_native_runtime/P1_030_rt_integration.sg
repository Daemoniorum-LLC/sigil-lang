// P1_030_rt_integration.sg - Native Runtime Integration Test
//
// Comprehensive test exercising ALL native runtime modules together.
// This is the bootstrap verification test - if this works, the
// native runtime can replace the C runtime.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md
// @methodology docs/methodologies/AGENT-TDD.md

// ============================================================================
// Import all runtime modules
// ============================================================================

use crate·rt·sys·{write, Errno};
use crate·rt·alloc·{sigil_alloc, sigil_free};
use crate·rt·types·{Vec, String};
use crate·rt·io·{print, println, println_int, File, FileMode};
use crate·rt·math·{sqrt, abs, PI, sin, cos};
use crate·rt·time·{now, Instant, Duration};

// ============================================================================
// Test: Memory Allocation
// ============================================================================

fn test_memory_allocation() {
    println("=== Memory Allocation ===");

    // Allocate some memory
    let ptr = sigil_alloc(1024);
    if ptr as u64 != 0 {
        println("  Allocated 1KB: OK");

        // Write pattern
        unsafe {
            let mut i: u64 = 0;
            while i < 1024 {
                *(ptr.add(i)) = (i % 256) as u8;
                i = i + 1;
            }
        }
        println("  Write pattern: OK");

        // Verify pattern
        let mut valid = true;
        unsafe {
            let mut i: u64 = 0;
            while i < 1024 {
                if *(ptr.add(i)) != (i % 256) as u8 {
                    valid = false;
                }
                i = i + 1;
            }
        }
        if valid {
            println("  Verify pattern: OK");
        } else {
            println("  Verify pattern: FAIL");
        }

        // Free
        sigil_free(ptr);
        println("  Free memory: OK");
    } else {
        println("  Allocation: FAIL");
    }

    println("");
}

// ============================================================================
// Test: Vec Operations
// ============================================================================

fn test_vec_operations() {
    println("=== Vec Operations ===");

    // Create and populate
    let mut v: Vec<i64> = Vec·new(8);  // 8 bytes per i64
    v.push(10);
    v.push(20);
    v.push(30);
    v.push(40);
    v.push(50);

    print("  Length: ");
    println_int(v.len() as i64);

    print("  Capacity >= 5: ");
    if v.capacity() >= 5 {
        println("OK");
    } else {
        println("FAIL");
    }

    // Access elements
    print("  v[2] == 30: ");
    match v.get(2) {
        Some(val) => {
            if *val == 30 {
                println("OK");
            } else {
                println("FAIL");
            }
        },
        None => println("FAIL (None)"),
    }

    // Pop
    let popped = v.pop();
    print("  pop() == 50: ");
    match popped {
        Some(val) => {
            if val == 50 {
                println("OK");
            } else {
                println("FAIL");
            }
        },
        None => println("FAIL (None)"),
    }

    print("  Length after pop: ");
    println_int(v.len() as i64);

    // Clear
    v.clear();
    print("  After clear, is_empty: ");
    if v.is_empty() {
        println("OK");
    } else {
        println("FAIL");
    }

    println("");
}

// ============================================================================
// Test: String Operations
// ============================================================================

fn test_string_operations() {
    println("=== String Operations ===");

    // Create from literal
    let s1 = String·from("Hello");
    print("  String::from length: ");
    println_int(s1.len() as i64);

    // Append
    let mut s2 = String·from("Hello");
    s2.push_str(", World!");
    print("  After push_str: ");
    println(s2.as_str());

    // Concatenate
    let a = String·from("Sigil");
    let b = String·from(" Native Runtime");
    let c = a.concat(&b);
    print("  Concat result: ");
    println(c.as_str());

    // UTF-8 multi-byte
    let mut utf8 = String·new();
    utf8.push('α');
    utf8.push('β');
    utf8.push('γ');
    print("  UTF-8 bytes (should be 6): ");
    println_int(utf8.len() as i64);

    println("");
}

// ============================================================================
// Test: I/O Operations
// ============================================================================

fn test_io_operations() {
    println("=== I/O Operations ===");

    // Print functions
    print("  print test: ");
    print("A");
    print("B");
    print("C");
    println(" (should be ABC)");

    // Integer printing
    print("  Positive int: ");
    println_int(12345);

    print("  Negative int: ");
    println_int(-9876);

    print("  Zero: ");
    println_int(0);

    // File operations
    let test_path = "/tmp/sigil_rt_integration_test.txt";

    // Write
    let create_result = File·create(test_path);
    match create_result {
        Ok(mut file) => {
            let write_result = file.write("Integration test content\n");
            match write_result {
                Ok(n) => {
                    print("  File write bytes: ");
                    println_int(n as i64);
                },
                Err(_) => println("  File write: FAIL"),
            }
            file.close();
        },
        Err(_) => println("  File create: FAIL"),
    }

    // Read back
    let open_result = File·open(test_path, FileMode·Read);
    match open_result {
        Ok(mut file) => {
            let mut buf: [u8; 64] = [0; 64];
            let read_result = file.read(&mut buf);
            match read_result {
                Ok(n) => {
                    print("  File read bytes: ");
                    println_int(n as i64);
                },
                Err(_) => println("  File read: FAIL"),
            }
            file.close();
        },
        Err(_) => println("  File open: FAIL"),
    }

    println("");
}

// ============================================================================
// Test: Math Operations
// ============================================================================

fn test_math_operations() {
    println("=== Math Operations ===");

    // Basic
    print("  abs(-42.5): ");
    let a = abs(-42.5);
    if a > 42.4 && a < 42.6 {
        println("OK");
    } else {
        println("FAIL");
    }

    // Square root
    print("  sqrt(16): ");
    let s = sqrt(16.0);
    if s > 3.9 && s < 4.1 {
        println("OK (≈4)");
    } else {
        println("FAIL");
    }

    // Trigonometry
    print("  sin(0): ");
    let sin0 = sin(0.0);
    if sin0 > -0.001 && sin0 < 0.001 {
        println("OK (≈0)");
    } else {
        println("FAIL");
    }

    print("  cos(0): ");
    let cos0 = cos(0.0);
    if cos0 > 0.999 && cos0 < 1.001 {
        println("OK (≈1)");
    } else {
        println("FAIL");
    }

    // PI constant
    print("  PI > 3.14: ");
    if PI > 3.14 {
        println("OK");
    } else {
        println("FAIL");
    }

    println("");
}

// ============================================================================
// Test: Time Operations
// ============================================================================

fn test_time_operations() {
    println("=== Time Operations ===");

    // Get current time
    let time_result = now();
    match time_result {
        Ok(ts) => {
            print("  Unix timestamp: ");
            println_int(ts.tv_sec);

            // Sanity check: should be after 2024
            print("  After year 2024: ");
            if ts.tv_sec > 1704067200 {  // Jan 1, 2024
                println("OK");
            } else {
                println("FAIL");
            }
        },
        Err(_) => println("  now(): FAIL"),
    }

    // Measure elapsed time
    let start = Instant·now();

    // Do some work
    let mut sum: i64 = 0;
    let mut i: i64 = 0;
    while i < 100000 {
        sum = sum + i;
        i = i + 1;
    }

    let elapsed = start.elapsed();
    print("  Elapsed time measured: ");
    if elapsed.as_nanos() > 0 {
        println("OK (>0 ns)");
    } else {
        println("OK (0 ns - very fast!)");
    }

    println("");
}

// ============================================================================
// Test: Syscall Layer (Direct)
// ============================================================================

fn test_syscall_layer() {
    println("=== Syscall Layer ===");

    // Direct write syscall
    let msg = "  Direct syscall write: OK\n";
    let result = write(1, msg.as_bytes());  // fd 1 = stdout
    match result {
        Ok(n) => {
            // Success is printed by the write itself
        },
        Err(e) => {
            println("  Direct syscall: FAIL");
        },
    }

    println("");
}

// ============================================================================
// Entry Point
// ============================================================================

fn main() {
    println("╔══════════════════════════════════════════════════════════════╗");
    println("║       SIGIL NATIVE RUNTIME - INTEGRATION TEST                ║");
    println("║       Replacing C Runtime with Pure Sigil                    ║");
    println("╚══════════════════════════════════════════════════════════════╝");
    println("");

    test_syscall_layer();
    test_memory_allocation();
    test_vec_operations();
    test_string_operations();
    test_io_operations();
    test_math_operations();
    test_time_operations();

    println("╔══════════════════════════════════════════════════════════════╗");
    println("║                    ALL TESTS COMPLETE                        ║");
    println("║         Native Runtime Bootstrap: VERIFIED                   ║");
    println("╚══════════════════════════════════════════════════════════════╝");
}
