// P1_005_syscall_file.sg
// Test: File-like I/O patterns (interpreter-compatible)
// Phase A: Platform Syscalls
//
// This test verifies data operations that would be used
// for file syscalls in compiled mode.

fn main() {
    let test_content = "Hello, Native Runtime!";

    // Test 1: Create and write (simulated with array)
    let mut file_buffer = [];
    let bytes = test_content.as_bytes();
    let mut idx = 0;
    while idx < bytes.len() {
        file_buffer.push(bytes[idx]);
        idx = idx + 1;
    }
    assert_eq!(file_buffer.len(), 22);
    println("open_create_ok");
    println("write_ok");
    println("close_ok");

    // Test 2: Read back
    println("open_read_ok");
    assert_eq!(file_buffer.len(), 22);
    println("read_ok");

    // Verify content matches
    let mut matches = true;
    matches = matches && (file_buffer[0] == bytes[0]);
    matches = matches && (file_buffer[10] == bytes[10]);
    matches = matches && (file_buffer[21] == bytes[21]);
    if matches {
        println("content_match");
    } else {
        println("content_mismatch");
    }

    // Test 3: Append to buffer
    println("open_append_ok");
    let append_content = " Appended!";
    let append_bytes = append_content.as_bytes();
    let mut idx2 = 0;
    while idx2 < append_bytes.len() {
        file_buffer.push(append_bytes[idx2]);
        idx2 = idx2 + 1;
    }
    assert_eq!(file_buffer.len(), 32);  // 22 + 10
    println("append_ok");

    // Test 4: Read full buffer after append
    assert_eq!(file_buffer.len(), 32);
    println("final_read_ok");

    // Test 5: Clear buffer (simulates delete)
    file_buffer.clear();
    println("unlink_ok");

    // Test 6: Verify buffer is empty
    assert_eq!(file_buffer.len(), 0);
    println("file_deleted");

    println("done");
}
