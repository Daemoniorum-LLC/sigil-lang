// P1_006_arena_alloc.sg
// Test: Arena allocation patterns (interpreter-compatible)
// Phase B: Memory Allocator
//
// This test verifies sequential memory allocation patterns
// using interpreter arrays.

λ main() {
    // Test 1: Create arena and allocate (using array)
    ≔ Δ arena = [];
    ≔ Δ i = 0;
    ⟳ i < 100 {
        arena.push(0);
        i = i + 1;
    }
    assert_eq!(arena.len(), 100);
    println("alloc_100_ok");

    // Test 2: Allocate more
    ≔ Δ j = 0;
    ⟳ j < 200 {
        arena.push(0);
        j = j + 1;
    }
    assert_eq!(arena.len(), 300);
    println("alloc_200_ok");

    // Test 3: Sequential check
    assert!(arena.len() >= 300);
    println("sequential_ok");

    // Test 4: Alignment (all indices divisible by 8 work correctly)
    arena[0] = 42;
    arena[8] = 43;
    arena[16] = 44;
    assert_eq!(arena[0], 42);
    assert_eq!(arena[8], 43);
    println("alignment_ok");

    // Test 5: Write and read patterns
    ≔ Δ k = 0;
    ⟳ k < 100 {
        arena[k] = k;
        k = k + 1;
    }
    ≔ Δ write_ok = true;
    ≔ Δ m = 0;
    ⟳ m < 100 {
        ⎇ arena[m] != m {
            write_ok = false;
        }
        m = m + 1;
    }
    ⎇ write_ok {
        println("write_read_ok");
    } ⎉ {
        println("write_read_fail");
    }

    // Test 6: Allocate zeroed (all zeros)
    ≔ Δ zeroed = [];
    ≔ Δ n = 0;
    ⟳ n < 64 {
        zeroed.push(0);
        n = n + 1;
    }
    ≔ Δ zeroed_ok = true;
    ≔ Δ p = 0;
    ⟳ p < 64 {
        ⎇ zeroed[p] != 0 {
            zeroed_ok = false;
        }
        p = p + 1;
    }
    ⎇ zeroed_ok {
        println("alloc_zeroed_ok");
    } ⎉ {
        println("alloc_zeroed_fail");
    }

    // Test 7: Reset (clear and reuse)
    arena.clear();
    ≔ Δ q = 0;
    ⟳ q < 8 {
        arena.push(0);
        q = q + 1;
    }
    assert_eq!(arena.len(), 8);
    println("reset_ok");

    // Test 8: Large allocation
    ≔ Δ large = [];
    ≔ Δ r = 0;
    ⟳ r < 2048 {
        large.push(r);
        r = r + 1;
    }
    assert_eq!(large.len(), 2048);
    println("large_alloc_ok");

    // Test 9: Many small allocations
    ≔ Δ all_valid = true;
    ≔ Δ small = [];
    ≔ Δ s = 0;
    ⟳ s < 1000 {
        small.push(s);
        ⎇ small.len() != s + 1 {
            all_valid = false;
        }
        s = s + 1;
    }
    ⎇ all_valid {
        println("many_allocs_ok");
    } ⎉ {
        println("many_allocs_fail");
    }

    println("done");
}
