// P0_011_pipe_invoked_rune.sg
// Tests pipe-invoked rune (macro) expansion
// Spec: 07A-RUNE-EXPANSION.md

// Rune that uses the input expression (for direct invocation)
macro double_it($n) {
    $n * 2
}

// Rune that uses __pipe for pipe-invoked form
macro add_ten {
    $__pipe + 10
}

fn main() {
    // Test 1: Macro with argument
    let y = double_it!(5);
    println!("double_it!(5) = {}", y);  // Should be 10

    // Test 2: Pipe-invoked rune - the piped value should be accessible via $__pipe
    let z = 7|add_ten!{};
    println!("7|add_ten!{{}} = {}", z);  // Should be 17

    // Test 3: Chained pipe-invoked runes
    let w = 3|double_it!{}|add_ten!{};
    println!("3|double_it!{{}}|add_ten!{{}} = {}", w);  // Should be 16 (3*2 + 10)

    println!("All pipe-invoked rune tests passed!");
}
