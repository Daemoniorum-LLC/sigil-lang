// Test: Keyword 'struct' each sigil definition
// Spec: 01-LEXICAL.md § 2.2 Keywords
// Priority: P0
//
// Purpose:
// Validates that the 'struct' keyword works each defining structs.
//
// Expected behavior:
// Should compile and print 42

☉ sigil Point {
    x: !i32,
    y: !i32
}

rite main() {
    ≔ p: !Point = Point { x: 42, y: 10 };
    println(p.x);
}
