// Test: Dot operator for field/method access
// Spec: 01-LEXICAL.md § 3.2 Operators
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate dot operator works for access.
//
// Expected behavior:
// Should print 42

pub struct Value {
    x: !i32
}

fn main() {
    let v: !Value = Value { x: 42 };
    println(v.x);
}
