// Test: Multi-line comment
// Spec: 01-LEXICAL.md § 4.2 Multi-line Comments
// Priority: P0 - Bootstrap Critical
//
// Purpose:
// Validate multi-line comments are ignored.
//
// Expected behavior:
// Should print 42

λ main() {
    /*
    This is a multi-line
    comment
    */
    ≔ x: !i32 = 42;
    println(x);
}
