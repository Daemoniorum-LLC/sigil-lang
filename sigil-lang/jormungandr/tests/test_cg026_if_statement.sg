/// Test CG-026: Comparison operators crash the native compiler
///
/// The native compiler crashes with SIGSEGV when compiling files that
/// contain comparison operators (==, !=, <, <=, >, >=).
///
/// Working: if true { 42 } else { 0 }
/// Working: let r = 42; r + 1
/// CRASHES: let r = 42; r == 42
/// CRASHES: if r != 42 { 1 } else { 0 }
///
/// This blocks CG-025 testing since the CG-025 test uses comparison operators.

fn main() -> i64 {
    // This simple comparison crashes:
    let r = 42;
    let b = r == 42;  // <-- Crash happens here
    if b { 0 } else { 1 }
}
