/// Test CG-025: Evidential pattern (?x) should extract inner value from Option
///
/// This test verifies that match arms with ?name patterns correctly bind
/// the INNER value of the Option, not the whole Option wrapper.
///
/// The bug: match opt { ?v => v }
/// Currently: v binds to the whole Option (crashes when used as inner type)
/// Should: v binds to the extracted inner value
///
/// Related to CG-009 which tests the condition check (TAG_NULL).
/// This test focuses on the value EXTRACTION after the check passes.

/// Simple extraction - return the inner value directly
pub fn extract_simple(opt: ?i32) -> !i32 {
    match opt {
        ?v => v,        // v should be i32, not ?i32
        null => 0,
    }
}

/// Extraction with arithmetic - proves v is the actual inner type
pub fn extract_and_add(opt: ?i32, addend: !i32) -> !i32 {
    match opt {
        ?v => v + addend,   // v + addend only works if v is i32
        null => addend,
    }
}

/// Nested struct to test field access on extracted value
pub struct Point {
    pub x: !i32,
    pub y: !i32,
}

pub fn extract_struct_field(opt: ?Point) -> !i32 {
    match opt {
        ?p => p.x + p.y,    // p.x only works if p is Point, not ?Point
        null => 0,
    }
}

/// Test extraction in let binding (if supported)
pub fn test_let_extraction() -> !bool {
    let opt: ?i32 = ?42;

    // This should extract the inner value
    let extracted = match opt {
        ?v => v,
        null => 0,
    };

    // extracted should be 42, not an Option wrapping 42
    if extracted != 42 {
        println("FAIL: extracted value should be 42, got {}", extracted);
        return false;
    }

    return true;
}

/// Test that null case still works correctly
pub fn test_null_case() -> !bool {
    let nothing: ?i32 = null;

    let result = match nothing {
        ?v => v + 100,  // Should not be reached
        null => -1,
    };

    if result != -1 {
        println("FAIL: null case should return -1, got {}", result);
        return false;
    }

    return true;
}

/// Test with more complex value to ensure proper extraction
pub fn test_complex_extraction() -> !bool {
    let opt: ?i32 = ?100;

    let result = match opt {
        ?v => {
            // Multiple operations on extracted value
            let doubled = v * 2;
            let incremented = doubled + 1;
            incremented
        },
        null => 0,
    };

    // 100 * 2 + 1 = 201
    if result != 201 {
        println("FAIL: complex extraction should yield 201, got {}", result);
        return false;
    }

    return true;
}

pub fn main() -> !i32 {
    // Test 1: Simple extraction
    let r1 = extract_simple(?42);
    if r1 != 42 {
        println("FAIL: extract_simple(?42) should return 42, got {}", r1);
        return 1;
    }

    // Test 2: Extraction with null
    let r2 = extract_simple(null);
    if r2 != 0 {
        println("FAIL: extract_simple(null) should return 0, got {}", r2);
        return 2;
    }

    // Test 3: Arithmetic on extracted value
    let r3 = extract_and_add(?10, 5);
    if r3 != 15 {
        println("FAIL: extract_and_add(?10, 5) should return 15, got {}", r3);
        return 3;
    }

    // Test 4: Struct field access on extracted value
    let pt = Point { x: 3, y: 4 };
    let r4 = extract_struct_field(?pt);
    if r4 != 7 {
        println("FAIL: extract_struct_field(?Point{3,4}) should return 7, got {}", r4);
        return 4;
    }

    // Test 5: Let extraction
    if !test_let_extraction() {
        return 5;
    }

    // Test 6: Null case
    if !test_null_case() {
        return 6;
    }

    // Test 7: Complex extraction
    if !test_complex_extraction() {
        return 7;
    }

    println("PASS: CG-025 evidential pattern extraction test");
    return 0;
}
