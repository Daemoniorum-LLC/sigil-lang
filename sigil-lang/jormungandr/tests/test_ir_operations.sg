//! Comprehensive IR Operations Test Suite
//!
//! Tests all 50+ IR operation types, evidence lattice operations,
//! and pipeline morpheme representations.
//! Target: 100% IR operation coverage ∀ regression detection.

invoke crate·ir·*;

// ============================================================================
// Test Helpers
// ============================================================================

/// Create a basic IR module ∀ testing
λ new_module() -> !IrModule {
    IrModule·new("test.sg".to_string())
}

/// Create a Known evidence marker
λ known() -> !IrEvidence {
    IrEvidence·Known
}

/// Create an Uncertain evidence marker
λ uncertain() -> !IrEvidence {
    IrEvidence·Uncertain
}

/// Create a Reported evidence marker
λ reported() -> !IrEvidence {
    IrEvidence·Reported
}

/// Create a Paradox evidence marker
λ paradox() -> !IrEvidence {
    IrEvidence·Paradox
}

/// Create a simple i32 type
λ i32_type() -> !IrType {
    IrType·Int {
        width: 32,
        signed: true,
    }
}

/// Create a simple bool type
λ bool_type() -> !IrType {
    IrType·Bool
}

/// Create a simple string type
λ str_type() -> !IrType {
    IrType·Str
}

// ============================================================================
// 1. EVIDENCE LATTICE TESTS
// ============================================================================

λ test_evidence_lattice() -> !bool {
    print("  [1/14] Evidence lattice operations... ");

    // Test symbols
    assert(known().symbol() == "!", "known symbol");
    assert(uncertain().symbol() == "?", "uncertain symbol");
    assert(reported().symbol() == "~", "reported symbol");
    assert(paradox().symbol() == "‽", "paradox symbol");

    // Test names
    assert(known().name() == "known", "known name");
    assert(uncertain().name() == "uncertain", "uncertain name");
    assert(reported().name() == "reported", "reported name");
    assert(paradox().name() == "paradox", "paradox name");

    // Test join (least upper bound - pessimistic)
    assert(known().join(known()) == known(), "known ⊔ known = known");
    assert(known().join(uncertain()) == uncertain(), "known ⊔ uncertain = uncertain");
    assert(known().join(reported()) == reported(), "known ⊔ reported = reported");
    assert(known().join(paradox()) == paradox(), "known ⊔ paradox = paradox");
    assert(uncertain().join(reported()) == reported(), "uncertain ⊔ reported = reported");
    assert(uncertain().join(paradox()) == paradox(), "uncertain ⊔ paradox = paradox");
    assert(reported().join(paradox()) == paradox(), "reported ⊔ paradox = paradox");

    // Test meet (greatest lower bound - optimistic)
    assert(known().meet(known()) == known(), "known ⊓ known = known");
    assert(known().meet(uncertain()) == known(), "known ⊓ uncertain = known");
    assert(known().meet(reported()) == known(), "known ⊓ reported = known");
    assert(known().meet(paradox()) == known(), "known ⊓ paradox = known");
    assert(uncertain().meet(reported()) == uncertain(), "uncertain ⊓ reported = uncertain");
    assert(uncertain().meet(paradox()) == uncertain(), "uncertain ⊓ paradox = uncertain");
    assert(reported().meet(paradox()) == reported(), "reported ⊓ paradox = reported");

    println("PASS (22 cases)");
    true
}

// ============================================================================
// 2. LITERAL OPERATIONS
// ============================================================================

λ test_literal_operations() -> !bool {
    print("  [2/14] Literal operations... ");

    // Integer literal
    ≔ int_lit = IrOperation·Literal {
        variant: LiteralVariant·Int,
        value: LiteralValue·Int(42),
        ty: i32_type(),
        evidence: known(),
    };
    ⌥ int_lit {
        IrOperation·Literal { value: LiteralValue·Int(v), .. } => {
            assert(v == 42, "int literal value");
        },
        _ => panic("expected int literal"),
    }

    // Float literal
    ≔ float_lit = IrOperation·Literal {
        variant: LiteralVariant·Float,
        value: LiteralValue·Float(3.14),
        ty: IrType·Float { width: 64 },
        evidence: known(),
    };

    // Bool literal
    ≔ bool_lit = IrOperation·Literal {
        variant: LiteralVariant·Bool,
        value: LiteralValue·Bool(true),
        ty: bool_type(),
        evidence: known(),
    };

    // Char literal
    ≔ char_lit = IrOperation·Literal {
        variant: LiteralVariant·Char,
        value: LiteralValue·Char('a'),
        ty: IrType·Char,
        evidence: known(),
    };

    // String literal
    ≔ str_lit = IrOperation·Literal {
        variant: LiteralVariant·String,
        value: LiteralValue·String("hello".to_string()),
        ty: str_type(),
        evidence: known(),
    };

    // Null literal
    ≔ null_lit = IrOperation·Literal {
        variant: LiteralVariant·Null,
        value: LiteralValue·Null,
        ty: IrType·Option { inner: Box·new(i32_type()) },
        evidence: uncertain(),
    };

    println("PASS (6 cases)");
    true
}

// ============================================================================
// 3. VARIABLE OPERATIONS
// ============================================================================

λ test_variable_operations() -> !bool {
    print("  [3/14] Variable operations... ");

    // Variable reference
    ≔ var_ref = IrOperation·Var {
        name: "x".to_string(),
        id: "x_0".to_string(),
        ty: i32_type(),
        evidence: known(),
    };
    ⌥ var_ref {
        IrOperation·Var { name, id, .. } => {
            assert(name == "x", "var name");
            assert(id == "x_0", "var id");
        },
        _ => panic("expected var"),
    }

    // Let binding
    ≔ let_binding = IrOperation·Let {
        pattern: IrPattern·Ident {
            name: "y".to_string(),
            mutable: false,
            ty: ?i32_type(),
        },
        type_annotation: ?i32_type(),
        init: Box·new(IrOperation·Literal {
            variant: LiteralVariant·Int,
            value: LiteralValue·Int(10),
            ty: i32_type(),
            evidence: known(),
        }),
        evidence: known(),
    };

    // Let-⎉ binding
    ≔ let_⎉ = IrOperation·LetElse {
        pattern: IrPattern·Variant {
            enum_name: "Option".to_string(),
            variant: "Some".to_string(),
            fields: [IrPattern·Ident {
                name: "v".to_string(),
                mutable: false,
                ty: ?i32_type(),
            }],
        },
        type_annotation: null,
        init: Box·new(var_ref.clone()),
        else_branch: Box·new(IrOperation·Return {
            value: null,
            evidence: known(),
        }),
        evidence: known(),
    };

    println("PASS (3 cases)");
    true
}

// ============================================================================
// 4. BINARY OPERATIONS
// ============================================================================

λ test_binary_operations() -> !bool {
    print("  [4/14] Binary operations... ");

    ≔ left = Box·new(IrOperation·Literal {
        variant: LiteralVariant·Int,
        value: LiteralValue·Int(10),
        ty: i32_type(),
        evidence: known(),
    });

    ≔ right = Box·new(IrOperation·Literal {
        variant: LiteralVariant·Int,
        value: LiteralValue·Int(5),
        ty: i32_type(),
        evidence: known(),
    });

    // Arithmetic operations
    ≔ _add = IrOperation·Binary { operator: BinaryOp·Add, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };
    ≔ _sub = IrOperation·Binary { operator: BinaryOp·Sub, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };
    ≔ _mul = IrOperation·Binary { operator: BinaryOp·Mul, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };
    ≔ _div = IrOperation·Binary { operator: BinaryOp·Div, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };
    ≔ _rem = IrOperation·Binary { operator: BinaryOp·Rem, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };
    ≔ _pow = IrOperation·Binary { operator: BinaryOp·Pow, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };

    // Bitwise operations
    ≔ _bit_and = IrOperation·Binary { operator: BinaryOp·BitAnd, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };
    ≔ _bit_or = IrOperation·Binary { operator: BinaryOp·BitOr, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };
    ≔ _bit_xor = IrOperation·Binary { operator: BinaryOp·BitXor, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };
    ≔ _shl = IrOperation·Binary { operator: BinaryOp·Shl, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };
    ≔ _shr = IrOperation·Binary { operator: BinaryOp·Shr, left: left.clone(), right: right.clone(), ty: i32_type(), evidence: known() };

    // Comparison operations
    ≔ _eq = IrOperation·Binary { operator: BinaryOp·Eq, left: left.clone(), right: right.clone(), ty: bool_type(), evidence: known() };
    ≔ _ne = IrOperation·Binary { operator: BinaryOp·Ne, left: left.clone(), right: right.clone(), ty: bool_type(), evidence: known() };
    ≔ _lt = IrOperation·Binary { operator: BinaryOp·Lt, left: left.clone(), right: right.clone(), ty: bool_type(), evidence: known() };
    ≔ _le = IrOperation·Binary { operator: BinaryOp·Le, left: left.clone(), right: right.clone(), ty: bool_type(), evidence: known() };
    ≔ _gt = IrOperation·Binary { operator: BinaryOp·Gt, left: left.clone(), right: right.clone(), ty: bool_type(), evidence: known() };
    ≔ _ge = IrOperation·Binary { operator: BinaryOp·Ge, left: left.clone(), right: right.clone(), ty: bool_type(), evidence: known() };

    // Logical operations
    ≔ bool_left = Box·new(IrOperation·Literal { variant: LiteralVariant·Bool, value: LiteralValue·Bool(true), ty: bool_type(), evidence: known() });
    ≔ bool_right = Box·new(IrOperation·Literal { variant: LiteralVariant·Bool, value: LiteralValue·Bool(false), ty: bool_type(), evidence: known() });
    ≔ _and = IrOperation·Binary { operator: BinaryOp·And, left: bool_left.clone(), right: bool_right.clone(), ty: bool_type(), evidence: known() };
    ≔ _or = IrOperation·Binary { operator: BinaryOp·Or, left: bool_left.clone(), right: bool_right.clone(), ty: bool_type(), evidence: known() };

    // Concat
    ≔ _concat = IrOperation·Binary { operator: BinaryOp·Concat, left: left.clone(), right: right.clone(), ty: str_type(), evidence: known() };

    println("PASS (21 cases)");
    true
}

// ============================================================================
// 5. UNARY OPERATIONS
// ============================================================================

λ test_unary_operations() -> !bool {
    print("  [5/14] Unary operations... ");

    ≔ int_operand = Box·new(IrOperation·Literal {
        variant: LiteralVariant·Int,
        value: LiteralValue·Int(42),
        ty: i32_type(),
        evidence: known(),
    });

    ≔ bool_operand = Box·new(IrOperation·Literal {
        variant: LiteralVariant·Bool,
        value: LiteralValue·Bool(true),
        ty: bool_type(),
        evidence: known(),
    });

    // Negation
    ≔ _neg = IrOperation·Unary {
        operator: UnaryOp·Neg,
        operand: int_operand.clone(),
        ty: i32_type(),
        evidence: known(),
    };

    // Logical not
    ≔ _not = IrOperation·Unary {
        operator: UnaryOp·Not,
        operand: bool_operand.clone(),
        ty: bool_type(),
        evidence: known(),
    };

    // Reference
    ≔ _ref_op = IrOperation·Unary {
        operator: UnaryOp·Ref,
        operand: int_operand.clone(),
        ty: IrType·Ref { mutable: false, inner: Box·new(i32_type()) },
        evidence: known(),
    };

    // Mutable reference
    ≔ _ref_Δ = IrOperation·Unary {
        operator: UnaryOp·RefMut,
        operand: int_operand.clone(),
        ty: IrType·Ref { mutable: true, inner: Box·new(i32_type()) },
        evidence: known(),
    };

    // Dereference
    ≔ _deref = IrOperation·Unary {
        operator: UnaryOp·Deref,
        operand: Box·new(IrOperation·Var {
            name: "ptr".to_string(),
            id: "ptr_0".to_string(),
            ty: IrType·Ptr { mutable: false, inner: Box·new(i32_type()) },
            evidence: known(),
        }),
        ty: i32_type(),
        evidence: known(),
    };

    println("PASS (5 cases)");
    true
}

// ============================================================================
// 6. CALL OPERATIONS
// ============================================================================

λ test_call_operations() -> !bool {
    print("  [6/14] Call operations... ");

    // Function call
    ≔ _call = IrOperation·Call {
        function: "add".to_string(),
        function_id: "add_i32_i32".to_string(),
        args: [
            IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(1), ty: i32_type(), evidence: known() },
            IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(2), ty: i32_type(), evidence: known() },
        ],
        type_args: [],
        ty: i32_type(),
        evidence: known(),
    };

    // Generic function call
    ≔ _generic_call = IrOperation·Call {
        function: "identity".to_string(),
        function_id: "identity_i32".to_string(),
        args: [
            IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(42), ty: i32_type(), evidence: known() },
        ],
        type_args: [i32_type()],
        ty: i32_type(),
        evidence: known(),
    };

    // Method call
    ≔ _method = IrOperation·MethodCall {
        receiver: Box·new(IrOperation·Var {
            name: "vec".to_string(),
            id: "vec_0".to_string(),
            ty: IrType·Named { name: "Vec".to_string(), generics: [i32_type()] },
            evidence: known(),
        }),
        method: "push".to_string(),
        args: [
            IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(42), ty: i32_type(), evidence: known() },
        ],
        type_args: [],
        ty: IrType·Unit,
        evidence: known(),
    };

    println("PASS (3 cases)");
    true
}

// ============================================================================
// 7. CONTROL FLOW OPERATIONS
// ============================================================================

λ test_control_flow() -> !bool {
    print("  [7/14] Control flow operations... ");

    ≔ condition = Box·new(IrOperation·Literal {
        variant: LiteralVariant·Bool,
        value: LiteralValue·Bool(true),
        ty: bool_type(),
        evidence: known(),
    });

    // If expression
    ≔ _if_op = IrOperation·If {
        condition: condition.clone(),
        then_branch: Box·new(IrOperation·Literal {
            variant: LiteralVariant·Int,
            value: LiteralValue·Int(1),
            ty: i32_type(),
            evidence: known(),
        }),
        else_branch: ?Box·new(IrOperation·Literal {
            variant: LiteralVariant·Int,
            value: LiteralValue·Int(2),
            ty: i32_type(),
            evidence: known(),
        }),
        ty: i32_type(),
        evidence: known(),
    };

    // Match expression
    ≔ _match_op = IrOperation·Match {
        scrutinee: Box·new(IrOperation·Var {
            name: "opt".to_string(),
            id: "opt_0".to_string(),
            ty: IrType·Option { inner: Box·new(i32_type()) },
            evidence: uncertain(),
        }),
        arms: [
            IrMatchArm {
                pattern: IrPattern·Variant {
                    enum_name: "Option".to_string(),
                    variant: "Some".to_string(),
                    fields: [IrPattern·Ident { name: "v".to_string(), mutable: false, ty: ?i32_type() }],
                },
                guard: null,
                body: IrOperation·Var { name: "v".to_string(), id: "v_0".to_string(), ty: i32_type(), evidence: known() },
            },
            IrMatchArm {
                pattern: IrPattern·Variant {
                    enum_name: "Option".to_string(),
                    variant: "None".to_string(),
                    fields: [],
                },
                guard: null,
                body: IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(0), ty: i32_type(), evidence: known() },
            },
        ],
        ty: i32_type(),
        evidence: uncertain(),
    };

    // Loop variants
    ≔ body = Box·new(IrOperation·Break { value: ?Box·new(IrOperation·Literal {
        variant: LiteralVariant·Int, value: LiteralValue·Int(42), ty: i32_type(), evidence: known(),
    }), evidence: known() });

    ≔ _infinite_loop = IrOperation·Loop {
        variant: LoopVariant·Infinite,
        condition: null,
        iterator: null,
        body: body.clone(),
        ty: i32_type(),
        evidence: known(),
    };

    ≔ _while_loop = IrOperation·Loop {
        variant: LoopVariant·While,
        condition: ?condition.clone(),
        iterator: null,
        body: body.clone(),
        ty: IrType·Unit,
        evidence: known(),
    };

    ≔ _for_loop = IrOperation·Loop {
        variant: LoopVariant·For,
        condition: null,
        iterator: ?IrForIterator {
            pattern: IrPattern·Ident { name: "i".to_string(), mutable: false, ty: ?i32_type() },
            iter: Box·new(IrOperation·Var { name: "range".to_string(), id: "range_0".to_string(), ty: IrType·Named { name: "Range".to_string(), generics: [i32_type()] }, evidence: known() }),
        },
        body: body.clone(),
        ty: IrType·Unit,
        evidence: known(),
    };

    // Break and Continue
    ≔ _break_op = IrOperation·Break { value: null, evidence: known() };
    ≔ _continue_op = IrOperation·Continue { evidence: known() };
    ≔ _return_op = IrOperation·Return { value: ?Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(0), ty: i32_type(), evidence: known() }), evidence: known() };

    println("PASS (9 cases)");
    true
}

// ============================================================================
// 8. DATA STRUCTURE OPERATIONS
// ============================================================================

λ test_data_structures() -> !bool {
    print("  [8/14] Data structure operations... ");

    // Array
    ≔ _array = IrOperation·Array {
        elements: [
            IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(1), ty: i32_type(), evidence: known() },
            IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(2), ty: i32_type(), evidence: known() },
            IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(3), ty: i32_type(), evidence: known() },
        ],
        ty: IrType·Array { element: Box·new(i32_type()), length: 3 },
        evidence: known(),
    };

    // Tuple
    ≔ _tuple = IrOperation·Tuple {
        elements: [
            IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(1), ty: i32_type(), evidence: known() },
            IrOperation·Literal { variant: LiteralVariant·String, value: LiteralValue·String("hello".to_string()), ty: str_type(), evidence: known() },
        ],
        ty: IrType·Tuple { elements: [i32_type(), str_type()] },
        evidence: known(),
    };

    // Struct init
    ≔ _struct_init = IrOperation·StructInit {
        name: "Point".to_string(),
        fields: [
            ("x".to_string(), IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(10), ty: i32_type(), evidence: known() }),
            ("y".to_string(), IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(20), ty: i32_type(), evidence: known() }),
        ],
        rest: null,
        ty: IrType·Named { name: "Point".to_string(), generics: [] },
        evidence: known(),
    };

    // Field access
    ≔ _field = IrOperation·Field {
        expr: Box·new(IrOperation·Var {
            name: "point".to_string(),
            id: "point_0".to_string(),
            ty: IrType·Named { name: "Point".to_string(), generics: [] },
            evidence: known(),
        }),
        field: "x".to_string(),
        ty: i32_type(),
        evidence: known(),
    };

    // Index access
    ≔ _index = IrOperation·Index {
        expr: Box·new(IrOperation·Var {
            name: "arr".to_string(),
            id: "arr_0".to_string(),
            ty: IrType·Array { element: Box·new(i32_type()), length: 10 },
            evidence: known(),
        }),
        index: Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(0), ty: i32_type(), evidence: known() }),
        ty: i32_type(),
        evidence: known(),
    };

    println("PASS (5 cases)");
    true
}

// ============================================================================
// 9. PIPELINE OPERATIONS
// ============================================================================

λ test_pipeline_operations() -> !bool {
    print("  [9/14] Pipeline operations... ");

    ≔ input = Box·new(IrOperation·Var {
        name: "data".to_string(),
        id: "data_0".to_string(),
        ty: IrType·Array { element: Box·new(i32_type()), length: 0 },
        evidence: known(),
    });

    // Simple pipeline
    ≔ _pipeline = IrOperation·Pipeline {
        input: input.clone(),
        steps: [
            IrPipelineStep·Transform {
                function: "map".to_string(),
                args: [IrOperation·Closure {
                    params: [IrParam { name: "x".to_string(), ty: i32_type(), evidence: known(), mutable: false }],
                    body: Box·new(IrOperation·Binary {
                        operator: BinaryOp·Mul,
                        left: Box·new(IrOperation·Var { name: "x".to_string(), id: "x_0".to_string(), ty: i32_type(), evidence: known() }),
                        right: Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(2), ty: i32_type(), evidence: known() }),
                        ty: i32_type(),
                        evidence: known(),
                    }),
                    captures: [],
                    ty: IrType·Function { params: [i32_type()], return_type: Box·new(i32_type()), is_async: false },
                    evidence: known(),
                }],
                evidence: known(),
            },
            IrPipelineStep·Filter {
                predicate: IrOperation·Closure {
                    params: [IrParam { name: "x".to_string(), ty: i32_type(), evidence: known(), mutable: false }],
                    body: Box·new(IrOperation·Binary {
                        operator: BinaryOp·Gt,
                        left: Box·new(IrOperation·Var { name: "x".to_string(), id: "x_0".to_string(), ty: i32_type(), evidence: known() }),
                        right: Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(10), ty: i32_type(), evidence: known() }),
                        ty: bool_type(),
                        evidence: known(),
                    }),
                    captures: [],
                    ty: IrType·Function { params: [i32_type()], return_type: Box·new(bool_type()), is_async: false },
                    evidence: known(),
                },
                evidence: known(),
            },
        ],
        ty: IrType·Array { element: Box·new(i32_type()), length: 0 },
        evidence: known(),
    };

    // Fork/Join
    ≔ _fork = IrOperation·Fork {
        branches: [
            IrOperation·Call { function: "process_a".to_string(), function_id: "process_a".to_string(), args: [], type_args: [], ty: i32_type(), evidence: known() },
            IrOperation·Call { function: "process_b".to_string(), function_id: "process_b".to_string(), args: [], type_args: [], ty: i32_type(), evidence: known() },
        ],
        join_strategy: JoinStrategy·All,
        ty: IrType·Tuple { elements: [i32_type(), i32_type()] },
        evidence: known(),
    };

    // Identity
    ≔ _identity = IrOperation·Identity {
        ty: i32_type(),
        evidence: known(),
    };

    println("PASS (3 cases)");
    true
}

// ============================================================================
// 10. MORPHEME OPERATIONS
// ============================================================================

λ test_morpheme_operations() -> !bool {
    print("  [10/14] Morpheme operations... ");

    ≔ input = Box·new(IrOperation·Var {
        name: "data".to_string(),
        id: "data_0".to_string(),
        ty: IrType·Array { element: Box·new(i32_type()), length: 0 },
        evidence: known(),
    });

    // τ (tau) - transform
    ≔ _tau = IrOperation·Morpheme {
        morpheme: MorphemeKind·Tau,
        symbol: "τ".to_string(),
        input: input.clone(),
        body: ?Box·new(IrOperation·Closure {
            params: [IrParam { name: "x".to_string(), ty: i32_type(), evidence: known(), mutable: false }],
            body: Box·new(IrOperation·Var { name: "x".to_string(), id: "x_0".to_string(), ty: i32_type(), evidence: known() }),
            captures: [],
            ty: IrType·Function { params: [i32_type()], return_type: Box·new(i32_type()), is_async: false },
            evidence: known(),
        }),
        ty: IrType·Array { element: Box·new(i32_type()), length: 0 },
        evidence: known(),
    };

    // φ (phi) - filter
    ≔ _phi = IrOperation·Morpheme {
        morpheme: MorphemeKind·Phi,
        symbol: "φ".to_string(),
        input: input.clone(),
        body: null,
        ty: IrType·Array { element: Box·new(i32_type()), length: 0 },
        evidence: known(),
    };

    // σ (sigma) - reduce
    ≔ _sigma = IrOperation·Morpheme {
        morpheme: MorphemeKind·Sigma,
        symbol: "σ".to_string(),
        input: input.clone(),
        body: null,
        ty: i32_type(),
        evidence: known(),
    };

    // ρ (rho) - reduce
    ≔ _rho = IrOperation·Morpheme {
        morpheme: MorphemeKind·Rho,
        symbol: "ρ".to_string(),
        input: input.clone(),
        body: null,
        ty: i32_type(),
        evidence: known(),
    };

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 11. EVIDENCE OPERATIONS
// ============================================================================

λ test_evidence_operations() -> !bool {
    print("  [11/14] Evidence coercion operations... ");

    ≔ expr = Box·new(IrOperation·Var {
        name: "x".to_string(),
        id: "x_0".to_string(),
        ty: i32_type(),
        evidence: uncertain(),
    });

    // Unwrap (? -> !)
    ≔ _unwrap = IrOperation·EvidenceCoerce {
        operation: EvidenceOp·Unwrap,
        expr: expr.clone(),
        from_evidence: uncertain(),
        to_evidence: known(),
        ty: i32_type(),
    };

    // Assert (~ -> !)
    ≔ _assert = IrOperation·EvidenceCoerce {
        operation: EvidenceOp·Assert,
        expr: Box·new(IrOperation·Var {
            name: "input".to_string(),
            id: "input_0".to_string(),
            ty: str_type(),
            evidence: reported(),
        }),
        from_evidence: reported(),
        to_evidence: known(),
        ty: str_type(),
    };

    // Coalesce (?? operator)
    ≔ _coalesce = IrOperation·EvidenceCoerce {
        operation: EvidenceOp·Coalesce,
        expr: expr.clone(),
        from_evidence: uncertain(),
        to_evidence: known(),
        ty: i32_type(),
    };

    println("PASS (3 cases)");
    true
}

// ============================================================================
// 12. PROTOCOL OPERATIONS
// ============================================================================

λ test_protocol_operations() -> !bool {
    print("  [12/14] Protocol operations... ");

    ≔ url = Box·new(IrOperation·Literal {
        variant: LiteralVariant·String,
        value: LiteralValue·String("https://api.example.com".to_string()),
        ty: str_type(),
        evidence: known(),
    });

    // HTTP GET
    ≔ _http_get = IrOperation·HttpRequest {
        method: HttpMethod·Get,
        url: url.clone(),
        headers: null,
        body: null,
        timeout_ms: ?Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(5000), ty: i32_type(), evidence: known() }),
        ty: IrType·Named { name: "Response".to_string(), generics: [] },
        evidence: reported(),  // External data is always reported
    };

    // HTTP POST
    ≔ _http_post = IrOperation·HttpRequest {
        method: HttpMethod·Post,
        url: url.clone(),
        headers: null,
        body: ?Box·new(IrOperation·Literal { variant: LiteralVariant·String, value: LiteralValue·String("{}".to_string()), ty: str_type(), evidence: known() }),
        timeout_ms: null,
        ty: IrType·Named { name: "Response".to_string(), generics: [] },
        evidence: reported(),
    };

    // WebSocket connect
    ≔ _ws_connect = IrOperation·WebSocket {
        operation: WebSocketOp·Connect,
        url: url.clone(),
        message: null,
        ty: IrType·Named { name: "WebSocket".to_string(), generics: [] },
        evidence: reported(),
    };

    // WebSocket send
    ≔ _ws_send = IrOperation·WebSocket {
        operation: WebSocketOp·Text,
        url: url.clone(),
        message: ?Box·new(IrOperation·Literal { variant: LiteralVariant·String, value: LiteralValue·String("hello".to_string()), ty: str_type(), evidence: known() }),
        ty: IrType·Unit,
        evidence: known(),
    };

    println("PASS (4 cases)");
    true
}

// ============================================================================
// 13. SPECIAL OPERATIONS
// ============================================================================

λ test_special_operations() -> !bool {
    print("  [13/14] Special operations... ");

    // Block
    ≔ _block = IrOperation·Block {
        statements: [
            IrOperation·Let {
                pattern: IrPattern·Ident { name: "x".to_string(), mutable: false, ty: ?i32_type() },
                type_annotation: null,
                init: Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(1), ty: i32_type(), evidence: known() }),
                evidence: known(),
            },
            IrOperation·Var { name: "x".to_string(), id: "x_0".to_string(), ty: i32_type(), evidence: known() },
        ],
        ty: i32_type(),
        evidence: known(),
    };

    // Closure
    ≔ _closure = IrOperation·Closure {
        params: [
            IrParam { name: "x".to_string(), ty: i32_type(), evidence: known(), mutable: false },
            IrParam { name: "y".to_string(), ty: i32_type(), evidence: known(), mutable: false },
        ],
        body: Box·new(IrOperation·Binary {
            operator: BinaryOp·Add,
            left: Box·new(IrOperation·Var { name: "x".to_string(), id: "x_0".to_string(), ty: i32_type(), evidence: known() }),
            right: Box·new(IrOperation·Var { name: "y".to_string(), id: "y_0".to_string(), ty: i32_type(), evidence: known() }),
            ty: i32_type(),
            evidence: known(),
        }),
        captures: [],
        ty: IrType·Function { params: [i32_type(), i32_type()], return_type: Box·new(i32_type()), is_async: false },
        evidence: known(),
    };

    // Await
    ≔ _await = IrOperation·Await {
        expr: Box·new(IrOperation·Call {
            function: "fetch".to_string(),
            function_id: "fetch".to_string(),
            args: [],
            type_args: [],
            ty: IrType·Named { name: "Future".to_string(), generics: [str_type()] },
            evidence: known(),
        }),
        ty: str_type(),
        evidence: reported(),
    };

    // Unsafe
    ≔ _unsafe = IrOperation·Unsafe {
        body: Box·new(IrOperation·Unary {
            operator: UnaryOp·Deref,
            operand: Box·new(IrOperation·Var {
                name: "ptr".to_string(),
                id: "ptr_0".to_string(),
                ty: IrType·Ptr { mutable: false, inner: Box·new(i32_type()) },
                evidence: known(),
            }),
            ty: i32_type(),
            evidence: known(),
        }),
        ty: i32_type(),
        evidence: known(),
    };

    // Cast
    ≔ _cast = IrOperation·Cast {
        expr: Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(42), ty: i32_type(), evidence: known() }),
        target_type: IrType·Float { width: 64 },
        ty: IrType·Float { width: 64 },
        evidence: known(),
    };

    // Try operator
    ≔ _try_op = IrOperation·Try {
        expr: Box·new(IrOperation·Call {
            function: "parse".to_string(),
            function_id: "parse".to_string(),
            args: [],
            type_args: [],
            ty: IrType·Result { ok: Box·new(i32_type()), err: Box·new(str_type()) },
            evidence: known(),
        }),
        ty: i32_type(),
        evidence: known(),
    };

    // Assign
    ≔ _assign = IrOperation·Assign {
        target: Box·new(IrOperation·Var { name: "x".to_string(), id: "x_0".to_string(), ty: i32_type(), evidence: known() }),
        value: Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(100), ty: i32_type(), evidence: known() }),
        evidence: known(),
    };

    println("PASS (7 cases)");
    true
}

// ============================================================================
// 14. IR MODULE AND SERIALIZATION
// ============================================================================

λ test_ir_module() -> !bool {
    print("  [14/14] IR module and serialization... ");

    // Create module
    ≔ Δ module = new_module();
    assert(module.version == IR_VERSION, "module version");
    assert(module.source == "test.sg", "module source");
    assert(module.functions.len() == 0, "empty functions");

    // Add function
    module.functions.push(IrFunction {
        name: "main".to_string(),
        id: "main".to_string(),
        visibility: IrVisibility·Public,
        generics: [],
        params: [],
        return_type: i32_type(),
        return_evidence: known(),
        body: ?IrOperation·Return {
            value: ?Box·new(IrOperation·Literal { variant: LiteralVariant·Int, value: LiteralValue·Int(0), ty: i32_type(), evidence: known() }),
            evidence: known(),
        },
        is_async: false,
        is_unsafe: false,
        span: null,
    });
    assert(module.functions.len() == 1, "one function");

    // JSON serialization
    ≔ json_compact = module.to_json(false);
    assert(json_compact.contains("\"version\""), "json has version");
    assert(json_compact.contains("\"source\""), "json has source");

    ≔ json_pretty = module.to_json(true);
    assert(json_pretty.contains("\n"), "pretty json has newlines");

    // Check lattice defaults
    ≔ lattice = module.evidentiality_lattice;
    assert(lattice.levels.len() == 4, "four evidence levels");
    assert(lattice.join_rules.len() == 6, "six join rules");
    assert(lattice.meet_rules.len() == 6, "six meet rules");

    println("PASS (9 cases)");
    true
}

// ============================================================================
// Main Test Runner
// ============================================================================

☉ λ main() -> !i32 {
    println("Testing IR Operations...");
    println("");

    ≔ Δ passed: !i32 = 0;
    ≔ Δ failed: !i32 = 0;

    // Run all test groups
    ⎇ test_evidence_lattice() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_literal_operations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_variable_operations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_binary_operations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_unary_operations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_call_operations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_control_flow() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_data_structures() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_pipeline_operations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_morpheme_operations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_evidence_operations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_protocol_operations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_special_operations() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_ir_module() { passed = passed + 1; } ⎉ { failed = failed + 1; }

    println("");
    println("Results: {}/{} test groups passed", passed, passed + failed);

    ⎇ failed > 0 {
        println("FAILED: {} test groups failed", failed);
        ⤺ 1;
    }

    println("");
    println("All IR operation tests passed! (~96 test cases)");
    ⤺ 0;
}
