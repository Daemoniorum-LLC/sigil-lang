        self.line("");

        // Close include guard
        self.line("#endif /* SIGIL_RUNTIME_H */");
        self.line("");

        // Closure captured variable globals - must be outside include guard
        // so each compilation unit has its own copy
        self.line("/* Closure captured variable globals */");
        self.line("static SigilValue __closure_self;");
        self.line("static SigilValue __closure_env;");
        self.line("static SigilValue __closure_ctx;");
