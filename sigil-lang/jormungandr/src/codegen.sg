        self.line("#endif");
        // CG-166: AttrArg variant fallbacks
        self.line("#ifndef ATTRARG_ENUM_ID");
        self.line("#define ATTRARG_ENUM_ID 0xDEAD001CU");
        self.line("#endif");
        self.line("#ifndef ATTRARG_IDENT");
        self.line("#define ATTRARG_IDENT 0xFFFF");
