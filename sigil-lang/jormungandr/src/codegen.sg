        self.line("extern SigilValue sigil_IrModule____new(SigilValue path);");
        self.line("");
        self.line("/* lib.sg - Result type */");
        self.line("typedef SigilValue Result;");
        self.line("typedef SigilValue ParseResult;");
        self.line("extern SigilValue sigil_Result____Ok(SigilValue v);");
        self.line("extern SigilValue sigil_Result____Err(SigilValue v);");
        self.line("extern const SigilValue Result____Ok;");
        self.line("extern const SigilValue Result____Err;");
        self.line("");
        self.line("/* lexer.sg */");
        self.line("extern SigilValue sigil_Lexer____new(SigilValue source);");
        self.line("extern SigilValue sigil_Lexer____next_token(SigilValue* self);");
        self.line("extern SigilValue sigil_Lexer____peek(SigilValue* self);");
        self.line("extern SigilValue sigil_Lexer____current(SigilValue self);");
        self.line("extern SigilValue sigil_Lexer____advance(SigilValue* self);");
