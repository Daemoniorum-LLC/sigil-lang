        self.line("static SigilValue __closure_t;");
        self.line("static SigilValue __closure_mapping;");
        self.line("");
    }

    fn emit_value_constructors(mut self) {
        // Unit
        self.line("static inline SigilValue sigil_unit(void) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_UNIT, .evidence = SIGIL_KNOWN };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Bool
        self.line("static inline SigilValue sigil_bool(bool b) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_BOOL, .evidence = SIGIL_KNOWN, .v.b = b };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Int
        self.line("static inline SigilValue sigil_int(int64_t i) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_INT, .evidence = SIGIL_KNOWN, .v.i = i };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Float
        self.line("static inline SigilValue sigil_float(double f) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_FLOAT, .evidence = SIGIL_KNOWN, .v.f = f };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Char
        self.line("static inline SigilValue sigil_char(char c) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_CHAR, .evidence = SIGIL_KNOWN, .v.c = c };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // String
        self.line("static inline SigilValue sigil_string(const char* s) {");
        self.indent_push();
        self.line("char* copy = strdup(s);");
        self.line("return (SigilValue){ .tag = TAG_STRING, .evidence = SIGIL_KNOWN, .v.s = copy };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Null
        self.line("static inline SigilValue sigil_null(void) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_NULL, .evidence = SIGIL_UNCERTAIN };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Array - uses header format for Vec-like dynamic operations
        self.line("static inline SigilValue sigil_array(size_t len) {");
        self.indent_push();
        self.line("/* Use header format for shared length tracking */");
        self.line("size_t cap = len < 4 ? 4 : len;");
        self.line("SigilArrayHeader* header = (SigilArrayHeader*)calloc(1, sizeof(SigilArrayHeader) + cap * sizeof(SigilValue));");
        self.line("header->len = len;");
        self.line("header->cap = cap;");
        self.line("return (SigilValue){ .tag = TAG_ARRAY, .evidence = SIGIL_KNOWN, .v.arr = { (SigilValue*)sigil_array_data(header), len, cap } };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Evidence setter
        self.line("static inline SigilValue sigil_with_evidence(SigilValue v, uint8_t ev) {");
        self.indent_push();
        self.line("v.evidence = ev;");
        self.line("return v;");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Truthiness
        self.line("static inline bool sigil_truthy(SigilValue v) {");
        self.indent_push();
        self.line("switch (v.tag) {");
        self.indent_push();
        self.line("case TAG_BOOL: return v.v.b;");
        self.line("case TAG_INT: return v.v.i != 0;");
        self.line("case TAG_FLOAT: return v.v.f != 0.0;");
        self.line("case TAG_STRING: return v.v.s && v.v.s[0];");
        self.line("case TAG_ARRAY: return v.v.arr.len > 0;");
        self.line("case TAG_NULL: return false;");
        self.line("case TAG_UNIT: return false;");
        self.line("case TAG_ENUM: return true;  /* Enum values are always truthy */");
        self.line("default: return true;");
        self.indent_pop();
        self.line("}");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Equality
        self.line("static inline bool sigil_eq(SigilValue a, SigilValue b) {");
        self.indent_push();
        self.line("/* Dereference refs before comparing */");
        self.line("if (a.tag == TAG_REF && a.v.ptr) a = *(SigilValue*)a.v.ptr;");
        self.line("if (b.tag == TAG_REF && b.v.ptr) b = *(SigilValue*)b.v.ptr;");
        self.line("if (a.tag != b.tag) return false;");
        self.line("switch (a.tag) {");
        self.indent_push();
        self.line("case TAG_BOOL: return a.v.b == b.v.b;");
        self.line("case TAG_INT: return a.v.i == b.v.i;");
        self.line("case TAG_FLOAT: return a.v.f == b.v.f;");
        self.line("case TAG_CHAR: return a.v.c == b.v.c;");
        self.line("case TAG_STRING: return strcmp(a.v.s, b.v.s) == 0;");
        self.line("case TAG_NULL: return true;");
        self.line("case TAG_UNIT: return true;");
        self.line("case TAG_ENUM: return a.v.e.enum_id == b.v.e.enum_id && a.v.e.variant == b.v.e.variant;");
        self.line("default: return false;");
        self.indent_pop();
        self.line("}");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Result type helpers
        self.line("/* Result type helpers */");
        self.line("static inline SigilValue sigil_Ok(SigilValue v) {");
        self.indent_push();
        self.line("SigilValue* inner = (SigilValue*)malloc(sizeof(SigilValue));");
        self.line("*inner = v;");
        self.line("return (SigilValue){ .tag = TAG_RESULT_OK, .evidence = SIGIL_KNOWN, .v.ptr = inner };");
        self.indent_pop();
        self.line("}");
        self.line("");
        self.line("static inline SigilValue sigil_Err(SigilValue v) {");
        self.indent_push();
        self.line("SigilValue* inner = (SigilValue*)malloc(sizeof(SigilValue));");
        self.line("*inner = v;");
        self.line("return (SigilValue){ .tag = TAG_RESULT_ERR, .evidence = SIGIL_KNOWN, .v.ptr = inner };");
        self.indent_pop();
        self.line("}");
        self.line("");
        self.line("static inline bool sigil_is_ok(SigilValue v) { return v.tag == TAG_RESULT_OK; }");
        self.line("static inline bool sigil_is_err(SigilValue v) { return v.tag == TAG_RESULT_ERR; }");
        self.line("");

        // Char from u32
        self.line("static inline SigilValue sigil_char____from_u32(SigilValue codepoint) {");
        self.indent_push();
        self.line("return sigil_char((char)(codepoint.v.i & 0xFF));");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Tick function (for loop iteration limit)
        self.line("static long long global_tick = 0;");
        self.line("static inline void tick(const char* fn) {");
        self.indent_push();
        self.line("global_tick++;");
        self.line("if (global_tick > 100000000) { fprintf(stderr, \"Infinite loop in %s\\n\", fn); exit(1); }");
        self.indent_pop();
        self.line("}");
        self.line("");
    }

    fn emit_builtin_decls(mut self) {
        self.line("/* I/O - print/println provided by user code or library */");
        self.line("SigilValue sigil_print(SigilValue s);");
        self.line("SigilValue sigil_println(SigilValue s);");
        self.line("SigilValue sigil_eprint(SigilValue s);");
        self.line("SigilValue sigil_eprintln(SigilValue s);");
        self.line("SigilValue sigil_display(SigilValue v);");
        self.line("SigilValue sigil_input(void);");
        self.line("");
        self.line("/* Math */");
        self.line("SigilValue sigil_abs(SigilValue v);");
        self.line("SigilValue sigil_sqrt(SigilValue v);");
        self.line("SigilValue sigil_sin(SigilValue v);");
        self.line("SigilValue sigil_cos(SigilValue v);");
        self.line("SigilValue sigil_pow(SigilValue base, SigilValue exp);");
        self.line("SigilValue sigil_floor(SigilValue v);");
        self.line("SigilValue sigil_ceil(SigilValue v);");
        self.line("SigilValue sigil_round(SigilValue v);");
        self.line("");
        self.line("/* Collections */");
        self.line("size_t sigil_arr_len(SigilValue v);");
        self.line("SigilValue sigil_len(SigilValue v);");
        self.line("SigilValue sigil_push(SigilValue arr, SigilValue item);");
        self.line("SigilValue sigil_pop(SigilValue arr);");
        self.line("SigilValue sigil_first(SigilValue arr);");
        self.line("SigilValue sigil_last(SigilValue arr);");
        self.line("SigilValue sigil_contains(SigilValue collection, SigilValue element);");
        self.line("");
        self.line("/* Assertions */");
        self.line("SigilValue sigil_assert(SigilValue cond, SigilValue msg);");
        self.line("SigilValue sigil_assert_eq(SigilValue a, SigilValue b);");
        self.line("SigilValue sigil_panic(SigilValue msg);");
        self.line("");
        self.line("/* String operations */");
        self.line("SigilValue sigil_concat(SigilValue a, SigilValue b);");
        self.line("SigilValue sigil_char_at(SigilValue s, SigilValue idx);");
        self.line("SigilValue sigil_len_utf8(SigilValue c);");
        self.line("SigilValue sigil_String____new(void);");
        self.line("SigilValue sigil_String____push(SigilValue s, SigilValue c);");
        self.line("SigilValue sigil_String____push_str(SigilValue s, SigilValue str);");
        self.line("SigilValue sigil_String____as_str(SigilValue s);");
        self.line("SigilValue sigil_String____to_uppercase(SigilValue s);");
        self.line("SigilValue sigil_String____to_lowercase(SigilValue s);");
        self.line("SigilValue sigil_String____chars(SigilValue s);");
        self.line("SigilValue sigil_String____starts_with(SigilValue s, SigilValue prefix);");
        self.line("SigilValue sigil_String____ends_with(SigilValue s, SigilValue suffix);");
        self.line("SigilValue sigil_String____contains(SigilValue s, SigilValue sub);");
        self.line("SigilValue sigil_String____split(SigilValue s, SigilValue delim);");
        self.line("SigilValue sigil_String____is_empty(SigilValue s);");
        self.line("SigilValue sigil_String____trim(SigilValue s);");
        self.line("SigilValue sigil_String____len(SigilValue s);");
        self.line("");
        self.line("/* Iterator operations - forward declarations */");
        self.line("/* These are defined as static inline at end but used early */");
        self.line("static inline SigilValue sigil_iter(SigilValue v);");
        self.line("static inline SigilValue sigil_collect(SigilValue v);");
        self.line("static inline SigilValue sigil_enumerate(SigilValue v);");
        self.line("static inline SigilValue sigil_join(SigilValue arr, SigilValue sep);");
        self.line("");
        self.line("/* Method aliases (when type prefix not resolved) */");
        self.line("#ifndef sigil_to_uppercase");
        self.line("#define sigil_to_uppercase(s) sigil_String____to_uppercase(s)");
        self.line("#endif");
        self.line("#ifndef sigil_to_lowercase");
        self.line("#define sigil_to_lowercase(s) sigil_String____to_lowercase(s)");
        self.line("#endif");
        self.line("");
        self.line("/* Struct operations */");
        self.line("SigilValue sigil_struct(const char* name, const char** names, SigilValue* values, size_t n);");
        self.line("SigilValue sigil_struct_field(SigilValue v, const char* field);");
        self.line("SigilValue sigil_struct_set_field(SigilValue* v, const char* field, SigilValue val);");
        self.line("int sigil_is_struct_variant(SigilValue v, const char* name);");
        self.line("int sigil_is_enum_variant(SigilValue v, const char* name);");
        self.line("int sigil_enum_eq(SigilValue a, SigilValue b);");
        self.line("");
        self.line("/* Tuple operations */");
        self.line("SigilValue sigil_tuple(SigilValue* fields, size_t n);");
        self.line("");
        self.line("/* Option helpers */");
        self.line("SigilValue sigil_Option____Some(SigilValue v);");
        self.line("SigilValue sigil_is_some(SigilValue v);");
        self.line("SigilValue sigil_is_none(SigilValue v);");
        self.line("extern const SigilValue Option____None;");
        self.line("");
        self.line("/* Vec operations */");
        self.line("SigilValue sigil_Vec____new(void);");
        self.line("SigilValue sigil_Vec____with_capacity(SigilValue cap);");
        self.line("SigilValue sigil_Vec____len(SigilValue v);");
        self.line("SigilValue sigil_Vec____push(SigilValue v, SigilValue item);");
        self.line("SigilValue sigil_Vec____pop(SigilValue v);");
        self.line("SigilValue sigil_Vec____get(SigilValue v, SigilValue idx);");
        self.line("SigilValue sigil_Vec____set(SigilValue v, SigilValue idx, SigilValue val);");
        self.line("SigilValue sigil_Vec____as_slice(SigilValue v);");
        self.line("SigilValue sigil_Vec____capacity(SigilValue v);");
        self.line("SigilValue sigil_Vec____clear(SigilValue v);");
        self.line("SigilValue sigil_Vec____clone(SigilValue v);");
        // CG-152 & CG-153: Additional Vec and String methods
        self.line("SigilValue sigil_Vec____extend(SigilValue v, SigilValue other);");
        self.line("SigilValue sigil_String____clone(SigilValue s);");
        // CG-160: Generic clone methods for types - no declarations needed, Rust parser generates them
        self.line("SigilValue sigil_capacity(SigilValue v);");
        self.line("SigilValue sigil_as_mut_ptr(SigilValue v);");
        self.line("");
        self.line("/* Box operations */");
        self.line("SigilValue sigil_Box____new(SigilValue v);");
        self.line("SigilValue sigil_Box____into_raw(SigilValue b);");
        self.line("SigilValue sigil_Box____from_raw(SigilValue ptr);");
        self.line("");
        self.line("/* Utility functions */");
        self.line("/* sigil_cloned is provided by runtime prelude as static inline */");
        self.line("SigilValue sigil_clone(SigilValue v);");
        self.line("SigilValue sigil_to_string(SigilValue v);");
        self.line("SigilValue sigil_max(SigilValue a, SigilValue b);");
        self.line("SigilValue sigil_min(SigilValue a, SigilValue b);");
        self.line("SigilValue sigil_add(SigilValue a, SigilValue b);");
        self.line("SigilValue sigil_sub(SigilValue a, SigilValue b);");
        self.line("SigilValue sigil_mul(SigilValue a, SigilValue b);");
        self.line("SigilValue sigil_div(SigilValue a, SigilValue b);");
        self.line("");
        self.line("/* Character and string helpers */");
        self.line("SigilValue sigil_chars(SigilValue s);");
        self.line("SigilValue sigil_is_vigesimal_digit(SigilValue c);");
        self.line("SigilValue sigil_is_duodecimal_digit(SigilValue c);");
        self.line("SigilValue sigil_is_sexagesimal_digit(SigilValue c);");
        self.line("SigilValue sigil_is_alphanumeric(SigilValue c);");
        self.line("SigilValue sigil_is_alphabetic(SigilValue c);");
        self.line("SigilValue sigil_is_digit(SigilValue c);");
        self.line("SigilValue sigil_is_whitespace(SigilValue c);");
        self.line("");
        self.line("/* Map operations */");
        self.line("SigilValue sigil_Map____new(void);");
        self.line("SigilValue sigil_Map____get(SigilValue m, SigilValue key);");
        self.line("SigilValue sigil_Map____insert(SigilValue m, SigilValue key, SigilValue val);");
        self.line("SigilValue sigil_Map____contains(SigilValue m, SigilValue key);");
        self.line("/* HashMap is an alias for Map */");
        self.line("#define sigil_HashMap____new sigil_Map____new");
        self.line("#define sigil_HashMap____get sigil_Map____get");
        self.line("#define sigil_HashMap____insert sigil_Map____insert");
        self.line("");
        self.line("/* String builder operations */");
        self.line("SigilValue sigil_push_str(SigilValue s, SigilValue str);");
        self.line("SigilValue sigil_as_str(SigilValue s);");
        self.line("SigilValue sigil_as_ptr(SigilValue s);");
        self.line("SigilValue sigil_is_null(SigilValue v);");
        self.line("SigilValue sigil_format(const char* fmt, ...);");
        self.line("");

        // Cross-module forward declarations for bootstrap
        // These allow modules to reference functions from other modules
        self.line("/* Cross-module forward declarations */");
        self.line("/* span.sg */");
        self.line("extern SigilValue sigil_Span____new(SigilValue start, SigilValue end);");
        self.line("extern SigilValue sigil_Span____merge(SigilValue a, SigilValue b);");
        self.line("extern SigilValue sigil_Span____len(SigilValue self);");
        self.line("extern SigilValue sigil_Span____empty_at(SigilValue pos);");
        self.line("extern SigilValue sigil_Span____dummy(void);");
        self.line("");
        // Token variant constructors are generated as static inline in token.c
        // so we don't need forward declarations here
        self.line("");
        self.line("/* ast.sg */");
        self.line("extern SigilValue sigil_Ident____new(SigilValue name, SigilValue span);");
        self.line("extern SigilValue sigil_Spanned____new(SigilValue value, SigilValue span);");
        self.line("");
        self.line("/* typeck.sg */");
        self.line("extern SigilValue sigil_EvidenceLevel____from_ast(SigilValue ast_ev);");
        self.line("extern SigilValue sigil_EvidenceLevel____join(SigilValue a, SigilValue b);");
        self.line("extern SigilValue sigil_EvidenceLevel____meet(SigilValue a, SigilValue b);");
        self.line("");
        self.line("/* ir.sg */");
        self.line("extern SigilValue sigil_IrSpan____from_span(SigilValue span);");
        self.line("extern SigilValue sigil_IrModule____new(SigilValue path);");
        self.line("");
        self.line("/* lib.sg - Result type */");
        self.line("typedef SigilValue Result;");
        self.line("typedef SigilValue ParseResult;");
        self.line("extern SigilValue sigil_Result____Ok(SigilValue v);");
        self.line("extern SigilValue sigil_Result____Err(SigilValue v);");
