        // so we don't need forward declarations here
        self.line("");
        self.line("/* ast.sg */");
        self.line("extern SigilValue sigil_Ident____new(SigilValue name, SigilValue span);");
        self.line("extern SigilValue sigil_Spanned____new(SigilValue value, SigilValue span);");
        self.line("");
        self.line("/* typeck.sg */");
        self.line("extern SigilValue sigil_EvidenceLevel____from_ast(SigilValue ast_ev);");
        self.line("extern SigilValue sigil_EvidenceLevel____join(SigilValue a, SigilValue b);");
