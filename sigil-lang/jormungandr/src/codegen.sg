    λ emit_value_constructors(Δ self) {
        // Unit
        self.line("static inline SigilValue sigil_unit(void) {");
        self.indent_push();
        self.line("⤺ (SigilValue){ .tag = TAG_UNIT, .evidence = SIGIL_KNOWN };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Bool
        self.line("static inline SigilValue sigil_bool(bool b) {");
        self.indent_push();
        self.line("⤺ (SigilValue){ .tag = TAG_BOOL, .evidence = SIGIL_KNOWN, .v.b = b };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Int
        self.line("static inline SigilValue sigil_int(int64_t i) {");
        self.indent_push();
        self.line("⤺ (SigilValue){ .tag = TAG_INT, .evidence = SIGIL_KNOWN, .v.i = i };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Float
        self.line("static inline SigilValue sigil_float(double f) {");
        self.indent_push();
        self.line("⤺ (SigilValue){ .tag = TAG_FLOAT, .evidence = SIGIL_KNOWN, .v.f = f };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Char
        self.line("static inline SigilValue sigil_char(char c) {");
        self.indent_push();
        self.line("⤺ (SigilValue){ .tag = TAG_CHAR, .evidence = SIGIL_KNOWN, .v.c = c };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // String
        self.line("static inline SigilValue sigil_string(const char* s) {");
        self.indent_push();
        self.line("char* copy = strdup(s);");
        self.line("⤺ (SigilValue){ .tag = TAG_STRING, .evidence = SIGIL_KNOWN, .v.s = copy };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Null
        self.line("static inline SigilValue sigil_null(void) {");
        self.indent_push();
        self.line("⤺ (SigilValue){ .tag = TAG_NULL, .evidence = SIGIL_UNCERTAIN };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Array - uses header format ∀ Vec-like dynamic operations
        self.line("static inline SigilValue sigil_array(size_t len) {");
        self.indent_push();
        self.line("/* Use header format ∀ shared length tracking */");
        self.line("size_t cap = len < 4 ? 4 : len;");
        self.line("SigilArrayHeader* header = (SigilArrayHeader*)calloc(1, sizeof(SigilArrayHeader) + cap * sizeof(SigilValue));");
        self.line("header->len = len;");
        self.line("header->cap = cap;");
        self.line("⤺ (SigilValue){ .tag = TAG_ARRAY, .evidence = SIGIL_KNOWN, .v.arr = { (SigilValue*)sigil_array_data(header), len, cap } };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Evidence setter
        self.line("static inline SigilValue sigil_with_evidence(SigilValue v, uint8_t ev) {");
        self.indent_push();
        self.line("v.evidence = ev;");
        self.line("⤺ v;");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Truthiness
        self.line("static inline bool sigil_truthy(SigilValue v) {");
        self.indent_push();
        self.line("switch (v.tag) {");
        self.indent_push();
        self.line("case TAG_BOOL: ⤺ v.v.b;");
        self.line("case TAG_INT: ⤺ v.v.i != 0;");
        self.line("case TAG_FLOAT: ⤺ v.v.f != 0.0;");
        self.line("case TAG_STRING: ⤺ v.v.s && v.v.s[0];");
        self.line("case TAG_ARRAY: ⤺ v.v.arr.len > 0;");
        self.line("case TAG_NULL: ⤺ false;");
        self.line("case TAG_UNIT: ⤺ false;");
        self.line("case TAG_ENUM: ⤺ true;  /* Enum values are always truthy */");
        self.line("default: ⤺ true;");
        self.indent_pop();
        self.line("}");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Equality
        self.line("static inline bool sigil_eq(SigilValue a, SigilValue b) {");
        self.indent_push();
        self.line("/* Dereference refs before comparing */");
        self.line("⎇ (a.tag == TAG_REF && a.v.ptr) a = *(SigilValue*)a.v.ptr;");
        self.line("⎇ (b.tag == TAG_REF && b.v.ptr) b = *(SigilValue*)b.v.ptr;");
        self.line("⎇ (a.tag != b.tag) ⤺ false;");
        self.line("switch (a.tag) {");
        self.indent_push();
        self.line("case TAG_BOOL: ⤺ a.v.b == b.v.b;");
        self.line("case TAG_INT: ⤺ a.v.i == b.v.i;");
        self.line("case TAG_FLOAT: ⤺ a.v.f == b.v.f;");
        self.line("case TAG_CHAR: ⤺ a.v.c == b.v.c;");
        self.line("case TAG_STRING: ⤺ strcmp(a.v.s, b.v.s) == 0;");
        self.line("case TAG_NULL: ⤺ true;");
        self.line("case TAG_UNIT: ⤺ true;");
        self.line("case TAG_ENUM: ⤺ a.v.e.enum_id == b.v.e.enum_id && a.v.e.variant == b.v.e.variant;");
        self.line("default: ⤺ false;");
        self.indent_pop();
        self.line("}");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Result type helpers
        self.line("/* Result type helpers */");
        self.line("static inline SigilValue sigil_Ok(SigilValue v) {");
        self.indent_push();
        self.line("SigilValue* inner = (SigilValue*)malloc(sizeof(SigilValue));");
        self.line("*inner = v;");
        self.line("⤺ (SigilValue){ .tag = TAG_RESULT_OK, .evidence = SIGIL_KNOWN, .v.ptr = inner };");
        self.indent_pop();
        self.line("}");
        self.line("");
        self.line("static inline SigilValue sigil_Err(SigilValue v) {");
        self.indent_push();
        self.line("SigilValue* inner = (SigilValue*)malloc(sizeof(SigilValue));");
        self.line("*inner = v;");
        self.line("⤺ (SigilValue){ .tag = TAG_RESULT_ERR, .evidence = SIGIL_KNOWN, .v.ptr = inner };");
        self.indent_pop();
        self.line("}");
        self.line("");
        self.line("static inline bool sigil_is_ok(SigilValue v) { ⤺ v.tag == TAG_RESULT_OK; }");
        self.line("static inline bool sigil_is_err(SigilValue v) { ⤺ v.tag == TAG_RESULT_ERR; }");
        self.line("");

        // Char from u32
        self.line("static inline SigilValue sigil_char____from_u32(SigilValue codepoint) {");
        self.indent_push();
        self.line("⤺ sigil_char((char)(codepoint.v.i & 0xFF));");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Tick function (∀ loop iteration limit)
        self.line("static long long global_tick = 0;");
        self.line("static inline void tick(const char* fn) {");
        self.indent_push();
        self.line("global_tick++;");
        self.line("⎇ (global_tick > 100000000) { fprintf(stderr, \"Infinite loop ∈ %s\\n\", fn); exit(1); }");
        self.indent_pop();
        self.line("}");
        self.line("");
    }

