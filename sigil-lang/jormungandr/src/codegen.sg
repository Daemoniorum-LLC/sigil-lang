//! Native Code Generation for Sigil
//!
//! This module generates native code from Sigil IR. For the bootstrap,
//! we target C as an intermediate language - this is portable and allows
//! us to leverage existing C compilers for optimization.
//!
//! ## Strategy
//!
//! 1. **C Codegen**: Generate C source code from IR (bootstrap)
//! 2. **Direct Native**: Future work with Cranelift or LLVM
//!
//! ## Generated Code Structure
//!
//! ```c
//! // Runtime header
//! #include "sigil_runtime.h"
//!
//! // Type definitions
//! typedef struct { ... } MyStruct;
//!
//! // Function declarations
//! SigilValue my_function(SigilValue arg);
//!
//! // Function definitions
//! SigilValue my_function(SigilValue arg) { ... }
//!
//! // Main entry point
//! int main(int argc, char** argv) { ... }
//! ```
//!
//! ## Evidence in Generated Code
//!
//! Evidence is represented as runtime tags:
//! - `SIGIL_KNOWN` (0) - Direct computation
//! - `SIGIL_UNCERTAIN` (1) - Possibly absent
//! - `SIGIL_REPORTED` (2) - External source
//! - `SIGIL_PARADOX` (3) - Contradictory
//!
//! ## Known Issues for Fixed-Point Compilation
//!
//! The following issues were discovered during fixed-point bootstrap attempts:
//!
//! ### CG-125: Result type representation mismatch
//! sigil_Ok/sigil_Err store values in `.v.ptr` but generated code accesses `.v.e.data[0]`.
//! **Fix**: Change sigil_Ok/sigil_Err to use `.v.e = { .data = ... }` representation.
//!
//! ### CG-126: Vec·is_empty generates String·is_empty
//! Method resolution doesn't track receiver type, so `vec.is_empty()` becomes
//! `sigil_String____is_empty(vec)` which fails for arrays.
//! **Fix**: Make sigil_String____is_empty handle TAG_ARRAY.
//!
//! ### CG-127: struct.field.push() doesn't write back
//! When pushing to a struct field like `config.input_files.push(s)`, the generated
//! code calls Vec·push but doesn't write the result back to the struct.
//! **Fix**: Generate `sigil_struct_set_field(&config, "input_files", result)` after push.

invoke tome·ir·*;
invoke tome·typeck·EvidenceLevel;

// ============================================================================
// Code Generator
// ============================================================================

/// C code generator
pub struct CodeGen {
    /// Output buffer
    output: !String,

    /// Indentation level
    indent: !u64,

    /// Generated type names
    type_names: !Map<String, String>,

    /// Temporary variable counter
    temp_counter: !u64,

    /// Label counter for control flow
    label_counter: !u64,

    /// Current function name
    current_function: ?String,

    /// Whether we're in an expression context
    in_expr: !bool,

    /// Buffer for closure functions (emitted before main code)
    closure_buffer: !String,

    /// CG-015: Method signatures for determining mut self at call sites
    /// Maps qualified method name (e.g., "Lexer·advance") to whether it has mut self
    method_signatures: !Map<String, bool>,

    /// CG-015: Whether the current function being emitted has `mut self`
    /// When true, `self` is SigilValue* and needs dereferencing when used
    current_fn_has_mut_self: !bool,

    /// CG-029: Whether we're currently generating a closure body
    /// In closures, captured `self` is always a value (not a pointer),
    /// so method calls on self always need &self
    in_closure_body: !bool,

    /// FIX: Track mutable reference parameters (&mut) in current function
    /// These need .v.ptr extraction when passed to struct_set_field
    current_mut_ref_params: ![String],
}

impl CodeGen {
    /// Create a new code generator
    pub fn new() -> !CodeGen {
        CodeGen {
            output: String·new(),
            indent: 0,
            type_names: Map·new(),
            temp_counter: 0,
            label_counter: 0,
            current_function: null,
            in_expr: false,
            closure_buffer: String·new(),
            method_signatures: Map·new(),
            current_fn_has_mut_self: false,
            in_closure_body: false,
            current_mut_ref_params: [],
        }
    }

    /// Generate C code from an IR module
    pub fn generate(mut self, module: !IrModule) -> !String {
        // CG-015: Copy method signatures for call-site lookup
        self.method_signatures = module.method_signatures.clone();

        // Emit header
        self.emit_header();

        // Emit type definitions
        for type_def in module.types {
            self.emit_typedef(type_def);
        }

        // Emit function declarations
        for func in module.functions {
            self.emit_function_decl(func);
        }

        // CG-131: Impl methods are already in module.functions with qualified names
        // (added by lower_item), so we skip emitting them again from module.impls
        // to avoid duplicate function definitions

        self.line("");

        // Generate function bodies to a temporary buffer (this collects closures)
        let header_code = self.output.clone();
        self.output = String·new();
        for func in module.functions {
            self.emit_function(func);
        }

        // CG-131: Impl method bodies are already emitted above from module.functions
        // (they were added with qualified names by lower_item)
        let func_code = self.output.clone();

        // Rebuild output: header + closures + functions
        self.output = header_code;

        // Insert closure functions before main functions
        if !self.closure_buffer.is_empty() {
            self.line("/* Closure functions */");
            self.output.push_str(self.closure_buffer.as_str());
            self.line("");
        }

        // Add function bodies
        self.output.push_str(func_code.as_str());

        // Check if module has a main function and whether it takes args
        let mut has_main = false;
        let mut main_has_args = false;
        for func in module.functions {
            if func.name == "main" {
                has_main = true;
                main_has_args = func.params.len() > 0;
            }
        }

        // Emit main entry point wrapper (only if has main)
        self.emit_main_wrapper(has_main, main_has_args);

        // CG-127: Final cleanup pass to remove any stray ? evidence markers
        self.strip_evidence_markers(self.output.clone())
    }

    /// Generate a fresh temporary name
    fn fresh_temp(mut self) -> !String {
        let id = self.temp_counter;
        self.temp_counter += 1;
        format!("_t{}", id)
    }

    /// Generate a fresh label
    fn fresh_label(mut self, prefix: !&str) -> !String {
        let id = self.label_counter;
        self.label_counter += 1;
        format!("{}_{}", prefix, id)
    }

    /// Generate a unique hash for an enum name (djb2 algorithm, masked to 32-bit)
    fn hash_enum_name(self, name: !String) -> !u32 {
        let mut hash: !u32 = 5381;
        let mask: !u32 = 4294967295;  // 2^32 - 1
        for c in name.chars() {
            // djb2: hash = hash * 33 + c, masked to 32 bits
            // Break into steps to avoid exponentially long C expressions
            let shifted = hash << 5;      // hash * 32
            let sum = shifted + hash;     // hash * 33
            let with_char = sum + (c as u32);
            hash = with_char & mask;
        }
        hash
    }

    /// Emit a line with current indentation
    /// CG-022: Use push_str instead of + to avoid O(n²) string copies
    /// Note: Interpreter mutates self.output in place, returns null - don't reassign
    fn line(mut self, s: !&str) {
        for _ in 0..self.indent {
            self.output.push_str("    ");
        }
        self.output.push_str(s);
        self.output.push_str("\n");
    }

    /// Emit text without newline
    fn emit(mut self, s: !&str) {
        self.output.push_str(s);
    }

    /// Helper: open brace (workaround for format! escaping issue)
    fn open_brace() -> !&str { "{" }

    /// Helper: close brace (workaround for format! escaping issue)
    fn close_brace() -> !&str { "}" }

    /// Helper: emit line with opening brace at end
    fn line_open(mut self, s: !&str) {
        // Avoid format! with static method calls - use string concat
        // Note: s is already a SigilValue string, so concat directly
        let line = s + " {";
        self.line(line);
    }

    /// Helper: emit closing brace with suffix
    fn line_close(mut self, suffix: !&str) {
        // Avoid format! with static method calls - use string concat
        let line = "}" + suffix;
        self.line(line);
    }

    /// Helper: create a C struct initializer like { .tag = 1, .v.i = 42 }
    fn struct_init(inner: !&str) -> !String {
        // Use string concat to avoid format! issues with static calls
        // Parameters are already SigilValue strings, concat directly
        "{ " + inner + " }"
    }

    /// Helper: create a C compound literal like (SigilValue){ .tag = 1 }
    fn compound_lit(ty: !&str, inner: !&str) -> !String {
        // Use string concat to avoid format! issues with static calls
        let init = CodeGen·struct_init(inner);
        "(" + ty + ")" + init
    }

    /// Increase indentation
    fn indent_push(mut self) {
        self.indent += 1;
    }

    /// Decrease indentation
    fn indent_pop(mut self) {
        if self.indent > 0 {
            self.indent -= 1;
        }
    }

    // ========================================================================
    // Header Generation
    // ========================================================================

    fn emit_header(mut self) {
        self.line("/* Generated by Sigil Compiler */");
        self.line("/* Jormungandr Bootstrap */");
        self.line("");
        self.line("#include <stdint.h>");
        self.line("#include <stdbool.h>");
        self.line("#include <stdio.h>");
        self.line("#include <stdlib.h>");
        self.line("#include <string.h>");
        self.line("#include <math.h>");
        self.line("#include <stdarg.h>");
        self.line("#include <time.h>");
        self.line("");

        // Use include guard for combined compilation
        self.line("#ifndef SIGIL_RUNTIME_H");
        self.line("#define SIGIL_RUNTIME_H");
        self.line("");

        // Evidence level constants
        self.line("/* Evidence levels */");
        self.line("#define SIGIL_KNOWN     0");
        self.line("#define SIGIL_UNCERTAIN 1");
        self.line("#define SIGIL_REPORTED  2");
        self.line("#define SIGIL_PARADOX   3");
        self.line("");

        // IrEvidence enum variant aliases (for generated code matching on IrEvidence)
        self.line("/* IrEvidence enum variants (aliases) */");
        self.line("#define IREVIDENCE_KNOWN     SIGIL_KNOWN");
        self.line("#define IREVIDENCE_UNCERTAIN SIGIL_UNCERTAIN");
        self.line("#define IREVIDENCE_REPORTED  SIGIL_REPORTED");
        self.line("#define IREVIDENCE_PARADOX   SIGIL_PARADOX");
        self.line("");

        // Value type tags
        self.line("/* Value type tags */");
        self.line("#define TAG_UNIT    0");
        self.line("#define TAG_BOOL    1");
        self.line("#define TAG_INT     2");
        self.line("#define TAG_FLOAT   3");
        self.line("#define TAG_CHAR    4");
        self.line("#define TAG_STRING  5");
        self.line("#define TAG_ARRAY   6");
        self.line("#define TAG_TUPLE   7");
        self.line("#define TAG_STRUCT  8");
        self.line("#define TAG_CLOSURE 9");
        self.line("#define TAG_REF     10");
        self.line("#define TAG_NULL    11");
        self.line("#define TAG_OPTION_NONE 12");
        self.line("#define TAG_OPTION_SOME 13");
        self.line("#define TAG_ENUM    14");
        self.line("#define TAG_RESULT_OK  15");
        self.line("#define TAG_RESULT_ERR 16");
        self.line("#define TAG_STRINGBUILDER 17");
        self.line("#define TAG_MAP 18");
        self.line("");

        // StringBuilder for mutable string building
        self.line("/* StringBuilder for O(1) amortized append */");
        self.line("typedef struct StringBuilder {");
        self.indent_push();
        self.line("char* data;");
        self.line("size_t len;");
        self.line("size_t cap;");
        self.indent_pop();
        self.line("} StringBuilder;");
        self.line("");
        self.line("static inline StringBuilder* sb_new(void) {");
        self.indent_push();
        self.line("StringBuilder* sb = (StringBuilder*)malloc(sizeof(StringBuilder));");
        self.line("sb->cap = 256;");
        self.line("sb->data = (char*)malloc(sb->cap);");
        self.line("sb->data[0] = 0;");
        self.line("sb->len = 0;");
        self.line("return sb;");
        self.indent_pop();
        self.line("}");
        self.line("");
        self.line("static inline void sb_ensure_cap(StringBuilder* sb, size_t needed) {");
        self.indent_push();
        self.line("if (sb->len + needed >= sb->cap) {");
        self.indent_push();
        self.line("sb->cap = (sb->len + needed + 1) * 2;");
        self.line("sb->data = (char*)realloc(sb->data, sb->cap);");
        self.indent_pop();
        self.line("}");
        self.indent_pop();
        self.line("}");
        self.line("");
        self.line("static inline char* sb_to_string(StringBuilder* sb) {");
        self.indent_push();
        self.line("char* result = (char*)malloc(sb->len + 1);");
        self.line("memcpy(result, sb->data, sb->len + 1);");
        self.line("return result;");
        self.indent_pop();
        self.line("}");
        self.line("");
        // NOTE: sigil_sb_finalize forward decl moved after SigilValue typedef

        // Core value type
        self.line("/* Runtime value representation */");
        self.line("typedef struct SigilValue {");
        self.indent_push();
        self.line("uint8_t tag;");
        self.line("uint8_t evidence;");
        self.line("union {");
        self.indent_push();
        self.line("bool b;");
        self.line("int64_t i;");
        self.line("double f;");
        self.line("int32_t c;");  // Use int32_t for full Unicode codepoint support
        self.line("char* s;");
        self.line("struct { struct SigilValue* data; size_t len; size_t cap; } arr;");
        self.line("struct { struct SigilValue* fields; size_t count; } tup;");
        self.line("struct { uint32_t enum_id; uint32_t variant; struct SigilValue* data; size_t field_count; } e;");
        self.line("void* ptr;");
        self.indent_pop();
        self.line("} v;");
        self.indent_pop();
        self.line("} SigilValue;");
        self.line("");
        self.line("static inline SigilValue sigil_sb_finalize(SigilValue v);");
        self.line("");

        // Array header for dynamic arrays (Vec-like operations)
        self.line("#ifndef SIGIL_ARRAY_HEADER_DEFINED");
        self.line("#define SIGIL_ARRAY_HEADER_DEFINED");
        self.line("/* Array header for shared length tracking */");
        self.line("typedef struct SigilArrayHeader {");
        self.indent_push();
        self.line("size_t len;");
        self.line("size_t cap;");
        self.indent_pop();
        self.line("} SigilArrayHeader;");
        self.line("");
        self.line("#define SIGIL_ARRAY_DATA_OFFSET (sizeof(SigilArrayHeader))");
        self.line("static inline SigilArrayHeader* sigil_get_array_header(void* arr_data) {");
        self.indent_push();
        self.line("return (SigilArrayHeader*)((char*)arr_data - SIGIL_ARRAY_DATA_OFFSET);");
        self.indent_pop();
        self.line("}");
        self.line("static inline void* sigil_array_data(SigilArrayHeader* h) {");
        self.indent_push();
        self.line("return (void*)((char*)h + SIGIL_ARRAY_DATA_OFFSET);");
        self.indent_pop();
        self.line("}");
        self.line("#endif /* SIGIL_ARRAY_HEADER_DEFINED */");
        self.line("");

        // Value constructors - must come first since IrEvidence methods use them
        self.line("/* Value constructors */");
        self.emit_value_constructors();
        self.line("");

        // IrEvidence enum variant constants (need to be after SigilValue definition)
        // CG-142: Use extern declarations to allow definition from ir.c
        self.line("/* IrEvidence enum variant constants */");
        self.line("extern const SigilValue IrEvidence____Known;");
        self.line("extern const SigilValue IrEvidence____Uncertain;");
        self.line("extern const SigilValue IrEvidence____Reported;");
        self.line("extern const SigilValue IrEvidence____Paradox;");
        self.line("");
        // CG-072: IrEvidence methods are now generated from the impl block in ir.sg
        // Don't emit static inline helpers here to avoid redefinition errors
        // Forward declarations only
        self.line("/* IrEvidence method declarations - implementations generated from ir.sg */");
        self.line("SigilValue sigil_IrEvidence____symbol(SigilValue self);");
        self.line("SigilValue sigil_IrEvidence____name(SigilValue self);");
        self.line("");

        // Built-in function declarations
        self.line("/* Built-in functions */");
        self.emit_builtin_decls();
        self.line("");

        // Cross-module enum fallback defines (for pattern matching)
        self.line("/* Cross-module enum fallbacks - prevents undefined errors */");
        self.line("/* Note: These use impossible values so TAG_ENUM checks fail gracefully, */");
        self.line("/* falling back to sigil_is_struct_variant which handles cross-module enums. */");
        self.line("#ifndef TOKEN_ENUM_ID");
        self.line("#define TOKEN_ENUM_ID 0xDEAD0001U");
        self.line("#endif");
        // Common Token variants - use 0xFFFF as impossible variant index
        self.line("#ifndef TOKEN_FATARROW");
        self.line("#define TOKEN_FATARROW 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_COMMA");
        self.line("#define TOKEN_COMMA 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_COLON");
        self.line("#define TOKEN_COLON 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_LPAREN");
        self.line("#define TOKEN_LPAREN 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_RPAREN");
        self.line("#define TOKEN_RPAREN 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_LBRACKET");
        self.line("#define TOKEN_LBRACKET 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_RBRACKET");
        self.line("#define TOKEN_RBRACKET 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_LBRACE");
        self.line("#define TOKEN_LBRACE 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_RBRACE");
        self.line("#define TOKEN_RBRACE 0xFFFF");
        self.line("#endif");
        // CG-166: Complete TOKEN_* variant fallbacks
        self.line("#ifndef TOKEN_IDENT");
        self.line("#define TOKEN_IDENT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_EOF");
        self.line("#define TOKEN_EOF 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_INTLIT");
        self.line("#define TOKEN_INTLIT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_FLOATLIT");
        self.line("#define TOKEN_FLOATLIT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_STRINGLIT");
        self.line("#define TOKEN_STRINGLIT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_CHARLIT");
        self.line("#define TOKEN_CHARLIT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_TRUE");
        self.line("#define TOKEN_TRUE 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_FALSE");
        self.line("#define TOKEN_FALSE 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_NULL");
        self.line("#define TOKEN_NULL 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_PLUS");
        self.line("#define TOKEN_PLUS 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_MINUS");
        self.line("#define TOKEN_MINUS 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_STAR");
        self.line("#define TOKEN_STAR 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_SLASH");
        self.line("#define TOKEN_SLASH 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_PERCENT");
        self.line("#define TOKEN_PERCENT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_AMP");
        self.line("#define TOKEN_AMP 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_PIPE");
        self.line("#define TOKEN_PIPE 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_CARET");
        self.line("#define TOKEN_CARET 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_BANG");
        self.line("#define TOKEN_BANG 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_QUESTION");
        self.line("#define TOKEN_QUESTION 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_TILDE");
        self.line("#define TOKEN_TILDE 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_DOT");
        self.line("#define TOKEN_DOT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_DOTDOT");
        self.line("#define TOKEN_DOTDOT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_DOTDOTEQ");
        self.line("#define TOKEN_DOTDOTEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_COLONCOLON");
        self.line("#define TOKEN_COLONCOLON 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_SEMI");
        self.line("#define TOKEN_SEMI 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_ARROW");
        self.line("#define TOKEN_ARROW 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_EQ");
        self.line("#define TOKEN_EQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_EQEQ");
        self.line("#define TOKEN_EQEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_NOTEQ");
        self.line("#define TOKEN_NOTEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_LT");
        self.line("#define TOKEN_LT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_GT");
        self.line("#define TOKEN_GT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_LTEQ");
        self.line("#define TOKEN_LTEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_GTEQ");
        self.line("#define TOKEN_GTEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_ANDAND");
        self.line("#define TOKEN_ANDAND 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_OROR");
        self.line("#define TOKEN_OROR 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_SHL");
        self.line("#define TOKEN_SHL 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_SHR");
        self.line("#define TOKEN_SHR 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_PLUSEQ");
        self.line("#define TOKEN_PLUSEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_MINUSEQ");
        self.line("#define TOKEN_MINUSEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_STAREQ");
        self.line("#define TOKEN_STAREQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_SLASHEQ");
        self.line("#define TOKEN_SLASHEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_PERCENTEQ");
        self.line("#define TOKEN_PERCENTEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_AMPEQ");
        self.line("#define TOKEN_AMPEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_PIPEEQ");
        self.line("#define TOKEN_PIPEEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_CARETEQ");
        self.line("#define TOKEN_CARETEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_SHLEQ");
        self.line("#define TOKEN_SHLEQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_SHREQ");
        self.line("#define TOKEN_SHREQ 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_AT");
        self.line("#define TOKEN_AT 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_HASH");
        self.line("#define TOKEN_HASH 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_UNDERSCORE");
        self.line("#define TOKEN_UNDERSCORE 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_IF");
        self.line("#define TOKEN_IF 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_ELSE");
        self.line("#define TOKEN_ELSE 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_MATCH");
        self.line("#define TOKEN_MATCH 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_LOOP");
        self.line("#define TOKEN_LOOP 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_WHILE");
        self.line("#define TOKEN_WHILE 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_FOR");
        self.line("#define TOKEN_FOR 0xFFFF");
        self.line("#endif");
        self.line("#ifndef TOKEN_IN");
        self.line("#define TOKEN_IN 0xFFFF");
        self.line("#endif");
