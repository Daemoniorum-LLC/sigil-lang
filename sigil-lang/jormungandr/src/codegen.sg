        self.line("SigilValue sigil_Vec____first(SigilValue v);");
        self.line("SigilValue sigil_Vec____last(SigilValue v);");
        // CG-079: sigil_fresh_id and sigil_get_var_id are now defined as wrappers above
        self.line("SigilValue sigil_error(SigilValue msg, SigilValue span);");
        self.line("SigilValue sigil_split(SigilValue s, SigilValue delim);");
