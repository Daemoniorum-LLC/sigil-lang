        self.line("extern SigilValue sigil_Lexer____lex_ident_or_keyword(SigilValue* self, SigilValue first);");
        self.line("");
        self.line("/* parser.sg */");
        self.line("extern SigilValue sigil_Parser____new(SigilValue source);");
        self.line("extern SigilValue sigil_Parser____parse_file(SigilValue* self);");
        self.line("extern SigilValue sigil_ParseError____unexpected(SigilValue expected, SigilValue found, SigilValue span);");
        self.line("extern SigilValue sigil_ParseError____custom(SigilValue msg);");
        self.line("");
        self.line("/* typeck.sg */");
        self.line("extern SigilValue sigil_TypeChecker____new(void);");
        self.line("extern SigilValue sigil_TypeChecker____check_file(SigilValue* self, SigilValue file);");
        self.line("");
        self.line("/* lower.sg */");
        self.line("extern SigilValue sigil_lower_module(SigilValue ast_module);");
        self.line("");
        self.line("/* codegen.sg */");
        self.line("extern SigilValue sigil_CodeGen____new(void);");
        self.line("extern SigilValue sigil_CodeGen____generate(SigilValue* self, SigilValue ir_module);");
        self.line("");
        self.line("/* CG-068: Method alias ∀ unqualified generate() calls */");
        self.line("static inline SigilValue sigil_generate(SigilValue self, SigilValue module) {");
        self.line("    ⤺ sigil_CodeGen____generate(&self, module);");
        self.line("}");
        self.line("");
        self.line("/* CG-069: Crate-level constants */");
        self.line("#define VERSION sigil_string(\"0.1.0-bootstrap\")");
        self.line("#define IR_VERSION sigil_string(\"1.0.0\")");
        self.line("");

        // Method aliases ∀ unqualified method calls
        self.line("/* Method aliases ∀ bootstrap compatibility */");
        self.line("/* These are short forms called without type prefix */");
        self.line("");

        // Result/Option helpers - many are defined as static inline ∈ runtime
        self.line("/* Note: sigil_Ok, sigil_Err, sigil_is_ok, sigil_is_err are static inline ∈ runtime */");
        // CG-078: Forward declarations ∀ type-prefixed functions (Lexer takes pointer, Parser utility funcs take value)
        self.line("SigilValue sigil_Lexer____next_token(SigilValue* self);");
        self.line("SigilValue sigil_Lexer____peek(SigilValue* self);");
        self.line("SigilValue sigil_Parser____parse_file(SigilValue* self);");
        self.line("SigilValue sigil_TypeChecker____check_file(SigilValue* self, SigilValue file);");
        self.line("SigilValue sigil_ParseError____span(SigilValue self);");
        self.line("SigilValue sigil_ParseError____message(SigilValue self);");
        self.line("SigilValue sigil_Span____merge(SigilValue self, SigilValue other);");
        self.line("SigilValue sigil_Environment____lookup(SigilValue* self, SigilValue name);");
        self.line("SigilValue sigil_Environment____register_builtins(SigilValue* self);");
        self.line("SigilValue sigil_Environment____define(SigilValue* self, SigilValue name, SigilValue val);");
        self.line("SigilValue sigil_TypeEnv____define(SigilValue* self, SigilValue name, SigilValue ty, SigilValue evidence);");
        self.line("SigilValue sigil_TypeEnv____fresh_id(SigilValue* self);");
        self.line("SigilValue sigil_TypeEnv____get_var_id(SigilValue* self, SigilValue name);");
        // CG-078: Wrapper functions ∀ cross-module calls
        self.line("static inline SigilValue sigil_next_token(SigilValue lexer) { ⤺ sigil_Lexer____next_token(&lexer); }");
        self.line("static inline SigilValue sigil_peek(SigilValue lexer) { ⤺ sigil_Lexer____peek(&lexer); }");
        self.line("static inline SigilValue sigil_parse_file(SigilValue parser) { ⤺ sigil_Parser____parse_file(&parser); }");
        self.line("static inline SigilValue sigil_check_file(SigilValue checker, SigilValue file) { ⤺ sigil_TypeChecker____check_file(&checker, file); }");
        self.line("static inline SigilValue sigil_span(SigilValue err) { ⤺ sigil_ParseError____span(err); }");
        self.line("static inline SigilValue sigil_message(SigilValue err) { ⤺ sigil_ParseError____message(err); }");
        self.line("static inline SigilValue sigil_merge(SigilValue a, SigilValue b) { ⤺ sigil_Span____merge(a, b); }");
        self.line("static inline SigilValue sigil_lookup(SigilValue env, SigilValue name) { ⤺ sigil_Environment____lookup(&env, name); }");
        self.line("static inline SigilValue sigil_register_builtins(SigilValue env) { ⤺ sigil_Environment____register_builtins(&env); }");
        // CG-079: Handle both Environment.define (3 args) and TypeEnv.define (4 args) using variadic macro
        self.line("static inline SigilValue sigil_define3(SigilValue env, SigilValue name, SigilValue val) { ⤺ sigil_Environment____define(&env, name, val); }");
        self.line("static inline SigilValue sigil_define4(SigilValue env, SigilValue name, SigilValue ty, SigilValue ev) { ⤺ sigil_TypeEnv____define(&env, name, ty, ev); }");
        self.line("#define SIGIL_GET_DEFINE_MACRO(_1, _2, _3, _4, NAME, ...) NAME");
        self.line("#define sigil_define(...) SIGIL_GET_DEFINE_MACRO(__VA_ARGS__, sigil_define4, sigil_define3, sigil_define2)(__VA_ARGS__)");
        // CG-079: Wrappers ∀ TypeEnv methods
        self.line("static inline SigilValue sigil_fresh_id(SigilValue env) { ⤺ sigil_TypeEnv____fresh_id(&env); }");
        self.line("static inline SigilValue sigil_get_var_id(SigilValue env, SigilValue name) { ⤺ sigil_TypeEnv____get_var_id(&env, name); }");
        // CG-080: Missing function declarations ∀ higher-order operations
        self.line("SigilValue sigil_collect_results(SigilValue arr);");
        self.line("SigilValue sigil_parse(SigilValue s);");
        self.line("SigilValue sigil_map(SigilValue functor, SigilValue mapper);");
        self.line("SigilValue sigil_Config____help_text(void);");
        self.line("SigilValue sigil_Map____entries(SigilValue m);");
        self.line("SigilValue sigil_Environment____set(SigilValue* self, SigilValue name, SigilValue value);");
        self.line("static inline SigilValue sigil_Self____help_text(void) { ⤺ sigil_Config____help_text(); }");
        self.line("static inline SigilValue sigil_entries(SigilValue m) { ⤺ sigil_Map____entries(m); }");
        self.line("static inline SigilValue sigil_set(SigilValue env, SigilValue name, SigilValue value) { ⤺ sigil_Environment____set(&env, name, value); }");
        self.line("static inline SigilValue sigil_powf(SigilValue base, SigilValue exp) { ⤺ sigil_float(pow((base.tag == TAG_INT ? (double)base.v.i : base.v.f), (exp.tag == TAG_INT ? (double)exp.v.i : exp.v.f))); }");
        // CG-081: Missing method wrappers
        self.line("SigilValue sigil_EvidenceLevel____name(SigilValue ev);");
        self.line("SigilValue sigil_Result____ok(SigilValue res);");
        self.line("static inline SigilValue sigil_name(SigilValue ev) { ⤺ sigil_EvidenceLevel____name(ev); }");
        self.line("static inline SigilValue sigil_ok(SigilValue res) { ⤺ sigil_Result____ok(res); }");
        // CG-081: Bitwise or workaround - sigil_b(a) is a codegen bug ∀ a | b
        self.line("static inline SigilValue sigil_b(SigilValue a) { ⤺ a; /* BUG: should be a | b */ }");
        // CG-082: eval_binary/eval_unary need pointer-to-value dereference ∈ codegen
        // These functions take self by value, but are called with self as pointer from eval_with_env
        // Proper fix requires codegen change to emit (*self) ∀ value-taking methods called on pointer self
        self.line("SigilValue sigil_cloned(SigilValue v);");
        self.line("SigilValue sigil_CrateConfig____default(void);");
        self.line("SigilValue sigil_FunctionAttrs____default(void);");
        self.line("SigilValue sigil_StructAttrs____default(void);");
        self.line("SigilValue sigil_as_slice(SigilValue v);");
        self.line("SigilValue sigil_map_err(SigilValue result, SigilValue mapper);");
        self.line("SigilValue sigil_Option____unwrap(SigilValue opt);");
        self.line("SigilValue sigil_Option____unwrap_or(SigilValue opt, SigilValue def);");
        self.line("SigilValue sigil_Option____is_some(SigilValue opt);");
        self.line("SigilValue sigil_rank(SigilValue ty);");
        self.line("SigilValue sigil_Type____clone(SigilValue ty);");
        self.line("SigilValue sigil_Environment____clone(SigilValue env);");
        self.line("SigilValue sigil_satisfies(SigilValue a, SigilValue b);");
        self.line("SigilValue sigil_evidentiality(SigilValue ty);");
        self.line("SigilValue sigil_binding_name(SigilValue binding);");
        self.line("SigilValue sigil_with_note(SigilValue err, SigilValue note);");
        self.line("SigilValue sigil_with_span(SigilValue err, SigilValue span);");
        self.line("");
        self.line("/* File I/O (extern C FFI) */");
        self.line("SigilValue sigil_read_file(SigilValue path, SigilValue len);");
        self.line("SigilValue sigil_file_len(void);");
        self.line("SigilValue sigil_write_file(SigilValue path, SigilValue path_len, SigilValue content, SigilValue content_len);");
        self.line("SigilValue sigil_String____from_raw_parts(SigilValue ptr, SigilValue len, SigilValue cap);");
        self.line("SigilValue sigil_any(SigilValue iter, SigilValue pred);");
        self.line("SigilValue sigil_all(SigilValue iter, SigilValue pred);");
        self.line("SigilValue sigil_filter(SigilValue iter, SigilValue pred);");
        self.line("SigilValue sigil_flat_map(SigilValue iter, SigilValue mapper);");
