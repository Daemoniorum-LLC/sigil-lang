        self.line("/* codegen.sg */");
        self.line("extern SigilValue sigil_CodeGen____new(void);");
        self.line("extern SigilValue sigil_CodeGen____generate(SigilValue* self, SigilValue ir_module);");
        self.line("");
        self.line("/* CG-068: Method alias for unqualified generate() calls */");
        self.line("static inline SigilValue sigil_generate(SigilValue self, SigilValue module) {");
        self.line("    return sigil_CodeGen____generate(&self, module);");
        self.line("}");
        self.line("");
        self.line("/* CG-069: Crate-level constants */");
        self.line("#define VERSION sigil_string(\"0.1.0-bootstrap\")");
        self.line("#define IR_VERSION sigil_string(\"1.0.0\")");
        self.line("");

        // Method aliases for unqualified method calls
        self.line("/* Method aliases for bootstrap compatibility */");
        self.line("/* These are short forms called without type prefix */");
        self.line("");

        // Result/Option helpers - many are defined as static inline in runtime
        self.line("/* Note: sigil_Ok, sigil_Err, sigil_is_ok, sigil_is_err are static inline in runtime */");
        // CG-078: Forward declarations for type-prefixed functions (Lexer takes pointer, Parser utility funcs take value)
        self.line("SigilValue sigil_Lexer____next_token(SigilValue* self);");
        self.line("SigilValue sigil_Lexer____peek(SigilValue* self);");
        self.line("SigilValue sigil_Parser____parse_file(SigilValue* self);");
        self.line("SigilValue sigil_TypeChecker____check_file(SigilValue* self, SigilValue file);");
        self.line("SigilValue sigil_ParseError____span(SigilValue self);");
        self.line("SigilValue sigil_ParseError____message(SigilValue self);");
        self.line("SigilValue sigil_Span____merge(SigilValue self, SigilValue other);");
        self.line("SigilValue sigil_Environment____lookup(SigilValue* self, SigilValue name);");
        self.line("SigilValue sigil_Environment____register_builtins(SigilValue* self);");
        self.line("SigilValue sigil_Environment____define(SigilValue* self, SigilValue name, SigilValue val);");
        self.line("SigilValue sigil_TypeEnv____define(SigilValue* self, SigilValue name, SigilValue ty, SigilValue evidence);");
        self.line("SigilValue sigil_TypeEnv____fresh_id(SigilValue* self);");
        self.line("SigilValue sigil_TypeEnv____get_var_id(SigilValue* self, SigilValue name);");
        // CG-078: Wrapper functions for cross-module calls
        self.line("static inline SigilValue sigil_next_token(SigilValue lexer) { return sigil_Lexer____next_token(&lexer); }");
        self.line("static inline SigilValue sigil_peek(SigilValue lexer) { return sigil_Lexer____peek(&lexer); }");
        self.line("static inline SigilValue sigil_parse_file(SigilValue parser) { return sigil_Parser____parse_file(&parser); }");
        self.line("static inline SigilValue sigil_check_file(SigilValue checker, SigilValue file) { return sigil_TypeChecker____check_file(&checker, file); }");
        self.line("static inline SigilValue sigil_span(SigilValue err) { return sigil_ParseError____span(err); }");
        self.line("static inline SigilValue sigil_message(SigilValue err) { return sigil_ParseError____message(err); }");
        self.line("static inline SigilValue sigil_merge(SigilValue a, SigilValue b) { return sigil_Span____merge(a, b); }");
        self.line("static inline SigilValue sigil_lookup(SigilValue env, SigilValue name) { return sigil_Environment____lookup(&env, name); }");
        self.line("static inline SigilValue sigil_register_builtins(SigilValue env) { return sigil_Environment____register_builtins(&env); }");
        // CG-079: Handle both Environment.define (3 args) and TypeEnv.define (4 args) using variadic macro
        self.line("static inline SigilValue sigil_define3(SigilValue env, SigilValue name, SigilValue val) { return sigil_Environment____define(&env, name, val); }");
        self.line("static inline SigilValue sigil_define4(SigilValue env, SigilValue name, SigilValue ty, SigilValue ev) { return sigil_TypeEnv____define(&env, name, ty, ev); }");
        self.line("#define SIGIL_GET_DEFINE_MACRO(_1, _2, _3, _4, NAME, ...) NAME");
        self.line("#define sigil_define(...) SIGIL_GET_DEFINE_MACRO(__VA_ARGS__, sigil_define4, sigil_define3, sigil_define2)(__VA_ARGS__)");
        // CG-079: Wrappers for TypeEnv methods
        self.line("static inline SigilValue sigil_fresh_id(SigilValue env) { return sigil_TypeEnv____fresh_id(&env); }");
        self.line("static inline SigilValue sigil_get_var_id(SigilValue env, SigilValue name) { return sigil_TypeEnv____get_var_id(&env, name); }");
