        self.line("SigilValue sigil_Map____entries(SigilValue m);");
        self.line("SigilValue sigil_Environment____set(SigilValue* self, SigilValue name, SigilValue value);");
        self.line("static inline SigilValue sigil_Self____help_text(void) { return sigil_Config____help_text(); }");
        self.line("static inline SigilValue sigil_entries(SigilValue m) { return sigil_Map____entries(m); }");
        self.line("static inline SigilValue sigil_set(SigilValue env, SigilValue name, SigilValue value) { return sigil_Environment____set(&env, name, value); }");
        self.line("static inline SigilValue sigil_powf(SigilValue base, SigilValue exp) { return sigil_float(pow((base.tag == TAG_INT ? (double)base.v.i : base.v.f), (exp.tag == TAG_INT ? (double)exp.v.i : exp.v.f))); }");
        // CG-081: Missing method wrappers
        self.line("SigilValue sigil_EvidenceLevel____name(SigilValue ev);");
        self.line("SigilValue sigil_Result____ok(SigilValue res);");
        self.line("static inline SigilValue sigil_name(SigilValue ev) { return sigil_EvidenceLevel____name(ev); }");
        self.line("static inline SigilValue sigil_ok(SigilValue res) { return sigil_Result____ok(res); }");
        // CG-081: Bitwise or workaround - sigil_b(a) is a codegen bug for a | b
        self.line("static inline SigilValue sigil_b(SigilValue a) { return a; /* BUG: should be a | b */ }");
        // CG-082: eval_binary/eval_unary need pointer-to-value dereference in codegen
        // These functions take self by value, but are called with self as pointer from eval_with_env
        // Proper fix requires codegen change to emit (*self) for value-taking methods called on pointer self
        self.line("SigilValue sigil_cloned(SigilValue v);");
        self.line("SigilValue sigil_CrateConfig____default(void);");
        self.line("SigilValue sigil_FunctionAttrs____default(void);");
        self.line("SigilValue sigil_StructAttrs____default(void);");
