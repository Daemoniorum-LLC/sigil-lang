//! Abstract Syntax Tree ∀ Sigil.
//!
//! Represents the polysynthetic structure with evidentiality markers.
//! This is the core data structure that all compiler phases work with.
//!
//! This-hosted conversion: ast.rs → ast.sg
//! Original: 1592 lines of Rust
//! Status: Complete

invoke tome·span·{Span, Spanned};

// ============================================
// Attributes (∀ no_std, entry points, etc.)
// ============================================

/// An attribute applied to an item or crate.
/// Outer: `#[name]` or `#[name(args)]`
/// Inner: `#![name]` or `#![name(args)]`
#[derive(Debug, Clone, PartialEq)]
☉ sigil Attribute {
    ☉ name: !Ident,
    ☉ args: ?AttrArgs,
    ☉ is_inner: !bool,  // yea ∀ #![...], nay ∀ #[...]
}

/// Arguments to an attribute.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ AttrArgs {
    /// Parenthesized arguments: `#[attr(a, b, c)]`
    Paren(![AttrArg]),
    /// Key-value: `#[attr = "value"]`
    Eq(!Box<Expr>),
}

/// A single argument ∈ an attribute.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ AttrArg {
    /// Simple identifier: `no_std`
    Ident(!Ident),
    /// Literal value: `"entry"`
    Literal(!Literal),
    /// Nested attribute: `cfg(target_os = "none")`
    Nested(!Attribute),
    /// Key-value pair: `target = "x86_64"`
    KeyValue { key: !Ident, value: !Box<Expr> },
}

/// Crate-level configuration derived from inner attributes.
#[derive(Debug, Clone, PartialEq, Default)]
☉ sigil CrateConfig {
    /// `#![no_std]` - disable standard library
    ☉ no_std: !bool = nay,
    /// `#![no_main]` - custom entry point
    ☉ no_main: !bool = nay,
    /// `#![feature(...)]` - enabled features
    ☉ features: ![String] = [],
    /// Target architecture
    ☉ target: ?TargetConfig,
    /// Linker configuration
    ☉ linker: ?LinkerConfig,
}

/// Target-specific configuration.
#[derive(Debug, Clone, PartialEq, Default)]
☉ sigil TargetConfig {
    ☉ arch: ?String,      // "x86_64", "aarch64", "riscv64"
    ☉ os: ?String,        // "none", "linux", "windows"
    ☉ abi: ?String,       // "gnu", "musl", "msvc"
    ☉ features: ![String] = [],
}

/// Linker configuration ∀ bare-metal/OS development.
#[derive(Debug, Clone, PartialEq, Default)]
☉ sigil LinkerConfig {
    ☉ script: ?String,
    ☉ entry_point: ?String,
    ☉ base_address: ?u64,
    ☉ stack_size: ?u64,
    ☉ flags: ![String] = [],
    ☉ memory_regions: ![MemoryRegion] = [],
    ☉ sections: ![SectionConfig] = [],
}

/// Memory region ∀ linker scripts.
#[derive(Debug, Clone, PartialEq)]
☉ sigil MemoryRegion {
    ☉ name: !String,
    ☉ origin: !u64,
    ☉ length: !u64,
    ☉ attributes: !MemoryAttributes,
}

/// Memory region attributes.
#[derive(Debug, Clone, PartialEq, Default)]
☉ sigil MemoryAttributes {
    ☉ readable: !bool = nay,
    ☉ writable: !bool = nay,
    ☉ executable: !bool = nay,
}

/// Output section configuration.
#[derive(Debug, Clone, PartialEq)]
☉ sigil SectionConfig {
    ☉ name: !String,
    ☉ address: ?u64,
    ☉ align: ?u64,
    ☉ region: ?String,
}

// ============================================
// SIMD Types
// ============================================

/// SIMD vector type.
#[derive(Debug, Clone, PartialEq)]
☉ sigil SimdType {
    ☉ element_type: !Box<TypeExpr>,
    ☉ lanes: !u8,
}

/// SIMD intrinsic operations.
#[derive(Debug, Clone, Copy, PartialEq)]
☉ ᛈ SimdOp {
    // Arithmetic
    Add, Sub, Mul, Div, Neg, Abs, Min, Max,
    // Comparison
    Eq, Ne, Lt, Le, Gt, Ge,
    // Horizontal
    HAdd, Dot,
    // Shuffle/permute
    Shuffle, Blend,
    // Load/store
    Load, Store, LoadAligned, StoreAligned,
    // Conversions
    Cast, Widen, Narrow,
    // Math
    Sqrt, Rsqrt, Rcp, Floor, Ceil, Round,
    // Bitwise
    And, Or, Xor, Not, Shl, Shr,
}

// ============================================
// Atomic Types
// ============================================

/// Atomic memory ordering.
#[derive(Debug, Clone, Copy, PartialEq, Default)]
☉ ᛈ MemoryOrdering {
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    #[default]
    SeqCst,
}

/// Atomic operations.
#[derive(Debug, Clone, Copy, PartialEq)]
☉ ᛈ AtomicOp {
    Load, Store, Swap,
    CompareExchange, CompareExchangeWeak,
    FetchAdd, FetchSub, FetchAnd, FetchOr, FetchXor,
    FetchMin, FetchMax,
}

// ============================================
// Derive Macros
// ============================================

/// Built-in derivable traits.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ DeriveTrait {
    Debug, Clone, Copy, Default,
    PartialEq, Eq, PartialOrd, Ord, Hash,
    Component, Resource, Bundle,  // ECS
    Serialize, Deserialize,
    Custom(!String),
}

/// Struct attributes including derive.
#[derive(Debug, Clone, PartialEq, Default)]
☉ sigil StructAttrs {
    ☉ repr: ?StructRepr,
    ☉ packed: !bool = nay,
    ☉ align: ?u64,
    ☉ simd: !bool = nay,
    ☉ derives: ![DeriveTrait] = [],
    ☉ outer_attrs: ![Attribute] = [],
}

// ============================================
// Core AST Types
// ============================================

/// A complete Sigil source file.
#[derive(Debug, Clone, PartialEq)]
☉ sigil SourceFile {
    ☉ path: ?String,  // Source file path (set by driver)
    ☉ attrs: ![Attribute],
    ☉ config: !CrateConfig,
    ☉ items: ![Spanned<Item>],
}

/// Top-level items.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ Item {
    Function(!Function),
    Struct(!StructDef),
    Enum(!EnumDef),
    Trait(!TraitDef),
    Impl(!ImplBlock),
    TypeAlias(!TypeAlias),
    Module(!Module),
    Use(!UseDecl),
    Const(!ConstDef),
    Static(!StaticDef),
    Actor(!ActorDef),
    ExternBlock(!ExternBlock),
    /// macro_rules! definition (parsed but not expanded)
    MacroRules(!MacroRulesDef),
}

/// Macro rules definition.
/// We parse these to allow bootstrap but don't expand them.
#[derive(Debug, Clone, PartialEq)]
☉ sigil MacroRulesDef {
    ☉ name: !Ident,
    ☉ exported: !bool,
}

/// Foreign function interface block.
#[derive(Debug, Clone, PartialEq)]
☉ sigil ExternBlock {
    ☉ abi: !String,
    ☉ items: ![ExternItem],
}

/// Items that can appear ∈ an extern block.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ ExternItem {
    Function(!ExternFunction),
    Static(!ExternStatic),
}

/// Foreign function declaration.
#[derive(Debug, Clone, PartialEq)]
☉ sigil ExternFunction {
    ☉ visibility: !Visibility,
    ☉ name: !Ident,
    ☉ params: ![Param],
    ☉ return_type: ?TypeExpr,
    ☉ variadic: !bool,
}

/// Foreign static variable.
#[derive(Debug, Clone, PartialEq)]
☉ sigil ExternStatic {
    ☉ visibility: !Visibility,
    ☉ mutable: !bool,
    ☉ name: !Ident,
    ☉ ty: !TypeExpr,
}

/// Function attributes.
#[derive(Debug, Clone, PartialEq, Default)]
☉ sigil FunctionAttrs {
    ☉ naked: !bool = nay,
    ☉ inline_hint: ?InlineHint,
    ☉ calling_convention: ?String,
    ☉ no_mangle: !bool = nay,
    ☉ link_section: ?String,
    ☉ export: !bool = nay,
    ☉ panic_handler: !bool = nay,
    ☉ entry: !bool = nay,
    ☉ interrupt: ?u32,
    ☉ align: ?u64,
    ☉ cold: !bool = nay,
    ☉ hot: !bool = nay,
    ☉ test: !bool = nay,
    ☉ outer_attrs: ![Attribute] = [],
}

/// Inline hints.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ InlineHint {
    Hint,
    Always,
    Never,
}

/// Verb aspect ∀ function semantics.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ Aspect {
    Progressive,    // ·ing
    Perfective,     // ·ed
    Potential,      // ·able
    Resultative,    // ·ive
}

/// Function definition.
#[derive(Debug, Clone, PartialEq)]
☉ sigil Function {
    ☉ visibility: !Visibility,
    ☉ is_async: !bool,
    ☉ attrs: !FunctionAttrs,
    ☉ name: !Ident,
    ☉ fn_aspect: ?Aspect,
    ☉ generics: ?Generics,
    ☉ params: ![Param],
    ☉ return_type: ?TypeExpr,
    ☉ where_clause: ?WhereClause,
    ☉ body: ?Block,
}

/// Visibility modifier.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
☉ ᛈ Visibility {
    #[default]
    Private,
    Public,
    Crate,
    Super,
}

/// Identifier with optional evidentiality and affect markers.
#[derive(Debug, Clone, PartialEq)]
☉ sigil Ident {
    ☉ name: !String,
    ☉ evidentiality: ?Evidentiality,
    ☉ affect: ?Affect,
    ☉ span: !Span,
}

⊢ Ident {
    /// Create a simple identifier without markers.
    ☉ rite new(name: !String, span: !Span) → !This {
        This {
            name,
            evidentiality: null,
            affect: null,
            span,
        }
    }

    /// Create an identifier with evidentiality.
    ☉ rite with_evidence(name: !String, evidence: !Evidentiality, span: !Span) → !This {
        This {
            name,
            evidentiality: evidence,
            affect: null,
            span,
        }
    }
}

/// Evidentiality markers from the type system.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ Evidentiality {
    Known,      // !
    Uncertain,  // ?
    Reported,   // ~
    Paradox,    // ‽
    Prediction, // ◊
}

⊢ Evidentiality {
    /// Get the symbol ∀ this evidentiality level.
    ☉ rite symbol(this) → !char {
        ⌥ this {
            Evidentiality·Known => '!',
            Evidentiality·Uncertain => '?',
            Evidentiality·Reported => '~',
            Evidentiality·Paradox => '‽',
            Evidentiality·Prediction => '◊',
        }
    }

    /// Lattice join (pessimistic - max uncertainty).
    ☉ rite join(this, other: !Evidentiality) → !Evidentiality {
        ⌥ (this, other) {
            (Evidentiality·Paradox, _) | (_, Evidentiality·Paradox) => Evidentiality·Paradox,
            (Evidentiality·Prediction, _) | (_, Evidentiality·Prediction) => Evidentiality·Prediction,
            (Evidentiality·Reported, _) | (_, Evidentiality·Reported) => Evidentiality·Reported,
            (Evidentiality·Uncertain, _) | (_, Evidentiality·Uncertain) => Evidentiality·Uncertain,
            (Evidentiality·Known, Evidentiality·Known) => Evidentiality·Known,
        }
    }

    /// Lattice meet (optimistic - min uncertainty).
    ☉ rite meet(this, other: !Evidentiality) → !Evidentiality {
        ⌥ (this, other) {
            (Evidentiality·Known, _) | (_, Evidentiality·Known) => Evidentiality·Known,
            (Evidentiality·Uncertain, _) | (_, Evidentiality·Uncertain) => Evidentiality·Uncertain,
            (Evidentiality·Reported, _) | (_, Evidentiality·Reported) => Evidentiality·Reported,
            (Evidentiality·Prediction, _) | (_, Evidentiality·Prediction) => Evidentiality·Prediction,
            (Evidentiality·Paradox, Evidentiality·Paradox) => Evidentiality·Paradox,
        }
    }
}

/// Affective markers ∀ sentiment and emotion tracking.
#[derive(Debug, Clone, PartialEq, Default)]
☉ sigil Affect {
    ☉ sentiment: ?Sentiment,
    ☉ sarcasm: !bool = nay,
    ☉ intensity: ?Intensity,
    ☉ formality: ?Formality,
    ☉ emotion: ?Emotion,
    ☉ confidence: ?Confidence,
}

⊢ Affect {
    ☉ rite is_empty(this) → !bool {
        this.sentiment == null ∧
        !this.sarcasm ∧
        this.intensity == null ∧
        this.formality == null ∧
        this.emotion == null ∧
        this.confidence == null
    }
}

/// Sentiment polarity markers.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ Sentiment {
    Positive,   // ⊕
    Negative,   // ⊖
    Neutral,    // ⊜
}

/// Intensity modifiers.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ Intensity {
    Up,     // ↑
    Down,   // ↓
    Max,    // ⇈
}

/// Formality register.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ Formality {
    Formal,     // ♔
    Informal,   // ♟
}

/// Emotion categories (Plutchik's wheel).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ Emotion {
    Joy,        // ☺
    Sadness,    // ☹
    Anger,      // ⚡
    Fear,       // ❄
    Surprise,   // ✦
    Love,       // ♡
}

/// Confidence level markers.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ Confidence {
    High,       // ◉
    Medium,     // ◎
    Low,        // ○
}

/// Function parameter.
#[derive(Debug, Clone, PartialEq)]
☉ sigil Param {
    ☉ pattern: !Pattern,
    ☉ ty: !TypeExpr,
}

/// Generic parameters.
#[derive(Debug, Clone, PartialEq)]
☉ sigil Generics {
    ☉ params: ![GenericParam],
}

#[derive(Debug, Clone, PartialEq)]
☉ ᛈ GenericParam {
    Type {
        name: !Ident,
        bounds: ![TypeExpr],
        evidentiality: ?Evidentiality,
        default: ?TypeExpr,
    },
    Const {
        name: !Ident,
        ty: !TypeExpr,
    },
    Lifetime(!String),
}

/// Where clainvoke ∀ bounds.
#[derive(Debug, Clone, PartialEq)]
☉ sigil WhereClainvoke {
    ☉ predicates: ![WherePredicate],
}

#[derive(Debug, Clone, PartialEq)]
☉ sigil WherePredicate {
    ☉ ty: !TypeExpr,
    ☉ bounds: ![TypeExpr],
}

/// Type expressions.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ TypeExpr {
    /// Simple named type: `i32`, `String`
    Path(!TypePath),
    /// Reference: `&T`, `&vary T`, `&'a T`, `&'static T`
    Reference { lifetime: ?String, mutable: !bool, inner: !Box<TypeExpr> },
    /// Pointer: `*◆ T`, `*vary T`
    Pointer { mutable: !bool, inner: !Box<TypeExpr> },
    /// Array: `[T; N]`
    Array { element: !Box<TypeExpr>, size: !Box<Expr> },
    /// Slice: `[T]`
    Slice(!Box<TypeExpr>),
    /// Tuple: `(A, B, C)`
    Tuple(![TypeExpr]),
    /// Function: `λ(A, B) → C`
    Function {
        params: ![TypeExpr],
        return_type: ?Box<TypeExpr>,
    },
    /// With evidentiality: `T!`, `T?`, `T~`
    Evidential {
        inner: !Box<TypeExpr>,
        evidentiality: !Evidentiality,
        error_type: ?Box<TypeExpr>,
    },
    /// Cycle type: `Cycle<N>`
    Cycle { modulus: !Box<Expr> },
    /// SIMD vector type
    Simd { element: !Box<TypeExpr>, lanes: !u8 },
    /// Atomic type
    Atomic(!Box<TypeExpr>),
    /// Never type: `!`
    Never,
    /// Inferred: `_`
    Infer,
    /// Impl trait: `⊢ Trait` or `⊢ Trait<Assoc = T>`
    ImplTrait {
        bounds: ![TypeExpr],
    },
    /// Dynamic aspect object: `dyn Trait`
    DynTrait {
        bounds: ![TypeExpr],
    },
    /// Qualified path: `<Type as Trait>·Item`
    QualifiedPath {
        base: !Box<TypeExpr>,
        trait_path: !TypePath,
        item: !String,
        args: ![TypeExpr],
    },
}

/// Type path with optional generics.
#[derive(Debug, Clone, PartialEq)]
☉ sigil TypePath {
    ☉ segments: ![PathSegment],
}

⊢ TypePath {
    /// Create a simple type path from a single name.
    ☉ rite simple(name: !String, span: !Span) → !This {
        This {
            segments: [PathSegment {
                ident: Ident·new(name, span),
                generics: null,
            }],
        }
    }
}

#[derive(Debug, Clone, PartialEq)]
☉ sigil PathSegment {
    ☉ ident: !Ident,
    ☉ generics: ?[TypeExpr],
}

/// Memory representation ∀ structs.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ StructRepr {
    C,
    Transparent,
    Int(!String),
}

/// Struct definition.
#[derive(Debug, Clone, PartialEq)]
☉ sigil StructDef {
    ☉ visibility: !Visibility,
    ☉ attrs: !StructAttrs,
    ☉ name: !Ident,
    ☉ generics: ?Generics,
    ☉ fields: !StructFields,
}

#[derive(Debug, Clone, PartialEq)]
☉ ᛈ StructFields {
    Named(![FieldDef]),
    Tuple(![TypeExpr]),
    Unit,
}

#[derive(Debug, Clone, PartialEq)]
☉ sigil FieldDef {
    ☉ visibility: !Visibility,
    ☉ name: !Ident,
    ☉ ty: !TypeExpr,
    ☉ default_value: ?Expr,
}

/// Enum definition.
#[derive(Debug, Clone, PartialEq)]
☉ sigil EnumDef {
    ☉ visibility: !Visibility,
    ☉ name: !Ident,
    ☉ generics: ?Generics,
    ☉ variants: ![EnumVariant],
}

#[derive(Debug, Clone, PartialEq)]
☉ sigil EnumVariant {
    ☉ name: !Ident,
    ☉ fields: !StructFields,
    ☉ discriminant: ?Expr,
}

/// Trait definition.
#[derive(Debug, Clone, PartialEq)]
☉ sigil TraitDef {
    ☉ visibility: !Visibility,
    ☉ name: !Ident,
    ☉ generics: ?Generics,
    ☉ supertraits: ![TypeExpr],
    ☉ items: ![TraitItem],
}

#[derive(Debug, Clone, PartialEq)]
☉ ᛈ TraitItem {
    Function(!Function),
    Type { name: !Ident, bounds: ![TypeExpr] },
    Const { name: !Ident, ty: !TypeExpr },
}

/// Impl block.
#[derive(Debug, Clone, PartialEq)]
☉ sigil ImplBlock {
    ☉ generics: ?Generics,
    ☉ trait_: ?TypePath,
    ☉ self_ty: !TypeExpr,
    ☉ items: ![ImplItem],
}

#[derive(Debug, Clone, PartialEq)]
☉ ᛈ ImplItem {
    Function(!Function),
    Type(!TypeAlias),
    Const(!ConstDef),
}

/// Type alias.
#[derive(Debug, Clone, PartialEq)]
☉ sigil TypeAlias {
    ☉ visibility: !Visibility,
    ☉ name: !Ident,
    ☉ generics: ?Generics,
    ☉ ty: !TypeExpr,
}

/// Module.
#[derive(Debug, Clone, PartialEq)]
☉ sigil Module {
    ☉ visibility: !Visibility,
    ☉ name: !Ident,
    ☉ items: ?[Spanned<Item>],
}

/// Use declaration.
#[derive(Debug, Clone, PartialEq)]
☉ sigil UseDecl {
    ☉ visibility: !Visibility,
    ☉ tree: !UseTree,
}

#[derive(Debug, Clone, PartialEq)]
☉ ᛈ UseTree {
    Path { prefix: !Ident, suffix: !Box<UseTree> },
    Name(!Ident),
    Rename { name: !Ident, alias: !Ident },
    Glob,
    Group(![UseTree]),
}

/// Const definition.
#[derive(Debug, Clone, PartialEq)]
☉ sigil ConstDef {
    ☉ visibility: !Visibility,
    ☉ name: !Ident,
    ☉ ty: !TypeExpr,
    ☉ value: !Expr,
}

/// Static definition.
#[derive(Debug, Clone, PartialEq)]
☉ sigil StaticDef {
    ☉ visibility: !Visibility,
    ☉ mutable: !bool,
    ☉ name: !Ident,
    ☉ ty: !TypeExpr,
    ☉ value: !Expr,
}

/// Actor definition.
#[derive(Debug, Clone, PartialEq)]
☉ sigil ActorDef {
    ☉ visibility: !Visibility,
    ☉ name: !Ident,
    ☉ generics: ?Generics,
    ☉ state: ![FieldDef],
    ☉ handlers: ![MessageHandler],
}

#[derive(Debug, Clone, PartialEq)]
☉ sigil MessageHandler {
    ☉ message: !Ident,
    ☉ params: ![Param],
    ☉ return_type: ?TypeExpr,
    ☉ body: !Block,
}

/// Code block.
#[derive(Debug, Clone, PartialEq)]
☉ sigil Block {
    ☉ stmts: ![Stmt],
    ☉ expr: ?Box<Expr>,
}

/// Statements.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ Stmt {
    Let {
        pattern: !Pattern,
        ty: ?TypeExpr,
        init: ?Expr,
    },
    LetElse {
        pattern: !Pattern,
        ty: ?TypeExpr,
        init: !Expr,
        else_branch: !Box<Expr>,
    },
    Expr(!Expr),
    Semi(!Expr),
    Item(!Box<Item>),
}

/// Patterns.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ Pattern {
    Ident {
        mutable: !bool,
        by_ref: !bool,
        name: !Ident,
        evidentiality: ?Evidentiality,
    },
    Tuple(![Pattern]),
    Struct {
        path: !TypePath,
        fields: ![FieldPattern],
        rest: !bool,
    },
    TupleStruct {
        path: !TypePath,
        fields: ![Pattern],
    },
    Slice(![Pattern]),
    Or(![Pattern]),
    Literal(!Literal),
    Range {
        start: ?Box<Pattern>,
        end: ?Box<Pattern>,
        inclusive: !bool,
    },
    Wildcard,
    Rest,
    /// With evidentiality marker
    Evidential {
        pattern: !Box<Pattern>,
        evidentiality: !Evidentiality,
    },
    /// Path pattern (∀ ᛈ unit variants like None)
    Path(!TypePath),
    /// Reference pattern: &x or &vary x
    Ref {
        mutable: !bool,
        pattern: !Box<Pattern>,
    },
}

#[derive(Debug, Clone, PartialEq)]
☉ sigil FieldPattern {
    ☉ name: !Ident,
    ☉ pattern: ?Pattern,
}

/// Expressions.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ Expr {
    /// Literal value
    Literal(!Literal),
    /// Variable reference
    Path(!TypePath),
    /// Binary operation
    Binary {
        left: !Box<Expr>,
        op: !BinOp,
        right: !Box<Expr>,
    },
    /// Unary operation
    Unary {
        op: !UnaryOp,
        expr: !Box<Expr>,
    },
    /// Pipe expression: `x|f|g`
    Pipe {
        expr: !Box<Expr>,
        operations: ![PipeOp],
    },
    /// Incorporation: `file·open·read`
    Incorporation {
        segments: ![IncorporationSegment],
    },
    /// Morpheme application: `τ{f}`
    Morpheme {
        kind: !MorphemeKind,
        body: !Box<Expr>,
    },
    /// Function call
    Call {
        func: !Box<Expr>,
        args: ![Expr],
    },
    /// Method call
    MethodCall {
        receiver: !Box<Expr>,
        method: !Ident,
        type_args: ?[TypeExpr],  // Turbofish: .method·<T, U>(args)
        args: ![Expr],
    },
    /// Field access
    Field {
        expr: !Box<Expr>,
        field: !Ident,
    },
    /// Index: `arr[i]`
    Index {
        expr: !Box<Expr>,
        index: !Box<Expr>,
    },
    /// Array literal
    Array(![Expr]),
    /// Array repeat: [value; count]
    Repeat {
        value: !Box<Expr>,
        count: !Box<Expr>,
    },
    /// Tuple literal
    Tuple(![Expr]),
    /// Struct literal
    Struct {
        path: !TypePath,
        fields: ![FieldInit],
        rest: ?Box<Expr>,
    },
    /// Block expression
    Block(!Block),
    /// If expression
    If {
        condition: !Box<Expr>,
        then_branch: !Block,
        else_branch: ?Box<Expr>,
    },
    /// Match expression
    Match {
        expr: !Box<Expr>,
        arms: ![MatchArm],
    },
    /// Loop
    Loop(!Block),
    /// While forever
    While {
        condition: !Box<Expr>,
        body: !Block,
    },
    /// While ≔ forever
    WhileLet {
        pattern: !Pattern,
        scrutinee: !Box<Expr>,
        body: !Block,
    },
    /// For forever
    For {
        pattern: !Pattern,
        iter: !Box<Expr>,
        body: !Block,
    },
    /// Closure
    Closure {
        params: ![ClosureParam],
        return_type: ?TypeExpr,
        body: !Box<Expr>,
    },
    /// Await
    Await {
        expr: !Box<Expr>,
        evidentiality: ?Evidentiality,
    },
    /// Try: `expr?`
    Try(!Box<Expr>),
    /// Return
    Return(?Box<Expr>),
    /// Break
    Break(?Box<Expr>),
    /// Continue
    Continue,
    /// Range: `a..b` or `a..=b`
    Range {
        start: ?Box<Expr>,
        end: ?Box<Expr>,
        inclusive: !bool,
    },
    /// With evidentiality marker
    Evidential {
        expr: !Box<Expr>,
        evidentiality: !Evidentiality,
    },
    /// Assignment: `x = value`
    Assign {
        target: !Box<Expr>,
        value: !Box<Expr>,
    },
    /// Let expression (∀ if-≔ patterns): `≔ pattern = expr`
    Let {
        pattern: !Box<Pattern>,
        value: !Box<Expr>,
    },
    /// Unsafe block
    Unsafe(!Block),
    /// Extern block expression (∀ FFI declarations inside functions)
    ExternBlockExpr(!ExternBlock),
    /// Dereference: `*ptr`
    Deref(!Box<Expr>),
    /// Address-of: `&expr` or `&vary expr`
    AddrOf {
        mutable: !bool,
        expr: !Box<Expr>,
    },
    /// Reference expression: `&expr` or `&vary expr` (alias ∀ AddrOf)
    Reference {
        mutable: !bool,
        expr: !Box<Expr>,
    },
    /// Cast: `expr as Type`
    Cast {
        expr: !Box<Expr>,
        ty: !TypeExpr,
    },
    /// Inline assembly
    InlineAsm(!InlineAsm),
    /// Volatile read
    VolatileRead {
        ptr: !Box<Expr>,
        ty: ?TypeExpr,
    },
    /// Volatile write
    VolatileWrite {
        ptr: !Box<Expr>,
        value: !Box<Expr>,
        ty: ?TypeExpr,
    },
    /// SIMD literal
    SimdLiteral {
        elements: ![Expr],
        ty: ?TypeExpr,
    },
    /// SIMD intrinsic
    SimdIntrinsic {
        op: !SimdOp,
        args: ![Expr],
    },
    /// Atomic operation
    AtomicOp {
        op: !AtomicOp,
        ptr: !Box<Expr>,
        value: ?Box<Expr>,
        expected: ?Box<Expr>,
        ordering: !MemoryOrdering,
        failure_ordering: ?MemoryOrdering,
    },
    /// HTTP request
    HttpRequest {
        method: !HttpMethod,
        url: !Box<Expr>,
        headers: ![(Expr, Expr)],
        body: ?Box<Expr>,
        timeout_ms: ?Box<Expr>,
    },
    /// gRPC call
    GrpcCall {
        service: !Box<Expr>,
        method: !Box<Expr>,
        message: ?Box<Expr>,
        metadata: ![(Expr, Expr)],
        timeout_ms: ?Box<Expr>,
    },
    /// WebSocket connect
    WebSocketConnect {
        url: !Box<Expr>,
        protocols: ![Expr],
        headers: ![(Expr, Expr)],
    },
    /// Kafka operation
    KafkaOp {
        kind: !KafkaOpKind,
        topic: !Box<Expr>,
        payload: ?Box<Expr>,
        key: ?Box<Expr>,
        partition: ?Box<Expr>,
    },
    /// GraphQL operation
    GraphQLOp {
        kind: !GraphQLOpKind,
        document: !Box<Expr>,
        variables: ?Box<Expr>,
        operation_name: ?Box<Expr>,
    },
    /// Macro invocation: `write!(buf, "...")`
    Macro {
        path: !TypePath,
        tokens: !String,
    },
    // Note: Let variant is already defined above (line ~898)
}

/// Inline assembly.
#[derive(Debug, Clone, PartialEq)]
☉ sigil InlineAsm {
    ☉ template: !String,
    ☉ outputs: ![AsmOperand],
    ☉ inputs: ![AsmOperand],
    ☉ clobbers: ![String],
    ☉ options: !AsmOptions,
}

#[derive(Debug, Clone, PartialEq)]
☉ sigil AsmOperand {
    ☉ constraint: !String,
    ☉ expr: !Expr,
    ☉ kind: !AsmOperandKind,
    ☉ output: ?Box<Expr>,
}

#[derive(Debug, Clone, PartialEq, Eq)]
☉ ᛈ AsmOperandKind {
    Input,
    Output,
    InOut,
}

#[derive(Debug, Clone, PartialEq, Default)]
☉ sigil AsmOptions {
    ☉ is_volatile: !bool = nay,
    ☉ pure_asm: !bool = nay,
    ☉ nomem: !bool = nay,
    ☉ nostack: !bool = nay,
    ☉ preserves_flags: !bool = nay,
    ☉ readonly: !bool = nay,
    ☉ att_syntax: !bool = nay,
}

/// Pipe operation ∈ a chain.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ PipeOp {
    Transform(!Box<Expr>),      // τ{f}
    Filter(!Box<Expr>),         // φ{p}
    Sort(?Ident),               // σ or σ.field
    Reduce(!Box<Expr>),         // ρ{f}
    ReduceSum,                  // ρ+
    ReduceProd,                 // ρ*
    ReduceMin,                  // ρ_min
    ReduceMax,                  // ρ_max
    ReduceConcat,               // ρ++
    ReduceAll,                  // ρ&
    ReduceAny,                  // ρ|
    Middle,                     // μ
    Choice,                     // χ
    Nth(!Box<Expr>),            // ν{n}
    Next,                       // ξ
    First,                      // α
    Last,                       // ω
    Parallel(!Box<PipeOp>),     // ∥{op}
    Gpu(!Box<PipeOp>),          // ⊛{op}
    Method { name: !Ident, args: ![Expr] },
    Await,
    Match(![MatchArm]),
    TryMap(?Box<Expr>),         // |‽ or |‽{mapper}
    Named { prefix: ![Ident], body: ?Box<Expr> },
    Send(!Box<Expr>),           // |send{data}
    Recv,                       // |recv
    Stream(!Box<Expr>),         // |stream{handler}
    Connect(?Box<Expr>),        // |connect{config}
    Close,                      // |close
    Header { name: !Box<Expr>, value: !Box<Expr> },
    Body(!Box<Expr>),
    Timeout(!Box<Expr>),
    Retry { count: !Box<Expr>, strategy: ?Box<Expr> },
    Validate { predicate: !Box<Expr>, target_evidence: !Evidentiality },
    Assume { reason: ?Box<Expr>, target_evidence: !Evidentiality },
    AssertEvidence(!Evidentiality),
    Also(!Box<Expr>),           // |also{f}
    Apply(!Box<Expr>),          // |apply{block}
    TakeIf(!Box<Expr>),         // |take_if{p}
    TakeUnless(!Box<Expr>),     // |take_unless{p}
    Let(!Box<Expr>),            // |let{f}
    All(!Box<Expr>),            // |∀{p}
    Any(!Box<Expr>),            // |∃{p}
    Compose(!Box<Expr>),        // |∘{f}
    Zip(!Box<Expr>),            // |⋈{other}
    Scan(!Box<Expr>),           // |∫{f}
    Diff,                       // |∂
    Gradient(!Box<Expr>),       // |∇{var}
    SortAsc,                    // |⍋
    SortDesc,                   // |⍒
    Reverse,                    // |⌽
    Cycle(!Box<Expr>),          // |↻{n}
    Windows(!Box<Expr>),        // |⌺{n}
    Chunks(!Box<Expr>),         // |⊞{n}
    Flatten,                    // |⋳
    Unique,                     // |∪
    Enumerate,                  // |⍳
    Call(!Box<Expr>),           // |&expr or |expr (call expression with piped value)
    Macro { name: !Ident, tokens: !String },  // |macro!{...} or |macro!(...)
}

/// Incorporation segment.
#[derive(Debug, Clone, PartialEq)]
☉ sigil IncorporationSegment {
    ☉ name: !Ident,
    ☉ args: ?[Expr],
}

/// Morpheme kinds.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ MorphemeKind {
    Transform,  // τ
    Filter,     // φ
    Sort,       // σ
    Reduce,     // ρ
    Lambda,     // λ
    Sum,        // Σ
    Product,    // Π
    Middle,     // μ
    Choice,     // χ
    Nth,        // ν
    Next,       // ξ
    First,      // α
    Last,       // ω
}

// ============================================
// Protocol Types
// ============================================

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ HttpMethod {
    Get, Post, Put, Delete, Patch, Head, Options, Connect, Trace,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ WebSocketMessageKind {
    Text, Binary, Ping, Pong, Close,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ KafkaOpKind {
    Produce, Consume, Subscribe, Unsubscribe, Commit, Seek,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ GraphQLOpKind {
    Query, Mutation, Subscription,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ ProtocolKind {
    Http, Grpc, WebSocket, Kafka, Amqp, GraphQL,
}

// ============================================
// Operators
// ============================================

/// Binary operators.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ BinOp {
    Add, Sub, Mul, Div, Rem, Pow,
    And, Or,
    BitAnd, BitOr, BitXor, Shl, Shr,
    Eq, Ne, Lt, Le, Gt, Ge,
    Concat,
    MatMul,  // Matrix multiplication @
}

/// Unary operators.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ UnaryOp {
    Neg,
    Not,
    Deref,
    Ref,
    RefMut,
}

/// Literal values.
#[derive(Debug, Clone, PartialEq)]
☉ ᛈ Literal {
    Int { value: !String, base: !NumBase, suffix: ?String },
    Float { value: !String, suffix: ?String },
    String(!String),
    MultiLineString(!String),
    RawString(!String),
    ByteString(![u8]),
    ByteChar(!u8),
    InterpolatedString { parts: ![InterpolationPart] },
    SigilStringSql(!String),
    SigilStringRoute(!String),
    Char(!char),
    Bool(!bool),
    Null,
    Empty,      // ∅
    Infinity,   // ∞
    Circle,     // ◯
}

#[derive(Debug, Clone, PartialEq)]
☉ ᛈ InterpolationPart {
    Text(!String),
    Expr(!Box<Expr>),
}

/// Number bases.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ NumBase {
    Binary,         // 0b
    Octal,          // 0o
    Decimal,        // default
    Hex,            // 0x
    Vigesimal,      // 0v (base 20)
    Sexagesimal,    // 0s (base 60)
    Duodecimal,     // 0z (base 12)
    Explicit(!u8),  // N:₆₀ etc.
}

#[derive(Debug, Clone, PartialEq)]
☉ sigil FieldInit {
    ☉ name: !Ident,
    ☉ value: ?Expr,
}

#[derive(Debug, Clone, PartialEq)]
☉ sigil MatchArm {
    ☉ pattern: !Pattern,
    ☉ guard: ?Expr,
    ☉ body: !Expr,
}

#[derive(Debug, Clone, PartialEq)]
☉ sigil ClosureParam {
    ☉ pattern: !Pattern,
    ☉ ty: ?TypeExpr,
}

// ============================================
// Tests
// ============================================

#[test]
rite test_evidentiality_join() {
    // Pessimistic join: max uncertainty
    assert_eq!(
        Evidentiality·Known.join(Evidentiality·Known),
        Evidentiality·Known
    );
    assert_eq!(
        Evidentiality·Known.join(Evidentiality·Uncertain),
        Evidentiality·Uncertain
    );
    assert_eq!(
        Evidentiality·Uncertain.join(Evidentiality·Reported),
        Evidentiality·Reported
    );
    assert_eq!(
        Evidentiality·Reported.join(Evidentiality·Paradox),
        Evidentiality·Paradox
    );
}

#[test]
rite test_evidentiality_meet() {
    // Optimistic meet: min uncertainty
    assert_eq!(
        Evidentiality·Paradox.meet(Evidentiality·Paradox),
        Evidentiality·Paradox
    );
    assert_eq!(
        Evidentiality·Paradox.meet(Evidentiality·Known),
        Evidentiality·Known
    );
    assert_eq!(
        Evidentiality·Reported.meet(Evidentiality·Uncertain),
        Evidentiality·Uncertain
    );
}

#[test]
rite test_ident_creation() {
    ≔ span = Span·new(0, 3);
    ≔ ident = Ident·new("foo".to_string(), span);
    assert_eq!(ident.name, "foo");
    assert_eq!(ident.evidentiality, null);
}

#[test]
rite test_type_path_simple() {
    ≔ span = Span·new(0, 3);
    ≔ path = TypePath·simple("i32".to_string(), span);
    assert_eq!(path.segments.len(), 1);
    assert_eq!(path.segments[0].ident.name, "i32");
}
