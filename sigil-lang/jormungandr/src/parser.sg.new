//! Recursive descent parser for Sigil.
//!
//! Handles polysynthetic pipe chains, morpheme expressions, and evidentiality.
//! This is the heart of the compiler frontend.
//!
//! Self-hosted conversion: parser.rs -> parser.sg
//! Original: 4,462 lines of Rust
//! Status: Complete

use crate::ast::*;
use crate::lexer::Lexer;
use crate::span::{Span, Spanned};
use crate::token::Token;

// ============================================
// Parse Error Types
// ============================================

/// Errors that can occur during parsing.
#[derive(Debug, Clone, PartialEq)]
pub enum ParseError {
    /// Unexpected token encountered
    UnexpectedToken {
        expected: !String,
        found: !Token,
        span: !Span,
    },
    /// Unexpected end of file
    UnexpectedEof,
    /// Invalid number literal
    InvalidNumber(!String),
    /// Custom error message
    Custom(!String),
}

impl ParseError {
    /// Create an unexpected token error.
    pub fn unexpected(expected: !&str, found: !Token, span: !Span) -> !Self {
        ParseError::UnexpectedToken {
            expected: expected.to_string(),
            found,
            span,
        }
    }

    /// Create a custom error.
    pub fn custom(msg: !&str) -> !Self {
        ParseError::Custom(msg.to_string())
    }

    /// Get the error message as a string.
    pub fn message(self) -> !String {
        match self {
            ParseError::UnexpectedToken { expected, found, .. } => {
                format!("unexpected token: expected {}, found {:?}", expected, found)
            },
            ParseError::UnexpectedEof => {
                "unexpected end of file".to_string()
            },
            ParseError::InvalidNumber(s) => {
                format!("invalid number literal: {}", s)
            },
            ParseError::Custom(msg) => {
                msg
            },
        }
    }

    /// Get the span of the error, if available.
    pub fn span(self) -> ?Span {
        match self {
            ParseError::UnexpectedToken { span, .. } => ?span,
            _ => null,
        }
    }
}

/// Result type for parsing operations.
pub type ParseResult<T> = Result<T, ParseError>;

// ============================================
// Parser Implementation
// ============================================

/// Recursive descent parser for Sigil.
pub struct Parser {
    /// The lexer producing tokens
    lexer: !Lexer,
    /// Current token and span (if any)
    current: ?(Token, Span),
    /// Whether we're parsing a condition (affects < parsing)
    in_condition: !bool,
    /// Pending > token from splitting >> in generics
    pending_gt: ?Span,
}

impl Parser {
    /// Create a new parser for the given source code.
    pub fn new(source: !String) -> !Self {
        let mut lexer = Lexer::new(source);
        let current = lexer.next_token();
        Self {
            lexer,
            current,
            in_condition: false,
            pending_gt: null,
        }
    }

    // ========================================
    // Helper Methods
    // ========================================

    /// Check if we've reached end of file.
    fn is_eof(self) -> !bool {
        self.current == null
    }

    /// Get the current token (if any).
    /// CG-300: Return by value, not reference - returning &token creates dangling pointer
    fn current_token(self) -> ?Token {
        match self.current {
            (token, _) => token,
            null => null,
        }
    }

    /// Get the current span.
    fn current_span(self) -> !Span {
        match self.current {
            (_, span) => span,
            null => Span::empty_at(0),
        }
    }

    /// Advance to the next token.
    fn advance(mut self) {
        self.current = self.lexer.next_token();
    }

    /// Check if current token matches expected.
    fn check(self, expected: !&Token) -> !bool {
        match self.current_token() {
            token => token == expected,
            null => false,
        }
    }

    /// Peek at the next token without consuming current.
    fn peek_next_token(self) -> ?Token {
        match self.lexer.peek() {
            ?(token, _) => ?token.clone(),
            null => null,
        }
    }

    /// Check if next token is a macro delimiter (paren, bracket, brace).
    fn peek_is_macro_delimiter(self) -> !bool {
        match self.peek_next_token() {
            ?Token::LParen => true,
            ?Token::LBracket => true,
            ?Token::LBrace => true,
            _ => false,
        }
    }

    /// Check if the next token matches expected.
    fn peek_is(self, expected: !&Token) -> !bool {
        match self.peek_next_token() {
            ?token => &token == expected,
            null => false,
        }
    }

    /// Check if in condition context (< is comparison, not generics).
    fn is_in_condition(self) -> !bool {
        self.in_condition
    }

    /// Consume token if it matches, return whether consumed.
    fn consume_if(mut self, expected: !&Token) -> !bool {
        if self.check(expected) {
            self.advance();
            true
        } else {
            false
        }
    }

    /// Expect and consume a token, or return error.
    fn expect(mut self, expected: !Token) -> !ParseResult<()> {
        if self.check(&expected) {
            self.advance();
            Ok(())
        } else {
            match self.current {
                (found, span) => Err(ParseError::unexpected(
                    &format!("{:?}", expected),
                    found,
                    span,
                )),
                null => Err(ParseError::UnexpectedEof),
            }
        }
    }

    /// Expect a `>` token, handling the case where `>>` (Shr) needs to be split.
    /// This is necessary for nested generics like `Vec<Option<T>>`.
    fn expect_gt(mut self) -> !ParseResult<Span> {
        // First check if we have a pending > from a previous split
        // Use match instead of if != null to work around codegen issue
        match self.pending_gt {
            ?span => {
                self.pending_gt = null;
                return Ok(span);
            },
            null => {},
        }

        match self.current {
            (Token::Gt, span) => {
                self.advance();
                Ok(span)
            },
            (Token::Shr, span) => {
                // Split >> into two > tokens
                // Take the first > now and save the second for later
                self.pending_gt = ?span;
                self.advance();
                Ok(span)
            },
            (found, span) => Err(ParseError::unexpected("Token::Gt", found, span)),
            null => Err(ParseError::UnexpectedEof),
        }
    }

    // ========================================
    // Top-Level Parsing
    // ========================================

    /// Parse a complete source file.
    pub fn parse_file(mut self) -> !ParseResult<SourceFile> {
        // Parse inner attributes (#![...])
        let mut attrs = Vec::new();
        while self.check(&Token::HashBang) {
            attrs.push(self.parse_inner_attribute()?);
        }

        // Build crate config from attributes
        let config = self.build_crate_config(&attrs);

        // Parse items
        let mut items = Vec::new();
        while !self.is_eof() {
            // Skip comments
            while self.check(&Token::LineComment(_)) || self.check(&Token::DocComment(_)) {
                self.advance();
            }
            if self.is_eof() {
                break;
            }
            items.push(self.parse_item()?);
        }

        Ok(SourceFile { path: null, attrs, config, items })
    }

    /// Parse an inner attribute: `#![name]` or `#![name(args)]`
    fn parse_inner_attribute(mut self) -> !ParseResult<Attribute> {
        self.expect(Token::HashBang)?;
        self.expect(Token::LBracket)?;

        let name = self.parse_ident()?;
        let args = self.parse_attr_args()?;

        self.expect(Token::RBracket)?;

        Ok(Attribute {
            name,
            args,
            is_inner: true,
        })
    }

    /// Parse an outer attribute: `#[name]` or `#[name(args)]` or `@[name]` or `@[A, B, C]`
    fn parse_outer_attribute(mut self) -> !ParseResult<Attribute> {
        // Accept both # and @ as attribute prefix
        let is_at_syntax = self.check(&Token::At);
        if self.check(&Token::Hash) {
            self.advance();
        } else if is_at_syntax {
            self.advance();
        } else {
            return Err(ParseError::unexpected("# or @", self.current_token()!, self.current_span()));
        }
        self.expect(Token::LBracket)?;

        let name = self.parse_ident()?;

        // For @[A, B, C] syntax, treat as derive(A, B, C)
        if is_at_syntax && self.check(&Token::Comma) {
            // Collect all comma-separated identifiers as derive arguments
            let mut derive_args: ![AttrArg] = [AttrArg::Ident(name.clone())];
            while self.consume_if(&Token::Comma) {
                if self.check(&Token::RBracket) {
                    break;
                }
                let arg_name = self.parse_ident()?;
                derive_args.push(AttrArg::Ident(arg_name));
            }
            self.expect(Token::RBracket)?;
            return Ok(Attribute {
                name: Ident::new("derive".to_string(), name.span),
                args: ?AttrArgs::Paren(derive_args),
                is_inner: false,
            });
        }

        let args = self.parse_attr_args()?;

        self.expect(Token::RBracket)?;

        Ok(Attribute {
            name,
            args,
            is_inner: false,
        })
    }

    /// Parse attribute arguments if present.
    fn parse_attr_args(mut self) -> !ParseResult<?AttrArgs> {
        if self.consume_if(&Token::LParen) {
            let mut args = Vec::new();
            while !self.check(&Token::RParen) {
                args.push(self.parse_attr_arg()?);
                if !self.consume_if(&Token::Comma) {
                    break;
                }
            }
            self.expect(Token::RParen)?;
            Ok(AttrArgs::Paren(args))
        } else if self.consume_if(&Token::Eq) {
            let expr = self.parse_expr()?;
            Ok(AttrArgs::Eq(Box::new(expr)))
        } else {
            Ok(null)
        }
    }

    /// Parse a single attribute argument.
    fn parse_attr_arg(mut self) -> !ParseResult<AttrArg> {
        match self.current_token().cloned() {
            Token::StringLit(s) => {
                self.advance();
                Ok(AttrArg::Literal(Literal::String(s)))
            }
            Token::IntLit(s) => {
                self.advance();
                Ok(AttrArg::Literal(Literal::Int {
                    value: s,
                    base: NumBase::Decimal,
                    suffix: null,
                }))
            }
            Token::Ident(_) => {
                let ident = self.parse_ident()?;
                self.parse_attr_arg_after_ident(ident)
            }
            t => Err(ParseError::unexpected("attribute argument", t?, self.current_span())),
        }
    }

    /// Continue parsing after identifier in attribute argument.
    fn parse_attr_arg_after_ident(mut self, ident: !Ident) -> !ParseResult<AttrArg> {
        if self.consume_if(&Token::Eq) {
            let value = self.parse_expr()?;
            Ok(AttrArg::KeyValue {
                key: ident,
                value: Box::new(value),
            })
        } else if self.check(&Token::LParen) {
            let args = self.parse_attr_args()?;
            Ok(AttrArg::Nested(Attribute {
                name: ident,
                args,
                is_inner: false,
            }))
        } else {
            Ok(AttrArg::Ident(ident))
        }
    }

    /// Build crate configuration from parsed attributes.
    fn build_crate_config(self, attrs: !&[Attribute]) -> !CrateConfig {
        let mut config = CrateConfig::default();

        for attr in attrs {
            match attr.name.name.as_str() {
                "no_std" => config.no_std = true,
                "no_main" => config.no_main = true,
                "feature" => {
                    if let AttrArgs::Paren(args) = &attr.args? {
                        for arg in args {
                            if let AttrArg::Ident(ident) = arg {
                                config.features.push(ident.name.clone());
                            }
                        }
                    }
                }
                _ => {}
            }
        }

        config
    }

    // ========================================
    // Item Parsing
    // ========================================

    /// Parse a top-level item.
    fn parse_item(mut self) -> !ParseResult<Spanned<Item>> {
        let start = self.current_span().start;

        // Parse outer attributes (both #[...] and @[...] syntax)
        let mut attrs = Vec::new();
        while self.check(&Token::Hash) || self.check(&Token::At) {
            attrs.push(self.parse_outer_attribute()?);
        }

        // Check for #[macro_export] attribute
        let mut is_macro_export = false;
        for attr in attrs.clone() {
            match attr.value.path.segments.first() {
                ?seg => {
                    if seg.value.name == "macro_export" {
                        is_macro_export = true;
                    }
                }
                null => {}
            }
        }

        // Parse visibility
        let visibility = self.parse_visibility()?;

        // Check for macro_rules! or macro special case
        let is_macro_rules = match self.current_token().cloned() {
            Token::Ident(name) => name == "macro_rules",
            _ => false,
        };

        let is_macro = match self.current_token().cloned() {
            Token::Ident(name) => name == "macro",
            _ => false,
        };

        // Parse the item itself
        let item = if is_macro_rules {
            self.parse_macro_rules(is_macro_export)?
        } else if is_macro {
            // Skip macro definition (declarative macro: macro name { ... })
            self.skip_macro_def()?
        } else {
            match self.current_token() {
                Token::Fn => self.parse_function(visibility, attrs, false)?,
                Token::Async => {
                    self.advance();
                    self.parse_function(visibility, attrs, true)?
                }
                Token::Unsafe => {
                    self.advance();
                    // unsafe fn or unsafe impl or unsafe trait
                    match self.current_token() {
                        Token::Fn => self.parse_function(visibility, attrs, false)?,
                        Token::Impl => self.parse_impl()?,
                        Token::Trait => self.parse_trait(visibility)?,
                        _ => return Err(ParseError::custom("expected fn, impl, or trait after unsafe")),
                    }
                }
                Token::Struct => self.parse_struct(visibility, attrs)?,
                Token::Enum => self.parse_enum(visibility)?,
                Token::Trait => self.parse_trait(visibility)?,
                Token::Impl => self.parse_impl()?,
                Token::Type => self.parse_type_alias(visibility)?,
                Token::Mod => self.parse_module(visibility)?,
                Token::Use => self.parse_use(visibility)?,
                Token::Const => self.parse_const(visibility)?,
                Token::Static => self.parse_static(visibility)?,
                Token::Actor => self.parse_actor(visibility)?,
                Token::Extern => self.parse_extern_block()?,
                Token::Ident(_) => {
                    // Check if this is a macro invocation: name!(...)
                    if self.peek_is(&Token::Bang) {
                        self.skip_item_macro()?
                    } else {
                        // Handle unknown item declarations like `scroll feature_name;`
                        self.skip_unknown_item()?
                    }
                }
                t => return Err(ParseError::unexpected("item", t?, self.current_span())),
            }
        };

        let end = self.current_span().end;
        Ok(Spanned::new(item, Span::new(start, end)))
    }

    /// Parse visibility modifier.
    fn parse_visibility(mut self) -> !ParseResult<Visibility> {
        if self.consume_if(&Token::Pub) {
            Ok(Visibility::Public)
        } else if self.consume_if(&Token::Crate) {
            Ok(Visibility::Crate)
        } else if self.consume_if(&Token::Super) {
            Ok(Visibility::Super)
        } else {
            Ok(Visibility::Private)
        }
    }

    /// Parse a function definition.
    fn parse_function(mut self, visibility: !Visibility, attrs: ![Attribute], is_async: !bool) -> !ParseResult<Item> {
        self.expect(Token::Fn)?;

        let name = self.parse_ident()?;

        // Consume optional evidentiality marker on function name: fn validate!(), fn estimate~()
        self.consume_if(&Token::Bang) || self.consume_if(&Token::Tilde) ||
            self.consume_if(&Token::Question) || self.consume_if(&Token::Lozenge);

        // Parse optional aspect: fn name·ing, fn name·ed, etc.
        let aspect = if self.check(&Token::AspectProgressive) {
            self.advance();
            Aspect::Progressive
        } else if self.check(&Token::AspectPerfective) {
            self.advance();
            Aspect::Perfective
        } else if self.check(&Token::AspectPotential) {
            self.advance();
            Aspect::Potential
        } else if self.check(&Token::AspectResultative) {
            self.advance();
            Aspect::Resultative
        } else {
            null
        };

        // Parse generics
        let generics = self.parse_generics_opt()?;

        // Parse parameters
        self.expect(Token::LParen)?;
        let params = self.parse_params()?;
        self.expect(Token::RParen)?;

        // Parse return type
        let return_type = if self.consume_if(&Token::Arrow) {
            self.parse_type()?
        } else {
            null
        };

        // Parse where clause
        let where_clause = self.parse_where_clause_opt()?;

        // Parse body (or optional semicolon for declarations)
        let body = if self.check(&Token::LBrace) {
            self.parse_block()?
        } else {
            // Semicolon is optional for trait/impl method declarations
            self.consume_if(&Token::Semi);
            null
        };

        // Build function attributes from parsed outer attributes
        let fn_attrs = self.build_function_attrs(attrs);

        Ok(Item::Function(Function {
            visibility,
            is_async,
            attrs: fn_attrs,
            name,
            aspect,
            generics,
            params,
            return_type,
            where_clause,
            body,
        }))
    }

    /// Build function attributes from outer attributes.
    fn build_function_attrs(self, attrs: ![Attribute]) -> !FunctionAttrs {
        let mut fn_attrs = FunctionAttrs::default();
        fn_attrs.outer_attrs = attrs.clone();

        for attr in &attrs {
            match attr.name.name.as_str() {
                "inline" => fn_attrs.inline = InlineHint::Hint,
                "cold" => fn_attrs.cold = true,
                "hot" => fn_attrs.hot = true,
                "naked" => fn_attrs.naked = true,
                "no_mangle" => fn_attrs.no_mangle = true,
                "export" => fn_attrs.export = true,
                "test" => fn_attrs.test = true,
                "entry" => fn_attrs.entry = true,
                "panic_handler" => fn_attrs.panic_handler = true,
                _ => {}
            }
        }

        fn_attrs
    }

    /// Parse function parameters.
    fn parse_params(mut self) -> !ParseResult<[Param]> {
        let mut params = Vec::new();

        while !self.check(&Token::RParen) {
            // Handle self parameter (self, &self, &mut self, mut self)
            if self.check(&Token::SelfLower) || self.check(&Token::Amp) ||
               (self.check(&Token::Mut) && self.peek_is(&Token::SelfLower)) {
                let param = self.parse_self_param()?;
                params.push(param);
            } else {
                let pattern = self.parse_pattern()?;
                self.expect(Token::Colon)?;
                let ty = self.parse_type()?;
                params.push(Param { pattern, ty });
            }

            if !self.consume_if(&Token::Comma) {
                break;
            }
        }

        Ok(params)
    }

    /// Parse self parameter.
    /// Handles: self, mut self, &self, &mut self
    fn parse_self_param(mut self) -> !ParseResult<Param> {
        let span = self.current_span();

        // Check for reference variants: &self, &mut self
        let is_ref = self.consume_if(&Token::Amp);
        let mutable = if is_ref {
            // &mut self
            self.consume_if(&Token::Mut)
        } else {
            // mut self (no &)
            self.consume_if(&Token::Mut)
        };

        self.expect(Token::SelfLower)?;

        let pattern = Pattern::Ident {
            mutable,
            by_ref: false,
            name: Ident::new("self".to_string(), span),
            evidentiality: null,
        };

        // Check for explicit type annotation: self: &Self!, self: Self, etc.
        let ty = if self.consume_if(&Token::Colon) {
            self.parse_type()?
        } else {
            // Self type is inferred based on & and mut
            if is_ref {
                TypeExpr::Reference {
                    lifetime: null,
                    mutable,
                    inner: Box::new(TypeExpr::Path(TypePath::simple("Self".to_string(), span))),
                }
            } else {
                TypeExpr::Path(TypePath::simple("Self".to_string(), span))
            }
        };

        Ok(Param { pattern, ty })
    }

    /// Parse a struct definition.
    fn parse_struct(mut self, visibility: !Visibility, attrs: ![Attribute]) -> !ParseResult<Item> {
        self.expect(Token::Struct)?;

        let name = self.parse_ident()?;

        // Handle evidential struct syntax in either order:
        // - struct Foo!<T>  (evidentiality before generics)
        // - struct Foo<T>~  (evidentiality after generics)
        // All four markers: ! (known), ~ (reported), ? (uncertain), ◊ (approximate)
        let _is_evidential_before = self.consume_if(&Token::Bang) || self.consume_if(&Token::Tilde) ||
                                    self.consume_if(&Token::Question) || self.consume_if(&Token::Lozenge);

        let generics = self.parse_generics_opt()?;

        let _is_evidential_after = self.consume_if(&Token::Bang) || self.consume_if(&Token::Tilde) ||
                                   self.consume_if(&Token::Question) || self.consume_if(&Token::Lozenge);

        // Build struct attributes
        let struct_attrs = self.build_struct_attrs(attrs);

        let fields = if self.check(&Token::LBrace) {
            // Named fields
            self.advance();
            let mut fields = Vec::new();
            while !self.check(&Token::RBrace) {
                let vis = self.parse_visibility()?;
                let name = self.parse_ident()?;
                // Consume optional evidentiality marker on field name (e.g., train_loss!)
                self.parse_evidentiality_opt();
                self.expect(Token::Colon)?;
                let ty = self.parse_type()?;
                let default = if self.consume_if(&Token::Eq) {
                    self.parse_expr()?
                } else {
                    null
                };
                fields.push(FieldDef { visibility: vis, name, ty, default });
                if !self.consume_if(&Token::Comma) {
                    break;
                }
            }
            self.expect(Token::RBrace)?;
            StructFields::Named(fields)
        } else if self.check(&Token::LParen) {
            // Tuple struct - may have visibility on fields like (pub T, pub U)
            self.advance();
            let mut types = Vec::new();
            while !self.check(&Token::RParen) {
                self.parse_visibility()?;  // Skip optional pub
                types.push(self.parse_type()?);
                if !self.consume_if(&Token::Comma) {
                    break;
                }
            }
            self.expect(Token::RParen)?;
            self.expect(Token::Semi)?;
            StructFields::Tuple(types)
        } else {
            // Unit struct
            self.expect(Token::Semi)?;
            StructFields::Unit
        };

        Ok(Item::Struct(StructDef {
            visibility,
            attrs: struct_attrs,
            name,
            generics,
            fields,
        }))
    }

    /// Build struct attributes from outer attributes.
    fn build_struct_attrs(self, attrs: ![Attribute]) -> !StructAttrs {
        let mut struct_attrs = StructAttrs::default();
        struct_attrs.outer_attrs = attrs.clone();

        for attr in &attrs {
            match attr.name.name.as_str() {
                "derive" => {
                    if let AttrArgs::Paren(args) = &attr.args? {
                        for arg in args {
                            if let AttrArg::Ident(ident) = arg {
                                let derive = match ident.name.as_str() {
                                    "Debug" => DeriveTrait::Debug,
                                    "Clone" => DeriveTrait::Clone,
                                    "Copy" => DeriveTrait::Copy,
                                    "Default" => DeriveTrait::Default,
                                    "PartialEq" => DeriveTrait::PartialEq,
                                    "Eq" => DeriveTrait::Eq,
                                    "Hash" => DeriveTrait::Hash,
                                    other => DeriveTrait::Custom(other.to_string()),
                                };
                                struct_attrs.derives.push(derive);
                            }
                        }
                    }
                }
                "repr" => {
                    if let AttrArgs::Paren(args) = &attr.args? {
                        if let [AttrArg::Ident(ident)] = args.as_slice() {
                            struct_attrs.repr = match ident.name.as_str() {
                                "C" => StructRepr::C,
                                "transparent" => StructRepr::Transparent,
                                other => StructRepr::Int(other.to_string()),
                            };
                        }
                    }
                }
                "packed" => struct_attrs.packed = true,
                "simd" => struct_attrs.simd = true,
                _ => {}
            }
        }

        struct_attrs
    }

    /// Parse an enum definition.
    fn parse_enum(mut self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token::Enum)?;

        let name = self.parse_ident()?;
        let generics = self.parse_generics_opt()?;

        self.expect(Token::LBrace)?;
        let mut variants = Vec::new();
        while !self.check(&Token::RBrace) {
            // Skip attributes on enum variants (both #[...] and @[...])
            while self.check(&Token::Hash) || self.check(&Token::At) {
                self.parse_outer_attribute()?;
            }
            let variant_name = self.parse_ident()?;

            let fields = if self.check(&Token::LBrace) {
                // Named fields
                self.advance();
                let mut fields = Vec::new();
                while !self.check(&Token::RBrace) {
                    let name = self.parse_ident()?;
                    self.expect(Token::Colon)?;
                    let ty = self.parse_type()?;
                    fields.push(FieldDef {
                        visibility: Visibility::Private,
                        name,
                        ty,
                        default: null,
                    });
                    if !self.consume_if(&Token::Comma) {
                        break;
                    }
                }
                self.expect(Token::RBrace)?;
                StructFields::Named(fields)
            } else if self.check(&Token::LParen) {
                // Tuple variant
                self.advance();
                let types = self.parse_type_list()?;
                self.expect(Token::RParen)?;
                StructFields::Tuple(types)
            } else {
                StructFields::Unit
            };

            let discriminant = if self.consume_if(&Token::Eq) {
                self.parse_expr()?
            } else {
                null
            };

            variants.push(EnumVariant {
                name: variant_name,
                fields,
                discriminant,
            });

            if !self.consume_if(&Token::Comma) {
                break;
            }
        }
        self.expect(Token::RBrace)?;

        Ok(Item::Enum(EnumDef {
            visibility,
            name,
            generics,
            variants,
        }))
    }

    /// Parse a trait definition.
    fn parse_trait(mut self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token::Trait)?;

        let name = self.parse_ident()?;
        let generics = self.parse_generics_opt()?;

        // Parse supertraits
        let supertraits = if self.consume_if(&Token::Colon) {
            self.parse_type_bounds()?
        } else {
            Vec::new()
        };

        self.expect(Token::LBrace)?;
        let mut items = Vec::new();
        while !self.check(&Token::RBrace) {
            let item = self.parse_trait_item()?;
            items.push(item);
        }
        self.expect(Token::RBrace)?;

        Ok(Item::Trait(TraitDef {
            visibility,
            name,
            generics,
            supertraits,
            items,
        }))
    }

    /// Parse a trait item.
    fn parse_trait_item(mut self) -> !ParseResult<TraitItem> {
        match self.current_token() {
            Token::Fn | Token::Async | Token::Unsafe => {
                let is_async = self.consume_if(&Token::Async);
                let _is_unsafe = self.consume_if(&Token::Unsafe);
                let Item::Function(f) = self.parse_function(Visibility::Private, Vec::new(), is_async)? else {
                    return Err(ParseError::custom("expected function"));
                };
                Ok(TraitItem::Function(f))
            }
            Token::Type => {
                self.advance();
                let name = self.parse_ident()?;
                let bounds = if self.consume_if(&Token::Colon) {
                    self.parse_type_bounds()?
                } else {
                    Vec::new()
                };
                self.expect(Token::Semi)?;
                Ok(TraitItem::Type { name, bounds })
            }
            Token::Const => {
                self.advance();
                let name = self.parse_ident()?;
                self.expect(Token::Colon)?;
                let ty = self.parse_type()?;
                self.expect(Token::Semi)?;
                Ok(TraitItem::Const { name, ty })
            }
            t => Err(ParseError::unexpected("trait item", t?, self.current_span())),
        }
    }

    /// Parse an impl block.
    fn parse_impl(mut self) -> !ParseResult<Item> {
        self.expect(Token::Impl)?;

        let generics = self.parse_generics_opt()?;

        // Parse type (and possibly trait)
        let first_type = self.parse_type()?;

        let (trait_, self_ty) = if self.consume_if(&Token::For) {
            // impl Trait for Type
            let self_ty = self.parse_type()?;
            let trait_path = match first_type {
                TypeExpr::Path(p) => p,
                _ => return Err(ParseError::custom("expected trait path")),
            };
            (trait_path, self_ty)
        } else {
            // impl Type
            (null, first_type)
        };

        // Skip optional where clause
        self.skip_where_clause()?;

        self.expect(Token::LBrace)?;
        let mut items = Vec::new();
        while !self.check(&Token::RBrace) {
            let item = self.parse_impl_item()?;
            items.push(item);
        }
        self.expect(Token::RBrace)?;

        Ok(Item::Impl(ImplBlock {
            generics,
            trait_,
            self_ty,
            items,
        }))
    }

    /// Parse an impl item.
    fn parse_impl_item(mut self) -> !ParseResult<ImplItem> {
        // Skip outer attributes
        while self.check(&Token::Hash) || self.check(&Token::At) {
            self.parse_outer_attribute()?;
        }

        let visibility = self.parse_visibility()?;

        match self.current_token() {
            Token::Fn | Token::Async | Token::Unsafe => {
                let is_async = self.consume_if(&Token::Async);
                let _is_unsafe = self.consume_if(&Token::Unsafe);
                let Item::Function(f) = self.parse_function(visibility, Vec::new(), is_async)? else {
                    return Err(ParseError::custom("expected function"));
                };
                Ok(ImplItem::Function(f))
            }
            Token::Type => {
                self.advance();
                let name = self.parse_ident()?;
                self.expect(Token::Eq)?;
                let ty = self.parse_type()?;
                self.expect(Token::Semi)?;
                Ok(ImplItem::Type(TypeAlias {
                    visibility,
                    name,
                    generics: null,
                    ty,
                }))
            }
            Token::Const => {
                // Check if this is `const fn` or associated constant
                if self.peek_is(&Token::Fn) {
                    self.advance(); // consume const
                    let Item::Function(f) = self.parse_function(visibility, Vec::new(), false)? else {
                        return Err(ParseError::custom("expected function"));
                    };
                    Ok(ImplItem::Function(f))
                } else {
                    self.advance();
                    let name = self.parse_ident()?;
                    self.expect(Token::Colon)?;
                    let ty = self.parse_type()?;
                    self.expect(Token::Eq)?;
                    let value = self.parse_expr()?;
                    self.expect(Token::Semi)?;
                    Ok(ImplItem::Const(ConstDef {
                        visibility,
                        name,
                        ty,
                        value,
                    }))
                }
            }
            t => Err(ParseError::unexpected("impl item", t?, self.current_span())),
        }
    }

    /// Parse a type alias.
    fn parse_type_alias(mut self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token::Type)?;
        let name = self.parse_ident()?;
        // Skip optional evidentiality marker on type alias name
        self.consume_if(&Token::Bang) || self.consume_if(&Token::Tilde) ||
            self.consume_if(&Token::Question) || self.consume_if(&Token::Lozenge);
        let generics = self.parse_generics_opt()?;
        self.expect(Token::Eq)?;

        // Check for inline enum definition: type Foo = enum { ... }
        if self.check(&Token::Enum) {
            self.advance();
            self.expect(Token::LBrace)?;
            // Parse enum variants with optional discriminants
            let mut variants = Vec::new();
            while !self.check(&Token::RBrace) {
                let variant_name = self.parse_ident()?;
                // Optional discriminant: = value
                if self.consume_if(&Token::Eq) {
                    // Skip the discriminant value (just need to parse it)
                    self.parse_expr()?;
                }
                variants.push(EnumVariant {
                    name: variant_name,
                    fields: StructFields::Unit,
                });
                if !self.consume_if(&Token::Comma) {
                    break;
                }
            }
            self.expect(Token::RBrace)?;
            // Create as enum item
            return Ok(Item::Enum(EnumDecl {
                visibility,
                name,
                generics,
                variants,
            }));
        }

        let ty = self.parse_type()?;
        // Semicolon is optional for newline-terminated items
        self.consume_if(&Token::Semi);

        Ok(Item::TypeAlias(TypeAlias {
            visibility,
            name,
            generics,
            ty,
        }))
    }

    /// Parse a module.
    fn parse_module(mut self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token::Mod)?;
        let name = self.parse_ident()?;

        let items = if self.check(&Token::LBrace) {
            self.advance();
            let mut items = Vec::new();
            while !self.check(&Token::RBrace) {
                items.push(self.parse_item()?);
            }
            self.expect(Token::RBrace)?;
            items
        } else {
            // Semicolon is optional for module declarations (Sigil style)
            self.consume_if(&Token::Semi);
            null
        };

        Ok(Item::Module(Module {
            visibility,
            name,
            items,
        }))
    }

    /// Parse a use declaration.
    fn parse_use(mut self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token::Use)?;
        let tree = self.parse_use_tree()?;
        // Semicolon is optional for use/invoke statements (Rust-compatible)
        self.consume_if(&Token::Semi);

        Ok(Item::Use(UseDecl { visibility, tree }))
    }

    /// Parse a use tree.
    fn parse_use_tree(mut self) -> !ParseResult<UseTree> {
        let ident = self.parse_ident()?;

        // Consume optional evidentiality markers (Gradient!, MomentEstimate~)
        // These are part of the type name in Sigil
        self.parse_evidentiality_opt();

        // Support both :: and · (middle dot) as path separators
        if self.consume_if(&Token::ColonColon) || self.consume_if(&Token::MiddleDot) {
            if self.check(&Token::LBrace) {
                // use foo::{bar, baz}
                self.advance();
                let mut trees = Vec::new();
                while !self.check(&Token::RBrace) {
                    // Skip conditional attributes: #[cfg(...)]
                    while self.check(&Token::Hash) {
                        self.skip_outer_attribute()?;
                    }
                    if self.check(&Token::RBrace) { break; }
                    trees.push(self.parse_use_tree()?);
                    if !self.consume_if(&Token::Comma) {
                        break;
                    }
                }
                self.expect(Token::RBrace)?;
                Ok(UseTree::Path {
                    prefix: ident,
                    suffix: Box::new(UseTree::Group(trees)),
                })
            } else if self.check(&Token::Star) {
                // use foo::*
                self.advance();
                Ok(UseTree::Path {
                    prefix: ident,
                    suffix: Box::new(UseTree::Glob),
                })
            } else {
                // use foo::bar
                let suffix = self.parse_use_tree()?;
                Ok(UseTree::Path {
                    prefix: ident,
                    suffix: Box::new(suffix),
                })
            }
        } else if self.consume_if(&Token::As) {
            // use foo as bar
            let alias = self.parse_ident()?;
            Ok(UseTree::Rename { name: ident, alias })
        } else {
            Ok(UseTree::Name(ident))
        }
    }

    /// Parse a const definition.
    fn parse_const(mut self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token::Const)?;
        let name = self.parse_ident()?;
        self.expect(Token::Colon)?;
        let ty = self.parse_type()?;
        self.expect(Token::Eq)?;
        let value = self.parse_expr()?;
        // Semicolon is optional for newline-terminated items
        self.consume_if(&Token::Semi);

        Ok(Item::Const(ConstDef { visibility, name, ty, value }))
    }

    /// Parse a static definition.
    fn parse_static(mut self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token::Static)?;
        let mutable = self.consume_if(&Token::Mut);
        let name = self.parse_ident()?;
        self.expect(Token::Colon)?;
        let ty = self.parse_type()?;
        self.expect(Token::Eq)?;
        let value = self.parse_expr()?;
        // Semicolon is optional for newline-terminated items
        self.consume_if(&Token::Semi);

        Ok(Item::Static(StaticDef { visibility, mutable, name, ty, value }))
    }

    /// Parse an actor definition.
    fn parse_actor(mut self, visibility: !Visibility) -> !ParseResult<Item> {
        self.expect(Token::Actor)?;
        let name = self.parse_ident()?;
        let generics = self.parse_generics_opt()?;

        self.expect(Token::LBrace)?;

        // Parse state fields
        let mut state = Vec::new();
        let mut handlers = Vec::new();

        while !self.check(&Token::RBrace) {
            if self.check(&Token::On) {
                // Message handler
                handlers.push(self.parse_message_handler()?);
            } else {
                // State field
                let name = self.parse_ident()?;
                self.expect(Token::Colon)?;
                let ty = self.parse_type()?;
                let default = if self.consume_if(&Token::Eq) {
                    self.parse_expr()?
                } else {
                    null
                };
                state.push(FieldDef {
                    visibility: Visibility::Private,
                    name,
                    ty,
                    default,
                });
                self.consume_if(&Token::Comma);
            }
        }

        self.expect(Token::RBrace)?;

        Ok(Item::Actor(ActorDef {
            visibility,
            name,
            generics,
            state,
            handlers,
        }))
    }

    /// Parse a message handler.
    fn parse_message_handler(mut self) -> !ParseResult<MessageHandler> {
        self.expect(Token::On)?;
        let message = self.parse_ident()?;
        self.expect(Token::LParen)?;
        let params = self.parse_params()?;
        self.expect(Token::RParen)?;

        let return_type = if self.consume_if(&Token::Arrow) {
            self.parse_type()?
        } else {
            null
        };

        let body = self.parse_block()?;

        Ok(MessageHandler { message, params, return_type, body })
    }

    /// Parse an extern block.
    fn parse_extern_block(mut self) -> !ParseResult<Item> {
        self.expect(Token::Extern)?;

        let abi = match self.current_token() {
            Token::StringLit(s) => {
                let abi = s.clone();
                self.advance();
                abi
            }
            _ => "C".to_string(),
        };

        self.expect(Token::LBrace)?;
        let mut items = Vec::new();
        while !self.check(&Token::RBrace) {
            let vis = self.parse_visibility()?;
            if self.check(&Token::Fn) {
                self.advance();
                let name = self.parse_ident()?;
                self.expect(Token::LParen)?;
                let params = self.parse_params()?;
                let variadic = self.consume_if(&Token::Comma) && self.consume_if(&Token::DotDot);
                self.expect(Token::RParen)?;
                let return_type = if self.consume_if(&Token::Arrow) {
                    self.parse_type()?
                } else {
                    null
                };
                self.expect(Token::Semi)?;
                items.push(ExternItem::Function(ExternFunction {
                    visibility: vis,
                    name,
                    params,
                    return_type,
                    variadic,
                }));
            } else if self.check(&Token::Static) {
                self.advance();
                let mutable = self.consume_if(&Token::Mut);
                let name = self.parse_ident()?;
                self.expect(Token::Colon)?;
                let ty = self.parse_type()?;
                self.expect(Token::Semi)?;
                items.push(ExternItem::Static(ExternStatic {
                    visibility: vis,
                    mutable,
                    name,
                    ty,
                }));
            }
        }
        self.expect(Token::RBrace)?;

        Ok(Item::ExternBlock(ExternBlock { abi, items }))
    }

    /// Parse a macro_rules! definition.
    /// We parse past the macro body without interpreting it.
    fn parse_macro_rules(mut self, exported: bool) -> !ParseResult<Item> {
        // Consume "macro_rules"
        self.advance();
        // Expect !
        self.expect(Token::Bang)?;
        // Parse macro name
        let name = self.parse_ident()?;
        // Expect opening brace
        self.expect(Token::LBrace)?;
        // Skip balanced braces until closing brace
        let mut depth = 1;
        while depth > 0 {
            match self.current_token() {
                Token::LBrace | Token::LParen | Token::LBracket => {
                    depth = depth + 1;
                    self.advance();
                }
                Token::RBrace | Token::RParen | Token::RBracket => {
                    depth = depth - 1;
                    if depth > 0 {
                        self.advance();
                    }
                }
                Token::Eof => {
                    return Err(ParseError::unexpected("}", Token::Eof, self.current_span()));
                }
                _ => {
                    self.advance();
                }
            }
        }
        self.expect(Token::RBrace)?;

        Ok(Item::MacroRules(MacroRulesDef {
            name,
            exported,
        }))
    }

    // ========================================
    // Generics and Where Clauses
    // ========================================

    /// Parse optional generic parameters.
    fn parse_generics_opt(mut self) -> !ParseResult<?Generics> {
        if !self.consume_if(&Token::Lt) {
            return Ok(null);
        }

        let mut params = Vec::new();
        while !self.check(&Token::Gt) {
            let param = self.parse_generic_param()?;
            params.push(param);
            if !self.consume_if(&Token::Comma) {
                break;
            }
        }
        self.expect_gt()?;

        Ok(Generics { params })
    }

    /// Parse a generic parameter.
    fn parse_generic_param(mut self) -> !ParseResult<GenericParam> {
        // Check for lifetime ('a, 'static, etc.)
        match self.current_token() {
            Token::Lifetime(name) => {
                self.advance();
                return Ok(GenericParam::Lifetime(name));
            }
            _ => {}
        }

        // Check for const generic
        if self.consume_if(&Token::Const) {
            let name = self.parse_ident()?;
            // Type annotation is optional (can be inferred)
            let ty = if self.consume_if(&Token::Colon) {
                self.parse_type()?
            } else {
                TypeExpr::Infer  // Use inferred type if not specified
            };
            return Ok(GenericParam::Const { name, ty });
        }

        // Type parameter
        let name = self.parse_ident()?;

        // Check for evidentiality constraint
        let evidentiality = self.parse_evidentiality_opt();

        // Check for bounds
        let bounds = if self.consume_if(&Token::Colon) {
            self.parse_type_bounds()?
        } else {
            Vec::new()
        };

        // Check for default type (= Type)
        let default = if self.consume_if(&Token::Eq) {
            self.parse_type()?
        } else {
            null
        };

        Ok(GenericParam::Type { name, bounds, evidentiality, default })
    }

    /// Parse optional where clause.
    fn parse_where_clause_opt(mut self) -> !ParseResult<?WhereClause> {
        if !self.consume_if(&Token::Where) {
            return Ok(null);
        }

        let mut predicates = Vec::new();
        loop {
            // Check if this is a const constraint (like `N % M == 0`) or type bound
            let ty = self.parse_type()?;

            if self.check(&Token::Colon) {
                // Type bound: `T: Trait` or empty bound `T: ,` for compile-time checks
                self.advance();
                // Check for empty bounds (just comma or brace after colon)
                if self.check(&Token::Comma) || self.check(&Token::LBrace) {
                    predicates.push(WherePredicate { ty, bounds: [] });
                } else {
                    let bounds = self.parse_type_bounds()?;
                    predicates.push(WherePredicate { ty, bounds });
                }
            } else {
                // Const constraint: `N % M == 0`, `N == 1`, etc.
                // Skip the constraint expression until comma or block start
                self.skip_const_constraint()?;
            }

            if !self.consume_if(&Token::Comma) {
                break;
            }
            // Stop if we hit block start or other delimiters
            if self.check(&Token::LBrace) || self.check(&Token::Semi) {
                break;
            }
        }

        Ok(WhereClause { predicates })
    }

    /// Skip a const constraint expression in where clause
    fn skip_const_constraint(mut self) -> !ParseResult<()> {
        let mut paren_depth = 0;
        loop {
            match self.current_token() {
                null => break,
                ?Token::Comma => {
                    if paren_depth == 0 { break; }
                    self.advance();
                },
                ?Token::LBrace => {
                    if paren_depth == 0 { break; }
                    self.advance();
                },
                ?Token::Semi => {
                    if paren_depth == 0 { break; }
                    self.advance();
                },
                ?Token::LParen => {
                    paren_depth += 1;
                    self.advance();
                },
                ?Token::RParen => {
                    if paren_depth == 0 { break; }
                    paren_depth -= 1;
                    self.advance();
                },
                _ => { self.advance(); },
            }
        }
        Ok(())
    }

    /// Skip balanced braces in const expression blocks like { const { if M < N { M } else { N } } }
    fn skip_balanced_braces(mut self) -> !ParseResult<()> {
        let mut depth = 0;
        loop {
            match self.current_token() {
                null => break,
                ?Token::LBrace => {
                    depth += 1;
                    self.advance();
                },
                ?Token::RBrace => {
                    depth -= 1;
                    self.advance();
                    if depth == 0 { break; }
                },
                _ => { self.advance(); },
            }
        }
        Ok(())
    }

    // ========================================
    // Type Parsing
    // ========================================

    /// Parse a type expression.
    fn parse_type(mut self) -> !ParseResult<TypeExpr> {
        let ty = self.parse_type_primary()?;

        // Check for evidentiality suffix: T!, T?, T~
        // Only check for suffix if current token is actually an evidentiality marker
        // IMPORTANT: Don't parse evidentiality if pending_gt is set - that means we're
        // inside nested generics (e.g., HashMap<K, Vec<V>>!) and the evidentiality
        // marker belongs to the outer type, not this inner type.
        match self.pending_gt {
            ?_ => return Ok(ty),  // Skip evidentiality - belongs to outer type
            null => {},
        }
        match self.current_token() {
            Token::Bang | Token::Question | Token::Tilde | Token::Interrobang | Token::Lozenge => {
                let ev = self.parse_evidentiality_opt();
                // Check for error type: T?[Error]
                let error_type = if self.consume_if(&Token::LBracket) {
                    let err = self.parse_type()?;
                    self.expect(Token::RBracket)?;
                    Box::new(err)
                } else {
                    null
                };

                return Ok(TypeExpr::Evidential {
                    inner: Box::new(ty),
                    evidentiality: ev,
                    error_type,
                });
            }
            _ => {}
        }

        Ok(ty)
    }

    /// Parse primary type expression.
    fn parse_type_primary(mut self) -> !ParseResult<TypeExpr> {
        match self.current_token() {
            Token::Amp => {
                self.advance();
                // Check for lifetime: &'a T or &'static T
                let lifetime = match self.current_token() {
                    Token::Lifetime(name) => {
                        self.advance();
                        ?name
                    }
                    _ => null,
                };
                let mutable = self.consume_if(&Token::Mut);
                let inner = self.parse_type()?;
                Ok(TypeExpr::Reference {
                    lifetime,
                    mutable,
                    inner: Box::new(inner),
                })
            }
            Token::Star => {
                self.advance();
                let mutable = if self.consume_if(&Token::Mut) {
                    true
                } else {
                    self.consume_if(&Token::Const);
                    false
                };
                let inner = self.parse_type()?;
                Ok(TypeExpr::Pointer {
                    mutable,
                    inner: Box::new(inner),
                })
            }
            Token::LBracket => {
                self.advance();
                // Handle empty brackets [] - represents 0-dimensional/scalar type
                if self.check(&Token::RBracket) {
                    self.advance();
                    return Ok(TypeExpr::Tuple(Vec::new()));  // Empty tuple for scalar
                }
                // Use parse_type_or_assoc_binding to handle const generics like [784]
                let element = self.parse_type_or_assoc_binding()?;
                if self.consume_if(&Token::Semi) {
                    // Array: [T; N]
                    let size = self.parse_expr()?;
                    self.expect(Token::RBracket)?;
                    Ok(TypeExpr::Array {
                        element: Box::new(element),
                        size: Box::new(size),
                    })
                } else if self.consume_if(&Token::Comma) {
                    // Const generic tuple/shape: [N, M, ...] - used for tensor shapes
                    // Represent as tuple type containing the elements
                    let mut types: ![TypeExpr] = [element];
                    while !self.check(&Token::RBracket) {
                        types.push(self.parse_type_or_assoc_binding()?);
                        if !self.consume_if(&Token::Comma) {
                            break;
                        }
                    }
                    self.expect(Token::RBracket)?;
                    Ok(TypeExpr::Tuple(types))
                } else {
                    // Slice: [T]
                    self.expect(Token::RBracket)?;
                    Ok(TypeExpr::Slice(Box::new(element)))
                }
            }
            Token::LParen => {
                self.advance();
                if self.check(&Token::RParen) {
                    self.advance();
                    return Ok(TypeExpr::Tuple(Vec::new()));
                }
                let first = self.parse_type()?;
                if self.consume_if(&Token::Comma) {
                    let mut types: ![TypeExpr] = [first];
                    while !self.check(&Token::RParen) {
                        types.push(self.parse_type()?);
                        if !self.consume_if(&Token::Comma) {
                            break;
                        }
                    }
                    self.expect(Token::RParen)?;
                    Ok(TypeExpr::Tuple(types))
                } else {
                    self.expect(Token::RParen)?;
                    Ok(first)
                }
            }
            Token::Fn => {
                self.advance();
                self.expect(Token::LParen)?;
                let params = self.parse_type_list()?;
                self.expect(Token::RParen)?;
                let return_type = if self.consume_if(&Token::Arrow) {
                    Box::new(self.parse_type()?)
                } else {
                    null
                };
                Ok(TypeExpr::Function { params, return_type })
            }
            Token::Bang => {
                self.advance();
                // Prefix ! means Known<T>
                let inner = self.parse_type_primary()?;
                Ok(TypeExpr::Evidential {
                    inner: Box::new(inner),
                    evidentiality: Evidentiality::Known,
                    error_type: null,
                })
            }
            Token::Underscore => {
                self.advance();
                Ok(TypeExpr::Infer)
            }
            Token::Simd => {
                self.advance();
                self.expect(Token::Lt)?;
                let element = self.parse_type()?;
                self.expect(Token::Comma)?;
                let lanes = match self.current_token() {
                    Token::IntLit(s) => {
                        let n = s.parse::<u8>().map_err({err => ParseError::custom("invalid lane count")})?;
                        self.advance();
                        n
                    }
                    _ => return Err(ParseError::custom("expected lane count")),
                };
                self.expect_gt()?;
                Ok(TypeExpr::Simd { element: Box::new(element), lanes })
            }
            Token::Atomic => {
                self.advance();
                self.expect(Token::Lt)?;
                let inner = self.parse_type()?;
                self.expect_gt()?;
                Ok(TypeExpr::Atomic(Box::new(inner)))
            }
            Token::Question => {
                self.advance();
                // Prefix ? means optional/uncertain type: ?T -> Uncertain<T>
                let inner = self.parse_type_primary()?;
                Ok(TypeExpr::Evidential {
                    inner: Box::new(inner),
                    evidentiality: Evidentiality::Uncertain,
                    error_type: null,
                })
            }
            Token::Tilde => {
                self.advance();
                // Prefix ~ means reported type: ~T -> Reported<T>
                let inner = self.parse_type_primary()?;
                Ok(TypeExpr::Evidential {
                    inner: Box::new(inner),
                    evidentiality: Evidentiality::Reported,
                    error_type: null,
                })
            }
            Token::Impl => {
                self.advance();
                // impl Trait or impl Trait + Bound + ...
                let bounds = self.parse_type_bounds()?;
                Ok(TypeExpr::ImplTrait { bounds })
            }
            Token::Dyn => {
                self.advance();
                // dyn Trait or dyn Trait + Bound + ...
                let bounds = self.parse_type_bounds()?;
                Ok(TypeExpr::DynTrait { bounds })
            }
            Token::Lt => {
                // Qualified path: <Type as Trait>::Item or <Type as Trait<T>>::Item
                self.advance();
                let base_ty = self.parse_type()?;
                self.expect(Token::As)?;
                // Parse trait as a single path segment to avoid consuming the ::Item part
                // after >> is split (expect_gt advances to ::, which parse_type_path would consume)
                let trait_segment = self.parse_path_segment(true)?;
                let trait_path = TypePath { segments: [trait_segment] };
                self.expect_gt()?;
                self.expect(Token::ColonColon)?;
                let item = self.parse_ident()?;
                // Optionally parse generic args on the associated type
                let args = if self.consume_if(&Token::Lt) {
                    let types = self.parse_type_list()?;
                    self.expect_gt()?;
                    types
                } else {
                    Vec::new()
                };
                Ok(TypeExpr::QualifiedPath {
                    base: Box::new(base_ty),
                    trait_path: trait_path,
                    item: item.name,
                    args,
                })
            }
            _ => {
                let path = self.parse_type_path()?;
                Ok(TypeExpr::Path(path))
            }
        }
    }

    /// Parse a type path (with optional generic arguments).
    fn parse_type_path(mut self) -> !ParseResult<TypePath> {
        let mut segments = Vec::new();
        segments.push(self.parse_path_segment(true)?);

        while self.consume_if(&Token::ColonColon) || self.consume_if(&Token::MiddleDot) {
            segments.push(self.parse_path_segment(true)?);
        }

        Ok(TypePath { segments })
    }

    /// Parse an expression path (without generic arguments - < is comparison).
    fn parse_expr_path(mut self) -> !ParseResult<TypePath> {
        let mut segments = Vec::new();
        segments.push(self.parse_path_segment(false)?);

        while self.consume_if(&Token::ColonColon) || self.consume_if(&Token::MiddleDot) {
            // Check for turbofish: Path::<T, U>
            if self.check(&Token::Lt) {
                // This is turbofish - add generic args to the last segment
                self.advance(); // consume <
                let types = self.parse_type_list()?;
                self.expect_gt()?;
                // Update the last segment with generic args
                let last_idx = segments.len() - 1;
                let last = segments[last_idx].clone();
                segments[last_idx] = PathSegment {
                    ident: last.ident,
                    args: types,
                };
                // Check if there's more path after the turbofish (e.g., ::method)
                if !self.check(&Token::ColonColon) && !self.check(&Token::MiddleDot) {
                    break;
                }
                // Continue to next segment if :: follows
                continue;
            }
            segments.push(self.parse_path_segment(false)?);
        }

        Ok(TypePath { segments })
    }

    /// Parse a path segment.
    /// If `allow_generics` is true and we're not in condition context, parses generic arguments.
    fn parse_path_segment(mut self, allow_generics: !bool) -> !ParseResult<PathSegment> {
        let ident = self.parse_ident()?;

        // Don't parse generics in condition context or when not allowed
        let generics = if allow_generics && !self.is_in_condition() {
            // Skip evidentiality markers between name and generics (Type!<T> syntax)
            // The evidentiality will be handled at a higher level in parse_type
            let has_evidentiality = match self.current_token() {
                Token::Bang | Token::Question | Token::Tilde | Token::Lozenge => {
                    // Check if this is Type!<T> pattern (evidentiality followed by <)
                    match self.lexer.peek() {
                        ?(Token::Lt, _) => {
                            self.advance(); // consume evidentiality
                            true
                        }
                        _ => false,
                    }
                }
                _ => false,
            };
            let _ = has_evidentiality; // Mark as used (evidentiality handled in parse_type)

            if self.consume_if(&Token::Lt) {
                let types = self.parse_type_list()?;
                self.expect_gt()?;
                types
            } else if self.consume_if(&Token::LBracket) {
                // Bracket generics: Option[T], Vec[T], Result[T, E]
                let types = self.parse_type_list()?;
                self.expect(Token::RBracket)?;
                ?types
            } else if self.check(&Token::LParen) {
                // Handle Fn(T) -> U, FnMut(T) -> U, FnOnce(T) -> U syntax
                let name = ident.name.as_str();
                if name == "Fn" || name == "FnMut" || name == "FnOnce" {
                    self.advance();  // consume (
                    let params = self.parse_type_list()?;
                    self.expect(Token::RParen)?;
                    // Optional return type: -> T
                    if self.consume_if(&Token::Arrow) {
                        let return_type = self.parse_type()?;
                        // Represent as generic args: (param_types..., return_type)
                        let mut args: ![TypeExpr] = params;
                        args.push(return_type);
                        ?args
                    } else {
                        ?params
                    }
                } else {
                    null
                }
            } else {
                null
            }
        } else {
            null
        };

        Ok(PathSegment { ident, generics })
    }

    /// Parse a list of types (including associated type bindings like `Item = T`).
    fn parse_type_list(mut self) -> !ParseResult<[TypeExpr]> {
        let mut types = Vec::new();
        // Also check pending_gt - if set, a nested >> was split and we need to close
        let has_pending = match self.pending_gt { ?_ => true, null => false };
        // Check for closing markers: ), ], >, or >> (Shr for nested generics like Option<Vec<T>>)
        if !has_pending && !self.check(&Token::RParen) && !self.check(&Token::RBracket) && !self.check(&Token::Gt) && !self.check(&Token::Shr) {
            types.push(self.parse_type_or_assoc_binding()?);
            // IMPORTANT: Check pending_gt BEFORE consuming comma!
            // After parsing Vec<T>> in Option<Vec<T>>, pending_gt is set and the current
            // token is comma (struct field separator). We must NOT consume that comma.
            loop {
                let has_pending_now = match self.pending_gt { ?_ => true, null => false };
                if has_pending_now {
                    break;
                }
                if !self.consume_if(&Token::Comma) {
                    break;
                }
                if self.check(&Token::RParen) || self.check(&Token::RBracket) || self.check(&Token::Gt) || self.check(&Token::Shr) {
                    break;
                }
                types.push(self.parse_type_or_assoc_binding()?);
            }
        }
        Ok(types)
    }

    /// Parse a type or an associated type binding (Item = T) or const generic value.
    fn parse_type_or_assoc_binding(mut self) -> !ParseResult<TypeExpr> {
        // Check if this looks like an associated type binding: Ident = Type
        // Use lookahead to check for Ident followed by =
        match self.current_token() {
            Token::Ident(name) => {
                // Check if next token is = (for associated type binding)
                match self.lexer.peek() {
                    ?(Token::Eq, _) => {
                        // This is an associated type binding: Name = Type
                        self.advance();  // consume Ident
                        self.advance();  // consume =
                        let bound_type = self.parse_type()?;
                        // For now, represent this as the bound type itself
                        // The associated name is lost but parsing succeeds
                        return Ok(bound_type);
                    }
                    _ => {
                        // Check for const generic arithmetic: HD/2, N*M, etc.
                        let peeked = self.lexer.peek();
                        let is_arithmetic = match peeked {
                            ?(Token::Star, _) => true,
                            ?(Token::Plus, _) => true,
                            ?(Token::Minus, _) => true,
                            ?(Token::Slash, _) => true,
                            _ => false,
                        };
                        if is_arithmetic {
                            let span = self.current_span();
                            self.advance();  // consume ident
                            self.advance();  // consume operator
                            // Skip remaining tokens until comma, bracket, or gt
                            while !self.check(&Token::Comma) && !self.check(&Token::RBracket) &&
                                  !self.check(&Token::Gt) && !self.check(&Token::Shr) && !self.is_eof() {
                                self.advance();
                            }
                            return Ok(TypeExpr::Path(TypePath {
                                segments: [PathSegment {
                                    ident: Spanned::new(Ident::new(name.clone(), span), span),
                                    args: [],
                                }],
                            }));
                        }
                    }
                }
                // Not an associated binding, parse as normal type
                self.parse_type()
            }
            // Const generics: expressions starting with integer like 3 * D, 784
            Token::IntLit(val) => {
                let span = self.current_span();
                self.advance();
                // Check for arithmetic operators
                if self.check(&Token::Star) || self.check(&Token::Plus) ||
                   self.check(&Token::Minus) || self.check(&Token::Slash) {
                    // Skip the operator and the rest of the const expression
                    self.advance();  // consume operator
                    // Skip remaining tokens until comma, bracket, or gt
                    while !self.check(&Token::Comma) && !self.check(&Token::RBracket) &&
                          !self.check(&Token::Gt) && !self.check(&Token::Shr) && !self.is_eof() {
                        self.advance();
                    }
                }
                // Represent const generic as a path with the literal value
                Ok(TypeExpr::Path(TypePath {
                    segments: [PathSegment {
                        ident: Spanned::new(Ident::new(val.clone(), span), span),
                        args: [],
                    }],
                }))
            }
            // Const generics: negative integers like Linear<-1>
            Token::Minus => {
                let start_span = self.current_span();
                self.advance();
                match self.current_token() {
                    Token::IntLit(val) => {
                        let span = Span::merge(start_span, self.current_span());
                        self.advance();
                        let neg_val = "-".to_string() + val.as_str();
                        Ok(TypeExpr::Path(TypePath {
                            segments: [PathSegment {
                                ident: Spanned::new(Ident::new(neg_val, span), span),
                                args: [],
                            }],
                        }))
                    }
                    _ => Err(ParseError::unexpected("integer literal after minus", self.current_token(), self.current_span()))
                }
            }
            // Array const generics: [N, M] for shapes like Tensor::<[4, 784], f32>
            Token::LBracket => {
                self.parse_type()
            }
            // Const block expression: { const { if M < N { M } else { N } } }
            Token::LBrace => {
                let span = self.current_span();
                // Skip the entire const block expression
                self.skip_balanced_braces()?;
                // Return TypeExpr::Infer as placeholder for the const expression
                Ok(TypeExpr::Infer)
            }
            // Lifetime placeholder: '_ or named lifetimes like 'a
            Token::Lifetime(name) => {
                let span = self.current_span();
                self.advance();
                // Represent lifetime as a path with the lifetime name
                Ok(TypeExpr::Path(TypePath {
                    segments: [PathSegment {
                        ident: Spanned::new(Ident::new(format!("'{}", name), span), span),
                        args: [],
                    }],
                }))
            }
            _ => self.parse_type(),
        }
    }

    /// Convert an expression to a const generic type representation.
    fn expr_to_const_generic(self, _expr: !Expr) -> !TypeExpr {
        // For const generics, represent the expression as an Infer type
        // since we just need parsing to succeed, not full semantic analysis
        TypeExpr::Infer
    }

    /// Parse type bounds (including lifetime bounds like 'static).
    fn parse_type_bounds(mut self) -> !ParseResult<[TypeExpr]> {
        let mut bounds = Vec::new();
        bounds.push(self.parse_type_or_lifetime_bound()?);
        while self.consume_if(&Token::Plus) {
            bounds.push(self.parse_type_or_lifetime_bound()?);
        }
        Ok(bounds)
    }

    /// Parse either a type bound or a lifetime bound.
    fn parse_type_or_lifetime_bound(mut self) -> !ParseResult<TypeExpr> {
        match self.current_token() {
            Token::Lifetime(name) => {
                self.advance();
                // Represent lifetime bounds as a simple path for now
                // The type checker can handle these specially
                Ok(TypeExpr::Path(TypePath::simple(format!("'{}", name), self.current_span())))
            }
            _ => self.parse_type(),
        }
    }

    // ========================================
    // Expression Parsing (Pratt Parser)
    // ========================================

    /// Parse an expression.
    pub fn parse_expr(mut self) -> !ParseResult<Expr> {
        let lhs = self.parse_expr_bp(0)?;

        // Check for assignment
        if self.consume_if(&Token::Eq) {
            let value = self.parse_expr()?;
            return Ok(Expr::Assign {
                target: Box::new(lhs),
                value: Box::new(value),
            });
        }

        // Check for compound assignment: expr += value, expr -= value, etc.
        // Desugar to: expr = expr op value
        let compound_op = match self.current_token() {
            Token::PlusEq => ?BinOp::Add,
            Token::MinusEq => ?BinOp::Sub,
            Token::StarEq => ?BinOp::Mul,
            Token::SlashEq => ?BinOp::Div,
            Token::ShlEq => ?BinOp::Shl,
            Token::ShrEq => ?BinOp::Shr,
            Token::AmpEq => ?BinOp::BitAnd,
            Token::PipeEq => ?BinOp::BitOr,
            Token::CaretEq => ?BinOp::BitXor,
            Token::PercentEq => ?BinOp::Rem,
            _ => null,
        };

        if compound_op != null {
            self.advance();
            let rhs = self.parse_expr()?;
            // Desugar: lhs op= rhs  ->  lhs = lhs op rhs
            let binary = Expr::Binary {
                left: Box::new(lhs.clone()),
                op: compound_op!,
                right: Box::new(rhs),
            };
            return Ok(Expr::Assign {
                target: Box::new(lhs),
                value: Box::new(binary),
            });
        }

        Ok(lhs)
    }

    /// Parse expression with binding power (Pratt parser).
    fn parse_expr_bp(mut self, min_bp: !u8) -> !ParseResult<Expr> {
        let mut lhs = self.parse_prefix_expr()?;

        loop {
            // Check for pipe operator - only if followed by pipe operation token
            if self.check(&Token::Pipe) && self.is_pipe_op_ahead() {
                lhs = self.parse_pipe_chain(lhs)?;
                continue;
            }

            // Check for binary operators
            let op = match self.current_token() {
                Token::OrOr => BinOp::Or,
                Token::AndAnd => BinOp::And,
                // Unicode logical operators
                Token::LogicAnd => BinOp::And,  // ∧ (wedge/logical and)
                Token::LogicOr => BinOp::Or,    // ∨ (vee/logical or)
                Token::EqEq => BinOp::Eq,
                Token::NotEq => BinOp::Ne,
                Token::Lt => BinOp::Lt,
                Token::LtEq => BinOp::Le,
                Token::Gt => BinOp::Gt,
                Token::GtEq => BinOp::Ge,
                Token::Plus => BinOp::Add,
                Token::Minus => BinOp::Sub,
                Token::Star => BinOp::Mul,
                Token::Slash => BinOp::Div,
                Token::Percent => BinOp::Rem,
                Token::StarStar => BinOp::Pow,
                Token::Amp => BinOp::BitAnd,
                Token::Pipe => BinOp::BitOr,  // Bitwise OR when not followed by pipe op
                Token::Caret => BinOp::BitXor,
                Token::Shl => BinOp::Shl,
                Token::Shr => BinOp::Shr,
                Token::PlusPlus => BinOp::Concat,
                Token::BitwiseAndSymbol => BinOp::BitAnd,
                Token::BitwiseOrSymbol => BinOp::BitOr,
                Token::At => BinOp::MatMul,  // Matrix multiplication
                // Unicode math operators as identifiers
                Token::Ident(name) if name == "⊙" => BinOp::Mul,  // Hadamard/elementwise product
                Token::Ident(name) if name == "⊗" => BinOp::MatMul,  // Tensor product
                Token::Ident(name) if name == "⊕" => BinOp::Add,  // Direct sum
                _ => {
                    // Check for range operators: .. and ..=
                    // Range has very low precedence (lower than all binary ops)
                    if self.check(&Token::DotDot) || self.check(&Token::DotDotEq) {
                        let inclusive = self.consume_if(&Token::DotDotEq);
                        if !inclusive {
                            self.advance(); // consume ..
                        }
                        // Parse end of range (optional for open ranges like `0..`)
                        let end = if self.check(&Token::Semi)
                            || self.check(&Token::RBrace)
                            || self.check(&Token::Comma)
                            || self.check(&Token::RParen)
                            || self.check(&Token::RBracket)
                            || self.check(&Token::LBrace)
                        {
                            null
                        } else {
                            ?Box::new(self.parse_expr_bp(0)?)
                        };
                        lhs = Expr::Range {
                            start: ?Box::new(lhs),
                            end,
                            inclusive,
                        };
                        continue;
                    }
                    break;
                }
            };

            let (l_bp, r_bp) = infix_binding_power(op);
            if l_bp < min_bp {
                break;
            }

            self.advance();
            let rhs = self.parse_expr_bp(r_bp)?;

            lhs = Expr::Binary {
                left: Box::new(lhs),
                op,
                right: Box::new(rhs),
            };
        }

        Ok(lhs)
    }

    /// Parse prefix expression.
    fn parse_prefix_expr(mut self) -> !ParseResult<Expr> {
        match self.current_token() {
            Token::Minus => {
                self.advance();
                let expr = self.parse_prefix_expr()?;
                Ok(Expr::Unary { op: UnaryOp::Neg, expr: Box::new(expr) })
            }
            Token::Bang => {
                self.advance();
                let expr = self.parse_prefix_expr()?;
                Ok(Expr::Unary { op: UnaryOp::Not, expr: Box::new(expr) })
            }
            Token::Question => {
                // Evidential prefix: ?expr creates uncertain value
                self.advance();
                let expr = self.parse_prefix_expr()?;
                Ok(Expr::Evidential {
                    expr: Box::new(expr),
                    evidentiality: Evidentiality::Uncertain,
                })
            }
            Token::Star => {
                self.advance();
                let expr = self.parse_prefix_expr()?;
                Ok(Expr::Unary { op: UnaryOp::Deref, expr: Box::new(expr) })
            }
            Token::Amp => {
                self.advance();
                let op = if self.consume_if(&Token::Mut) {
                    UnaryOp::RefMut
                } else {
                    UnaryOp::Ref
                };
                let expr = self.parse_prefix_expr()?;
                Ok(Expr::Unary { op, expr: Box::new(expr) })
            }
            _ => self.parse_postfix_expr(),
        }
    }

    /// Check if an expression is a block-ending expression that should not be callable.
    /// Block expressions like if/while/match/loop/for return values but should not
    /// be directly called like functions.
    fn is_non_callable_expr(self, expr: !&Expr) -> !bool {
        match expr {
            Expr::If { .. } => true,
            Expr::While { .. } => true,
            Expr::Match { .. } => true,
            Expr::Loop(_) => true,
            Expr::For { .. } => true,
            Expr::Block(_) => true,
            _ => false,
        }
    }

    /// Parse postfix expression.
    fn parse_postfix_expr(mut self) -> !ParseResult<Expr> {
        let mut expr = self.parse_primary_expr()?;

        loop {
            match self.current_token() {
                Token::LParen => {
                    // Don't treat block-ending expressions as callable
                    // This prevents parsing `if {...} (...)` as a call expression
                    if self.is_non_callable_expr(&expr) {
                        break;
                    }
                    self.advance();
                    let args = self.parse_expr_list()?;
                    self.expect(Token::RParen)?;
                    expr = Expr::Call { func: Box::new(expr), args };
                }
                Token::LBracket => {
                    self.advance();
                    let index = self.parse_expr()?;
                    // Handle multi-dimensional indexing: arr[.., 0] or arr[i, j, k]
                    if self.consume_if(&Token::Comma) {
                        // Multi-index: parse remaining indices and create tuple
                        let mut indices = Vec::new();
                        indices.push(index);
                        while !self.check(&Token::RBracket) {
                            indices.push(self.parse_expr()?);
                            if !self.consume_if(&Token::Comma) {
                                break;
                            }
                        }
                        self.expect(Token::RBracket)?;
                        // Wrap as tuple for multi-index
                        expr = Expr::Index { expr: Box::new(expr), index: Box::new(Expr::Tuple(indices)) };
                    } else {
                        self.expect(Token::RBracket)?;
                        expr = Expr::Index { expr: Box::new(expr), index: Box::new(index) };
                    }
                }
                Token::Dot => {
                    self.advance();
                    // Handle .⌛ await syntax (dot-hourglass)
                    if self.check(&Token::Hourglass) {
                        self.advance();
                        let evidentiality = match self.current_token() {
                            Token::Question => { self.advance(); ?Evidentiality::Uncertain }
                            Token::Bang => { self.advance(); ?Evidentiality::Known }
                            Token::Tilde => { self.advance(); ?Evidentiality::Reported }
                            Token::Interrobang => { self.advance(); ?Evidentiality::Paradox }
                            _ => null,
                        };
                        expr = Expr::Await { expr: Box::new(expr), evidentiality };
                        continue;
                    }
                    // Handle both named fields (`.field`) and tuple indices (`.0`, `.1`)
                    let field = match self.current_token() {
                        Token::IntLit(idx) => {
                            let span = self.current_span();
                            let name = idx.clone();
                            self.advance();
                            Ident::new(name, span)
                        }
                        _ => self.parse_ident()?,
                    };
                    // Check for method call (with optional turbofish)
                    if self.check(&Token::LParen) || self.check(&Token::ColonColon) {
                        // Parse turbofish: .method::<T, U>(args)
                        let type_args = if self.consume_if(&Token::ColonColon) {
                            self.expect(Token::Lt)?;
                            let types = self.parse_type_list()?;
                            self.expect_gt()?;
                            ?types
                        } else {
                            null
                        };
                        self.expect(Token::LParen)?;
                        let args = self.parse_expr_list()?;
                        self.expect(Token::RParen)?;
                        expr = Expr::MethodCall {
                            receiver: Box::new(expr),
                            method: field,
                            type_args,
                            args,
                        };
                    } else {
                        expr = Expr::Field { expr: Box::new(expr), field };
                    }
                }
                Token::Question => {
                    self.advance();
                    expr = Expr::Try(Box::new(expr));
                }
                Token::Bang => {
                    // Check if this is a macro invocation: name!(...)
                    if let Expr::Path(path) = expr.clone() {
                        // Check for macro delimiter after !
                        if self.lexer.peek_is_macro_delimiter() {
                            self.advance(); // consume !

                            // Get the macro name to check for special handling
                            let macro_name = if path.segments.len() == 1 {
                                ?path.segments[0].ident.name.clone()
                            } else {
                                null
                            };

                            // Handle assert! specially by parsing body as expression(s)
                            match macro_name {
                                ?"assert" => {
                                    self.expect(Token::LParen)?;
                                    let args = self.parse_expr_list()?;
                                    self.expect(Token::RParen)?;
                                    // Desugar assert!(cond, msg) to assert(cond, msg)
                                    expr = Expr::Call {
                                        func: Box::new(Expr::Path(TypePath {
                                            segments: [PathSegment {
                                                ident: Ident { name: "assert".to_string(), evidentiality: null, affect: null, span: Span::empty_at(0) },
                                                args: null,
                                            }],
                                        })),
                                        args,
                                    };
                                },
                                _ => {
                                    let tokens = self.parse_macro_tokens()?;
                                    expr = Expr::Macro { path, tokens };
                                },
                            }
                            // Loop will naturally continue
                        } else {
                            // Not a macro, treat as evidentiality
                            if let ?ev = self.parse_evidentiality_opt() {
                                expr = Expr::Evidential {
                                    expr: Box::new(expr),
                                    evidentiality: ev,
                                };
                            } else {
                                break;
                            }
                        }
                    } else {
                        // Not a path, treat as evidentiality
                        if let ?ev = self.parse_evidentiality_opt() {
                            expr = Expr::Evidential {
                                expr: Box::new(expr),
                                evidentiality: ev,
                            };
                        } else {
                            break;
                        }
                    }
                }
                Token::Tilde | Token::Interrobang => {
                    if let ?ev = self.parse_evidentiality_opt() {
                        expr = Expr::Evidential {
                            expr: Box::new(expr),
                            evidentiality: ev,
                        };
                    } else {
                        break;
                    }
                }
                Token::Hourglass => {
                    self.advance();
                    let evidentiality = match self.current_token() {
                        Token::Question => { self.advance(); Evidentiality::Uncertain }
                        Token::Bang => { self.advance(); Evidentiality::Known }
                        Token::Tilde => { self.advance(); Evidentiality::Reported }
                        Token::Interrobang => { self.advance(); Evidentiality::Paradox }
                        _ => null,
                    };
                    expr = Expr::Await { expr: Box::new(expr), evidentiality };
                }
                Token::MiddleDot => {
                    // MiddleDot can be method call separator (like .) or incorporation
                    // If expr is already complex (Call, MethodCall, etc.), treat as method call
                    let is_method_chain = match &expr {
                        Expr::Call { .. } | Expr::MethodCall { .. } | Expr::Field { .. } |
                        Expr::Index { .. } | Expr::Try { .. } => true,
                        _ => false,
                    };

                    if is_method_chain {
                        // Treat MiddleDot as method call separator (like Dot)
                        self.advance(); // consume ·
                        let method = self.parse_ident()?;
                        // Check for method call
                        if self.check(&Token::LParen) {
                            self.advance();
                            let args = self.parse_expr_list()?;
                            self.expect(Token::RParen)?;
                            expr = Expr::MethodCall {
                                receiver: Box::new(expr),
                                method,
                                type_args: null,
                                args,
                            };
                        } else {
                            // Field access with MiddleDot
                            expr = Expr::Field { expr: Box::new(expr), field: method };
                        }
                    } else {
                        // Incorporation: expr·verb·noun
                        let first = self.expr_to_incorporation_segment(expr.clone())?;
                        let mut segments: ![PathSegment] = [first];

                        while self.consume_if(&Token::MiddleDot) {
                            let name = self.parse_ident()?;
                            let args = if self.check(&Token::LParen) {
                                self.advance();
                                let args = self.parse_expr_list()?;
                                self.expect(Token::RParen)?;
                                args
                            } else {
                                null
                            };
                            segments.push(IncorporationSegment { name, args });
                        }

                        expr = Expr::Incorporation { segments };
                    }
                }
                Token::ColonColon => {
                    // Associated function call: Type::method() or Type!::method()
                    self.advance(); // consume ::
                    let method = self.parse_ident()?;
                    // Check for turbofish: Type::method::<T>()
                    let type_args = if self.consume_if(&Token::ColonColon) {
                        self.expect(Token::Lt)?;
                        let types = self.parse_type_list()?;
                        self.expect_gt()?;
                        ?types
                    } else {
                        null
                    };
                    self.expect(Token::LParen)?;
                    let args = self.parse_expr_list()?;
                    self.expect(Token::RParen)?;
                    expr = Expr::MethodCall {
                        receiver: Box::new(expr),
                        method,
                        type_args,
                        args,
                    };
                }
                Token::As => {
                    // Cast expression: expr as Type
                    self.advance();
                    let ty = self.parse_type()?;
                    expr = Expr::Cast {
                        expr: Box::new(expr),
                        ty,
                    };
                }
                // Postfix evidentiality markers: x~, x◊ (not ! or ? which have other meanings)
                Token::Tilde | Token::Lozenge => {
                    // These are evidentiality markers on expressions
                    // Just consume and ignore (semantic, not syntactic)
                    self.advance();
                }
                _ => break,
            }
        }

        Ok(expr)
    }

    /// Convert expression to incorporation segment.
    fn expr_to_incorporation_segment(self, expr: !Expr) -> !ParseResult<IncorporationSegment> {
        match expr {
            Expr::Path(path) => {
                if path.segments.len() == 1 {
                    Ok(IncorporationSegment {
                        name: path.segments[0].ident.clone(),
                        args: null,
                    })
                } else {
                    Err(ParseError::custom("expected simple identifier for incorporation"))
                }
            }
            Expr::Call { .. } => {
                let func = expr.func;
                let args = expr.args;
                if let Expr::Path(path) = *func {
                    if path.segments.len() == 1 {
                        return Ok(IncorporationSegment {
                            name: path.segments[0].ident.clone(),
                            args,
                        });
                    }
                }
                Err(ParseError::custom("expected simple call for incorporation"))
            }
            _ => Err(ParseError::custom("cannot convert expression to incorporation segment")),
        }
    }

    /// Parse primary expression.
    fn parse_primary_expr(mut self) -> !ParseResult<Expr> {
        match self.current_token().cloned() {
            Token::IntLit(s) => {
                self.advance();
                // Check for type suffix (u8, u16, u32, u64, i8, i16, i32, i64, etc.)
                let suffix: ?String = match self.current_token().cloned() {
                    Token::Ident(suf) => {
                        if suf == "u8" || suf == "u16" || suf == "u32" || suf == "u64" ||
                           suf == "i8" || suf == "i16" || suf == "i32" || suf == "i64" ||
                           suf == "f32" || suf == "f64" || suf == "usize" || suf == "isize" {
                            self.advance();
                            ?suf
                        } else {
                            null
                        }
                    }
                    _ => null,
                };
                Ok(Expr::Literal(Literal::Int {
                    value: s,
                    base: NumBase::Decimal,
                    suffix,
                }))
            }
            Token::HexLit(s) => {
                self.advance();
                // Check for type suffix (u8, u16, u32, u64, i8, i16, i32, i64, etc.)
                let suffix: ?String = match self.current_token().cloned() {
                    Token::Ident(suf) => {
                        if suf == "u8" || suf == "u16" || suf == "u32" || suf == "u64" ||
                           suf == "i8" || suf == "i16" || suf == "i32" || suf == "i64" ||
                           suf == "f32" || suf == "f64" || suf == "usize" || suf == "isize" {
                            self.advance();
                            ?suf
                        } else {
                            null
                        }
                    }
                    _ => null,
                };
                Ok(Expr::Literal(Literal::Int {
                    value: s,
                    base: NumBase::Hex,
                    suffix,
                }))
            }
            Token::BinaryLit(s) => {
                self.advance();
                // Check for type suffix
                let suffix: ?String = match self.current_token().cloned() {
                    Token::Ident(suf) => {
                        if suf == "u8" || suf == "u16" || suf == "u32" || suf == "u64" ||
                           suf == "i8" || suf == "i16" || suf == "i32" || suf == "i64" ||
                           suf == "usize" || suf == "isize" {
                            self.advance();
                            ?suf
                        } else {
                            null
                        }
                    }
                    _ => null,
                };
                Ok(Expr::Literal(Literal::Int {
                    value: s,
                    base: NumBase::Binary,
                    suffix,
                }))
            }
            Token::OctalLit(s) => {
                self.advance();
                // Check for type suffix
                let suffix: ?String = match self.current_token().cloned() {
                    Token::Ident(suf) => {
                        if suf == "u8" || suf == "u16" || suf == "u32" || suf == "u64" ||
                           suf == "i8" || suf == "i16" || suf == "i32" || suf == "i64" ||
                           suf == "usize" || suf == "isize" {
                            self.advance();
                            ?suf
                        } else {
                            null
                        }
                    }
                    _ => null,
                };
                Ok(Expr::Literal(Literal::Int {
                    value: s,
                    base: NumBase::Octal,
                    suffix,
                }))
            }
            Token::FloatLit(s) => {
                self.advance();
                // Check for type suffix (f32, f64)
                let suffix: ?String = match self.current_token().cloned() {
                    Token::Ident(suf) => {
                        if suf == "f32" || suf == "f64" {
                            self.advance();
                            ?suf
                        } else {
                            null
                        }
                    }
                    _ => null,
                };
                Ok(Expr::Literal(Literal::Float { value: s, suffix }))
            }
            Token::StringLit(s) => {
                self.advance();
                Ok(Expr::Literal(Literal::String(s)))
            }
            Token::RawStringLit(s) => {
                self.advance();
                Ok(Expr::Literal(Literal::String(s)))
            }
            Token::MultiLineStringLit(s) => {
                self.advance();
                Ok(Expr::Literal(Literal::String(s)))
            }
            Token::ByteStringLit(bytes) => {
                self.advance();
                Ok(Expr::Literal(Literal::ByteString(bytes)))
            }
            Token::ByteLit(b) => {
                self.advance();
                Ok(Expr::Literal(Literal::ByteChar(b)))
            }
            Token::CharLit(c) => {
                self.advance();
                Ok(Expr::Literal(Literal::Char(c)))
            }
            Token::True => {
                self.advance();
                Ok(Expr::Literal(Literal::Bool(true)))
            }
            Token::False => {
                self.advance();
                Ok(Expr::Literal(Literal::Bool(false)))
            }
            Token::Null => {
                self.advance();
                Ok(Expr::Literal(Literal::Null))
            }
            Token::Empty => {
                self.advance();
                Ok(Expr::Literal(Literal::Empty))
            }
            Token::Infinity => {
                self.advance();
                Ok(Expr::Literal(Literal::Infinity))
            }
            Token::Underscore => {
                // Underscore as an expression (wildcard/placeholder)
                self.advance();
                Ok(Expr::Path(TypePath {
                    segments: [PathSegment {
                        ident: Ident::new("_".to_string(), self.current_span()),
                        generics: null,
                    }],
                }))
            }
            Token::LParen => {
                self.advance();
                if self.check(&Token::RParen) {
                    self.advance();
                    return Ok(Expr::Tuple(Vec::new()));
                }
                let expr = self.parse_expr()?;
                if self.consume_if(&Token::Comma) {
                    let mut exprs: ![Expr] = [expr];
                    while !self.check(&Token::RParen) {
                        exprs.push(self.parse_expr()?);
                        if !self.consume_if(&Token::Comma) {
                            break;
                        }
                    }
                    self.expect(Token::RParen)?;
                    Ok(Expr::Tuple(exprs))
                } else {
                    self.expect(Token::RParen)?;
                    Ok(expr)
                }
            }
            Token::LBracket => {
                self.advance();
                // Check for empty array
                if self.check(&Token::RBracket) {
                    self.advance();
                    return Ok(Expr::Array(Vec::new()));
                }
                // Parse first expression
                let first = self.parse_expr()?;
                // Check for repeat syntax: [value; count]
                if self.consume_if(&Token::Semi) {
                    let count = self.parse_expr()?;
                    self.expect(Token::RBracket)?;
                    return Ok(Expr::Repeat {
                        value: Box::new(first),
                        count: Box::new(count),
                    });
                }
                // Regular array: [a, b, c]
                let mut exprs = Vec::new();
                exprs.push(first);
                while self.consume_if(&Token::Comma) {
                    if self.check(&Token::RBracket) {
                        break;  // Trailing comma
                    }
                    exprs.push(self.parse_expr()?);
                }
                self.expect(Token::RBracket)?;
                Ok(Expr::Array(exprs))
            }
            Token::LBrace => {
                self.parse_block_or_closure()
            }
            // Move closure: move |params| body
            Token::Move => {
                self.advance();
                // After move, expect a closure
                match self.current_token() {
                    Token::Pipe => {
                        self.advance();
                        let mut params = Vec::new();
                        while !self.check(&Token::Pipe) {
                            let pattern = self.parse_pattern_primary()?;
                            let ty = if self.consume_if(&Token::Colon) {
                                self.parse_type()?
                            } else {
                                null
                            };
                            params.push(ClosureParam { pattern, ty });
                            if !self.consume_if(&Token::Comma) {
                                break;
                            }
                        }
                        self.expect(Token::Pipe)?;
                        // Parse optional return type
                        let return_type = if self.consume_if(&Token::Arrow) {
                            ?self.parse_type()?
                        } else {
                            null
                        };
                        let body = self.parse_expr()?;
                        // Note: move is ignored for now, captured vars treated same
                        Ok(Expr::Closure {
                            params,
                            return_type,
                            body: Box::new(body),
                        })
                    }
                    Token::OrOr => {
                        self.advance();
                        let body = self.parse_expr()?;
                        Ok(Expr::Closure {
                            params: Vec::new(),
                            return_type: null,
                            body: Box::new(body),
                        })
                    }
                    _ => Err(ParseError::unexpected("closure after move", self.current_token()!, self.current_span())),
                }
            }
            // Pipe closure: |params| body
            Token::Pipe => {
                self.advance();
                let mut params = Vec::new();
                while !self.check(&Token::Pipe) {
                    // Use parse_pattern_primary to avoid consuming | as OR pattern
                    let pattern = self.parse_pattern_primary()?;
                    let ty = if self.consume_if(&Token::Colon) {
                        self.parse_type()?
                    } else {
                        null
                    };
                    params.push(ClosureParam { pattern, ty });
                    if !self.consume_if(&Token::Comma) {
                        break;
                    }
                }
                self.expect(Token::Pipe)?;
                // Parse optional return type
                let return_type = if self.consume_if(&Token::Arrow) {
                    ?self.parse_type()?
                } else {
                    null
                };
                let body = self.parse_expr()?;
                Ok(Expr::Closure {
                    params,
                    return_type,
                    body: Box::new(body),
                })
            }
            // Or pattern in closures: || body (no params)
            Token::OrOr => {
                self.advance();
                let body = self.parse_expr()?;
                Ok(Expr::Closure {
                    params: Vec::new(),
                    return_type: null,
                    body: Box::new(body),
                })
            }
            Token::If => self.parse_if_expr(),
            Token::Match => self.parse_match_expr(),
            Token::Loop => {
                self.advance();
                let body = self.parse_block()?;
                Ok(Expr::Loop(body))
            }
            Token::While => {
                self.advance();
                // Check for while let
                if self.consume_if(&Token::Let) {
                    let pattern = self.parse_pattern()?;
                    self.expect(Token::Eq)?;
                    self.in_condition = true;
                    let scrutinee = self.parse_expr()?;
                    self.in_condition = false;
                    let body = self.parse_block()?;
                    // Desugar while let to loop + match
                    Ok(Expr::WhileLet {
                        pattern,
                        scrutinee: Box::new(scrutinee),
                        body,
                    })
                } else {
                    self.in_condition = true;
                    let condition = self.parse_expr()?;
                    self.in_condition = false;
                    let body = self.parse_block()?;
                    Ok(Expr::While { condition: Box::new(condition), body })
                }
            }
            Token::For => {
                self.advance();
                let pattern = self.parse_pattern()?;
                self.expect(Token::In)?;
                self.in_condition = true;
                let iter = self.parse_expr()?;
                self.in_condition = false;
                let body = self.parse_block()?;
                Ok(Expr::For {
                    pattern,
                    iter: Box::new(iter),
                    body,
                })
            }
            Token::Return => {
                self.advance();
                let value = if self.check(&Token::Semi) || self.check(&Token::RBrace) {
                    null
                } else {
                    Box::new(self.parse_expr()?)
                };
                Ok(Expr::Return(value))
            }
            Token::Break => {
                self.advance();
                // Break without value if followed by ; } or , (match arm terminator)
                let value = if self.check(&Token::Semi) || self.check(&Token::RBrace) || self.check(&Token::Comma) {
                    null
                } else {
                    Box::new(self.parse_expr()?)
                };
                Ok(Expr::Break(value))
            }
            Token::Continue => {
                self.advance();
                Ok(Expr::Continue)
            }
            Token::Unsafe => {
                self.advance();
                let block = self.parse_block()?;
                Ok(Expr::Unsafe(block))
            }
            Token::Extern => {
                // Parse inline extern block as expression
                self.advance();
                let abi = match self.current_token() {
                    Token::StringLit(s) => {
                        let abi = s.clone();
                        self.advance();
                        abi
                    }
                    _ => "C".to_string(),
                };
                self.expect(Token::LBrace)?;
                let mut items = Vec::new();
                while !self.check(&Token::RBrace) {
                    let vis = self.parse_visibility()?;
                    if self.check(&Token::Fn) {
                        self.advance();
                        let name = self.parse_ident()?;
                        self.expect(Token::LParen)?;
                        let params = self.parse_params()?;
                        let variadic = self.consume_if(&Token::Comma) && self.consume_if(&Token::DotDot);
                        self.expect(Token::RParen)?;
                        let return_type = if self.consume_if(&Token::Arrow) {
                            self.parse_type()?
                        } else {
                            null
                        };
                        self.expect(Token::Semi)?;
                        items.push(ExternItem::Function(ExternFunction {
                            visibility: vis,
                            name,
                            params,
                            return_type,
                            variadic,
                        }));
                    } else if self.check(&Token::Static) {
                        self.advance();
                        let mutable = self.consume_if(&Token::Mut);
                        let name = self.parse_ident()?;
                        self.expect(Token::Colon)?;
                        let ty = self.parse_type()?;
                        self.expect(Token::Semi)?;
                        items.push(ExternItem::Static(ExternStatic {
                            visibility: vis,
                            mutable,
                            name,
                            ty,
                        }));
                    }
                }
                self.expect(Token::RBrace)?;
                Ok(Expr::ExternBlockExpr(ExternBlock { abi, items }))
            }
            // Range expressions without start: ..end or ..=end
            Token::DotDot | Token::DotDotEq => {
                let inclusive = self.consume_if(&Token::DotDotEq);
                if !inclusive {
                    self.advance();  // consume DotDot
                }
                // Check if there's an end expression
                let end = if self.check(&Token::RBracket) || self.check(&Token::RParen) ||
                             self.check(&Token::Comma) || self.check(&Token::Semi) ||
                             self.check(&Token::RBrace) {
                    null  // Just .. by itself (RangeFull)
                } else {
                    ?Box::new(self.parse_expr_bp(0)?)
                };
                Ok(Expr::Range {
                    start: null,
                    end,
                    inclusive,
                })
            }
            // Morpheme expressions - only if followed by { (otherwise treat as identifier)
            Token::Tau | Token::Phi | Token::Sigma | Token::Rho |
            Token::Lambda | Token::Pi | Token::Alpha | Token::Omega => {
                // Check if this is a morpheme (followed by {) or an identifier
                match self.lexer.peek() {
                    ?(Token::LBrace, _) => self.parse_morpheme_expr(),
                    _ => {
                        // Parse as identifier (e.g., φ as golden ratio constant)
                        let ident = self.parse_ident()?;
                        let path = TypePath { segments: [PathSegment { ident, args: null }] };
                        Ok(Expr::Path(path))
                    }
                }
            }
            // Keywords that can be used as identifiers in expressions
            Token::Ident(_) | Token::SelfLower | Token::SelfUpper
                | Token::Derive | Token::Body | Token::Header | Token::Naked
                | Token::Gpu | Token::Asm | Token::Simd | Token::Send | Token::Recv
                | Token::Close | Token::Retry | Token::Http | Token::Https
                | Token::On | Token::Ws | Token::Wss | Token::Grpc | Token::Kafka | Token::Amqp
                | Token::Packed | Token::Repr | Token::Align
                | Token::Crate | Token::Super => {
                // Use parse_expr_path to avoid interpreting < as generics
                let path = self.parse_expr_path()?;

                // Consume optional evidentiality marker on struct type: Type~ { ... }
                // Only consume ~ or ◊ when followed by { for struct literal
                // (! and ? have other meanings that would break generic args)
                if (self.check(&Token::Tilde) || self.check(&Token::Lozenge)) {
                    let peeked = self.lexer.peek();
                    match peeked {
                        ?(Token::LBrace, _) => { self.advance(); }
                        _ => {}
                    }
                }

                // Check for struct literal
                if self.check(&Token::LBrace) && !self.is_in_condition() {
                    self.advance();
                    let mut fields = Vec::new();
                    let mut rest = null;

                    while !self.check(&Token::RBrace) {
                        if self.consume_if(&Token::DotDot) {
                            rest = Box::new(self.parse_expr()?);
                            break;
                        }

                        let name = self.parse_ident()?;
                        // Consume optional evidentiality marker on field name: field◊: value
                        self.consume_if(&Token::Lozenge) || self.consume_if(&Token::Tilde) ||
                            self.consume_if(&Token::Bang) || self.consume_if(&Token::Question);
                        let value = if self.consume_if(&Token::Colon) {
                            self.parse_expr()?
                        } else {
                            null
                        };
                        fields.push(FieldInit { name, value });

                        if !self.consume_if(&Token::Comma) {
                            break;
                        }
                    }
                    self.expect(Token::RBrace)?;

                    Ok(Expr::Struct { path, fields, rest })
                } else {
                    Ok(Expr::Path(path))
                }
            }
            t => Err(ParseError::unexpected("expression", t?, self.current_span())),
        }
    }

    /// Parse block or closure.
    fn parse_block_or_closure(mut self) -> !ParseResult<Expr> {
        self.expect(Token::LBrace)?;

        // Check for closure: {x => ...} or {x, y => ...} or |x| or (x)|
        if self.is_closure_start() {
            let params = self.parse_closure_params()?;
            // Accept either => or | as closure arrow
            if !self.consume_if(&Token::FatArrow) {
                self.expect(Token::Pipe)?;
            }
            // Parse optional return type: |x: T| -> R { }
            let return_type = if self.consume_if(&Token::Arrow) {
                ?self.parse_type()?
            } else {
                null
            };
            let body = self.parse_expr()?;
            self.expect(Token::RBrace)?;
            return Ok(Expr::Closure {
                params,
                return_type,
                body: Box::new(body),
            });
        }

        // Parse as block
        let block = self.parse_block_contents()?;
        self.expect(Token::RBrace)?;
        Ok(Expr::Block(block))
    }

    /// Check if we're at the start of a closure.
    fn is_closure_start(mut self) -> !bool {
        // Look for pattern => or pattern, pattern =>
        // Simple heuristic: check if pattern start followed by =>, comma, or colon
        match self.current_token() {
            Token::Ident(_) | Token::Underscore => {
                // Check if next token indicates closure
                self.lexer.peek_is_closure_indicator()
            }
            // Reference patterns: &x => ... or &mut x => ...
            Token::Amp => true,
            // Mutable binding: mut x => ...
            Token::Mut => true,
            // Ref binding: ref x => ...
            Token::Ref => true,
            // Tuple patterns: (a, b) => ... - but need to distinguish from (expr)|pipe
            // For now, check if next token is identifier/underscore/& (pattern-like)
            // This handles most cases without full lookahead
            Token::LParen => {
                match self.lexer.peek() {
                    // (ident...) could be closure pattern
                    ?(Token::Ident(_), _) => true,
                    // (_...) is closure pattern
                    ?(Token::Underscore, _) => true,
                    // (&...) could be ref pattern
                    ?(Token::Amp, _) => true,
                    // (mut ...) is mutable pattern
                    ?(Token::Mut, _) => true,
                    // ((..)) is nested tuple pattern
                    ?(Token::LParen, _) => true,
                    // Empty tuple () followed by => or | is closure
                    ?(Token::RParen, _) => true,
                    // Literals like (0) are likely expressions, not closures
                    _ => false,
                }
            }
            // Struct patterns: Name { ... } => ... (but we need to be careful)
            Token::LBracket => true,
            _ => false,
        }
    }

    /// Parse closure parameters.
    /// Supports: `params =>`, `|params|` (Rust-style), and `params|` (alternative arrow)
    fn parse_closure_params(mut self) -> !ParseResult<[ClosureParam]> {
        let mut params = Vec::new();
        // Support |params| syntax: if starting with |, consume and parse until closing |
        let rust_style = self.consume_if(&Token::Pipe);

        loop {
            // Check for terminator: => or | (both act as closure arrow)
            if self.check(&Token::FatArrow) || self.check(&Token::Pipe) {
                break;
            }

            // Use parse_pattern_primary to avoid consuming | as OR pattern
            let pattern = self.parse_pattern_primary()?;
            let ty = if self.consume_if(&Token::Colon) {
                self.parse_type()?
            } else {
                null
            };
            params.push(ClosureParam { pattern, ty });
            if !self.consume_if(&Token::Comma) {
                break;
            }
        }

        // For rust_style, we need to consume the closing |
        // For non-rust style, the caller will handle => or |
        let _ = rust_style;
        Ok(params)
    }

    /// Parse block contents.
    fn parse_block_contents(mut self) -> !ParseResult<Block> {
        let mut stmts = Vec::new();
        let mut expr = null;

        while !self.check(&Token::RBrace) {
            // Skip outer attributes on statements: #[...]
            while self.check(&Token::Hash) {
                self.skip_outer_attribute()?;
            }
            if self.check(&Token::RBrace) {
                break;
            }
            if self.check(&Token::Let) {
                stmts.push(self.parse_let_stmt()?);
            } else if self.check(&Token::Const) {
                // Local const declaration: const NAME: Type = expr;
                self.advance();
                let name = self.parse_ident()?;
                self.expect(Token::Colon)?;
                let ty = self.parse_type()?;
                self.expect(Token::Eq)?;
                let value = self.parse_expr()?;
                self.expect(Token::Semi)?;
                // Treat as a let with const semantics (parsing only)
                stmts.push(Stmt::Let {
                    pattern: Pattern::Ident { mutable: false, by_ref: false, name, evidentiality: null },
                    ty: ?ty,
                    init: ?value,
                });
            } else if self.check(&Token::Fn) {
                // Local function declaration: skip it for now (parsing only)
                self.skip_local_fn()?;
            } else if self.check(&Token::Unsafe) && self.peek_is(&Token::Fn) {
                // Local unsafe function declaration: skip it for now (parsing only)
                self.skip_local_fn()?;
            } else if self.check(&Token::Use) {
                // Local use statement: skip it for now (parsing only)
                self.skip_use_stmt()?;
            } else if self.check(&Token::Static) {
                // Local static variable: skip it for now (parsing only)
                self.skip_static()?;
            } else {
                // Extern blocks are now parsed as expressions via parse_primary_expr
                let e = self.parse_expr()?;
                if self.consume_if(&Token::Semi) {
                    stmts.push(Stmt::Semi(e));
                } else if self.check(&Token::RBrace) {
                    expr = Box::new(e);
                } else if self.check(&Token::Let) || self.check(&Token::Const) ||
                          self.check(&Token::Fn) || self.check(&Token::Hash) {
                    // Implicit semicolon before next statement (newline-separated)
                    stmts.push(Stmt::Semi(e));
                } else {
                    stmts.push(Stmt::Expr(e));
                }
            }
        }

        Ok(Block { stmts, expr })
    }

    /// Skip a local function declaration (used for parsing only, not executed)
    fn skip_local_fn(mut self) -> !ParseResult<()> {
        // Skip optional unsafe
        self.consume_if(&Token::Unsafe);
        self.expect(Token::Fn)?;
        // Skip function name
        self.parse_ident()?;
        // Skip generics if present
        if self.check(&Token::Lt) {
            self.skip_generics()?;
        }
        // Skip parameters
        self.expect(Token::LParen)?;
        let mut paren_depth = 1;
        while paren_depth > 0 {
            match self.current_token() {
                Token::LParen => { self.advance(); paren_depth += 1; },
                Token::RParen => { self.advance(); paren_depth -= 1; },
                Token::Eof => return Err(ParseError::unexpected(")", Token::Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        // Skip return type if present
        if self.consume_if(&Token::Arrow) {
            self.parse_type()?;
        }
        // Skip where clause if present
        if self.check(&Token::Where) {
            self.skip_where_clause()?;
        }
        // Skip function body
        self.expect(Token::LBrace)?;
        let mut brace_depth = 1;
        while brace_depth > 0 {
            match self.current_token() {
                Token::LBrace => { self.advance(); brace_depth += 1; },
                Token::RBrace => { self.advance(); brace_depth -= 1; },
                Token::Eof => return Err(ParseError::unexpected("}", Token::Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        Ok(())
    }

    /// Skip a local use statement
    fn skip_use_stmt(mut self) -> !ParseResult<()> {
        self.expect(Token::Use)?;
        // Skip until semicolon
        while !self.check(&Token::Semi) && !self.is_eof() {
            // Handle nested braces in use paths like use foo::{bar, baz}
            if self.check(&Token::LBrace) {
                self.advance();
                let mut depth = 1;
                while depth > 0 {
                    match self.current_token() {
                        Token::LBrace => { self.advance(); depth += 1; },
                        Token::RBrace => { self.advance(); depth -= 1; },
                        Token::Eof => return Err(ParseError::unexpected("}", Token::Eof, self.current_span())),
                        _ => { self.advance(); }
                    }
                }
            } else {
                self.advance();
            }
        }
        self.expect(Token::Semi)?;
        Ok(())
    }

    /// Skip a local static variable declaration
    fn skip_static(mut self) -> !ParseResult<()> {
        self.expect(Token::Static)?;
        // Skip optional mut
        self.consume_if(&Token::Mut);
        // Skip name
        self.parse_ident()?;
        // Skip type annotation
        self.expect(Token::Colon)?;
        self.parse_type()?;
        // Skip initializer
        self.expect(Token::Eq)?;
        self.parse_expr()?;
        self.expect(Token::Semi)?;
        Ok(())
    }

    /// Skip an outer attribute #[...]
    fn skip_outer_attribute(mut self) -> !ParseResult<()> {
        self.expect(Token::Hash)?;
        self.expect(Token::LBracket)?;
        let mut depth = 1;
        while depth > 0 {
            match self.current_token() {
                Token::LBracket => { self.advance(); depth += 1; },
                Token::RBracket => { self.advance(); depth -= 1; },
                Token::Eof => return Err(ParseError::unexpected("]", Token::Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        Ok(())
    }

    /// Skip generic parameters <T, U, ...>
    fn skip_generics(mut self) -> !ParseResult<()> {
        if !self.consume_if(&Token::Lt) {
            return Ok(());
        }
        let mut depth = 1;
        while depth > 0 {
            match self.current_token() {
                Token::Lt => { self.advance(); depth += 1; },
                Token::Gt => { self.advance(); depth -= 1; },
                Token::Shr => { self.advance(); depth -= 2; },  // >>
                Token::Eof => return Err(ParseError::unexpected(">", Token::Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        Ok(())
    }

    /// Skip where clause
    fn skip_where_clause(mut self) -> !ParseResult<()> {
        if !self.consume_if(&Token::Where) {
            return Ok(());
        }
        // Skip until we hit { or ; or end
        while !self.check(&Token::LBrace) && !self.check(&Token::Semi) && !self.is_eof() {
            self.advance();
        }
        Ok(())
    }

    /// Skip an unknown item declaration (like `scroll feature;`)
    fn skip_unknown_item(mut self) -> !ParseResult<Item> {
        // Skip tokens until we hit a semicolon, block, or new item starter
        // (handles newline-terminated items like `pub scroll feature`)
        while !self.check(&Token::Semi) && !self.check(&Token::LBrace) && !self.is_eof() {
            // Stop at tokens that could start a new item
            match self.current_token() {
                Token::Pub | Token::Fn | Token::Struct | Token::Enum |
                Token::Trait | Token::Impl | Token::Use | Token::Mod |
                Token::Const | Token::Static | Token::Extern | Token::Async |
                Token::Unsafe | Token::Actor | Token::Type | Token::Hash => break,
                _ => { self.advance(); }
            }
        }
        if self.consume_if(&Token::LBrace) {
            // Skip the block
            let mut depth = 1;
            while depth > 0 {
                match self.current_token() {
                    Token::LBrace => { self.advance(); depth += 1; },
                    Token::RBrace => { self.advance(); depth -= 1; },
                    Token::Eof => return Err(ParseError::unexpected("}", Token::Eof, self.current_span())),
                    _ => { self.advance(); }
                }
            }
        } else {
            self.consume_if(&Token::Semi);
        }
        // Return a dummy const item
        Ok(Item::Const(ConstDef {
            visibility: Visibility::Private,
            name: Ident::new("__unknown".to_string(), Span::empty_at(0)),
            ty: TypeExpr::Tuple([]),
            value: Expr::Tuple([]),
        }))
    }

    /// Skip a macro invocation at item level (name!(...) or name!{...})
    fn skip_item_macro(mut self) -> !ParseResult<Item> {
        // Skip macro name
        self.parse_ident()?;
        // Skip !
        self.expect(Token::Bang)?;
        // Skip the macro body (paren, bracket, or brace delimited)
        match self.current_token() {
            Token::LParen => {
                self.advance();
                let mut depth = 1;
                while depth > 0 {
                    match self.current_token() {
                        Token::LParen => { self.advance(); depth += 1; },
                        Token::RParen => { self.advance(); depth -= 1; },
                        Token::Eof => return Err(ParseError::unexpected(")", Token::Eof, self.current_span())),
                        _ => { self.advance(); }
                    }
                }
            }
            Token::LBracket => {
                self.advance();
                let mut depth = 1;
                while depth > 0 {
                    match self.current_token() {
                        Token::LBracket => { self.advance(); depth += 1; },
                        Token::RBracket => { self.advance(); depth -= 1; },
                        Token::Eof => return Err(ParseError::unexpected("]", Token::Eof, self.current_span())),
                        _ => { self.advance(); }
                    }
                }
            }
            Token::LBrace => {
                self.advance();
                let mut depth = 1;
                while depth > 0 {
                    match self.current_token() {
                        Token::LBrace => { self.advance(); depth += 1; },
                        Token::RBrace => { self.advance(); depth -= 1; },
                        Token::Eof => return Err(ParseError::unexpected("}", Token::Eof, self.current_span())),
                        _ => { self.advance(); }
                    }
                }
            }
            _ => return Err(ParseError::custom("expected '(', '[', or '{' after macro name!")),
        }
        // Optional semicolon
        self.consume_if(&Token::Semi);
        // Return a dummy const item
        Ok(Item::Const(ConstDef {
            visibility: Visibility::Private,
            name: Ident::new("__macro".to_string(), Span::empty_at(0)),
            ty: TypeExpr::Tuple([]),
            value: Expr::Tuple([]),
        }))
    }

    /// Skip a macro definition (macro name { ... })
    fn skip_macro_def(mut self) -> !ParseResult<Item> {
        // Skip 'macro' identifier
        self.advance();
        // Skip macro name
        self.parse_ident()?;
        // Skip braces and contents
        self.expect(Token::LBrace)?;
        let mut depth = 1;
        while depth > 0 {
            match self.current_token() {
                Token::LBrace => { self.advance(); depth += 1; },
                Token::RBrace => { self.advance(); depth -= 1; },
                Token::Eof => return Err(ParseError::unexpected("}", Token::Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        // Return a dummy const item
        Ok(Item::Const(ConstDef {
            visibility: Visibility::Private,
            name: Ident::new("__macro".to_string(), Span::empty_at(0)),
            ty: TypeExpr::Tuple([]),
            value: Expr::Tuple([]),
        }))
    }

    /// Skip an inline extern block (used in FFI, not needed for bootstrap)
    fn skip_extern_block(mut self) -> !ParseResult<()> {
        self.expect(Token::Extern)?;
        // Skip optional ABI string like "C"
        if let Token::StringLit(_) = self.current_token() {
            self.advance();
        }
        self.expect(Token::LBrace)?;
        // Skip balanced braces
        let mut depth = 1;
        while depth > 0 {
            match self.current_token() {
                Token::LBrace => { self.advance(); depth += 1; },
                Token::RBrace => { self.advance(); depth -= 1; },
                Token::Eof => return Err(ParseError::unexpected("}", Token::Eof, self.current_span())),
                _ => { self.advance(); }
            }
        }
        Ok(())
    }

    /// Parse a block.
    fn parse_block(mut self) -> !ParseResult<Block> {
        self.expect(Token::LBrace)?;
        let block = self.parse_block_contents()?;
        self.expect(Token::RBrace)?;
        Ok(block)
    }

    /// Parse if expression.
    fn parse_if_expr(mut self) -> !ParseResult<Expr> {
        self.expect(Token::If)?;

        // Check for if-let: if let pattern = expr { ... }
        let condition = if self.consume_if(&Token::Let) {
            let pattern = self.parse_pattern()?;
            self.expect(Token::Eq)?;
            self.in_condition = true;
            let value = self.parse_expr()?;
            self.in_condition = false;
            // Create a Let expression which evaluates to true if pattern matches
            Expr::Let {
                pattern: Box::new(pattern),
                value: Box::new(value),
            }
        } else {
            self.in_condition = true;
            let cond = self.parse_expr()?;
            self.in_condition = false;
            cond
        };

        let then_branch = self.parse_block()?;

        let else_branch = if self.consume_if(&Token::Else) {
            if self.check(&Token::If) {
                Box::new(self.parse_if_expr()?)
            } else {
                Box::new(Expr::Block(self.parse_block()?))
            }
        } else {
            null
        };

        Ok(Expr::If {
            condition: Box::new(condition),
            then_branch,
            else_branch,
        })
    }

    /// Parse match expression.
    fn parse_match_expr(mut self) -> !ParseResult<Expr> {
        self.expect(Token::Match)?;
        self.in_condition = true;
        let expr = self.parse_expr()?;
        self.in_condition = false;

        self.expect(Token::LBrace)?;
        let mut arms = Vec::new();
        while !self.check(&Token::RBrace) {
            // Skip outer attributes on match arms
            while self.check(&Token::Hash) || self.check(&Token::At) {
                self.parse_outer_attribute()?;
            }
            let pattern = self.parse_pattern()?;
            let guard = if self.consume_if(&Token::If) {
                self.in_condition = true;
                let g = self.parse_expr()?;
                self.in_condition = false;
                g
            } else {
                null
            };
            self.expect(Token::FatArrow)?;
            let body = self.parse_expr()?;
            arms.push(MatchArm { pattern, guard, body });
            // In Rust/Sigil, commas are optional after block-bodied match arms
            // So we try to consume a comma, but don't break if absent
            self.consume_if(&Token::Comma);
        }
        self.expect(Token::RBrace)?;

        Ok(Expr::Match {
            expr: Box::new(expr),
            arms,
        })
    }

    /// Parse morpheme expression.
    fn parse_morpheme_expr(mut self) -> !ParseResult<Expr> {
        let kind = match self.current_token() {
            Token::Tau => MorphemeKind::Transform,
            Token::Phi => MorphemeKind::Filter,
            Token::Sigma => MorphemeKind::Sort,
            Token::Rho => MorphemeKind::Reduce,
            Token::Lambda => MorphemeKind::Lambda,
            Token::Pi => MorphemeKind::Product,
            Token::Alpha => MorphemeKind::First,
            Token::Omega => MorphemeKind::Last,
            _ => return Err(ParseError::custom("expected morpheme")),
        };
        self.advance();

        self.expect(Token::LBrace)?;
        let body = self.parse_expr()?;
        self.expect(Token::RBrace)?;

        Ok(Expr::Morpheme {
            kind,
            body: Box::new(body),
        })
    }

    /// Parse let statement (with optional else for let-else syntax).
    fn parse_let_stmt(mut self) -> !ParseResult<Stmt> {
        self.expect(Token::Let)?;
        let pattern = self.parse_pattern()?;
        let ty = if self.consume_if(&Token::Colon) {
            self.parse_type()?
        } else {
            null
        };
        let init = if self.consume_if(&Token::Eq) {
            self.parse_expr()?
        } else {
            null
        };

        // Check for let-else syntax
        if self.consume_if(&Token::Else) {
            let else_block = self.parse_block()?;
            self.expect(Token::Semi)?;
            Ok(Stmt::LetElse {
                pattern,
                ty,
                init: init!,
                else_branch: Box::new(Expr::Block(else_block)),
            })
        } else {
            // Semicolon is optional in Nihil-style code (newline-separated)
            // Only require it if not followed by a token that could start a new statement
            self.consume_if(&Token::Semi);  // Optional semicolon
            Ok(Stmt::Let { pattern, ty, init })
        }
    }

    /// Parse condition (in condition context).
    fn parse_condition(mut self) -> !ParseResult<Expr> {
        self.in_condition = true;
        let expr = self.parse_expr()?;
        self.in_condition = false;
        Ok(expr)
    }

    /// Check if the token after | looks like a pipe operation (not bitwise OR).
    fn is_pipe_op_ahead(self) -> !bool {
        match self.peek_next_token() {
            ?Token::Tau => true,
            ?Token::Phi => true,
            ?Token::Sigma => true,
            ?Token::Rho => true,
            ?Token::Alpha => true,
            ?Token::Omega => true,
            ?Token::Pi => true,
            ?Token::Mu => true,
            ?Token::Chi => true,
            ?Token::Nu => true,
            ?Token::Xi => true,
            ?Token::Nabla => true,
            ?Token::Parallel => true,
            ?Token::Gpu => true,
            ?Token::Await => true,
            ?Token::Hourglass => true,
            ?Token::GradeUp => true,
            ?Token::GradeDown => true,
            ?Token::Rotate => true,
            ?Token::ElementSmallVerticalBar => true,
            ?Token::Union => true,
            ?Token::Iota => true,
            ?Token::Interrobang => true,
            ?Token::Match => true,
            ?Token::Amp => true,
            ?Token::SelfLower => true,
            ?Token::Ident(_) => true,
            _ => false,
        }
    }

    /// Parse a pipe chain.
    fn parse_pipe_chain(mut self, initial: !Expr) -> !ParseResult<Expr> {
        let mut operations = Vec::new();

        while self.consume_if(&Token::Pipe) {
            let op = self.parse_pipe_op()?;
            operations.push(op);
        }

        Ok(Expr::Pipe {
            expr: Box::new(initial),
            operations,
        })
    }

    /// Parse a pipe operation.
    fn parse_pipe_op(mut self) -> !ParseResult<PipeOp> {
        match self.current_token() {
            Token::Tau => {
                self.advance();
                self.expect(Token::LBrace)?;
                // Check for closure syntax: {x => ...} or {(x)| ...}
                let body = if self.is_closure_start() {
                    let params = self.parse_closure_params()?;
                    // Accept either => or | as closure arrow
                    if !self.consume_if(&Token::FatArrow) {
                        self.expect(Token::Pipe)?;
                    }
                    // Parse optional return type
                    let return_type = if self.consume_if(&Token::Arrow) {
                        ?self.parse_type()?
                    } else {
                        null
                    };
                    // Parse body as block contents (handles both single expr and multi-stmt)
                    let block = self.parse_block_contents()?;
                    let expr = Expr::Block(block);
                    Expr::Closure { params, return_type, body: Box::new(expr) }
                } else {
                    self.parse_expr()?
                };
                self.expect(Token::RBrace)?;
                Ok(PipeOp::Transform(Box::new(body)))
            }
            Token::Phi => {
                self.advance();
                self.expect(Token::LBrace)?;
                // Check for closure syntax: {x => ...} or {(x)| ...}
                let body = if self.is_closure_start() {
                    let params = self.parse_closure_params()?;
                    // Accept either => or | as closure arrow
                    if !self.consume_if(&Token::FatArrow) {
                        self.expect(Token::Pipe)?;
                    }
                    // Parse optional return type
                    let return_type = if self.consume_if(&Token::Arrow) {
                        ?self.parse_type()?
                    } else {
                        null
                    };
                    // Parse body as block contents (handles both single expr and multi-stmt)
                    let block = self.parse_block_contents()?;
                    let expr = Expr::Block(block);
                    Expr::Closure { params, return_type, body: Box::new(expr) }
                } else {
                    self.parse_expr()?
                };
                self.expect(Token::RBrace)?;
                Ok(PipeOp::Filter(Box::new(body)))
            }
            Token::Sigma => {
                self.advance();
                let field = if self.consume_if(&Token::Dot) {
                    self.parse_ident()?
                } else {
                    null
                };
                Ok(PipeOp::Sort(field))
            }
            Token::Rho => {
                self.advance();
                match self.current_token() {
                    Token::Plus => { self.advance(); Ok(PipeOp::ReduceSum) }
                    Token::Star => { self.advance(); Ok(PipeOp::ReduceProd) }
                    Token::PlusPlus => { self.advance(); Ok(PipeOp::ReduceConcat) }
                    Token::Amp => { self.advance(); Ok(PipeOp::ReduceAll) }
                    Token::LBrace => {
                        self.advance();
                        // Check for closure syntax: {x => ...} or {(acc, x) => ...}
                        let body = if self.is_closure_start() {
                            let params = self.parse_closure_params()?;
                            // Accept either => or | as closure arrow
                            if !self.consume_if(&Token::FatArrow) {
                                self.expect(Token::Pipe)?;
                            }
                            // Parse optional return type
                            let return_type = if self.consume_if(&Token::Arrow) {
                                ?self.parse_type()?
                            } else {
                                null
                            };
                            // Parse body as block contents (handles both single expr and multi-stmt)
                            let block = self.parse_block_contents()?;
                            let expr = Expr::Block(block);
                            Expr::Closure { params, return_type, body: Box::new(expr) }
                        } else {
                            self.parse_expr()?
                        };
                        self.expect(Token::RBrace)?;
                        Ok(PipeOp::Reduce(Box::new(body)))
                    }
                    _ => Err(ParseError::custom("expected reduction variant after ρ")),
                }
            }
            Token::Alpha => { self.advance(); Ok(PipeOp::First) }
            Token::Omega => { self.advance(); Ok(PipeOp::Last) }
            Token::Pi => { self.advance(); Ok(PipeOp::ReduceProd) }
            Token::Mu => {
                self.advance();
                // Check for method call: |μ(args...) vs simple |μ
                if self.check(&Token::LParen) {
                    self.advance();
                    let args = self.parse_expr_list()?;
                    self.expect(Token::RParen)?;
                    // μ with args is "mean" operation in tensor context
                    Ok(PipeOp::Method { name: Ident::new("mean".to_string(), Span::empty_at(0)), args })
                } else {
                    Ok(PipeOp::Middle)
                }
            }
            Token::Chi => { self.advance(); Ok(PipeOp::Choice) }
            Token::Nu => {
                self.advance();
                if self.check(&Token::LBrace) {
                    self.advance();
                    let index = self.parse_expr()?;
                    self.expect(Token::RBrace)?;
                    Ok(PipeOp::Nth(Box::new(index)))
                } else {
                    // Default to first element when no index specified
                    Ok(PipeOp::First)
                }
            }
            Token::Xi => { self.advance(); Ok(PipeOp::Next) }
            Token::Parallel => {
                self.advance();
                let inner = self.parse_pipe_op()?;
                Ok(PipeOp::Parallel(Box::new(inner)))
            }
            Token::Gpu => {
                self.advance();
                let inner = self.parse_pipe_op()?;
                Ok(PipeOp::Gpu(Box::new(inner)))
            }
            Token::Await | Token::Hourglass => {
                self.advance();
                Ok(PipeOp::Await)
            }
            Token::GradeUp => { self.advance(); Ok(PipeOp::SortAsc) }
            Token::GradeDown => { self.advance(); Ok(PipeOp::SortDesc) }
            Token::Rotate => { self.advance(); Ok(PipeOp::Reverse) }
            Token::ElementSmallVerticalBar => { self.advance(); Ok(PipeOp::Flatten) }
            Token::Union => { self.advance(); Ok(PipeOp::Unique) }
            Token::Iota => { self.advance(); Ok(PipeOp::Enumerate) }
            Token::Nabla => {
                self.advance();
                // Optional argument: |∇ or |∇{var}
                let var = if self.check(&Token::LBrace) {
                    self.advance();
                    let expr = self.parse_expr()?;
                    self.expect(Token::RBrace)?;
                    Box::new(expr)
                } else {
                    // No specific variable - gradient with respect to all tracked inputs
                    Box::new(Expr::Tuple([]))  // Empty tuple as placeholder
                };
                Ok(PipeOp::Gradient(var))
            }
            Token::Interrobang => {
                self.advance();
                let mapper = if self.check(&Token::LBrace) {
                    self.advance();
                    let expr = self.parse_expr()?;
                    self.expect(Token::RBrace)?;
                    Box::new(expr)
                } else {
                    null
                };
                Ok(PipeOp::TryMap(mapper))
            }
            Token::Ident(_) => {
                let name = self.parse_ident()?;
                // Check for macro invocation: |macro!{...}, |macro!(...), |macro![...]
                let is_macro = self.consume_if(&Token::Bang);
                if is_macro && (self.check(&Token::LBrace) || self.check(&Token::LParen) || self.check(&Token::LBracket)) {
                    // Parse macro tokens
                    let tokens = self.parse_macro_tokens()?;
                    return Ok(PipeOp::Macro { name, tokens });
                }
                // Consume optional evidentiality marker on method name: |estimate~()
                if !is_macro {
                    self.consume_if(&Token::Tilde) ||
                        self.consume_if(&Token::Question) || self.consume_if(&Token::Lozenge);
                }
                // Handle |method{...} syntax (closure body)
                // Don't consume { when in condition context (e.g., for x in iter|method {})
                if self.check(&Token::LBrace) && !self.is_in_condition() {
                    self.advance();
                    // Check for closure syntax: {x => ...} or {(x)| ...}
                    let body = if self.is_closure_start() {
                        let params = self.parse_closure_params()?;
                        // Accept either => or | as closure arrow
                        if !self.consume_if(&Token::FatArrow) {
                            self.expect(Token::Pipe)?;
                        }
                        // Parse optional return type
                        let return_type = if self.consume_if(&Token::Arrow) {
                            ?self.parse_type()?
                        } else {
                            null
                        };
                        // Parse body as block contents (handles both single expr and multi-stmt)
                        let block = self.parse_block_contents()?;
                        let expr = Expr::Block(block);
                        Expr::Closure { params, return_type, body: Box::new(expr) }
                    } else {
                        self.parse_expr()?
                    };
                    self.expect(Token::RBrace)?;
                    // Return as Method with closure as single arg
                    Ok(PipeOp::Method { name, args: [body] })
                } else if self.check(&Token::ColonColon) {
                    // Either turbofish: |collect::<Vec<_>>() or qualified: |Tensor::from_slice
                    self.advance(); // consume ::
                    if self.check(&Token::Lt) {
                        // Turbofish: |collect::<Vec<_>>()
                        self.advance();
                        let _type_args = self.parse_type_list()?;
                        self.expect_gt()?;
                        // Parse args if present (optional - no args means pipe value only)
                        let args = if self.check(&Token::LParen) {
                            self.advance();
                            let args = self.parse_expr_list()?;
                            self.expect(Token::RParen)?;
                            args
                        } else {
                            []
                        };
                        Ok(PipeOp::Method { name, args })
                    } else {
                        // Qualified path: |Type::method or |Type::method(args)
                        let method_name = self.parse_ident()?;
                        let args = if self.check(&Token::LParen) {
                            self.advance();
                            let args = self.parse_expr_list()?;
                            self.expect(Token::RParen)?;
                            args
                        } else {
                            []
                        };
                        // Use the method_name for the call (name was Type, method_name is the actual method)
                        Ok(PipeOp::Method { name: method_name, args })
                    }
                } else if self.check(&Token::LParen) {
                    self.advance();
                    let args = self.parse_expr_list()?;
                    self.expect(Token::RParen)?;
                    Ok(PipeOp::Method { name, args })
                } else {
                    Ok(PipeOp::Method { name, args: [] })
                }
            }
            // Reference in pipe: |&expr - call the referenced function/method
            Token::Amp => {
                let span = self.current_span();
                self.advance();
                // Parse the expression being referenced (postfix handles field access)
                let inner = self.parse_postfix_expr()?;
                // Wrap in Ref expression
                let ref_expr = Expr::Ref {
                    mutable: false,
                    expr: Box::new(inner),
                };
                Ok(PipeOp::Call(Box::new(ref_expr)))
            }
            // Self method call: |self.method()
            Token::SelfLower => {
                let expr = self.parse_postfix_expr()?;
                Ok(PipeOp::Call(Box::new(expr)))
            }
            // Pipe into match: |match { arms }
            Token::Match => {
                self.advance();
                self.expect(Token::LBrace)?;
                // Parse match arms inline
                let mut arms = Vec::new();
                while !self.check(&Token::RBrace) {
                    while self.check(&Token::Hash) || self.check(&Token::At) {
                        self.parse_outer_attribute()?;
                    }
                    let pattern = self.parse_pattern()?;
                    let guard = if self.consume_if(&Token::If) {
                        self.in_condition = true;
                        let g = self.parse_expr()?;
                        self.in_condition = false;
                        Box::new(g)
                    } else {
                        null
                    };
                    self.expect(Token::FatArrow)?;
                    let body = self.parse_expr()?;
                    arms.push(MatchArm { pattern, guard, body });
                    self.consume_if(&Token::Comma);
                }
                self.expect(Token::RBrace)?;
                // Represent as a call to a match expression
                // Create a simple "_" path for the placeholder expression
                let placeholder_path = TypePath {
                    segments: [PathSegment {
                        ident: Ident::new("_".to_string(), Span::empty_at(0)),
                        generics: null,
                    }],
                };
                let match_expr = Expr::Match {
                    expr: Box::new(Expr::Path(placeholder_path)),
                    arms,
                };
                Ok(PipeOp::Call(Box::new(match_expr)))
            }
            t => Err(ParseError::unexpected("pipe operation", t?, self.current_span())),
        }
    }

    // ========================================
    // Pattern Parsing
    // ========================================

    /// Parse a pattern.
    fn parse_pattern(mut self) -> !ParseResult<Pattern> {
        self.parse_pattern_or()
    }

    /// Parse or-pattern: p1 | p2.
    fn parse_pattern_or(mut self) -> !ParseResult<Pattern> {
        let mut patterns: ![Pattern] = [self.parse_pattern_primary()?];

        while self.consume_if(&Token::Pipe) {
            patterns.push(self.parse_pattern_primary()?);
        }

        if patterns.len() == 1 {
            Ok(patterns.pop()!)
        } else {
            Ok(Pattern::Or(patterns))
        }
    }

    /// Parse primary pattern.
    fn parse_pattern_primary(mut self) -> !ParseResult<Pattern> {
        match self.current_token() {
            Token::Underscore => {
                self.advance();
                Ok(Pattern::Wildcard)
            }
            Token::DotDot => {
                self.advance();
                Ok(Pattern::Rest)
            }
            // Evidential prefix pattern: ?(pattern) matches Some/uncertain values
            Token::Question => {
                self.advance();
                let inner = self.parse_pattern_primary()?;
                Ok(Pattern::Evidential {
                    pattern: Box::new(inner),
                    evidentiality: Evidentiality::Uncertain,
                })
            }
            // Known evidentiality: !(pattern)
            Token::Bang => {
                self.advance();
                let inner = self.parse_pattern_primary()?;
                Ok(Pattern::Evidential {
                    pattern: Box::new(inner),
                    evidentiality: Evidentiality::Known,
                })
            }
            Token::Mut => {
                self.advance();
                // mut ref x or mut x
                let by_ref = self.consume_if(&Token::Ref);
                let name = self.parse_ident()?;
                let evidentiality = self.parse_evidentiality_opt();
                Ok(Pattern::Ident { mutable: true, by_ref, name, evidentiality })
            }
            Token::Ref => {
                self.advance();
                // ref mut x or ref x
                let mutable = self.consume_if(&Token::Mut);
                let name = self.parse_ident()?;
                let evidentiality = self.parse_evidentiality_opt();
                Ok(Pattern::Ident { mutable, by_ref: true, name, evidentiality })
            }
            // Reference pattern: &x or &mut x
            Token::Amp => {
                self.advance();
                let mutable = self.consume_if(&Token::Mut);
                let inner = self.parse_pattern_primary()?;
                Ok(Pattern::Ref {
                    mutable,
                    pattern: Box::new(inner),
                })
            }
            // Keywords that can be used as identifiers in patterns
            Token::Ident(_) | Token::SelfUpper | Token::Derive | Token::Body | Token::Header | Token::Naked
                | Token::Gpu | Token::Asm | Token::Simd | Token::Send | Token::Recv
                | Token::Close | Token::Retry | Token::Http | Token::Https
                | Token::On | Token::Ws | Token::Wss | Token::Grpc | Token::Kafka | Token::Amqp
                | Token::Packed | Token::Repr | Token::Align => {
                let ident = self.parse_ident()?;

                // Build path segments (handle :: for qualified paths like Token::Fn)
                let mut segments: ![PathSegment] = [PathSegment { ident, args: null }];
                while self.consume_if(&Token::ColonColon) {
                    let next_ident = self.parse_ident()?;
                    segments.push(PathSegment { ident: next_ident, args: null });
                }
                let path = TypePath { segments: segments.clone() };

                // Check for struct pattern
                if self.check(&Token::LBrace) {
                    self.advance();
                    let mut fields = Vec::new();
                    let mut rest = false;
                    while !self.check(&Token::RBrace) {
                        if self.consume_if(&Token::DotDot) {
                            rest = true;
                            break;
                        }
                        let name = self.parse_ident()?;
                        let pattern = if self.consume_if(&Token::Colon) {
                            self.parse_pattern()?
                        } else {
                            null
                        };
                        fields.push(FieldPattern { name, pattern });
                        if !self.consume_if(&Token::Comma) {
                            break;
                        }
                    }
                    self.expect(Token::RBrace)?;
                    Ok(Pattern::Struct { path, fields, rest })
                }
                // Check for tuple struct pattern
                else if self.check(&Token::LParen) {
                    self.advance();
                    let mut fields = Vec::new();
                    while !self.check(&Token::RParen) {
                        fields.push(self.parse_pattern()?);
                        if !self.consume_if(&Token::Comma) {
                            break;
                        }
                    }
                    self.expect(Token::RParen)?;
                    Ok(Pattern::TupleStruct { path, fields })
                }
                // Single segment path without { or ( -> simple identifier pattern
                else if segments.len() == 1 {
                    let evidentiality = self.parse_evidentiality_opt();
                    Ok(Pattern::Ident { mutable: false, by_ref: false, name: segments[0].ident.clone(), evidentiality })
                }
                // Multi-segment path (like Token::Fn) -> TupleStruct with no fields (unit variant)
                else {
                    Ok(Pattern::TupleStruct { path, fields: [] })
                }
            }
            Token::LParen => {
                self.advance();
                if self.check(&Token::RParen) {
                    self.advance();
                    return Ok(Pattern::Tuple(Vec::new()));
                }
                // Use parse_pattern_primary to avoid consuming | as OR separator
                // This prevents closure arrow | from being parsed as OR in tuple params
                let mut patterns: ![Pattern] = [self.parse_pattern_primary()?];
                while self.consume_if(&Token::Comma) {
                    if self.check(&Token::RParen) {
                        break;
                    }
                    patterns.push(self.parse_pattern_primary()?);
                }
                self.expect(Token::RParen)?;
                if patterns.len() == 1 {
                    Ok(patterns.pop()!)
                } else {
                    Ok(Pattern::Tuple(patterns))
                }
            }
            Token::LBracket => {
                self.advance();
                let mut patterns = Vec::new();
                while !self.check(&Token::RBracket) {
                    patterns.push(self.parse_pattern()?);
                    if !self.consume_if(&Token::Comma) {
                        break;
                    }
                }
                self.expect(Token::RBracket)?;
                Ok(Pattern::Slice(patterns))
            }
            // Literals - check for range patterns after
            Token::IntLit(s) => {
                self.advance();
                let lit = Pattern::Literal(Literal::Int {
                    value: s.clone(),
                    base: NumBase::Decimal,
                    suffix: null,
                });
                // Check for range pattern: lit..end or lit..=end
                if self.check(&Token::DotDot) || self.check(&Token::DotDotEq) {
                    let inclusive = self.consume_if(&Token::DotDotEq);
                    if !inclusive {
                        self.advance(); // consume ..
                    }
                    // Parse end of range if present
                    let end = match self.current_token() {
                        Token::IntLit(_) | Token::CharLit(_) => {
                            let end_pat = self.parse_pattern_primary()?;
                            ?Box::new(end_pat)
                        },
                        _ => null,
                    };
                    Ok(Pattern::Range {
                        start: ?Box::new(lit),
                        end,
                        inclusive,
                    })
                } else {
                    Ok(lit)
                }
            }
            Token::FloatLit(s) => {
                self.advance();
                Ok(Pattern::Literal(Literal::Float { value: s.clone(), suffix: null }))
            }
            Token::StringLit(s) => {
                self.advance();
                Ok(Pattern::Literal(Literal::String(s.clone())))
            }
            Token::CharLit(c) => {
                self.advance();
                let lit = Pattern::Literal(Literal::Char(c.clone()));
                // Check for range pattern: lit..end or lit..=end
                if self.check(&Token::DotDot) || self.check(&Token::DotDotEq) {
                    let inclusive = self.consume_if(&Token::DotDotEq);
                    if !inclusive {
                        self.advance(); // consume ..
                    }
                    // Parse end of range if present
                    let end = match self.current_token() {
                        Token::IntLit(_) | Token::CharLit(_) => {
                            let end_pat = self.parse_pattern_primary()?;
                            ?Box::new(end_pat)
                        },
                        _ => null,
                    };
                    Ok(Pattern::Range {
                        start: ?Box::new(lit),
                        end,
                        inclusive,
                    })
                } else {
                    Ok(lit)
                }
            }
            Token::True => {
                self.advance();
                Ok(Pattern::Literal(Literal::Bool(true)))
            }
            Token::False => {
                self.advance();
                Ok(Pattern::Literal(Literal::Bool(false)))
            }
            Token::Null => {
                self.advance();
                Ok(Pattern::Literal(Literal::Null))
            }
            // Keywords that can be used as identifiers in pattern context
            Token::Body | Token::Header | Token::Http | Token::Https | Token::Retry |
            Token::Send | Token::Recv | Token::Close | Token::On => {
                let span = self.current_span();
                let name = match self.current_token() {
                    Token::Body => "body",
                    Token::Header => "header",
                    Token::Http => "http",
                    Token::Https => "https",
                    Token::Retry => "retry",
                    Token::Send => "send",
                    Token::Recv => "recv",
                    Token::Close => "close",
                    Token::On => "on",
                    _ => "unknown",
                };
                self.advance();
                let evidentiality = self.parse_evidentiality_opt();
                Ok(Pattern::Ident {
                    mutable: false,
                    by_ref: false,
                    name: Ident::new(name.to_string(), span),
                    evidentiality,
                })
            }
            t => Err(ParseError::unexpected("pattern", t?, self.current_span())),
        }
    }

    // ========================================
    // Helper Parsing Methods
    // ========================================

    /// Parse an identifier.
    fn parse_ident(mut self) -> !ParseResult<Ident> {
        let span = self.current_span();
        match self.current_token().cloned() {
            Token::Ident(name) => {
                self.advance();
                Ok(Ident::new(name, span))
            }
            Token::SelfLower => {
                self.advance();
                Ok(Ident::new("self".to_string(), span))
            }
            Token::SelfUpper => {
                self.advance();
                Ok(Ident::new("Self".to_string(), span))
            }
            // Keywords that can also be used as identifiers in certain contexts
            Token::Derive => {
                self.advance();
                Ok(Ident::new("derive".to_string(), span))
            }
            Token::Test => {
                self.advance();
                Ok(Ident::new("test".to_string(), span))
            }
            Token::Default => {
                self.advance();
                Ok(Ident::new("default".to_string(), span))
            }
            // Path keywords that can be used as identifiers in use/path contexts
            Token::Crate => {
                self.advance();
                Ok(Ident::new("crate".to_string(), span))
            }
            Token::Super => {
                self.advance();
                Ok(Ident::new("super".to_string(), span))
            }
            // Context-specific keywords that can be used as identifiers
            Token::Body => {
                self.advance();
                Ok(Ident::new("body".to_string(), span))
            }
            Token::Header => {
                self.advance();
                Ok(Ident::new("header".to_string(), span))
            }
            Token::Http | Token::Https => {
                let name = if self.current_token() == &Token::Http { "http" } else { "https" };
                self.advance();
                Ok(Ident::new(name.to_string(), span))
            }
            Token::Retry => {
                self.advance();
                Ok(Ident::new("retry".to_string(), span))
            }
            Token::Send => {
                self.advance();
                Ok(Ident::new("send".to_string(), span))
            }
            Token::Recv => {
                self.advance();
                Ok(Ident::new("recv".to_string(), span))
            }
            Token::Close => {
                self.advance();
                Ok(Ident::new("close".to_string(), span))
            }
            Token::On => {
                self.advance();
                Ok(Ident::new("on".to_string(), span))
            }
            Token::Naked => {
                self.advance();
                Ok(Ident::new("naked".to_string(), span))
            }
            Token::Gpu => {
                self.advance();
                Ok(Ident::new("gpu".to_string(), span))
            }
            Token::Asm => {
                self.advance();
                Ok(Ident::new("asm".to_string(), span))
            }
            Token::Simd => {
                self.advance();
                Ok(Ident::new("simd".to_string(), span))
            }
            Token::Packed => {
                self.advance();
                Ok(Ident::new("packed".to_string(), span))
            }
            Token::Repr => {
                self.advance();
                Ok(Ident::new("repr".to_string(), span))
            }
            Token::Align => {
                self.advance();
                Ok(Ident::new("align".to_string(), span))
            }
            Token::Atomic => {
                self.advance();
                Ok(Ident::new("atomic".to_string(), span))
            }
            // Mathematical symbols that can be used as identifiers
            Token::Nabla => {
                self.advance();
                Ok(Ident::new("∇".to_string(), span))
            }
            Token::Sqrt => {
                self.advance();
                Ok(Ident::new("√".to_string(), span))
            }
            Token::Partial => {
                self.advance();
                Ok(Ident::new("∂".to_string(), span))
            }
            Token::Pi => {
                self.advance();
                Ok(Ident::new("Π".to_string(), span))
            }
            Token::Phi => {
                self.advance();
                Ok(Ident::new("φ".to_string(), span))
            }
            Token::Tau => {
                self.advance();
                Ok(Ident::new("τ".to_string(), span))
            }
            Token::Sigma => {
                self.advance();
                Ok(Ident::new("Σ".to_string(), span))
            }
            Token::Mu => {
                self.advance();
                Ok(Ident::new("μ".to_string(), span))
            }
            Token::Rho => {
                self.advance();
                Ok(Ident::new("ρ".to_string(), span))
            }
            // Contextual keywords that can be identifiers
            Token::Parallel => {
                self.advance();
                Ok(Ident::new("parallel".to_string(), span))
            }
            Token::Null => {
                self.advance();
                Ok(Ident::new("null".to_string(), span))
            }
            Token::Enum => {
                self.advance();
                Ok(Ident::new("enum".to_string(), span))
            }
            Token::Await => {
                self.advance();
                Ok(Ident::new("await".to_string(), span))
            }
            t => Err(ParseError::unexpected("identifier", t?, span)),
        }
    }

    /// Parse optional numeric type suffix (u8, u16, u32, u64, i8, i16, i32, i64, f32, f64, usize, isize).
    fn parse_numeric_suffix(mut self) -> ?String {
        match self.current_token().cloned() {
            Token::Ident(s) => {
                if s == "u8" || s == "u16" || s == "u32" || s == "u64" ||
                   s == "i8" || s == "i16" || s == "i32" || s == "i64" ||
                   s == "f32" || s == "f64" || s == "usize" || s == "isize" {
                    self.advance();
                    ?s
                } else {
                    null
                }
            }
            _ => null,
        }
    }

    /// Parse optional evidentiality marker.
    fn parse_evidentiality_opt(mut self) -> ?Evidentiality {
        match self.current_token() {
            Token::Bang => { self.advance(); Evidentiality::Known }
            Token::Question => { self.advance(); Evidentiality::Uncertain }
            Token::Tilde => { self.advance(); Evidentiality::Reported }
            Token::Interrobang => { self.advance(); Evidentiality::Paradox }
            Token::Lozenge => { self.advance(); Evidentiality::Prediction }
            _ => null,
        }
    }

    /// Parse an expression or named argument (name: expr).
    fn parse_expr_or_named_arg(mut self) -> !ParseResult<Expr> {
        // Check for named argument: ident: expr
        match self.current_token() {
            Token::Ident(_) => {
                match self.lexer.peek() {
                    ?(Token::Colon, _) => {
                        // Named argument - skip the name, just return the value
                        self.advance(); // consume ident
                        self.advance(); // consume :
                        self.parse_expr()
                    }
                    _ => self.parse_expr(),
                }
            }
            _ => self.parse_expr(),
        }
    }

    /// Parse a list of expressions.
    fn parse_expr_list(mut self) -> !ParseResult<[Expr]> {
        let mut exprs = Vec::new();
        if !self.check(&Token::RParen) && !self.check(&Token::RBracket) {
            exprs.push(self.parse_expr_or_named_arg()?);
            while self.consume_if(&Token::Comma) {
                if self.check(&Token::RParen) || self.check(&Token::RBracket) {
                    break;
                }
                exprs.push(self.parse_expr_or_named_arg()?);
            }
        }
        Ok(exprs)
    }

    /// Parse macro tokens: collects all tokens inside matching delimiters.
    fn parse_macro_tokens(mut self) -> !ParseResult<String> {
        // Determine delimiter type
        let open: Token;
        let close: Token;
        match self.current_token() {
            Token::LParen => { open = Token::LParen; close = Token::RParen; }
            Token::LBracket => { open = Token::LBracket; close = Token::RBracket; }
            Token::LBrace => { open = Token::LBrace; close = Token::RBrace; }
            _ => {
                return Err(ParseError::custom("expected '(', '[', or '{' for macro invocation"));
            }
        }

        self.advance(); // consume opening delimiter
        let mut tokens = String::new();
        let mut depth = 1;
        let mut suppress_space = false;  // Dont add space after . or :: or open delimiters

        while depth > 0 && !self.is_eof() {
            if self.check(&open) {
                depth += 1;
            } else if self.check(&close) {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            }

            // Collect token text
            match self.current_token() {
                Token::Ident(s) => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str(s.as_str());
                    suppress_space = false;
                }
                Token::IntLit(s) => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str(s.as_str());
                    suppress_space = false;
                }
                Token::FloatLit(s) => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str(s.as_str());
                    suppress_space = false;
                }
                Token::StringLit(s) => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("\"");
                    // CG-097: Re-escape special characters when reconstructing string literals
                    // The lexer already processed escapes, so we need to re-escape for output
                    for c in s.chars() {
                        match c {
                            '"' => tokens.push_str("\\\""),
                            '\\' => tokens.push_str("\\\\"),
                            '\n' => tokens.push_str("\\n"),
                            '\r' => tokens.push_str("\\r"),
                            '\t' => tokens.push_str("\\t"),
                            _ => tokens.push(c),
                        }
                    }
                    tokens.push_str("\"");
                }
                Token::CharLit(c) => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("'");
                    tokens.push(c);
                    tokens.push_str("'");
                    suppress_space = false;
                }
                Token::Comma => { tokens.push_str(", "); suppress_space = false; }
                Token::Colon => { tokens.push_str(": "); suppress_space = false; }
                Token::Plus => { tokens.push_str(" + "); suppress_space = false; }
                Token::Minus => { tokens.push_str(" - "); suppress_space = false; }
                Token::Star => { tokens.push_str(" * "); suppress_space = false; }
                Token::Slash => { tokens.push_str(" / "); suppress_space = false; }
                Token::Eq => { tokens.push_str(" = "); suppress_space = false; }
                Token::LParen => { tokens.push_str("("); suppress_space = true; }
                Token::RParen => { tokens.push_str(")"); suppress_space = false; }
                Token::LBracket => { tokens.push_str("["); suppress_space = true; }
                Token::RBracket => { tokens.push_str("]"); suppress_space = false; }
                Token::LBrace => { tokens.push_str("{"); suppress_space = true; }
                Token::RBrace => { tokens.push_str("}"); suppress_space = false; }
                Token::Dot => { tokens.push_str("."); suppress_space = true; }
                Token::Bang => { tokens.push_str("!"); suppress_space = false; }
                Token::Question => { tokens.push_str("?"); suppress_space = false; }
                Token::Lt => { tokens.push_str(" < "); suppress_space = false; }
                Token::Gt => { tokens.push_str(" > "); suppress_space = false; }
                Token::LtEq => { tokens.push_str(" <= "); suppress_space = false; }
                Token::GtEq => { tokens.push_str(" >= "); suppress_space = false; }
                Token::EqEq => { tokens.push_str(" == "); suppress_space = false; }
                Token::NotEq => { tokens.push_str(" != "); suppress_space = false; }
                Token::Amp => { tokens.push_str("&"); suppress_space = true; }
                Token::Pipe => { tokens.push_str("|"); suppress_space = false; }
                Token::AndAnd => { tokens.push_str(" && "); suppress_space = false; }
                Token::OrOr => { tokens.push_str(" || "); suppress_space = false; }
                Token::ColonColon => { tokens.push_str("::"); suppress_space = true; }
                Token::Semi => { tokens.push_str("; "); suppress_space = false; }
                Token::Arrow => { tokens.push_str(" -> "); suppress_space = false; }
                Token::FatArrow => { tokens.push_str(" => "); suppress_space = false; }
                Token::SelfLower => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("self");
                    suppress_space = false;
                }
                Token::SelfUpper => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("Self");
                    suppress_space = false;
                }
                Token::Percent => { tokens.push_str(" % "); suppress_space = false; }
                Token::Caret => { tokens.push_str(" ^ "); suppress_space = false; }
                Token::Tilde => { tokens.push_str("~"); suppress_space = true; }
                Token::At => { tokens.push_str("@"); suppress_space = true; }
                Token::Hash => { tokens.push_str("#"); suppress_space = true; }
                Token::Dollar => { tokens.push_str("$"); suppress_space = true; }
                Token::True => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("true");
                    suppress_space = false;
                }
                Token::False => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("false");
                    suppress_space = false;
                }
                Token::Null => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("null");
                    suppress_space = false;
                }
                Token::As => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("as");
                    suppress_space = false;
                }
                // CG-069: Handle crate keyword in macro arguments
                Token::Crate => {
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("crate");
                    suppress_space = false;
                }
                _ => {
                    // For other tokens, output token debug representation
                    if !tokens.is_empty() && !suppress_space { tokens.push_str(" "); }
                    tokens.push_str("/* unknown token */");
                    suppress_space = false;
                }
            }
            self.advance();
        }

        self.expect(close)?;
        Ok(tokens)
    }
}

// ============================================
// Operator Precedence
// ============================================

/// Get binding power for infix operators.
fn infix_binding_power(op: !BinOp) -> !(u8, u8) {
    match op {
        BinOp::Or => (1, 2),
        BinOp::And => (3, 4),
        BinOp::Eq | BinOp::Ne | BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge => (5, 6),
        BinOp::BitOr => (7, 8),
        BinOp::BitXor => (9, 10),
        BinOp::BitAnd => (11, 12),
        BinOp::Shl | BinOp::Shr => (13, 14),
        BinOp::Add | BinOp::Sub | BinOp::Concat => (15, 16),
        BinOp::Mul | BinOp::Div | BinOp::Rem | BinOp::MatMul => (17, 18),
        BinOp::Pow => (20, 19),  // Right associative
    }
}

// ============================================
// Tests
// ============================================

#[test]
fn test_parse_empty_file() {
    let mut parser = Parser::new("".to_string());
    let file = parser.parse_file().unwrap();
    assert!(file.items.is_empty());
}

#[test]
fn test_parse_function() {
    let mut parser = Parser::new("fn main() {}".to_string());
    let file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
fn test_parse_struct() {
    let mut parser = Parser::new("struct Point { x: !i32, y: !i32 }".to_string());
    let file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
fn test_parse_pipe_chain() {
    let mut parser = Parser::new("fn test() { data|τ{f}|φ{p}|σ }".to_string());
    let file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
fn test_parse_evidentiality() {
    let mut parser = Parser::new("fn test() { let x: !i32 = value!; }".to_string());
    let file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
fn test_parse_morpheme() {
    let mut parser = Parser::new("fn test() { τ{x + 1} }".to_string());
    let file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
fn test_parse_match() {
    let source = r#"
        fn test() {
            match x {
                0 => "zero",
                n => "other",
            }
        }
    "#;
    let mut parser = Parser::new(source.to_string());
    let file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
fn test_parse_trait() {
    let source = r#"
        trait Display {
            fn fmt(self) -> String;
        }
    "#;
    let mut parser = Parser::new(source.to_string());
    let file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}

#[test]
fn test_parse_impl() {
    let source = r#"
        impl Display for Point {
            fn fmt(self) -> String {
                f"({self.x}, {self.y})"
            }
        }
    "#;
    let mut parser = Parser::new(source.to_string());
    let file = parser.parse_file().unwrap();
    assert_eq!(file.items.len(), 1);
}
