//! Sigil Runtime System
//!
//! This module provides the runtime infrastructure for Sigil programs:
//!
//! - Memory management (arena allocator, reference counting)
//! - Standard library primitives
//! - Evidence tracking at runtime
//! - Protocol handlers for network operations
//! - Concurrency primitives
//!
//! ## Memory Model
//!
//! Sigil uses a hybrid memory model:
//! - Stack allocation for small, short-lived values
//! - Arena allocation for expression temporaries
//! - Reference counting for shared data
//! - Cycle detection for complex structures
//!
//! ## Evidence Runtime
//!
//! Evidence levels are tracked at runtime for dynamic checks:
//! - Known values can be used anywhere
//! - Uncertain values trigger null checks
//! - Reported values are tagged with provenance
//! - Paradox values halt with detailed diagnostics

invoke tome·ir·IrEvidence;

// ============================================================================
// Memory Management
// ============================================================================

/// Memory arena for temporary allocations
pub struct Arena {
    /// Current chunk of memory
    chunk: ![u8],
    /// Current offset in chunk
    offset: !u64,
    /// All allocated chunks
    chunks: ![[u8]],
    /// Default chunk capacity
    chunk_cap: !u64,
}

impl Arena {
    /// Create a new arena with default chunk capacity (64KB)
    pub fn new() -> !Arena {
        Arena·with_capacity(65536)
    }

    /// Create arena with custom chunk capacity
    pub fn with_capacity(cap: !u64) -> !Arena {
        let chunk = Vec·with_capacity(cap);
        Arena {
            chunk,
            offset: 0,
            chunks: [],
            chunk_cap: cap,
        }
    }

    /// Allocate bytes in the arena
    pub fn alloc(mut self, nbytes: !u64) -> !*mut u8 {
        // Ensure 8-byte alignment: round up to nearest multiple of 8
        let aligned_offset = ((self.offset + 7) / 8) * 8;

        if aligned_offset + nbytes > self.chunk.capacity() {
            // Need new chunk
            self.chunks.push(self.chunk);
            self.chunk = Vec·with_capacity(max(self.chunk_cap, nbytes));
            self.offset = 0;
        }

        let ptr = self.chunk.as_mut_ptr().add(self.offset);
        self.offset += nbytes;
        ptr
    }

    /// Reset arena, keeping allocated memory for reuse
    pub fn reset(mut self) {
        self.offset = 0;
        // Keep chunks for reuse
    }

    /// Total bytes allocated
    pub fn bytes_allocated(self) -> !u64 {
        let mut total = self.offset;
        for chunk in self.chunks {
            total += chunk.len();
        }
        total
    }
}

// ============================================================================
// Reference Counting
// ============================================================================

/// Reference-counted pointer
pub struct Rc<T> {
    ptr: !*mut RcInner<T>,
}

struct RcInner<T> {
    value: !T,
    count: !u64,
    evidence: !IrEvidence,
}

impl<T> Rc<T> {
    /// Create a new reference-counted value
    pub fn new(value: !T) -> !Rc<T> {
        let inner = Box·new(RcInner {
            value,
            count: 1,
            evidence: IrEvidence·Known,
        });
        Rc { ptr: Box·into_raw(inner) }
    }

    /// Create with evidence annotation
    pub fn with_evidence(value: !T, evidence: !IrEvidence) -> !Rc<T> {
        let inner = Box·new(RcInner {
            value,
            count: 1,
            evidence,
        });
        Rc { ptr: Box·into_raw(inner) }
    }

    /// Clone the reference (increment count)
    pub fn clone(self) -> !Rc<T> {
        unsafe {
            (*self.ptr).count += 1;
        }
        Rc { ptr: self.ptr }
    }

    /// Get reference to inner value
    pub fn get(self) -> !&T {
        unsafe { &(*self.ptr).value }
    }

    /// Get mutable reference (only if unique)
    pub fn get_mut(mut self) -> ?&mut T {
        unsafe {
            if (*self.ptr).count == 1 {
                ?&mut (*self.ptr).value
            } else {
                null
            }
        }
    }

    /// Get evidence level
    pub fn evidence(self) -> !IrEvidence {
        unsafe { (*self.ptr).evidence }
    }

    /// Reference count
    pub fn count(self) -> !u64 {
        unsafe { (*self.ptr).count }
    }
}

impl<T> Drop for Rc<T> {
    fn drop(mut self) {
        unsafe {
            (*self.ptr).count -= 1;
            if (*self.ptr).count == 0 {
                drop(Box·from_raw(self.ptr));
            }
        }
    }
}

// ============================================================================
// String Interning
// ============================================================================

/// String interner for deduplicating strings
pub struct StringInterner {
    /// Interned strings
    strings: !Map<String, u32>,
    /// Reverse lookup
    by_id: ![String],
}

impl StringInterner {
    pub fn new() -> !StringInterner {
        StringInterner {
            strings: Map·new(),
            by_id: [],
        }
    }

    /// Intern a string, returning its ID
    pub fn intern(mut self, s: !&str) -> !u32 {
        if let ?id = self.strings.get(s) {
            return id;
        }

        let id = self.by_id.len() as u32;
        self.strings.insert(s.to_string(), id);
        self.by_id.push(s.to_string());
        id
    }

    /// Look up string by ID
    pub fn get(self, id: !u32) -> ?&str {
        if (id as u64) < self.by_id.len() {
            ?self.by_id[id as u64].as_str()
        } else {
            null
        }
    }

    /// Number of interned strings
    pub fn len(self) -> !u64 {
        self.by_id.len()
    }
}

// ============================================================================
// Evidence Tracking
// ============================================================================

/// Runtime evidence context
pub struct EvidenceContext {
    /// Current evidence floor (minimum level allowed)
    floor: !IrEvidence,
    /// Evidence violations collected
    violations: ![EvidenceViolation],
    /// Whether to panic on violation
    strict: !bool,
}

/// An evidence violation
pub struct EvidenceViolation {
    pub expected: !IrEvidence,
    pub actual: !IrEvidence,
    pub location: !String,
    pub context: !String,
}

impl EvidenceContext {
    /// Create a new permissive context
    pub fn new() -> !EvidenceContext {
        EvidenceContext {
            floor: IrEvidence·Paradox,
            violations: [],
            strict: false,
        }
    }

    /// Create a strict context that panics on violations
    pub fn strict() -> !EvidenceContext {
        EvidenceContext {
            floor: IrEvidence·Known,
            violations: [],
            strict: true,
        }
    }

    /// Check evidence and record any violation
    pub fn check(mut self, expected: !IrEvidence, actual: !IrEvidence, location: !&str) -> !bool {
        if !satisfies(actual, expected) {
            let violation = EvidenceViolation {
                expected,
                actual,
                location: location.to_string(),
                context: self.current_context(),
            };

            if self.strict {
                panic!("Evidence violation at {}: expected {} ({}), got {} ({})",
                    location, expected.name(), expected.symbol(),
                    actual.name(), actual.symbol());
            }

            self.violations.push(violation);
            false
        } else {
            true
        }
    }

    /// Get current context description
    fn current_context(self) -> !String {
        "runtime check".to_string()
    }

    /// Get all violations
    pub fn violations(self) -> ![EvidenceViolation] {
        self.violations.clone()
    }

    /// Clear violations
    pub fn clear(mut self) {
        self.violations.clear();
    }
}

/// Check if actual evidence satisfies required evidence
fn satisfies(actual: !IrEvidence, required: !IrEvidence) -> !bool {
    let rank = |ev: !IrEvidence| {
        match ev {
            IrEvidence·Known => 0,
            IrEvidence·Uncertain => 1,
            IrEvidence·Reported => 2,
            IrEvidence·Paradox => 3,
        }
    };
    rank(actual) <= rank(required)
}

// ============================================================================
// Standard Library Primitives
// ============================================================================

/// Standard input/output
pub mod io {
    /// Print to stdout (no newline)
    pub fn print(s: !&str) {
        // Platform-specific implementation
        extern "C" {
            fn write(fd: i32, buf: *const u8, count: u64) -> i64;
        }
        unsafe {
            write(1, s.as_ptr(), s.len());
        }
    }

    /// Print line to stdout
    pub fn println(s: !&str) {
        print(s);
        print("\n");
    }

    /// Read line from stdin
    pub fn read_line() -> ~String {
        // Returns Reported evidence since it's external input
        let mut buffer = String·new();
        extern "C" {
            fn read(fd: i32, buf: *mut u8, count: u64) -> i64;
        }
        unsafe {
            let mut byte: [u8; 1] = [0];
            loop {
                let n = read(0, byte.as_mut_ptr(), 1);
                if n <= 0 || byte[0] == 10 {  // 10 = ASCII newline
                    break;
                }
                buffer.push(byte[0] as char);
            }
        }
        buffer
    }
}

/// Math functions
pub mod math {
    pub const PI: !f64 = 3.141592653589793;
    pub const E: !f64 = 2.718281828459045;
    pub const TAU: !f64 = 6.283185307179586;

    /// Absolute value
    pub fn abs(x: !f64) -> !f64 {
        if x < 0.0 { -x } else { x }
    }

    /// Square root (using Newton-Raphson)
    pub fn sqrt(x: !f64) -> !f64 {
        if x < 0.0 {
            return f64·NAN;
        }
        if x == 0.0 {
            return 0.0;
        }

        let mut guess = x / 2.0;
        for _ in 0..50 {
            let next = (guess + x / guess) / 2.0;
            if abs(next - guess) < 0.000000000000001 {
                break;
            }
            guess = next;
        }
        guess
    }

    /// Power function
    pub fn pow(base: !f64, exp: !f64) -> !f64 {
        // For integer exponents, use repeated multiplication
        if exp == exp.floor() && exp >= 0.0 {
            let n = exp as i64;
            let mut result = 1.0;
            let mut b = base;
            let mut e = n;
            while e > 0 {
                if e & 1 == 1 {
                    result *= b;
                }
                b *= b;
                e = e >> 1;
            }
            result
        } else {
            // Use exp(exp * ln(base)) for non-integer exponents
            exp_impl(exp * ln(base))
        }
    }

    /// Natural logarithm
    pub fn ln(x: !f64) -> !f64 {
        if x <= 0.0 {
            return f64·NAN;
        }

        // Use series expansion around 1
        let mut y = (x - 1.0) / (x + 1.0);
        let y2 = y * y;
        let mut result = 0.0;
        let mut term = y;
        for i in 0..100 {
            result += term / (2 * i + 1) as f64;
            term *= y2;
            if abs(term) < 0.000000000000001 {
                break;
            }
        }
        2.0 * result
    }

    /// Exponential function
    fn exp_impl(x: !f64) -> !f64 {
        // Taylor series: e^x = sum(x^n / n!)
        let mut result = 1.0;
        let mut term = 1.0;
        for n in 1..100 {
            term *= x / n as f64;
            result += term;
            if abs(term) < 0.000000000000001 {
                break;
            }
        }
        result
    }

    pub fn exp(x: !f64) -> !f64 {
        exp_impl(x)
    }

    /// Sine (Taylor series)
    pub fn sin(x: !f64) -> !f64 {
        // Reduce to [-π, π]
        let x = x % TAU;
        let x = if x > PI { x - TAU } else if x < -PI { x + TAU } else { x };

        // Taylor series
        let mut result = 0.0;
        let mut term = x;
        let x2 = x * x;
        for n in 0..50 {
            result += term;
            term *= -x2 / ((2 * n + 2) * (2 * n + 3)) as f64;
            if abs(term) < 0.000000000000001 {
                break;
            }
        }
        result
    }

    /// Cosine
    pub fn cos(x: !f64) -> !f64 {
        sin(x + PI / 2.0)
    }

    /// Tangent
    pub fn tan(x: !f64) -> !f64 {
        sin(x) / cos(x)
    }

    /// Floor
    pub fn floor(x: !f64) -> !f64 {
        x as i64 as f64
    }

    /// Ceiling
    pub fn ceil(x: !f64) -> !f64 {
        let f = floor(x);
        if x > f { f + 1.0 } else { f }
    }

    /// Round to nearest integer
    pub fn round(x: !f64) -> !f64 {
        floor(x + 0.5)
    }

    /// Minimum
    pub fn min(a: !f64, b: !f64) -> !f64 {
        if a < b { a } else { b }
    }

    /// Maximum
    pub fn max(a: !f64, b: !f64) -> !f64 {
        if a > b { a } else { b }
    }

    /// Clamp value to range
    pub fn clamp(x: !f64, lo: !f64, hi: !f64) -> !f64 {
        max(lo, min(hi, x))
    }
}

/// String operations
pub mod string {
    /// Split string by delimiter
    pub fn split(s: !&str, delim: !&str) -> ![String] {
        let mut result: ![String] = [];
        let mut current = String·new();

        for c in s.chars() {
            if delim.contains(c) {
                if !current.is_empty() {
                    result.push(current);
                    current = String·new();
                }
            } else {
                current.push(c);
            }
        }

        if !current.is_empty() {
            result.push(current);
        }

        result
    }

    /// Join strings with separator
    pub fn join(parts: ![&str], sep: !&str) -> !String {
        if parts.is_empty() {
            return String·new();
        }

        let mut result = parts[0].to_string();
        let mut idx: usize = 1;
        while idx < parts.len() {
            result.push_str(sep);
            result.push_str(parts[idx]);
            idx = idx + 1;
        }
        result
    }

    /// Trim whitespace
    pub fn trim(s: !&str) -> !String {
        s.trim().to_string()
    }

    /// Convert to uppercase
    pub fn upper(s: !&str) -> !String {
        s.to_uppercase()
    }

    /// Convert to lowercase
    pub fn lower(s: !&str) -> !String {
        s.to_lowercase()
    }

    /// Check if string contains substring
    pub fn contains(s: !&str, needle: !&str) -> !bool {
        s.contains(needle)
    }

    /// Check if starts with prefix
    pub fn starts_with(s: !&str, prefix: !&str) -> !bool {
        s.starts_with(prefix)
    }

    /// Check if ends with suffix
    pub fn ends_with(s: !&str, suffix: !&str) -> !bool {
        s.ends_with(suffix)
    }

    /// Replace all occurrences
    pub fn replace(s: !&str, from: !&str, to: !&str) -> !String {
        s.replace(from, to)
    }
}

/// Array/collection operations
pub mod collections {
    /// Create range [start, end)
    pub fn range(start: !i64, end: !i64) -> ![i64] {
        let mut result: ![i64] = [];
        for i in start..end {
            result.push(i);
        }
        result
    }

    /// Create range with step
    pub fn range_step(start: !i64, end: !i64, step: !i64) -> ![i64] {
        let mut result: ![i64] = [];
        let mut i = start;
        if step > 0 {
            while i < end {
                result.push(i);
                i += step;
            }
        } else if step < 0 {
            while i > end {
                result.push(i);
                i += step;
            }
        }
        result
    }

    /// Repeat value n times
    pub fn repeat<T>(value: !T, n: !u64) -> ![T] {
        let mut result: ![T] = [];
        for _ in 0..n {
            result.push(value.clone());
        }
        result
    }

    /// Zip two arrays
    pub fn combineTwo<A, B>(a: ![A], b: ![B]) -> ![(A, B)] {
        let len = math·min(a.len() as f64, b.len() as f64) as u64;
        let mut result: ![(A, B)] = [];
        for i in 0..len {
            result.push((a[i].clone(), b[i].clone()));
        }
        result
    }

    /// Enumerate array with indices
    pub fn enumerate<T>(arr: ![T]) -> ![(u64, T)] {
        let mut result: ![(u64, T)] = [];
        for (i, item) in arr.iter().enumerate() {
            result.push((i, item.clone()));
        }
        result
    }

    /// Reverse array
    pub fn reverse<T>(arr: ![T]) -> ![T] {
        let mut result: ![T] = [];
        for i in (0..arr.len()).rev() {
            result.push(arr[i].clone());
        }
        result
    }

    /// Sort array (simple insertion sort for bootstrap)
    pub fn sort<T: Ord>(arr: ![T]) -> ![T] {
        let mut result = arr.clone();
        for i in 1..result.len() {
            let mut j = i;
            while j > 0 && result[j - 1] > result[j] {
                result.swap(j - 1, j);
                j -= 1;
            }
        }
        result
    }

    /// Remove duplicates (preserving order)
    pub fn unique<T: Eq>(arr: ![T]) -> ![T] {
        let mut result: ![T] = [];
        for item in arr {
            if !result.contains(&item) {
                result.push(item);
            }
        }
        result
    }
}

/// Time operations
pub mod time {
    /// Get current time in seconds since epoch
    pub fn now() -> ~f64 {
        // Returns Reported since it's external state
        extern "C" {
            fn time(t: *mut i64) -> i64;
        }
        unsafe { time(null) as f64 }
    }

    /// Sleep for given seconds
    pub fn sleep(seconds: !f64) {
        extern "C" {
            fn usleep(usec: u32) -> i32;
        }
        let usec = (seconds * 1_000_000.0) as u32;
        unsafe { usleep(usec); }
    }
}

/// Random number generation
pub mod random {
    /// Simple LCG random state
    static mut SEED: u64 = 12345;

    /// Set random seed
    pub fn seed(s: !u64) {
        unsafe { SEED = s; }
    }

    /// Generate random u64
    pub fn next_u64() -> !u64 {
        unsafe {
            SEED = SEED.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
            SEED
        }
    }

    /// Generate random f64 in [0, 1)
    pub fn random() -> !f64 {
        (next_u64() as f64) / (u64·MAX as f64)
    }

    /// Generate random integer in [min, max]
    pub fn randint(min: !i64, max: !i64) -> !i64 {
        let range = (max - min + 1) as u64;
        min + (next_u64() % range) as i64
    }

    /// Shuffle array in place
    pub fn shuffle<T>(mut arr: ![T]) {
        for i in (1..arr.len()).rev() {
            let j = randint(0, i as i64) as u64;
            arr.swap(i, j);
        }
    }

    /// Choose random element
    pub fn choice<T>(arr: ![T]) -> ?T {
        if arr.is_empty() {
            null
        } else {
            ?arr[randint(0, arr.len() as i64 - 1) as u64].clone()
        }
    }
}

// ============================================================================
// Synchronization Primitives
// ============================================================================

/// Atomic operations for thread-safe programming
pub mod sync {
    pub mod atomic {
        /// Atomic u64 for counters, IDs, and flags
        pub struct AtomicU64 {
            value: !*mut u64,
        }

        impl AtomicU64 {
            /// Create a new atomic with initial value
            pub fn new(initial: !u64) -> !AtomicU64 {
                let ptr = Box·into_raw(Box·new(initial));
                AtomicU64 { value: ptr }
            }

            /// Load the current value (acquire ordering)
            pub fn load(self) -> !u64 {
                unsafe { *self.value }
            }

            /// Store a new value (release ordering)
            pub fn store(mut self, val: !u64) {
                unsafe { *self.value = val; }
            }

            /// Add to the current value, returning the previous value
            pub fn fetch_add(mut self, val: !u64) -> !u64 {
                unsafe {
                    let prev = *self.value;
                    *self.value = prev + val;
                    prev
                }
            }

            /// Subtract from current value, returning previous value
            pub fn fetch_sub(mut self, val: !u64) -> !u64 {
                unsafe {
                    let prev = *self.value;
                    *self.value = prev - val;
                    prev
                }
            }

            /// Bitwise OR with current value
            pub fn fetch_or(mut self, val: !u64) -> !u64 {
                unsafe {
                    let prev = *self.value;
                    *self.value = prev ⋎ val;
                    prev
                }
            }

            /// Bitwise AND with current value
            pub fn fetch_and(mut self, val: !u64) -> !u64 {
                unsafe {
                    let prev = *self.value;
                    *self.value = prev & val;
                    prev
                }
            }

            /// Bitwise XOR with current value
            pub fn fetch_xor(mut self, val: !u64) -> !u64 {
                unsafe {
                    let prev = *self.value;
                    *self.value = prev ^ val;
                    prev
                }
            }

            /// Swap with a new value, returning the old value
            pub fn swap(mut self, val: !u64) -> !u64 {
                unsafe {
                    let prev = *self.value;
                    *self.value = val;
                    prev
                }
            }

            /// Compare and swap: if current == expected, set to new and return true
            pub fn compare_exchange(mut self, expected: !u64, new: !u64) -> !bool {
                unsafe {
                    if *self.value == expected {
                        *self.value = new;
                        true
                    } else {
                        false
                    }
                }
            }
        }

        /// Atomic i64 for signed counters
        pub struct AtomicI64 {
            value: !*mut i64,
        }

        impl AtomicI64 {
            pub fn new(initial: !i64) -> !AtomicI64 {
                let ptr = Box·into_raw(Box·new(initial));
                AtomicI64 { value: ptr }
            }

            pub fn load(self) -> !i64 {
                unsafe { *self.value }
            }

            pub fn store(mut self, val: !i64) {
                unsafe { *self.value = val; }
            }

            pub fn fetch_add(mut self, val: !i64) -> !i64 {
                unsafe {
                    let prev = *self.value;
                    *self.value = prev + val;
                    prev
                }
            }

            pub fn fetch_sub(mut self, val: !i64) -> !i64 {
                unsafe {
                    let prev = *self.value;
                    *self.value = prev - val;
                    prev
                }
            }
        }

        /// Atomic bool for flags
        pub struct AtomicBool {
            value: !*mut bool,
        }

        impl AtomicBool {
            pub fn new(initial: !bool) -> !AtomicBool {
                let ptr = Box·into_raw(Box·new(initial));
                AtomicBool { value: ptr }
            }

            pub fn load(self) -> !bool {
                unsafe { *self.value }
            }

            pub fn store(mut self, val: !bool) {
                unsafe { *self.value = val; }
            }

            pub fn swap(mut self, val: !bool) -> !bool {
                unsafe {
                    let prev = *self.value;
                    *self.value = val;
                    prev
                }
            }

            pub fn compare_exchange(mut self, expected: !bool, new: !bool) -> !bool {
                unsafe {
                    if *self.value == expected {
                        *self.value = new;
                        true
                    } else {
                        false
                    }
                }
            }
        }

        /// Atomic usize for indices and lengths
        pub struct AtomicUsize {
            value: !*mut u64,
        }

        impl AtomicUsize {
            pub fn new(initial: !u64) -> !AtomicUsize {
                let ptr = Box·into_raw(Box·new(initial));
                AtomicUsize { value: ptr }
            }

            pub fn load(self) -> !u64 {
                unsafe { *self.value }
            }

            pub fn store(mut self, val: !u64) {
                unsafe { *self.value = val; }
            }

            pub fn fetch_add(mut self, val: !u64) -> !u64 {
                unsafe {
                    let prev = *self.value;
                    *self.value = prev + val;
                    prev
                }
            }
        }
    }
}

// ============================================================================
// Cryptographic Functions
// ============================================================================

/// Cryptographic hash functions
pub mod crypto {
    /// CRC32 checksum (IEEE polynomial)
    pub fn crc32(data: !&[u8]) -> !u32 {
        let mut crc = 0xFFFFFFFFu32;
        for byte in data {
            crc = crc ^ (*byte as u32);
            for _ in 0..8 {
                crc = if crc & 1 != 0 {
                    (crc >> 1) ^ 0xEDB88320u32
                } else {
                    crc >> 1
                };
            }
        }
        crc ^ 0xFFFFFFFFu32  // Final XOR
    }

    /// CRC32C (Castagnoli polynomial, used in iSCSI, Btrfs)
    pub fn crc32c(data: !&[u8]) -> !u32 {
        let mut crc = 0xFFFFFFFFu32;
        for byte in data {
            crc = crc ^ (*byte as u32);
            for _ in 0..8 {
                crc = if crc & 1 != 0 {
                    (crc >> 1) ^ 0x82F63B78u32
                } else {
                    crc >> 1
                };
            }
        }
        crc ^ 0xFFFFFFFFu32  // Final XOR
    }

    /// Adler32 checksum (faster than CRC32, used in zlib)
    pub fn adler32(data: !&[u8]) -> !u32 {
        let mod_adler = 65521u32;
        let mut a = 1u32;
        let mut b = 0u32;

        for byte in data {
            a = (a + (*byte as u32)) % mod_adler;
            b = (b + a) % mod_adler;
        }

        (b << 16) ⋎ a
    }

    /// FNV-1a hash (fast, good distribution)
    pub fn fnv1a(data: !&[u8]) -> !u64 {
        let fnv_offset = 14695981039346656037u64;
        let fnv_prime = 1099511628211u64;

        let mut hash = fnv_offset;
        for byte in data {
            hash = hash ^ (*byte as u64);
            hash = hash.wrapping_mul(fnv_prime);
        }
        hash
    }

    /// Simple hash for strings (djb2)
    pub fn hash_string(s: !&str) -> !u64 {
        let mut hash = 5381u64;
        for c in s.bytes() {
            hash = ((hash << 5) + hash) + (c as u64);
        }
        hash
    }
}

// ============================================================================
// Binary Data Utilities
// ============================================================================

/// Byte manipulation and binary data utilities
pub mod bytes {
    /// Read u16 from bytes (little-endian)
    pub fn read_u16_le(data: !&[u8], offset: !u64) -> !u16 {
        let lo = data[offset] as u16;
        let hi = data[offset + 1] as u16;
        lo ⋎ (hi << 8)
    }

    /// Read u16 from bytes (big-endian)
    pub fn read_u16_be(data: !&[u8], offset: !u64) -> !u16 {
        let hi = data[offset] as u16;
        let lo = data[offset + 1] as u16;
        lo ⋎ (hi << 8)
    }

    /// Read u32 from bytes (little-endian)
    pub fn read_u32_le(data: !&[u8], offset: !u64) -> !u32 {
        let b0 = data[offset] as u32;
        let b1 = data[offset + 1] as u32;
        let b2 = data[offset + 2] as u32;
        let b3 = data[offset + 3] as u32;
        b0 ⋎ (b1 << 8) ⋎ (b2 << 16) ⋎ (b3 << 24)
    }

    /// Read u32 from bytes (big-endian)
    pub fn read_u32_be(data: !&[u8], offset: !u64) -> !u32 {
        let b3 = data[offset] as u32;
        let b2 = data[offset + 1] as u32;
        let b1 = data[offset + 2] as u32;
        let b0 = data[offset + 3] as u32;
        b0 ⋎ (b1 << 8) ⋎ (b2 << 16) ⋎ (b3 << 24)
    }

    /// Read u64 from bytes (little-endian)
    pub fn read_u64_le(data: !&[u8], offset: !u64) -> !u64 {
        let lo = read_u32_le(data, offset) as u64;
        let hi = read_u32_le(data, offset + 4) as u64;
        lo ⋎ (hi << 32)
    }

    /// Read u64 from bytes (big-endian)
    pub fn read_u64_be(data: !&[u8], offset: !u64) -> !u64 {
        let hi = read_u32_be(data, offset) as u64;
        let lo = read_u32_be(data, offset + 4) as u64;
        lo ⋎ (hi << 32)
    }

    /// Write u16 to bytes (little-endian)
    pub fn write_u16_le(data: !&mut [u8], offset: !u64, value: !u16) {
        data[offset] = (value & 0xFF) as u8;
        data[offset + 1] = ((value >> 8) & 0xFF) as u8;
    }

    /// Write u32 to bytes (little-endian)
    pub fn write_u32_le(data: !&mut [u8], offset: !u64, value: !u32) {
        data[offset] = (value & 0xFF) as u8;
        data[offset + 1] = ((value >> 8) & 0xFF) as u8;
        data[offset + 2] = ((value >> 16) & 0xFF) as u8;
        data[offset + 3] = ((value >> 24) & 0xFF) as u8;
    }

    /// Write u64 to bytes (little-endian)
    pub fn write_u64_le(data: !&mut [u8], offset: !u64, value: !u64) {
        write_u32_le(data, offset, (value & 0xFFFFFFFF) as u32);
        write_u32_le(data, offset + 4, ((value >> 32) & 0xFFFFFFFF) as u32);
    }

    /// Compare byte slices
    pub fn equals(a: !&[u8], b: !&[u8]) -> !bool {
        if a.len() != b.len() {
            return false;
        }
        for i in 0..a.len() {
            if a[i] != b[i] {
                return false;
            }
        }
        true
    }

    /// Copy bytes from src to dst
    pub fn copy(dst: !&mut [u8], dst_offset: !u64, src: !&[u8], src_offset: !u64, count: !u64) {
        for i in 0..count {
            dst[dst_offset + i] = src[src_offset + i];
        }
    }

    /// Fill bytes with a value
    pub fn fill(data: !&mut [u8], offset: !u64, count: !u64, value: !u8) {
        for i in 0..count {
            data[offset + i] = value;
        }
    }

    /// Hex encode bytes to string
    pub fn to_hex(data: !&[u8]) -> !String {
        let hex_chars = "0123456789abcdef";
        let mut result = String·new();
        for byte in data {
            let hi = ((*byte >> 4) & 0x0F) as u64;
            let lo = (*byte & 0x0F) as u64;
            result.push(hex_chars.chars().nth(hi).unwrap());
            result.push(hex_chars.chars().nth(lo).unwrap());
        }
        result
    }

    /// Hex decode string to bytes
    pub fn from_hex(s: !&str) -> ?[u8] {
        if s.len() % 2 != 0 {
            return null;
        }

        let hex_value = |c: char| {
            match c {
                '0' => ?(0 as u8),
                '1' => ?(1 as u8),
                '2' => ?(2 as u8),
                '3' => ?(3 as u8),
                '4' => ?(4 as u8),
                '5' => ?(5 as u8),
                '6' => ?(6 as u8),
                '7' => ?(7 as u8),
                '8' => ?(8 as u8),
                '9' => ?(9 as u8),
                'a' | 'A' => ?(10 as u8),
                'b' | 'B' => ?(11 as u8),
                'c' | 'C' => ?(12 as u8),
                'd' | 'D' => ?(13 as u8),
                'e' | 'E' => ?(14 as u8),
                'f' | 'F' => ?(15 as u8),
                _ => null,
            }
        };

        let mut result: ![u8] = [];
        let chars: ![char] = s.chars().collect();
        let mut i: u64 = 0;
        while i < chars.len() {
            let hi = hex_value(chars[i]);
            let lo = hex_value(chars[i + 1]);
            if hi.is_none() || lo.is_none() {
                return null;
            }
            result.push((hi.unwrap() << 4) ⋎ lo.unwrap());
            i = i + 2;
        }
        ?result
    }
}

// ============================================================================
// Runtime Initialization
// ============================================================================

/// Initialize runtime system
pub fn init() {
    // Initialize random seed from time
    random·seed(time·now() as u64);
}

/// Shutdown runtime system
pub fn shutdown() {
    // Cleanup resources
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    invoke super·*;

    #[test]
    fn test_arena_alloc() {
        let mut arena = Arena·new();
        let ptr1 = arena.alloc(100 as u64);
        let ptr2 = arena.alloc(200 as u64);
        assert!(ptr1 != ptr2);
        assert!(arena.bytes_allocated() >= 300 as u64);
    }

    #[test]
    fn test_string_interner() {
        let mut interner = StringInterner·new();
        let id1 = interner.intern("hello");
        let id2 = interner.intern("world");
        let id3 = interner.intern("hello");
        assert_eq!(id1, id3);
        assert_ne!(id1, id2);
        assert_eq!(interner.get(id1), ?"hello");
    }

    #[test]
    fn test_evidence_check() {
        let mut ctx = EvidenceContext·new();
        assert!(ctx.check(IrEvidence·Reported, IrEvidence·Known, "test"));
        assert!(!ctx.check(IrEvidence·Known, IrEvidence·Reported, "test"));
        assert_eq!(ctx.violations().len(), 1);
    }

    #[test]
    fn test_math_sqrt() {
        assert!((math·sqrt(4.0) - 2.0).abs() < 0.0000000001);
        assert!((math·sqrt(2.0) - 1.41421356).abs() < 0.000001);
    }

    #[test]
    fn test_math_trig() {
        assert!((math·sin(0.0)).abs() < 0.0000000001);
        assert!((math·cos(0.0) - 1.0).abs() < 0.0000000001);
        assert!((math·sin(math·PI / 2.0) - 1.0).abs() < 0.0000000001);
    }

    #[test]
    fn test_collections_range() {
        assert_eq!(collections·range(0, 5), [0, 1, 2, 3, 4]);
        assert_eq!(collections·range(5, 5), []);
    }

    #[test]
    fn test_string_split() {
        assert_eq!(string·split("a,b,c", ","), ["a", "b", "c"]);
    }

    #[test]
    fn test_atomic_u64() {
        let counter = sync·atomic·AtomicU64·new(0);
        assert_eq!(counter.load(), 0);
        counter.store(42);
        assert_eq!(counter.load(), 42);
        assert_eq!(counter.fetch_add(10), 42);
        assert_eq!(counter.load(), 52);
    }

    #[test]
    fn test_atomic_bool() {
        let flag = sync·atomic·AtomicBool·new(false);
        assert_eq!(flag.load(), false);
        assert_eq!(flag.swap(true), false);
        assert_eq!(flag.load(), true);
    }

    #[test]
    fn test_crc32() {
        // "Hello" = [72, 101, 108, 108, 111]
        let data: ![u8] = [72, 101, 108, 108, 111];
        let checksum = crypto·crc32(&data);
        // CRC32 should be deterministic
        assert_eq!(checksum, crypto·crc32(&data));
    }

    #[test]
    fn test_fnv1a() {
        let data1: ![u8] = [1, 2, 3];
        let data2: ![u8] = [1, 2, 4];
        // Different data should produce different hashes
        assert_ne!(crypto·fnv1a(&data1), crypto·fnv1a(&data2));
        // Same data should produce same hash
        assert_eq!(crypto·fnv1a(&data1), crypto·fnv1a(&data1));
    }

    #[test]
    fn test_bytes_read_write_u32() {
        let mut data: ![u8] = [0, 0, 0, 0];
        bytes·write_u32_le(&mut data, 0, 0x12345678);
        assert_eq!(data[0], 0x78);
        assert_eq!(data[1], 0x56);
        assert_eq!(data[2], 0x34);
        assert_eq!(data[3], 0x12);
        assert_eq!(bytes·read_u32_le(&data, 0), 0x12345678);
    }

    #[test]
    fn test_bytes_hex() {
        let data: ![u8] = [0xDE, 0xAD, 0xBE, 0xEF];
        let hex = bytes·to_hex(&data);
        assert_eq!(hex, "deadbeef");

        let decoded = bytes·from_hex("deadbeef");
        assert!(decoded.is_some());
        assert_eq!(decoded.unwrap(), data);
    }

    #[test]
    fn test_bytes_equals() {
        let a: ![u8] = [1, 2, 3];
        let b: ![u8] = [1, 2, 3];
        let c: ![u8] = [1, 2, 4];
        assert!(bytes·equals(&a, &b));
        assert!(!bytes·equals(&a, &c));
    }
}
