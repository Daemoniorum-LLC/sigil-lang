// Commune Core Implementation
// Multi-agent communication infrastructure

invoke crate·types·*;
invoke std·collections·{HashMap, HashSet};
invoke std·time·{Duration, Timestamp};

// ============================================================================
// Commune - The Communication Network
// ============================================================================

/// The main commune - a network of communicating agents
☉ Σ Commune {
    /// Configuration
    config: CommuneConfig,

    /// Registered agents
    agents: HashMap<AgentId, AgentInfo>,

    /// Communication channels
    channels: HashMap<ChannelId, Channel>,

    /// Trust manager
    trust: TrustManager,

    /// Channel router
    router: ChannelRouter,

    /// Collective memory
    collective: CollectiveMemory,

    /// Swarm coordinator
    swarms: SwarmCoordinator,

    /// Consensus engine
    consensus: ConsensusEngine,

    /// Message queue
    queue: MessageQueue,
}

⊢ Commune {
    ☉ λ new(config: CommuneConfig) -> Self {
        Self {
            config: config.clone(),
            agents: HashMap·new(),
            channels: HashMap·new(),
            trust: TrustManager·new(config.trust_model.clone()),
            router: ChannelRouter·new(),
            collective: CollectiveMemory·new(),
            swarms: SwarmCoordinator·new(),
            consensus: ConsensusEngine·new(ConsensusConfig·default()),
            queue: MessageQueue·new(),
        }
    }

    /// Create a local commune (in-process)
    ☉ λ local() -> Self {
        Self·new(CommuneConfig·default())
    }

    // ========================================================================
    // Agent Registration
    // ========================================================================

    /// Register an agent with the commune
    ☉ λ register(&Δ self, agent_id: AgentId, info: AgentInfo) {
        self.agents.insert(agent_id.clone(), info);
        self.trust.add_agent(agent_id);
    }

    /// Unregister an agent
    ☉ λ unregister(&Δ self, agent_id: &AgentId) {
        self.agents.remove(agent_id);

        // Remove from all channels
        ∀ channel ∈ self.channels.values_mut() {
            channel.subscribers.remove(agent_id);
        }

        // Remove from all swarms
        self.swarms.remove_from_all(agent_id);
    }

    /// Check ⎇ agent is registered
    ☉ λ is_registered(&self, agent_id: &AgentId) -> bool {
        self.agents.contains_key(agent_id)
    }

    // ========================================================================
    // Messaging
    // ========================================================================

    /// Send a message
    ☉ λ send(&Δ self, message: Message) -> Result<MessageId, CommuneError> {
        // Validate sender
        ⎇ !self.is_registered(&message.header.from) {
            ⤺ Err(CommuneError·SenderNotRegistered);
        }

        // Check trust
        ≔ sender_trust = self.trust.trust_score(&message.header.from, None);
        ⎇ sender_trust < self.config.trust_model.min_trust {
            ⤺ Err(CommuneError·InsufficientTrust);
        }

        // Route to recipients
        ≔ recipients = self.router.route(&message);

        // Deliver to each recipient
        ∀ recipient ∈ recipients {
            self.deliver(&message, &recipient)?;
        }

        Ok(message.id.clone())
    }

    /// Express an intent (higher-level API)
    ☉ λ express(&Δ self, from: AgentId, to: Recipient, intent: Intent) -> IntentBuilder {
        IntentBuilder {
            commune: self,
            from,
            to,
            intent,
            epistemic: Epistemic·Observed,
            confidence: 1.0,
            timeout: intent.default_timeout(),
        }
    }

    λ deliver(&Δ self, message: &Message, recipient: &AgentId) -> Result<(), CommuneError> {
        // Apply epistemic adjustment
        ≔ (new_epistemic, new_confidence) = self.trust.adjust_epistemic(message);

        // Create adjusted message ∀ recipient
        ≔ Δ adjusted = message.clone();
        adjusted.header.epistemic = new_epistemic;
        adjusted.header.confidence = new_confidence;

        // Queue ∀ delivery
        self.queue.enqueue(recipient.clone(), adjusted);

        Ok(())
    }

    /// Receive messages ∀ an agent
    ☉ λ receive(&Δ self, agent_id: &AgentId) -> Vec<Message> {
        self.queue.dequeue(agent_id)
    }

    // ========================================================================
    // Channels
    // ========================================================================

    /// Create a channel
    ☉ λ create_channel(&Δ self, name: &str) -> ChannelId {
        ≔ channel = Channel·new(name);
        ≔ id = channel.id.clone();
        self.channels.insert(id.clone(), channel);
        self.router.add_channel(id.clone());
        id
    }

    /// Get a channel
    ☉ λ channel(&self, name: &str) -> Option<&Channel> {
        ≔ id = ChannelId·new(name);
        self.channels.get(&id)
    }

    /// Subscribe to a channel
    ☉ λ subscribe(&Δ self, agent_id: AgentId, channel_id: ChannelId) -> Result<(), CommuneError> {
        self.router.subscribe(agent_id, channel_id)
    }

    /// Unsubscribe from a channel
    ☉ λ unsubscribe(&Δ self, agent_id: &AgentId, channel_id: &ChannelId) {
        self.router.unsubscribe(agent_id, channel_id);
    }

    /// Broadcast to a channel
    ☉ λ broadcast(&Δ self, channel_id: &ChannelId, from: AgentId, content: Value) -> Result<(), CommuneError> {
        ≔ message = Message·new(
            from,
            Recipient·Channel(channel_id.clone()),
            Intent·Announce {
                topic: channel_id.name.clone(),
                content,
                importance: Importance·Normal,
            },
        );

        self.send(message)?;
        Ok(())
    }

    // ========================================================================
    // Trust
    // ========================================================================

    /// Get trust score ∀ an agent
    ☉ λ trust_score(&self, agent_id: &AgentId) -> f32 {
        self.trust.trust_score(agent_id, None)
    }

    /// Get trust score ∈ a domain
    ☉ λ trust_score_domain(&self, agent_id: &AgentId, domain: &str) -> f32 {
        self.trust.trust_score(agent_id, Some(domain))
    }

    /// Record accuracy ∀ an agent
    ☉ λ record_accuracy(&Δ self, agent_id: &AgentId, accurate: bool) {
        self.trust.record_accuracy(agent_id, accurate, None);
    }

    /// Vouch ∀ another agent
    ☉ λ vouch(&Δ self, voucher: AgentId, vouchee: AgentId, strength: f32) {
        self.trust.vouch(voucher, vouchee, None, strength);
    }

    // ========================================================================
    // Collective Memory
    // ========================================================================

    /// Contribute knowledge to collective
    ☉ λ contribute(&Δ self, agent: AgentId, knowledge: Knowledge) -> FactId {
        self.collective.contribute(agent, knowledge)
    }

    /// Query collective knowledge
    ☉ λ collective_recall(&self, query: &str) -> Vec<Fact> {
        self.collective.recall(query)
    }

    // ========================================================================
    // Swarm Coordination
    // ========================================================================

    /// Create a swarm
    ☉ λ create_swarm(&Δ self, name: &str) -> SwarmId {
        self.swarms.create_swarm(name)
    }

    /// Join a swarm
    ☉ λ join_swarm(&Δ self, agent_id: AgentId, swarm_id: SwarmId) {
        self.swarms.add_member(swarm_id, agent_id);
    }

    /// Add behavior to swarm
    ☉ λ add_swarm_behavior(&Δ self, swarm_id: SwarmId, behavior: Behavior) {
        self.swarms.add_behavior(swarm_id, behavior);
    }

    /// Step swarm simulation
    ☉ λ step_swarm(&Δ self, swarm_id: &SwarmId) {
        self.swarms.step(swarm_id);
    }

    // ========================================================================
    // Consensus
    // ========================================================================

    /// Create a proposal
    ☉ λ propose(&Δ self, proposer: AgentId, proposal: Proposal) -> ProposalId {
        self.consensus.propose(proposer, proposal.content, proposal.description)
    }

    /// Vote on a proposal
    ☉ λ vote(&Δ self, proposal_id: ProposalId, voter: AgentId, vote: VoteValue, rationale: Option<String>) -> Result<(), CommuneError> {
        self.consensus.vote(proposal_id, voter, vote, rationale)
            .map_err(|e| CommuneError·ConsensusError(format!("{:?}", e)))
    }

    /// Get consensus result
    ☉ λ consensus_result(&self, proposal_id: &ProposalId) -> Option<ConsensusResult> {
        self.consensus.result(proposal_id)
    }

    // ========================================================================
    // Queries
    // ========================================================================

    /// Query agents with capability
    ☉ λ query_agents(&self, capability: &str) -> Vec<&AgentInfo> {
        self.agents.values()
            .filter(|a| a.capabilities.contains(&capability.to_string()))
            .collect()
    }

    /// Query channel members
    ☉ λ channel_members(&self, channel_id: &ChannelId) -> Vec<AgentId> {
        self.channels.get(channel_id)
            .map(|c| c.subscribers.iter().cloned().collect())
            .unwrap_or_default()
    }
}

// ============================================================================
// Agent Info
// ============================================================================

☉ Σ AgentInfo {
    ☉ id: AgentId,
    ☉ name: String,
    ☉ capabilities: Vec<String>,
    ☉ status: AgentStatus,
}

☉ ᛈ AgentStatus {
    Online,
    Busy,
    Away,
    Offline,
}

// ============================================================================
// Intent Builder
// ============================================================================

☉ Σ IntentBuilder<'a> {
    commune: &'a Δ Commune,
    from: AgentId,
    to: Recipient,
    intent: Intent,
    epistemic: Epistemic,
    confidence: f32,
    timeout: Duration,
}

⊢<'a> IntentBuilder<'a> {
    ☉ λ with_epistemic(Δ self, epistemic: Epistemic, confidence: f32) -> Self {
        self.epistemic = epistemic;
        self.confidence = confidence;
        self
    }

    ☉ λ with_timeout(Δ self, timeout: Duration) -> Self {
        self.timeout = timeout;
        self
    }

    ☉ λ execute(self) -> Result<MessageId, CommuneError> {
        ≔ message = Message·new(self.from, self.to, self.intent)
            .with_epistemic(self.epistemic, self.confidence);

        self.commune.send(message)
    }
}

// ============================================================================
// Trust Manager
// ============================================================================

☉ Σ TrustManager {
    profiles: HashMap<AgentId, TrustProfile>,
    config: TrustModelConfig,
}

⊢ TrustManager {
    ☉ λ new(config: TrustModelConfig) -> Self {
        Self {
            profiles: HashMap·new(),
            config,
        }
    }

    ☉ λ add_agent(&Δ self, agent: AgentId) {
        self.profiles.insert(
            agent.clone(),
            TrustProfile·new(agent, self.config.default_trust),
        );
    }

    ☉ λ trust_score(&self, agent: &AgentId, domain: Option<&str>) -> f32 {
        ≔ profile = ⌥ self.profiles.get(agent) {
            Some(p) => p,
            None => ⤺ self.config.default_trust,
        };

        ≔ Δ score = profile.base_trust;

        // Apply domain-specific trust
        ⎇ ≔ Some(d) = domain {
            ⎇ ≔ Some(dt) = profile.domain_trust.get(d) {
                score = *dt;
            }
        }

        // Factor ∈ accuracy
        score *= profile.accuracy.score;

        // Factor ∈ vouches
        ≔ vouch_bonus = profile.vouch_score();
        score = (score + vouch_bonus).min(1.0);

        // Apply decay
        ≔ decay = self.calculate_decay(profile.last_seen);
        score *= decay;

        score.clamp(0.0, 1.0)
    }

    ☉ λ record_accuracy(&Δ self, agent: &AgentId, accurate: bool, domain: Option<String>) {
        ⎇ ≔ Some(profile) = self.profiles.get_mut(agent) {
            profile.accuracy.record(accurate, domain);

            // Update base trust
            profile.base_trust = profile.base_trust * 0.95 +
                (⎇ accurate { 1.0 } ⎉ { 0.0 }) * 0.05;
        }
    }

    ☉ λ vouch(&Δ self, voucher: AgentId, vouchee: AgentId, domain: Option<String>, strength: f32) {
        ≔ voucher_trust = self.trust_score(&voucher, domain.as_deref());
        ⎇ voucher_trust < self.config.min_trust_to_vouch {
            ⤺;
        }

        ⎇ ≔ Some(profile) = self.profiles.get_mut(&vouchee) {
            profile.vouches.push(Vouch {
                voucher,
                domain,
                strength: strength * voucher_trust,
                timestamp: Timestamp·now(),
            });
        }
    }

    ☉ λ adjust_epistemic(&self, msg: &Message) -> (Epistemic, f32) {
        ≔ sender_trust = self.trust_score(&msg.header.from, None);

        ≔ new_epistemic = ⌥ msg.header.epistemic {
            Epistemic·Axiomatic => Epistemic·Reported,
            Epistemic·Observed => Epistemic·Reported,
            Epistemic·Reported => Epistemic·Reported,
            Epistemic·Inferred => Epistemic·Reported,
            e => e,
        };

        ≔ transmission_factor = ⌥ msg.header.epistemic {
            Epistemic·Axiomatic => 0.95,
            Epistemic·Observed => 0.9,
            Epistemic·Reported => 0.8,
            Epistemic·Inferred => 0.5,
            _ => 0.3,
        };

        ≔ new_confidence = msg.header.confidence * sender_trust * transmission_factor;

        (new_epistemic, new_confidence)
    }

    λ calculate_decay(&self, last_seen: Timestamp) -> f32 {
        // Exponential decay based on time since last interaction
        ≔ elapsed = Timestamp·now().nanos.saturating_sub(last_seen.nanos);
        ≔ halflife_nanos = self.config.decay_halflife.as_nanos();

        ⎇ halflife_nanos == 0 {
            ⤺ 1.0;
        }

        ≔ decay = (-0.693 * elapsed as f64 / halflife_nanos as f64).exp();
        decay as f32
    }
}

// ============================================================================
// Channel Router
// ============================================================================

☉ Σ ChannelRouter {
    channels: HashMap<ChannelId, HashSet<AgentId>>,
    subscriptions: HashMap<AgentId, HashSet<ChannelId>>,
}

⊢ ChannelRouter {
    ☉ λ new() -> Self {
        Self {
            channels: HashMap·new(),
            subscriptions: HashMap·new(),
        }
    }

    ☉ λ add_channel(&Δ self, channel_id: ChannelId) {
        self.channels.insert(channel_id, HashSet·new());
    }

    ☉ λ route(&self, msg: &Message) -> Vec<AgentId> {
        ⌥ &msg.header.to {
            Recipient·Agent(id) => vec![id.clone()],
            Recipient·Agents(ids) => ids.clone(),
            Recipient·Channel(channel_id) => {
                self.channels.get(channel_id)
                    .map(|s| s.iter().cloned().collect())
                    .unwrap_or_default()
            }
            Recipient·Broadcast => {
                self.subscriptions.keys().cloned().collect()
            }
            Recipient·Swarm(_) => vec![],  // Handled by swarm coordinator
        }
    }

    ☉ λ subscribe(&Δ self, agent: AgentId, channel_id: ChannelId) -> Result<(), CommuneError> {
        self.channels.entry(channel_id.clone())
            .or_default()
            .insert(agent.clone());

        self.subscriptions.entry(agent)
            .or_default()
            .insert(channel_id);

        Ok(())
    }

    ☉ λ unsubscribe(&Δ self, agent: &AgentId, channel_id: &ChannelId) {
        ⎇ ≔ Some(subscribers) = self.channels.get_mut(channel_id) {
            subscribers.remove(agent);
        }

        ⎇ ≔ Some(subs) = self.subscriptions.get_mut(agent) {
            subs.remove(channel_id);
        }
    }
}

// ============================================================================
// Collective Memory
// ============================================================================

☉ Σ FactId {
    bytes: [u8; 16],
}

⊢ FactId {
    ☉ λ new() -> Self {
        Self { bytes: uuid_v7() }
    }
}

☉ Σ Fact {
    ☉ id: FactId,
    ☉ content: Value,
    ☉ topic: String,
    ☉ epistemic: Epistemic,
    ☉ confidence: f32,
    ☉ contributors: Vec<AgentId>,
}

☉ Σ CollectiveMemory {
    facts: HashMap<FactId, Fact>,
    topic_index: HashMap<String, Vec<FactId>>,
}

⊢ CollectiveMemory {
    ☉ λ new() -> Self {
        Self {
            facts: HashMap·new(),
            topic_index: HashMap·new(),
        }
    }

    ☉ λ contribute(&Δ self, agent: AgentId, knowledge: Knowledge) -> FactId {
        ≔ id = FactId·new();

        ≔ fact = Fact {
            id: id.clone(),
            content: knowledge.content,
            topic: knowledge.topic.clone(),
            epistemic: knowledge.epistemic,
            confidence: knowledge.confidence,
            contributors: vec![agent],
        };

        self.topic_index.entry(knowledge.topic)
            .or_default()
            .push(id.clone());

        self.facts.insert(id.clone(), fact);
        id
    }

    ☉ λ recall(&self, query: &str) -> Vec<Fact> {
        // Simple topic-based recall
        self.topic_index.get(query)
            .map(|ids| ids.iter()
                .filter_map(|id| self.facts.get(id))
                .cloned()
                .collect())
            .unwrap_or_default()
    }
}

⊢ Clone ∀ Fact {
    λ clone(&self) -> Self {
        Self {
            id: FactId { bytes: self.id.bytes },
            content: Value { inner: self.content.inner.clone() },
            topic: self.topic.clone(),
            epistemic: self.epistemic,
            confidence: self.confidence,
            contributors: self.contributors.clone(),
        }
    }
}

// ============================================================================
// Swarm Coordinator
// ============================================================================

☉ Σ SwarmCoordinator {
    swarms: HashMap<SwarmId, Swarm>,
    behaviors: HashMap<SwarmId, Vec<Behavior>>,
}

⊢ SwarmCoordinator {
    ☉ λ new() -> Self {
        Self {
            swarms: HashMap·new(),
            behaviors: HashMap·new(),
        }
    }

    ☉ λ create_swarm(&Δ self, name: &str) -> SwarmId {
        ≔ swarm = Swarm·new(name);
        ≔ id = swarm.id.clone();
        self.swarms.insert(id.clone(), swarm);
        self.behaviors.insert(id.clone(), Vec·new());
        id
    }

    ☉ λ add_member(&Δ self, swarm_id: SwarmId, agent: AgentId) {
        ⎇ ≔ Some(swarm) = self.swarms.get_mut(&swarm_id) {
            swarm.add_member(agent);
        }
    }

    ☉ λ remove_from_all(&Δ self, agent: &AgentId) {
        ∀ swarm ∈ self.swarms.values_mut() {
            swarm.remove_member(agent);
        }
    }

    ☉ λ add_behavior(&Δ self, swarm_id: SwarmId, behavior: Behavior) {
        self.behaviors.entry(swarm_id)
            .or_default()
            .push(behavior);
    }

    ☉ λ step(&Δ self, swarm_id: &SwarmId) {
        ≔ behaviors = self.behaviors.get(swarm_id)
            .map(|b| b.clone())
            .unwrap_or_default();

        ⎇ ≔ Some(swarm) = self.swarms.get_mut(swarm_id) {
            // Compute forces ∀ each member
            ≔ forces: HashMap<AgentId, Vector> = swarm.members.iter()
                .map(|agent| {
                    ≔ force = behaviors.iter()
                        .map(|b| self.compute_force(b, agent, &swarm.state))
                        .fold(Vector·zero(), |acc, f| acc + f);
                    (agent.clone(), force)
                })
                .collect();

            // Update velocities and positions
            ∀ (agent, force) ∈ forces {
                ⎇ ≔ Some(vel) = swarm.state.velocities.get_mut(&agent) {
                    *vel = (*vel + force).clamp_magnitude(swarm.config.max_velocity);
                }
                ⎇ ≔ Some(pos) = swarm.state.positions.get_mut(&agent) {
                    ⎇ ≔ Some(vel) = swarm.state.velocities.get(&agent) {
                        *pos = *pos + *vel;
                    }
                }
            }
        }
    }

    λ compute_force(&self, behavior: &Behavior, agent: &AgentId, state: &SwarmState) -> Vector {
        ≔ pos = state.positions.get(agent).cloned().unwrap_or(Vector·zero());

        ⌥ behavior {
            Behavior·Separation { distance, weight } => {
                ≔ Δ force = Vector·zero();
                ∀ (other, other_pos) ∈ &state.positions {
                    ⎇ other != agent {
                        ≔ diff = pos - *other_pos;
                        ≔ dist = diff.magnitude();
                        ⎇ dist < *distance && dist > 0.0 {
                            force = force + diff.normalize() * (1.0 / dist);
                        }
                    }
                }
                force * *weight
            }
            Behavior·Alignment { weight } => {
                ⎇ state.velocities.is_empty() {
                    ⤺ Vector·zero();
                }
                ≔ avg_vel = state.velocities.values()
                    .fold(Vector·zero(), |acc, v| acc + *v)
                    * (1.0 / state.velocities.len() as f32);
                avg_vel * *weight
            }
            Behavior·Cohesion { weight } => {
                ⎇ state.positions.is_empty() {
                    ⤺ Vector·zero();
                }
                ≔ center = state.positions.values()
                    .fold(Vector·zero(), |acc, p| acc + *p)
                    * (1.0 / state.positions.len() as f32);
                (center - pos) * *weight
            }
            Behavior·GoalSeeking { goal, weight } => {
                (*goal - pos).normalize() * *weight
            }
            _ => Vector·zero(),
        }
    }
}

⊢ Clone ∀ Behavior {
    λ clone(&self) -> Self {
        ⌥ self {
            Behavior·Separation { distance, weight } => Behavior·Separation { distance: *distance, weight: *weight },
            Behavior·Alignment { weight } => Behavior·Alignment { weight: *weight },
            Behavior·Cohesion { weight } => Behavior·Cohesion { weight: *weight },
            Behavior·GoalSeeking { goal, weight } => Behavior·GoalSeeking { goal: goal.clone(), weight: *weight },
            Behavior·Avoidance { obstacles, weight } => Behavior·Avoidance { obstacles: obstacles.clone(), weight: *weight },
            Behavior·Gradient { weight } => Behavior·Gradient { weight: *weight },
        }
    }
}

⊢ Clone ∀ Obstacle {
    λ clone(&self) -> Self {
        Self { position: self.position.clone(), radius: self.radius }
    }
}

// ============================================================================
// Consensus Engine
// ============================================================================

☉ Σ ConsensusConfig {
    ☉ quorum: f32,
    ☉ threshold: f32,
    ☉ allow_blocks: bool,
    ☉ default_deadline: Duration,
}

⊢ Default ∀ ConsensusConfig {
    λ default() -> Self {
        Self {
            quorum: 0.5,
            threshold: 0.67,
            allow_blocks: true,
            default_deadline: Duration·hours(24),
        }
    }
}

☉ Σ ConsensusEngine {
    proposals: HashMap<ProposalId, ProposalState>,
    config: ConsensusConfig,
}

⊢ ConsensusEngine {
    ☉ λ new(config: ConsensusConfig) -> Self {
        Self {
            proposals: HashMap·new(),
            config,
        }
    }

    ☉ λ propose(&Δ self, proposer: AgentId, content: Value, description: String) -> ProposalId {
        ≔ id = ProposalId·new();

        ≔ proposal = Proposal {
            id: id.clone(),
            proposer,
            content,
            description,
            deadline: Timestamp·now() + self.config.default_deadline,
        };

        self.proposals.insert(id.clone(), ProposalState {
            proposal,
            votes: HashMap·new(),
            status: ProposalStatus·Open,
        });

        id
    }

    ☉ λ vote(
        &Δ self,
        proposal_id: ProposalId,
        voter: AgentId,
        value: VoteValue,
        rationale: Option<String>,
    ) -> Result<(), ConsensusError> {
        ≔ state = self.proposals.get_mut(&proposal_id)
            .ok_or(ConsensusError·ProposalNotFound)?;

        ⎇ !matches!(state.status, ProposalStatus·Open) {
            ⤺ Err(ConsensusError·ProposalClosed);
        }

        ⎇ matches!(value, VoteValue·Block) {
            ⎇ !self.config.allow_blocks {
                ⤺ Err(ConsensusError·BlocksNotAllowed);
            }
            state.status = ProposalStatus·Blocked {
                by: voter.clone(),
                reason: rationale.clone().unwrap_or_default(),
            };
        }

        state.votes.insert(voter.clone(), Vote {
            voter,
            value,
            rationale,
            timestamp: Timestamp·now(),
        });

        self.check_consensus(&proposal_id);

        Ok(())
    }

    λ check_consensus(&Δ self, proposal_id: &ProposalId) {
        ≔ state = ⌥ self.proposals.get_mut(proposal_id) {
            Some(s) => s,
            None => return,
        };

        ⎇ !matches!(state.status, ProposalStatus·Open) {
            ⤺;
        }

        ≔ total = state.votes.len() as f32;
        ⎇ total == 0.0 {
            ⤺;
        }

        ≔ approvals = state.votes.values()
            .filter(|v| matches!(v.value, VoteValue·Approve))
            .count() as f32;
        ≔ rejections = state.votes.values()
            .filter(|v| matches!(v.value, VoteValue·Reject))
            .count() as f32;

        ≔ approval_rate = approvals / total;
        ≔ rejection_rate = rejections / total;

        ⎇ approval_rate >= self.config.threshold {
            state.status = ProposalStatus·Achieved;
        } ⎉ ⎇ rejection_rate > (1.0 - self.config.threshold) {
            state.status = ProposalStatus·Rejected;
        }
    }

    ☉ λ result(&self, proposal_id: &ProposalId) -> Option<ConsensusResult> {
        self.proposals.get(proposal_id).map(|state| {
            ≔ total = state.votes.len() as f32;
            ≔ approvals = state.votes.values()
                .filter(|v| matches!(v.value, VoteValue·Approve))
                .count() as f32;

            ConsensusResult {
                proposal: state.proposal.clone(),
                status: state.status.clone(),
                votes: state.votes.clone(),
                approval_rate: ⎇ total > 0.0 { approvals / total } ⎉ { 0.0 },
            }
        })
    }
}

☉ ᛈ ConsensusError {
    ProposalNotFound,
    ProposalClosed,
    BlocksNotAllowed,
}

// ============================================================================
// Message Queue
// ============================================================================

☉ Σ MessageQueue {
    queues: HashMap<AgentId, VecDeque<Message>>,
}

⊢ MessageQueue {
    ☉ λ new() -> Self {
        Self {
            queues: HashMap·new(),
        }
    }

    ☉ λ enqueue(&Δ self, recipient: AgentId, message: Message) {
        self.queues.entry(recipient)
            .or_default()
            .push_back(message);
    }

    ☉ λ dequeue(&Δ self, agent: &AgentId) -> Vec<Message> {
        self.queues.get_mut(agent)
            .map(|q| q.drain(..).collect())
            .unwrap_or_default()
    }
}

// ============================================================================
// Errors
// ============================================================================

☉ ᛈ CommuneError {
    SenderNotRegistered,
    RecipientNotFound,
    ChannelNotFound,
    InsufficientTrust,
    AccessDenied,
    MessageTooLarge,
    RateLimitExceeded,
    ConsensusError(String),
}

// Clone implementations
⊢ Clone ∀ Message {
    λ clone(&self) -> Self {
        Self {
            id: MessageId { bytes: self.id.bytes },
            header: self.header.clone(),
            payload: self.payload.clone(),
            signature: Signature { bytes: self.signature.bytes.clone() },
        }
    }
}

⊢ Clone ∀ MessageHeader {
    λ clone(&self) -> Self {
        Self {
            from: AgentId { bytes: self.from.bytes },
            to: self.to.clone(),
            intent: self.intent.clone(),
            epistemic: self.epistemic,
            confidence: self.confidence,
            timestamp: Timestamp { nanos: self.timestamp.nanos },
            correlation_id: self.correlation_id.clone(),
            reply_to: self.reply_to.clone(),
            ttl: self.ttl,
            priority: self.priority.clone(),
            trace: self.trace.clone(),
        }
    }
}

⊢ Clone ∀ Recipient {
    λ clone(&self) -> Self {
        ⌥ self {
            Recipient·Agent(id) => Recipient·Agent(AgentId { bytes: id.bytes }),
            Recipient·Agents(ids) => Recipient·Agents(ids.iter().map(|id| AgentId { bytes: id.bytes }).collect()),
            Recipient·Channel(id) => Recipient·Channel(ChannelId { name: id.name.clone() }),
            Recipient·Broadcast => Recipient·Broadcast,
            Recipient·Swarm(id) => Recipient·Swarm(SwarmId { bytes: id.bytes }),
        }
    }
}

⊢ Clone ∀ Intent {
    λ clone(&self) -> Self {
        // Would implement full clone
        Intent·Ping
    }
}

⊢ Clone ∀ Payload {
    λ clone(&self) -> Self {
        ⌥ self {
            Payload·Data(v) => Payload·Data(Value { inner: v.inner.clone() }),
            Payload·Binary(b) => Payload·Binary(b.clone()),
            Payload·Reference(r) => Payload·Reference(r.clone()),
            Payload·Stream(s) => Payload·Stream(StreamId { bytes: s.bytes }),
            Payload·Empty => Payload·Empty,
        }
    }
}

⊢ Clone ∀ Priority {
    λ clone(&self) -> Self {
        ⌥ self {
            Priority·Critical => Priority·Critical,
            Priority·High => Priority·High,
            Priority·Normal => Priority·Normal,
            Priority·Low => Priority·Low,
        }
    }
}

⊢ Clone ∀ TraceContext {
    λ clone(&self) -> Self {
        Self {
            trace_id: self.trace_id,
            span_id: self.span_id,
            parent_span: self.parent_span,
        }
    }
}

⊢ Clone ∀ MessageId {
    λ clone(&self) -> Self {
        Self { bytes: self.bytes }
    }
}

⊢ Clone ∀ AgentId {
    λ clone(&self) -> Self {
        Self { bytes: self.bytes }
    }
}

⊢ Clone ∀ Proposal {
    λ clone(&self) -> Self {
        Self {
            id: ProposalId { bytes: self.id.bytes },
            proposer: AgentId { bytes: self.proposer.bytes },
            content: Value { inner: self.content.inner.clone() },
            description: self.description.clone(),
            deadline: Timestamp { nanos: self.deadline.nanos },
        }
    }
}

⊢ Clone ∀ ProposalStatus {
    λ clone(&self) -> Self {
        ⌥ self {
            ProposalStatus·Open => ProposalStatus·Open,
            ProposalStatus·Achieved => ProposalStatus·Achieved,
            ProposalStatus·Rejected => ProposalStatus·Rejected,
            ProposalStatus·Blocked { by, reason } => ProposalStatus·Blocked {
                by: AgentId { bytes: by.bytes },
                reason: reason.clone(),
            },
            ProposalStatus·Expired => ProposalStatus·Expired,
        }
    }
}

⊢ Clone ∀ Vote {
    λ clone(&self) -> Self {
        Self {
            voter: AgentId { bytes: self.voter.bytes },
            value: self.value.clone(),
            rationale: self.rationale.clone(),
            timestamp: Timestamp { nanos: self.timestamp.nanos },
        }
    }
}

⊢ Clone ∀ VoteValue {
    λ clone(&self) -> Self {
        ⌥ self {
            VoteValue·Approve => VoteValue·Approve,
            VoteValue·Reject => VoteValue·Reject,
            VoteValue·Abstain => VoteValue·Abstain,
            VoteValue·Block => VoteValue·Block,
        }
    }
}

λ uuid_v7() -> [u8; 16] { [0u8; 16] }
