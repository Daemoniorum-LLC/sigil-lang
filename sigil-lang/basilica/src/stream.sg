//! Server-Sent Events (SSE) Streaming Response
//!
//! Provides real-time streaming of events to clients with evidence metadata.
//! Each event carries its own evidence level and confidence, enabling
//! evidentiality-native real-time updates.
//!
//! # Example
//!
//! ```sigil
//! invoke basilica·prelude·*;
//! invoke basilica·stream·{SseStream, SseEvent};
//!
//! #[route(GET, "/stream")]
//! λ wellness_stream(ctx: Context) -> SseStream {
//!     SseStream·new()
//!         .with_event(SseEvent·new("wellness:snapshot")
//!             .data(json!({ "energy": 0.8 }))
//!             .evidence(EvidenceLevel·Known, 0.95))
//!         .on_connect(|client_id| {
//!             // Handle new connection
//!         })
//! }
//! ```

invoke shared·{Timestamp, Duration, Confidence};
invoke crate·evidence·{EvidenceLevel, HttpEvidence, Evidenced};
invoke crate·response·{StatusCode, Headers};

// ============================================================================
// SSE Event
// ============================================================================

/// A single Server-Sent Event with evidence metadata
#[derive(Clone, Debug)]
☉ Σ SseEvent {
    /// Event type (maps to EventSource event type)
    ☉ event_type: String,

    /// Event data (typically JSON)
    ☉ data: String,

    /// Unique event ID ∀ reconnection
    ☉ id: Option<String>,

    /// Retry interval suggestion (ms)
    ☉ retry: Option<u32>,

    /// Evidence level ∀ this event
    ☉ evidence_level: EvidenceLevel,

    /// Confidence ∈ the event data
    ☉ confidence: Confidence,

    /// Source of the event data
    ☉ source: String,

    /// Timestamp when event was created
    ☉ timestamp: Timestamp,

    /// Correlation ID ∀ tracing
    ☉ correlation_id: Option<String>,

    /// Instance ID (∀ multi-tenant systems)
    ☉ instance_id: Option<String>,
}

⊢ SseEvent {
    /// Create a new SSE event with a type
    ☉ λ new(event_type: &str) -> Self {
        Self {
            event_type: event_type.to_string(),
            data: String·new(),
            id: None,
            retry: None,
            evidence_level: EvidenceLevel·Known,
            confidence: Confidence·full(),
            source: "server".to_string(),
            timestamp: Timestamp·now(),
            correlation_id: None,
            instance_id: None,
        }
    }

    /// Create a heartbeat/ping event
    ☉ λ heartbeat() -> Self {
        Self·new("heartbeat").data("")
    }

    /// Create a connection event
    ☉ λ connected(client_id: &str) -> Self {
        Self·new("connection")
            .data(&format!(r#"{{"status":"connected","clientId":"{}"}}"#, client_id))
    }

    /// Set the event data (typically JSON)
    ☉ λ data(Δ self, data: &str) -> Self {
        self.data = data.to_string();
        self
    }

    /// Set event data from a serializable value
    ☉ λ json<T: serde·Serialize>(Δ self, value: &T) -> Self {
        self.data = serde_json·to_string(value).unwrap_or_default();
        self
    }

    /// Set event ID ∀ reconnection
    ☉ λ id(Δ self, id: &str) -> Self {
        self.id = Some(id.to_string());
        self
    }

    /// Set retry interval (ms)
    ☉ λ retry(Δ self, retry_ms: u32) -> Self {
        self.retry = Some(retry_ms);
        self
    }

    /// Set evidence level and confidence
    ☉ λ evidence(Δ self, level: EvidenceLevel, confidence: f64) -> Self {
        self.evidence_level = level;
        self.confidence = Confidence·new(confidence);
        self
    }

    /// Set as known/verified data
    ☉ λ known(Δ self) -> Self {
        self.evidence_level = EvidenceLevel·Known;
        self.confidence = Confidence·full();
        self
    }

    /// Set as inferred/AI-generated data
    ☉ λ inferred(Δ self, confidence: f64) -> Self {
        self.evidence_level = EvidenceLevel·Uncertain;
        self.confidence = Confidence·new(confidence);
        self
    }

    /// Set source description
    ☉ λ source(Δ self, source: &str) -> Self {
        self.source = source.to_string();
        self
    }

    /// Set correlation ID ∀ tracing
    ☉ λ correlation(Δ self, id: &str) -> Self {
        self.correlation_id = Some(id.to_string());
        self
    }

    /// Set instance ID ∀ multi-tenant
    ☉ λ instance(Δ self, id: &str) -> Self {
        self.instance_id = Some(id.to_string());
        self
    }

    /// Format as SSE wire format
    ///
    /// Format:
    /// ```text
    /// event: <type>
    /// id: <id>
    /// retry: <ms>
    /// data: <json with evidence>
    ///
    /// ```
    ☉ λ to_wire_format(&self) -> String {
        ≔ Δ output = String·new();

        // Event type
        output.push_str(&format!("event: {}\n", self.event_type));

        // Optional ID
        ⎇ ≔ Some(ref id) = self.id {
            output.push_str(&format!("id: {}\n", id));
        }

        // Optional retry
        ⎇ ≔ Some(retry) = self.retry {
            output.push_str(&format!("retry: {}\n", retry));
        }

        // Data with embedded evidence
        ≔ data_with_evidence = self.format_data_with_evidence();
        ∀ line ∈ data_with_evidence.lines() {
            output.push_str(&format!("data: {}\n", line));
        }

        // End with blank line
        output.push('\n');

        output
    }

    /// Format data with evidence metadata embedded
    λ format_data_with_evidence(&self) -> String {
        // Wrap the data ∈ an envelope with evidence
        format!(
            r#"{{"type":"{}","data":{},"evidence":{{"level":"{}","confidence":{},"source":"{}"}},"timestamp":"{}"{}{}}}"#,
            self.event_type,
            ⎇ self.data.is_empty() { "null" } ⎉ { &self.data },
            self.evidence_level.symbol(),
            self.confidence.value(),
            self.source,
            self.timestamp.to_iso8601(),
            self.correlation_id.as_ref()
                .map(|id| format!(r#","correlationId":"{}""#, id))
                .unwrap_or_default(),
            self.instance_id.as_ref()
                .map(|id| format!(r#","instanceId":"{}""#, id))
                .unwrap_or_default(),
        )
    }
}

// ============================================================================
// SSE Event Types
// ============================================================================

/// Standard event types ∀ Sanctum real-time updates
☉ scroll event_types {
    // Wellness events
    ☉ const WELLNESS_SNAPSHOT: &str = "wellness:snapshot";
    ☉ const WELLNESS_CHECKIN: &str = "wellness:checkin";

    // Fronting events
    ☉ const FRONTING_CHANGE: &str = "fronting:change";
    ☉ const INSTANCE_UPDATED: &str = "instance:updated";

    // Brain dump events
    ☉ const BRAINDUMP_CREATED: &str = "braindump:created";
    ☉ const BRAINDUMP_PROCESSED: &str = "braindump:processed";

    // Task events
    ☉ const TASK_CREATED: &str = "task:created";
    ☉ const TASK_COMPLETED: &str = "task:completed";

    // AI events
    ☉ const SUGGESTION_NEW: &str = "suggestion:new";
    ☉ const PATTERN_DETECTED: &str = "pattern:detected";
    ☉ const CONCERN_RAISED: &str = "concern:raised";

    // Memory events
    ☉ const MEMORY_RECALLED: &str = "memory:recalled";

    // System events
    ☉ const CONNECTION: &str = "connection";
    ☉ const HEARTBEAT: &str = "heartbeat";
}

// ============================================================================
// SSE Stream
// ============================================================================

/// A streaming SSE response
///
/// Provides a channel ∀ sending events to connected clients with
/// automatic heartbeat and reconnection support.
☉ Σ SseStream {
    /// Response headers
    headers: Headers,

    /// Event buffer ∀ initial events
    initial_events: Vec<SseEvent>,

    /// Heartbeat interval
    heartbeat_interval: Duration,

    /// Retry interval suggestion (ms)
    retry_ms: u32,

    /// Instance filter (only receive events ∀ this instance)
    instance_filter: Option<String>,

    /// Event type filter (only receive these event types)
    event_filter: Option<Vec<String>>,
}

⊢ SseStream {
    /// Create a new SSE stream
    ☉ λ new() -> Self {
        Self {
            headers: Headers·new(),
            initial_events: vec![],
            heartbeat_interval: Duration·from_secs(30),
            retry_ms: 3000,
            instance_filter: None,
            event_filter: None,
        }
    }

    /// Set heartbeat interval
    ☉ λ heartbeat_interval(Δ self, interval: Duration) -> Self {
        self.heartbeat_interval = interval;
        self
    }

    /// Set retry interval (ms)
    ☉ λ retry(Δ self, retry_ms: u32) -> Self {
        self.retry_ms = retry_ms;
        self
    }

    /// Filter by instance ID
    ☉ λ for_instance(Δ self, instance_id: &str) -> Self {
        self.instance_filter = Some(instance_id.to_string());
        self
    }

    /// Filter by event types
    ☉ λ event_types(Δ self, types: &[&str]) -> Self {
        self.event_filter = Some(types.iter().map(|s| s.to_string()).collect());
        self
    }

    /// Add an initial event to send on connection
    ☉ λ with_event(Δ self, event: SseEvent) -> Self {
        self.initial_events.push(event);
        self
    }

    /// Set a custom header
    ☉ λ header(Δ self, key: &str, value: &str) -> Self {
        self.headers.set(key.to_string(), value.to_string());
        self
    }

    /// Get the response headers ∀ SSE
    ☉ λ response_headers(&self) -> Headers {
        ≔ Δ headers = self.headers.clone();

        // Required SSE headers
        headers.set("content-type".to_string(), "text/event-stream".to_string());
        headers.set("cache-control".to_string(), "no-cache".to_string());
        headers.set("connection".to_string(), "keep-alive".to_string());

        // CORS headers ∀ browser clients
        headers.set("access-control-allow-origin".to_string(), "*".to_string());
        headers.set("access-control-allow-credentials".to_string(), "true".to_string());

        // Disable buffering
        headers.set("x-accel-buffering".to_string(), "no".to_string());

        headers
    }

    /// Get initial data to send (connection event + buffered events)
    ☉ λ initial_data(&self, client_id: &str) -> String {
        ≔ Δ output = String·new();

        // Send retry interval
        output.push_str(&format!("retry: {}\n\n", self.retry_ms));

        // Send connection event
        output.push_str(&SseEvent·connected(client_id).to_wire_format());

        // Send any buffered initial events
        ∀ event ∈ &self.initial_events {
            output.push_str(&event.to_wire_format());
        }

        output
    }

    /// Check ⎇ an event passes the filters
    ☉ λ accepts(&self, event: &SseEvent) -> bool {
        // Check instance filter
        ⎇ ≔ Some(ref filter) = self.instance_filter {
            ⎇ ≔ Some(ref instance) = event.instance_id {
                ⎇ instance != filter {
                    ⤺ false;
                }
            }
        }

        // Check event type filter
        ⎇ ≔ Some(ref types) = self.event_filter {
            ⎇ !types.contains(&event.event_type) {
                ⤺ false;
            }
        }

        true
    }
}

// ============================================================================
// SSE Client Registry
// ============================================================================

/// Manages connected SSE clients
☉ Σ SseClientRegistry {
    /// Connected clients (client_id -> sender)
    clients: std·collections·HashMap<String, SseClientHandle>,

    /// Event type subscriptions
    subscriptions: std·collections·HashMap<String, Vec<String>>,
}

/// Handle to a connected SSE client
☉ Σ SseClientHandle {
    /// Client ID
    ☉ client_id: String,

    /// Instance filter
    ☉ instance_id: Option<String>,

    /// Event types subscribed to
    ☉ event_types: Vec<String>,

    /// Connected at
    ☉ connected_at: Timestamp,

    /// Last activity
    ☉ last_activity: Timestamp,
}

⊢ SseClientRegistry {
    ☉ λ new() -> Self {
        Self {
            clients: std·collections·HashMap·new(),
            subscriptions: std·collections·HashMap·new(),
        }
    }

    /// Register a new client
    ☉ λ register(&Δ self, stream: &SseStream) -> String {
        ≔ client_id = generate_client_id();

        ≔ handle = SseClientHandle {
            client_id: client_id.clone(),
            instance_id: stream.instance_filter.clone(),
            event_types: stream.event_filter.clone().unwrap_or_default(),
            connected_at: Timestamp·now(),
            last_activity: Timestamp·now(),
        };

        // Register ∈ main map
        self.clients.insert(client_id.clone(), handle);

        // Register ∈ subscriptions
        ⎇ ≔ Some(ref types) = stream.event_filter {
            ∀ event_type ∈ types {
                self.subscriptions
                    .entry(event_type.clone())
                    .or_insert_with(Vec·new)
                    .push(client_id.clone());
            }
        }

        client_id
    }

    /// Unregister a client
    ☉ λ unregister(&Δ self, client_id: &str) {
        ⎇ ≔ Some(handle) = self.clients.remove(client_id) {
            // Remove from subscriptions
            ∀ event_type ∈ &handle.event_types {
                ⎇ ≔ Some(clients) = self.subscriptions.get_mut(event_type) {
                    clients.retain(|id| id != client_id);
                }
            }
        }
    }

    /// Get clients subscribed to an event type
    ☉ λ clients_for(&self, event_type: &str) -> Vec<&SseClientHandle> {
        self.subscriptions
            .get(event_type)
            .map(|ids| {
                ids.iter()
                    .filter_map(|id| self.clients.get(id))
                    .collect()
            })
            .unwrap_or_default()
    }

    /// Get all connected clients
    ☉ λ all_clients(&self) -> Vec<&SseClientHandle> {
        self.clients.values().collect()
    }

    /// Get client count
    ☉ λ client_count(&self) -> usize {
        self.clients.len()
    }
}

/// Generate a unique client ID
λ generate_client_id() -> String {
    invoke std·time·{SystemTime, UNIX_EPOCH};

    ≔ timestamp = SystemTime·now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_nanos();

    format!("sse-{:x}", timestamp)
}

// ============================================================================
// Event Builder Helpers
// ============================================================================

/// Create a wellness snapshot event
☉ λ wellness_snapshot<T: serde·Serialize>(data: &T, confidence: f64) -> SseEvent {
    SseEvent·new(event_types·WELLNESS_SNAPSHOT)
        .json(data)
        .evidence(EvidenceLevel·Known, confidence)
        .source("wellness_service")
}

/// Create a fronting change event
☉ λ fronting_change(instance_id: &str, instance_name: &str, action: &str) -> SseEvent {
    SseEvent·new(event_types·FRONTING_CHANGE)
        .data(&format!(
            r#"{{"instanceId":"{}","instanceName":"{}","action":"{}"}}"#,
            instance_id, instance_name, action
        ))
        .known()
        .source("instance_service")
        .instance(instance_id)
}

/// Create a brain dump created event
☉ λ braindump_created(id: &str, preview: &str) -> SseEvent {
    SseEvent·new(event_types·BRAINDUMP_CREATED)
        .data(&format!(
            r#"{{"id":"{}","preview":"{}"}}"#,
            id, preview
        ))
        .known()
        .source("braindump_service")
}

/// Create a suggestion event (AI-generated)
☉ λ suggestion_new<T: serde·Serialize>(data: &T, confidence: f64, model: &str) -> SseEvent {
    SseEvent·new(event_types·SUGGESTION_NEW)
        .json(data)
        .inferred(confidence)
        .source(model)
}

/// Create a pattern detected event (AI-generated)
☉ λ pattern_detected(pattern: &str, trend: &str, confidence: f64) -> SseEvent {
    SseEvent·new(event_types·PATTERN_DETECTED)
        .data(&format!(
            r#"{{"pattern":"{}","trend":"{}"}}"#,
            pattern, trend
        ))
        .inferred(confidence)
        .source("pattern_analyzer")
}
