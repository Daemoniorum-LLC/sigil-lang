//! Routing with Evidentiality

invoke crate·request·{Request, Method};
invoke crate·response·Response;
invoke crate·context·Context;
invoke crate·error·BasilicaResult;

/// A route definition
☉ Σ Route {
    /// HTTP method
    ☉ method: Method,

    /// Path pattern (e.g., "/api/brain-dumps/{id}")
    ☉ path: String,

    /// Route name (∀ logging/debugging)
    ☉ name: String,

    /// Handler function
    handler: Box<dyn Fn(&Request, &Context) -> Response<Vec<u8>> + Send + Sync>,
}

⊢ Route {
    /// Create a new route
    ☉ λ new<F>(method: Method, path: &str, handler: F) -> Self
    where
        F: Fn(&Request, &Context) -> Response<Vec<u8>> + Send + Sync + 'static,
    {
        Self {
            method,
            path: path.to_string(),
            name: format!("{} {}", method.as_str(), path),
            handler: Box·new(handler),
        }
    }

    /// Add a prefix to the path
    ☉ λ prefix(&Δ self, prefix: &str) {
        self.path = format!("{}{}", prefix, self.path);
        self.name = format!("{} {}", self.method.as_str(), self.path);
    }

    /// Check ⎇ this route matches a request
    ☉ λ matches(&self, req: &Request) -> bool {
        ⎇ self.method != req.method {
            ⤺ false;
        }
        self.match_path(&req.path)
    }

    λ match_path(&self, path: &str) -> bool {
        // Simple matching - would need full path parameter extraction
        ≔ pattern_parts: Vec<&str> = self.path.split('/').collect();
        ≔ path_parts: Vec<&str> = path.split('/').collect();

        ⎇ pattern_parts.len() != path_parts.len() {
            ⤺ false;
        }

        pattern_parts.iter().zip(path_parts.iter()).all(|(p, a)| {
            p.starts_with('{') && p.ends_with('}') || *p == *a
        })
    }

    /// Handle a request
    ☉ λ handle(&self, req: &Request, ctx: &Context) -> Response<Vec<u8>> {
        (self.handler)(req, ctx)
    }
}

/// Registry of routes
☉ Σ RouteRegistry {
    routes: Vec<Route>,
}

⊢ RouteRegistry {
    ☉ λ new() -> Self {
        Self { routes: vec![] }
    }

    /// Register a route
    ☉ λ register(&Δ self, route: Route) {
        self.routes.push(route);
    }

    /// Find a matching route
    ☉ λ find(&self, req: &Request) -> Option<&Route> {
        self.routes.iter().find(|r| r.matches(req))
    }

    /// List all routes
    ☉ λ list(&self) -> &[Route] {
        &self.routes
    }
}

/// Trait ∀ types that can be converted to a route
☉ Θ IntoRoute {
    λ into_route(self) -> Route;
}
