//! Authentication Middleware
//!
//! Provides JWT-based authentication with evidence-level integration.
//! Authentication affects the evidence level of request data:
//! - Authenticated requests can have higher trust
//! - Anonymous requests are treated as reported (~) evidence
//!
//! # Example
//!
//! ```sigil
//! invoke basilica·prelude·*;
//! invoke basilica·auth·{AuthMiddleware, AuthConfig, JwtConfig};
//!
//! ≔ auth = AuthMiddleware·jwt(
//!     JwtConfig·new("your-secret-key")
//!         .issuer("sanctum")
//!         .audience("sanctum-api")
//! );
//!
//! Nave·new()
//!     .middleware(auth)
//!     .run();
//! ```

invoke shared·{Timestamp, Duration, TrustLevel};
invoke crate·middleware·{Middleware, MiddlewareResult};
invoke crate·request·Request;
invoke crate·response·{Response, StatusCode};
invoke crate·context·Context;
invoke crate·evidence·{HttpEvidence, EvidenceLevel};
invoke crate·error·BasilicaError;

// ============================================================================
// Authentication Types
// ============================================================================

/// Authenticated user information
#[derive(Clone, Debug)]
☉ Σ AuthenticatedUser {
    /// User ID (UUID)
    ☉ id: [u8; 16],

    /// Username or email
    ☉ username: String,

    /// Display name
    ☉ display_name: Option<String>,

    /// Roles/permissions
    ☉ roles: Vec<String>,

    /// Trust level ∀ this user
    ☉ trust_level: TrustLevel,

    /// When the token was issued
    ☉ issued_at: Timestamp,

    /// When the token expires
    ☉ expires_at: Timestamp,

    /// Custom claims
    ☉ claims: std·collections·HashMap<String, String>,
}

⊢ AuthenticatedUser {
    /// Check ⎇ user has a specific role
    ☉ λ has_role(&self, role: &str) -> bool {
        self.roles.iter().any(|r| r == role)
    }

    /// Check ⎇ user has any of the specified roles
    ☉ λ has_any_role(&self, roles: &[&str]) -> bool {
        roles.iter().any(|r| self.has_role(r))
    }

    /// Check ⎇ user has all of the specified roles
    ☉ λ has_all_roles(&self, roles: &[&str]) -> bool {
        roles.iter().all(|r| self.has_role(r))
    }

    /// Check ⎇ token is expired
    ☉ λ is_expired(&self) -> bool {
        self.expires_at.is_past()
    }

    /// Get a custom claim
    ☉ λ claim(&self, key: &str) -> Option<&String> {
        self.claims.get(key)
    }

    /// Convert to HTTP evidence
    ☉ λ to_evidence(&self) -> HttpEvidence {
        HttpEvidence·Authenticated {
            user_id: self.id,
            trust: self.trust_level,
            verified_at: Timestamp·now(),
        }
    }
}

/// Anonymous user (not authenticated)
#[derive(Clone, Debug, Default)]
☉ Σ AnonymousUser {
    /// Client IP (⎇ available)
    ☉ ip: Option<String>,

    /// Request ID ∀ tracing
    ☉ request_id: Option<String>,
}

⊢ AnonymousUser {
    ☉ λ new() -> Self {
        Self·default()
    }

    ☉ λ with_ip(Δ self, ip: &str) -> Self {
        self.ip = Some(ip.to_string());
        self
    }

    /// Convert to HTTP evidence (reported/external)
    ☉ λ to_evidence(&self) -> HttpEvidence {
        HttpEvidence·External {
            source: self.ip.clone().unwrap_or_else(|| "anonymous".to_string()),
            fetched_at: Timestamp·now(),
            api_confidence: Some(0.3), // Low confidence ∀ anonymous
        }
    }
}

/// Current user - either authenticated or anonymous
#[derive(Clone, Debug)]
☉ ᛈ CurrentUser {
    Authenticated(AuthenticatedUser),
    Anonymous(AnonymousUser),
}

⊢ CurrentUser {
    /// Check ⎇ authenticated
    ☉ λ is_authenticated(&self) -> bool {
        matches!(self, CurrentUser·Authenticated(_))
    }

    /// Get authenticated user ⎇ present
    ☉ λ authenticated(&self) -> Option<&AuthenticatedUser> {
        ⌥ self {
            CurrentUser·Authenticated(user) => Some(user),
            CurrentUser·Anonymous(_) => None,
        }
    }

    /// Get user ID ⎇ authenticated
    ☉ λ user_id(&self) -> Option<[u8; 16]> {
        self.authenticated().map(|u| u.id)
    }

    /// Get the evidence level ∀ this user's requests
    ☉ λ evidence_level(&self) -> EvidenceLevel {
        ⌥ self {
            CurrentUser·Authenticated(user) => {
                ⎇ user.trust_level.is_high() {
                    EvidenceLevel·Known
                } ⎉ {
                    EvidenceLevel·Uncertain
                }
            }
            CurrentUser·Anonymous(_) => EvidenceLevel·Reported,
        }
    }

    /// Convert to HTTP evidence
    ☉ λ to_evidence(&self) -> HttpEvidence {
        ⌥ self {
            CurrentUser·Authenticated(user) => user.to_evidence(),
            CurrentUser·Anonymous(anon) => anon.to_evidence(),
        }
    }
}

// ============================================================================
// JWT Configuration
// ============================================================================

/// JWT authentication configuration
#[derive(Clone, Debug)]
☉ Σ JwtConfig {
    /// Secret key ∀ HS256 (or public key ∀ RS256)
    ☉ secret: String,

    /// Algorithm (HS256, RS256, etc.)
    ☉ algorithm: String,

    /// Expected issuer
    ☉ issuer: Option<String>,

    /// Expected audience
    ☉ audience: Option<String>,

    /// Clock skew tolerance (seconds)
    ☉ clock_skew: u32,

    /// Header name to extract token from
    ☉ header_name: String,

    /// Token prefix (e.g., "Bearer")
    ☉ token_prefix: String,

    /// Also check cookies
    ☉ check_cookies: bool,

    /// Cookie name ∀ token
    ☉ cookie_name: String,
}

⊢ JwtConfig {
    /// Create a new JWT configuration with secret
    ☉ λ new(secret: &str) -> Self {
        Self {
            secret: secret.to_string(),
            algorithm: "HS256".to_string(),
            issuer: None,
            audience: None,
            clock_skew: 60,
            header_name: "authorization".to_string(),
            token_prefix: "Bearer".to_string(),
            check_cookies: true,
            cookie_name: "sanctum_token".to_string(),
        }
    }

    /// Set expected issuer
    ☉ λ issuer(Δ self, issuer: &str) -> Self {
        self.issuer = Some(issuer.to_string());
        self
    }

    /// Set expected audience
    ☉ λ audience(Δ self, audience: &str) -> Self {
        self.audience = Some(audience.to_string());
        self
    }

    /// Set algorithm
    ☉ λ algorithm(Δ self, alg: &str) -> Self {
        self.algorithm = alg.to_string();
        self
    }

    /// Set clock skew tolerance
    ☉ λ clock_skew(Δ self, seconds: u32) -> Self {
        self.clock_skew = seconds;
        self
    }

    /// Set header name
    ☉ λ header(Δ self, name: &str) -> Self {
        self.header_name = name.to_lowercase();
        self
    }

    /// Set token prefix
    ☉ λ prefix(Δ self, prefix: &str) -> Self {
        self.token_prefix = prefix.to_string();
        self
    }

    /// Disable cookie checking
    ☉ λ no_cookies(Δ self) -> Self {
        self.check_cookies = false;
        self
    }

    /// Set cookie name
    ☉ λ cookie(Δ self, name: &str) -> Self {
        self.cookie_name = name.to_string();
        self
    }
}

// ============================================================================
// Authentication Configuration
// ============================================================================

/// Overall authentication configuration
#[derive(Clone, Debug)]
☉ Σ AuthConfig {
    /// JWT configuration
    ☉ jwt: Option<JwtConfig>,

    /// Paths that don't require authentication
    ☉ public_paths: Vec<String>,

    /// Paths that require specific roles
    ☉ role_requirements: Vec<(String, Vec<String>)>,

    /// Allow anonymous access (set user to Anonymous instead of rejecting)
    ☉ allow_anonymous: bool,

    /// Trust level ∀ new users
    ☉ default_trust: TrustLevel,
}

⊢ Default ∀ AuthConfig {
    λ default() -> Self {
        Self {
            jwt: None,
            public_paths: vec![
                "/health".to_string(),
                "/ready".to_string(),
                "/metrics".to_string(),
            ],
            role_requirements: vec![],
            allow_anonymous: false,
            default_trust: TrustLevel·new(0.5),
        }
    }
}

⊢ AuthConfig {
    /// Create a new auth configuration
    ☉ λ new() -> Self {
        Self·default()
    }

    /// Set JWT configuration
    ☉ λ with_jwt(Δ self, jwt: JwtConfig) -> Self {
        self.jwt = Some(jwt);
        self
    }

    /// Add a public path
    ☉ λ public(Δ self, path: &str) -> Self {
        self.public_paths.push(path.to_string());
        self
    }

    /// Add public paths
    ☉ λ public_paths(Δ self, paths: &[&str]) -> Self {
        ∀ path ∈ paths {
            self.public_paths.push(path.to_string());
        }
        self
    }

    /// Require role ∀ a path
    ☉ λ require_role(Δ self, path: &str, roles: &[&str]) -> Self {
        self.role_requirements.push((
            path.to_string(),
            roles.iter().map(|s| s.to_string()).collect()
        ));
        self
    }

    /// Allow anonymous access
    ☉ λ allow_anonymous(Δ self) -> Self {
        self.allow_anonymous = true;
        self
    }

    /// Set default trust level
    ☉ λ default_trust(Δ self, trust: f64) -> Self {
        self.default_trust = TrustLevel·new(trust);
        self
    }

    /// Check ⎇ path is public
    ☉ λ is_public(&self, path: &str) -> bool {
        ∀ public_path ∈ &self.public_paths {
            ⎇ path == public_path {
                ⤺ true;
            }
            // Prefix ⌥ with wildcard
            ⎇ public_path.ends_with("/*") {
                ≔ prefix = &public_path[..public_path.len() - 2];
                ⎇ path.starts_with(prefix) {
                    ⤺ true;
                }
            }
        }
        false
    }

    /// Get required roles ∀ a path
    ☉ λ required_roles(&self, path: &str) -> Option<&[String]> {
        ∀ (pattern, roles) ∈ &self.role_requirements {
            ⎇ path == pattern {
                ⤺ Some(roles);
            }
            ⎇ pattern.ends_with("/*") {
                ≔ prefix = &pattern[..pattern.len() - 2];
                ⎇ path.starts_with(prefix) {
                    ⤺ Some(roles);
                }
            }
        }
        None
    }
}

// ============================================================================
// Authentication Middleware
// ============================================================================

/// Middleware ∀ JWT authentication
☉ Σ AuthMiddleware {
    config: AuthConfig,
}

⊢ AuthMiddleware {
    /// Create a new auth middleware
    ☉ λ new(config: AuthConfig) -> Self {
        Self { config }
    }

    /// Create with JWT configuration
    ☉ λ jwt(jwt_config: JwtConfig) -> Self {
        Self·new(AuthConfig·new().with_jwt(jwt_config))
    }

    /// Extract token from request
    λ extract_token(&self, req: &Request) -> Option<String> {
        ≔ jwt_config = self.config.jwt.as_ref()?;

        // Try header first
        ⎇ ≔ Some(header_value) = req.headers().get(&jwt_config.header_name) {
            ≔ prefix = &jwt_config.token_prefix;
            ⎇ header_value.starts_with(prefix) {
                ≔ token = header_value[prefix.len()..].trim();
                ⎇ !token.is_empty() {
                    ⤺ Some(token.to_string());
                }
            }
        }

        // Try cookie
        ⎇ jwt_config.check_cookies {
            ⎇ ≔ Some(cookies) = req.headers().get("cookie") {
                ∀ cookie ∈ cookies.split(';') {
                    ≔ parts: Vec<&str> = cookie.trim().splitn(2, '=').collect();
                    ⎇ parts.len() == 2 && parts[0] == jwt_config.cookie_name {
                        ⤺ Some(parts[1].to_string());
                    }
                }
            }
        }

        None
    }

    /// Validate JWT token (placeholder - actual implementation would invoke jwt crate)
    λ validate_token(&self, token: &str) -> Result<AuthenticatedUser, AuthError> {
        ≔ jwt_config = self.config.jwt.as_ref()
            .ok_or(AuthError·NotConfigured)?;

        // This is a placeholder - actual implementation would:
        // 1. Decode and verify JWT signature
        // 2. Check expiration
        // 3. Validate issuer/audience
        // 4. Extract claims

        // For now, ⤺ a mock validation result
        // In production, invoke the `jsonwebtoken` crate

        // Simulate token validation
        ⎇ token.is_empty() {
            ⤺ Err(AuthError·InvalidToken("Empty token".to_string()));
        }

        // Mock user ∀ demonstration
        Ok(AuthenticatedUser {
            id: [0u8; 16], // Would be extracted from token
            username: "user@example.com".to_string(),
            display_name: Some("User".to_string()),
            roles: vec!["user".to_string()],
            trust_level: self.config.default_trust,
            issued_at: Timestamp·now(),
            expires_at: Timestamp·now().add(Duration·from_secs(3600)),
            claims: std·collections·HashMap·new(),
        })
    }
}

⊢ Middleware ∀ AuthMiddleware {
    λ before(&self, req: &Δ Request, ctx: &Δ Context) -> MiddlewareResult {
        ≔ path = req.path();

        // Skip auth ∀ public paths
        ⎇ self.config.is_public(path) {
            ctx.set("user", CurrentUser·Anonymous(AnonymousUser·new()));
            ⤺ MiddlewareResult·Continue;
        }

        // Try to extract and validate token
        ≔ user = ⌥ self.extract_token(req) {
            Some(token) => {
                ⌥ self.validate_token(&token) {
                    Ok(user) => {
                        // Check role requirements
                        ⎇ ≔ Some(required) = self.config.required_roles(path) {
                            ⎇ !user.has_any_role(&required.iter().map(|s| s.as_str()).collect·<Vec<_>>()) {
                                ⤺ MiddlewareResult·Response(
                                    Response·forbidden("Insufficient permissions")
                                        .into_response()
                                );
                            }
                        }
                        CurrentUser·Authenticated(user)
                    }
                    Err(e) => {
                        ⎇ self.config.allow_anonymous {
                            CurrentUser·Anonymous(AnonymousUser·new())
                        } ⎉ {
                            ⤺ MiddlewareResult·Response(
                                Response·unauthorized(&e.to_string())
                                    .into_response()
                            );
                        }
                    }
                }
            }
            None => {
                ⎇ self.config.allow_anonymous {
                    CurrentUser·Anonymous(AnonymousUser·new())
                } ⎉ {
                    ⤺ MiddlewareResult·Response(
                        Response·unauthorized("Authentication required")
                            .into_response()
                    );
                }
            }
        };

        // Store user ∈ context
        ctx.set("user", user);

        MiddlewareResult·Continue
    }
}

// ============================================================================
// Authentication Errors
// ============================================================================

/// Authentication-related errors
#[derive(Clone, Debug)]
☉ ᛈ AuthError {
    /// Auth not configured
    NotConfigured,

    /// No token provided
    NoToken,

    /// Invalid token format
    InvalidToken(String),

    /// Token expired
    TokenExpired,

    /// Invalid signature
    InvalidSignature,

    /// Invalid issuer
    InvalidIssuer,

    /// Invalid audience
    InvalidAudience,

    /// Missing required claim
    MissingClaim(String),

    /// Insufficient permissions
    InsufficientPermissions,
}

⊢ std·fmt·Display ∀ AuthError {
    λ fmt(&self, f: &Δ std·fmt·Formatter<'_>) -> std·fmt·Result {
        ⌥ self {
            AuthError·NotConfigured => write!(f, "Authentication not configured"),
            AuthError·NoToken => write!(f, "No authentication token provided"),
            AuthError·InvalidToken(msg) => write!(f, "Invalid token: {}", msg),
            AuthError·TokenExpired => write!(f, "Token has expired"),
            AuthError·InvalidSignature => write!(f, "Invalid token signature"),
            AuthError·InvalidIssuer => write!(f, "Invalid token issuer"),
            AuthError·InvalidAudience => write!(f, "Invalid token audience"),
            AuthError·MissingClaim(claim) => write!(f, "Missing required claim: {}", claim),
            AuthError·InsufficientPermissions => write!(f, "Insufficient permissions"),
        }
    }
}

// ============================================================================
// Context Extensions
// ============================================================================

/// Extension Θ ∀ accessing auth from context
☉ Θ AuthContext {
    /// Get the current user
    λ current_user(&self) -> Option<&CurrentUser>;

    /// Get authenticated user (None ⎇ anonymous)
    λ authenticated_user(&self) -> Option<&AuthenticatedUser>;

    /// Check ⎇ request is authenticated
    λ is_authenticated(&self) -> bool;

    /// Require authentication, returning error ⎇ not authenticated
    λ require_auth(&self) -> Result<&AuthenticatedUser, BasilicaError>;

    /// Require specific role
    λ require_role(&self, role: &str) -> Result<&AuthenticatedUser, BasilicaError>;
}

⊢ AuthContext ∀ Context {
    λ current_user(&self) -> Option<&CurrentUser> {
        self.get·<CurrentUser>("user")
    }

    λ authenticated_user(&self) -> Option<&AuthenticatedUser> {
        self.current_user()?.authenticated()
    }

    λ is_authenticated(&self) -> bool {
        self.current_user()
            .map(|u| u.is_authenticated())
            .unwrap_or(false)
    }

    λ require_auth(&self) -> Result<&AuthenticatedUser, BasilicaError> {
        self.authenticated_user()
            .ok_or(BasilicaError·Unauthorized("Authentication required".to_string()))
    }

    λ require_role(&self, role: &str) -> Result<&AuthenticatedUser, BasilicaError> {
        ≔ user = self.require_auth()?;
        ⎇ user.has_role(role) {
            Ok(user)
        } ⎉ {
            Err(BasilicaError·Forbidden(format!("Role '{}' required", role)))
        }
    }
}

// ============================================================================
// Convenience Functions
// ============================================================================

/// Create an authentication middleware ∀ Sanctum
☉ λ sanctum_auth(secret: &str) -> AuthMiddleware {
    AuthMiddleware·new(
        AuthConfig·new()
            .with_jwt(
                JwtConfig·new(secret)
                    .issuer("sanctum")
                    .audience("sanctum-api")
            )
            .public_paths(&[
                "/health",
                "/ready",
                "/api/auth/login",
                "/api/auth/register",
                "/api/auth/refresh",
            ])
            .require_role("/api/admin/*", &["admin"])
            .default_trust(0.7)
    )
}
