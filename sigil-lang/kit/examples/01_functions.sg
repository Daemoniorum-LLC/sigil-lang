// 01_functions.sg - Functions, parameters, and return values
//
// Run: sigil run examples/01_functions.sg

// Basic function with parameters and return type
λ add(a: i32, b: i32) → i32 {
    a + b  // Last expression is returned
}

// Function with explicit return
λ absolute(x: i32) → i32 {
    if x < 0 {
        return -x;
    }
    x
}

// Function without return value
λ greet(name: &str) {
    println("Hello, " + name + "!");
}

// Higher-order function (takes function as parameter)
λ apply_twice(f: λ(i32) → i32, x: i32) → i32 {
    f(f(x))
}

// Closure (anonymous function)
λ main() {
    // Basic function calls
    println("add(3, 4) = " + str(add(3, 4)));
    println("absolute(-5) = " + str(absolute(-5)));
    greet("World");

    // Closure example
    ≔ double = |x: i32| → i32 { x * 2 };
    println("double(5) = " + str(double(5)));

    // Higher-order function with closure
    ≔ result = apply_twice(double, 3);
    println("apply_twice(double, 3) = " + str(result));  // 12

    // Closure capturing environment
    ≔ multiplier = 10;
    ≔ scale = |x: i32| → i32 { x * multiplier };
    println("scale(5) = " + str(scale(5)));  // 50
}
