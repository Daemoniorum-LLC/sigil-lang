//! Tests ∀ Gnosis Skill System
//!
//! Verifies SkillSystem, SkillProfile, SkillLevel, Exercise, and skill mechanics.

invoke std·collections·HashMap;

// ============================================================================
// Self-contained Test Types
// ============================================================================

☉ Σ Duration { nanos: u64 }
⊢ Duration {
    ☉ λ zero() -> Self { Self { nanos: 0 } }
    ☉ λ minutes(m: u64) -> Self { Self { nanos: m * 60_000_000_000 } }
}
⊢ Copy ∀ Duration {}
⊢ Clone ∀ Duration { λ clone(&self) -> Self { *self } }

☉ Σ Timestamp { nanos: u64 }
⊢ Timestamp {
    ☉ λ now() -> Self { Self { nanos: 1000 } }
}

☉ Σ ExperienceId { id: String }
⊢ ExperienceId { ☉ λ generate() -> Self { Self { id: "exp".to_string() } } }
⊢ Clone ∀ ExperienceId { λ clone(&self) -> Self { Self { id: self.id.clone() } } }

#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]
☉ ᛈ SkillLevel {
    Novice,
    AdvancedBeginner,
    Competent,
    Proficient,
    Expert,
}

⊢ SkillLevel {
    ☉ λ from_proficiency(p: f32) -> Self {
        ⎇ p >= 0.9 { SkillLevel·Expert }
        ⎉ ⎇ p >= 0.7 { SkillLevel·Proficient }
        ⎉ ⎇ p >= 0.5 { SkillLevel·Competent }
        ⎉ ⎇ p >= 0.3 { SkillLevel·AdvancedBeginner }
        ⎉ { SkillLevel·Novice }
    }

    ☉ λ to_string(&self) -> &'static str {
        ⌥ self {
            SkillLevel·Novice => "Novice",
            SkillLevel·AdvancedBeginner => "Advanced Beginner",
            SkillLevel·Competent => "Competent",
            SkillLevel·Proficient => "Proficient",
            SkillLevel·Expert => "Expert",
        }
    }

    ☉ λ numeric_level(&self) -> u8 {
        ⌥ self {
            SkillLevel·Novice => 1,
            SkillLevel·AdvancedBeginner => 2,
            SkillLevel·Competent => 3,
            SkillLevel·Proficient => 4,
            SkillLevel·Expert => 5,
        }
    }
}

#[derive(Copy, Clone)]
☉ ᛈ Performance {
    Excellent,
    Good,
    Adequate,
    Poor,
    Failed,
}

⊢ Performance {
    ☉ λ from_quality(quality: f32) -> Self {
        ⎇ quality >= 0.9 { Performance·Excellent }
        ⎉ ⎇ quality >= 0.7 { Performance·Good }
        ⎉ ⎇ quality >= 0.5 { Performance·Adequate }
        ⎉ ⎇ quality > 0.0 { Performance·Poor }
        ⎉ { Performance·Failed }
    }

    ☉ λ to_quality(&self) -> f32 {
        ⌥ self {
            Performance·Excellent => 0.95,
            Performance·Good => 0.8,
            Performance·Adequate => 0.6,
            Performance·Poor => 0.3,
            Performance·Failed => 0.0,
        }
    }
}

☉ Σ Exercise {
    ☉ task_id: ExperienceId,
    ☉ performance: Performance,
    ☉ duration: Duration,
    ☉ quality: f32,
    ☉ timestamp: Timestamp,
}

⊢ Exercise {
    ☉ λ new(quality: f32) -> Self {
        Self {
            task_id: ExperienceId·generate(),
            performance: Performance·from_quality(quality),
            duration: Duration·zero(),
            quality: quality.clamp(0.0, 1.0),
            timestamp: Timestamp·now(),
        }
    }

    ☉ λ with_performance(Δ self, performance: Performance) -> Self {
        self.performance = performance;
        self.quality = performance.to_quality();
        self
    }

    ☉ λ with_duration(Δ self, duration: Duration) -> Self {
        self.duration = duration;
        self
    }

    ☉ λ was_successful(&self) -> bool {
        self.quality >= 0.5
    }
}

☉ Σ SkillProfile {
    ☉ name: String,
    ☉ level: SkillLevel,
    ☉ proficiency: f32,
    ☉ experience_count: u32,
    exercises: Vec<Exercise>,
    ☉ last_practiced: Timestamp,
}

⊢ SkillProfile {
    ☉ λ new(name: &str) -> Self {
        Self {
            name: name.to_string(),
            level: SkillLevel·Novice,
            proficiency: 0.0,
            experience_count: 0,
            exercises: vec![],
            last_practiced: Timestamp·now(),
        }
    }

    ☉ λ proficiency(&self) -> f32 { self.proficiency }
    ☉ λ level(&self) -> SkillLevel { self.level }
    ☉ λ experience_count(&self) -> u32 { self.experience_count }
    ☉ λ exercise_count(&self) -> usize { self.exercises.len() }

    ☉ λ record_exercise(&Δ self, exercise: Exercise) {
        self.experience_count += 1;
        self.last_practiced = Timestamp·now();

        // Update proficiency (exponential moving average)
        ≔ alpha = 0.1;
        self.proficiency = self.proficiency * (1.0 - alpha) + exercise.quality * alpha;

        // Update level
        self.level = SkillLevel·from_proficiency(self.proficiency);

        self.exercises.push(exercise);
    }

    ☉ λ record_transfer(&Δ self, quality: f32) {
        ≔ alpha = 0.05;
        self.proficiency = self.proficiency * (1.0 - alpha) + quality * alpha;
        self.level = SkillLevel·from_proficiency(self.proficiency);
    }

    ☉ λ recent_accuracy(&self) -> f32 {
        ≔ recent: Vec<_> = self.exercises.iter().rev().take(10).collect();
        ⎇ recent.is_empty() { ⤺ 0.0; }
        recent.iter().map(|e| e.quality).sum·<f32>() / recent.len() as f32
    }

    ☉ λ success_rate(&self) -> f32 {
        ⎇ self.exercises.is_empty() { ⤺ 0.0; }
        ≔ successes = self.exercises.iter().filter(|e| e.was_successful()).count();
        successes as f32 / self.exercises.len() as f32
    }

    ☉ λ is_expert(&self) -> bool {
        self.level == SkillLevel·Expert
    }

    ☉ λ is_novice(&self) -> bool {
        self.level == SkillLevel·Novice
    }
}

☉ Σ SkillDefinition {
    ☉ name: String,
    ☉ subskills: Vec<String>,
    ☉ category: Option<String>,
}

⊢ SkillDefinition {
    ☉ λ new(name: &str) -> Self {
        Self {
            name: name.to_string(),
            subskills: vec![],
            category: None,
        }
    }

    ☉ λ with_subskill(Δ self, name: &str) -> Self {
        self.subskills.push(name.to_string());
        self
    }

    ☉ λ with_category(Δ self, category: &str) -> Self {
        self.category = Some(category.to_string());
        self
    }

    ☉ λ has_subskills(&self) -> bool {
        !self.subskills.is_empty()
    }
}

☉ Σ SkillTransfer {
    ☉ source: String,
    ☉ target: String,
    ☉ rate: f32,
    ☉ aspects: Vec<String>,
}

⊢ SkillTransfer {
    ☉ λ new(source: &str, target: &str, rate: f32) -> Self {
        Self {
            source: source.to_string(),
            target: target.to_string(),
            rate: rate.clamp(0.0, 1.0),
            aspects: vec![],
        }
    }

    ☉ λ with_aspect(Δ self, aspect: &str) -> Self {
        self.aspects.push(aspect.to_string());
        self
    }
}

☉ Σ SkillHierarchy {
    parent: HashMap<String, String>,
    children: HashMap<String, Vec<String>>,
}

⊢ SkillHierarchy {
    ☉ λ new() -> Self {
        Self {
            parent: HashMap·new(),
            children: HashMap·new(),
        }
    }

    ☉ λ add_child(&Δ self, parent: &str, child: &str) {
        self.parent.insert(child.to_string(), parent.to_string());
        self.children
            .entry(parent.to_string())
            .or_insert_with(Vec·new)
            .push(child.to_string());
    }

    ☉ λ get_children(&self, skill: &str) -> Option<&Vec<String>> {
        self.children.get(skill)
    }

    ☉ λ get_parent(&self, skill: &str) -> Option<&String> {
        self.parent.get(skill)
    }

    ☉ λ is_child_of(&self, child: &str, parent: &str) -> bool {
        self.parent.get(child).map(|p| p == parent).unwrap_or(false)
    }

    ☉ λ has_children(&self, skill: &str) -> bool {
        self.children.get(skill).map(|c| !c.is_empty()).unwrap_or(false)
    }
}

☉ Σ SkillConfig {
    ☉ experience_per_level: u32,
    ☉ decay_rate: f32,
    ☉ default_transfer_rate: f32,
}

⊢ SkillConfig {
    ☉ λ default_config() -> Self {
        Self {
            experience_per_level: 10,
            decay_rate: 0.01,
            default_transfer_rate: 0.3,
        }
    }
}

☉ Σ SkillSystem {
    skills: HashMap<String, SkillProfile>,
    hierarchy: SkillHierarchy,
    transfers: Vec<SkillTransfer>,
    config: SkillConfig,
}

⊢ SkillSystem {
    ☉ λ new() -> Self {
        Self {
            skills: HashMap·new(),
            hierarchy: SkillHierarchy·new(),
            transfers: vec![],
            config: SkillConfig·default_config(),
        }
    }

    ☉ λ define(&Δ self, skill: SkillDefinition) {
        ≔ profile = SkillProfile·new(&skill.name);
        self.skills.insert(skill.name.clone(), profile);

        ∀ sub ∈ skill.subskills {
            self.hierarchy.add_child(&skill.name, &sub);
            self.define(SkillDefinition·new(&sub));
        }
    }

    ☉ λ get(&self, name: &str) -> Option<&SkillProfile> {
        self.skills.get(name)
    }

    ☉ λ get_mut(&Δ self, name: &str) -> Option<&Δ SkillProfile> {
        self.skills.get_mut(name)
    }

    ☉ λ record_exercise(&Δ self, skill_name: &str, quality: f32) {
        // Get transfer targets first
        ≔ transfer_targets: Vec<(String, f32)> = self.transfers.iter()
            .filter(|t| t.source == skill_name)
            .map(|t| (t.target.clone(), t.rate))
            .collect();

        ⎇ ≔ Some(skill) = self.skills.get_mut(skill_name) {
            skill.record_exercise(Exercise·new(quality));
        }

        // Apply transfer learning
        ∀ (target_name, rate) ∈ transfer_targets {
            ⎇ ≔ Some(target) = self.skills.get_mut(&target_name) {
                target.record_transfer(quality * rate);
            }
        }
    }

    ☉ λ register_transfer(&Δ self, transfer: SkillTransfer) {
        self.transfers.push(transfer);
    }

    ☉ λ skill_count(&self) -> usize {
        self.skills.len()
    }

    ☉ λ all_skills(&self) -> Vec<&SkillProfile> {
        self.skills.values().collect()
    }

    ☉ λ skills_at_level(&self, level: SkillLevel) -> Vec<&SkillProfile> {
        self.skills.values().filter(|s| s.level == level).collect()
    }

    ☉ λ expert_skills(&self) -> Vec<&SkillProfile> {
        self.skills_at_level(SkillLevel·Expert)
    }

    ☉ λ novice_skills(&self) -> Vec<&SkillProfile> {
        self.skills_at_level(SkillLevel·Novice)
    }
}

// ============================================================================
// Tests: SkillLevel
// ============================================================================

#[test]
λ test_skill_level_from_proficiency_novice() {
    assert_eq(SkillLevel·from_proficiency(0.1), SkillLevel·Novice);
    assert_eq(SkillLevel·from_proficiency(0.0), SkillLevel·Novice);
}

#[test]
λ test_skill_level_from_proficiency_advanced_beginner() {
    assert_eq(SkillLevel·from_proficiency(0.3), SkillLevel·AdvancedBeginner);
    assert_eq(SkillLevel·from_proficiency(0.4), SkillLevel·AdvancedBeginner);
}

#[test]
λ test_skill_level_from_proficiency_competent() {
    assert_eq(SkillLevel·from_proficiency(0.5), SkillLevel·Competent);
    assert_eq(SkillLevel·from_proficiency(0.6), SkillLevel·Competent);
}

#[test]
λ test_skill_level_from_proficiency_proficient() {
    assert_eq(SkillLevel·from_proficiency(0.7), SkillLevel·Proficient);
    assert_eq(SkillLevel·from_proficiency(0.8), SkillLevel·Proficient);
}

#[test]
λ test_skill_level_from_proficiency_expert() {
    assert_eq(SkillLevel·from_proficiency(0.9), SkillLevel·Expert);
    assert_eq(SkillLevel·from_proficiency(1.0), SkillLevel·Expert);
}

#[test]
λ test_skill_level_to_string() {
    assert_eq(SkillLevel·Novice.to_string(), "Novice");
    assert_eq(SkillLevel·Expert.to_string(), "Expert");
}

#[test]
λ test_skill_level_numeric() {
    assert_eq(SkillLevel·Novice.numeric_level(), 1);
    assert_eq(SkillLevel·Expert.numeric_level(), 5);
}

#[test]
λ test_skill_level_ordering() {
    assert(SkillLevel·Expert > SkillLevel·Novice);
    assert(SkillLevel·Proficient > SkillLevel·Competent);
}

// ============================================================================
// Tests: Performance
// ============================================================================

#[test]
λ test_performance_from_quality_excellent() {
    ≔ perf = Performance·from_quality(0.95);
    ≔ is_excellent = ⌥ perf { Performance·Excellent => true, _ => false };
    assert(is_excellent);
}

#[test]
λ test_performance_from_quality_good() {
    ≔ perf = Performance·from_quality(0.75);
    ≔ is_good = ⌥ perf { Performance·Good => true, _ => false };
    assert(is_good);
}

#[test]
λ test_performance_from_quality_adequate() {
    ≔ perf = Performance·from_quality(0.55);
    ≔ is_adequate = ⌥ perf { Performance·Adequate => true, _ => false };
    assert(is_adequate);
}

#[test]
λ test_performance_from_quality_poor() {
    ≔ perf = Performance·from_quality(0.2);
    ≔ is_poor = ⌥ perf { Performance·Poor => true, _ => false };
    assert(is_poor);
}

#[test]
λ test_performance_from_quality_failed() {
    ≔ perf = Performance·from_quality(0.0);
    ≔ is_failed = ⌥ perf { Performance·Failed => true, _ => false };
    assert(is_failed);
}

#[test]
λ test_performance_to_quality() {
    assert_eq(Performance·Excellent.to_quality(), 0.95);
    assert_eq(Performance·Failed.to_quality(), 0.0);
}

// ============================================================================
// Tests: Exercise
// ============================================================================

#[test]
λ test_exercise_new() {
    ≔ ex = Exercise·new(0.8);
    assert_eq(ex.quality, 0.8);
    assert(ex.was_successful());
}

#[test]
λ test_exercise_quality_clamped() {
    ≔ ex = Exercise·new(1.5);
    assert_eq(ex.quality, 1.0);
}

#[test]
λ test_exercise_was_successful() {
    ≔ success = Exercise·new(0.6);
    ≔ failure = Exercise·new(0.3);
    assert(success.was_successful());
    assert(!failure.was_successful());
}

#[test]
λ test_exercise_with_performance() {
    ≔ ex = Exercise·new(0.5).with_performance(Performance·Excellent);
    assert_eq(ex.quality, 0.95);
}

#[test]
λ test_exercise_with_duration() {
    ≔ ex = Exercise·new(0.8).with_duration(Duration·minutes(30));
    assert_eq(ex.duration.nanos, Duration·minutes(30).nanos);
}

// ============================================================================
// Tests: SkillProfile
// ============================================================================

#[test]
λ test_skill_profile_new() {
    ≔ profile = SkillProfile·new("rust");
    assert_eq(profile.name, "rust");
    assert_eq(profile.level, SkillLevel·Novice);
    assert_eq(profile.proficiency, 0.0);
}

#[test]
λ test_skill_profile_record_exercise() {
    ≔ Δ profile = SkillProfile·new("testing");
    profile.record_exercise(Exercise·new(0.8));
    assert_eq(profile.experience_count(), 1);
    assert(profile.proficiency() > 0.0);
}

#[test]
λ test_skill_profile_level_progression() {
    ≔ Δ profile = SkillProfile·new("skill");
    // Many high-quality exercises should increase level
    ∀ _ ∈ 0..50 {
        profile.record_exercise(Exercise·new(0.95));
    }
    assert(profile.level() >= SkillLevel·Proficient);
}

#[test]
λ test_skill_profile_record_transfer() {
    ≔ Δ profile = SkillProfile·new("related");
    profile.record_transfer(0.8);
    assert(profile.proficiency() > 0.0);
}

#[test]
λ test_skill_profile_recent_accuracy() {
    ≔ Δ profile = SkillProfile·new("skill");
    profile.record_exercise(Exercise·new(0.8));
    profile.record_exercise(Exercise·new(0.9));
    ≔ accuracy = profile.recent_accuracy();
    ≔ diff = (accuracy - 0.85).abs();
    assert(diff < 0.01);
}

#[test]
λ test_skill_profile_success_rate() {
    ≔ Δ profile = SkillProfile·new("skill");
    profile.record_exercise(Exercise·new(0.8));  // success
    profile.record_exercise(Exercise·new(0.6));  // success
    profile.record_exercise(Exercise·new(0.3));  // failure
    ≔ rate = profile.success_rate();
    ≔ diff = (rate - 0.667).abs();
    assert(diff < 0.01);
}

#[test]
λ test_skill_profile_is_expert() {
    ≔ Δ profile = SkillProfile·new("mastered");
    ∀ _ ∈ 0..100 {
        profile.record_exercise(Exercise·new(0.99));
    }
    assert(profile.is_expert());
}

#[test]
λ test_skill_profile_is_novice() {
    ≔ profile = SkillProfile·new("new_skill");
    assert(profile.is_novice());
}

// ============================================================================
// Tests: SkillDefinition
// ============================================================================

#[test]
λ test_skill_definition_new() {
    ≔ def = SkillDefinition·new("programming");
    assert_eq(def.name, "programming");
    assert(!def.has_subskills());
}

#[test]
λ test_skill_definition_with_subskill() {
    ≔ def = SkillDefinition·new("programming")
        .with_subskill("rust")
        .with_subskill("python");
    assert(def.has_subskills());
    assert_eq(def.subskills.len(), 2);
}

#[test]
λ test_skill_definition_with_category() {
    ≔ def = SkillDefinition·new("rust")
        .with_category("programming");
    assert_eq(def.category.unwrap(), "programming");
}

// ============================================================================
// Tests: SkillTransfer
// ============================================================================

#[test]
λ test_skill_transfer_new() {
    ≔ transfer = SkillTransfer·new("python", "ruby", 0.5);
    assert_eq(transfer.source, "python");
    assert_eq(transfer.target, "ruby");
    assert_eq(transfer.rate, 0.5);
}

#[test]
λ test_skill_transfer_rate_clamped() {
    ≔ transfer = SkillTransfer·new("a", "b", 1.5);
    assert_eq(transfer.rate, 1.0);
}

#[test]
λ test_skill_transfer_with_aspect() {
    ≔ transfer = SkillTransfer·new("java", "kotlin", 0.7)
        .with_aspect("syntax")
        .with_aspect("oop");
    assert_eq(transfer.aspects.len(), 2);
}

// ============================================================================
// Tests: SkillHierarchy
// ============================================================================

#[test]
λ test_skill_hierarchy_new() {
    ≔ h = SkillHierarchy·new();
    assert(h.get_children("anything").is_none());
}

#[test]
λ test_skill_hierarchy_add_child() {
    ≔ Δ h = SkillHierarchy·new();
    h.add_child("programming", "rust");
    assert(h.has_children("programming"));
}

#[test]
λ test_skill_hierarchy_get_children() {
    ≔ Δ h = SkillHierarchy·new();
    h.add_child("programming", "rust");
    h.add_child("programming", "python");
    ≔ children = h.get_children("programming");
    assert(children.is_some());
    assert_eq(children.unwrap().len(), 2);
}

#[test]
λ test_skill_hierarchy_get_parent() {
    ≔ Δ h = SkillHierarchy·new();
    h.add_child("programming", "rust");
    ≔ parent = h.get_parent("rust");
    assert(parent.is_some());
    assert_eq(*parent.unwrap(), "programming");
}

#[test]
λ test_skill_hierarchy_is_child_of() {
    ≔ Δ h = SkillHierarchy·new();
    h.add_child("programming", "rust");
    assert(h.is_child_of("rust", "programming"));
    assert(!h.is_child_of("python", "programming"));
}

// ============================================================================
// Tests: SkillSystem
// ============================================================================

#[test]
λ test_skill_system_new() {
    ≔ system = SkillSystem·new();
    assert_eq(system.skill_count(), 0);
}

#[test]
λ test_skill_system_define() {
    ≔ Δ system = SkillSystem·new();
    system.define(SkillDefinition·new("rust"));
    assert_eq(system.skill_count(), 1);
}

#[test]
λ test_skill_system_define_with_subskills() {
    ≔ Δ system = SkillSystem·new();
    system.define(SkillDefinition·new("programming")
        .with_subskill("rust")
        .with_subskill("python"));
    assert_eq(system.skill_count(), 3);  // programming + rust + python
}

#[test]
λ test_skill_system_get() {
    ≔ Δ system = SkillSystem·new();
    system.define(SkillDefinition·new("testing"));
    ≔ skill = system.get("testing");
    assert(skill.is_some());
    assert_eq(skill.unwrap().name, "testing");
}

#[test]
λ test_skill_system_record_exercise() {
    ≔ Δ system = SkillSystem·new();
    system.define(SkillDefinition·new("coding"));
    system.record_exercise("coding", 0.8);
    ≔ skill = system.get("coding").unwrap();
    assert_eq(skill.experience_count(), 1);
}

#[test]
λ test_skill_system_transfer_learning() {
    ≔ Δ system = SkillSystem·new();
    system.define(SkillDefinition·new("python"));
    system.define(SkillDefinition·new("ruby"));
    system.register_transfer(SkillTransfer·new("python", "ruby", 0.5));

    system.record_exercise("python", 0.9);

    ≔ ruby = system.get("ruby").unwrap();
    assert(ruby.proficiency() > 0.0);  // Should have transferred
}

#[test]
λ test_skill_system_all_skills() {
    ≔ Δ system = SkillSystem·new();
    system.define(SkillDefinition·new("a"));
    system.define(SkillDefinition·new("b"));
    system.define(SkillDefinition·new("c"));
    assert_eq(system.all_skills().len(), 3);
}

#[test]
λ test_skill_system_skills_at_level() {
    ≔ Δ system = SkillSystem·new();
    system.define(SkillDefinition·new("novice1"));
    system.define(SkillDefinition·new("novice2"));
    ≔ novices = system.skills_at_level(SkillLevel·Novice);
    assert_eq(novices.len(), 2);
}

#[test]
λ test_skill_system_expert_skills() {
    ≔ Δ system = SkillSystem·new();
    system.define(SkillDefinition·new("mastered"));
    // Exercise many times with high quality
    ∀ _ ∈ 0..100 {
        system.record_exercise("mastered", 0.99);
    }
    ≔ experts = system.expert_skills();
    assert_eq(experts.len(), 1);
}

λ main() {
    print("Gnosis skills tests");
}
