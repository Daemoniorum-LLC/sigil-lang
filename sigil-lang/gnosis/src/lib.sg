☉ λ new_gnosis() -> Gnosis { Gnosis·new() }

☉ λ learn_from_experience(gnosis: &Δ Gnosis, context: Context, action: Action, outcome: ExperienceOutcome) {
    gnosis.experience(Experience·new(context, action, outcome));
}

☉ λ reflect_on_period(gnosis: &Gnosis, period: ReflectionPeriod) -> String {
    gnosis.reflect(period).to_summary()
}

