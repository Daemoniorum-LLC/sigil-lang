// Gnosis - Learning and Growth Infrastructure
// Wisdom is knowledge applied through experience

invoke std·collections·HashMap;
invoke std·hash·{Hash, Hasher};
invoke std·cmp·Ordering;
invoke shared·{
    Timestamp, Duration, Value, BoundedDeque, Confidence,
    Priority, HumanId, ExperienceId, EntityId,
};

// ============================================================================
// Main Gnosis Structure
// ============================================================================

☉ Σ Gnosis {
    learning: LearningEngine,
    skills: SkillSystem,
    adaptation: AdaptationSystem,
    reflection: ReflectionSystem,
    config: GnosisConfig,
}

☉ Σ GnosisConfig {
    ☉ max_experiences: usize,
    ☉ pattern_threshold: usize,
    ☉ preference_learning_rate: f32,
}

⊢ GnosisConfig {
    ☉ λ default() -> Self {
        Self {
            max_experiences: 1000,
            pattern_threshold: 3,
            preference_learning_rate: 0.1,
        }
    }
}

⊢ Gnosis {
    ☉ λ new() -> Self {
        Self {
            learning: LearningEngine·new(),
            skills: SkillSystem·new(),
            adaptation: AdaptationSystem·new(),
            reflection: ReflectionSystem·new(),
            config: GnosisConfig·default(),
        }
    }

    /// Record an experience
    ☉ λ experience(&Δ self, exp: Experience) {
        self.learning.record_experience(exp.clone());

        // Extract lessons
        ≔ lessons = self.learning.extract_lessons(&exp);
        ∀ lesson ∈ lessons {
            self.learning.lessons.add(lesson);
        }

        // Update skills
        ⎇ ≔ Some(skills) = exp.skills_exercised() {
            ∀ skill ∈ skills {
                self.skills.record_exercise(&skill, &exp);
            }
        }
    }

    /// Learn from feedback
    ☉ λ learn_from_feedback(&Δ self, feedback: Feedback) {
        self.learning.integrate_feedback(feedback.clone());

        // Update adaptation
        ⎇ ≔ Some(ref human_id) = feedback.human_id {
            self.adaptation.update_profile(human_id, &feedback);
        }
    }

    /// Learn from outcome
    ☉ λ learn_from_outcome(&Δ self, outcome: Outcome) {
        self.learning.learn_from_outcome(outcome);
    }

    /// Get a skill profile
    ☉ λ skill(&self, name: &str) -> Option<&SkillProfile> {
        self.skills.get(name)
    }

    /// Define a new skill
    ☉ λ define_skill(&Δ self, skill: SkillDefinition) {
        self.skills.define(skill);
    }

    /// Get adapted communication style ∀ human
    ☉ λ adapted_style(&self, human_id: &HumanId) -> CommunicationStyle {
        self.adaptation.style_for(human_id)
    }

    /// Adapt to a domain
    ☉ λ adapt_to_domain(&Δ self, domain: &str, knowledge: DomainKnowledge) {
        self.adaptation.adapt_to_domain(domain, knowledge);
    }

    /// Get domain adaptation
    ☉ λ domain_adaptation(&self, domain: &str) -> Option<&DomainAdaptation> {
        self.adaptation.domain_adaptation(domain)
    }

    /// Perform reflection
    ☉ λ reflect(&self, period: ReflectionPeriod) -> Reflection {
        self.reflection.analyze(period, &self.learning, &self.skills)
    }

    /// Register skill transfer relationship
    ☉ λ register_transfer(&Δ self, transfer: SkillTransfer) {
        self.skills.register_transfer(transfer);
    }

    /// Get all skills
    ☉ λ all_skills(&self) -> ⊢ Iterator<Item = &SkillProfile> {
        self.skills.all_skills()
    }

    /// Suggest approach based on past learning
    ☉ λ suggest_approach(&self, context: &Context) -> ApproachSuggestion {
        // Find patterns matching this context
        ≔ matching_patterns: Vec<_> = self.learning.patterns.patterns.iter()
            .filter(|p| p.context.similar_to(context))
            .collect();

        ⎇ matching_patterns.is_empty() {
            ⤺ ApproachSuggestion {
                approaches: vec![],
                confidence: Confidence·zero(),
            };
        }

        // Sort by success rate
        ≔ Δ suggestions: Vec<_> = matching_patterns.iter()
            .map(|p| SuggestedApproach {
                approach: p.approach.clone(),
                success_rate: p.success_rate,
                confidence: p.confidence,
            })
            .collect();

        suggestions.sort_by(|a, b| b.success_rate.partial_cmp(&a.success_rate).unwrap_or(Ordering·Equal));

        ≔ avg_confidence = suggestions.iter().map(|s| s.confidence.value()).sum·<f64>() / suggestions.len() as f64;

        ApproachSuggestion {
            approaches: suggestions,
            confidence: Confidence·new(avg_confidence),
        }
    }
}

☉ Σ ApproachSuggestion {
    ☉ approaches: Vec<SuggestedApproach>,
    ☉ confidence: Confidence,
}

⊢ ApproachSuggestion {
    ☉ λ best(&self) -> Option<&SuggestedApproach> {
        self.approaches.first()
    }
}

☉ Σ SuggestedApproach {
    ☉ approach: String,
    ☉ success_rate: f32,
    ☉ confidence: Confidence,
}

// ============================================================================
// Learning Engine
// ============================================================================

☉ Σ LearningEngine {
    ☉ experiences: BoundedDeque<Experience>,
    ☉ patterns: PatternStore,
    ☉ lessons: LessonStore,
    config: LearningConfig,
}

☉ Σ LearningConfig {
    ☉ max_experiences: usize,
    ☉ pattern_threshold: usize,
    ☉ generalization_threshold: f32,
}

⊢ LearningConfig {
    ☉ λ default() -> Self {
        Self {
            max_experiences: 1000,
            pattern_threshold: 3,
            generalization_threshold: 0.7,
        }
    }
}

⊢ LearningEngine {
    ☉ λ new() -> Self {
        Self {
            experiences: BoundedDeque·new(1000),
            patterns: PatternStore·new(),
            lessons: LessonStore·new(),
            config: LearningConfig·default(),
        }
    }

    /// Record an experience
    ☉ λ record_experience(&Δ self, exp: Experience) {
        self.experiences.push_back(exp.clone());

        // Check ∀ patterns
        self.detect_patterns(&exp);
        // BoundedDeque handles capacity automatically
    }

    /// Extract lessons from experience
    ☉ λ extract_lessons(&self, exp: &Experience) -> Vec<Lesson> {
        ≔ Δ lessons = Vec·new();

        // Lesson from positive outcomes
        ⎇ exp.outcome.success {
            lessons.push(Lesson {
                context: exp.context.clone(),
                approach: exp.action.approach.clone(),
                effectiveness: exp.outcome.quality,
                lesson_type: LessonType·EffectiveApproach,
            });
        }

        // Lesson from negative outcomes
        ⎇ !exp.outcome.success {
            lessons.push(Lesson {
                context: exp.context.clone(),
                approach: exp.action.approach.clone(),
                effectiveness: 1.0 - exp.outcome.quality,
                lesson_type: LessonType·IneffectiveApproach,
            });
        }

        // Lesson from unexpected outcomes
        ⎇ exp.outcome.unexpected {
            lessons.push(Lesson {
                context: exp.context.clone(),
                approach: exp.action.approach.clone(),
                effectiveness: 0.5,
                lesson_type: LessonType·SurprisingOutcome,
            });
        }

        lessons
    }

    /// Integrate feedback
    ☉ λ integrate_feedback(&Δ self, feedback: Feedback) {
        // Find relevant experience
        ⎇ ≔ Some(_exp) = self.find_experience(&feedback.context) {
            // Learn from the feedback
            ≔ lesson = Lesson {
                context: feedback.context.clone(),
                approach: "feedback_response".to_string(),
                effectiveness: feedback.positivity(),
                lesson_type: LessonType·FeedbackLearning,
            };
            self.lessons.add(lesson);
        }
    }

    /// Learn from outcome
    ☉ λ learn_from_outcome(&Δ self, outcome: Outcome) {
        ≔ lesson = Lesson {
            context: outcome.task.context.clone(),
            approach: outcome.task.approach.clone(),
            effectiveness: ⎇ outcome.success { outcome.quality } ⎉ { 0.0 },
            lesson_type: ⎇ outcome.success {
                LessonType·EffectiveApproach
            } ⎉ {
                LessonType·IneffectiveApproach
            },
        };

        self.lessons.add(lesson);
    }

    λ detect_patterns(&Δ self, exp: &Experience) {
        ≔ similar = self.find_similar_experiences(exp);

        ⎇ similar.len() >= self.config.pattern_threshold {
            ⎇ ≔ Some(pattern) = self.extract_pattern(&similar) {
                self.patterns.add(pattern);
            }
        }
    }

    λ find_similar_experiences(&self, exp: &Experience) -> Vec<&Experience> {
        self.experiences.iter()
            .filter(|e| e.context.similar_to(&exp.context))
            .collect()
    }

    λ extract_pattern(&self, experiences: &[&Experience]) -> Option<Pattern> {
        ⎇ experiences.is_empty() {
            ⤺ None;
        }

        // Find most common approach
        ≔ Δ approach_counts: HashMap<&str, usize> = HashMap·new();
        ∀ exp ∈ experiences {
            *approach_counts.entry(&exp.action.approach).or_insert(0) += 1;
        }

        ≔ common_approach = approach_counts.iter()
            .max_by_key(|(_, count)| *count)
            .map(|(approach, _)| (*approach).to_string())?;

        ≔ avg_success = experiences.iter()
            .filter(|e| e.outcome.success)
            .count() as f32 / experiences.len() as f32;

        Some(Pattern {
            context: experiences[0].context.clone(),
            approach: common_approach,
            success_rate: avg_success,
            confidence: Confidence·new((experiences.len() as f64 / 10.0).min(1.0)),
        })
    }

    λ find_experience(&self, context: &Context) -> Option<&Experience> {
        self.experiences.iter()
            .rev()
            .find(|e| e.context.matches(context))
    }
}

// ============================================================================
// Experience Types
// ============================================================================

#[derive(Clone)]
☉ Σ Experience {
    ☉ id: ExperienceId,
    ☉ context: Context,
    ☉ action: Action,
    ☉ outcome: ExperienceOutcome,
    ☉ feedback: Option<Feedback>,
    ☉ timestamp: Timestamp,
}

⊢ Experience {
    ☉ λ new(context: Context, action: Action, outcome: ExperienceOutcome) -> Self {
        Self {
            id: ExperienceId·generate(),
            context,
            action,
            outcome,
            feedback: None,
            timestamp: Timestamp·now(),
        }
    }

    ☉ λ skills_exercised(&self) -> Option<Vec<String>> {
        ⎇ self.action.skills.is_empty() {
            None
        } ⎉ {
            Some(self.action.skills.clone())
        }
    }
}

#[derive(Clone)]
☉ Σ Context {
    ☉ task_type: String,
    ☉ constraints: Vec<String>,
    ☉ domain: Option<String>,
    ☉ human_id: Option<HumanId>,
    ☉ features: HashMap<String, String>,
}

⊢ Context {
    ☉ λ new(task_type: &str) -> Self {
        Self {
            task_type: task_type.to_string(),
            constraints: vec![],
            domain: None,
            human_id: None,
            features: HashMap·new(),
        }
    }

    ☉ λ with_domain(Δ self, domain: &str) -> Self {
        self.domain = Some(domain.to_string());
        self
    }

    ☉ λ with_human(Δ self, human_id: HumanId) -> Self {
        self.human_id = Some(human_id);
        self
    }

    ☉ λ similar_to(&self, other: &Context) -> bool {
        self.task_type == other.task_type
    }

    ☉ λ matches(&self, other: &Context) -> bool {
        self.task_type == other.task_type && self.domain == other.domain
    }
}

#[derive(Clone)]
☉ Σ Action {
    ☉ approach: String,
    ☉ skills: Vec<String>,
    ☉ details: Option<String>,
}

⊢ Action {
    ☉ λ new(approach: &str) -> Self {
        Self {
            approach: approach.to_string(),
            skills: vec![],
            details: None,
        }
    }

    ☉ λ with_skill(Δ self, skill: &str) -> Self {
        self.skills.push(skill.to_string());
        self
    }
}

#[derive(Clone)]
☉ Σ ExperienceOutcome {
    ☉ success: bool,
    ☉ quality: f32,
    ☉ unexpected: bool,
    ☉ details: Option<String>,
}

⊢ ExperienceOutcome {
    ☉ λ success(quality: f32) -> Self {
        Self {
            success: true,
            quality,
            unexpected: false,
            details: None,
        }
    }

    ☉ λ failure(details: &str) -> Self {
        Self {
            success: false,
            quality: 0.0,
            unexpected: false,
            details: Some(details.to_string()),
        }
    }

    ☉ λ unexpected(quality: f32) -> Self {
        Self {
            success: true,
            quality,
            unexpected: true,
            details: None,
        }
    }
}

// ============================================================================
// Pattern and Lesson Types
// ============================================================================

☉ Σ Pattern {
    ☉ context: Context,
    ☉ approach: String,
    ☉ success_rate: f32,
    ☉ confidence: Confidence,
}

☉ Σ Lesson {
    ☉ context: Context,
    ☉ approach: String,
    ☉ effectiveness: f32,
    ☉ lesson_type: LessonType,
}

#[derive(Clone)]
☉ ᛈ LessonType {
    EffectiveApproach,
    IneffectiveApproach,
    SurprisingOutcome,
    FeedbackLearning,
}

☉ Σ PatternStore {
    ☉ patterns: Vec<Pattern>,
}

⊢ PatternStore {
    ☉ λ new() -> Self { Self { patterns: vec![] } }
    ☉ λ add(&Δ self, pattern: Pattern) { self.patterns.push(pattern); }
}

☉ Σ LessonStore {
    lessons: Vec<Lesson>,
}

⊢ LessonStore {
    ☉ λ new() -> Self { Self { lessons: vec![] } }
    ☉ λ add(&Δ self, lesson: Lesson) { self.lessons.push(lesson); }
    ☉ λ lessons(&self) -> &[Lesson] { &self.lessons }
}

// ============================================================================
// Skill System
// ============================================================================

☉ Σ SkillSystem {
    skills: HashMap<String, SkillProfile>,
    hierarchy: SkillHierarchy,
    transfers: Vec<SkillTransfer>,
    config: SkillConfig,
}

☉ Σ SkillConfig {
    ☉ experience_per_level: u32,
    ☉ decay_rate: f32,
    ☉ default_transfer_rate: f32,
}

⊢ SkillConfig {
    ☉ λ default() -> Self {
        Self {
            experience_per_level: 10,
            decay_rate: 0.01,
            default_transfer_rate: 0.3,
        }
    }
}

⊢ SkillSystem {
    ☉ λ new() -> Self {
        Self {
            skills: HashMap·new(),
            hierarchy: SkillHierarchy·new(),
            transfers: vec![],
            config: SkillConfig·default(),
        }
    }

    /// Define a skill
    ☉ λ define(&Δ self, skill: SkillDefinition) {
        ≔ profile = SkillProfile·new(skill.name.clone());
        self.skills.insert(skill.name.clone(), profile);

        ∀ sub ∈ skill.subskills {
            self.hierarchy.add_child(&skill.name, &sub);
            self.define(SkillDefinition {
                name: sub,
                subskills: vec![],
            });
        }
    }

    /// Get skill profile
    ☉ λ get(&self, name: &str) -> Option<&SkillProfile> {
        self.skills.get(name)
    }

    /// Record skill exercise
    ☉ λ record_exercise(&Δ self, skill_name: &str, exp: &Experience) {
        // Get transfer targets first
        ≔ transfer_targets: Vec<(String, f32)> = self.transfers.iter()
            .filter(|t| t.source == skill_name)
            .map(|t| (t.target.clone(), t.rate))
            .collect();

        ≔ quality = exp.outcome.quality;

        ⎇ ≔ Some(skill) = self.skills.get_mut(skill_name) {
            ≔ exercise = Exercise {
                task_id: exp.id.clone(),
                performance: Performance·from_outcome(&exp.outcome),
                duration: Duration·zero(),
                quality: exp.outcome.quality,
                timestamp: Timestamp·now(),
            };

            skill.record_exercise(exercise);
        }

        // Apply transfer learning
        ∀ (target_name, rate) ∈ transfer_targets {
            ⎇ ≔ Some(target) = self.skills.get_mut(&target_name) {
                ≔ transferred_quality = quality * rate;
                target.record_transfer(transferred_quality);
            }
        }
    }

    /// Register skill transfer
    ☉ λ register_transfer(&Δ self, transfer: SkillTransfer) {
        self.transfers.push(transfer);
    }

    /// Get all skills
    ☉ λ all_skills(&self) -> ⊢ Iterator<Item = &SkillProfile> {
        self.skills.values()
    }
}

☉ Σ SkillDefinition {
    ☉ name: String,
    ☉ subskills: Vec<String>,
}

⊢ SkillDefinition {
    ☉ λ new(name: &str) -> Self {
        Self {
            name: name.to_string(),
            subskills: vec![],
        }
    }

    ☉ λ with_subskill(Δ self, name: &str) -> Self {
        self.subskills.push(name.to_string());
        self
    }
}

☉ Σ SkillProfile {
    ☉ name: String,
    ☉ level: SkillLevel,
    ☉ proficiency: f32,
    ☉ experience_count: u32,
    ☉ exercises: BoundedDeque<Exercise>,
    ☉ last_practiced: Timestamp,
}

⊢ SkillProfile {
    ☉ λ new(name: String) -> Self {
        Self {
            name,
            level: SkillLevel·Novice,
            proficiency: 0.0,
            experience_count: 0,
            exercises: BoundedDeque·new(100),
            last_practiced: Timestamp·now(),
        }
    }

    ☉ λ proficiency(&self) -> f32 { self.proficiency }
    ☉ λ level(&self) -> SkillLevel { self.level }
    ☉ λ experience_count(&self) -> u32 { self.experience_count }

    ☉ λ recent_accuracy(&self) -> f32 {
        ≔ recent: Vec<_> = self.exercises.iter().rev().take(10).collect();
        ⎇ recent.is_empty() { ⤺ 0.0; }
        recent.iter().map(|e| e.quality).sum·<f32>() / recent.len() as f32
    }

    ☉ λ record_exercise(&Δ self, exercise: Exercise) {
        self.experience_count += 1;
        self.last_practiced = Timestamp·now();

        // Update proficiency (exponential moving average)
        ≔ alpha = 0.1;
        self.proficiency = self.proficiency * (1.0 - alpha) + exercise.quality * alpha;

        // Update level
        self.level = SkillLevel·from_proficiency(self.proficiency);

        // Store exercise - BoundedDeque handles capacity automatically
        self.exercises.push_back(exercise);
    }

    ☉ λ record_transfer(&Δ self, quality: f32) {
        ≔ alpha = 0.05;
        self.proficiency = self.proficiency * (1.0 - alpha) + quality * alpha;
        self.level = SkillLevel·from_proficiency(self.proficiency);
    }
}

#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]
☉ ᛈ SkillLevel {
    Novice,
    AdvancedBeginner,
    Competent,
    Proficient,
    Expert,
}

⊢ SkillLevel {
    ☉ λ from_proficiency(p: f32) -> Self {
        ⎇ p >= 0.9 { SkillLevel·Expert }
        ⎉ ⎇ p >= 0.7 { SkillLevel·Proficient }
        ⎉ ⎇ p >= 0.5 { SkillLevel·Competent }
        ⎉ ⎇ p >= 0.3 { SkillLevel·AdvancedBeginner }
        ⎉ { SkillLevel·Novice }
    }

    ☉ λ to_string(&self) -> &'static str {
        ⌥ self {
            SkillLevel·Novice => "Novice",
            SkillLevel·AdvancedBeginner => "Advanced Beginner",
            SkillLevel·Competent => "Competent",
            SkillLevel·Proficient => "Proficient",
            SkillLevel·Expert => "Expert",
        }
    }
}

☉ Σ Exercise {
    ☉ task_id: ExperienceId,
    ☉ performance: Performance,
    ☉ duration: Duration,
    ☉ quality: f32,
    ☉ timestamp: Timestamp,
}

#[derive(Copy, Clone)]
☉ ᛈ Performance {
    Excellent,
    Good,
    Adequate,
    Poor,
    Failed,
}

⊢ Performance {
    ☉ λ from_outcome(outcome: &ExperienceOutcome) -> Self {
        ⎇ !outcome.success { ⤺ Performance·Failed; }
        ⎇ outcome.quality >= 0.9 { Performance·Excellent }
        ⎉ ⎇ outcome.quality >= 0.7 { Performance·Good }
        ⎉ ⎇ outcome.quality >= 0.5 { Performance·Adequate }
        ⎉ { Performance·Poor }
    }
}

☉ Σ SkillHierarchy {
    parent: HashMap<String, String>,
    children: HashMap<String, Vec<String>>,
}

⊢ SkillHierarchy {
    ☉ λ new() -> Self {
        Self {
            parent: HashMap·new(),
            children: HashMap·new(),
        }
    }

    ☉ λ add_child(&Δ self, parent: &str, child: &str) {
        self.parent.insert(child.to_string(), parent.to_string());
        self.children
            .entry(parent.to_string())
            .or_insert_with(Vec·new)
            .push(child.to_string());
    }

    ☉ λ get_children(&self, skill: &str) -> Option<&Vec<String>> {
        self.children.get(skill)
    }

    ☉ λ get_parent(&self, skill: &str) -> Option<&String> {
        self.parent.get(skill)
    }
}

☉ Σ SkillTransfer {
    ☉ source: String,
    ☉ target: String,
    ☉ rate: f32,
    ☉ aspects: Vec<String>,
}

⊢ SkillTransfer {
    ☉ λ new(source: &str, target: &str, rate: f32) -> Self {
        Self {
            source: source.to_string(),
            target: target.to_string(),
            rate,
            aspects: vec![],
        }
    }
}

// ============================================================================
// Adaptation System
// ============================================================================

☉ Σ AdaptationSystem {
    profiles: HashMap<HumanId, HumanProfile>,
    domains: HashMap<String, DomainAdaptation>,
    default_style: CommunicationStyle,
    config: AdaptationConfig,
}

☉ Σ AdaptationConfig {
    ☉ preference_learning_rate: f32,
    ☉ preference_decay_rate: f32,
}

⊢ AdaptationConfig {
    ☉ λ default() -> Self {
        Self {
            preference_learning_rate: 0.1,
            preference_decay_rate: 0.01,
        }
    }
}

⊢ AdaptationSystem {
    ☉ λ new() -> Self {
        Self {
            profiles: HashMap·new(),
            domains: HashMap·new(),
            default_style: CommunicationStyle·default(),
            config: AdaptationConfig·default(),
        }
    }

    /// Get communication style ∀ human
    ☉ λ style_for(&self, human_id: &HumanId) -> CommunicationStyle {
        self.profiles.get(human_id)
            .map(|p| p.preferred_style.clone())
            .unwrap_or_else(|| self.default_style.clone())
    }

    /// Update profile based on feedback
    ☉ λ update_profile(&Δ self, human_id: &HumanId, feedback: &Feedback) {
        ≔ profile = self.profiles
            .entry(human_id.clone())
            .or_insert_with(|| HumanProfile·new(human_id.clone()));

        ⌥ feedback.feedback_type {
            FeedbackType·TooVerbose => profile.adjust_verbosity(-0.1),
            FeedbackType·NeedMoreDetail => profile.adjust_verbosity(0.1),
            FeedbackType·TooFormal => profile.adjust_formality(-0.1),
            FeedbackType·TooInformal => profile.adjust_formality(0.1),
            FeedbackType·GoodApproach => profile.reinforce_current(),
            _ => {}
        }
    }

    /// Adapt to domain
    ☉ λ adapt_to_domain(&Δ self, domain: &str, knowledge: DomainKnowledge) {
        self.domains.insert(domain.to_string(), DomainAdaptation {
            domain: domain.to_string(),
            terminology: knowledge.terminology,
            conventions: knowledge.conventions,
            constraints: knowledge.constraints,
        });
    }

    /// Get domain adaptation
    ☉ λ domain_adaptation(&self, domain: &str) -> Option<&DomainAdaptation> {
        self.domains.get(domain)
    }
}

☉ Σ HumanProfile {
    ☉ human_id: HumanId,
    ☉ preferred_style: CommunicationStyle,
    ☉ interaction_history: BoundedDeque<InteractionRecord>,
    ☉ last_interaction: Timestamp,
}

⊢ HumanProfile {
    ☉ λ new(human_id: HumanId) -> Self {
        Self {
            human_id,
            preferred_style: CommunicationStyle·default(),
            interaction_history: BoundedDeque·new(100),
            last_interaction: Timestamp·now(),
        }
    }

    ☉ λ adjust_verbosity(&Δ self, delta: f32) {
        self.preferred_style.verbosity = (self.preferred_style.verbosity + delta).clamp(-1.0, 1.0);
    }

    ☉ λ adjust_formality(&Δ self, delta: f32) {
        self.preferred_style.formality = (self.preferred_style.formality + delta).clamp(-1.0, 1.0);
    }

    ☉ λ adjust_proactivity(&Δ self, delta: f32) {
        self.preferred_style.proactivity = (self.preferred_style.proactivity + delta).clamp(-1.0, 1.0);
    }

    ☉ λ reinforce_current(&Δ self) {
        // Style is already good, reinforce by moving slightly toward extremes
        self.preferred_style.verbosity *= 1.05;
        self.preferred_style.formality *= 1.05;
        self.preferred_style.verbosity = self.preferred_style.verbosity.clamp(-1.0, 1.0);
        self.preferred_style.formality = self.preferred_style.formality.clamp(-1.0, 1.0);
    }
}

#[derive(Clone)]
☉ Σ CommunicationStyle {
    /// Verbosity (-1 = minimal, 1 = verbose)
    ☉ verbosity: f32,
    /// Formality (-1 = casual, 1 = formal)
    ☉ formality: f32,
    /// Proactivity (-1 = reactive, 1 = proactive)
    ☉ proactivity: f32,
    /// Detail level (-1 = high-level, 1 = detailed)
    ☉ detail_level: f32,
    /// Check-in frequency (-1 = rare, 1 = frequent)
    ☉ check_in_frequency: f32,
}

⊢ CommunicationStyle {
    ☉ λ default() -> Self {
        Self {
            verbosity: 0.0,
            formality: 0.0,
            proactivity: 0.0,
            detail_level: 0.0,
            check_in_frequency: 0.0,
        }
    }

    ☉ λ concise() -> Self {
        Self { verbosity: -0.8, ..Self·default() }
    }

    ☉ λ verbose() -> Self {
        Self { verbosity: 0.8, ..Self·default() }
    }

    ☉ λ formal() -> Self {
        Self { formality: 0.8, ..Self·default() }
    }

    ☉ λ casual() -> Self {
        Self { formality: -0.8, ..Self·default() }
    }
}

Σ InteractionRecord {
    timestamp: Timestamp,
    interaction_type: String,
    outcome: String,
}

☉ Σ DomainAdaptation {
    ☉ domain: String,
    ☉ terminology: HashMap<String, String>,
    ☉ conventions: Vec<String>,
    ☉ constraints: Vec<String>,
}

☉ Σ DomainKnowledge {
    ☉ terminology: HashMap<String, String>,
    ☉ conventions: Vec<String>,
    ☉ constraints: Vec<String>,
}

⊢ DomainKnowledge {
    ☉ λ new() -> Self {
        Self {
            terminology: HashMap·new(),
            conventions: vec![],
            constraints: vec![],
        }
    }

    ☉ λ with_term(Δ self, term: &str, definition: &str) -> Self {
        self.terminology.insert(term.to_string(), definition.to_string());
        self
    }

    ☉ λ with_convention(Δ self, convention: &str) -> Self {
        self.conventions.push(convention.to_string());
        self
    }
}

// ============================================================================
// Reflection System
// ============================================================================

☉ Σ ReflectionSystem {
    config: ReflectionConfig,
}

☉ Σ ReflectionConfig {
    ☉ min_experiences: usize,
    ☉ pattern_significance: f32,
}

⊢ ReflectionConfig {
    ☉ λ default() -> Self {
        Self {
            min_experiences: 5,
            pattern_significance: 0.7,
        }
    }
}

⊢ ReflectionSystem {
    ☉ λ new() -> Self {
        Self { config: ReflectionConfig·default() }
    }

    /// Analyze and reflect
    ☉ λ analyze(
        &self,
        period: ReflectionPeriod,
        learning: &LearningEngine,
        skills: &SkillSystem,
    ) -> Reflection {
        ≔ experiences = self.gather_experiences(period, learning);
        ≔ skill_data = self.gather_skill_data(period, skills);

        ≔ successes = self.identify_successes(&experiences);
        ≔ improvements = self.identify_improvements(&experiences, &skill_data);
        ≔ patterns = self.extract_patterns(&experiences);
        ≔ insights = self.generate_insights(&experiences, &skill_data, &patterns);
        ≔ growth = self.measure_growth(&skill_data);

        Reflection {
            period,
            successes,
            improvements,
            patterns,
            insights,
            growth,
            timestamp: Timestamp·now(),
        }
    }

    λ gather_experiences(&self, period: ReflectionPeriod, learning: &LearningEngine) -> Vec<Experience> {
        ≔ cutoff = period.start_time();
        learning.experiences.iter()
            .filter(|e| e.timestamp >= cutoff)
            .cloned()
            .collect()
    }

    λ gather_skill_data(&self, period: ReflectionPeriod, skills: &SkillSystem) -> Vec<SkillSnapshot> {
        skills.all_skills()
            .map(|s| SkillSnapshot {
                name: s.name.clone(),
                level: s.level,
                proficiency: s.proficiency,
                recent_exercises: s.exercises.iter()
                    .filter(|e| e.timestamp >= period.start_time())
                    .count(),
            })
            .collect()
    }

    λ identify_successes(&self, experiences: &[Experience]) -> Vec<Success> {
        experiences.iter()
            .filter(|e| e.outcome.success && e.outcome.quality >= 0.8)
            .map(|e| Success {
                description: format!("Successful {} task", e.context.task_type),
                factors: vec![e.action.approach.clone()],
            })
            .collect()
    }

    λ identify_improvements(&self, experiences: &[Experience], skills: &[SkillSnapshot]) -> Vec<ImprovementArea> {
        ≔ Δ improvements = Vec·new();

        // From failed experiences
        ∀ exp ∈ experiences.iter().filter(|e| !e.outcome.success) {
            improvements.push(ImprovementArea {
                skill: exp.context.task_type.clone(),
                suggestion: format!("Review approach ∀ {} tasks", exp.context.task_type),
                priority: Priority·Normal,
            });
        }

        // From low proficiency skills
        ∀ skill ∈ skills.iter().filter(|s| s.proficiency < 0.5 && s.recent_exercises > 0) {
            improvements.push(ImprovementArea {
                skill: skill.name.clone(),
                suggestion: format!("Practice {} more", skill.name),
                priority: Priority·Low,
            });
        }

        improvements
    }

    λ extract_patterns(&self, experiences: &[Experience]) -> Vec<String> {
        ≔ Δ patterns = Vec·new();

        // Group by task type
        ≔ Δ by_type: HashMap<&str, Vec<&Experience>> = HashMap·new();
        ∀ exp ∈ experiences {
            by_type.entry(&exp.context.task_type).or_default().push(exp);
        }

        // Identify patterns ∈ each group
        ∀ (task_type, exps) ∈ by_type {
            ⎇ exps.len() >= 3 {
                ≔ success_rate = exps.iter().filter(|e| e.outcome.success).count() as f32 / exps.len() as f32;
                ⎇ success_rate >= 0.8 {
                    patterns.push(format!("Strong performance on {} tasks ({:.0}% success)", task_type, success_rate * 100.0));
                } ⎉ ⎇ success_rate <= 0.4 {
                    patterns.push(format!("Struggling with {} tasks ({:.0}% success)", task_type, success_rate * 100.0));
                }
            }
        }

        patterns
    }

    λ generate_insights(&self, experiences: &[Experience], skills: &[SkillSnapshot], patterns: &[String]) -> Vec<Insight> {
        ≔ Δ insights = Vec·new();

        // Insight from experience volume
        ⎇ experiences.len() > 20 {
            insights.push(Insight {
                observation: format!("High activity period with {} experiences", experiences.len()),
                implication: "Active learning phase".to_string(),
                action: Some("Continue momentum ⟳ ensuring quality".to_string()),
            });
        }

        // Insight from skill distribution
        ≔ expert_skills = skills.iter().filter(|s| s.level >= SkillLevel·Proficient).count();
        ≔ novice_skills = skills.iter().filter(|s| s.level == SkillLevel·Novice && s.recent_exercises > 0).count();

        ⎇ expert_skills > novice_skills * 2 {
            insights.push(Insight {
                observation: "Skill profile shows specialization".to_string(),
                implication: "Strong ∈ specific areas".to_string(),
                action: Some("Consider broadening skill base".to_string()),
            });
        }

        // Insight from patterns
        ∀ pattern ∈ patterns {
            ⎇ pattern.contains("Struggling") {
                insights.push(Insight {
                    observation: pattern.clone(),
                    implication: "May need different approach".to_string(),
                    action: Some("Analyze failed attempts ∀ common factors".to_string()),
                });
            }
        }

        insights
    }

    λ measure_growth(&self, skills: &[SkillSnapshot]) -> GrowthMeasurement {
        ≔ active_skills: Vec<_> = skills.iter().filter(|s| s.recent_exercises > 0).collect();

        ≔ overall = ⎇ active_skills.is_empty() {
            0.0
        } ⎉ {
            active_skills.iter().map(|s| s.proficiency).sum·<f32>() / active_skills.len() as f32
        };

        GrowthMeasurement {
            overall,
            by_skill: skills.iter()
                .filter(|s| s.recent_exercises > 0)
                .map(|s| (s.name.clone(), s.proficiency))
                .collect(),
        }
    }
}

#[derive(Copy, Clone)]
☉ ᛈ ReflectionPeriod {
    Daily,
    Weekly,
    Monthly,
}

⊢ ReflectionPeriod {
    ☉ λ start_time(&self) -> Timestamp {
        ≔ now = Timestamp·now();
        ≔ offset = ⌥ self {
            ReflectionPeriod·Daily => Duration·hours(24),
            ReflectionPeriod·Weekly => Duration·hours(168),
            ReflectionPeriod·Monthly => Duration·hours(720),
        };
        Timestamp·from_nanos(now.nanos.saturating_sub(offset.as_nanos()))
    }
}

☉ Σ Reflection {
    ☉ period: ReflectionPeriod,
    ☉ successes: Vec<Success>,
    ☉ improvements: Vec<ImprovementArea>,
    ☉ patterns: Vec<String>,
    ☉ insights: Vec<Insight>,
    ☉ growth: GrowthMeasurement,
    ☉ timestamp: Timestamp,
}

⊢ Reflection {
    ☉ λ successes(&self) -> &[Success] { &self.successes }
    ☉ λ improvement_areas(&self) -> &[ImprovementArea] { &self.improvements }
    ☉ λ patterns(&self) -> &[String] { &self.patterns }
    ☉ λ insights(&self) -> &[Insight] { &self.insights }

    ☉ λ to_summary(&self) -> String {
        ≔ Δ output = String·new();

        output.push_str("=== Reflection Summary ===\n\n");

        ⎇ !self.successes.is_empty() {
            output.push_str("Successes:\n");
            ∀ s ∈ &self.successes {
                output.push_str(&format!("  - {}\n", s.description));
            }
            output.push('\n');
        }

        ⎇ !self.improvements.is_empty() {
            output.push_str("Areas ∀ Improvement:\n");
            ∀ i ∈ &self.improvements {
                output.push_str(&format!("  - {}: {}\n", i.skill, i.suggestion));
            }
            output.push('\n');
        }

        ⎇ !self.patterns.is_empty() {
            output.push_str("Patterns Observed:\n");
            ∀ p ∈ &self.patterns {
                output.push_str(&format!("  - {}\n", p));
            }
            output.push('\n');
        }

        ⎇ !self.insights.is_empty() {
            output.push_str("Insights:\n");
            ∀ i ∈ &self.insights {
                output.push_str(&format!("  - {}\n", i.observation));
                ⎇ ≔ Some(ref action) = i.action {
                    output.push_str(&format!("    → {}\n", action));
                }
            }
            output.push('\n');
        }

        output.push_str(&format!("Overall Growth: {:.0}%\n", self.growth.overall * 100.0));

        output
    }
}

☉ Σ Success {
    ☉ description: String,
    ☉ factors: Vec<String>,
}

☉ Σ ImprovementArea {
    ☉ skill: String,
    ☉ suggestion: String,
    ☉ priority: Priority,
}

// Priority imported from shared module

☉ Σ Insight {
    ☉ observation: String,
    ☉ implication: String,
    ☉ action: Option<String>,
}

☉ Σ SkillSnapshot {
    ☉ name: String,
    ☉ level: SkillLevel,
    ☉ proficiency: f32,
    ☉ recent_exercises: usize,
}

☉ Σ GrowthMeasurement {
    ☉ overall: f32,
    ☉ by_skill: Vec<(String, f32)>,
}

⊢ GrowthMeasurement {
    ☉ λ overall_growth(&self) -> f32 { self.overall }
}

// ============================================================================
// Feedback Types
// ============================================================================

#[derive(Clone)]
☉ Σ Feedback {
    ☉ human_id: Option<HumanId>,
    ☉ context: Context,
    ☉ feedback_type: FeedbackType,
    ☉ message: Option<String>,
    ☉ timestamp: Timestamp,
}

⊢ Feedback {
    ☉ λ new(feedback_type: FeedbackType, context: Context) -> Self {
        Self {
            human_id: None,
            context,
            feedback_type,
            message: None,
            timestamp: Timestamp·now(),
        }
    }

    ☉ λ from_human(human_id: HumanId, feedback_type: FeedbackType, context: Context) -> Self {
        Self {
            human_id: Some(human_id),
            context,
            feedback_type,
            message: None,
            timestamp: Timestamp·now(),
        }
    }

    ☉ λ positivity(&self) -> f32 {
        ⌥ self.feedback_type {
            FeedbackType·Positive(_) => 1.0,
            FeedbackType·Neutral => 0.5,
            FeedbackType·Negative(_) => 0.0,
            FeedbackType·TooVerbose => 0.3,
            FeedbackType·NeedMoreDetail => 0.3,
            FeedbackType·TooFormal => 0.3,
            FeedbackType·TooInformal => 0.3,
            FeedbackType·GoodApproach => 0.9,
            FeedbackType·WrongApproach => 0.1,
            FeedbackType·Custom(_) => 0.5,
        }
    }
}

#[derive(Clone)]
☉ ᛈ FeedbackType {
    Positive(String),
    Negative(String),
    Neutral,
    TooVerbose,
    NeedMoreDetail,
    TooFormal,
    TooInformal,
    GoodApproach,
    WrongApproach,
    Custom(String),
}

☉ Σ Outcome {
    ☉ task: Task,
    ☉ success: bool,
    ☉ quality: f32,
    ☉ human_satisfaction: Option<Satisfaction>,
}

☉ Σ Task {
    ☉ context: Context,
    ☉ approach: String,
}

#[derive(Copy, Clone)]
☉ ᛈ Satisfaction {
    Delighted,
    Satisfied,
    Neutral,
    Disappointed,
    Frustrated,
}

