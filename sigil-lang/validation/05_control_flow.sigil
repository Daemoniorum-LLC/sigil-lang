// From GETTING_STARTED - Control Flow
fn main() {
    // If expression
    let a = 10;
    let b = 5;
    let max = if a > b { a } else { b };
    println("Max:");
    println(max);

    // While loop
    let mut counter = 0;
    while counter < 5 {
        println(counter);
        counter = counter + 1;
    }

    // For loop
    println("For loop:");
    for i in 0..5 {
        println(i);
    }
}
