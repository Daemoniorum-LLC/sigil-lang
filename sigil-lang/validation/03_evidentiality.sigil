// From README - Evidentiality Types
fn main() {
    // Known - verified truth
    let computed: i32! = 1 + 1;
    println("Computed (known):");
    println(computed);

    // Test validation
    let external = 42;
    let validated = external|validate!{|x| x > 0};
    println("Validated:");
    println(validated);
}
