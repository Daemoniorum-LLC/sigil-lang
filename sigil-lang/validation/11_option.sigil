// Option type handling
fn find_even(nums: Vec<i32>) -> Option<i32> {
    for n in nums {
        if n % 2 == 0 {
            return Some(n);
        }
    }
    None
}

fn main() {
    let odds = vec![1, 3, 5, 7];
    let mixed = vec![1, 3, 4, 5];

    let result1 = find_even(odds);
    match result1 {
        Some(n) => println("Found even: " + n.to_string()),
        None => println("No even found"),
    }

    let result2 = find_even(mixed);
    match result2 {
        Some(n) => println("Found even: " + n.to_string()),
        None => println("No even found"),
    }
}
