// From GETTING_STARTED - Enums and Match
enum Shape {
    Circle(f64),
    Rectangle(f64, f64),
}

fn area(shape: Shape) -> f64 {
    match shape {
        Shape::Circle(r) => 3.14159 * r * r,
        Shape::Rectangle(w, h) => w * h,
    }
}

fn main() {
    let circle = Shape::Circle(5.0);
    let rect = Shape::Rectangle(3.0, 4.0);

    println("Circle area:");
    println(area(circle));

    println("Rectangle area:");
    println(area(rect));
}
