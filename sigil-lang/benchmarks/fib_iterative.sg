// Benchmark: Iterative Fibonacci
// Tests: Loop performance, variable mutation

λ fib(n: i64) -> i64 {
    ⎇ n <= 1 {
        ⤺ n;
    }
    ≔ Δ a = 0;
    ≔ Δ b = 1;
    ≔ Δ i = 2;
    ⟳ i <= n {
        ≔ temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    b
}

λ main() {
    ≔ result = fib(50);
    println(result);
}
