// Benchmark: Sieve of Eratosthenes
// Tests: Array operations, nested loops

λ sieve(limit: i64) -> i64 {
    ≔ Δ is_prime: Vec<bool> = Vec·new();
    ≔ Δ i = 0;
    ⟳ i <= limit {
        is_prime.push(true);
        i = i + 1;
    }

    is_prime[0] = false;
    is_prime[1] = false;

    ≔ Δ p = 2;
    ⟳ p * p <= limit {
        ⎇ is_prime[p] {
            ≔ Δ multiple = p * p;
            ⟳ multiple <= limit {
                is_prime[multiple] = false;
                multiple = multiple + p;
            }
        }
        p = p + 1;
    }

    ≔ Δ count = 0;
    ≔ Δ j = 0;
    ⟳ j <= limit {
        ⎇ is_prime[j] {
            count = count + 1;
        }
        j = j + 1;
    }
    count
}

λ main() {
    ≔ count = sieve(10000);
    println(count);
}
