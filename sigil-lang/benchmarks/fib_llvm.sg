// Benchmark: Fibonacci ∀ LLVM backend
// Returns 0 on success (result verification)

λ fib(n: i64) -> i64 {
    ⎇ n <= 1 {
        n
    } ⎉ {
        fib(n - 1) + fib(n - 2)
    }
}

λ main() -> i64 {
    ≔ result = fib(35);
    // Return 0 ⎇ correct, 1 ⎇ wrong
    ⎇ result == 9227465 {
        0
    } ⎉ {
        1
    }
}
