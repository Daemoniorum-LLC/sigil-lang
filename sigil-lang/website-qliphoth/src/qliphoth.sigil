// Qliphoth Component Library Documentation
// Compiled from Sigil to WebAssembly
// Full component library with 40+ components and 25 hooks

// === DOM Helpers ===

rite create_element(tag: &str) → i64 {
    vdom_create_vnode(tag)
}

rite create_text(content: &str) → i64 {
    vdom_create_text_vnode(content)
}

rite set_class(element: i64, class_name: &str) {
    vdom_set_vnode_str_prop(element, "class", class_name)
}

rite set_attr(element: i64, name: &str, value: &str) {
    vdom_set_vnode_str_prop(element, name, value)
}

rite append_child(parent: i64, child: i64) {
    vdom_append_vnode_child(parent, child)
}

rite mount(element: i64, selector: &str) → i64 {
    vdom_mount_vnode(element, selector)
}

// === Component Helpers ===

rite link(href: &str, text: &str, class: &str) → i64 {
    ≔ a = create_element("a");
    set_class(a, class);
    set_attr(a, "href", href);
    ≔ t = create_text(text);
    append_child(a, t);
    a
}

rite heading(level: &str, text: &str, class: &str) → i64 {
    ≔ h = create_element(level);
    set_class(h, class);
    ≔ t = create_text(text);
    append_child(h, t);
    h
}

rite para(text: &str, class: &str) → i64 {
    ≔ p = create_element("p");
    set_class(p, class);
    ≔ t = create_text(text);
    append_child(p, t);
    p
}

rite span(text: &str, class: &str) → i64 {
    ≔ s = create_element("span");
    set_class(s, class);
    ≔ t = create_text(text);
    append_child(s, t);
    s
}

rite code_block(code: &str) → i64 {
    ≔ pre = create_element("pre");
    set_class(pre, "code-block");
    ≔ c = create_text(code);
    append_child(pre, c);
    pre
}

rite div_with_class(class: &str) → i64 {
    ≔ d = create_element("div");
    set_class(d, class);
    d
}

// === Navigation ===

rite header() → i64 {
    ≔ h = create_element("header");
    set_class(h, "site-header");

    ≔ container = div_with_class("container");
    ≔ content = div_with_class("header-content");

    // Logo
    ≔ logo = create_element("a");
    set_class(logo, "logo");
    set_attr(logo, "href", "index.html");
    ≔ logo_icon = div_with_class("logo-icon");
    ≔ img = create_element("img");
    set_attr(img, "src", "images/sigil-logo.svg");
    set_attr(img, "alt", "Sigil Logo");
    append_child(logo_icon, img);
    append_child(logo, logo_icon);
    append_child(logo, span("Sigil", "logo-text"));
    append_child(logo, span("0.3", "version-badge"));
    append_child(content, logo);

    // Nav
    ≔ nav = create_element("nav");
    append_child(nav, link("learn.html", "Learn", ""));
    append_child(nav, link("docs.html", "Docs", ""));
    append_child(nav, link("qliphoth.html", "Qliphoth", "active"));
    append_child(nav, link("playground/", "Playground", ""));
    append_child(nav, link("agents.html", "Agents", ""));
    append_child(nav, link("https://github.com/Daemoniorum-LLC/sigil-lang", "GitHub", ""));
    append_child(content, nav);

    append_child(container, content);
    append_child(h, container);
    h
}

// === Hero Section ===

rite hero_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "hero");

    ≔ container = div_with_class("container");

    append_child(container, heading("h1", "Qliphoth", ""));
    append_child(container, para(
        "A React-inspired web framework built on Sigil's polysynthetic paradigm. " ++
        "Corporate Goth UI components, signal-based reactivity, and zero JavaScript.",
        "tagline"
    ));

    // Stats
    ≔ stats = div_with_class("hero-stats");
    append_child(stats, hero_stat("40+", "Components"));
    append_child(stats, hero_stat("25", "Hooks"));
    append_child(stats, hero_stat("0", "JavaScript"));
    append_child(stats, hero_stat("100%", "Type-safe"));
    append_child(container, stats);

    // CTA buttons
    ≔ cta = div_with_class("cta-buttons");
    append_child(cta, link("#quick-start", "Get Started", "btn btn-primary"));
    append_child(cta, link("https://github.com/Daemoniorum-LLC/sigil-lang/tree/master/qliphoth", "View Source", "btn btn-secondary"));
    append_child(container, cta);

    append_child(section, container);
    section
}

rite hero_stat(value: &str, label: &str) → i64 {
    ≔ stat = div_with_class("hero-stat");
    ≔ v = div_with_class("hero-stat-value");
    ≔ vt = create_text(value);
    append_child(v, vt);
    append_child(stat, v);
    ≔ l = div_with_class("hero-stat-label");
    ≔ lt = create_text(label);
    append_child(l, lt);
    append_child(stat, l);
    stat
}

// === Overview Section ===

rite overview_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "docs-section");
    set_attr(section, "id", "overview");

    ≔ container = div_with_class("container");

    // Section header
    ≔ header = div_with_class("section-header");
    append_child(header, span("Overview", "section-eyebrow"));
    append_child(header, heading("h2", "Why Qliphoth?", "section-title"));
    append_child(header, para(
        "Leveraging Sigil's unique features for type-safe, high-performance web applications.",
        "section-lead"
    ));
    append_child(container, header);

    // Feature grid
    ≔ grid = div_with_class("feature-grid");
    append_child(grid, feature_card("!", "Evidentiality-Driven",
        "Track data provenance with ! known, ? uncertain, ~ remote markers."));
    append_child(grid, feature_card("|τ", "Morpheme Components",
        "Compose UI with pipe operators and functional transformations."));
    append_child(grid, feature_card("→", "Signal Reactivity",
        "Fine-grained updates via message passing, not virtual DOM diffing."));
    append_child(grid, feature_card("0", "Zero-Cost",
        "Compile-time optimization eliminates runtime overhead."));
    append_child(container, grid);

    // Quick start example
    ≔ example = div_with_class("example-section");
    set_attr(example, "id", "quick-start");
    ≔ ex_header = div_with_class("example-header");
    append_child(ex_header, span("Quick Start", "example-title"));
    append_child(ex_header, span("counter.sigil", "example-lang"));
    append_child(example, ex_header);
    append_child(example, code_block(
        "use qliphoth::prelude::*\n\n" ++
        "// Define a counter component with reactive state\n" ++
        "#[component]\n" ++
        "sigil Counter {\n" ++
        "    count: i64! = 0  // Known, computed state\n" ++
        "}\n\n" ++
        "⊢ Counter {\n" ++
        "    rite render(&this) → Element! {\n" ++
        "        div {\n" ++
        "            h1 { \"Count: {this.count}\" }\n" ++
        "            button[onclick: || this.count += 1] { \"+\" }\n" ++
        "            button[onclick: || this.count -= 1] { \"-\" }\n" ++
        "        }\n" ++
        "    }\n" ++
        "}\n\n" ++
        "☉ rite main() {\n" ++
        "    App::mount(\"#root\", Counter::new())\n" ++
        "}"
    ));
    append_child(container, example);

    append_child(section, container);
    section
}

rite feature_card(icon: &str, title: &str, desc: &str) → i64 {
    ≔ card = div_with_class("feature-card");
    ≔ ic = div_with_class("feature-icon");
    ≔ it = create_text(icon);
    append_child(ic, it);
    append_child(card, ic);
    append_child(card, heading("h3", title, "feature-title"));
    append_child(card, para(desc, "feature-desc"));
    card
}

// === Components Section ===

rite components_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "docs-section");
    set_attr(section, "id", "components");

    ≔ container = div_with_class("container");

    // Section header
    ≔ header = div_with_class("section-header");
    append_child(header, span("Components", "section-eyebrow"));
    append_child(header, heading("h2", "Core Components", "section-title"));
    append_child(header, para(
        "React-inspired component model with Sigil's evidentiality and actor patterns.",
        "section-lead"
    ));
    append_child(container, header);

    // Component grid
    ≔ grid = div_with_class("component-grid");

    append_child(grid, component_card("Component", "Core", "</>"  ,
        "Base trait for all Sigil Web components.",
        "aspect Component: Sized {\n    rite render(&this) → VNode;\n}"
    ));

    append_child(grid, component_card("Context", "State", "⊕",
        "Share data across components without prop drilling.",
        "≔ ThemeCtx = Context::new(\"dark\")\n≔ theme = use_context(ThemeCtx)"
    ));

    append_child(grid, component_card("ErrorBoundary", "Error", "⚠",
        "Catch errors in child components and display fallback UI.",
        "ErrorBoundary {\n    fallback: |err~| ErrorView { err },\n    children: [RiskyComponent {}]\n}"
    ));

    append_child(grid, component_card("Suspense", "Async", "…",
        "Handle async loading states with fallback content.",
        "Suspense {\n    fallback: Spinner {},\n    children: [AsyncContent {}]\n}"
    ));

    append_child(grid, component_card("Memo", "Perf", "μ",
        "Memoize component rendering when props don't change.",
        "Memo::new(ExpensiveList { items })"
    ));

    append_child(grid, component_card("Fragment", "Core", "[ ]",
        "Group children without adding extra DOM nodes.",
        "Fragment([\n    Header {},\n    Content {},\n    Footer {}\n])"
    ));

    append_child(grid, component_card("Portal", "DOM", "↔",
        "Render children into a different DOM location.",
        "Portal(\"#modal-root\", [\n    Modal { open: show_modal }\n])"
    ));

    append_child(grid, component_card("Lazy", "Async", "↓",
        "Code-split components with lazy loading.",
        "≔ HeavyChart = Lazy::new(|| {\n    import(\"./charts\")\n})"
    ));

    append_child(container, grid);
    append_child(section, container);
    section
}

rite component_card(name: &str, badge: &str, icon: &str, desc: &str, code: &str) → i64 {
    ≔ card = div_with_class("component-card");

    ≔ header = div_with_class("component-header");
    ≔ ic = div_with_class("component-icon");
    ≔ it = create_text(icon);
    append_child(ic, it);
    append_child(header, ic);
    append_child(header, span(name, "component-name"));
    append_child(header, span(badge, "component-badge"));
    append_child(card, header);

    append_child(card, para(desc, "component-desc"));
    append_child(card, code_block(code));

    card
}

// === Hooks Section ===

rite hooks_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "docs-section");
    set_attr(section, "id", "hooks");

    ≔ container = div_with_class("container");

    // Section header
    ≔ header = div_with_class("section-header");
    append_child(header, span("Hooks", "section-eyebrow"));
    append_child(header, heading("h2", "React-Style Hooks", "section-title"));
    append_child(header, para(
        "25 hooks with Sigil's evidentiality tracking for type-safe state management.",
        "section-lead"
    ));
    append_child(container, header);

    // Core Hooks
    append_child(container, heading("h3", "Core Hooks", "category-title"));
    ≔ core_grid = div_with_class("hooks-grid");
    append_child(core_grid, hook_card("use_state", "Local component state. Returns (value!, setter)."));
    append_child(core_grid, hook_card("use_reducer", "Complex state with reducer pattern."));
    append_child(core_grid, hook_card("use_effect", "Side effects with dependency tracking."));
    append_child(core_grid, hook_card("use_memo", "Memoize expensive computations."));
    append_child(core_grid, hook_card("use_callback", "Memoize callback functions."));
    append_child(core_grid, hook_card("use_ref", "Mutable reference persisting across renders."));
    append_child(core_grid, hook_card("use_context", "Consume context values from ancestors."));
    append_child(container, core_grid);

    // Data Hooks
    append_child(container, heading("h3", "Data Fetching Hooks", "category-title"));
    ≔ data_grid = div_with_class("hooks-grid");
    append_child(data_grid, hook_card("use_fetch", "Fetch JSON data. Returns AsyncState<T~>."));
    append_child(data_grid, hook_card("use_fetch_with", "Fetch with custom options."));
    append_child(data_grid, hook_card("use_mutation", "Handle POST/PUT/DELETE mutations."));
    append_child(container, data_grid);

    // Utility Hooks
    append_child(container, heading("h3", "Utility Hooks", "category-title"));
    ≔ util_grid = div_with_class("hooks-grid");
    append_child(util_grid, hook_card("use_debounce", "Debounce value updates by delay."));
    append_child(util_grid, hook_card("use_throttle", "Throttle value updates by rate limit."));
    append_child(util_grid, hook_card("use_local_storage", "Persist state to localStorage."));
    append_child(util_grid, hook_card("use_media_query", "React to CSS media query changes."));
    append_child(util_grid, hook_card("use_window_size", "Track window dimensions."));
    append_child(util_grid, hook_card("use_online", "Track online/offline network status."));
    append_child(container, util_grid);

    // Animation Hooks
    append_child(container, heading("h3", "Animation Hooks", "category-title"));
    ≔ anim_grid = div_with_class("hooks-grid");
    append_child(anim_grid, hook_card("use_spring", "Spring-based physics animations."));
    append_child(anim_grid, hook_card("use_transition", "Manage transition state for async updates."));
    append_child(anim_grid, hook_card("use_animation_frame", "Run callback on every animation frame."));
    append_child(container, anim_grid);

    append_child(section, container);
    section
}

rite hook_card(name: &str, desc: &str) → i64 {
    ≔ card = div_with_class("hook-card");
    ≔ n = div_with_class("hook-name");
    ≔ nt = create_text(name);
    append_child(n, nt);
    append_child(card, n);
    append_child(card, para(desc, "hook-desc"));
    card
}

// === State Section ===

rite state_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "docs-section");
    set_attr(section, "id", "state");

    ≔ container = div_with_class("container");

    // Section header
    ≔ header = div_with_class("section-header");
    append_child(header, span("State Management", "section-eyebrow"));
    append_child(header, heading("h2", "Signals & Atoms", "section-title"));
    append_child(header, para(
        "Fine-grained reactivity with Sigil's evidentiality tracking.",
        "section-lead"
    ));
    append_child(container, header);

    ≔ grid = div_with_class("component-grid");

    append_child(grid, component_card("signal", "Reactive", "σ",
        "Create reactive primitive values that auto-update subscribers.",
        "≔ count = signal(0)\ncount.set(count.get() + 1)"
    ));

    append_child(grid, component_card("computed", "Derived", "ƒ",
        "Derive values from signals with automatic dependency tracking.",
        "≔ doubled = computed(|| count.get() * 2)"
    ));

    append_child(grid, component_card("effect", "Side Effect", "ε",
        "Run side effects when signals change.",
        "effect(|| {\n    println(\"Count: {}\", count.get())\n})"
    ));

    append_child(grid, component_card("Atom", "Global", "α",
        "Jotai-style atomic state for global sharing.",
        "≔ userAtom = Atom::new(None)\n≔ user = use_atom(userAtom)"
    ));

    append_child(grid, component_card("Store", "Redux", "S",
        "Redux-style store with actions and selectors.",
        "≔ store = Store::new(reducer, init)\n≔ dispatch = use_dispatch()"
    ));

    append_child(grid, component_card("produce", "Immer", "ρ",
        "Immer-style immutable updates with mutable syntax.",
        "≔ next = produce(state, |draft| {\n    draft.user.name = \"Alice\"\n})"
    ));

    append_child(container, grid);
    append_child(section, container);
    section
}

// === Router Section ===

rite router_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "docs-section");
    set_attr(section, "id", "router");

    ≔ container = div_with_class("container");

    // Section header
    ≔ header = div_with_class("section-header");
    append_child(header, span("Routing", "section-eyebrow"));
    append_child(header, heading("h2", "Type-Safe Router", "section-title"));
    append_child(header, para(
        "React Router-inspired navigation with compile-time route checking.",
        "section-lead"
    ));
    append_child(container, header);

    ≔ grid = div_with_class("component-grid");

    append_child(grid, component_card("Router", "Core", "/",
        "Root router component with history management.",
        "Router {\n    Route { path: \"/\", element: Home {} }\n    Route { path: \"/users/:id\", element: User {} }\n}"
    ));

    append_child(grid, component_card("Link / NavLink", "Navigation", "→",
        "Client-side navigation without full page reload.",
        "Link { to: \"/users/123\", \"View User\" }\nNavLink { to: \"/home\", active_class: \"current\" }"
    ));

    append_child(grid, component_card("use_params / use_query", "Hooks", "?",
        "Access route parameters and query strings.",
        "≔ params = use_params()  // { id: \"123\" }\n≔ query = use_query()    // { page: \"2\" }"
    ));

    append_child(grid, component_card("use_navigate", "Hooks", "←",
        "Programmatic navigation hook.",
        "≔ navigate = use_navigate()\nnavigate(\"/dashboard\")"
    ));

    append_child(grid, component_card("Outlet", "Nested", "⊕",
        "Nested route rendering for layouts.",
        "Route { path: \"/app\", element: Layout {} }\n    Route { path: \"dashboard\", element: Dashboard {} }"
    ));

    append_child(grid, component_card("ProtectedRoute", "Auth", "✓",
        "Auth-gated routes with redirect.",
        "ProtectedRoute {\n    auth: use_auth().is_logged_in,\n    fallback: \"/login\",\n    element: AdminPanel {}\n}"
    ));

    append_child(container, grid);
    append_child(section, container);
    section
}

// === A11y Section ===

rite a11y_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "docs-section");
    set_attr(section, "id", "a11y");

    ≔ container = div_with_class("container");

    // Section header
    ≔ header = div_with_class("section-header");
    append_child(header, span("Accessibility", "section-eyebrow"));
    append_child(header, heading("h2", "A11y Built-In", "section-title"));
    append_child(header, para(
        "WCAG 2.1 compliant hooks and components for inclusive interfaces.",
        "section-lead"
    ));
    append_child(container, header);

    ≔ grid = div_with_class("component-grid");

    append_child(grid, component_card("use_announcer", "Screen Reader", "📢",
        "Announce messages to screen readers.",
        "≔ announce = use_announcer()\nannounce(\"Item added\", Politeness::Polite)"
    ));

    append_child(grid, component_card("use_focus_trap", "Focus", "◎",
        "Trap focus within modal/dialog containers.",
        "≔ trap_ref = use_focus_trap(FocusTrapOptions {\n    initial_focus: \"#first-input\"\n})"
    ));

    append_child(grid, component_card("use_keyboard_navigation", "Keyboard", "⌨",
        "Arrow key navigation for lists and menus.",
        "≔ nav = use_keyboard_navigation(KeyboardNavConfig {\n    orientation: Orientation::Vertical\n})"
    ));

    append_child(grid, component_card("use_reduced_motion", "Motion", "⚡",
        "Respect user's motion preferences.",
        "≔ prefers_reduced = use_reduced_motion()\n⎇ prefers_reduced { StaticIcon {} } ⎉ { AnimatedIcon {} }"
    ));

    append_child(grid, component_card("SkipLink", "Navigation", "⇥",
        "Skip to main content link for keyboard users.",
        "SkipLink { target: \"#main\", \"Skip to content\" }"
    ));

    append_child(grid, component_card("VisuallyHidden", "Screen Reader", "👁",
        "Hide content visually but keep for screen readers.",
        "VisuallyHidden { \"Opens in new window\" }"
    ));

    append_child(container, grid);
    append_child(section, container);
    section
}

// === Animation Section ===

rite animation_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "docs-section");
    set_attr(section, "id", "animation");

    ≔ container = div_with_class("container");

    // Section header
    ≔ header = div_with_class("section-header");
    append_child(header, span("Animation", "section-eyebrow"));
    append_child(header, heading("h2", "Motion Primitives", "section-title"));
    append_child(header, para(
        "Spring physics, keyframes, gestures, and transition components.",
        "section-lead"
    ));
    append_child(container, header);

    ≔ grid = div_with_class("component-grid");

    append_child(grid, component_card("use_spring", "Physics", "~",
        "Spring-based physics animations.",
        "≔ x = use_spring(0.0, SpringConfig::Bouncy)\nx.set(100.0) // Animates smoothly"
    ));

    append_child(grid, component_card("use_keyframes", "CSS", "▶",
        "CSS-style keyframe animations.",
        "≔ anim = use_keyframes([\n    Keyframe { offset: 0.0, opacity: 0.0 },\n    Keyframe { offset: 1.0, opacity: 1.0 }\n])"
    ));

    append_child(grid, component_card("Gesture Hooks", "Touch", "✋",
        "Pan, pinch, rotate, swipe, long-press detection.",
        "≔ pan = use_pan()\n≔ swipe = use_swipe(SwipeConfig { threshold: 50.0 })"
    ));

    append_child(grid, component_card("AnimatePresence", "Enter/Exit", "↔",
        "Animate components entering and leaving.",
        "AnimatePresence {\n    ⎇ show { Fade { Card { content } } }\n}"
    ));

    append_child(grid, component_card("Stagger", "List", "≡",
        "Staggered animations for list items.",
        "Stagger { delay: 50, children: items |τ{Card} }"
    ));

    append_child(grid, component_card("Transitions", "Built-in", "□",
        "Fade, Slide, Scale, Spin, Collapse components.",
        "Slide { direction: SlideDirection::Left, children }\nCollapse { open: expanded, children }"
    ));

    append_child(container, grid);
    append_child(section, container);
    section
}

// === Footer ===

rite footer() → i64 {
    ≔ f = create_element("footer");

    ≔ container = div_with_class("container");
    ≔ content = div_with_class("footer-content");

    ≔ links = div_with_class("footer-links");
    append_child(links, link("index.html", "Home", ""));
    append_child(links, link("docs.html", "Docs", ""));
    append_child(links, link("https://github.com/Daemoniorum-LLC/sigil-lang", "GitHub", ""));
    append_child(links, link("pattern.html", "The Pattern", ""));
    append_child(content, links);

    ≔ copy = div_with_class("footer-copy");
    ≔ ct = create_text("© 2025-2026 Daemoniorum LLC. MIT License.");
    append_child(copy, ct);
    append_child(content, copy);

    append_child(container, content);
    append_child(f, container);
    f
}

// === Main App ===

rite app() → i64 {
    ≔ root = create_element("div");
    set_class(root, "app");

    append_child(root, header());
    append_child(root, hero_section());
    append_child(root, overview_section());
    append_child(root, components_section());
    append_child(root, hooks_section());
    append_child(root, state_section());
    append_child(root, router_section());
    append_child(root, a11y_section());
    append_child(root, animation_section());
    append_child(root, footer());

    root
}

☉ rite main() → i64 {
    ≔ root = app();
    mount(root, "#app")
}
