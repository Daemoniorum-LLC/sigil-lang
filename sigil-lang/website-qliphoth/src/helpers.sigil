// Qliphoth Procedural Helpers
// Shared builder-style functions for WASM compilation
// These provide a cleaner API over raw VDOM FFI calls

// =============================================================================
// Core DOM Operations (wrap FFI calls)
// =============================================================================

rite create_element(tag: &str) → i64 {
    vdom_create_vnode(tag)
}

rite create_text(content: &str) → i64 {
    vdom_create_text_vnode(content)
}

rite set_class(element: i64, class_name: &str) {
    vdom_set_vnode_str_prop(element, "class", class_name)
}

rite add_class(element: i64, class_name: &str) {
    // Append class to existing (simplified - assumes no existing class)
    vdom_set_vnode_str_prop(element, "class", class_name)
}

rite set_attr(element: i64, name: &str, value: &str) {
    vdom_set_vnode_str_prop(element, name, value)
}

rite set_inner_html(element: i64, html: &str) {
    vdom_set_vnode_str_prop(element, "innerHTML", html)
}

rite append(parent: i64, child: i64) {
    vdom_append_vnode_child(parent, child)
}

rite mount(element: i64, selector: &str) → i64 {
    vdom_mount_vnode(element, selector)
}

// =============================================================================
// Builder-Style Element Helpers
// =============================================================================

// Basic element with class
rite h(tag: &str) → i64 {
    create_element(tag)
}

rite h_class(tag: &str, class: &str) → i64 {
    ≔ el = create_element(tag);
    set_class(el, class);
    el
}

// Element with text content
rite h_text(tag: &str, text: &str) → i64 {
    ≔ el = create_element(tag);
    append(el, create_text(text));
    el
}

// Element with class and text
rite h_class_text(tag: &str, class: &str, text: &str) → i64 {
    ≔ el = create_element(tag);
    set_class(el, class);
    append(el, create_text(text));
    el
}

// Element with id
rite h_id(tag: &str, id: &str) → i64 {
    ≔ el = create_element(tag);
    set_attr(el, "id", id);
    el
}

// Element with class and id
rite h_class_id(tag: &str, class: &str, id: &str) → i64 {
    ≔ el = create_element(tag);
    set_class(el, class);
    set_attr(el, "id", id);
    el
}

// =============================================================================
// Semantic Element Helpers
// =============================================================================

// Headings
rite h1(text: &str) → i64 { h_text("h1", text) }
rite h2(text: &str) → i64 { h_text("h2", text) }
rite h3(text: &str) → i64 { h_text("h3", text) }
rite h4(text: &str) → i64 { h_text("h4", text) }
rite h5(text: &str) → i64 { h_text("h5", text) }
rite h6(text: &str) → i64 { h_text("h6", text) }

rite h1_class(text: &str, class: &str) → i64 { h_class_text("h1", class, text) }
rite h2_class(text: &str, class: &str) → i64 { h_class_text("h2", class, text) }
rite h3_class(text: &str, class: &str) → i64 { h_class_text("h3", class, text) }
rite h4_class(text: &str, class: &str) → i64 { h_class_text("h4", class, text) }
rite h5_class(text: &str, class: &str) → i64 { h_class_text("h5", class, text) }
rite h6_class(text: &str, class: &str) → i64 { h_class_text("h6", class, text) }

// Heading with dynamic level
rite heading(level: &str, text: &str, class: &str) → i64 {
    ≔ el = create_element(level);
    set_class(el, class);
    append(el, create_text(text));
    el
}

// Paragraph
rite p(text: &str) → i64 { h_text("p", text) }
rite p_class(text: &str, class: &str) → i64 { h_class_text("p", class, text) }
rite para(text: &str, class: &str) → i64 { h_class_text("p", class, text) }

// Span
rite span(text: &str) → i64 { h_text("span", text) }
rite span_class(text: &str, class: &str) → i64 { h_class_text("span", class, text) }

// Div containers
rite div() → i64 { create_element("div") }
rite div_class(class: &str) → i64 { h_class("div", class) }
rite div_id(id: &str) → i64 { h_id("div", id) }
rite div_class_id(class: &str, id: &str) → i64 { h_class_id("div", class, id) }

// Section containers
rite section(id: &str) → i64 { h_id("section", id) }
rite section_class(class: &str) → i64 { h_class("section", class) }
rite section_class_id(class: &str, id: &str) → i64 { h_class_id("section", class, id) }

// Article
rite article() → i64 { create_element("article") }
rite article_class(class: &str) → i64 { h_class("article", class) }

// Nav
rite nav() → i64 { create_element("nav") }
rite nav_class(class: &str) → i64 { h_class("nav", class) }

// Header/Footer
rite header() → i64 { create_element("header") }
rite header_class(class: &str) → i64 { h_class("header", class) }
rite footer() → i64 { create_element("footer") }
rite footer_class(class: &str) → i64 { h_class("footer", class) }

// =============================================================================
// Link Helpers
// =============================================================================

rite link(href: &str, text: &str, class: &str) → i64 {
    ≔ a = create_element("a");
    set_class(a, class);
    set_attr(a, "href", href);
    append(a, create_text(text));
    a
}

rite link_external(href: &str, text: &str, class: &str) → i64 {
    ≔ a = create_element("a");
    set_class(a, class);
    set_attr(a, "href", href);
    set_attr(a, "target", "_blank");
    set_attr(a, "rel", "noopener noreferrer");
    append(a, create_text(text));
    a
}

rite link_aria(href: &str, text: &str, class: &str, aria_label: &str) → i64 {
    ≔ a = link(href, text, class);
    set_attr(a, "aria-label", aria_label);
    a
}

// =============================================================================
// Button Helpers
// =============================================================================

rite btn(text: &str, class: &str) → i64 {
    ≔ b = create_element("button");
    set_class(b, class);
    set_attr(b, "type", "button");
    append(b, create_text(text));
    b
}

rite btn_submit(text: &str, class: &str) → i64 {
    ≔ b = create_element("button");
    set_class(b, class);
    set_attr(b, "type", "submit");
    append(b, create_text(text));
    b
}

// =============================================================================
// Image Helpers
// =============================================================================

rite img(src: &str, alt: &str) → i64 {
    ≔ i = create_element("img");
    set_attr(i, "src", src);
    set_attr(i, "alt", alt);
    i
}

rite img_class(src: &str, alt: &str, class: &str) → i64 {
    ≔ i = img(src, alt);
    set_class(i, class);
    i
}

rite img_size(src: &str, alt: &str, width: &str, height: &str) → i64 {
    ≔ i = img(src, alt);
    set_attr(i, "width", width);
    set_attr(i, "height", height);
    i
}

// =============================================================================
// Code Block Helpers
// =============================================================================

rite code(text: &str) → i64 {
    ≔ c = create_element("code");
    append(c, create_text(text));
    c
}

rite code_class(text: &str, class: &str) → i64 {
    ≔ c = code(text);
    set_class(c, class);
    c
}

rite code_inline(text: &str) → i64 {
    code_class(text, "inline-code")
}

rite code_block(code_text: &str) → i64 {
    ≔ pre = create_element("pre");
    set_class(pre, "code-block");
    append(pre, create_text(code_text));
    pre
}

rite code_block_class(code_text: &str, class: &str) → i64 {
    ≔ pre = create_element("pre");
    set_class(pre, "code-block " ++ class);
    append(pre, create_text(code_text));
    pre
}

rite code_block_html(html: &str) → i64 {
    ≔ pre = create_element("pre");
    set_class(pre, "code-block");
    ≔ c = create_element("code");
    set_inner_html(c, html);
    append(pre, c);
    pre
}

rite code_block_html_class(html: &str, class: &str) → i64 {
    ≔ pre = create_element("pre");
    set_class(pre, "code-block " ++ class);
    ≔ c = create_element("code");
    set_inner_html(c, html);
    append(pre, c);
    pre
}

// =============================================================================
// List Helpers
// =============================================================================

rite ul() → i64 { create_element("ul") }
rite ul_class(class: &str) → i64 { h_class("ul", class) }
rite ol() → i64 { create_element("ol") }
rite ol_class(class: &str) → i64 { h_class("ol", class) }
rite li(text: &str) → i64 { h_text("li", text) }
rite li_class(text: &str, class: &str) → i64 { h_class_text("li", class, text) }

// =============================================================================
// Form Helpers
// =============================================================================

rite input_text(name: &str, placeholder: &str) → i64 {
    ≔ i = create_element("input");
    set_attr(i, "type", "text");
    set_attr(i, "name", name);
    set_attr(i, "placeholder", placeholder);
    i
}

rite input_email(name: &str, placeholder: &str) → i64 {
    ≔ i = create_element("input");
    set_attr(i, "type", "email");
    set_attr(i, "name", name);
    set_attr(i, "placeholder", placeholder);
    i
}

rite label(for_id: &str, text: &str) → i64 {
    ≔ l = create_element("label");
    set_attr(l, "for", for_id);
    append(l, create_text(text));
    l
}

// =============================================================================
// Accessibility Helpers
// =============================================================================

rite aria_label(element: i64, label: &str) → i64 {
    set_attr(element, "aria-label", label);
    element
}

rite aria_hidden(element: i64) → i64 {
    set_attr(element, "aria-hidden", "true");
    element
}

rite role(element: i64, role_name: &str) → i64 {
    set_attr(element, "role", role_name);
    element
}

// =============================================================================
// Layout Composition Helpers
// =============================================================================

// Section with container
rite Section(id: &str, extra_class: &str) → i64 {
    ≔ sec = create_element("section");
    set_class(sec, "section " ++ extra_class);
    set_attr(sec, "id", id);
    ≔ container = div_class("container");
    append(sec, container);
    container  // Return container for appending children
}

// Section header with title and subtitle
rite SectionHeader(title: &str, subtitle: &str) → i64 {
    ≔ hdr = div_class("section-header");
    append(hdr, h2(title));
    append(hdr, p(subtitle));
    hdr
}

// Card with title and description
rite Card(class: &str, title: &str, description: &str) → i64 {
    ≔ card = div_class(class);
    append(card, h3(title));
    append(card, p(description));
    card
}

// Card with link
rite CardWithLink(class: &str, title: &str, description: &str, href: &str, link_text: &str) → i64 {
    ≔ card = Card(class, title, description);
    append(card, link(href, link_text, "card-link"));
    card
}

// =============================================================================
// Additional Semantic Elements
// =============================================================================

// Main
rite main_el() → i64 { create_element("main") }
rite main_class(class: &str) → i64 { h_class("main", class) }

// Aside
rite aside() → i64 { create_element("aside") }
rite aside_class(class: &str) → i64 { h_class("aside", class) }

// Blockquote
rite blockquote(text: &str) → i64 { h_text("blockquote", text) }
rite blockquote_class(text: &str, class: &str) → i64 { h_class_text("blockquote", class, text) }

// Table-like structures (div-based)
rite table_row(class: &str) → i64 { div_class(class) }
rite table_cell(class: &str, text: &str) → i64 { h_class_text("div", class, text) }

// Version badge
rite version_badge(version: &str) → i64 { span_class(version, "version-badge") }
