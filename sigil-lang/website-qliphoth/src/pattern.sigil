    append_child(header, heading("h2", "Ubuntu: I Am Because We Are", "section-title"));
    append_child(section, header);

    append_child(section, para(
        "The Anima layer models agents as fundamentally relational—not isolated units processing data, but entities that exist in relationship.",
        ""
    ));

    ≔ list = create_element("ul");
    set_class(list, "pattern-list");
    ≔ u1 = create_element("li");
