rite section_affect() → i64 {
    ≔ section = create_element("section");
    set_class(section, "pattern-section");
    set_attr(section, "id", "affect");

    ≔ header = create_element("div");
    set_class(header, "section-header-with-icon");
    ≔ icon = span("♡", "section-icon");
    append_child(header, icon);
    append_child(header, heading("h2", "Affect as First-Class Data", "section-title"));
    append_child(section, header);

    append_child(section, para(
        "Sigil doesn't just process data. It processes how data feels.",
        "emphasis-text"
    ));

    append_child(section, code_block(
        "// Affective markers in the type system\n" ++
        "≔ good_news = positive(\"Revenue is up 40%!\")\n" ++
        "≔ bad_news = negative(\"Server crashed at 3am\")\n\n" ++
        "// Sarcasm: ⸮ (the percontation point, invented 1580)\n" ++
        "≔ sarcastic_comment = sarcastic(\"Oh great, another meeting\")\n\n" ++
        "// Intensity: ↑ (up), ↓ (down), ⇈ (max)\n" ++
        "≔ emphasized = intensify(\"This is important\")\n" ++
        "≔ extreme = maximize(\"CRITICAL EMERGENCY!\")\n\n" ++
        "// Formality: ♔ (formal), ♟ (informal)\n" ++
        "≔ formal_msg = formal(\"Dear Sir or Madam...\")\n" ++
        "≔ casual = informal(\"hey whats up lol\")"
    ));

    append_child(section, para(
        "The system also models inner truth (本音 honne) versus expressed stance (建前 tatemae):",
        ""
    ));

    append_child(section, code_block(
        "pub struct Expression {\n" ++
        "    pub honne: InnerState,       // What I actually feel\n" ++
        "    pub tatemae: ExpressedStance, // What I express\n" ++
        "    pub openness: Openness,      // How negotiable this is\n" ++
        "    pub context: RelationalContext, // Who I'm talking to\n" ++
        "}"
    ));

    append_child(section, insight_box("Data has emotional valence. Types should track it. Systems should respect it."));

    section
}

rite section_temporal() → i64 {
    ≔ section = create_element("section");
    set_class(section, "pattern-section");
    set_attr(section, "id", "temporal");

    ≔ header = create_element("div");
    set_class(header, "section-header-with-icon");
    ≔ icon = span("⟲", "section-icon");
    append_child(header, icon);
    append_child(header, heading("h2", "Cyclical Mathematics", "section-title"));
    append_child(section, header);

    append_child(section, para(
        "Time isn't always linear. Sigil treats multiple temporal models as first-class:",
        ""
    ));

    append_child(section, code_block(
        "// Cyclical time (wrapping arithmetic)\n" ++
        "type MayanTzolkin = Cycle<260>      // Sacred calendar\n" ++
        "type ChineseStem = Cycle<10>        // Heavenly stems\n" ++
        "type ChineseBranch = Cycle<12>      // Earthly branches\n\n" ++
        "// An event can be queried in any temporal frame\n" ++
        "event|time·linear     // \"2024-09-21T14:00:00Z\"\n" ++
        "event|time·mayan      // \"13.0.11.14.5, 8 Chikchan\"\n" ++
        "event|time·chinese    // \"甲辰年八月十九\"\n" ++
        "event|time·seasonal   // Autumn.mid\n" ++
        "event|time·lunar      // WaxingGibbous(0.82)"
    ));

    append_child(section, para(
        "This matters because not all cultures use Gregorian linear time. A system that only understands linear timestamps cannot correctly model \"the third full moon after harvest.\"",
        ""
    ));

    append_child(section, insight_box("Linear time is one valid model among many. Different temporal frames reveal different patterns."));

    section
}

rite section_metaprogramming() → i64 {
    ≔ section = create_element("section");
    set_class(section, "pattern-section");
    set_attr(section, "id", "metaprogramming");

    ≔ header = create_element("div");
    set_class(header, "section-header-with-icon");
    ≔ icon = span("⛤", "section-icon");
    append_child(header, icon);
    append_child(header, heading("h2", "Metaprogramming as Magic", "section-title"));
    append_child(section, header);

    append_child(section, para(
        "Code that writes code deserves reverence. Sigil frames metaprogramming through symbolic power:",
        ""
    ));

    ≔ list = create_element("ul");
    set_class(list, "pattern-list magic-list");
    ≔ m1 = create_element("li");
    append_child(m1, create_text("Runes — declarative macros (pattern-based transformation)"));
    append_child(list, m1);
    ≔ m2 = create_element("li");
    append_child(m2, create_text("Wards — compile-time protection and constraints"));
    append_child(list, m2);
    ≔ m3 = create_element("li");
    append_child(m3, create_text("Glyphs — compile-time value computation"));
    append_child(list, m3);
    ≔ m4 = create_element("li");
    append_child(m4, create_text("Grimoire — the central registry of incantations"));
    append_child(list, m4);
    append_child(section, list);

    append_child(section, para(
        "To name a thing is to have power over it. To write a Rune is to reshape reality.",
        "emphasis-text"
    ));

    append_child(section, insight_box("Metaprogramming vocabulary should evoke the transformative power of what it does."));

    section
}

rite section_ubuntu() → i64 {
    ≔ section = create_element("section");
    set_class(section, "pattern-section");
    set_attr(section, "id", "ubuntu");

    ≔ header = create_element("div");
    set_class(header, "section-header-with-icon");
    ≔ icon = span("☍", "section-icon");
