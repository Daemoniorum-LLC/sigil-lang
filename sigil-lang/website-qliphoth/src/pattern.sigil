    append_child(header, icon);
    append_child(header, heading("h2", "Cultural Pluralism", "section-title"));
    append_child(section, header);

    append_child(section, para(
        "Sigil acknowledges that Western computing assumptions aren't universal:",
        ""
    ));

    // Cultural table
    ≔ table = create_element("div");
    set_class(table, "pattern-table cultural-table");
    append_child(table, cultural_row("Polycultural Mathematics", "Mayan vigesimal, Babylonian sexagesimal"));
    append_child(table, cultural_row("World Music", "22-Shruti, Arabic maqam, Gamelan"));
