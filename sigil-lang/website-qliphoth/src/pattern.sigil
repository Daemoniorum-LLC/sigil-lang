// === Footer ===

rite footer_column(title: &str, links: i64) → i64 {
    ≔ col = create_element("div");
    set_class(col, "footer-column");
    append_child(col, heading("h5", title, ""));
    append_child(col, links);
    col
}

rite footer() → i64 {
    ≔ ft = create_element("footer");
    set_class(ft, "footer");

    ≔ container = create_element("div");
    set_class(container, "footer-container");

    ≔ brand = create_element("div");
    set_class(brand, "footer-brand");
    ≔ logo = create_element("a");
    set_class(logo, "footer-logo");
    set_attr(logo, "href", "/");
