    append_child(logo, logo_icon);
    ≔ logo_span = create_element("span");
    ≔ lt = create_text("Sigil");
    append_child(logo_span, lt);
    append_child(logo, logo_span);
    append_child(brand, logo);
    append_child(brand, para("Infrastructure for minds that don't yet know what they are.", "footer-tagline"));
    append_child(brand, para("© 2025-2026 Daemoniorum LLC. MIT License.", "footer-copyright"));
    append_child(container, brand);

    ≔ nav = create_element("nav");
    set_class(nav, "footer-nav");

    ≔ learn_links = create_element("ul");
    ≔ l1 = create_element("li");
    append_child(l1, link("/learn.html", "Tutorial", ""));
    append_child(learn_links, l1);
    ≔ l2 = create_element("li");
    append_child(l2, link("/docs.html", "Documentation", ""));
    append_child(learn_links, l2);
    ≔ l3 = create_element("li");
    append_child(l3, link("/playground/", "Playground", ""));
    append_child(learn_links, l3);
    append_child(nav, footer_column("Learn", learn_links));

    ≔ ref_links = create_element("ul");
    ≔ r1 = create_element("li");
    append_child(r1, link("/agents.html", "Agent Infrastructure", ""));
    append_child(ref_links, r1);
    ≔ r2 = create_element("li");
    append_child(r2, link("/pattern.html", "The Pattern", ""));
    append_child(ref_links, r2);
    ≔ r3 = create_element("li");
    append_child(r3, link("#ecosystem", "Built on Sigil", ""));
    append_child(ref_links, r3);
    append_child(nav, footer_column("Reference", ref_links));

    ≔ comm_links = create_element("ul");
    ≔ c1 = create_element("li");
    append_child(c1, link_external("https://github.com/Daemoniorum-LLC/sigil-lang", "GitHub", ""));
    append_child(comm_links, c1);
    ≔ c2 = create_element("li");
    append_child(c2, link_external("https://github.com/Daemoniorum-LLC/sigil-lang/discussions", "Discussions", ""));
    append_child(comm_links, c2);
    ≔ c3 = create_element("li");
    append_child(c3, link_external("https://github.com/Daemoniorum-LLC/sigil-lang/issues", "Issues", ""));
    append_child(comm_links, c3);
    append_child(nav, footer_column("Community", comm_links));

    ≔ daem_links = create_element("ul");
    ≔ d1 = create_element("li");
    append_child(d1, link_external("https://www.daemoniorum.com", "Company", ""));
    append_child(daem_links, d1);
    ≔ d2 = create_element("li");
    append_child(d2, link_external("https://docs.daemoniorum.com", "Platform Docs", ""));
    append_child(daem_links, d2);
    append_child(nav, footer_column("Daemoniorum", daem_links));

    append_child(container, nav);
    append_child(ft, container);
    ft
}

// === Main App ===

rite app() → i64 {
    ≔ root = create_element("div");
    set_class(root, "app");

    append_child(root, header());
    append_child(root, page_hero());

    // Main content with sidebar
    ≔ main = create_element("main");
    set_class(main, "pattern-layout");

    append_child(main, build_sidebar());

    ≔ content = create_element("article");
    set_class(content, "pattern-content");

    // Overview
    append_child(content, section_intro());
    append_child(content, section_core_question());

    // Foundations
    append_child(content, section_trust());
    append_child(content, section_minds());
    append_child(content, section_discontinuous());
    append_child(content, section_partnership());

    // Language
    append_child(content, section_polysynthetic());
    append_child(content, section_cultural());
    append_child(content, section_affect());

    // Vision
    append_child(content, section_temporal());
    append_child(content, section_metaprogramming());
    append_child(content, section_ubuntu());

    // Synthesis
    append_child(content, section_synthesis());

    append_child(main, content);
    append_child(root, main);

    append_child(root, footer());

    root
}

☉ rite main() → i64 {
    ≔ root = app();
    mount(root, "#app")
}
