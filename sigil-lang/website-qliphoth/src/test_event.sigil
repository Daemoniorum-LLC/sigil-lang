// Test file for function references / event handlers

rite create_element(tag: &str) → i64 {
    vdom_create_vnode(tag)
}

rite create_text(content: &str) → i64 {
    vdom_create_text_vnode(content)
}

rite set_class(element: i64, class_name: &str) {
    vdom_set_vnode_str_prop(element, "class", class_name)
}

rite set_prop(element: i64, name: &str, value: i64) {
    vdom_set_vnode_prop(element, name, value)
}

rite append_child(parent: i64, child: i64) {
    vdom_append_vnode_child(parent, child)
}

rite mount(element: i64, selector: &str) → i64 {
    vdom_mount_vnode(element, selector)
}

// Event handler function - will be called when button is clicked
rite handle_click() {
    console_log_i64(999)
}

☉ rite main() → i64 {
    console_log_i64(1);

    ≔ root = create_element("div");
    set_class(root, "app");

    ≔ btn = create_element("button");
    ≔ btn_text = create_text("Click me!");
    append_child(btn, btn_text);

    // Set onclick prop with function reference - vdom renderer handles it
    set_prop(btn, "onclick", handle_click);

    append_child(root, btn);

    mount(root, "#app")
}
