// rt/math/mod.sg - Math Functions
//
// Mathematical functions using LLVM intrinsics.
// These map directly to LLVM's math intrinsics for optimal codegen.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md#module-5-math
// @evidentiality docs/specs/EVIDENTIALITY-RULES.md

// ============================================================================
// Basic Operations (f64)
// ============================================================================

/// Absolute value
///
/// Returns Known (!) - pure computation
#[inline]
pub fn abs(x: f64) -> f64! {
    __llvm_fabs_f64(x)
}

/// Floor (round toward negative infinity)
#[inline]
pub fn floor(x: f64) -> f64! {
    __llvm_floor_f64(x)
}

/// Ceiling (round toward positive infinity)
#[inline]
pub fn ceil(x: f64) -> f64! {
    __llvm_ceil_f64(x)
}

/// Round to nearest integer
#[inline]
pub fn round(x: f64) -> f64! {
    __llvm_round_f64(x)
}

/// Truncate toward zero
#[inline]
pub fn trunc(x: f64) -> f64! {
    __llvm_trunc_f64(x)
}

// ============================================================================
// Exponential / Logarithmic
// ============================================================================

/// Square root
#[inline]
pub fn sqrt(x: f64) -> f64! {
    __llvm_sqrt_f64(x)
}

/// e^x (exponential)
#[inline]
pub fn exp(x: f64) -> f64! {
    __llvm_exp_f64(x)
}

/// 2^x
#[inline]
pub fn exp2(x: f64) -> f64! {
    __llvm_exp2_f64(x)
}

/// Natural logarithm (ln)
#[inline]
pub fn ln(x: f64) -> f64! {
    __llvm_log_f64(x)
}

/// Base-2 logarithm
#[inline]
pub fn log2(x: f64) -> f64! {
    __llvm_log2_f64(x)
}

/// Base-10 logarithm
#[inline]
pub fn log10(x: f64) -> f64! {
    __llvm_log10_f64(x)
}

/// Power: x^y
#[inline]
pub fn pow(x: f64, y: f64) -> f64! {
    __llvm_pow_f64(x, y)
}

// ============================================================================
// Trigonometric
// ============================================================================

/// Sine
#[inline]
pub fn sin(x: f64) -> f64! {
    __llvm_sin_f64(x)
}

/// Cosine
#[inline]
pub fn cos(x: f64) -> f64! {
    __llvm_cos_f64(x)
}

/// Tangent
#[inline]
pub fn tan(x: f64) -> f64! {
    sin(x) / cos(x)
}

/// Arc sine
#[inline]
pub fn asin(x: f64) -> f64! {
    __libm_asin(x)
}

/// Arc cosine
#[inline]
pub fn acos(x: f64) -> f64! {
    __libm_acos(x)
}

/// Arc tangent
#[inline]
pub fn atan(x: f64) -> f64! {
    __libm_atan(x)
}

/// Two-argument arc tangent
#[inline]
pub fn atan2(y: f64, x: f64) -> f64! {
    __libm_atan2(y, x)
}

// ============================================================================
// Hyperbolic
// ============================================================================

/// Hyperbolic sine
#[inline]
pub fn sinh(x: f64) -> f64! {
    (exp(x) - exp(0.0 - x)) / 2.0
}

/// Hyperbolic cosine
#[inline]
pub fn cosh(x: f64) -> f64! {
    (exp(x) + exp(0.0 - x)) / 2.0
}

/// Hyperbolic tangent
#[inline]
pub fn tanh(x: f64) -> f64! {
    sinh(x) / cosh(x)
}

// ============================================================================
// Utility
// ============================================================================

/// Minimum of two values
#[inline]
pub fn min(a: f64, b: f64) -> f64! {
    __llvm_minnum_f64(a, b)
}

/// Maximum of two values
#[inline]
pub fn max(a: f64, b: f64) -> f64! {
    __llvm_maxnum_f64(a, b)
}

/// Fused multiply-add: a*b + c
#[inline]
pub fn fma(a: f64, b: f64, c: f64) -> f64! {
    __llvm_fma_f64(a, b, c)
}

/// Copy sign: |x| with sign of y
#[inline]
pub fn copysign(x: f64, y: f64) -> f64! {
    __llvm_copysign_f64(x, y)
}

// ============================================================================
// Integer Math
// ============================================================================

/// Absolute value (i64)
#[inline]
pub fn abs_i64(x: i64) -> i64! {
    if x < 0 { 0 - x } else { x }
}

/// Minimum (i64)
#[inline]
pub fn min_i64(a: i64, b: i64) -> i64! {
    if a < b { a } else { b }
}

/// Maximum (i64)
#[inline]
pub fn max_i64(a: i64, b: i64) -> i64! {
    if a > b { a } else { b }
}

/// Clamp value to range
#[inline]
pub fn clamp_i64(x: i64, min_val: i64, max_val: i64) -> i64! {
    if x < min_val {
        min_val
    } else if x > max_val {
        max_val
    } else {
        x
    }
}

// ============================================================================
// Constants
// ============================================================================

/// π (pi)
pub const PI: f64 = 3.14159265358979323846;

/// e (Euler's number)
pub const E: f64 = 2.71828182845904523536;

/// τ (tau = 2π)
pub const TAU: f64 = 6.28318530717958647692;

/// √2
pub const SQRT_2: f64 = 1.41421356237309504880;

/// ln(2)
pub const LN_2: f64 = 0.69314718055994530941;

/// ln(10)
pub const LN_10: f64 = 2.30258509299404568402;
