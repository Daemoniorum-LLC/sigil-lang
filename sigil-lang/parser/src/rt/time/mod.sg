// rt/time/mod.sg - Time Functions
//
// Time-related operations using platform syscalls.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md#module-6-time
// @evidentiality docs/specs/EVIDENTIALITY-RULES.md

use crate·rt·sys·{clock_gettime, Errno};

// ============================================================================
// Time Types
// ============================================================================

/// Time specification (seconds + nanoseconds)
pub struct Timespec {
    /// Seconds since epoch
    pub tv_sec: i64,
    /// Nanoseconds (0-999999999)
    pub tv_nsec: i64,
}

impl Timespec {
    /// Create zero timespec
    pub fn zero() -> Self! {
        Timespec { tv_sec: 0, tv_nsec: 0 }
    }

    /// Convert to milliseconds
    pub fn as_millis(&self) -> i64! {
        self.tv_sec * 1000 + self.tv_nsec / 1000000
    }

    /// Convert to microseconds
    pub fn as_micros(&self) -> i64! {
        self.tv_sec * 1000000 + self.tv_nsec / 1000
    }

    /// Convert to nanoseconds
    pub fn as_nanos(&self) -> i64! {
        self.tv_sec * 1000000000 + self.tv_nsec
    }

    /// Convert to f64 seconds
    pub fn as_secs_f64(&self) -> f64! {
        self.tv_sec as f64 + (self.tv_nsec as f64 / 1000000000.0)
    }
}

// ============================================================================
// Clock Types
// ============================================================================

/// Clock IDs for clock_gettime
pub const CLOCK_REALTIME: i32 = 0;
pub const CLOCK_MONOTONIC: i32 = 1;
pub const CLOCK_PROCESS_CPUTIME: i32 = 2;
pub const CLOCK_THREAD_CPUTIME: i32 = 3;

// ============================================================================
// Time Functions
// ============================================================================

/// Get current time (realtime clock)
///
/// Returns Reported (~) - time comes from kernel
pub fn now() -> Result<Timespec, Errno>~ {
    let mut ts = Timespec·zero();
    match clock_gettime(CLOCK_REALTIME, &mut ts) {
        Ok(_) => Ok(ts),
        Err(e) => Err(e),
    }
}

/// Get monotonic time (for measuring durations)
///
/// Returns Reported (~) - time comes from kernel
pub fn monotonic() -> Result<Timespec, Errno>~ {
    let mut ts = Timespec·zero();
    match clock_gettime(CLOCK_MONOTONIC, &mut ts) {
        Ok(_) => Ok(ts),
        Err(e) => Err(e),
    }
}

/// Get Unix timestamp (seconds since epoch)
///
/// Returns Reported (~) - time comes from kernel
pub fn unix_timestamp() -> i64~ {
    match now() {
        Ok(ts) => ts.tv_sec,
        Err(_) => 0,  // Fallback to 0 on error
    }
}

/// Get current time in milliseconds since epoch
pub fn millis() -> i64~ {
    match now() {
        Ok(ts) => ts.as_millis(),
        Err(_) => 0,
    }
}

/// Get current time in microseconds since epoch
pub fn micros() -> i64~ {
    match now() {
        Ok(ts) => ts.as_micros(),
        Err(_) => 0,
    }
}

/// Get current time in nanoseconds since epoch
pub fn nanos() -> i64~ {
    match now() {
        Ok(ts) => ts.as_nanos(),
        Err(_) => 0,
    }
}

// ============================================================================
// Duration Type
// ============================================================================

/// Duration (positive time span)
pub struct Duration {
    /// Total nanoseconds
    nanos: u64,
}

impl Duration {
    /// Create duration from seconds
    pub fn from_secs(secs: u64) -> Self! {
        Duration { nanos: secs * 1000000000 }
    }

    /// Create duration from milliseconds
    pub fn from_millis(millis: u64) -> Self! {
        Duration { nanos: millis * 1000000 }
    }

    /// Create duration from microseconds
    pub fn from_micros(micros: u64) -> Self! {
        Duration { nanos: micros * 1000 }
    }

    /// Create duration from nanoseconds
    pub fn from_nanos(nanos: u64) -> Self! {
        Duration { nanos: nanos }
    }

    /// Get as seconds (truncated)
    pub fn as_secs(&self) -> u64! {
        self.nanos / 1000000000
    }

    /// Get as milliseconds
    pub fn as_millis(&self) -> u64! {
        self.nanos / 1000000
    }

    /// Get as microseconds
    pub fn as_micros(&self) -> u64! {
        self.nanos / 1000
    }

    /// Get as nanoseconds
    pub fn as_nanos(&self) -> u64! {
        self.nanos
    }

    /// Get as f64 seconds
    pub fn as_secs_f64(&self) -> f64! {
        self.nanos as f64 / 1000000000.0
    }

    /// Check if duration is zero
    pub fn is_zero(&self) -> bool! {
        self.nanos == 0
    }
}

// ============================================================================
// Instant (for measuring elapsed time)
// ============================================================================

/// Instant in monotonic time (for measuring elapsed time)
pub struct Instant {
    ts: Timespec,
}

impl Instant {
    /// Capture current instant
    ///
    /// Returns Reported (~) - time from kernel
    pub fn now() -> Instant~ {
        match monotonic() {
            Ok(ts) => Instant { ts: ts },
            Err(_) => Instant { ts: Timespec·zero() },
        }
    }

    /// Calculate elapsed time since this instant
    pub fn elapsed(&self) -> Duration~ {
        match monotonic() {
            Ok(now_ts) => {
                let diff_sec = now_ts.tv_sec - self.ts.tv_sec;
                let diff_nsec = now_ts.tv_nsec - self.ts.tv_nsec;
                let total_nanos = diff_sec * 1000000000 + diff_nsec;
                if total_nanos < 0 {
                    Duration·from_nanos(0)
                } else {
                    Duration·from_nanos(total_nanos as u64)
                }
            },
            Err(_) => Duration·from_nanos(0),
        }
    }
}
