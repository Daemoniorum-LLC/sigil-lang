// rt/mod.sg - Sigil Native Runtime
//
// Pure Sigil runtime with zero C dependencies.
// Provides syscall wrappers, memory allocation, core types, and I/O.
//
// Architecture:
//   User Program
//       ↓
//   rt·types (Vec, String, Option, Result)
//       ↓
//   rt·alloc (Arena, Global Allocator)
//       ↓
//   rt·sys (Platform Syscalls)
//       ↓
//   Kernel

/// Platform syscall layer
pub mod sys;

/// Memory allocation
pub mod alloc;

/// Core types (Vec, String)
pub mod types;

/// I/O operations (print, file)
pub mod io;

/// Math functions (LLVM intrinsics)
pub mod math;

/// Time functions
pub mod time;

/// Initialize the native runtime
/// Must be called before using any runtime functions
pub fn init() {
    alloc·init_allocator();
}
