// rt/io/mod.sg - I/O Module
//
// Standard I/O operations: stdout, stderr, file operations.
// Built directly on platform syscalls.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md#module-4-io
// @evidentiality docs/specs/EVIDENTIALITY-RULES.md

use crate·rt·sys·{write, read, open, close, Errno};
use crate·rt·types·String;

// ============================================================================
// File Descriptors
// ============================================================================

/// Standard file descriptor constants
pub const STDIN: i32 = 0;
pub const STDOUT: i32 = 1;
pub const STDERR: i32 = 2;

// ============================================================================
// Print Functions
// ============================================================================

/// Print string to stdout (no newline)
///
/// Evidentiality: Returns ~ because syscall may fail
pub fn print(s: &str) {
    let _ = write(STDOUT, s.as_bytes());
}

/// Print string to stdout with newline
pub fn println(s: &str) {
    let _ = write(STDOUT, s.as_bytes());
    let _ = write(STDOUT, "\n".as_bytes());
}

/// Print to stderr (no newline)
pub fn eprint(s: &str) {
    let _ = write(STDERR, s.as_bytes());
}

/// Print to stderr with newline
pub fn eprintln(s: &str) {
    let _ = write(STDERR, s.as_bytes());
    let _ = write(STDERR, "\n".as_bytes());
}

// ============================================================================
// Integer/Float Printing
// ============================================================================

/// Print i64 to stdout
pub fn print_int(val: i64) {
    let mut buf: [u8; 21] = [0; 21];  // Max i64 is 20 digits + sign
    let s = i64_to_str(val, &mut buf);
    print(s);
}

/// Print i64 to stdout with newline
pub fn println_int(val: i64) {
    let mut buf: [u8; 21] = [0; 21];
    let s = i64_to_str(val, &mut buf);
    println(s);
}

/// Convert i64 to string in buffer, returns &str
fn i64_to_str(val: i64, buf: &mut [u8]) -> &str! {
    // Handle zero case
    if val == 0 {
        buf[0] = 48;  // '0'
        return unsafe { str_from_raw(buf.as_ptr(), 1) };
    }

    let mut n = val;
    let negative = n < 0;
    if negative {
        n = 0 - n;  // Make positive
    }

    // Fill buffer from end
    let mut i: u64 = 20;
    while n > 0 {
        let digit = (n % 10) as u8;
        buf[i] = 48 + digit;  // '0' + digit
        n = n / 10;
        i = i - 1;
    }

    // Add negative sign
    if negative {
        buf[i] = 45;  // '-'
        i = i - 1;
    }

    // Return slice from i+1 to end
    let start = i + 1;
    let len = 21 - start;
    unsafe { str_from_raw(buf.as_ptr().add(start as usize), len) }
}

// ============================================================================
// File Mode
// ============================================================================

/// File open modes
pub enum FileMode {
    /// Read only
    Read,
    /// Write only (create if not exists, truncate if exists)
    Write,
    /// Append (create if not exists)
    Append,
    /// Read and write
    ReadWrite,
}

impl FileMode {
    /// Convert to POSIX open flags
    pub fn to_flags(&self) -> i32! {
        match self {
            FileMode·Read => 0,           // O_RDONLY
            FileMode·Write => 577,        // O_WRONLY | O_CREAT | O_TRUNC
            FileMode·Append => 1089,      // O_WRONLY | O_CREAT | O_APPEND
            FileMode·ReadWrite => 2,      // O_RDWR
        }
    }
}

// ============================================================================
// File Type
// ============================================================================

/// File handle wrapper
pub struct File {
    /// File descriptor
    fd: i32,
    /// Whether file is open
    is_open: bool,
}

impl File {
    /// Create new file (write mode, truncate if exists)
    ///
    /// Returns Reported (~) - syscall may fail
    pub fn create(path: &str) -> Result<File, Errno>~ {
        let flags = 577;  // O_WRONLY | O_CREAT | O_TRUNC
        let mode = 420;   // 0644 in octal

        match open(path.as_ptr() as *const u8, flags, mode) {
            Ok(fd) => Ok(File { fd: fd as i32, is_open: true }),
            Err(e) => Err(e),
        }
    }

    /// Open existing file with mode
    ///
    /// Returns Reported (~) - file contents are external
    pub fn open(path: &str, mode: FileMode) -> Result<File, Errno>~ {
        let flags = mode.to_flags();
        let file_mode = if flags & 64 != 0 { 420 } else { 0 };  // O_CREAT check

        match open(path.as_ptr() as *const u8, flags, file_mode) {
            Ok(fd) => Ok(File { fd: fd as i32, is_open: true }),
            Err(e) => Err(e),
        }
    }

    /// Write bytes to file
    ///
    /// Returns number of bytes written
    pub fn write(&mut self, data: &str) -> Result<u64, Errno>~ {
        if !self.is_open {
            return Err(Errno·EBADF);
        }
        write(self.fd, data.as_bytes())
    }

    /// Write byte slice to file
    pub fn write_bytes(&mut self, data: &[u8]) -> Result<u64, Errno>~ {
        if !self.is_open {
            return Err(Errno·EBADF);
        }
        write(self.fd, data)
    }

    /// Read bytes from file into buffer
    ///
    /// Returns number of bytes read
    /// Data is Reported (~) - comes from file
    pub fn read(&mut self, buf: &mut [u8]) -> Result<u64, Errno>~ {
        if !self.is_open {
            return Err(Errno·EBADF);
        }
        read(self.fd, buf)
    }

    /// Close file
    pub fn close(&mut self) {
        if self.is_open {
            let _ = close(self.fd);
            self.is_open = false;
        }
    }

    /// Get file descriptor
    pub fn fd(&self) -> i32! {
        self.fd
    }

    /// Check if file is open
    pub fn is_open(&self) -> bool! {
        self.is_open
    }
}

impl Drop for File {
    fn drop(&mut self) {
        self.close();
    }
}

// ============================================================================
// Stdin
// ============================================================================

/// Read line from stdin
///
/// Returns Reported (~) - user input is external
pub fn read_line() -> String~ {
    let mut result = String·new();
    let mut buf: [u8; 1] = [0; 1];

    loop {
        match read(STDIN, &mut buf) {
            Ok(n) => {
                if n == 0 {
                    break;  // EOF
                }
                if buf[0] == 10 {  // '\n'
                    break;
                }
                result.push(buf[0] as char);
            },
            Err(_) => break,
        }
    }

    result
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Create &str from raw pointer and length (unsafe)
#[inline]
unsafe fn str_from_raw(ptr: *const u8, len: u64) -> &str! {
    __builtin_str_from_raw_parts(ptr, len)
}
