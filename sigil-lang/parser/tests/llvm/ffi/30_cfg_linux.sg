// FFI Test 30: Conditional compilation - Linux
// Tests: #[cfg(target_os = "linux")] attribute
// Expected: 1 on Linux, 0 elsewhere

#[cfg(target_os = "linux")]
rite linux_only() → i64 {
    1
}

#[cfg(not(target_os = "linux"))]
rite linux_only() → i64 {
    0
}

rite main() → i64 {
    linux_only()
}
