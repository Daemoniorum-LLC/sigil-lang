// Test: Nested modules
// Expected output: 24

mod outer {
    pub mod inner {
        pub fn factorial(n: i64) -> i64 {
            if n <= 1 {
                1
            } else {
                n * factorial(n - 1)
            }
        }
    }
}

fn main() -> i64 {
    outer::inner::factorial(4)
}
