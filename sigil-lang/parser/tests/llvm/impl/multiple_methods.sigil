// Test: Multiple methods and method with parameters
// Expected output: 100

struct Rectangle {
    width: i64,
    height: i64,
}

impl Rectangle {
    fn area(self) -> i64 {
        self.width * self.height
    }
    
    fn scale(self, factor: i64) -> i64 {
        self.width * self.height * factor
    }
}

fn main() -> i64 {
    let r = Rectangle { width: 5, height: 4 };
    r.scale(5)
}
