// Native Platform Test 08: Entry (Input) Widget
// Tests: Create text entry and set text
// Expected: 0 (entry works correctly)

#[cfg(target_os = "linux")]
#[link("gtk-4")]
#[link("glib-2.0")]
#[link("gobject-2.0")]
extern "C" {
    type GtkWidget;
    type GtkEntry;
    type GtkEntryBuffer;

    rite gtk_init();
    rite gtk_entry_new() → *GtkEntry;
    rite gtk_entry_get_buffer(entry: *GtkEntry) → *GtkEntryBuffer;
    rite gtk_entry_buffer_set_text(buffer: *GtkEntryBuffer, text: *c_char, n_chars: c_int);

    // Editable interface
    rite gtk_editable_set_text(editable: *GtkWidget, text: *c_char);
}

#[cfg(target_os = "linux")]
rite main() → i64 {
    gtk_init();

    // Create entry widget
    ≔ entry = gtk_entry_new();

    // Set text using editable interface
    gtk_editable_set_text(entry as *GtkWidget, "Hello, World!\0".as_ptr());

    0  // Success
}

#[cfg(not(target_os = "linux"))]
rite main() → i64 {
    0
}
