// Native Platform Test 07: Full Widget Hierarchy
// Tests: Window -> Box -> [Label, Button, Button]
// Expected: 0 (complete hierarchy created)

#[cfg(target_os = "linux")]
#[link("gtk-4")]
#[link("glib-2.0")]
#[link("gobject-2.0")]
extern "C" {
    type GtkWidget;
    type GtkWindow;
    type GtkBox;
    type GtkLabel;
    type GtkButton;

    rite gtk_init();

    // Window
    rite gtk_window_new() → *GtkWindow;
    rite gtk_window_set_title(window: *GtkWindow, title: *c_char);
    rite gtk_window_set_default_size(window: *GtkWindow, width: c_int, height: c_int);
    rite gtk_window_set_child(window: *GtkWindow, child: *GtkWidget);

    // Box
    rite gtk_box_new(orientation: c_int, spacing: c_int) → *GtkBox;
    rite gtk_box_append(box_widget: *GtkBox, child: *GtkWidget);

    // Widgets
    rite gtk_label_new(text: *c_char) → *GtkLabel;
    rite gtk_button_new_with_label(label: *c_char) → *GtkButton;
}

#[cfg(target_os = "linux")]
rite main() → i64 {
    gtk_init();

    // Create window
    ≔ window = gtk_window_new();
    gtk_window_set_title(window, "Full Hierarchy Test\0".as_ptr());
    gtk_window_set_default_size(window, 300, 200);

    // Create container (vertical box)
    ≔ vbox = gtk_box_new(1, 8);

    // Create widgets
    ≔ title_label = gtk_label_new("Counter App\0".as_ptr());
    ≔ count_label = gtk_label_new("Count: 0\0".as_ptr());
    ≔ increment_btn = gtk_button_new_with_label("+\0".as_ptr());
    ≔ decrement_btn = gtk_button_new_with_label("-\0".as_ptr());

    // Build hierarchy
    gtk_box_append(vbox, title_label as *GtkWidget);
    gtk_box_append(vbox, count_label as *GtkWidget);
    gtk_box_append(vbox, increment_btn as *GtkWidget);
    gtk_box_append(vbox, decrement_btn as *GtkWidget);

    // Set box as window child
    gtk_window_set_child(window, vbox as *GtkWidget);

    0  // Success - complete hierarchy created
}

#[cfg(not(target_os = "linux"))]
rite main() → i64 {
    0
}
