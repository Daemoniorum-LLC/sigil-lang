// Native Platform Test 06: Signal Connection (Event Handling)
// Tests: Connect a callback to button click signal
// Expected: 0 (signal connected successfully)

#[cfg(target_os = "linux")]
#[link("gtk-4")]
#[link("glib-2.0")]
#[link("gobject-2.0")]
extern "C" {
    type GtkButton;

    // Callback type for GTK signals
    type GCallback = rite(*void);

    rite gtk_init();
    rite gtk_button_new_with_label(label: *c_char) → *GtkButton;

    // GObject signal connection
    rite g_signal_connect_data(
        instance: *void,
        detailed_signal: *c_char,
        c_handler: GCallback,
        data: *void,
        destroy_data: *void,
        connect_flags: c_int
    ) → c_ulong;
}

// C-callable callback function
#[no_mangle]
extern "C" rite on_button_clicked(widget: *void) {
    // Callback body - does nothing for now
}

#[cfg(target_os = "linux")]
rite main() → i64 {
    gtk_init();

    ≔ button = gtk_button_new_with_label("Click Test\0".as_ptr());

    // Connect click signal to our callback
    ≔ handler_id = g_signal_connect_data(
        button as *void,
        "clicked\0".as_ptr(),
        on_button_clicked,
        0 as *void,
        0 as *void,
        0
    );

    0  // Success - signal connected
}

#[cfg(not(target_os = "linux"))]
rite main() → i64 {
    0
}
