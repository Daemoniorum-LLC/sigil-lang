//! DAEMONIORUM - Combat Encounter Example
//!
//! Demonstrates how combat, alter switching, and reality
//! perception integrate during a boss fight.

use daemoniorum::combat::{Combat, Enemy, Ability, Turn};
use daemoniorum::core::{Trigger, RealityLayer};
use daemoniorum::anima::AnimaState;

// ============================================================================
// BOSS: THE GUILT SHADE
// ============================================================================

/// A manifestation of internalized guilt that appears in the Church
enemy GuiltShade: Manifestation {
    name: "The Guilt Shade",
    description: "A shifting mass of shadows wearing familiar faces",

    health: 150.0,
    psyche: 50.0,

    // Only visible in Fractured/Shattered
    visibility: [RealityLayer::Fractured, RealityLayer::Shattered],

    // Stronger in deeper reality layers
    layer_modifiers: {
        Fractured: { damage: 1.0, defense: 1.0 },
        Shattered: { damage: 1.5, defense: 0.7 },
    },

    abilities: [
        EnemyAbility {
            name: "Accusation",
            damage: 15.0,
            damage_type: DamageType::Emotional,
            description: "Speaks a truth the player tried to forget",
            effect: StatusEffect::Guilt { intensity: 0.3, duration: 3 },
        },
        EnemyAbility {
            name: "Memory Lash",
            damage: 20.0,
            damage_type: DamageType::Psychic,
            description: "Forces a painful memory to surface",
            effect: Trigger::trauma_flash { memory_id: random_trauma() },
        },
        EnemyAbility {
            name: "Face Theft",
            damage: 0.0,
            damage_type: DamageType::Reality,
            description: "Wears the face of someone from the past",
            effect: StatusEffect::Recognition { target: random_abuser() },
        },
        EnemyAbility {
            name: "Shadow Embrace",
            damage: 25.0,
            damage_type: DamageType::Physical,
            cooldown: 3,
            description: "Attempts to drag into the darkness",
            effect: RealityShift::deeper(),
        },
    ],

    trigger_behaviors: [
        TriggerBehavior {
            trigger: "guilt",
            condition: TriggerCondition::OnTurn,
            intensity: 0.4,
        },
        TriggerBehavior {
            trigger: "self_blame",
            condition: TriggerCondition::HealthBelow(0.5),
            intensity: 0.6,
        },
    ],

    phases: [
        Phase {
            name: "Whispering",
            health_range: (0.7, 1.0),
            behavior: Behavior::Psychological,
            preferred_abilities: ["Accusation", "Face Theft"],
        },
        Phase {
            name: "Raging",
            health_range: (0.3, 0.7),
            behavior: Behavior::Aggressive,
            preferred_abilities: ["Memory Lash", "Shadow Embrace"],
            on_enter: perception.shift(RealityLayer::Shattered, rate: 0.5),
        },
        Phase {
            name: "Desperate",
            health_range: (0.0, 0.3),
            behavior: Behavior::AllOut,
            summons: ["LesserGuilt", "LesserGuilt", "ShameFragment"],
        },
    ],

    weakness: Ability::trait("self_forgiveness"),
    immunity: DamageType::Physical, // Can't punch a shadow

    on_defeat: {
        // Defeating guilt brings revelation
        system.process_insight(Insight::GuildProcessed);
        perception.allow_layer(RealityLayer::Grounded);
    },
}

// ============================================================================
// COMBAT ENCOUNTER SCRIPT
// ============================================================================

/// The Church confrontation
encounter ChurchBoss {
    location: Church,
    enemy: GuiltShade,
    required_layer: RealityLayer::Fractured,

    /// Pre-combat setup
    fn initialize() {
        // Lock exits
        Church.lock_doors();

        // Set atmosphere
        perception.force_layer(RealityLayer::Fractured);
        audio.play("boss_ambient_guilt");

        // Initial trigger
        system.process_trigger(Trigger::guilt_confrontation());
    }

    /// Combat loop
    fn combat_loop(combat: Combat) {
        while !combat.is_over {
            let turn = combat.current_turn();

            match turn.combatant {
                Combatant::Player(player) => {
                    // Check for alter switch triggers
                    check_combat_triggers(player);

                    // Get player action
                    let action = player.choose_action();

                    match action {
                        Action::Ability(ability) => {
                            let result = execute_ability(player, ability, combat.enemy);
                            handle_ability_result(result);
                        },
                        Action::Switch(target_alter) => {
                            let result = player.combat_switch(target_alter);
                            handle_switch_result(result);
                        },
                        Action::Ground => {
                            let result = attempt_grounding();
                            handle_grounding_result(result);
                        },
                        Action::Item(item) => {
                            use_item(item);
                        },
                    }
                },
                Combatant::Enemy(enemy) => {
                    // Enemy AI
                    let ability = enemy.select_ability(combat);
                    let result = enemy.execute(ability, combat.player);

                    // Enemy abilities may cause triggers
                    if let Some(trigger) = ability.trigger_effect {
                        combat.player.process_combat_trigger(trigger);
                    }
                },
            }

            // Update reality based on combat state
            update_reality(combat);

            combat.next_turn();
        }

        // Combat end
        if combat.result == CombatResult::Victory {
            on_victory();
        } else {
            on_defeat();
        }
    }

    /// Check for alter switch triggers during combat
    fn check_combat_triggers(player: PlayerCombatant) {
        // Low health may trigger protector
        if player.health < player.max_health * 0.3 {
            if let Some(protector) = system.find_alter_by_role(Role::Protector) {
                system.process_trigger(Trigger::system_endangered());
            }
        }

        // High psyche damage may trigger knowledge alter
        if player.psyche < player.max_psyche * 0.2 {
            if let Some(analyst) = system.find_alter_by_trait("analysis") {
                system.bring_cocon(analyst);
            }
        }

        // Reality shift may activate specific alters
        match perception.current_layer {
            RealityLayer::Shattered => {
                // Trauma holders are stronger here
                system.alters.iter()
                    .filter(|a| a.category == AlterCategory::TraumaHolder)
                    .for_each(|a| a.damage_modifier = 1.3);
            },
            RealityLayer::Fractured => {
                // Council members balanced
            },
            RealityLayer::Grounded => {
                // Should rarely be here during this fight
            },
        }
    }

    /// Update reality layer based on combat state
    fn update_reality(combat: Combat) {
        let enemy_health_ratio = combat.enemy.health / combat.enemy.max_health;
        let player_stability = system.stability;
        let dissociation = system.dissociation;

        // Enemy getting desperate pushes toward Shattered
        if enemy_health_ratio < 0.3 && perception.current_layer != RealityLayer::Shattered {
            perception.begin_transition(RealityLayer::Shattered, rate: 0.3);
        }

        // Player grounding can push back
        if player_stability > 0.7 && dissociation < 0.3 {
            if perception.current_layer == RealityLayer::Shattered {
                perception.begin_transition(RealityLayer::Fractured, rate: 0.1);
            }
        }

        // High dissociation is dangerous
        if dissociation > 0.8 {
            // Risk of passive state
            system.process_trigger(Trigger::dissociation_critical());
        }
    }

    /// Victory handler
    fn on_victory() {
        // Process the confrontation
        let insight = Insight::new("Guilt was a chain, not a truth");
        system.integrate_insight(insight);

        // Reward: new ability
        let fronter = system.current_fronter();
        fronter.learn_ability(Ability::new(
            "Forgiveness",
            DamageType::Emotional,
            healing: 20.0,
            description: "Accept what cannot be changed",
        ));

        // Reality stabilizes
        perception.begin_transition(RealityLayer::Grounded, rate: 0.5);

        // Unlock progression
        Church.unlock_door("Crypt");
    }

    /// Defeat handler
    fn on_defeat() {
        // Not game over - system protects itself
        switch! to system.any_protector() {
            reason: SwitchReason::Emergency,
            urgency: 1.0,
            then: {
                // Emergency retreat
                headspace.emergency_evacuate();

                // Temporary safety
                perception.force_layer(RealityLayer::Grounded);

                // But the guilt remains...
                system.add_status(StatusEffect::Unresolved {
                    source: "GuiltShade",
                    intensity: 0.5,
                    decay_rate: 0.01,
                });
            },
        }
    }
}

// ============================================================================
// ALTER-SPECIFIC COMBAT STRATEGIES
// ============================================================================

/// Abaddon's combat approach
impl CombatStrategy for Abaddon {
    fn preferred_approach(&self, enemy: Enemy) -> Approach {
        if enemy.is_manifestation() && self.reality == RealityLayer::Fractured {
            Approach::Aggressive {
                lead_with: "Trauma Strike",
                follow_up: "Protective Rage",
            }
        } else {
            Approach::Defensive {
                protect: system.vulnerable_alters(),
                counter: true,
            }
        }
    }

    fn on_low_health(&self) {
        // Abaddon fights harder when wounded
        self.anima.arousal += 0.2;
        self.damage_modifier = 1.2;
    }
}

/// Stolas's combat approach
impl CombatStrategy for Stolas {
    fn preferred_approach(&self, enemy: Enemy) -> Approach {
        // Analyze first, then exploit weakness
        Approach::Tactical {
            first_turn: "Analyze",
            then: enemy.weakness.map(|w| w.counter_ability()),
        }
    }

    fn support_mode(&self) -> SupportStrategy {
        SupportStrategy {
            buff_target: system.current_fronter(),
            intel_share: true,
            avoid_front: true,
        }
    }
}

/// Beleth's combat approach
impl CombatStrategy for Beleth {
    fn preferred_approach(&self, enemy: Enemy) -> Approach {
        if enemy.can_communicate() {
            Approach::Diplomatic {
                attempt: "Negotiate",
                fallback: "Charm",
            }
        } else {
            Approach::Evasive {
                priority: "Social Shield",
                call_for_switch: true,
            }
        }
    }
}
