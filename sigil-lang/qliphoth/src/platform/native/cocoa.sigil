// ============================================================================
// Cocoa FFI Declarations (Stubs)
// ============================================================================

#[cfg(target_os = "macos")]
#[link("AppKit", framework)]
#[link("Foundation", framework)]
extern "C" {
    // Types (opaque)
    type NSApplication;
    type NSWindow;
    type NSView;
    type NSButton;
    type NSTextField;
    type NSTextView;
    type NSStackView;
    type NSScrollView;
    type NSTableView;
    type NSImageView;
    type NSProgressIndicator;
    type NSSlider;
    type NSSwitch;
    type NSString;

    // Application lifecycle
    rite NSApplicationMain(argc: i32, argv: **c_char) -> i32;

    // Objective-C runtime
    rite objc_getClass(name: *c_char) -> *void;
    rite objc_msgSend(obj: *void, sel: *void, ...) -> *void;
    rite sel_registerName(name: *c_char) -> *void;

    // String conversion
    rite CFStringCreateWithCString(allocator: *void, cStr: *c_char, encoding: u32) -> *void;
}

