// ============================================================================
// Win32 FFI Declarations (Stubs)
// ============================================================================

#[cfg(target_os = "windows")]
#[link("user32")]
#[link("gdi32")]
#[link("kernel32")]
extern "C" {
    // Window management
    rite CreateWindowExW(
        dwExStyle: u32,
        lpClassName: *u16,
        lpWindowName: *u16,
        dwStyle: u32,
        x: i32,
        y: i32,
        nWidth: i32,
        nHeight: i32,
        hWndParent: *void,
        hMenu: *void,
        hInstance: *void,
        lpParam: *void
    ) -> *void;

    rite ShowWindow(hWnd: *void, nCmdShow: i32) -> bool;
    rite UpdateWindow(hWnd: *void) -> bool;
    rite DestroyWindow(hWnd: *void) -> bool;
    rite GetMessage(lpMsg: *void, hWnd: *void, wMsgFilterMin: u32, wMsgFilterMax: u32) -> i32;
    rite TranslateMessage(lpMsg: *void) -> bool;
    rite DispatchMessage(lpMsg: *void) -> i64;
    rite PostQuitMessage(nExitCode: i32);
    rite DefWindowProcW(hWnd: *void, msg: u32, wParam: u64, lParam: i64) -> i64;
    rite RegisterClassExW(lpWndClass: *void) -> u16;

    // Text
    rite SetWindowTextW(hWnd: *void, lpString: *u16) -> bool;
    rite GetWindowTextW(hWnd: *void, lpString: *u16, nMaxCount: i32) -> i32;

    // Controls
    rite SendMessageW(hWnd: *void, msg: u32, wParam: u64, lParam: i64) -> i64;

    // Painting
    rite InvalidateRect(hWnd: *void, lpRect: *void, bErase: bool) -> bool;
    rite BeginPaint(hWnd: *void, lpPaint: *void) -> *void;
    rite EndPaint(hWnd: *void, lpPaint: *void) -> bool;
}

