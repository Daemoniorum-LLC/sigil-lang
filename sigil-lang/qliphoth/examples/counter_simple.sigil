// Simple Interactive Counter
// Demonstrates state management using structs.
// Uses P0-compatible features only.

☉ sigil Counter {
    count: !i64
}

⊢ Counter {
    ☉ rite new() → This {
        This { count: 0 }
    }

    ☉ rite increment(vary this) {
        this.count = this.count + 1;
    }

    ☉ rite decrement(vary this) {
        this.count = this.count - 1;
    }

    ☉ rite reset(vary this) {
        this.count = 0;
    }

    ☉ rite get(this) → !i64 {
        this.count
    }
}

rite main() {
    println("=== Sigil Counter Demo ===");

    ≔ vary counter: !Counter = Counter·new();
    println(counter.get());

    counter.increment();
    counter.increment();
    counter.increment();
    println(counter.get());

    counter.decrement();
    println(counter.get());

    counter.reset();
    println(counter.get());
}
