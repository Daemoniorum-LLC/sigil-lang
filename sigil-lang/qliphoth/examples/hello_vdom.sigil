// Simple VDOM Rendering Example
//
// Demonstrates basic virtual DOM concepts with Sigil.
// P0-compatible version that simulates VDOM in the console.

/// A virtual DOM node (simplified)
sigil VNode {
    tag: String,
    text: String,
    class_name: String,
    children: Vec<VNode>,
}

⊢ VNode {
    /// Create an element node
    rite element(tag: str) → VNode {
        VNode {
            tag: tag.to_string(),
            text: "".to_string(),
            class_name: "".to_string(),
            children: Vec·new()
        }
    }

    /// Create a text node
    rite text_node(content: str) → VNode {
        VNode {
            tag: "".to_string(),
            text: content.to_string(),
            class_name: "".to_string(),
            children: Vec·new()
        }
    }

    /// Set class name
    rite with_class(&vary this, class: str) {
        this.class_name = class.to_string();
    }

    /// Add a child node
    rite add_child(&vary this, child: VNode) {
        this.children.push(child);
    }

    /// Check if this is a text node
    rite is_text(&this) → bool {
        this.tag.len() == 0
    }

    /// Render to HTML string
    rite to_html(&this, indent: i64) → String {
        ≔ vary spaces = "".to_string();
        ≔ vary i = 0;
        ⟳ i < indent {
            spaces = f"{spaces}  ";
            i = i + 1;
        }

        ⎇ this.is_text() {
            f"{spaces}{this.text}"
        } ⎉ {
            ≔ vary html = "".to_string();

            // Opening tag
            ⎇ this.class_name.len() > 0 {
                html = f"{spaces}<{this.tag} class=\"{this.class_name}\">";
            } ⎉ {
                html = f"{spaces}<{this.tag}>";
            }

            // Children
            ⎇ this.children.len() > 0 {
                html = f"{html}\n";
                ≔ vary j = 0;
                ⟳ j < this.children.len() {
                    ≔ child_html = this.children[j].to_html(indent + 1);
                    html = f"{html}{child_html}\n";
                    j = j + 1;
                }
                html = f"{html}{spaces}</{this.tag}>"
            } ⎉ {
                html = f"{html}</{this.tag}>"
            }

            html
        }
    }
}

/// Create a greeting component
rite create_greeting(name: str) → VNode {
    ≔ vary div = VNode·element("div");
    div.with_class("greeting");
    div.add_child(VNode·text_node(f"Hello, {name}! Welcome to Sigil."));
    div
}

/// Create a card component
rite create_card(title: str, content: str) → VNode {
    ≔ vary card = VNode·element("div");
    card.with_class("card");

    ≔ vary h2 = VNode·element("h2");
    h2.with_class("card-title");
    h2.add_child(VNode·text_node(title));
    card.add_child(h2);

    ≔ vary p = VNode·element("p");
    p.with_class("card-content");
    p.add_child(VNode·text_node(content));
    card.add_child(p);

    card
}

/// Main entry point
rite main() {
    println("=== Sigil VDOM Demo ===");
    println("");

    // Example 1: Simple greeting
    println("1. Simple Greeting Component:");
    ≔ greeting = create_greeting("World");
    println(greeting.to_html(0));
    println("");

    // Example 2: Card component
    println("2. Card Component:");
    ≔ card = create_card("Welcome to Qliphoth", "A web framework for Sigil.");
    println(card.to_html(0));
    println("");

    // Example 3: Nested structure
    println("3. Nested Structure:");
    ≔ vary page = VNode·element("main");
    page.with_class("page");

    ≔ vary header = VNode·element("header");
    ≔ vary h1 = VNode·element("h1");
    h1.add_child(VNode·text_node("Sigil App"));
    header.add_child(h1);
    page.add_child(header);

    ≔ vary section = VNode·element("section");
    section.with_class("content");
    section.add_child(create_card("About", "This is a Sigil app."));
    page.add_child(section);

    ≔ vary footer = VNode·element("footer");
    footer.add_child(VNode·text_node("Built with Qliphoth"));
    page.add_child(footer);

    println(page.to_html(0));
    println("");

    println("=== Demo Complete ===");
}
