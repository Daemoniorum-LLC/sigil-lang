// Simple VDOM Test
//
// A minimal example demonstrating basic Sigil syntax.
// P0-compatible.

/// A simple element structure
sigil Element {
    tag: String,
    content: String,
}

⊢ Element {
    rite new(tag: str, content: str) → Element {
        Element {
            tag: tag.to_string(),
            content: content.to_string()
        }
    }

    rite render(&this) → String {
        f"<{this.tag}>{this.content}</{this.tag}>"
    }
}

/// Main entry point
rite main() {
    println("=== Simple VDOM Test ===");
    println("");

    // Basic string formatting
    ≔ name = "World";
    ≔ greeting = f"Hello, {name}!";
    println(greeting);
    println("");

    // Basic arithmetic
    ≔ x = 10;
    ≔ y = 20;
    ≔ sum = x + y;
    println(f"Sum: {x} + {y} = {sum}");
    println("");

    // Simple element rendering
    println("Element Rendering:");
    ≔ h1 = Element·new("h1", "Welcome");
    ≔ p = Element·new("p", "This is a paragraph.");
    ≔ span = Element·new("span", "Inline text");

    println(h1.render());
    println(p.render());
    println(span.render());
    println("");

    // Page structure
    println("Page Structure:");
    println("<html>");
    println(f"  <head><title>{name} Page</title></head>");
    println("  <body>");
    println(f"    {h1.render()}");
    println(f"    {p.render()}");
    println("  </body>");
    println("</html>");
    println("");

    println("=== Test Complete ===");
}
