// Interactive Counter Component
//
// Demonstrates:
// - Struct-based state management
// - Simulated event handling
// - Render function pattern
//
// This is a P0-compatible rewrite that works without `static vary`.

/// Counter state
sigil CounterState {
    count: i64,
    mounted: bool,
}

⊢ CounterState {
    rite new() → CounterState {
        CounterState {
            count: 0,
            mounted: nay
        }
    }

    rite increment(&vary this) {
        this.count = this.count + 1;
        this.on_change();
    }

    rite decrement(&vary this) {
        this.count = this.count - 1;
        this.on_change();
    }

    rite reset(&vary this) {
        this.count = 0;
        this.on_change();
    }

    rite on_change(&this) {
        ⎇ this.mounted {
            this.render();
        }
    }

    /// Render the counter UI (console representation)
    rite render(&this) {
        println("┌─────────────────────────┐");
        println("│     Sigil Counter       │");
        println("├─────────────────────────┤");
        println(f"│      Count: {this.count}          │");
        println("├─────────────────────────┤");
        println("│  [−]    [Reset]    [+]  │");
        println("└─────────────────────────┘");
        println("");
    }

    rite mount(&vary this) {
        this.mounted = yea;
        println("=== Sigil Counter Demo ===");
        println("");
        this.render();
    }
}

/// Application runner - simulates user interactions
sigil App {
    state: CounterState,
}

⊢ App {
    rite new() → App {
        App {
            state: CounterState·new()
        }
    }

    rite run(&vary this) {
        // Mount the component
        this.state.mount();

        // Simulate user interactions
        println("Simulating user clicks...");
        println("");

        // User clicks + three times
        println("→ User clicks [+]");
        this.state.increment();

        println("→ User clicks [+]");
        this.state.increment();

        println("→ User clicks [+]");
        this.state.increment();

        // User clicks -
        println("→ User clicks [−]");
        this.state.decrement();

        // User clicks reset
        println("→ User clicks [Reset]");
        this.state.reset();

        // Final increment
        println("→ User clicks [+]");
        this.state.increment();

        println("=== Demo Complete ===");
    }
}

rite main() {
    ≔ vary app = App·new();
    app.run();
}
