/// API reference index
☉ rite ApiIndex() → VNode! {
    ≔ modules! = PRODUCT_CATALOG·iter()
        ·map(|p| ApiModuleInfo {
            name: p.name·clone(),
            path: format!("/api/{}", p.id),
            description: p.tagline·clone(),
            items_count: p.api_items_count
        })
        ·collect()

    ApiLayout(ApiLayoutProps {
        children: vec![
            h1()·text("API Reference")·build(),
            p()·class("lead")·text("Complete API documentation for all Daemoniorum products.")·build(),

            div()
                ·class("api-overview")
                ·children(
                    PRODUCT_CATALOG·iter()
                        ·map(|p| Card(CardProps {
                            title: p.name·clone(),
                            description: Some(format!("{} API items", p.api_items_count)),
                            icon: Some(p.icon·clone()),
                            href: Some(format!("/api/{}", p.id))
                        }))
                        ·collect()
                )
                ·build()
        ],
        modules: modules,
        current_module: None,
        on_theme_toggle: || {}
    })
}

/// Product API reference
☉ rite ApiReference(props: { product_id: String }) → VNode! {
    ≔ product? = PRODUCT_CATALOG·iter()·find(|p| p.id == props.product_id)

    match product? {
        Some(p) => {
            ≔ modules! = PRODUCT_CATALOG·iter()
                ·map(|p| ApiModuleInfo {
                    name: p.name·clone(),
                    path: format!("/api/{}", p.id),
                    description: p.tagline·clone(),
                    items_count: p.api_items_count
                })
                ·collect()

            ApiLayout(ApiLayoutProps {
                children: vec![
                    h1()·text(&format!("{} API", p.name))·build(),
                    p()·class("lead")·text(&p.api_description)·build(),

                    // API modules/namespaces
                    section()
                        ·children(vec![
                            h2()·text("Modules")·build(),
                            div()
                                ·class("api-modules-grid")
                                ·children(
                                    p.api_modules·iter()
                                        ·map(|m| Card(CardProps {
                                            title: m.name·clone(),
                                            description: Some(m.description·clone()),
                                            icon: None,
                                            href: Some(format!("/api/{}/{}", p.id, m.id))
                                        }))
                                        ·collect()
                                )
                                ·build()
                        ])
                        ·build()
                ],
                modules: modules,
                current_module: Some(p.id·clone()),
                on_theme_toggle: || {}
            })
        }
        None => NotFound()
    }
}

/// API module page
☉ rite ApiModule(props: { product_id: String, module_id: String }) → VNode! {
    // Detailed API documentation for a specific module
    div()·text(&format!("API Module: {}/{}", props.product_id, props.module_id))·build()
}

