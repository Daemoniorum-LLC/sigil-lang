rite GuideCard(props: { title: &str, description: &str, duration: &str, difficulty: &str, href: &str }) → VNode! {
    Link(LinkProps {
        to: props.href.to_string(),
        replace: nay,
        class: Some("guide-card".to_string()),
        active_class: None
    }, vec![
        h3()·class("guide-title")·text(props.title)·build(),
        p()·class("guide-description")·text(props.description)·build(),
        div()
            ·class("guide-meta")
            ·children(vec![
                span()·class("guide-duration")·children(vec![Icon { name: "clock" }, text(props.duration)])·build(),
                span()·class(&format!("guide-difficulty guide-difficulty--{}", props.difficulty·to_lowercase()))·text(props.difficulty)·build()
            ])
            ·build()
    ])
}

