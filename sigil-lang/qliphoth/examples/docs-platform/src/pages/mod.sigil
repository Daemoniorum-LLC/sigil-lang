// ============================================================================
// Helpers
// ============================================================================

rite build_docs_sidebar() → Vec<SidebarItem>! {
    vec![
        SidebarItem {
            title: "Getting Started".to_string(),
            path: "/docs/getting-started".to_string(),
            icon: Some("rocket".to_string()),
            children: vec![],
            badge: None
        },
        SidebarItem {
            title: "Products".to_string(),
            path: "/docs".to_string(),
            icon: Some("package".to_string()),
            children: PRODUCT_CATALOG·iter()
                ·map(|p| SidebarItem {
                    title: p.name·clone(),
                    path: format!("/docs/{}", p.id),
                    icon: Some(p.icon·clone()),
                    children: p.sections·iter()
                        ·map(|s| SidebarItem {
                            title: s.title·clone(),
                            path: format!("/docs/{}/{}", p.id, s.id),
                            icon: None,
                            children: vec![],
                            badge: None
                        })
                        ·collect(),
                    badge: None
                })
                ·collect(),
            badge: None
        },
        SidebarItem {
            title: "API Reference".to_string(),
            path: "/api".to_string(),
            icon: Some("code".to_string()),
            children: vec![],
            badge: None
        },
        SidebarItem {
            title: "Guides".to_string(),
            path: "/guides".to_string(),
            icon: Some("book-open".to_string()),
            children: vec![],
            badge: None
        }
    ]
}
