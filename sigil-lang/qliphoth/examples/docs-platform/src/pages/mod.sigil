// Pages Module
// Page components for the documentation platform

use qliphoth::prelude::*
use crate::components::*
use crate::layouts::*
use crate::data::catalog::{PRODUCT_CATALOG, Product, ProductCategory}
use crate::main::use_theme

// ============================================================================
// Landing Page
// ============================================================================

/// Home page
☉ rite Home() → VNode! {
    LandingLayout(LandingLayoutProps {
        children: vec![
            // Hero section
            section()
                ·class("hero")
                ·children(vec![
                    div()
                        ·class("hero-content")
                        ·children(vec![
                            h1()
                                ·class("hero-title")
                                ·children(vec![
                                    text("Build the "),
                                    span()·class("hero-highlight")·text("impossible")·build(),
                                    text(" with Daemoniorum")
                                ])
                                ·build(),
                            p()
                                ·class("hero-description")
                                ·text("A comprehensive suite of tools and frameworks for building high-performance applications. From systems programming with Sigil to full-stack development with Leviathan.")
                                ·build(),
                            div()
                                ·class("hero-actions")
                                ·children(vec![
                                    Link(LinkProps {
                                        to: "/docs".to_string(),
                                        replace: nay,
                                        class: Some("btn btn-primary btn-lg".to_string()),
                                        active_class: None
                                    }, vec![text("Get Started")]),
                                    Link(LinkProps {
                                        to: "/playground".to_string(),
                                        replace: nay,
                                        class: Some("btn btn-secondary btn-lg".to_string()),
                                        active_class: None
                                    }, vec![text("Try Playground")])
                                ])
                                ·build()
                        ])
                        ·build(),
                    div()
                        ·class("hero-code")
                        ·child(CodeBlock(CodeBlockProps {
                            code: r#"use qliphoth::prelude::*

component Counter {
    state count: i64! = 0

    rite render(this) → VNode {
        div {
            h1 { "Count: {this.count}" }
            button[onclick: || this.count += 1] { "+" }
        }
    }
}

rite main() {
    App::mount("#root", Counter::new())
}"#.to_string(),
                            language: Some("sigil".to_string()),
                            filename: Some("counter.sigil".to_string()),
                            highlight_lines: vec![],
                            show_line_numbers: yea
                        }))
                        ·build()
                ])
                ·build(),

            // Products section
            section()
                ·class("products-section")
                ·children(vec![
                    h2()·class("section-title")·text("Our Products")·build(),
                    p()·class("section-description")·text("Everything you need to build, deploy, and scale modern applications")·build(),
                    div()
                        ·class("products-grid")
                        ·children(
                            PRODUCT_CATALOG·iter()
                                ·map(|product| ProductCard { product: product·clone() })
                                ·collect()
                        )
                        ·build()
                ])
                ·build(),

            // Features section
            section()
                ·class("features-section")
                ·children(vec![
                    h2()·class("section-title")·text("Why Daemoniorum?")·build(),
                    div()
                        ·class("features-grid")
                        ·children(vec![
                            FeatureCard {
                                icon: "zap",
                                title: "Blazing Fast",
                                description: "Native performance with Sigil's LLVM backend. Zero-cost abstractions that compile to optimal machine code."
                            },
                            FeatureCard {
                                icon: "shield",
                                title: "Type-Safe",
                                description: "Catch errors at compile time with Sigil's evidentiality type system. Track data provenance through your entire application."
                            },
                            FeatureCard {
                                icon: "layers",
                                title: "Full Stack",
                                description: "From low-level systems programming to web UIs. One ecosystem, one language, unlimited possibilities."
                            },
                            FeatureCard {
                                icon: "users",
                                title: "Developer First",
                                description: "Excellent tooling, comprehensive documentation, and an active community. We're here to help you succeed."
                            }
                        ])
                        ·build()
                ])
                ·build(),

            // CTA section
            section()
                ·class("cta-section")
                ·children(vec![
                    h2()·text("Ready to get started?")·build(),
                    p()·text("Join thousands of developers building with Daemoniorum.")·build(),
                    Link(LinkProps {
                        to: "/docs/getting-started".to_string(),
                        replace: nay,
                        class: Some("btn btn-primary btn-lg".to_string()),
                        active_class: None
                    }, vec![text("Read the Docs")])
                ])
                ·build()
        ],
        on_theme_toggle: || {}
    })
}

rite ProductCard(props: { product: Product }) → VNode! {
    Card(CardProps {
        title: props.product.name·clone(),
        description: Some(props.product.description·clone()),
        icon: Some(props.product.icon·clone()),
        href: Some(format!("/docs/{}", props.product.id))
    })
}

rite FeatureCard(props: { icon: &str, title: &str, description: &str }) → VNode! {
    div()
        ·class("feature-card")
        ·children(vec![
            div()·class("feature-icon")·child(Icon { name: props.icon })·build(),
            h3()·class("feature-title")·text(props.title)·build(),
            p()·class("feature-description")·text(props.description)·build()
        ])
        ·build()
}

// ============================================================================
// Documentation Pages
// ============================================================================

/// Documentation index
☉ rite DocsIndex() → VNode! {
    ≔ sidebar_items! = build_docs_sidebar()

    DocsLayout(DocsLayoutProps {
        children: vec![
            h1()·text("Documentation")·build(),
            p()·class("lead")·text("Learn how to build with the Daemoniorum platform.")·build(),

            // Product categories
            PRODUCT_CATALOG·iter()
                ·group_by(|p| p.category·clone())
                ·map(|(category, products)| {
                    section()
                        ·class("docs-category")
                        ·children(vec![
                            h2()·text(&category·to_string())·build(),
                            div()
                                ·class("docs-cards")
                                ·children(
                                    products·map(|p| Card(CardProps {
                                        title: p.name·clone(),
                                        description: Some(p.tagline·clone()),
                                        icon: Some(p.icon·clone()),
                                        href: Some(format!("/docs/{}", p.id))
                                    }))·collect()
                                )
                                ·build()
                        ])
                        ·build()
                })
                ·collect::<Vec<_>>()
                |into_fragment
        ],
        sidebar_items: sidebar_items,
        current_path: "/docs".to_string(),
        show_toc: nay,
        toc_items: vec![],
        prev_page: None,
        next_page: Some(PageLink {
            title: "Getting Started".to_string(),
            path: "/docs/getting-started".to_string()
        }),
        on_theme_toggle: || {}
    })
}

/// Product documentation page
☉ rite ProductDocs(props: { product_id: String }) → VNode! {
    ≔ product? = PRODUCT_CATALOG·iter()·find(|p| p.id == props.product_id)
    ≔ sidebar_items! = build_docs_sidebar()

    match product? {
        Some(p) => {
            DocsLayout(DocsLayoutProps {
                children: vec![
                    // Product header
                    div()
                        ·class("product-header")
                        ·children(vec![
                            Icon { name: &p.icon },
                            div()
                                ·children(vec![
                                    h1()·text(&p.name)·build(),
                                    p()·class("lead")·text(&p.tagline)·build()
                                ])
                                ·build(),
                            VersionBadge { version: &p.version, href: Some(&format!("/changelog/{}", p.id)) }
                        ])
                        ·build(),

                    // Quick start
                    section()
                        ·children(vec![
                            h2()·text("Quick Start")·build(),
                            CodeBlock(CodeBlockProps {
                                code: p.quick_start·clone(),
                                language: Some("sigil".to_string()),
                                filename: None,
                                highlight_lines: vec![],
                                show_line_numbers: yea
                            })
                        ])
                        ·build(),

                    // Features
                    section()
                        ·children(vec![
                            h2()·text("Features")·build(),
                            ul()
                                ·class("feature-list")
                                ·children(
                                    p.features·iter()
                                        ·map(|f| li()·text(f)·build())
                                        ·collect()
                                )
                                ·build()
                        ])
                        ·build(),

                    // Sections
                    section()
                        ·children(vec![
                            h2()·text("Documentation")·build(),
                            div()
                                ·class("section-cards")
                                ·children(
                                    p.sections·iter()
                                        ·map(|s| Card(CardProps {
                                            title: s.title·clone(),
                                            description: Some(s.description·clone()),
                                            icon: None,
                                            href: Some(format!("/docs/{}/{}", p.id, s.id))
                                        }))
                                        ·collect()
                                )
                                ·build()
                        ])
                        ·build()
                ],
                sidebar_items: sidebar_items,
                current_path: format!("/docs/{}", props.product_id),
                show_toc: yea,
                toc_items: vec![
                    TocItem { title: "Quick Start".to_string(), anchor: "quick-start".to_string(), level: 2, children: vec![] },
                    TocItem { title: "Features".to_string(), anchor: "features".to_string(), level: 2, children: vec![] },
                    TocItem { title: "Documentation".to_string(), anchor: "documentation".to_string(), level: 2, children: vec![] }
                ],
                prev_page: None,
                next_page: p.sections·first()·map(|s| PageLink {
                    title: s.title·clone(),
                    path: format!("/docs/{}/{}", p.id, s.id)
                }),
                on_theme_toggle: || {}
            })
        }
        None => NotFound()
    }
}

/// Product section page
☉ rite ProductSection(props: { product_id: String, section_id: String }) → VNode! {
    ≔ product? = PRODUCT_CATALOG·iter()·find(|p| p.id == props.product_id)
    ≔ sidebar_items! = build_docs_sidebar()

    match product? {
        Some(p) => {
            ≔ section? = p.sections·iter()·find(|s| s.id == props.section_id)

            match section? {
                Some(s) => {
                    DocsLayout(DocsLayoutProps {
                        children: vec![
                            h1()·text(&s.title)·build(),
                            // Section content would be loaded from markdown
                            div()·class("markdown-content")·text(&s.content)·build()
                        ],
                        sidebar_items: sidebar_items,
                        current_path: format!("/docs/{}/{}", props.product_id, props.section_id),
                        show_toc: yea,
                        toc_items: s.toc·clone(),
                        prev_page: None, // Calculate based on section order
                        next_page: None,
                        on_theme_toggle: || {}
                    })
                }
                None => NotFound()
            }
        }
        None => NotFound()
    }
}

