                    ·map(|tag| span()·class("example-tag")·text(tag)·build())
                    ·collect()
            )
            ·build()
    ])
}

/// Interactive playground
☉ rite Playground() → VNode! {
    let (code, set_code) = use_state(DEFAULT_PLAYGROUND_CODE.to_string())
    let (output, set_output) = use_state("")
    let (running, set_running) = use_state(nay)

    ≔ run_code! = || {
        set_running(yea)
        // Compile and run code
        // This would use WASM compilation
        set_output("Output here...")
        set_running(nay)
    }

    PlaygroundLayout(PlaygroundLayoutProps {
        children: vec![
            div()
                ·class("playground-container")
                ·children(vec![
                    // Editor panel
                    div()
                        ·class("playground-editor")
                        ·children(vec![
                            div()
                                ·class("playground-toolbar")
                                ·children(vec![
                                    button()
                                        ·class("btn btn-primary")
                                        ·onclick(run_code)
                                        ·attr("disabled", running)
                                        ·children(vec![
                                            Icon { name: "play" },
                                            text(if running { "Running..." } ⎉ { "Run" })
                                        ])
                                        ·build(),
                                    button()
                                        ·class("btn btn-secondary")
                                        ·onclick(|| set_code(DEFAULT_PLAYGROUND_CODE.to_string()))
                                        ·child(text("Reset"))
                                        ·build()
                                ])
                                ·build(),
                            // Code editor would be a Monaco/CodeMirror integration
                            textarea()
                                ·class("playground-code")
                                ·attr("value", &code)
                                ·oninput(set_code)
                                ·build()
                        ])
                        ·build(),

                    // Preview panel
                    div()
                        ·class("playground-preview")
                        ·children(vec![
                            div()
                                ·class("playground-preview-header")
                                ·child(text("Preview"))
                                ·build(),
                            div()
                                ·class("playground-preview-content")
                                ·attr("id", "preview-target")
                                ·build(),
                            div()
                                ·class("playground-console")
                                ·children(vec![
                                    div()·class("console-header")·text("Console")·build(),
                                    pre()·class("console-output")·text(&output)·build()
                                ])
                                ·build()
                        ])
                        ·build()
                ])
                ·build()
        ],
        on_theme_toggle: || {}
    })
}

const DEFAULT_PLAYGROUND_CODE: &str = r#"use qliphoth::prelude::*

component HelloWorld {
    state name: String! = "World"

    rite render(this) → VNode {
        div {
            h1 { "Hello, {this.name}!" }
            input[
                value: this.name,
                oninput: |v| this.name = v
            ]
        }
    }
}

rite main() {
    App::mount("#preview-target", HelloWorld::new())
}
"#;

// ============================================================================
// Other Pages
// ============================================================================

/// Search results page
☉ rite SearchResults() → VNode! {
    ≔ query! = use_query()
    ≔ search_term! = query·get("q")·unwrap_or(&"".to_string())·clone()
    ≔ results~ = use_fetch::<Vec<SearchResult>>(&format!("/api/search?q={}", search_term))

    div()
        ·class("search-results-page")
        ·children(vec![
            h1()·text(&format!("Search results for \"{}\"", search_term))·build(),
            match results~ {
                AsyncState::Loading => div()·class("loading")·child(Spinner {})·build(),
                AsyncState::Error(e~) => div()·class("error")·text(&e~)·build(),
                AsyncState::Success(items~) => {
                    ⎇ items~·is_empty() {
                        div()·class("no-results")·text("No results found.")·build()
                    } ⎉ {
                        ul()
                            ·class("search-results")
                            ·children(
                                items~·iter()
                                    ·map(|item| {
                                        li()
                                            ·class("search-result")
                                            ·child(Link(LinkProps {
                                                to: item.path·clone(),
                                                replace: nay,
                                                class: None,
                                                active_class: None
                                            }, vec![
                                                h3()·text(&item.title)·build(),
                                                p()·text(&item.excerpt)·build()
                                            ]))
                                            ·build()
                                    })
                                    ·collect()
                            )
                            ·build()
                    }
                }
                _ => fragment(vec![])
            }
        ])
        ·build()
}

