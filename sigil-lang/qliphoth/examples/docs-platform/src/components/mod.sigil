// Components Module
// Reusable UI components for the documentation platform

use qliphoth::prelude::*
use crate::main::{use_theme, Theme}
use crate::layouts::{SidebarItem, TocItem, PageLink}

// ============================================================================
// Navigation Components
// ============================================================================

/// Site header with navigation
☉ rite Header(props: HeaderProps) → VNode! {
    ≔ theme! = use_theme()
    let (search_open, set_search_open) = use_state(nay)

    header()
        ·class("site-header")
        ·children(vec![
            // Logo
            Link(LinkProps {
                to: "/".to_string(),
                replace: nay,
                class: Some("site-logo".to_string()),
                active_class: None
            }, vec![
                img()·attr("src", "/logo.svg")·attr("alt", "Daemoniorum")·build(),
                span()·text("Daemoniorum")·build()
            ]),

            // Main navigation
            nav()
                ·class("site-nav")
                ·children(vec![
                    NavLink(NavLinkProps {
                        to: "/docs".to_string(),
                        class: Some("nav-link".to_string()),
                        active_class: Some("nav-link--active".to_string())
                    }, vec![text("Documentation")]),

                    NavLink(NavLinkProps {
                        to: "/api".to_string(),
                        class: Some("nav-link".to_string()),
                        active_class: Some("nav-link--active".to_string())
                    }, vec![text("API Reference")]),

                    NavLink(NavLinkProps {
                        to: "/guides".to_string(),
                        class: Some("nav-link".to_string()),
                        active_class: Some("nav-link--active".to_string())
                    }, vec![text("Guides")]),

                    NavLink(NavLinkProps {
                        to: "/examples".to_string(),
                        class: Some("nav-link".to_string()),
                        active_class: Some("nav-link--active".to_string())
                    }, vec![text("Examples")]),

                    NavLink(NavLinkProps {
                        to: "/playground".to_string(),
                        class: Some("nav-link".to_string()),
                        active_class: Some("nav-link--active".to_string())
                    }, vec![text("Playground")])
                ])
                ·build(),

            // Right side actions
            div()
                ·class("header-actions")
                ·children(vec![
                    // Search button
                    button()
                        ·class("search-trigger")
                        ·onclick(|| set_search_open(yea))
                        ·children(vec![
                            Icon { name: "search" },
                            span()·class("search-shortcut")·text("⌘K")·build()
                        ])
                        ·build(),

                    // Theme toggle
                    button()
                        ·class("theme-toggle")
                        ·onclick(props.on_theme_toggle)
                        ·child(Icon {
                            name: match theme {
                                Theme::Light => "moon",
                                Theme::Dark => "sun",
                                Theme::System => "monitor"
                            }
                        })
                        ·build(),

                    // GitHub link
                    a()
                        ·attr("href", "https://github.com/daemoniorum")
                        ·attr("target", "_blank")
                        ·class("github-link")
                        ·child(Icon { name: "github" })
                        ·build(),

                    // Mobile menu toggle
                    button()
                        ·class("mobile-menu-toggle")
                        ·onclick(props.on_menu_toggle)
                        ·child(Icon { name: "menu" })
                        ·build()
                ])
                ·build(),

            // Search modal
            when(search_open, || {
                SearchModal {
                    on_close: || set_search_open(nay)
                }
            })
        ])
        ·build()
}

☉ sigil HeaderProps {
    ☉ on_menu_toggle: fn()
    ☉ on_theme_toggle: fn()
}

/// Sidebar navigation
☉ rite Sidebar(props: SidebarProps) → VNode! {
    aside()
        ·class("docs-sidebar")
        ·children(vec![
            nav()
                ·class("sidebar-nav")
                ·children(
                    props.items·iter()
                        ·map(|item| SidebarNavItem {
                            item: item·clone(),
                            current_path: props.current_path·clone(),
                            on_navigate: props.on_navigate
                        })
                        ·collect()
                )
                ·build()
        ])
        ·build()
}

☉ sigil SidebarProps {
    ☉ items: Vec<SidebarItem>!
    ☉ current_path: String!
    ☉ on_navigate: fn()
}

rite SidebarNavItem(props: { item: SidebarItem, current_path: String, on_navigate: fn() }) → VNode! {
    let (expanded, set_expanded) = use_state(
        props.current_path·starts_with(&props.item.path)
    )
    ≔ has_children! = !props.item.children·is_empty()
    ≔ is_active! = props.current_path == props.item.path

    div()
        ·class(classes()
            ·add("sidebar-item")
            ·add_if(is_active, "sidebar-item--active")
            ·add_if(expanded, "sidebar-item--expanded")
            ·to_string())
        ·children(vec![
            // Item link or button
            ⎇ has_children {
                button()
                    ·class("sidebar-item-toggle")
                    ·onclick(|| set_expanded(!expanded))
                    ·children(vec![
                        when(props.item.icon·is_some(), || {
                            Icon { name: &props.item.icon·clone()·unwrap() }
                        }),
                        span()·class("sidebar-item-title")·text(&props.item.title)·build(),
                        Icon { name: ⎇ expanded { "chevron-down" } ⎉ { "chevron-right" } }
                    ])
                    ·build()
            } ⎉ {
                Link(LinkProps {
                    to: props.item.path·clone(),
                    replace: nay,
                    class: Some("sidebar-item-link".to_string()),
                    active_class: Some("sidebar-item-link--active".to_string())
                }, vec![
                    when(props.item.icon·is_some(), || {
                        Icon { name: &props.item.icon·clone()·unwrap() }
                    }),
                    span()·class("sidebar-item-title")·text(&props.item.title)·build(),
                    when(props.item.badge·is_some(), || {
                        Badge { text: &props.item.badge·clone()·unwrap() }
                    })
                ])
            },

            // Children
            when(has_children && expanded, || {
                div()
                    ·class("sidebar-children")
                    ·children(
                        props.item.children·iter()
                            ·map(|child| SidebarNavItem {
                                item: child·clone(),
                                current_path: props.current_path·clone(),
                                on_navigate: props.on_navigate
                            })
                            ·collect()
                    )
                    ·build()
            })
        ])
        ·build()
}

/// Breadcrumb navigation
☉ rite Breadcrumbs(props: { path: String }) → VNode! {
    ≔ segments! = props.path·split('/')
        ·filter(|s| !s·is_empty())
        ·collect::<Vec<_>>()

    nav()
        ·class("breadcrumbs")
        ·attr("aria-label", "Breadcrumb")
        ·children(vec![
            ol()
                ·class("breadcrumb-list")
                ·children({
                    ≔ vary items! = vec![
                        li()
                            ·class("breadcrumb-item")
                            ·child(Link(LinkProps {
                                to: "/".to_string(),
                                replace: nay,
                                class: Some("breadcrumb-link".to_string()),
                                active_class: None
                            }, vec![text("Home")]))
                            ·build()
                    ]

                    ≔ vary path_acc! = String::new()
                    for (i, segment) in segments·iter()·enumerate() {
                        path_acc·push('/')
                        path_acc·push_str(segment)

                        ≔ is_last! = i == segments·len() - 1
                        ≔ title! = segment·replace('-', " ")·to_title_case()

                        items·push(
                            li()
                                ·class("breadcrumb-item")
                                ·children(vec![
                                    span()·class("breadcrumb-separator")·text("/")·build(),
                                    ⎇ is_last {
                                        span()·class("breadcrumb-current")·text(&title)·build()
                                    } ⎉ {
                                        Link(LinkProps {
                                            to: path_acc·clone(),
                                            replace: nay,
                                            class: Some("breadcrumb-link".to_string()),
                                            active_class: None
                                        }, vec![text(&title)])
                                    }
                                ])
                                ·build()
                        )
                    }

                    items
                })
                ·build()
        ])
        ·build()
}

/// Table of contents
☉ rite TableOfContents(props: { headings: Vec<TocItem> }) → VNode! {
    let (active_id, set_active_id) = use_state("")

    // Track scroll position to highlight current section
    use_effect(|| {
        ≔ observer! = IntersectionObserver::new(|entries| {
            for entry in entries {
                ⎇ entry·is_intersecting() {
                    set_active_id(entry·target_id())
                }
            }
        }, IntersectionOptions {
            root_margin: "-100px 0px -66%".to_string(),
            ..IntersectionOptions::default()
        })

        // Observe all headings
        None
    }, [])

    nav()
        ·class("toc")
        ·attr("aria-label", "On this page")
        ·children(vec![
            h4()·class("toc-title")·text("On this page")·build(),
            ul()
                ·class("toc-list")
                ·children(
                    props.headings·iter()
                        ·map(|item| TocLink {
                            item: item·clone(),
                            active_id: active_id·clone()
                        })
                        ·collect()
                )
                ·build()
        ])
        ·build()
}

rite TocLink(props: { item: TocItem, active_id: String }) → VNode! {
    ≔ is_active! = props.active_id == props.item.anchor

    li()
        ·class(classes()
            ·add("toc-item")
            ·add(&format!("toc-item--level-{}", props.item.level))
            ·add_if(is_active, "toc-item--active")
            ·to_string())
        ·children(vec![
            a()
                ·attr("href", &format!("#{}", props.item.anchor))
                ·class("toc-link")
                ·text(&props.item.title)
                ·build(),
            when(!props.item.children·is_empty(), || {
                ul()
                    ·class("toc-sublist")
                    ·children(
                        props.item.children·iter()
                            ·map(|child| TocLink {
                                item: child·clone(),
                                active_id: props.active_id·clone()
                            })
                            ·collect()
                    )
                    ·build()
            })
        ])
        ·build()
}

/// Previous/Next page navigation
☉ rite PageNavigation(props: { prev: Option<PageLink>?, next: Option<PageLink>? }) → VNode! {
    nav()
        ·class("page-nav")
        ·children(vec![
            when(props.prev·is_some(), || {
                ≔ prev! = props.prev·clone()·unwrap()
                Link(LinkProps {
                    to: prev.path,
                    replace: nay,
                    class: Some("page-nav-link page-nav-prev".to_string()),
                    active_class: None
                }, vec![
                    Icon { name: "arrow-left" },
                    div()
                        ·class("page-nav-content")
                        ·children(vec![
                            span()·class("page-nav-label")·text("Previous")·build(),
                            span()·class("page-nav-title")·text(&prev.title)·build()
                        ])
                        ·build()
                ])
            }),

            when(props.next·is_some(), || {
                ≔ next! = props.next·clone()·unwrap()
                Link(LinkProps {
                    to: next.path,
                    replace: nay,
                    class: Some("page-nav-link page-nav-next".to_string()),
                    active_class: None
                }, vec![
                    div()
                        ·class("page-nav-content")
                        ·children(vec![
                            span()·class("page-nav-label")·text("Next")·build(),
                            span()·class("page-nav-title")·text(&next.title)·build()
                        ])
                        ·build(),
                    Icon { name: "arrow-right" }
                ])
            })
        ])
        ·build()
}

