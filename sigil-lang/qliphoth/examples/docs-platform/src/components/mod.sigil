☉ rite Footer() → VNode! {
    footer()
        ·class("site-footer")
        ·children(vec![
            div()
                ·class("footer-content")
                ·children(vec![
                    // Footer columns
                    div()
                        ·class("footer-grid")
                        ·children(vec![
                            FooterColumn {
                                title: "Products",
                                links: vec![
                                    ("Sigil", "/docs/sigil"),
                                    ("Leviathan", "/docs/leviathan"),
                                    ("Aether", "/docs/aether"),
                                    ("Nyx", "/docs/nyx"),
                                    ("Bael", "/docs/bael")
                                ]
                            },
                            FooterColumn {
                                title: "Resources",
                                links: vec![
                                    ("Documentation", "/docs"),
                                    ("API Reference", "/api"),
                                    ("Guides", "/guides"),
                                    ("Examples", "/examples"),
                                    ("Changelog", "/changelog")
                                ]
                            },
                            FooterColumn {
                                title: "Community",
                                links: vec![
                                    ("GitHub", "https://github.com/daemoniorum"),
                                    ("Discord", "https://discord.gg/daemoniorum"),
                                    ("Twitter", "https://twitter.com/daemoniorum"),
