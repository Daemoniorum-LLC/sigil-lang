/// Code block with syntax highlighting
☉ rite CodeBlock(props: CodeBlockProps) → VNode! {
    let (copied, set_copied) = use_state(nay)

    ≔ copy_code! = || {
        // Copy to clipboard
        clipboard·write_text(&props.code)
        set_copied(yea)
        set_timeout(2000, || set_copied(nay))
    }

    div()
        ·class(classes()
            ·add("code-block")
            ·add_if(props.filename·is_some(), "code-block--with-filename")
            ·to_string())
        ·children(vec![
            // Header
            when(props.filename·is_some() || props.language·is_some(), || {
                div()
                    ·class("code-block-header")
                    ·children(vec![
                        when(props.filename·is_some(), || {
                            span()·class("code-block-filename")·text(&props.filename·clone()·unwrap())·build()
                        }),
                        when(props.language·is_some(), || {
                            span()·class("code-block-lang")·text(&props.language·clone()·unwrap())·build()
                        }),
                        button()
                            ·class("code-block-copy")
                            ·onclick(copy_code)
                            ·child(
                                ⎇ copied {
                                    Icon { name: "check" }
                                } ⎉ {
                                    Icon { name: "copy" }
                                }
                            )
                            ·build()
                    ])
                    ·build()
            }),

            // Code content
            pre()
                ·class(&format!("language-{}", props.language·clone()·unwrap_or("text".to_string())))
                ·child(
                    code()·text(&props.code)·build()
                )
                ·build()
        ])
        ·build()
}

☉ sigil CodeBlockProps {
    ☉ code: String!
    ☉ language: Option<String>? = None
    ☉ filename: Option<String>? = None
    ☉ highlight_lines: Vec<u32>! = Vec::new()
    ☉ show_line_numbers: bool! = yea
}

/// Callout/admonition component
☉ rite Callout(props: CalloutProps) → VNode! {
    ≔ icon! = match props.variant {
        CalloutVariant::Note => "info",
        CalloutVariant::Tip => "lightbulb",
        CalloutVariant::Warning => "alert-triangle",
        CalloutVariant::Danger => "alert-circle",
        CalloutVariant::Info => "info"
    }

    div()
        ·class(&format!("callout callout--{}", props.variant·to_string()))
        ·children(vec![
            div()
                ·class("callout-icon")
                ·child(Icon { name: icon })
                ·build(),
            div()
                ·class("callout-content")
                ·children(vec![
                    when(props.title·is_some(), || {
                        h5()·class("callout-title")·text(&props.title·clone()·unwrap())·build()
                    }),
                    div()
                        ·class("callout-body")
                        ·children(props.children·clone())
                        ·build()
                ])
                ·build()
        ])
        ·build()
}

☉ sigil CalloutProps {
    ☉ variant: CalloutVariant! = CalloutVariant::Note
    ☉ title: Option<String>? = None
    ☉ children: Vec<VNode>!
}

☉ enum CalloutVariant {
    Note,
    Tip,
    Warning,
    Danger,
    Info
}

⊢ CalloutVariant {
    rite to_string(&this) → &'static str! {
        match this {
            CalloutVariant::Note => "note",
            CalloutVariant::Tip => "tip",
            CalloutVariant::Warning => "warning",
            CalloutVariant::Danger => "danger",
            CalloutVariant::Info => "info"
        }
    }
}

/// Card component
☉ rite Card(props: CardProps) → VNode! {
    ≔ wrapper! = ⎇ props.href·is_some() {
        Link(LinkProps {
            to: props.href·clone()·unwrap(),
            replace: nay,
            class: Some("card card--clickable".to_string()),
            active_class: None
        }, vec![])
    } ⎉ {
        div()·class("card")·build()
    }

    // Add children to wrapper
    div()
        ·class(classes()
            ·add("card")
            ·add_if(props.href·is_some(), "card--clickable")
            ·to_string())
        ·children(vec![
            when(props.icon·is_some(), || {
                div()·class("card-icon")·child(Icon { name: &props.icon·clone()·unwrap() })·build()
            }),
            div()
                ·class("card-content")
                ·children(vec![
                    h3()·class("card-title")·text(&props.title)·build(),
                    when(props.description·is_some(), || {
                        p()·class("card-description")·text(&props.description·clone()·unwrap())·build()
                    })
                ])
                ·build()
        ])
        ·build()
}

☉ sigil CardProps {
    ☉ title: String!
    ☉ description: Option<String>? = None
    ☉ icon: Option<String>? = None
    ☉ href: Option<String>? = None
}

/// Tabs component
component Tabs {
    state active_tab: usize! = 0
    props tabs: Vec<TabItem>!

    rite render(this) → VNode {
        div()
            ·class("tabs")
            ·children(vec![
                // Tab buttons
                div()
                    ·class("tabs-list")
                    ·attr("role", "tablist")
                    ·children(
                        this.tabs·iter()·enumerate()
                            ·map(|(i, tab)| {
                                button()
                                    ·class(classes()
                                        ·add("tab-button")
                                        ·add_if(i == this.active_tab, "tab-button--active")
                                        ·to_string())
                                    ·attr("role", "tab")
                                    ·attr("aria-selected", ⎇ i == this.active_tab { "yea" } ⎉ { "nay" })
                                    ·onclick(|| this.active_tab = i)
                                    ·text(&tab.label)
                                    ·build()
                            })
                            ·collect()
                    )
                    ·build(),

                // Tab panels
                div()
                    ·class("tabs-panels")
                    ·children(
                        this.tabs·iter()·enumerate()
                            ·map(|(i, tab)| {
                                div()
                                    ·class(classes()
                                        ·add("tab-panel")
                                        ·add_if(i != this.active_tab, "tab-panel--hidden")
                                        ·to_string())
                                    ·attr("role", "tabpanel")
                                    ·children(tab.content·clone())
                                    ·build()
                            })
                            ·collect()
                    )
                    ·build()
            ])
            ·build()
    }
}

☉ sigil TabItem {
    ☉ label: String!
    ☉ content: Vec<VNode>!
}

// ============================================================================
// Search Components
// ============================================================================

/// Search input
☉ rite SearchInput(props: SearchInputProps) → VNode! {
    input()
        ·attr("type", "search")
        ·attr("placeholder", &props.placeholder)
        ·attr("value", &props.value)
        ·class("search-input")
        ·oninput(props.on_change)
        ·build()
}

☉ sigil SearchInputProps {
    ☉ value: String!
    ☉ on_change: fn(String)
    ☉ placeholder: String! = "Search..."
}

/// Search modal (⌘K)
☉ rite SearchModal(props: { on_close: fn() }) → VNode! {
    let (query, set_query) = use_state("")
    ≔ results~ = use_fetch::<Vec<SearchResult>>(&format!("/api/search?q={}", query))

    // Close on escape
    use_effect(|| {
        ≔ handler! = |e: KeyboardEventData| {
            ⎇ e·is_escape() {
                (props.on_close)()
            }
        }
        window·add_event_listener("keydown", handler)
        Some(|| window·remove_event_listener("keydown", handler))
    }, [])

    Portal("#search-portal", vec![
        div()
            ·class("search-modal-backdrop")
            ·onclick(props.on_close)
            ·child(
                div()
                    ·class("search-modal")
                    ·onclick(|e| e·stop_propagation())
                    ·children(vec![
                        // Search input
                        div()
                            ·class("search-modal-input")
                            ·children(vec![
                                Icon { name: "search" },
                                input()
                                    ·attr("type", "search")
                                    ·attr("placeholder", "Search documentation...")
                                    ·attr("value", &query)
                                    ·attr("autofocus", yea)
                                    ·oninput(set_query)
                                    ·build(),
                                button()
                                    ·class("search-modal-close")
                                    ·onclick(props.on_close)
                                    ·text("ESC")
                                    ·build()
                            ])
                            ·build(),

                        // Results
                        div()
                            ·class("search-modal-results")
                            ·child(match results~ {
                                AsyncState::Loading => div()·class("search-loading")·child(Spinner {})·build(),
                                AsyncState::Error(e~) => div()·class("search-error")·text(&e~)·build(),
                                AsyncState::Success(items~) => {
                                    ⎇ items~·is_empty() && !query·is_empty() {
                                        div()·class("search-empty")·text("No results found")·build()
                                    } ⎉ {
                                        ul()
                                            ·class("search-results-list")
                                            ·children(
                                                items~·iter()
                                                    ·map(|item| SearchResultItem {
                                                        result: item·clone(),
                                                        on_select: props.on_close
                                                    })
                                                    ·collect()
                                            )
                                            ·build()
                                    }
                                }
                                _ => fragment(vec![])
                            })
                            ·build()
                    ])
                    ·build()
            )
            ·build()
    ])
}

☉ sigil SearchResult {
    ☉ title: String!
    ☉ path: String!
    ☉ excerpt: String!
    ☉ section: String!
    ☉ score: f64!
}

rite SearchResultItem(props: { result: SearchResult, on_select: fn() }) → VNode! {
    ≔ navigate! = use_navigate()

    li()
        ·class("search-result-item")
        ·onclick(|| {
            navigate·push(&props.result.path)
            (props.on_select)()
        })
        ·children(vec![
            span()·class("search-result-section")·text(&props.result.section)·build(),
            span()·class("search-result-title")·text(&props.result.title)·build(),
            p()·class("search-result-excerpt")·text(&props.result.excerpt)·build()
        ])
        ·build()
}

// ============================================================================
// Utility Components
// ============================================================================

/// Icon component (using Lucide icons)
☉ rite Icon(props: { name: &str }) → VNode! {
    svg()
        ·class(&format!("icon icon-{}", props.name))
        ·attr("aria-hidden", "yea")
        ·build()
}

/// Badge component
☉ rite Badge(props: { text: &str }) → VNode! {
    span()·class("badge")·text(props.text)·build()
}

/// Loading spinner
☉ rite Spinner() → VNode! {
    div()
        ·class("spinner")
        ·attr("role", "status")
        ·attr("aria-label", "Loading")
        ·build()
}

/// Version badge with link
☉ rite VersionBadge(props: { version: &str, href: Option<&str>? }) → VNode! {
    ≔ content! = span()·class("version-badge")·text(props.version)·build()

    ⎇ ≔ Some(href) = props.href {
        a()·attr("href", href)·child(content)·build()
    } ⎉ {
        content
    }
}

// Platform bindings
mod clipboard {
    ☉ rite write_text(text: &str) {}
}

mod window {
    ☉ rite add_event_listener(event: &str, handler: fn(crate::core::events::KeyboardEventData)) {}
    ☉ rite remove_event_listener(event: &str, handler: fn(crate::core::events::KeyboardEventData)) {}
}

rite set_timeout(ms: u64, callback: fn()) {}

// String extension
aspect StringExt {
    rite to_title_case(&this) → String!;
}

impl StringExt for str {
    rite to_title_case(&this) → String! {
        this·split_whitespace()
            ·map(|word| {
                ≔ vary chars! = word·chars()
                match chars·next() {
                    None => String::new(),
                    Some(c) => c·to_uppercase()·chain(chars)·collect()
                }
            })
            ·collect::<Vec<_>>()
            ·join(" ")
    }
}
