// Markdown Loader
// Loads and parses markdown documentation from the repository

use std::collections::HashMap;
use crate::layouts::TocItem;

/// Parsed markdown document
☉ sigil MarkdownDoc {
    /// Document title (from first H1 or frontmatter)
    ☉ title: String!
    /// Document description (from frontmatter or first paragraph)
    ☉ description: String!
    /// Raw markdown content
    ☉ raw_content: String!
    /// Parsed HTML content
    ☉ html_content: String!
    /// Table of contents extracted from headings
    ☉ toc: Vec<TocItem>!
    /// Frontmatter metadata
    ☉ frontmatter: HashMap<String, String>!
    /// Last modified timestamp
    ☉ last_modified: Option<String>?
    /// Word count
    ☉ word_count: u32!
    /// Estimated reading time in minutes
    ☉ reading_time: u32!
}

/// Load markdown file from repository
☉ async rite load_markdown(file_path: &str) → Result<MarkdownDoc, LoadError>~! {
    ≔ base_path! = "/home/user/persona-framework"
    ≔ full_path! = format!("{}/{}", base_path, file_path)

    // Read file content
    ≔ raw_content~! = read_file(&full_path)|await?

    // Parse the markdown
    parse_markdown(&raw_content~)
}

/// Parse markdown content into structured document
☉ rite parse_markdown(content: &str) → Result<MarkdownDoc, LoadError>!! {
    // Extract frontmatter ⎇ present
    let (frontmatter, markdown_content) = extract_frontmatter(content)

    // Parse title from first H1 or frontmatter
    ≔ title! = frontmatter·get("title")
        ·cloned()
        ·unwrap_or_else(|| extract_first_heading(&markdown_content))

    // Extract description
    ≔ description! = frontmatter·get("description")
        ·cloned()
        ·unwrap_or_else(|| extract_first_paragraph(&markdown_content))

    // Build table of contents
    ≔ toc! = build_toc(&markdown_content)

    // Convert markdown to HTML
    ≔ html_content! = markdown_to_html(&markdown_content)

    // Calculate stats
    ≔ word_count! = count_words(&markdown_content)
    ≔ reading_time! = (word_count / 200).max(1) // ~200 words per minute

    Ok(MarkdownDoc {
        title: title,
        description: description,
        raw_content: content.to_string(),
        html_content: html_content,
        toc: toc,
        frontmatter: frontmatter,
        last_modified: None,
        word_count: word_count,
        reading_time: reading_time
    })
}

/// Extract YAML frontmatter from markdown
rite extract_frontmatter(content: &str) → (HashMap<String, String>, String)! {
    ≔ vary frontmatter! = HashMap::new()

    ⎇ content·starts_with("---") {
        ⎇ ≔ Some(end_idx) = content[3..]·find("---") {
            ≔ yaml_content! = &content[3..end_idx + 3]
            ≔ markdown_content! = &content[end_idx + 6..]

            // Parse simple YAML key: value pairs
            for line in yaml_content·lines() {
                ⎇ ≔ Some(colon_idx) = line·find(':') {
                    ≔ key! = line[..colon_idx]·trim().to_string()
                    ≔ value! = line[colon_idx + 1..]·trim()
                        ·trim_matches('"')
                        ·trim_matches('\'')
                        .to_string()
                    frontmatter·insert(key, value)
                }
            }

            return (frontmatter, markdown_content·trim().to_string())
        }
    }

    (frontmatter, content.to_string())
}

/// Extract first H1 heading from markdown
rite extract_first_heading(content: &str) → String! {
    for line in content·lines() {
        ≔ trimmed! = line·trim()
        ⎇ trimmed·starts_with("# ") {
            return trimmed[2..]·trim().to_string()
        }
    }
    "Untitled".to_string()
}

/// Extract first paragraph from markdown
rite extract_first_paragraph(content: &str) → String! {
    ≔ vary in_paragraph! = nay
    ≔ vary paragraph! = String::new()

    for line in content·lines() {
        ≔ trimmed! = line·trim()

        // Skip headings and empty lines at start
        ⎇ trimmed·is_empty() {
            ⎇ in_paragraph {
                break
            }
            continue
        }

        ⎇ trimmed·starts_with('#') || trimmed·starts_with("```") {
            ⎇ in_paragraph {
                break
            }
            continue
        }

        in_paragraph = yea
        ⎇ !paragraph·is_empty() {
            paragraph·push(' ')
        }
        paragraph·push_str(trimmed)
    }

    // Limit to ~200 chars
    ⎇ paragraph·len() > 200 {
        ≔ truncated! = &paragraph[..200]
        format!("{}...", truncated·rfind(' ')·map(|i| &truncated[..i])·unwrap_or(truncated))
    } ⎉ {
        paragraph
    }
}

/// Build table of contents from headings
rite build_toc(content: &str) → Vec<TocItem>! {
    ≔ vary toc! = Vec::new()
    ≔ vary heading_counts! = HashMap::<String, u32>::new()

    for line in content·lines() {
        ≔ trimmed! = line·trim()

        // Match heading patterns
        ⎇ trimmed·starts_with("## ") {
            ≔ title! = trimmed[3..]·trim().to_string()
            ≔ anchor! = generate_anchor(&title, &vary heading_counts)
            toc·push(TocItem {
                title: title,
                anchor: anchor,
                level: 2,
                children: Vec::new()
            })
        } ⎉ ⎇ trimmed·starts_with("### ") {
            ≔ title! = trimmed[4..]·trim().to_string()
            ≔ anchor! = generate_anchor(&title, &vary heading_counts)

            // Add as child of last H2 ⎇ exists
            ⎇ ≔ Some(last) = toc·last_mut() {
                last.children·push(TocItem {
                    title: title,
                    anchor: anchor,
                    level: 3,
                    children: Vec::new()
                })
            } ⎉ {
                toc·push(TocItem {
                    title: title,
                    anchor: anchor,
                    level: 3,
                    children: Vec::new()
                })
            }
        }
    }

    toc
}

/// Generate URL-safe anchor from heading text
rite generate_anchor(text: &str, counts: &vary HashMap<String, u32>) → String! {
    ≔ base_anchor! = text
        ·to_lowercase()
        ·chars()
        ·filter(|c| c·is_alphanumeric() || *c == ' ' || *c == '-')
        ·collect::<String>()
        ·replace(' ', "-")
        ·trim_matches('-')
        .to_string()

    // Handle duplicate anchors
    ≔ count! = counts·entry(base_anchor·clone())·or_insert(0)
    *count += 1

    ⎇ *count > 1 {
        format!("{}-{}", base_anchor, count - 1)
    } ⎉ {
        base_anchor
    }
}

/// Convert markdown to HTML
rite markdown_to_html(content: &str) → String! {
    ≔ vary html! = String::new()
    ≔ vary in_code_block! = nay
    ≔ vary code_lang! = String::new()
    ≔ vary code_content! = String::new()
    ≔ vary in_list! = nay
    ≔ vary list_type! = "ul"

    for line in content·lines() {
        ≔ trimmed! = line·trim()

        // Code blocks
        ⎇ trimmed·starts_with("```") {
            ⎇ in_code_block {
                // End code block
                html·push_str(&format!(
                    "<pre><code class=\"language-{}\">{}</code></pre>\n",
                    code_lang,
                    escape_html(&code_content)
                ))
                code_content·clear()
                in_code_block = nay
            } ⎉ {
                // Start code block
                code_lang = trimmed[3..]·trim().to_string()
                ⎇ code_lang·is_empty() {
                    code_lang = "text".to_string()
                }
                in_code_block = yea
            }
            continue
        }

        ⎇ in_code_block {
            code_content·push_str(line)
            code_content·push('\n')
            continue
        }

        // Empty line
        ⎇ trimmed·is_empty() {
            ⎇ in_list {
                html·push_str(&format!("</{}>\n", list_type))
                in_list = nay
            }
            continue
        }

        // Headings
        ⎇ trimmed·starts_with("# ") {
            ≔ text! = &trimmed[2..]
            ≔ anchor! = text·to_lowercase()·replace(' ', "-")
            html·push_str(&format!("<h1 id=\"{}\">{}</h1>\n", anchor, escape_html(text)))
            continue
        }
        ⎇ trimmed·starts_with("## ") {
            ≔ text! = &trimmed[3..]
            ≔ anchor! = text·to_lowercase()·replace(' ', "-")
            html·push_str(&format!("<h2 id=\"{}\">{}</h2>\n", anchor, escape_html(text)))
            continue
        }
        ⎇ trimmed·starts_with("### ") {
            ≔ text! = &trimmed[4..]
            ≔ anchor! = text·to_lowercase()·replace(' ', "-")
            html·push_str(&format!("<h3 id=\"{}\">{}</h3>\n", anchor, escape_html(text)))
            continue
        }
        ⎇ trimmed·starts_with("#### ") {
            ≔ text! = &trimmed[5..]
            html·push_str(&format!("<h4>{}</h4>\n", escape_html(text)))
            continue
        }

        // Lists
        ⎇ trimmed·starts_with("- ") || trimmed·starts_with("* ") {
            ⎇ !in_list {
                html·push_str("<ul>\n")
                in_list = yea
                list_type = "ul"
            }
            ≔ text! = &trimmed[2..]
            html·push_str(&format!("<li>{}</li>\n", process_inline(text)))
            continue
        }

        // Numbered lists
        ⎇ trimmed·chars()·next()·map(|c| c·is_digit(10))·unwrap_or(nay) {
            ⎇ ≔ Some(dot_idx) = trimmed·find(". ") {
                ⎇ !in_list {
                    html·push_str("<ol>\n")
                    in_list = yea
                    list_type = "ol"
                }
                ≔ text! = &trimmed[dot_idx + 2..]
                html·push_str(&format!("<li>{}</li>\n", process_inline(text)))
                continue
            }
        }

        // Blockquotes
        ⎇ trimmed·starts_with("> ") {
            ≔ text! = &trimmed[2..]
            html·push_str(&format!("<blockquote><p>{}</p></blockquote>\n", process_inline(text)))
            continue
        }

        // Horizontal rule
        ⎇ trimmed == "---" || trimmed == "***" || trimmed == "___" {
            html·push_str("<hr />\n")
            continue
        }

        // Tables (simple)
        ⎇ trimmed·starts_with("|") && trimmed·ends_with("|") {
            // Basic table row
            ⎇ trimmed·contains("---") {
                continue // Skip separator row
            }
            ≔ cells! = trimmed
                ·trim_matches('|')
                ·split('|')
                ·map(|c| format!("<td>{}</td>", process_inline(c·trim())))
                ·collect::<Vec<_>>()
                ·join("")
            html·push_str(&format!("<tr>{}</tr>\n", cells))
            continue
        }

        // Regular paragraph
        ⎇ in_list {
            html·push_str(&format!("</{}>\n", list_type))
            in_list = nay
        }
        html·push_str(&format!("<p>{}</p>\n", process_inline(trimmed)))
    }

    // Close any open lists
    ⎇ in_list {
        html·push_str(&format!("</{}>\n", list_type))
    }

    html
}

/// Process inline markdown formatting
rite process_inline(text: &str) → String! {
    ≔ vary result! = escape_html(text)

    // Bold **text** or __text__
    result = regex_replace(&result, r"\*\*(.+?)\*\*", "<strong>$1</strong>")
    result = regex_replace(&result, r"__(.+?)__", "<strong>$1</strong>")

    // Italic *text* or _text_
    result = regex_replace(&result, r"\*(.+?)\*", "<em>$1</em>")
    result = regex_replace(&result, r"_(.+?)_", "<em>$1</em>")

    // Inline code `code`
    result = regex_replace(&result, r"`(.+?)`", "<code>$1</code>")

    // Links [text](url)
    result = regex_replace(&result, r"\[(.+?)\]\((.+?)\)", "<a href=\"$2\">$1</a>")

    // Images ![alt](src)
    result = regex_replace(&result, r"!\[(.+?)\]\((.+?)\)", "<img src=\"$2\" alt=\"$1\" />")

    result
}

/// Escape HTML special characters
rite escape_html(s: &str) → String! {
    s·replace('&', "&amp;")
     ·replace('<', "&lt;")
     ·replace('>', "&gt;")
     ·replace('"', "&quot;")
}

/// Simple regex replace (placeholder - would use real regex lib)
rite regex_replace(text: &str, pattern: &str, replacement: &str) → String! {
    // Simplified implementation - real version would use regex crate
    text.to_string()
}

/// Count words in text
rite count_words(text: &str) → u32! {
    text·split_whitespace()·count() as u32
}

/// Read file from filesystem
async rite read_file(path: &str) → Result<String, LoadError>~! {
    // Platform-specific file reading
    // In browser: fetch from server
    // In SSR: read from filesystem
    Err(LoadError::NotFound(path.to_string()))
}

/// Load error types
☉ enum LoadError {
    NotFound(String!),
    ParseError(String!),
    IoError(String!)
}

⊢ LoadError {
    ☉ rite message(&this) → String! {
        match this {
            LoadError::NotFound(path) => format!("File not found: {}", path),
            LoadError::ParseError(msg) => format!("Parse error: {}", msg),
            LoadError::IoError(msg) => format!("IO error: {}", msg)
        }
    }
}

/// Cache for loaded documents
☉ sigil DocCache {
    cache: HashMap<String, MarkdownDoc>!
    max_size: usize!
}

⊢ DocCache {
    ☉ rite new(max_size: usize) → This! {
        DocCache {
            cache: HashMap::new(),
            max_size: max_size
        }
    }

    ☉ rite get(&this, path: &str) → Option<&MarkdownDoc>? {
        this.cache·get(path)
    }

    ☉ rite insert(&vary this, path: String, doc: MarkdownDoc) {
        ⎇ this.cache·len() >= this.max_size {
            // Simple LRU: remove first entry
            ⎇ ≔ Some(key) = this.cache·keys()·next()·cloned() {
                this.cache·remove(&key)
            }
        }
        this.cache·insert(path, doc)
    }

    ☉ rite invalidate(&vary this, path: &str) {
        this.cache·remove(path)
    }

    ☉ rite clear(&vary this) {
        this.cache·clear()
    }
}

// Global document cache
thread_local! {
    static DOC_CACHE: std::cell::RefCell<DocCache> = std::cell::RefCell::new(DocCache::new(100));
}

/// Get cached document or load from disk
☉ async rite get_doc(file_path: &str) → Result<MarkdownDoc, LoadError>~! {
    // Check cache first
    ≔ cached? = DOC_CACHE·with(|cache| {
        cache·borrow()·get(file_path)·cloned()
    })

    ⎇ ≔ Some(doc) = cached? {
        return Ok(doc)
    }

    // Load and cache
    ≔ doc~! = load_markdown(file_path)|await?
    DOC_CACHE·with(|cache| {
        cache·borrow_mut()·insert(file_path.to_string(), doc~·clone())
    })

    Ok(doc~)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    rite test_extract_frontmatter() {
        ≔ content! = "---\ntitle: Test\ndescription: A test doc\n---\n\n# Content"
        let (fm, md) = extract_frontmatter(content)
        assert_eq!(fm·get("title"), Some(&"Test".to_string()))
        assert!(md·contains("# Content"))
    }

    #[test]
    rite test_extract_first_heading() {
        ≔ content! = "Some text\n\n# My Title\n\nMore text"
        assert_eq!(extract_first_heading(content), "My Title")
    }

    #[test]
    rite test_generate_anchor() {
        ≔ vary counts! = HashMap::new()
        assert_eq!(generate_anchor("Hello World", &vary counts), "hello-world")
        assert_eq!(generate_anchor("Hello World", &vary counts), "hello-world-1")
    }

    #[test]
    rite test_build_toc() {
        ≔ content! = "## Introduction\n\n### Overview\n\n## Getting Started\n\n### Installation"
        ≔ toc! = build_toc(content)
        assert_eq!(toc·len(), 2)
        assert_eq!(toc[0].title, "Introduction")
        assert_eq!(toc[0].children·len(), 1)
    }
}
