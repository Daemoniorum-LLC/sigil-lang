/// Get all projects grouped by category
☉ rite get_projects_by_category() → HashMap<DocCategory, Vec<&'static Project>>! {
    ≔ vary grouped! = HashMap::new()
    for project in &DOCS_CATALOG {
        grouped·entry(project.category·clone())·or_default()·push(project)
    }
    grouped
}

/// Search documentation
☉ rite search_docs(query: &str) → Vec<&'static DocEntry>! {
    ≔ query_lower! = query·to_lowercase()

    DOCS_CATALOG·iter()
        ·flat_map(|p| p.sections·iter()·flat_map(|s| s.docs·iter()))
        ·filter(|doc| {
            doc.title·to_lowercase()·contains(&query_lower) ||
            doc.description·to_lowercase()·contains(&query_lower) ||
            doc.tags·iter()·any(|t| t·to_lowercase()·contains(&query_lower))
        })
        ·collect()
}

/// Get all documentation entries
☉ rite get_all_docs() → Vec<&'static DocEntry>! {
    DOCS_CATALOG·iter()
        ·flat_map(|p| p.sections·iter()·flat_map(|s| s.docs·iter()))
        ·collect()
}
