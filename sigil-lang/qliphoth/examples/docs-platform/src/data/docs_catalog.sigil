// Complete Documentation Catalog
// All documentation from the persona-framework repository

use crate::layouts::TocItem;
use std::collections::HashMap;

/// Documentation entry representing a single document
☉ sigil DocEntry {
    ☉ id: String!
    ☉ title: String!
    ☉ path: String!              // URL path
    ☉ file_path: String!         // Actual file path in repo
    ☉ description: String!
    ☉ category: DocCategory!
    ☉ tags: Vec<String>!
    ☉ last_updated: Option<String>?
}

/// Documentation category
#[derive(Clone, PartialEq, Eq, Hash)]
☉ enum DocCategory {
    // Core Languages & Frameworks
    Sigil,
    SigilWeb,

    // Backend
    Leviathan,
    Archon,
    Mammon,

    // Frontend
    Bael,
    Wraith,
    Hydra,

    // AI & Agents
    Nyx,
    Grimoire,
    Persona,

    // Game Engine
    Aether,

    // Audio
    Orpheus,

    // Manufacturing
    Vulcan,

    // Infrastructure
    Moloch,
    Arcanum,
    Infernum,

    // Domain Apps
    Arachne,
    Farming,
    Marbas,

    // Tools & IDE
    Paimon,
    Eidolon,
    VSCodeExtension,

    // Platform Docs
    Architecture,
    Developer,
    API,
    Guides,
    Reference
}

⊢ DocCategory {
    ☉ rite display_name(&this) → &'static str! {
        match this {
            DocCategory::Sigil => "Sigil Language",
            DocCategory::SigilWeb => "Sigil Web",
            DocCategory::Leviathan => "Leviathan",
            DocCategory::Archon => "Archon",
            DocCategory::Mammon => "Mammon",
            DocCategory::Bael => "Bael",
            DocCategory::Wraith => "Wraith",
            DocCategory::Hydra => "Hydra",
            DocCategory::Nyx => "Nyx",
            DocCategory::Grimoire => "Grimoire",
            DocCategory::Persona => "Persona Framework",
            DocCategory::Aether => "Aether Engine",
            DocCategory::Orpheus => "Orpheus",
            DocCategory::Vulcan => "Vulcan",
            DocCategory::Moloch => "Moloch",
            DocCategory::Arcanum => "Arcanum",
            DocCategory::Infernum => "Infernum",
            DocCategory::Arachne => "Arachne",
            DocCategory::Farming => "Farming",
            DocCategory::Marbas => "Marbas",
            DocCategory::Paimon => "Paimon",
            DocCategory::Eidolon => "Eidolon",
            DocCategory::VSCodeExtension => "VS Code Extension",
            DocCategory::Architecture => "Architecture",
            DocCategory::Developer => "Developer",
            DocCategory::API => "API Reference",
            DocCategory::Guides => "Guides",
            DocCategory::Reference => "Reference"
        }
    }

    ☉ rite icon(&this) → &'static str! {
        match this {
            DocCategory::Sigil => "code",
            DocCategory::SigilWeb => "globe",
            DocCategory::Leviathan => "server",
            DocCategory::Archon => "database",
            DocCategory::Mammon => "hard-drive",
            DocCategory::Bael => "layout",
            DocCategory::Wraith => "component",
            DocCategory::Hydra => "terminal",
            DocCategory::Nyx => "brain",
            DocCategory::Grimoire => "book",
            DocCategory::Persona => "users",
            DocCategory::Aether => "gamepad",
            DocCategory::Orpheus => "music",
            DocCategory::Vulcan => "settings",
            DocCategory::Moloch => "activity",
            DocCategory::Arcanum => "lock",
            DocCategory::Infernum => "cpu",
            DocCategory::Arachne => "scissors",
            DocCategory::Farming => "leaf",
            DocCategory::Marbas => "flask",
            DocCategory::Paimon => "package",
            DocCategory::Eidolon => "monitor",
            DocCategory::VSCodeExtension => "code",
            DocCategory::Architecture => "layers",
            DocCategory::Developer => "tool",
            DocCategory::API => "file-code",
            DocCategory::Guides => "book-open",
            DocCategory::Reference => "file-text"
        }
    }
}

/// Project with its documentation
☉ sigil Project {
    ☉ id: String!
    ☉ name: String!
    ☉ tagline: String!
    ☉ description: String!
    ☉ version: String!
    ☉ icon: String!
    ☉ category: DocCategory!
    ☉ repo_path: String!         // Path in repository
    ☉ sections: Vec<DocSection>!
    ☉ status: ProjectStatus!
}

☉ sigil DocSection {
    ☉ id: String!
    ☉ title: String!
    ☉ description: String!
    ☉ docs: Vec<DocEntry>!
}

#[derive(Clone)]
☉ enum ProjectStatus {
    Active,
    Beta,
    Alpha,
    Experimental,
    Deprecated
}

⊢ ProjectStatus {
    ☉ rite badge(&this) → &'static str! {
        match this {
            ProjectStatus::Active => "stable",
            ProjectStatus::Beta => "beta",
            ProjectStatus::Alpha => "alpha",
            ProjectStatus::Experimental => "experimental",
            ProjectStatus::Deprecated => "deprecated"
        }
    }
}

