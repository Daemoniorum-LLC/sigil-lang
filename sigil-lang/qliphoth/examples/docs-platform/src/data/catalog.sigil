        quick_start: r#"use moloch::prelude::*

#[event]
sigil OrderPlaced {
    order_id: String!
    customer_id: String!
    total: Decimal!
}

#[consumer]
async rite handle_order(event: OrderPlaced~) {
    // Process the order
    println!("Order {} placed by {}", event~.order_id, event~.customer_id)
}

rite main() {
    Moloch::new()
        .topic("orders")
        .consumer(handle_order)
        .run()
}"#.to_string(),
