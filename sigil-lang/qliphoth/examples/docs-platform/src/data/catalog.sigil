component Counter {
    state count: i64! = 0

    rite render(this) → VNode {
        div {
            h1 { "Count: {this.count}" }
            button[onclick: || this.count += 1] { "+" }
            button[onclick: || this.count -= 1] { "-" }
        }
    }
}

rite main() {
    App::mount("#root", Counter::new())
