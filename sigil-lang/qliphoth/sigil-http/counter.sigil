/// Qliphoth Counter Demo
/// A simple counter component showing Sigil's capabilities.

/// Counter state
☉ sigil Counter {
    count: !i64
}

⊢ Counter {
    /// Create a new counter
    ☉ rite new() → !Counter {
        Counter { count: 0 }
    }

    /// Increment the counter
    ☉ rite increment(&vary this) {
        this.count = this.count + 1;
    }

    /// Decrement the counter
    ☉ rite decrement(&vary this) {
        this.count = this.count - 1;
    }

    /// Get current count
    ☉ rite get(&this) → !i64 {
        this.count
    }

    /// Render as HTML string
    ☉ rite render(&this) → !String {
        format("<div class=\"counter\">
  <h1>Count: {}</h1>
  <button onclick=\"increment()\">+</button>
  <button onclick=\"decrement()\">-</button>
</div>", this.count)
    }
}

/// Main function - renders the counter component
rite main() {
    ≔ vary counter = Counter·new();

    println("Initial count:");
    println(counter.get());

    counter.increment();
    counter.increment();
    println("After two increments:");
    println(counter.get());

    counter.decrement();
    println("After one decrement:");
    println(counter.get());

    println("Rendered HTML:");
    println(counter.render());
}
