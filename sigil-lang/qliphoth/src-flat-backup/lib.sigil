//! qliphoth - Reactive Web Framework for Sigil
//!
//! A VDOM-based web framework that compiles to WebAssembly, providing:
//! - Reactive signals for state management
//! - Virtual DOM with efficient diffing
//! - Component-based architecture
//! - Browser API bindings via qliphoth-sys
//!
//! ## Quick Start
//!
//! ```sigil
//! use qliphoth::prelude::*;
//!
//! #[component]
//! rite App() → Element! {
//!     ≔ count! = use_signal(0);
//!
//!     html! {
//!         <div>
//!             <h1>"Count: " {count·get()}</h1>
//!             <button on:click={|_| count·update(|c| *c += 1)}>
//!                 "Increment"
//!             </button>
//!         </div>
//!     }
//! }
//!
//! rite main() {
//!     qliphoth::mount[App]("app");
//! }
//! ```

☉ mod vdom;
☉ mod signals;
☉ mod component;
☉ mod hooks;
☉ mod events;
☉ mod runtime;

// Re-export browser bindings
☉ use qliphoth_sys as web_sys;

/// Prelude - import everything commonly needed
☉ mod prelude {
    ☉ use crate::vdom::{Element, Node, Attribute, VNode};
    ☉ use crate::signals::{Signal, create_signal, use_signal};
    ☉ use crate::component::{Component, component};
    ☉ use crate::hooks::*;
    ☉ use crate::events::*;
    ☉ use crate::mount;
    ☉ use crate::html;
}

/// Mount a component to a DOM element by ID
☉ rite mount[C: Component](element_id: &str!) {
    ≔ window! = web_sys::window()·expect("no window");
    ≔ document! = window·document()·expect("no document");
    ≔ root! = document·get_element_by_id(element_id)·expect("element not found");

    runtime::mount_to_element[C](root);
}

/// Mount a component to a specific DOM element
☉ rite mount_to[C: Component](element: web_sys::Element!) {
    runtime::mount_to_element[C](element);
}

/// HTML macro for JSX-like syntax
///
/// Transforms at compile time into VNode tree construction
#[macro]
☉ macro html {
    // Empty element
    (<$tag:ident />) => {
        Element::new(stringify!($tag))
    };

    // Element with children
    (<$tag:ident $($attr:tt)*> $($children:tt)* </$tag2:ident>) => {{
        debug_assert!(stringify!($tag) == stringify!($tag2));
        ≔ vary el! = Element::new(stringify!($tag));
        html!(@attrs el $($attr)*);
        html!(@children el $($children)*);
        el
    }};

    // Attribute parsing
    (@attrs $el:ident) => {};
    (@attrs $el:ident $name:ident = $value:expr $($rest:tt)*) => {
        $el·set_attr(stringify!($name), $value);
        html!(@attrs $el $($rest)*);
    };
    (@attrs $el:ident on:$event:ident = $handler:expr $($rest:tt)*) => {
        $el·on(stringify!($event), $handler);
        html!(@attrs $el $($rest)*);
    };
    (@attrs $el:ident class = $value:expr $($rest:tt)*) => {
        $el·set_class($value);
        html!(@attrs $el $($rest)*);
    };
    (@attrs $el:ident style = $value:expr $($rest:tt)*) => {
        $el·set_style($value);
        html!(@attrs $el $($rest)*);
    };

    // Children parsing
    (@children $el:ident) => {};
    (@children $el:ident $text:literal $($rest:tt)*) => {
        $el·append_text($text);
        html!(@children $el $($rest)*);
    };
    (@children $el:ident { $expr:expr } $($rest:tt)*) => {
        $el·append($expr);
        html!(@children $el $($rest)*);
    };
    (@children $el:ident <$($child:tt)*) => {
        $el·append_child(html!(<$($child)*));
    };
}
