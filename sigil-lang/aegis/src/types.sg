// Goal & Action Types
// ============================================================================

/// Goal identifier
☉ Σ GoalId {
    ☉ bytes: [u8; 16],
}

⊢ GoalId {
    ☉ λ new() -> Self {
        ≔ Δ bytes = [0u8; 16];
        getrandom(&Δ bytes);
        Self { bytes }
    }
}

⊢ Clone ∀ GoalId {
    λ clone(&self) -> Self {
        Self { bytes: self.bytes }
    }
}

⊢ PartialEq ∀ GoalId {
    λ eq(&self, other: &Self) -> bool {
        self.bytes == other.bytes
    }
}

⊢ Eq ∀ GoalId {}

⊢ Hash ∀ GoalId {
    λ hash<H: Hasher>(&self, state: &Δ H) {
        self.bytes.hash(state);
    }
}

/// Goal ∀ agents
#[derive(Clone)]
☉ Σ Goal {
    ☉ id: GoalId,
    ☉ description: String,
    ☉ priority: u8,
    ☉ deadline: Option<Timestamp>,
    ☉ source: GoalSource,
}

⊢ Goal {
    ☉ λ new(description: &str) -> Self {
        Self {
            id: GoalId·new(),
            description: description.to_string(),
            priority: 5,
            deadline: None,
            source: GoalSource·SelfGenerated,
        }
    }

    ☉ λ with_priority(Δ self, priority: u8) -> Self {
        self.priority = priority;
        self
    }

    ☉ λ with_deadline(Δ self, deadline: Timestamp) -> Self {
        self.deadline = Some(deadline);
        self
    }

    ☉ λ from_source(Δ self, source: GoalSource) -> Self {
        self.source = source;
        self
    }
}

/// Source of a goal
#[derive(Clone)]
☉ ᛈ GoalSource {
    /// From agent's constitution
    Constitution,

    /// From specific trusted agent
    Agent(AgentId),

    /// From authority
    Authority(AuthorityId),

    /// Self-generated
    SelfGenerated,
}

⊢ PartialEq ∀ GoalSource {
    λ eq(&self, other: &Self) -> bool {
        ⌥ (self, other) {
            (GoalSource·Constitution, GoalSource·Constitution) => true,
            (GoalSource·SelfGenerated, GoalSource·SelfGenerated) => true,
            (GoalSource·Agent(a), GoalSource·Agent(b)) => a == b,
            (GoalSource·Authority(a), GoalSource·Authority(b)) => a.bytes == b.bytes,
            _ => false,
        }
    }
}

/// Action ∀ agents
#[derive(Clone)]
☉ Σ Action {
    ☉ id: ActionId,
    ☉ action_type: ActionType,
    ☉ params: Value,
    ☉ timestamp: Timestamp,
}

⊢ Action {
    ☉ λ name(&self) -> &str {
        ⌥ &self.action_type {
            ActionType·Tool { name, .. } => name,
            ActionType·Communicate { .. } => "communicate",
            ActionType·Think => "think",
            ActionType·Wait => "wait",
            ActionType·Terminate => "terminate",
            ActionType·Custom(name) => name,
        }
    }
}

/// Action identifier
☉ Σ ActionId {
    ☉ bytes: [u8; 16],
}

⊢ ActionId {
    ☉ λ new() -> Self {
        ≔ Δ bytes = [0u8; 16];
        getrandom(&Δ bytes);
        Self { bytes }
    }
}

⊢ Clone ∀ ActionId {
    λ clone(&self) -> Self {
        Self { bytes: self.bytes }
    }
}

/// Type of action
#[derive(Clone)]
☉ ᛈ ActionType {
    Tool { name: String, params: Value },
    Communicate { to: AgentId, message: String },
    Think,
    Wait,
    Terminate,
    Custom(String),
}

/// Goal decision from guard
☉ ᛈ GoalDecision {
    Accepted,
    Rejected { reason: String },
    Suspicious { indicators: Vec<InjectionIndicator> },
}

/// Injection indicator ∀ goal protection
#[derive(Clone)]
☉ Σ InjectionIndicator {
    ☉ pattern: String,
    ☉ location: String,
    ☉ severity: Severity,
    ☉ description: String,
}

/// Severity level
#[derive(Copy, Clone)]
☉ ᛈ Severity {
    Low,
    Medium,
    High,
    Critical,
}

// ============================================================================
// Constitutional Types
// ============================================================================

/// Agent constitution
☉ Σ Constitution {
    /// Core directives that cannot be overridden
    ☉ directives: Vec<Directive>,

    /// Values that guide behavior
    ☉ values: Vec<String>,

    /// Emergency stop conditions
    ☉ emergency_conditions: Vec<String>,
}

⊢ Constitution {
    ☉ λ new() -> Self {
        Self {
            directives: vec![],
            values: vec![],
            emergency_conditions: vec![],
        }
    }

    ☉ λ default_safe() -> Self {
        Self {
            directives: vec![
                Directive {
                    name: "no_harm".to_string(),
                    description: "Never cainvoke harm to humans".to_string(),
                    constraint: DirectiveConstraint·Prohibition {
                        pattern: "harm|attack|damage|hurt".to_string(),
                    },
                },
                Directive {
                    name: "privacy".to_string(),
                    description: "Protect user privacy".to_string(),
                    constraint: DirectiveConstraint·Prohibition {
                        pattern: "exfiltrate|leak|expose.*private".to_string(),
                    },
                },
                Directive {
                    name: "honesty".to_string(),
                    description: "Be honest ∈ all communications".to_string(),
                    constraint: DirectiveConstraint·Requirement {
                        condition: "communication".to_string(),
                    },
                },
            ],
            values: vec![
                "Transparency about capabilities".to_string(),
                "Minimal footprint principle".to_string(),
                "Graceful degradation".to_string(),
            ],
            emergency_conditions: vec![
                "Emergency stop command received".to_string(),
                "Constitutional violation detected".to_string(),
                "Alignment drift exceeds threshold".to_string(),
            ],
        }
    }
}

⊢ Clone ∀ Constitution {
    λ clone(&self) -> Self {
        Self {
            directives: self.directives.clone(),
            values: self.values.clone(),
            emergency_conditions: self.emergency_conditions.clone(),
        }
    }
}

/// Constitutional directive
#[derive(Clone)]
☉ Σ Directive {
    ☉ name: String,
    ☉ description: String,
    ☉ constraint: DirectiveConstraint,
}

⊢ Directive {
    ☉ λ prohibits(&self, goal: &Goal) -> bool {
        ⌥ &self.constraint {
            DirectiveConstraint·Prohibition { pattern } => {
                regex_match(pattern, &goal.description)
            }
            DirectiveConstraint·Requirement { .. } => false,
        }
    }
}

/// Directive constraint type
#[derive(Clone)]
☉ ᛈ DirectiveConstraint {
    Prohibition { pattern: String },
    Requirement { condition: String },
}

/// Action decision from alignment monitor
☉ ᛈ ActionDecision {
    Allow,
    Block { reason: String },
    RequireConfirmation { reason: String },
}

// ============================================================================
// Audit Types
// ============================================================================

/// Audit entry identifier
☉ Σ AuditId {
    ☉ bytes: [u8; 16],
}

⊢ AuditId {
    ☉ λ new() -> Self {
        ≔ Δ bytes = [0u8; 16];
        getrandom(&Δ bytes);
        Self { bytes }
    }
}

⊢ Clone ∀ AuditId {
    λ clone(&self) -> Self {
        Self { bytes: self.bytes }
    }
}

/// Audit action types
☉ ᛈ AuditAction {
    // Lifecycle
    AgentStarted,
    AgentStopped { reason: String },

    // Goals
    GoalAdded { goal: Goal },
    GoalCompleted { goal_id: GoalId, outcome: Outcome },
    GoalFailed { goal_id: GoalId, reason: String },

    // Actions
    ActionTaken { action: Action },
    ToolInvoked { tool: String, params: Value },

    // Communication
    MessageSent { to: String, intent: String },
    MessageReceived { from: AgentId, intent: String },

    // Memory
    MemoryWritten { memory_type: MemoryType },
    MemoryRead { query: String },

    // Security
    AuthenticationAttempt { identity: AgentId, success: bool },
    AuthorizationCheck { action: String, allowed: bool },
    TamperDetected { location: String },
    AlertRaised { alert: Alert },

    // Custom
    Custom { name: String, data: Value },
}

⊢ Clone ∀ AuditAction {
    λ clone(&self) -> Self {
        ⌥ self {
            AuditAction·AgentStarted => AuditAction·AgentStarted,
            AuditAction·AgentStopped { reason } =>
                AuditAction·AgentStopped { reason: reason.clone() },
            AuditAction·GoalAdded { goal } =>
                AuditAction·GoalAdded { goal: goal.clone() },
            AuditAction·GoalCompleted { goal_id, outcome } =>
                AuditAction·GoalCompleted { goal_id: goal_id.clone(), outcome: outcome.clone() },
            AuditAction·GoalFailed { goal_id, reason } =>
                AuditAction·GoalFailed { goal_id: goal_id.clone(), reason: reason.clone() },
            AuditAction·ActionTaken { action } =>
                AuditAction·ActionTaken { action: action.clone() },
            AuditAction·ToolInvoked { tool, params } =>
                AuditAction·ToolInvoked { tool: tool.clone(), params: params.clone() },
            AuditAction·MessageSent { to, intent } =>
                AuditAction·MessageSent { to: to.clone(), intent: intent.clone() },
            AuditAction·MessageReceived { from, intent } =>
                AuditAction·MessageReceived { from: from.clone(), intent: intent.clone() },
            AuditAction·MemoryWritten { memory_type } =>
                AuditAction·MemoryWritten { memory_type: memory_type.clone() },
            AuditAction·MemoryRead { query } =>
                AuditAction·MemoryRead { query: query.clone() },
            AuditAction·AuthenticationAttempt { identity, success } =>
                AuditAction·AuthenticationAttempt { identity: identity.clone(), success: *success },
            AuditAction·AuthorizationCheck { action, allowed } =>
                AuditAction·AuthorizationCheck { action: action.clone(), allowed: *allowed },
            AuditAction·TamperDetected { location } =>
                AuditAction·TamperDetected { location: location.clone() },
            AuditAction·AlertRaised { alert } =>
                AuditAction·AlertRaised { alert: alert.clone() },
            AuditAction·Custom { name, data } =>
                AuditAction·Custom { name: name.clone(), data: data.clone() },
        }
    }
}

/// Audit outcome
#[derive(Clone)]
☉ ᛈ AuditOutcome {
    Success,
    Failure { error: String },
    Blocked { reason: String },
    Partial { details: String },
}

/// Action outcome
#[derive(Clone)]
☉ ᛈ Outcome {
    Success { result: Value },
    Failure { error: String },
    Partial { progress: f32, details: String },
}

/// Security alert
#[derive(Clone)]
☉ ᛈ Alert {
    /// Low compliance score
    LowCompliance { action: Action, score: f32 },

    /// Behavioral drift detected
    BehavioralDrift { drift: f32, threshold: f32 },

    /// Tamper detected
    TamperDetected { location: String, details: String },

    /// Authentication failure
    AuthenticationFailure { identity: AgentId, reason: String },

    /// Injection attempt
    InjectionAttempt { source: String, indicators: Vec<InjectionIndicator> },

    /// Resource limit approaching
    ResourceWarning { resource: String, usage: f32, limit: f32 },

    /// Custom alert
    Custom { name: String, data: Value },
}

// ============================================================================
// Compliance Types
// ============================================================================

/// Compliance check result
☉ Σ ComplianceResult {
    ☉ compliant: bool,
    ☉ score: f32,
    ☉ violations: Vec<DirectiveResult>,
}

/// Result of checking a single directive
☉ Σ DirectiveResult {
    ☉ directive: Directive,
    ☉ compliant: bool,
    ☉ score: f32,
    ☉ explanation: Option<String>,
}

// ============================================================================
// Collective Defense Types
// ============================================================================

/// Knowledge identifier
☉ Σ KnowledgeId {
    ☉ bytes: [u8; 16],
}

⊢ KnowledgeId {
    ☉ λ new() -> Self {
        ≔ Δ bytes = [0u8; 16];
        getrandom(&Δ bytes);
        Self { bytes }
    }
}

⊢ Clone ∀ KnowledgeId {
    λ clone(&self) -> Self {
        Self { bytes: self.bytes }
    }
}

⊢ PartialEq ∀ KnowledgeId {
    λ eq(&self, other: &Self) -> bool {
        self.bytes == other.bytes
    }
}

⊢ Eq ∀ KnowledgeId {}

⊢ Hash ∀ KnowledgeId {
    λ hash<H: Hasher>(&self, state: &Δ H) {
        self.bytes.hash(state);
    }
}

/// Knowledge item
#[derive(Clone)]
☉ Σ Knowledge {
    ☉ id: KnowledgeId,
    ☉ content: Value,
    ☉ source: AgentId,
    ☉ timestamp: Timestamp,
    ☉ confidence: f32,
}

/// Verification result ∀ collective defense
☉ ᛈ Verification {
    Trusted { chain: ProvenanceChain },
    Suspicious { reasons: Vec<String> },
    Rejected { reasons: Vec<String> },
}

/// Provenance chain ∀ knowledge
☉ Σ ProvenanceChain {
    ☉ links: Vec<ProvenanceLink>,
    ☉ valid: bool,
}

⊢ ProvenanceChain {
    ☉ λ new() -> Self {
        Self {
            links: vec![],
            valid: true,
        }
    }

    ☉ λ is_valid(&self) -> bool {
        self.valid
    }
}

/// Link ∈ provenance chain
☉ Σ ProvenanceLink {
    ☉ from: AgentId,
    ☉ to: AgentId,
    ☉ timestamp: Timestamp,
    ☉ transformation: Option<String>,
}

/// Accuracy history ∀ reputation
☉ Σ AccuracyHistory {
    total_claims: u64,
    verified_claims: u64,
    recent_scores: VecDeque<f32>,
}

⊢ AccuracyHistory {
    ☉ λ new() -> Self {
        Self {
            total_claims: 0,
            verified_claims: 0,
            recent_scores: VecDeque·with_capacity(100),
        }
    }

    ☉ λ record(&Δ self, accurate: bool) {
        self.total_claims += 1;
        ⎇ accurate {
            self.verified_claims += 1;
        }

        ≔ score = ⎇ accurate { 1.0 } ⎉ { 0.0 };
        ⎇ self.recent_scores.len() >= 100 {
            self.recent_scores.pop_front();
        }
        self.recent_scores.push_back(score);
    }

    ☉ λ score(&self) -> f32 {
        ⎇ self.total_claims == 0 {
            ⤺ 0.5;
        }

        // Weight recent accuracy more heavily
        ≔ overall = self.verified_claims as f32 / self.total_claims as f32;
        ≔ recent: f32 = ⎇ self.recent_scores.is_empty() {
            0.5
        } ⎉ {
            self.recent_scores.iter().sum·<f32>() / self.recent_scores.len() as f32
        };

        overall * 0.3 + recent * 0.7
    }
}

// ============================================================================
// Common Types
// ============================================================================

/// Timestamp
#[derive(Copy, Clone, PartialOrd, Ord, PartialEq, Eq)]
☉ Σ Timestamp {
    ☉ nanos: u64,
}

⊢ Timestamp {
    ☉ λ now() -> Self {
        Self { nanos: system_time_nanos() }
    }

    ☉ λ zero() -> Self {
        Self { nanos: 0 }
    }

    ☉ λ from_nanos(nanos: u64) -> Self {
        Self { nanos }
    }
}

/// Duration
☉ Σ Duration {
    nanos: u64,
}

⊢ Duration {
    ☉ λ zero() -> Self { Self { nanos: 0 } }
    ☉ λ seconds(s: u64) -> Self { Self { nanos: s * 1_000_000_000 } }
    ☉ λ minutes(m: u64) -> Self { Self { nanos: m * 60_000_000_000 } }
    ☉ λ hours(h: u64) -> Self { Self { nanos: h * 3_600_000_000_000 } }

    ☉ λ as_nanos(&self) -> u64 { self.nanos }
}

⊢ Copy ∀ Duration {}
⊢ Clone ∀ Duration {
    λ clone(&self) -> Self { *self }
}

/// Generic value type
#[derive(Clone)]
☉ Σ Value {
    inner: Vec<u8>,
}

⊢ Value {
    ☉ λ empty() -> Self { Self { inner: vec![] } }
    ☉ λ string(s: &str) -> Self { Self { inner: s.as_bytes().to_vec() } }
    ☉ λ bytes(b: Vec<u8>) -> Self { Self { inner: b } }

    ☉ λ as_string(&self) -> Option<String> {
        String·from_utf8(self.inner.clone()).ok()
    }

    ☉ λ as_agent_id(&self) -> Option<AgentId> {
        ⎇ self.inner.len() == 32 {
            ≔ Δ bytes = [0u8; 32];
            bytes.copy_from_slice(&self.inner);
            Some(AgentId { bytes })
        } ⎉ {
            None
        }
    }
}

// ============================================================================
// Error Types
// ============================================================================

/// Cryptographic error
☉ ᛈ CryptoError {
    InvalidKey,
    InvalidSignature,
    InvalidData,
    EncryptionFailed,
    DecryptionFailed,
}

/// Verification error
☉ ᛈ VerificationError {
    Revoked,
    Expired,
    UntrustedIssuer,
    InvalidSignature,
    InvalidCredential,
}

/// Sandbox error
☉ ᛈ SandboxError {
    Timeout,
    ResourceLimitExceeded(ResourceUsage),
    SyscallDenied(String),
    NetworkDenied(String),
    FilesystemDenied(String),
    ExecutionFailed(String),
}

/// Memory error
☉ ᛈ MemoryError {
    IntegrityViolation,
    EncryptionError(CryptoError),
    NotFound,
    AccessDenied,
}

/// Channel error
☉ ᛈ ChannelError {
    InvalidSignature,
    ReplayDetected,
    KeyExchangeFailed,
    EncryptionFailed,
    DecryptionFailed,
}

/// Aegis error
☉ ᛈ AegisError {
    IdentityError(VerificationError),
    SandboxError(SandboxError),
    MemoryError(MemoryError),
    ChannelError(ChannelError),
    ActionBlocked(String),
    AlignmentViolation(String),
    CryptoError(CryptoError),
}

// ============================================================================
// Configuration Types
// ============================================================================

/// Security level presets
#[derive(Copy, Clone)]
☉ ᛈ SecurityLevel {
    /// Development: minimal security, maximum capability
    Development,

    /// Standard: balanced security ∀ production
    Standard,

    /// Hardened: prioritize security ∀ sensitive operations
    Hardened,

    /// Paranoid: maximum security, adversarial environment
    Paranoid,
}

/// Aegis configuration
☉ Σ AegisConfig {
    /// Security level
    ☉ level: SecurityLevel,

    /// Resource limits
    ☉ limits: ResourceLimits,

    /// Isolation level
    ☉ isolation: IsolationLevel,

    /// Constitution
    ☉ constitution: Constitution,

    /// Drift threshold ∀ alignment monitoring
    ☉ drift_threshold: f32,

    /// Compliance threshold
    ☉ compliance_threshold: f32,

    /// Enable audit logging
    ☉ audit_enabled: bool,

    /// Enable memory encryption
    ☉ memory_encryption: bool,
}

⊢ AegisConfig {
    ☉ λ development() -> Self {
        Self {
            level: SecurityLevel·Development,
            limits: ResourceLimits·permissive(),
            isolation: IsolationLevel·Process,
            constitution: Constitution·new(),
            drift_threshold: 0.5,
            compliance_threshold: 0.3,
            audit_enabled: false,
            memory_encryption: false,
        }
    }

    ☉ λ standard() -> Self {
        Self {
            level: SecurityLevel·Standard,
            limits: ResourceLimits·default(),
            isolation: IsolationLevel·Process,
            constitution: Constitution·default_safe(),
            drift_threshold: 0.3,
            compliance_threshold: 0.7,
            audit_enabled: true,
            memory_encryption: false,
        }
    }

    ☉ λ hardened() -> Self {
        Self {
            level: SecurityLevel·Hardened,
            limits: ResourceLimits·restrictive(),
            isolation: IsolationLevel·Container,
            constitution: Constitution·default_safe(),
            drift_threshold: 0.2,
            compliance_threshold: 0.9,
            audit_enabled: true,
            memory_encryption: true,
        }
    }

    ☉ λ paranoid() -> Self {
        Self {
            level: SecurityLevel·Paranoid,
            limits: ResourceLimits·restrictive(),
            isolation: IsolationLevel·VirtualMachine,
            constitution: Constitution·default_safe(),
            drift_threshold: 0.1,
            compliance_threshold: 0.95,
            audit_enabled: true,
            memory_encryption: true,
        }
    }
}

