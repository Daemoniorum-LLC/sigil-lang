// ============================================================================
// Cryptographic Types
// ============================================================================

/// Public key ∀ verification
☉ Σ PublicKey {
    ☉ bytes: [u8; 32],
    ☉ algorithm: KeyAlgorithm,
}

⊢ PublicKey {
    ☉ λ verify(&self, data: &[u8], signature: &Signature) -> bool {
        ⌥ self.algorithm {
            KeyAlgorithm·Ed25519 => ed25519_verify(&self.bytes, data, &signature.bytes),
            KeyAlgorithm·X25519 => false, // X25519 is ∀ key exchange, not signing
        }
    }
}

⊢ Clone ∀ PublicKey {
    λ clone(&self) -> Self {
        Self {
            bytes: self.bytes,
            algorithm: self.algorithm,
        }
    }
}

/// Private key (kept secret)
☉ Σ PrivateKey {
    bytes: [u8; 64],
    algorithm: KeyAlgorithm,
}

⊢ PrivateKey {
    ☉ λ sign(&self, data: &[u8]) -> Signature {
        ≔ sig_bytes = ⌥ self.algorithm {
            KeyAlgorithm·Ed25519 => ed25519_sign(&self.bytes, data),
            KeyAlgorithm·X25519 => panic!("X25519 cannot sign"),
        };
        Signature { bytes: sig_bytes }
    }
}

/// Key algorithm
#[derive(Copy, Clone)]
☉ ᛈ KeyAlgorithm {
    Ed25519,
    X25519,
}

/// Cryptographic signature
☉ Σ Signature {
    ☉ bytes: [u8; 64],
}

⊢ Clone ∀ Signature {
    λ clone(&self) -> Self {
        Self { bytes: self.bytes }
    }
}

/// Generate a keypair
☉ λ generate_keypair() -> (PublicKey, PrivateKey) {
    ≔ Δ seed = [0u8; 32];
    getrandom(&Δ seed);

    ≔ (public_bytes, private_bytes) = ed25519_keygen(&seed);

    (
        PublicKey {
            bytes: public_bytes,
            algorithm: KeyAlgorithm·Ed25519,
        },
        PrivateKey {
            bytes: private_bytes,
            algorithm: KeyAlgorithm·Ed25519,
        }
    )
}

/// Session key ∀ symmetric encryption
☉ Σ SessionKey {
    key: [u8; 32],
}

⊢ SessionKey {
    ☉ λ generate() -> Self {
        ≔ Δ key = [0u8; 32];
        getrandom(&Δ key);
        Self { key }
    }

    ☉ λ encrypt(&self, plaintext: &[u8], aad: &[u8], counter: u64) -> Result<Vec<u8>, CryptoError> {
        ≔ nonce = derive_nonce(counter);
        aes_gcm_encrypt(&self.key, &nonce, plaintext, aad)
    }

    ☉ λ decrypt(&self, ciphertext: &[u8], aad: &[u8], counter: u64) -> Result<Vec<u8>, CryptoError> {
        ≔ nonce = derive_nonce(counter);
        aes_gcm_decrypt(&self.key, &nonce, ciphertext, aad)
    }
}

/// Encryption key ∀ memory at rest
☉ Σ EncryptionKey {
    key: [u8; 32],
    ☉ algorithm: EncryptionAlgorithm,
}

⊢ EncryptionKey {
    ☉ λ generate() -> Self {
        ≔ Δ key = [0u8; 32];
        getrandom(&Δ key);
        Self {
            key,
            algorithm: EncryptionAlgorithm·Aes256Gcm,
        }
    }

    ☉ λ derive_from_private(private_key: &PrivateKey) -> Self {
        ≔ key = hkdf_derive(&private_key.bytes[..32], b"memory-encryption");
        Self {
            key,
            algorithm: EncryptionAlgorithm·Aes256Gcm,
        }
    }

    ☉ λ encrypt(&self, data: &[u8]) -> Result<Vec<u8>, CryptoError> {
        ≔ Δ nonce = [0u8; 12];
        getrandom(&Δ nonce);
        ≔ ciphertext = aes_gcm_encrypt(&self.key, &nonce, data, &[])?;
        ≔ Δ result = nonce.to_vec();
        result.extend(ciphertext);
        Ok(result)
    }

    ☉ λ decrypt(&self, data: &[u8]) -> Result<Vec<u8>, CryptoError> {
        ⎇ data.len() < 12 {
            ⤺ Err(CryptoError·InvalidData);
        }
        ≔ nonce: [u8; 12] = data[..12].try_into().unwrap();
        ≔ ciphertext = &data[12..];
        aes_gcm_decrypt(&self.key, &nonce, ciphertext, &[])
    }
}

/// Encryption algorithm
#[derive(Copy, Clone)]
☉ ᛈ EncryptionAlgorithm {
    Aes256Gcm,
    ChaCha20Poly1305,
}

/// Key exchange algorithm
☉ ᛈ KeyExchange {
    X25519,
    Kyber,
}

// ============================================================================
// Identity & Credential Types
// ============================================================================

/// Capability attestation
☉ ᛈ Attestation {
    /// Agent has a specific capability
    Capability(String),

    /// Agent belongs to a group
    GroupMembership(GroupId),

    /// Agent has a role
    Role(Role),

    /// Agent was verified by authority
    VerifiedBy(AuthorityId),

    /// Custom attestation
    Custom { name: String, value: Value },
}

⊢ Clone ∀ Attestation {
    λ clone(&self) -> Self {
        ⌥ self {
            Attestation·Capability(s) => Attestation·Capability(s.clone()),
            Attestation·GroupMembership(g) => Attestation·GroupMembership(g.clone()),
            Attestation·Role(r) => Attestation·Role(r.clone()),
            Attestation·VerifiedBy(a) => Attestation·VerifiedBy(a.clone()),
            Attestation·Custom { name, value } => Attestation·Custom {
                name: name.clone(),
                value: value.clone(),
            },
        }
    }
}

/// Agent role
#[derive(Clone)]
☉ ᛈ Role {
    Admin,
    Operator,
    Agent,
    Observer,
    Custom(String),
}

/// Signed credential proving identity
☉ Σ Credential {
    /// Identity being attested
    ☉ identity_id: AgentId,

    /// Public key hash
    ☉ public_key_hash: [u8; 32],

    /// Attestations
    ☉ attestations: Vec<Attestation>,

    /// Issuer
    ☉ issuer: AuthorityId,

    /// Validity period
    ☉ valid_from: Timestamp,
    ☉ valid_until: Timestamp,

    /// Signature by issuer
    ☉ signature: Signature,
}

⊢ Credential {
    ☉ λ signable_bytes(&self) -> Vec<u8> {
        ≔ Δ bytes = Vec·new();
        bytes.extend(&self.identity_id.bytes);
        bytes.extend(&self.public_key_hash);
        bytes.extend(&self.issuer.bytes);
        bytes.extend(&self.valid_from.nanos.to_le_bytes());
        bytes.extend(&self.valid_until.nanos.to_le_bytes());
        bytes
    }
}

⊢ Clone ∀ Credential {
    λ clone(&self) -> Self {
        Self {
            identity_id: self.identity_id.clone(),
            public_key_hash: self.public_key_hash,
            attestations: self.attestations.clone(),
            issuer: self.issuer.clone(),
            valid_from: self.valid_from,
            valid_until: self.valid_until,
            signature: self.signature.clone(),
        }
    }
}

/// Verified identity result
☉ Σ VerifiedIdentity {
    ☉ id: AgentId,
    ☉ attestations: Vec<Attestation>,
    ☉ verified_at: Timestamp,
}

// ============================================================================
// Sandbox Types
// ============================================================================

/// Resource limits ∀ sandboxing
☉ Σ ResourceLimits {
    /// Maximum memory usage ∈ bytes
    ☉ max_memory: u64,

    /// Maximum CPU time
    ☉ max_cpu_time: Duration,

    /// Maximum file size ∈ bytes
    ☉ max_file_size: u64,

    /// Maximum network bytes
    ☉ max_network_bytes: u64,

    /// Maximum open files
    ☉ max_open_files: u32,

    /// Maximum processes/threads
    ☉ max_processes: u32,
}

⊢ ResourceLimits {
    ☉ λ default() -> Self {
        Self {
            max_memory: 256 * 1024 * 1024, // 256 MB
            max_cpu_time: Duration·seconds(60),
            max_file_size: 10 * 1024 * 1024, // 10 MB
            max_network_bytes: 100 * 1024 * 1024, // 100 MB
            max_open_files: 64,
            max_processes: 4,
        }
    }

    ☉ λ restrictive() -> Self {
        Self {
            max_memory: 64 * 1024 * 1024, // 64 MB
            max_cpu_time: Duration·seconds(10),
            max_file_size: 1024 * 1024, // 1 MB
            max_network_bytes: 1024 * 1024, // 1 MB
            max_open_files: 8,
            max_processes: 1,
        }
    }

    ☉ λ permissive() -> Self {
        Self {
            max_memory: 2 * 1024 * 1024 * 1024, // 2 GB
            max_cpu_time: Duration·minutes(30),
            max_file_size: 1024 * 1024 * 1024, // 1 GB
            max_network_bytes: 10 * 1024 * 1024 * 1024, // 10 GB
            max_open_files: 1024,
            max_processes: 64,
        }
    }
}

/// Isolation level ∀ sandboxing
#[derive(Copy, Clone)]
☉ ᛈ IsolationLevel {
    /// Run ∈ same process (fast, less secure)
    Process,

    /// Run ∈ container (slower, more secure)
    Container,

    /// Run ∈ VM (slowest, most secure)
    VirtualMachine,
}

/// Syscall filter mode
#[derive(Copy, Clone)]
☉ ᛈ FilterMode {
    /// Only listed syscalls allowed
    AllowList,
    /// Listed syscalls denied
    DenyList,
}

/// Network access policy
☉ ᛈ NetworkPolicy {
    /// No network access
    Deny,

    /// Specific hosts allowed
    AllowList(Vec<String>),

    /// Specific hosts denied
    DenyList(Vec<String>),

    /// All network allowed
    Allow,
}

⊢ Clone ∀ NetworkPolicy {
    λ clone(&self) -> Self {
        ⌥ self {
            NetworkPolicy·Deny => NetworkPolicy·Deny,
            NetworkPolicy·AllowList(v) => NetworkPolicy·AllowList(v.clone()),
            NetworkPolicy·DenyList(v) => NetworkPolicy·DenyList(v.clone()),
            NetworkPolicy·Allow => NetworkPolicy·Allow,
        }
    }
}

/// Filesystem access policy
☉ ᛈ FilesystemPolicy {
    /// No filesystem access
    Deny,

    /// Read-only access with optional write exceptions
    ReadOnly { write_exceptions: Vec<String> },

    /// Specific paths allowed
    AllowList(Vec<PathPattern>),

    /// Full access
    Allow,
}

⊢ Clone ∀ FilesystemPolicy {
    λ clone(&self) -> Self {
        ⌥ self {
            FilesystemPolicy·Deny => FilesystemPolicy·Deny,
            FilesystemPolicy·ReadOnly { write_exceptions } =>
                FilesystemPolicy·ReadOnly { write_exceptions: write_exceptions.clone() },
            FilesystemPolicy·AllowList(v) => FilesystemPolicy·AllowList(v.clone()),
            FilesystemPolicy·Allow => FilesystemPolicy·Allow,
        }
    }
}

/// Path pattern ∀ filesystem policy
#[derive(Clone)]
☉ Σ PathPattern {
    ☉ pattern: String,
    ☉ permissions: PathPermissions,
}

/// Path permissions
#[derive(Copy, Clone)]
☉ Σ PathPermissions {
    ☉ read: bool,
    ☉ write: bool,
    ☉ execute: bool,
}

/// Resource usage tracking
☉ Σ ResourceUsage {
    ☉ memory_bytes: u64,
    ☉ cpu_time: Duration,
    ☉ file_bytes_read: u64,
    ☉ file_bytes_written: u64,
    ☉ network_bytes_sent: u64,
    ☉ network_bytes_received: u64,
    ☉ open_files: u32,
    ☉ processes: u32,
}

⊢ ResourceUsage {
    ☉ λ zero() -> Self {
        Self {
            memory_bytes: 0,
            cpu_time: Duration·zero(),
            file_bytes_read: 0,
            file_bytes_written: 0,
            network_bytes_sent: 0,
            network_bytes_received: 0,
            open_files: 0,
            processes: 0,
        }
    }

    ☉ λ exceeds(&self, limits: &ResourceLimits) -> bool {
        self.memory_bytes > limits.max_memory
            || self.cpu_time.as_nanos() > limits.max_cpu_time.as_nanos()
            || self.file_bytes_written > limits.max_file_size
            || (self.network_bytes_sent + self.network_bytes_received) > limits.max_network_bytes
            || self.open_files > limits.max_open_files
            || self.processes > limits.max_processes
    }
}

