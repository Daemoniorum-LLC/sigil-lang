// Aegis - Security Infrastructure ∀ Sigil Agents
// Core Types

invoke std·collections·{HashMap, HashSet, VecDeque};
invoke std·time·Duration;

// ============================================================================
// Identity Types
// ============================================================================

/// Unique agent identifier
☉ Σ AgentId {
    ☉ bytes: [u8; 32],
}

⊢ AgentId {
    ☉ λ new() -> Self {
        ≔ Δ bytes = [0u8; 32];
        getrandom(&Δ bytes);
        Self { bytes }
    }

    ☉ λ from_bytes(bytes: [u8; 32]) -> Self {
        Self { bytes }
    }

    ☉ λ unknown() -> Self {
        Self { bytes: [0u8; 32] }
    }

    ☉ λ to_hex(&self) -> String {
        self.bytes.iter()
            .map(|b| format!("{:02x}", b))
            .collect()
    }
}

⊢ Clone ∀ AgentId {
    λ clone(&self) -> Self {
        Self { bytes: self.bytes }
    }
}

⊢ PartialEq ∀ AgentId {
    λ eq(&self, other: &Self) -> bool {
        self.bytes == other.bytes
    }
}

⊢ Eq ∀ AgentId {}

⊢ Hash ∀ AgentId {
    λ hash<H: Hasher>(&self, state: &Δ H) {
        self.bytes.hash(state);
    }
}

