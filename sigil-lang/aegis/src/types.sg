// External Function Declarations (would be provided by runtime)
// ============================================================================

extern λ getrandom(buf: &Δ [u8]);
extern λ system_time_nanos() -> u64;
extern λ ed25519_keygen(seed: &[u8; 32]) -> ([u8; 32], [u8; 64]);
extern λ ed25519_sign(private_key: &[u8; 64], data: &[u8]) -> [u8; 64];
extern λ ed25519_verify(public_key: &[u8; 32], data: &[u8], signature: &[u8; 64]) -> bool;
extern λ aes_gcm_encrypt(key: &[u8; 32], nonce: &[u8; 12], plaintext: &[u8], aad: &[u8]) -> Result<Vec<u8>, CryptoError>;
extern λ aes_gcm_decrypt(key: &[u8; 32], nonce: &[u8; 12], ciphertext: &[u8], aad: &[u8]) -> Result<Vec<u8>, CryptoError>;
extern λ hkdf_derive(input: &[u8], info: &[u8]) -> [u8; 32];
extern λ derive_nonce(counter: u64) -> [u8; 12];
extern λ sha256(data: &[u8]) -> [u8; 32];
extern λ regex_match(pattern: &str, text: &str) -> bool;

// Use declarations ∀ std traits
invoke std·hash·{Hash, Hasher};
