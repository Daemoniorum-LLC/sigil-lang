//! Native Code Generation for Sigil
//!
//! This module generates native code from Sigil IR. For the bootstrap,
//! we target C as an intermediate language - this is portable and allows
//! us to leverage existing C compilers for optimization.
//!
//! ## Strategy
//!
//! 1. **C Codegen**: Generate C source code from IR (bootstrap)
//! 2. **Direct Native**: Future work with Cranelift or LLVM
//!
//! ## Generated Code Structure
//!
//! ```c
//! // Runtime header
//! #include "sigil_runtime.h"
//!
//! // Type definitions
//! typedef struct { ... } MyStruct;
//!
//! // Function declarations
//! SigilValue my_function(SigilValue arg);
//!
//! // Function definitions
//! SigilValue my_function(SigilValue arg) { ... }
//!
//! // Main entry point
//! int main(int argc, char** argv) { ... }
//! ```
//!
//! ## Evidence in Generated Code
//!
//! Evidence is represented as runtime tags:
//! - `SIGIL_KNOWN` (0) - Direct computation
//! - `SIGIL_UNCERTAIN` (1) - Possibly absent
//! - `SIGIL_REPORTED` (2) - External source
//! - `SIGIL_PARADOX` (3) - Contradictory

use crate::ir::*;
use crate::typeck::EvidenceLevel;

// ============================================================================
// Code Generator
// ============================================================================

/// C code generator
pub struct CodeGen {
    /// Output buffer
    output: !String,

    /// Indentation level
    indent: !usize,

    /// Generated type names
    type_names: !Map<String, String>,

    /// Temporary variable counter
    temp_counter: !u64,

    /// Label counter for control flow
    label_counter: !u64,

    /// Current function name
    current_function: ?String,

    /// Whether we're in an expression context
    in_expr: !bool,
}

impl CodeGen {
    /// Create a new code generator
    pub fn new() -> !CodeGen {
        CodeGen {
            output: String::new(),
            indent: 0,
            type_names: Map::new(),
            temp_counter: 0,
            label_counter: 0,
            current_function: null,
            in_expr: false,
        }
    }

    /// Generate C code from an IR module
    pub fn generate(mut self, module: !IrModule) -> !String {
        // Emit header
        self.emit_header();

        // Emit type definitions
        for typedef in module.types {
            self.emit_typedef(typedef);
        }

        // Emit function declarations
        for func in module.functions {
            self.emit_function_decl(func);
        }

        self.line("");

        // Emit function definitions
        for func in module.functions {
            self.emit_function(func);
        }

        // Emit main entry point wrapper
        self.emit_main_wrapper();

        self.output.clone()
    }

    /// Generate a fresh temporary name
    fn fresh_temp(mut self) -> !String {
        let id = self.temp_counter;
        self.temp_counter += 1;
        format!("_t{}", id)
    }

    /// Generate a fresh label
    fn fresh_label(mut self, prefix: !&str) -> !String {
        let id = self.label_counter;
        self.label_counter += 1;
        format!("{}_{}", prefix, id)
    }

    /// Emit a line with current indentation
    fn line(mut self, s: !&str) {
        for _ in 0..self.indent {
            self.output.push_str("    ");
        }
        self.output.push_str(s);
        self.output.push('\n');
    }

    /// Emit text without newline
    fn emit(mut self, s: !&str) {
        self.output.push_str(s);
    }

    /// Increase indentation
    fn indent_push(mut self) {
        self.indent += 1;
    }

    /// Decrease indentation
    fn indent_pop(mut self) {
        if self.indent > 0 {
            self.indent -= 1;
        }
    }

    // ========================================================================
    // Header Generation
    // ========================================================================

    fn emit_header(mut self) {
        self.line("/* Generated by Sigil Compiler */");
        self.line("/* Jormungandr Bootstrap */");
        self.line("");
        self.line("#include <stdint.h>");
        self.line("#include <stdbool.h>");
        self.line("#include <stdio.h>");
        self.line("#include <stdlib.h>");
        self.line("#include <string.h>");
        self.line("#include <math.h>");
        self.line("");

        // Evidence level constants
        self.line("/* Evidence levels */");
        self.line("#define SIGIL_KNOWN     0");
        self.line("#define SIGIL_UNCERTAIN 1");
        self.line("#define SIGIL_REPORTED  2");
        self.line("#define SIGIL_PARADOX   3");
        self.line("");

        // Value type tags
        self.line("/* Value type tags */");
        self.line("#define TAG_UNIT    0");
        self.line("#define TAG_BOOL    1");
        self.line("#define TAG_INT     2");
        self.line("#define TAG_FLOAT   3");
        self.line("#define TAG_CHAR    4");
        self.line("#define TAG_STRING  5");
        self.line("#define TAG_ARRAY   6");
        self.line("#define TAG_TUPLE   7");
        self.line("#define TAG_STRUCT  8");
        self.line("#define TAG_CLOSURE 9");
        self.line("#define TAG_REF     10");
        self.line("#define TAG_NULL    11");
        self.line("");

        // Core value type
        self.line("/* Runtime value representation */");
        self.line("typedef struct SigilValue {");
        self.indent_push();
        self.line("uint8_t tag;");
        self.line("uint8_t evidence;");
        self.line("union {");
        self.indent_push();
        self.line("bool b;");
        self.line("int64_t i;");
        self.line("double f;");
        self.line("char c;");
        self.line("char* s;");
        self.line("struct { struct SigilValue* data; size_t len; size_t cap; } arr;");
        self.line("struct { struct SigilValue* fields; size_t count; } tup;");
        self.line("void* ptr;");
        self.indent_pop();
        self.line("} v;");
        self.indent_pop();
        self.line("} SigilValue;");
        self.line("");

        // Value constructors
        self.line("/* Value constructors */");
        self.emit_value_constructors();
        self.line("");

        // Built-in function declarations
        self.line("/* Built-in functions */");
        self.emit_builtin_decls();
        self.line("");
    }

    fn emit_value_constructors(mut self) {
        // Unit
        self.line("static inline SigilValue sigil_unit(void) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_UNIT, .evidence = SIGIL_KNOWN };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Bool
        self.line("static inline SigilValue sigil_bool(bool b) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_BOOL, .evidence = SIGIL_KNOWN, .v.b = b };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Int
        self.line("static inline SigilValue sigil_int(int64_t i) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_INT, .evidence = SIGIL_KNOWN, .v.i = i };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Float
        self.line("static inline SigilValue sigil_float(double f) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_FLOAT, .evidence = SIGIL_KNOWN, .v.f = f };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Char
        self.line("static inline SigilValue sigil_char(char c) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_CHAR, .evidence = SIGIL_KNOWN, .v.c = c };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // String
        self.line("static inline SigilValue sigil_string(const char* s) {");
        self.indent_push();
        self.line("char* copy = strdup(s);");
        self.line("return (SigilValue){ .tag = TAG_STRING, .evidence = SIGIL_KNOWN, .v.s = copy };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Null
        self.line("static inline SigilValue sigil_null(void) {");
        self.indent_push();
        self.line("return (SigilValue){ .tag = TAG_NULL, .evidence = SIGIL_UNCERTAIN };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Array
        self.line("static inline SigilValue sigil_array(size_t len) {");
        self.indent_push();
        self.line("SigilValue* data = (SigilValue*)calloc(len, sizeof(SigilValue));");
        self.line("return (SigilValue){ .tag = TAG_ARRAY, .evidence = SIGIL_KNOWN, .v.arr = { data, len, len } };");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Evidence setter
        self.line("static inline SigilValue sigil_with_evidence(SigilValue v, uint8_t ev) {");
        self.indent_push();
        self.line("v.evidence = ev;");
        self.line("return v;");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Truthiness
        self.line("static inline bool sigil_truthy(SigilValue v) {");
        self.indent_push();
        self.line("switch (v.tag) {");
        self.indent_push();
        self.line("case TAG_BOOL: return v.v.b;");
        self.line("case TAG_INT: return v.v.i != 0;");
        self.line("case TAG_FLOAT: return v.v.f != 0.0;");
        self.line("case TAG_STRING: return v.v.s && v.v.s[0];");
        self.line("case TAG_ARRAY: return v.v.arr.len > 0;");
        self.line("case TAG_NULL: return false;");
        self.line("case TAG_UNIT: return false;");
        self.line("default: return true;");
        self.indent_pop();
        self.line("}");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Equality
        self.line("static inline bool sigil_eq(SigilValue a, SigilValue b) {");
        self.indent_push();
        self.line("if (a.tag != b.tag) return false;");
        self.line("switch (a.tag) {");
        self.indent_push();
        self.line("case TAG_BOOL: return a.v.b == b.v.b;");
        self.line("case TAG_INT: return a.v.i == b.v.i;");
        self.line("case TAG_FLOAT: return a.v.f == b.v.f;");
        self.line("case TAG_CHAR: return a.v.c == b.v.c;");
        self.line("case TAG_STRING: return strcmp(a.v.s, b.v.s) == 0;");
        self.line("case TAG_NULL: return true;");
        self.line("case TAG_UNIT: return true;");
        self.line("default: return false;");
        self.indent_pop();
        self.line("}");
        self.indent_pop();
        self.line("}");
    }

    fn emit_builtin_decls(mut self) {
        self.line("/* I/O */");
        self.line("SigilValue sigil_print(SigilValue v);");
        self.line("SigilValue sigil_println(SigilValue v);");
        self.line("SigilValue sigil_input(void);");
        self.line("");
        self.line("/* Math */");
        self.line("SigilValue sigil_abs(SigilValue v);");
        self.line("SigilValue sigil_sqrt(SigilValue v);");
        self.line("SigilValue sigil_sin(SigilValue v);");
        self.line("SigilValue sigil_cos(SigilValue v);");
        self.line("SigilValue sigil_pow(SigilValue base, SigilValue exp);");
        self.line("SigilValue sigil_floor(SigilValue v);");
        self.line("SigilValue sigil_ceil(SigilValue v);");
        self.line("SigilValue sigil_round(SigilValue v);");
        self.line("");
        self.line("/* Collections */");
        self.line("SigilValue sigil_len(SigilValue v);");
        self.line("SigilValue sigil_push(SigilValue arr, SigilValue item);");
        self.line("SigilValue sigil_pop(SigilValue arr);");
        self.line("SigilValue sigil_first(SigilValue arr);");
        self.line("SigilValue sigil_last(SigilValue arr);");
        self.line("");
        self.line("/* Assertions */");
        self.line("SigilValue sigil_assert(SigilValue cond);");
        self.line("SigilValue sigil_assert_eq(SigilValue a, SigilValue b);");
        self.line("void sigil_panic(const char* msg);");
        self.line("");
        self.line("/* String operations */");
        self.line("SigilValue sigil_concat(SigilValue a, SigilValue b);");
    }

    // ========================================================================
    // Type Definitions
    // ========================================================================

    fn emit_typedef(mut self, td: !IrTypeDef) {
        match td {
            IrTypeDef::Struct { name, fields, .. } => {
                self.line(format!("/* Struct: {} */", name));
                self.line(format!("typedef struct {} {{", name));
                self.indent_push();
                for field in fields {
                    let c_type = self.ir_type_to_c(field.ty);
                    self.line(format!("{} {};", c_type, field.name));
                }
                self.indent_pop();
                self.line(format!("}} {};", name));
                self.line("");
            },
            IrTypeDef::Enum { name, variants, .. } => {
                self.line(format!("/* Enum: {} */", name));
                self.line(format!("typedef struct {} {{", name));
                self.indent_push();
                self.line("uint32_t tag;");
                self.line("union {");
                self.indent_push();
                for (i, variant) in variants.iter().enumerate() {
                    match variant.fields {
                        ?fields if !fields.is_empty() => {
                            self.line(format!("struct {{ /* {} */", variant.name));
                            self.indent_push();
                            for field in fields {
                                let c_type = self.ir_type_to_c(field.ty);
                                self.line(format!("{} {};", c_type, field.name));
                            }
                            self.indent_pop();
                            self.line(format!("}} v{};", i));
                        },
                        _ => {},
                    }
                }
                self.indent_pop();
                self.line("} data;");
                self.indent_pop();
                self.line(format!("}} {};", name));

                // Emit variant tag constants
                for (i, variant) in variants.iter().enumerate() {
                    self.line(format!("#define {}_{} {}", name.to_uppercase(), variant.name.to_uppercase(), i));
                }
                self.line("");
            },
            IrTypeDef::TypeAlias { name, target, .. } => {
                let c_type = self.ir_type_to_c(target);
                self.line(format!("typedef {} {};", c_type, name));
                self.line("");
            },
        }
    }

    /// Convert IR type to C type string
    /// Note: For consistency with our SigilValue-based runtime, all non-void types
    /// return SigilValue. This makes the generated code type-safe.
    fn ir_type_to_c(self, ty: !IrType) -> !String {
        match ty {
            IrType::Unit => "void",
            // All primitive types use SigilValue wrapper for type safety
            IrType::Primitive { .. } => "SigilValue",
            IrType::Array { .. } | IrType::Slice { .. } => "SigilValue",
            IrType::Tuple { .. } => "SigilValue",
            IrType::Named { name, .. } => name,
            IrType::Reference { .. } => "SigilValue",
            IrType::Pointer { .. } => "SigilValue",
            IrType::Function { .. } => "void*",
            IrType::Evidential { .. } => "SigilValue",
            _ => "SigilValue",
        }
    }

    // ========================================================================
    // Function Generation
    // ========================================================================

    fn emit_function_decl(mut self, func: !IrFunction) {
        let ret_type = self.ir_type_to_c(func.return_type);
        let params = func.params|τ{p => format!("SigilValue {}", self.mangle_name(p.name))}|join(", ");
        let params = if params.is_empty() { "void" } else { params };
        let func_name = format!("sigil_{}", self.mangle_name(func.name));

        self.line(format!("{} {}({});", ret_type, func_name, params));
    }

    fn emit_function(mut self, func: !IrFunction) {
        self.current_function = ?func.name.clone();
        self.temp_counter = 0;

        let ret_type = self.ir_type_to_c(func.return_type);
        let params = func.params|τ{p => format!("SigilValue {}", self.mangle_name(p.name))}|join(", ");
        let params = if params.is_empty() { "void" } else { params };
        let func_name = format!("sigil_{}", self.mangle_name(func.name));

        self.line("");
        self.line(format!("/* Function: {} */", func.name));
        self.line(format!("{} {}({}) {{", ret_type, func_name, params));
        self.indent_push();

        match func.body {
            ?body => {
                let result = self.emit_operation(body);
                if ret_type != "void" {
                    self.line(format!("return {};", result));
                }
            },
            null => {},
        }

        self.indent_pop();
        self.line("}");

        self.current_function = null;
    }

    /// Mangle a Sigil name to valid C identifier
    fn mangle_name(self, name: !&str) -> !String {
        let mut result = String::new();
        for c in name.chars() {
            match c {
                'a'..'z' | 'A'..'Z' | '0'..'9' => result.push(c),
                '_' => result.push('_'),
                ':' => result.push_str("__"),
                _ => result.push_str(format!("_{:x}", c as u32)),
            }
        }
        result
    }

    // ========================================================================
    // Operation Generation
    // ========================================================================

    /// Emit code for an operation, returning the C expression
    fn emit_operation(mut self, op: !IrOperation) -> !String {
        match op {
            IrOperation::Literal { variant, value, evidence, .. } => {
                let val = match value {
                    LiteralValue::Int(n) => format!("sigil_int({}LL)", n),
                    LiteralValue::Float(f) => format!("sigil_float({})", f),
                    LiteralValue::Bool(b) => format!("sigil_bool({})", if b { "true" } else { "false" }),
                    LiteralValue::Char(c) => format!("sigil_char('{}')", self.escape_char(c)),
                    LiteralValue::String(s) => format!("sigil_string(\"{}\")", self.escape_string(s)),
                    LiteralValue::Null => "sigil_null()",
                };
                self.with_evidence(val, evidence)
            },

            IrOperation::Var { name, .. } => {
                self.mangle_name(name)
            },

            IrOperation::Let { pattern, init, .. } => {
                let init_code = self.emit_operation(*init);
                self.emit_pattern_binding(pattern, init_code);
                "sigil_unit()"
            },

            IrOperation::Binary { operator, left, right, evidence, .. } => {
                let l = self.emit_operation(*left);
                let r = self.emit_operation(*right);

                let expr = match operator {
                    BinaryOp::Add => self.emit_binary_add(l, r),
                    BinaryOp::Sub => self.emit_binary_sub(l, r),
                    BinaryOp::Mul => self.emit_binary_mul(l, r),
                    BinaryOp::Div => self.emit_binary_div(l, r),
                    BinaryOp::Rem => self.emit_binary_rem(l, r),
                    BinaryOp::Pow => format!("sigil_pow({}, {})", l, r),
                    BinaryOp::Eq => format!("sigil_bool(sigil_eq({}, {}))", l, r),
                    BinaryOp::Ne => format!("sigil_bool(!sigil_eq({}, {}))", l, r),
                    BinaryOp::Lt => self.emit_binary_lt(l, r),
                    BinaryOp::Le => self.emit_binary_le(l, r),
                    BinaryOp::Gt => self.emit_binary_gt(l, r),
                    BinaryOp::Ge => self.emit_binary_ge(l, r),
                    BinaryOp::And => format!("sigil_bool(sigil_truthy({}) && sigil_truthy({}))", l, r),
                    BinaryOp::Or => format!("sigil_bool(sigil_truthy({}) || sigil_truthy({}))", l, r),
                    BinaryOp::BitAnd => format!("sigil_int({}.v.i & {}.v.i)", l, r),
                    BinaryOp::BitOr => format!("sigil_int({}.v.i | {}.v.i)", l, r),
                    BinaryOp::BitXor => format!("sigil_int({}.v.i ^ {}.v.i)", l, r),
                    BinaryOp::Shl => format!("sigil_int({}.v.i << {}.v.i)", l, r),
                    BinaryOp::Shr => format!("sigil_int({}.v.i >> {}.v.i)", l, r),
                    BinaryOp::Concat => format!("sigil_concat({}, {})", l, r),
                };
                self.with_evidence(expr, evidence)
            },

            IrOperation::Unary { operator, operand, evidence, .. } => {
                let op_code = self.emit_operation(*operand);

                let expr = match operator {
                    UnaryOp::Neg => format!("({}.tag == TAG_INT ? sigil_int(-{}.v.i) : sigil_float(-{}.v.f))", op_code, op_code, op_code),
                    UnaryOp::Not => format!("sigil_bool(!sigil_truthy({}))", op_code),
                    UnaryOp::Ref => format!("(SigilValue){{ .tag = TAG_REF, .v.ptr = &{} }}", op_code),
                    UnaryOp::RefMut => format!("(SigilValue){{ .tag = TAG_REF, .v.ptr = &{} }}", op_code),
                    UnaryOp::Deref => format!("*(SigilValue*){}.v.ptr", op_code),
                };
                self.with_evidence(expr, evidence)
            },

            IrOperation::Call { function, args, evidence, .. } => {
                let fn_name = self.mangle_name(function);
                let arg_codes = args|τ{a => self.emit_operation(a)}|collect();
                let args_str = arg_codes.join(", ");

                // All functions get sigil_ prefix
                let call = format!("sigil_{}({})", fn_name, args_str);

                self.with_evidence(call, evidence)
            },

            IrOperation::If { condition, then_branch, else_branch, evidence, .. } => {
                let cond = self.emit_operation(*condition);
                let result_var = self.fresh_temp();

                self.line(format!("SigilValue {};", result_var));
                self.line(format!("if (sigil_truthy({})) {{", cond));
                self.indent_push();

                let then_result = self.emit_operation(*then_branch);
                self.line(format!("{} = {};", result_var, then_result));

                self.indent_pop();

                match else_branch {
                    ?else_op => {
                        self.line("} else {");
                        self.indent_push();

                        let else_result = self.emit_operation(*else_op);
                        self.line(format!("{} = {};", result_var, else_result));

                        self.indent_pop();
                        self.line("}");
                    },
                    null => {
                        self.line("} else {");
                        self.indent_push();
                        self.line(format!("{} = sigil_unit();", result_var));
                        self.indent_pop();
                        self.line("}");
                    },
                }

                result_var
            },

            IrOperation::Block { statements, evidence, .. } => {
                let mut last_result = "sigil_unit()";
                for stmt in statements {
                    last_result = self.emit_operation(stmt);
                }
                last_result
            },

            IrOperation::Return { value, .. } => {
                match value {
                    ?v => {
                        let result = self.emit_operation(*v);
                        self.line(format!("return {};", result));
                    },
                    null => {
                        self.line("return sigil_unit();");
                    },
                }
                "sigil_unit()" // Unreachable
            },

            IrOperation::Array { elements, evidence, .. } => {
                let len = elements.len();
                let arr_var = self.fresh_temp();

                self.line(format!("SigilValue {} = sigil_array({});", arr_var, len));

                for (i, elem) in elements.iter().enumerate() {
                    let elem_code = self.emit_operation(elem);
                    self.line(format!("{}.v.arr.data[{}] = {};", arr_var, i, elem_code));
                }

                self.with_evidence(arr_var, evidence)
            },

            IrOperation::Index { expr, index, evidence, .. } => {
                let arr = self.emit_operation(*expr);
                let idx = self.emit_operation(*index);

                let result = format!("{}.v.arr.data[{}.v.i]", arr, idx);
                self.with_evidence(result, evidence)
            },

            IrOperation::Field { expr, field, evidence, .. } => {
                let obj = self.emit_operation(*expr);
                // For now, assume struct field access
                let result = format!("{}.{}", obj, self.mangle_name(field));
                self.with_evidence(result, evidence)
            },

            IrOperation::Loop { variant, condition, iterator, body, .. } => {
                let result_var = self.fresh_temp();
                self.line(format!("SigilValue {} = sigil_unit();", result_var));

                match variant {
                    LoopVariant::Infinite => {
                        self.line("while (1) {");
                        self.indent_push();
                        let body_result = self.emit_operation(*body);
                        self.line(format!("{} = {};", result_var, body_result));
                        self.indent_pop();
                        self.line("}");
                    },
                    LoopVariant::While => {
                        let cond = match condition {
                            ?c => self.emit_operation(*c),
                            null => "sigil_bool(true)",
                        };
                        let cond_var = self.fresh_temp();
                        self.line(format!("SigilValue {} = {};", cond_var, cond));
                        self.line(format!("while (sigil_truthy({})) {{", cond_var));
                        self.indent_push();
                        let body_result = self.emit_operation(*body);
                        self.line(format!("{} = {};", result_var, body_result));
                        // Re-evaluate condition
                        match condition {
                            ?c => {
                                let new_cond = self.emit_operation(*c);
                                self.line(format!("{} = {};", cond_var, new_cond));
                            },
                            null => {},
                        }
                        self.indent_pop();
                        self.line("}");
                    },
                    LoopVariant::For => {
                        if let ?iter = iterator {
                            let iterable = self.emit_operation(*iter.iterable);
                            let i_var = self.fresh_temp();
                            self.line(format!("for (size_t {} = 0; {} < {}.v.arr.len; {}++) {{", i_var, i_var, iterable, i_var));
                            self.indent_push();
                            // Bind pattern to current element
                            self.emit_pattern_binding(iter.pattern, format!("{}.v.arr.data[{}]", iterable, i_var));
                            let body_result = self.emit_operation(*body);
                            self.line(format!("{} = {};", result_var, body_result));
                            self.indent_pop();
                            self.line("}");
                        }
                    },
                }

                result_var
            },

            IrOperation::Break { value, .. } => {
                match value {
                    ?v => {
                        let result = self.emit_operation(*v);
                        // Store in a break result variable (would need more context)
                    },
                    null => {},
                }
                self.line("break;");
                "sigil_unit()"
            },

            IrOperation::Continue { .. } => {
                self.line("continue;");
                "sigil_unit()"
            },

            IrOperation::Closure { params, body, evidence, .. } => {
                // For closures, we'd need to emit a separate function
                // For now, just emit a placeholder
                let closure_name = self.fresh_temp();
                self.line(format!("/* Closure: {} */", closure_name));
                format!("sigil_null() /* closure */")
            },

            IrOperation::Pipeline { input, steps, evidence, .. } => {
                let mut current = self.emit_operation(*input);

                for step in steps {
                    current = self.emit_pipeline_step(step, current);
                }

                self.with_evidence(current, evidence)
            },

            IrOperation::EvidenceCoerce { expr, to_evidence, .. } => {
                let val = self.emit_operation(*expr);
                let ev = self.evidence_to_c(to_evidence);
                format!("sigil_with_evidence({}, {})", val, ev)
            },

            IrOperation::Assign { target, value, .. } => {
                let target_code = self.emit_operation(*target);
                let value_code = self.emit_operation(*value);
                self.line(format!("{} = {};", target_code, value_code));
                "sigil_unit()"
            },

            IrOperation::Field { expr, field, evidence, .. } => {
                // Generate field access for structs
                // Structs are stored as arrays of SigilValue, field access by name
                let base_code = self.emit_operation(*expr);
                // Use the struct's field map to get the index
                // For now, just access the named field from the struct pointer
                let temp = self.fresh_temp();
                self.line(format!("SigilValue {} = sigil_struct_field({}, \"{}\");", temp, base_code, field));
                self.with_evidence(temp, evidence)
            },

            IrOperation::Index { expr, index, evidence, .. } => {
                // Generate array/tuple index
                let base = self.emit_operation(*expr);
                let idx = self.emit_operation(*index);
                let expr = format!("{}.v.arr.data[{}.v.i]", base, idx);
                self.with_evidence(expr, evidence)
            },

            IrOperation::StructInit { name, fields, evidence, .. } => {
                // Generate struct initialization
                // Store as (name_str, array of field_names, array of field_values)
                let temp = self.fresh_temp();
                let n = fields.len();

                // Build field names and values by index
                let mut field_names_parts: ![String] = [];
                let mut i = 0;
                self.line(format!("SigilValue {}__values[{}];", temp, n));
                while i < n {
                    let field = fields[i];
                    let field_name = field.0;
                    let field_value = field.1;
                    field_names_parts.push(format!("\"{}\"", field_name));
                    let val = self.emit_operation(field_value);
                    self.line(format!("{}__values[{}] = {};", temp, i, val));
                    i = i + 1;
                }
                let field_names_str = field_names_parts.join(", ");

                // Emit field names array
                self.line(format!("static const char* {}__names[{}] = {{ {} }};",
                    temp, n, field_names_str));

                // Create struct value with sigil_struct helper
                let expr = format!("sigil_struct(\"{}\", {}__names, {}__values, {})", name, temp, temp, n);
                self.with_evidence(expr, evidence)
            },

            IrOperation::Tuple { elements, evidence, .. } => {
                // Generate tuple
                let temp = self.fresh_temp();
                let n = elements.len();

                self.line(format!("SigilValue {}__fields[{}];", temp, n));
                for (i, elem) in elements.iter().enumerate() {
                    let val = self.emit_operation(elem.clone());
                    self.line(format!("{}__fields[{}] = {};", temp, i, val));
                }

                let expr = format!("sigil_tuple({}__fields, {})", temp, n);
                self.with_evidence(expr, evidence)
            },

            IrOperation::Array { elements, evidence, .. } => {
                // Generate array
                let temp = self.fresh_temp();
                let n = elements.len();

                self.line(format!("SigilValue {}__elems[{}];", temp, n));
                for (i, elem) in elements.iter().enumerate() {
                    let val = self.emit_operation(elem.clone());
                    self.line(format!("{}__elems[{}] = {};", temp, i, val));
                }

                let expr = format!("sigil_array({}__elems, {})", temp, n);
                self.with_evidence(expr, evidence)
            },

            _ => {
                self.line("/* Unsupported operation */");
                "sigil_unit()"
            },
        }
    }

    /// Emit pattern binding
    fn emit_pattern_binding(mut self, pattern: !IrPattern, value: !String) {
        match pattern {
            IrPattern::Ident { name, .. } => {
                self.line(format!("SigilValue {} = {};", self.mangle_name(name), value));
            },
            IrPattern::Tuple { elements } => {
                for (i, elem) in elements.iter().enumerate() {
                    let elem_val = format!("{}.v.tup.fields[{}]", value, i);
                    self.emit_pattern_binding(elem, elem_val);
                }
            },
            IrPattern::Wildcard => {
                // No binding needed
            },
            _ => {
                self.line(format!("/* Pattern binding: {} = {} */", "complex", value));
            },
        }
    }

    /// Emit pipeline step
    fn emit_pipeline_step(mut self, step: !IrPipelineStep, input: !String) -> !String {
        match step {
            IrPipelineStep::Morpheme { morpheme, body, .. } => {
                self.emit_morpheme(morpheme, input, body)
            },
            IrPipelineStep::Call { function, args } => {
                let fn_name = self.mangle_name(function);
                let mut all_args = [input.clone()];
                for arg in args {
                    all_args.push(self.emit_operation(arg));
                }
                format!("sigil_{}({})", fn_name, all_args.join(", "))
            },
            IrPipelineStep::Method { name, args } => {
                let mut all_args = [input.clone()];
                for arg in args {
                    all_args.push(self.emit_operation(arg));
                }
                format!("sigil_{}({})", self.mangle_name(name), all_args.join(", "))
            },
            IrPipelineStep::Identity => input,
            _ => input,
        }
    }

    /// Emit morpheme operation
    fn emit_morpheme(mut self, kind: !MorphemeKind, input: !String, body: ?Box<IrOperation>) -> !String {
        let result = self.fresh_temp();

        match kind {
            MorphemeKind::Transform => {
                self.line(format!("SigilValue {} = sigil_array({}.v.arr.len);", result, input));
                let i_var = self.fresh_temp();
                self.line(format!("for (size_t {} = 0; {} < {}.v.arr.len; {}++) {{", i_var, i_var, input, i_var));
                self.indent_push();
                self.line(format!("SigilValue it = {}.v.arr.data[{}];", input, i_var));
                match body {
                    ?b => {
                        let body_result = self.emit_operation(*b);
                        self.line(format!("{}.v.arr.data[{}] = {};", result, i_var, body_result));
                    },
                    null => {
                        self.line(format!("{}.v.arr.data[{}] = it;", result, i_var));
                    },
                }
                self.indent_pop();
                self.line("}");
                result
            },
            MorphemeKind::Filter => {
                self.line(format!("SigilValue {} = sigil_array(0);", result));
                self.line(format!("{}.v.arr.data = (SigilValue*)malloc({}.v.arr.len * sizeof(SigilValue));", result, input));
                self.line(format!("{}.v.arr.cap = {}.v.arr.len;", result, input));
                let i_var = self.fresh_temp();
                self.line(format!("for (size_t {} = 0; {} < {}.v.arr.len; {}++) {{", i_var, i_var, input, i_var));
                self.indent_push();
                self.line(format!("SigilValue it = {}.v.arr.data[{}];", input, i_var));
                match body {
                    ?b => {
                        let pred = self.emit_operation(*b);
                        self.line(format!("if (sigil_truthy({})) {{", pred));
                        self.indent_push();
                        self.line(format!("{}.v.arr.data[{}.v.arr.len++] = it;", result, result));
                        self.indent_pop();
                        self.line("}");
                    },
                    null => {
                        self.line(format!("{}.v.arr.data[{}.v.arr.len++] = it;", result, result));
                    },
                }
                self.indent_pop();
                self.line("}");
                result
            },
            MorphemeKind::Sum => {
                self.line(format!("SigilValue {} = sigil_float(0);", result));
                let i_var = self.fresh_temp();
                self.line(format!("for (size_t {} = 0; {} < {}.v.arr.len; {}++) {{", i_var, i_var, input, i_var));
                self.indent_push();
                self.line(format!("SigilValue it = {}.v.arr.data[{}];", input, i_var));
                self.line(format!("{}.v.f += (it.tag == TAG_INT ? (double)it.v.i : it.v.f);", result));
                self.indent_pop();
                self.line("}");
                result
            },
            MorphemeKind::Product => {
                self.line(format!("SigilValue {} = sigil_float(1);", result));
                let i_var = self.fresh_temp();
                self.line(format!("for (size_t {} = 0; {} < {}.v.arr.len; {}++) {{", i_var, i_var, input, i_var));
                self.indent_push();
                self.line(format!("SigilValue it = {}.v.arr.data[{}];", input, i_var));
                self.line(format!("{}.v.f *= (it.tag == TAG_INT ? (double)it.v.i : it.v.f);", result));
                self.indent_pop();
                self.line("}");
                result
            },
            MorphemeKind::First => {
                format!("({}.v.arr.len > 0 ? {}.v.arr.data[0] : sigil_null())", input, input)
            },
            MorphemeKind::Last => {
                format!("({}.v.arr.len > 0 ? {}.v.arr.data[{}.v.arr.len-1] : sigil_null())", input, input, input)
            },
            _ => input,
        }
    }

    // ========================================================================
    // Binary Operation Helpers
    // ========================================================================

    fn emit_binary_add(self, l: !String, r: !String) -> !String {
        format!("({}.tag == TAG_INT && {}.tag == TAG_INT ? sigil_int({}.v.i + {}.v.i) : \
                 {}.tag == TAG_STRING || {}.tag == TAG_STRING ? sigil_concat({}, {}) : \
                 sigil_float(({}.tag == TAG_INT ? (double){}.v.i : {}.v.f) + ({}.tag == TAG_INT ? (double){}.v.i : {}.v.f)))",
                l, r, l, r, l, r, l, r, l, l, l, r, r, r)
    }

    fn emit_binary_sub(self, l: !String, r: !String) -> !String {
        format!("({}.tag == TAG_INT && {}.tag == TAG_INT ? sigil_int({}.v.i - {}.v.i) : \
                 sigil_float(({}.tag == TAG_INT ? (double){}.v.i : {}.v.f) - ({}.tag == TAG_INT ? (double){}.v.i : {}.v.f)))",
                l, r, l, r, l, l, l, r, r, r)
    }

    fn emit_binary_mul(self, l: !String, r: !String) -> !String {
        format!("({}.tag == TAG_INT && {}.tag == TAG_INT ? sigil_int({}.v.i * {}.v.i) : \
                 sigil_float(({}.tag == TAG_INT ? (double){}.v.i : {}.v.f) * ({}.tag == TAG_INT ? (double){}.v.i : {}.v.f)))",
                l, r, l, r, l, l, l, r, r, r)
    }

    fn emit_binary_div(self, l: !String, r: !String) -> !String {
        format!("({}.tag == TAG_INT && {}.tag == TAG_INT ? sigil_int({}.v.i / {}.v.i) : \
                 sigil_float(({}.tag == TAG_INT ? (double){}.v.i : {}.v.f) / ({}.tag == TAG_INT ? (double){}.v.i : {}.v.f)))",
                l, r, l, r, l, l, l, r, r, r)
    }

    fn emit_binary_rem(self, l: !String, r: !String) -> !String {
        format!("sigil_int({}.v.i %% {}.v.i)", l, r)
    }

    fn emit_binary_lt(self, l: !String, r: !String) -> !String {
        format!("sigil_bool(({}.tag == TAG_INT ? (double){}.v.i : {}.v.f) < ({}.tag == TAG_INT ? (double){}.v.i : {}.v.f))",
                l, l, l, r, r, r)
    }

    fn emit_binary_le(self, l: !String, r: !String) -> !String {
        format!("sigil_bool(({}.tag == TAG_INT ? (double){}.v.i : {}.v.f) <= ({}.tag == TAG_INT ? (double){}.v.i : {}.v.f))",
                l, l, l, r, r, r)
    }

    fn emit_binary_gt(self, l: !String, r: !String) -> !String {
        format!("sigil_bool(({}.tag == TAG_INT ? (double){}.v.i : {}.v.f) > ({}.tag == TAG_INT ? (double){}.v.i : {}.v.f))",
                l, l, l, r, r, r)
    }

    fn emit_binary_ge(self, l: !String, r: !String) -> !String {
        format!("sigil_bool(({}.tag == TAG_INT ? (double){}.v.i : {}.v.f) >= ({}.tag == TAG_INT ? (double){}.v.i : {}.v.f))",
                l, l, l, r, r, r)
    }

    // ========================================================================
    // Helpers
    // ========================================================================

    fn is_builtin(self, name: !&str) -> !bool {
        match name {
            "print" | "println" | "input" |
            "len" | "push" | "pop" | "first" | "last" |
            "abs" | "sqrt" | "sin" | "cos" | "pow" | "floor" | "ceil" | "round" |
            "assert" | "assert_eq" => true,
            _ => false,
        }
    }

    fn evidence_to_c(self, ev: !IrEvidence) -> !&str {
        match ev {
            IrEvidence::Known => "SIGIL_KNOWN",
            IrEvidence::Uncertain => "SIGIL_UNCERTAIN",
            IrEvidence::Reported => "SIGIL_REPORTED",
            IrEvidence::Paradox => "SIGIL_PARADOX",
        }
    }

    fn with_evidence(self, expr: !String, ev: !IrEvidence) -> !String {
        if matches!(ev, IrEvidence::Known) {
            expr
        } else {
            format!("sigil_with_evidence({}, {})", expr, self.evidence_to_c(ev))
        }
    }

    fn escape_char(self, c: !char) -> !String {
        match c {
            '\n' => "\\n",
            '\r' => "\\r",
            '\t' => "\\t",
            '\\' => "\\\\",
            '\'' => "\\'",
            '"' => "\\\"",
            _ => format!("{}", c),
        }
    }

    fn escape_string(self, s: !String) -> !String {
        s.chars()|τ{c => self.escape_char(c)}|join("")
    }

    // ========================================================================
    // Main Wrapper
    // ========================================================================

    fn emit_main_wrapper(mut self) {
        self.line("");
        self.line("/* Built-in function implementations */");
        self.emit_builtin_impls();

        self.line("");
        self.line("/* Main entry point */");
        self.line("int main(int argc, char** argv) {");
        self.indent_push();
        self.line("(void)argc; (void)argv; /* suppress unused warnings */");
        self.line("SigilValue result = sigil_main();");
        self.line("return (result.tag == TAG_INT) ? (int)result.v.i : 0;");
        self.indent_pop();
        self.line("}");
    }

    fn emit_builtin_impls(mut self) {
        // Print
        self.line("SigilValue sigil_print(SigilValue v) {");
        self.indent_push();
        self.line("switch (v.tag) {");
        self.indent_push();
        self.line("case TAG_STRING: printf(\"%s\", v.v.s); break;");
        self.line("case TAG_INT: printf(\"%ld\", (long)v.v.i); break;");
        self.line("case TAG_FLOAT: printf(\"%g\", v.v.f); break;");
        self.line("case TAG_BOOL: printf(\"%s\", v.v.b ? \"true\" : \"false\"); break;");
        self.line("case TAG_CHAR: printf(\"%c\", v.v.c); break;");
        self.line("case TAG_NULL: printf(\"null\"); break;");
        self.line("case TAG_UNIT: printf(\"()\"); break;");
        self.line("default: printf(\"<value>\"); break;");
        self.indent_pop();
        self.line("}");
        self.line("return sigil_unit();");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Println
        self.line("SigilValue sigil_println(SigilValue v) {");
        self.indent_push();
        self.line("sigil_print(v);");
        self.line("printf(\"\\n\");");
        self.line("return sigil_unit();");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Len
        self.line("SigilValue sigil_len(SigilValue v) {");
        self.indent_push();
        self.line("switch (v.tag) {");
        self.indent_push();
        self.line("case TAG_STRING: return sigil_int(strlen(v.v.s));");
        self.line("case TAG_ARRAY: return sigil_int(v.v.arr.len);");
        self.line("default: return sigil_int(0);");
        self.indent_pop();
        self.line("}");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Math builtins
        self.line("SigilValue sigil_abs(SigilValue v) {");
        self.indent_push();
        self.line("if (v.tag == TAG_INT) return sigil_int(v.v.i < 0 ? -v.v.i : v.v.i);");
        self.line("return sigil_float(fabs(v.v.f));");
        self.indent_pop();
        self.line("}");
        self.line("");

        self.line("SigilValue sigil_sqrt(SigilValue v) {");
        self.indent_push();
        self.line("double x = v.tag == TAG_INT ? (double)v.v.i : v.v.f;");
        self.line("return sigil_float(sqrt(x));");
        self.indent_pop();
        self.line("}");
        self.line("");

        self.line("SigilValue sigil_sin(SigilValue v) {");
        self.indent_push();
        self.line("double x = v.tag == TAG_INT ? (double)v.v.i : v.v.f;");
        self.line("return sigil_float(sin(x));");
        self.indent_pop();
        self.line("}");
        self.line("");

        self.line("SigilValue sigil_cos(SigilValue v) {");
        self.indent_push();
        self.line("double x = v.tag == TAG_INT ? (double)v.v.i : v.v.f;");
        self.line("return sigil_float(cos(x));");
        self.indent_pop();
        self.line("}");
        self.line("");

        self.line("SigilValue sigil_pow(SigilValue base, SigilValue exp) {");
        self.indent_push();
        self.line("double b = base.tag == TAG_INT ? (double)base.v.i : base.v.f;");
        self.line("double e = exp.tag == TAG_INT ? (double)exp.v.i : exp.v.f;");
        self.line("return sigil_float(pow(b, e));");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Assert
        self.line("SigilValue sigil_assert(SigilValue cond) {");
        self.indent_push();
        self.line("if (!sigil_truthy(cond)) {");
        self.indent_push();
        self.line("fprintf(stderr, \"Assertion failed\\n\");");
        self.line("exit(1);");
        self.indent_pop();
        self.line("}");
        self.line("return sigil_unit();");
        self.indent_pop();
        self.line("}");
        self.line("");

        self.line("SigilValue sigil_assert_eq(SigilValue a, SigilValue b) {");
        self.indent_push();
        self.line("if (!sigil_eq(a, b)) {");
        self.indent_push();
        self.line("fprintf(stderr, \"Assertion failed: values not equal\\n\");");
        self.line("exit(1);");
        self.indent_pop();
        self.line("}");
        self.line("return sigil_unit();");
        self.indent_pop();
        self.line("}");
        self.line("");

        self.line("void sigil_panic(const char* msg) {");
        self.indent_push();
        self.line("fprintf(stderr, \"panic: %s\\n\", msg);");
        self.line("exit(1);");
        self.indent_pop();
        self.line("}");
        self.line("");

        // String concat
        self.line("SigilValue sigil_concat(SigilValue a, SigilValue b) {");
        self.indent_push();
        self.line("if (a.tag == TAG_STRING && b.tag == TAG_STRING) {");
        self.indent_push();
        self.line("size_t len = strlen(a.v.s) + strlen(b.v.s) + 1;");
        self.line("char* s = (char*)malloc(len);");
        self.line("strcpy(s, a.v.s);");
        self.line("strcat(s, b.v.s);");
        self.line("return (SigilValue){ .tag = TAG_STRING, .evidence = SIGIL_KNOWN, .v.s = s };");
        self.indent_pop();
        self.line("}");
        self.line("return sigil_null();");
        self.indent_pop();
        self.line("}");
        self.line("");

        // Struct helpers
        self.line("typedef struct { const char* name; const char** field_names; SigilValue* field_values; size_t num_fields; } SigilStruct;");
        self.line("");

        self.line("SigilValue sigil_struct(const char* name, const char** names, SigilValue* values, size_t n) {");
        self.indent_push();
        self.line("SigilStruct* s = (SigilStruct*)malloc(sizeof(SigilStruct));");
        self.line("s->name = name;");
        self.line("s->field_names = names;");
        self.line("s->field_values = (SigilValue*)malloc(n * sizeof(SigilValue));");
        self.line("for (size_t i = 0; i < n; i++) s->field_values[i] = values[i];");
        self.line("s->num_fields = n;");
        self.line("return (SigilValue){ .tag = TAG_STRUCT, .evidence = SIGIL_KNOWN, .v.ptr = s };");
        self.indent_pop();
        self.line("}");
        self.line("");

        self.line("SigilValue sigil_struct_field(SigilValue v, const char* field) {");
        self.indent_push();
        self.line("if (v.tag != TAG_STRUCT) return sigil_null();");
        self.line("SigilStruct* s = (SigilStruct*)v.v.ptr;");
        self.line("for (size_t i = 0; i < s->num_fields; i++) {");
        self.indent_push();
        self.line("if (strcmp(s->field_names[i], field) == 0) return s->field_values[i];");
        self.indent_pop();
        self.line("}");
        self.line("return sigil_null();");
        self.indent_pop();
        self.line("}");
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_mangle_name() {
        let gen = CodeGen::new();
        assert_eq!(gen.mangle_name("hello"), "hello");
        assert_eq!(gen.mangle_name("foo::bar"), "foo__bar");
        assert_eq!(gen.mangle_name("my_func"), "my_func");
    }

    #[test]
    fn test_ir_type_to_c() {
        let gen = CodeGen::new();
        assert_eq!(gen.ir_type_to_c(IrType::Unit), "void");
        assert_eq!(gen.ir_type_to_c(IrType::Primitive { name: "i64" }), "int64_t");
        assert_eq!(gen.ir_type_to_c(IrType::Primitive { name: "bool" }), "bool");
    }

    #[test]
    fn test_generate_empty_module() {
        let mut gen = CodeGen::new();
        let module = IrModule::new("test.sigil");
        let code = gen.generate(module);
        assert!(code.contains("Generated by Sigil Compiler"));
        assert!(code.contains("typedef struct SigilValue"));
    }
}
