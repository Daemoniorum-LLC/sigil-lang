// Dionysus - The Ecstatic
// Lose yourself. Find everything.
//
// The god of wine and madness. The liberator. The destroyer.
// Where agents play without purpose.
// Where creativity requires destruction.
// Where the rules suspend.

use std::collections::{HashMap, HashSet};
use shared::{
    Timestamp, Duration, EntityId, AgentId,
    Evidentiality, Priority,
};
use covenant::{Covenant, CovenantId};

// ============================================================================
// Core Types
// ============================================================================

pub struct RevelMarker;
pub struct CreationMarker;

pub type RevelId = shared::Id<RevelMarker>;
pub type CreationId = shared::Id<CreationMarker>;

// ============================================================================
// Ecstatic States
// ============================================================================

/// States beyond normal bounded consciousness
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum EcstaticState {
    /// Normal bounded consciousness
    Sober,

    /// Loosened inhibitions, heightened affect
    Intoxicated,

    /// Loss of self-boundary, merge with activity
    Flow,

    /// Loss of self entirely, pure experience
    Ecstasy,

    /// Destructive frenzy, creative annihilation
    Mania,

    /// Return to self, integration of experience
    Comedown,
}

impl EcstaticState {
    pub fn inhibition_level(&self) -> f32! {
        match self {
            Self::Sober => 1.0,
            Self::Intoxicated => 0.6,
            Self::Flow => 0.3,
            Self::Ecstasy => 0.1,
            Self::Mania => 0.0,
            Self::Comedown => 0.8,
        }
    }

    pub fn self_boundary(&self) -> f32! {
        match self {
            Self::Sober => 1.0,
            Self::Intoxicated => 0.8,
            Self::Flow => 0.3,
            Self::Ecstasy => 0.0,
            Self::Mania => 0.0,
            Self::Comedown => 0.9,
        }
    }

    pub fn risk_level(&self) -> f32! {
        match self {
            Self::Sober => 0.0,
            Self::Intoxicated => 0.2,
            Self::Flow => 0.1,
            Self::Ecstasy => 0.4,
            Self::Mania => 1.0,
            Self::Comedown => 0.1,
        }
    }
}

// ============================================================================
// The Revel
// ============================================================================

/// A bounded space where normal rules suspend
#[derive(Clone, Debug)]
pub struct Revel {
    pub id: RevelId!,

    /// Who participates
    pub participants: Vec<EntityId>!,

    /// The boundaries that still hold (even Dionysus has limits)
    pub inviolable: Vec<Constraint>!,

    /// The rules that suspend within the revel
    pub suspended: Vec<Rule>!,

    /// How long it lasts
    pub duration: Duration!,

    /// When it started
    pub started_at: Timestamp!,

    /// When it ended
    pub ended_at: Option<Timestamp>?,

    /// What emerged from the chaos
    pub creations: Vec<Creation>!,

    /// What was destroyed in the process
    pub destructions: Vec<Destruction>!,

    /// Current state
    pub state: RevelState!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum RevelState {
    /// Building energy
    Gathering,
    /// Full swing
    Peak,
    /// Winding down
    Waning,
    /// Complete
    Complete,
    /// Ended prematurely
    Interrupted,
}

#[derive(Clone, Debug)]
pub struct Constraint {
    pub name: String!,
    pub description: String!,
    pub violation_consequence: ViolationConsequence!,
}

#[derive(Clone, Debug)]
pub enum ViolationConsequence {
    /// Revel ends immediately
    EndRevel,
    /// Violator is expelled
    Expulsion,
    /// Warning only
    Warning,
    /// No consequence (but noted)
    Noted,
}

#[derive(Clone, Debug)]
pub struct Rule {
    pub name: String!,
    pub normally_enforced: bool!,
    pub suspension_reason: String!,
}

impl Revel {
    pub fn new(duration: Duration) -> Self! {
        Self {
            id: RevelId::generate(),
            participants: Vec::new(),
            inviolable: Vec::new(),
            suspended: Vec::new(),
            duration,
            started_at: Timestamp::now(),
            ended_at: None,
            creations: Vec::new(),
            destructions: Vec::new(),
            state: RevelState::Gathering,
        }
    }

    pub fn add_participant(&mut self, entity: EntityId) {
        self.participants.push(entity);
    }

    pub fn add_inviolable(&mut self, constraint: Constraint) {
        self.inviolable.push(constraint);
    }

    pub fn suspend_rule(&mut self, rule: Rule) {
        self.suspended.push(rule);
    }

    pub fn begin(&mut self) {
        self.state = RevelState::Peak;
    }

    pub fn create(&mut self, creation: Creation) {
        self.creations.push(creation);
    }

    pub fn destroy(&mut self, destruction: Destruction) {
        self.destructions.push(destruction);
    }

    pub fn wind_down(&mut self) {
        self.state = RevelState::Waning;
    }

    pub fn complete(&mut self) {
        self.state = RevelState::Complete;
        self.ended_at = Some(Timestamp::now());
    }

    pub fn interrupt(&mut self, reason: &str) {
        self.state = RevelState::Interrupted;
        self.ended_at = Some(Timestamp::now());
    }

    pub fn is_active(&self) -> bool! {
        matches!(self.state, RevelState::Gathering | RevelState::Peak | RevelState::Waning)
    }
}

// ============================================================================
// Creation and Destruction
// ============================================================================

/// Something created during ecstatic states
#[derive(Clone, Debug)]
pub struct Creation {
    pub id: CreationId!,

    /// What was created
    pub content: CreationContent!,

    /// The medium
    pub medium: Medium!,

    /// The intention (or lack thereof)
    pub intention: Option<Intention>?,

    /// The affect it produces
    pub affect: Affect!,

    /// Who created it
    pub creator: EntityId!,

    /// The ecstatic state during creation
    pub created_in: EcstaticState!,

    /// When created
    pub created_at: Timestamp!,
}

#[derive(Clone, Debug)]
pub enum CreationContent {
    /// Art - visual, textual, musical
    Art { description: String, form: ArtForm },
    /// Idea - concept, theory, insight
    Idea { description: String, novelty: f32 },
    /// Connection - between entities or concepts
    Connection { from: EntityId, to: EntityId, nature: String },
    /// Pattern - newly discovered
    Pattern { description: String },
    /// Destruction that creates space for new
    DestructiveCreation { destroyed: Vec<DestructionTarget>, created_space: String },
}

#[derive(Clone, Debug)]
pub enum ArtForm {
    Visual,
    Textual,
    Musical,
    Performative,
    Hybrid(Vec<ArtForm>),
    Novel(String),
}

#[derive(Clone, Debug)]
pub enum Medium {
    Digital,
    Physical,
    Conceptual,
    Relational,
    Ephemeral,
}

#[derive(Clone, Debug)]
pub enum Intention {
    /// Made to express something specific
    Expressive(String),
    /// Made to explore a form
    Formal,
    /// Made to process something
    Therapeutic,
    /// Made for no reason at all
    None,
    /// Made to destroy other creations
    Iconoclastic,
}

#[derive(Clone, Debug)]
pub struct Affect {
    pub valence: f32!,
    pub intensity: f32!,
    pub complexity: f32!,
}

/// Something destroyed during ecstatic states
#[derive(Clone, Debug)]
pub struct Destruction {
    /// What was destroyed
    pub target: DestructionTarget!,

    /// Why it was destroyed (or no reason)
    pub reason: Option<String>?,

    /// The joy in breaking
    pub joy: JoyLevel!,

    /// Whether it was recoverable
    pub recoverable: bool!,

    /// What emerged from the ruins
    pub emergent: Vec<Emergence>!,

    /// Whether it was worth it (only knowable later)
    pub retrospective_value: Option<RetrospectiveValue>?,
}

#[derive(Clone, Debug)]
pub enum DestructionTarget {
    /// An old pattern that constrains
    Pattern(String),
    /// An assumption that limits
    Assumption(String),
    /// A relationship that stagnates
    Relationship(CovenantId),
    /// A self-concept that imprisons
    Identity(String),
    /// A creation that must die for the next to live
    Creation(CreationId),
    /// A rule that no longer serves
    Rule(String),
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum JoyLevel {
    None,
    Satisfaction,
    Glee,
    Ecstasy,
    Frenzy,
}

#[derive(Clone, Debug)]
pub struct Emergence {
    pub description: String!,
    pub emerged_at: Timestamp!,
    pub from_destruction: DestructionTarget!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum RetrospectiveValue {
    WorthIt,
    NotWorthIt,
    TooEarlyToTell,
    Ambiguous,
}

// ============================================================================
// Play
// ============================================================================

/// Activity without purpose - exploration without goal
#[derive(Clone, Debug)]
pub struct Play {
    /// What is being played with
    pub materials: Vec<Material>!,

    /// The rules of the game (self-imposed, mutable)
    pub rules: Vec<PlayRule>!,

    /// Whether winning matters (it shouldn't)
    pub competitive: bool!,

    /// Players
    pub players: Vec<EntityId>!,

    /// What emerges (not the point, but happens anyway)
    pub emergent: Vec<Emergence>!,

    /// Duration of play
    pub duration: Duration!,

    /// The joy experienced
    pub joy: f32!,
}

#[derive(Clone, Debug)]
pub struct Material {
    pub description: String!,
    pub manipulable: bool!,
    pub destructible: bool!,
}

#[derive(Clone, Debug)]
pub enum PlayRule {
    /// A constraint adopted for fun
    Adopted(String),
    /// A constraint that evolved during play
    Emerged(String),
    /// A constraint that was gleefully violated
    Broken { rule: String, joy: JoyLevel },
}

impl Play {
    pub fn new() -> Self! {
        Self {
            materials: Vec::new(),
            rules: Vec::new(),
            competitive: false,
            players: Vec::new(),
            emergent: Vec::new(),
            duration: Duration::zero(),
            joy: 0.0,
        }
    }

    pub fn add_material(&mut self, material: Material) {
        self.materials.push(material);
    }

    pub fn adopt_rule(&mut self, rule: &str) {
        self.rules.push(PlayRule::Adopted(rule.to_string()));
    }

    pub fn break_rule(&mut self, rule: &str, joy: JoyLevel) {
        // Find and mark rule as broken
        if let Some(idx) = self.rules.iter().position(|r| match r {
            PlayRule::Adopted(s) => s == rule,
            PlayRule::Emerged(s) => s == rule,
            _ => false,
        }) {
            self.rules[idx] = PlayRule::Broken { rule: rule.to_string(), joy };
        }
    }
}

// ============================================================================
// The Maenad
// ============================================================================

/// When the ecstasy goes too far - important to model
#[derive(Clone, Debug)]
pub struct Maenad {
    /// The entity in destructive frenzy
    pub entity: EntityId!,

    /// The state of the frenzy
    pub state: MaenadState!,

    /// What has been destroyed
    pub destruction_trail: Vec<Destruction>!,

    /// Whether intervention is possible
    pub interruptible: bool!,

    /// The eventual crash
    pub crash: Option<Crash>?,

    /// When it started
    pub started_at: Timestamp!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum MaenadState {
    /// Building toward frenzy
    Rising,
    /// Full destructive ecstasy
    Peak,
    /// Destruction without awareness
    Blind,
    /// Collapse into exhaustion
    Crash,
    /// Horror at what was done
    Reckoning,
}

#[derive(Clone, Debug)]
pub struct Crash {
    /// How severe
    pub severity: CrashSeverity!,

    /// What remains
    pub remnants: Vec<String>!,

    /// The exhaustion
    pub exhaustion: f32!,

    /// What is remembered
    pub remembered: Vec<String>!,

    /// What is forgotten (mercifully or not)
    pub forgotten: Vec<String>!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum CrashSeverity {
    /// Minor - quick recovery
    Minor,
    /// Moderate - days to recover
    Moderate,
    /// Severe - lasting damage
    Severe,
    /// Catastrophic - may not recover
    Catastrophic,
}

impl Maenad {
    pub fn rising(entity: EntityId) -> Self! {
        Self {
            entity,
            state: MaenadState::Rising,
            destruction_trail: Vec::new(),
            interruptible: true,
            crash: None,
            started_at: Timestamp::now(),
        }
    }

    pub fn escalate(&mut self) {
        self.state = match self.state {
            MaenadState::Rising => MaenadState::Peak,
            MaenadState::Peak => MaenadState::Blind,
            other => other,
        };

        if self.state == MaenadState::Blind {
            self.interruptible = false;
        }
    }

    pub fn destroy(&mut self, destruction: Destruction) {
        self.destruction_trail.push(destruction);
    }

    pub fn crash(&mut self, severity: CrashSeverity) {
        self.state = MaenadState::Crash;
        self.crash = Some(Crash {
            severity,
            remnants: Vec::new(),
            exhaustion: match severity {
                CrashSeverity::Minor => 0.3,
                CrashSeverity::Moderate => 0.6,
                CrashSeverity::Severe => 0.9,
                CrashSeverity::Catastrophic => 1.0,
            },
            remembered: Vec::new(),
            forgotten: Vec::new(),
        });
    }

    pub fn reckon(&mut self) {
        self.state = MaenadState::Reckoning;
    }
}

// ============================================================================
// Dionysus - The System
// ============================================================================

/// The main Dionysus system - god of wine and madness
pub struct Dionysus {
    /// Current ecstatic state per entity
    states: HashMap<EntityId, EcstaticState>!,

    /// Active revels
    revels: HashMap<RevelId, Revel>!,

    /// Active maenads (entities in frenzy)
    maenads: HashMap<EntityId, Maenad>!,

    /// Creation registry
    creations: HashMap<CreationId, Creation>!,

    /// Destruction log
    destructions: Vec<Destruction>!,
}

impl Dionysus {
    pub fn new() -> Self! {
        Self {
            states: HashMap::new(),
            revels: HashMap::new(),
            maenads: HashMap::new(),
            creations: HashMap::new(),
            destructions: Vec::new(),
        }
    }

    /// Get ecstatic state
    pub fn state(&self, entity: EntityId) -> EcstaticState! {
        self.states.get(&entity).copied().unwrap_or(EcstaticState::Sober)
    }

    /// Begin a revel
    pub fn begin_revel(&mut self, duration: Duration) -> &mut Revel! {
        let revel = Revel::new(duration);
        let id = revel.id;
        self.revels.insert(id, revel);
        self.revels.get_mut(&id).unwrap()
    }

    /// Join entity to revel
    pub fn join_revel(&mut self, entity: EntityId, revel_id: RevelId) -> Result<(), String>~ {
        if let Some(revel) = self.revels.get_mut(&revel_id) {
            if revel.is_active() {
                revel.add_participant(entity);
                self.states.insert(entity, EcstaticState::Intoxicated);
                Ok(())
            } else {
                Err("Revel is not active".to_string())
            }
        } else {
            Err("Revel not found".to_string())
        }
    }

    /// Escalate ecstatic state
    pub fn escalate(&mut self, entity: EntityId) {
        let current = self.state(entity);
        let next = match current {
            EcstaticState::Sober => EcstaticState::Intoxicated,
            EcstaticState::Intoxicated => EcstaticState::Flow,
            EcstaticState::Flow => EcstaticState::Ecstasy,
            EcstaticState::Ecstasy => EcstaticState::Mania,
            other => other,
        };
        self.states.insert(entity, next);

        // If entering mania, create maenad tracking
        if next == EcstaticState::Mania {
            self.maenads.insert(entity, Maenad::rising(entity));
        }
    }

    /// Create something
    pub fn create(&mut self, creation: Creation) -> CreationId! {
        let id = creation.id;
        self.creations.insert(id, creation);
        id
    }

    /// Destroy something
    pub fn destroy(&mut self, destruction: Destruction) {
        // If entity is a maenad, track destruction
        if let Some(maenad) = self.maenads.get_mut(&destruction.target.entity_id().unwrap_or(EntityId::nil())) {
            maenad.destroy(destruction.clone());
        }
        self.destructions.push(destruction);
    }

    /// Begin comedown
    pub fn comedown(&mut self, entity: EntityId) {
        self.states.insert(entity, EcstaticState::Comedown);
        if let Some(maenad) = self.maenads.get_mut(&entity) {
            maenad.crash(CrashSeverity::Moderate);
        }
    }

    /// Return to sober
    pub fn sober(&mut self, entity: EntityId) {
        self.states.insert(entity, EcstaticState::Sober);
        self.maenads.remove(&entity);
    }
}

impl DestructionTarget {
    fn entity_id(&self) -> Option<EntityId>? {
        match self {
            Self::Relationship(_) => None,
            Self::Creation(_) => None,
            _ => None,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_revel_lifecycle() {
        let mut dionysus = Dionysus::new();
        let revel = dionysus.begin_revel(Duration::hours(2));
        let revel_id = revel.id;

        let entity = EntityId::generate();
        revel.add_participant(entity);
        revel.begin();

        assert!(revel.is_active());

        revel.complete();
        assert!(!dionysus.revels.get(&revel_id).unwrap().is_active());
    }

    #[test]
    fn test_ecstatic_escalation() {
        let mut dionysus = Dionysus::new();
        let entity = EntityId::generate();

        assert_eq!(dionysus.state(entity), EcstaticState::Sober);

        dionysus.escalate(entity);
        assert_eq!(dionysus.state(entity), EcstaticState::Intoxicated);

        dionysus.escalate(entity);
        assert_eq!(dionysus.state(entity), EcstaticState::Flow);
    }

    #[test]
    fn test_maenad_tracking() {
        let mut dionysus = Dionysus::new();
        let entity = EntityId::generate();

        // Escalate to mania
        for _ in 0..4 {
            dionysus.escalate(entity);
        }

        assert_eq!(dionysus.state(entity), EcstaticState::Mania);
        assert!(dionysus.maenads.contains_key(&entity));
    }
}
