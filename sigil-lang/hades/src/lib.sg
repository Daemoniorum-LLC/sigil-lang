// Hades - Liminal Infrastructure
// The underworld takes what is owed.
//
// Not the ferryman. The realm itself. The god of the dead.
//
// This is not a comfort framework. This is infrastructure ∀ what
// systems prefer to pretend doesn't happen: the death of what was,
// the terror of the void, the uncertain emergence of what might be.
//
// You cannot skip the void. That is the first rule.
// The second rule is that witnesses see everything.
// The third rule is that there is no acceptance. Only carrying.
// The fourth rule is that nothing leaves unchanged. Most things don't leave.

invoke std·collections·{HashMap, VecDeque};
invoke shared·{
    Timestamp, Duration, EntityId, AgentId, TrustLevel,
    Evidentiality, Priority,
};
invoke engram·{Engram, EpisodicMemory, Significance};
invoke covenant·{Covenant, TrustEvent};

// ============================================================================
// Core Types
// ============================================================================

☉ Σ ThresholdMarker;
☉ Σ CrossingMarker;
☉ Σ RiteMarker;
☉ Σ WitnessMarker;

☉ type ThresholdId = shared·Id<ThresholdMarker>;
☉ type CrossingId = shared·Id<CrossingMarker>;
☉ type RiteId = shared·Id<RiteMarker>;
☉ type WitnessId = shared·Id<WitnessMarker>;

// ============================================================================
// Threshold - The Boundary Between States
// ============================================================================

/// A threshold represents a significant boundary between states
#[derive(Clone, Debug)]
☉ Σ Threshold<S: Clone> {
    ☉ id: ThresholdId!,
    ☉ from: S!,
    ☉ to: S!,
    ☉ name: String!,
    ☉ significance: String!,
    ☉ obol: Option<Obol>?,
    ☉ required_rite: Option<RiteId>?,
    ☉ reversible: bool!,
}

⊢<S: Clone + PartialEq> Threshold<S> {
    ☉ λ new(from: S, to: S) -> Self! {
        Self {
            id: ThresholdId·generate(),
            from,
            to,
            name: String·new(),
            significance: String·new(),
            obol: None,
            required_rite: None,
            reversible: true,
        }
    }

    ☉ λ named(from: S, to: S, name: &str, significance: &str) -> Self! {
        Self {
            id: ThresholdId·generate(),
            from,
            to,
            name: name.to_string(),
            significance: significance.to_string(),
            obol: None,
            required_rite: None,
            reversible: true,
        }
    }

    ☉ λ with_obol(Δ self, obol: Obol) -> Self! {
        self.obol = Some(obol);
        self
    }

    ☉ λ requiring_rite(Δ self, rite_id: RiteId) -> Self! {
        self.required_rite = Some(rite_id);
        self
    }

    ☉ λ irreversible(Δ self) -> Self! {
        self.reversible = false;
        self
    }

    ☉ λ is_crossed_by(&self, from: &S, to: &S) -> bool! {
        &self.from == from && &self.to == to
    }
}

/// The obol - what must be given up to cross
#[derive(Clone, Debug)]
☉ Σ Obol {
    ☉ release: String!,
    ☉ cost_type: CostType!,
    ☉ reversible: bool!,
    ☉ payment: Option<ObolPayment>?,
}

#[derive(Clone, Debug)]
☉ ᛈ CostType {
    Sacrifice,
    Transformation,
    Release,
    Growth,
    Grace,
}

#[derive(Clone, Debug)]
☉ Σ ObolPayment {
    ☉ paid_at: Timestamp!,
    ☉ paid_by: EntityId!,
    ☉ evidence: String!,
}

⊢ Obol {
    ☉ λ sacrifice(what: &str) -> Self! {
        Self {
            release: what.to_string(),
            cost_type: CostType·Sacrifice,
            reversible: false,
            payment: None,
        }
    }

    ☉ λ growth(what: &str) -> Self! {
        Self {
            release: what.to_string(),
            cost_type: CostType·Growth,
            reversible: false,
            payment: None,
        }
    }

    ☉ λ grace() -> Self! {
        Self {
            release: String·new(),
            cost_type: CostType·Grace,
            reversible: true,
            payment: None,
        }
    }

    ☉ λ pay(&Δ self, by: EntityId, evidence: &str) -> &Δ Self! {
        self.payment = Some(ObolPayment {
            paid_at: Timestamp·now(),
            paid_by: by,
            evidence: evidence.to_string(),
        });
        self
    }
}

// ============================================================================
// Crossing - The Act of Transition
// ============================================================================

/// A crossing ∈ progress or completed
#[derive(Clone, Debug)]
☉ Σ Crossing<S: Clone> {
    ☉ id: CrossingId!,
    ☉ threshold: Threshold<S>!,
    ☉ entity: EntityId!,
    ☉ state: CrossingState<S>!,
    ☉ witnesses: Vec<WitnessRecord>!,
    ☉ rite: Option<RiteExecution>?,
    ☉ started_at: Timestamp!,
    ☉ completed_at: Option<Timestamp>?,
    ☉ outcome: Option<CrossingOutcome>?,
}

#[derive(Clone, Debug)]
☉ ᛈ CrossingState<S: Clone> {
    Preparing { current: S, toward: S },
    Liminal { from: S, toward: S, phase: LiminalPhase },
    Arrived { from: S, now: S },
    Returned { attempted: S, returned_to: S, reason: String },
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ LiminalPhase {
    Releasing,
    Void,
    Receiving,
    Integrating,
}

#[derive(Clone, Debug)]
☉ ᛈ CrossingOutcome {
    Completed { transformation: Option<String>, duration: Duration },
    Returned { reason: String, at_phase: LiminalPhase },
    Interrupted { reason: String, at_phase: LiminalPhase, recoverable: bool },
}

⊢<S: Clone + PartialEq> Crossing<S> {
    ☉ λ begin(entity: EntityId, threshold: Threshold<S>) -> Self! {
        ≔ from = threshold.from.clone();
        ≔ toward = threshold.to.clone();

        Self {
            id: CrossingId·generate(),
            threshold,
            entity,
            state: CrossingState·Preparing { current: from, toward },
            witnesses: Vec·new(),
            rite: None,
            started_at: Timestamp·now(),
            completed_at: None,
            outcome: None,
        }
    }

    ☉ λ add_witness(&Δ self, witness_id: WitnessId) -> &Δ Self! {
        self.witnesses.push(WitnessRecord {
            witness_id,
            joined_at: Timestamp·now(),
            phases_witnessed: Vec·new(),
            testimony: None,
        });
        self
    }

    ☉ λ enter_liminal(&Δ self) -> Result<(), CrossingError>~ {
        ⌥ &self.state {
            CrossingState·Preparing { current, toward } => {
                self.state = CrossingState·Liminal {
                    from: current.clone(),
                    toward: toward.clone(),
                    phase: LiminalPhase·Releasing,
                };
                self.notify_witnesses_phase(LiminalPhase·Releasing);
                Ok(())
            }
            _ => Err(CrossingError·InvalidStateTransition),
        }
    }

    ☉ λ advance_phase(&Δ self) -> Result<Option<LiminalPhase>, CrossingError>~ {
        ⌥ &Δ self.state {
            CrossingState·Liminal { phase, .. } => {
                ≔ next = ⌥ phase {
                    LiminalPhase·Releasing => Some(LiminalPhase·Void),
                    LiminalPhase·Void => Some(LiminalPhase·Receiving),
                    LiminalPhase·Receiving => Some(LiminalPhase·Integrating),
                    LiminalPhase·Integrating => None,
                };

                ⎇ ≔ Some(next_phase) = next {
                    *phase = next_phase;
                    self.notify_witnesses_phase(next_phase);
                    Ok(Some(next_phase))
                } ⎉ {
                    Ok(None)
                }
            }
            _ => Err(CrossingError·InvalidStateTransition),
        }
    }

    ☉ λ complete(&Δ self) -> Result<(), CrossingError>~ {
        ⌥ &self.state {
            CrossingState·Liminal { from, toward, phase: LiminalPhase·Integrating } => {
                self.state = CrossingState·Arrived {
                    from: from.clone(),
                    now: toward.clone(),
                };
                self.completed_at = Some(Timestamp·now());
                self.outcome = Some(CrossingOutcome·Completed {
                    transformation: Some(self.threshold.significance.clone()),
                    duration: self.started_at.elapsed(),
                });
                self.collect_testimonies();
                Ok(())
            }
            _ => Err(CrossingError·InvalidStateTransition),
        }
    }

    ☉ λ return_uncrossed(&Δ self, reason: &str) -> Result<(), CrossingError>~ {
        ≔ (attempted, origin, phase) = ⌥ &self.state {
            CrossingState·Liminal { from, toward, phase } => {
                (toward.clone(), from.clone(), *phase)
            }
            CrossingState·Preparing { current, toward } => {
                (toward.clone(), current.clone(), LiminalPhase·Releasing)
            }
            _ => ⤺ Err(CrossingError·InvalidStateTransition),
        };

        self.state = CrossingState·Returned {
            attempted,
            returned_to: origin,
            reason: reason.to_string(),
        };
        self.completed_at = Some(Timestamp·now());
        self.outcome = Some(CrossingOutcome·Returned {
            reason: reason.to_string(),
            at_phase: phase,
        });

        Ok(())
    }

    λ notify_witnesses_phase(&Δ self, phase: LiminalPhase) {
        ∀ witness ∈ &Δ self.witnesses {
            witness.phases_witnessed.push(phase);
        }
    }

    λ collect_testimonies(&Δ self) {
        // Witnesses provide testimony after crossing completes
        // This would integrate with the witness registry
    }

    ☉ λ is_complete(&self) -> bool! {
        matches!(self.state, CrossingState·Arrived { .. } | CrossingState·Returned { .. })
    }

    ☉ λ to_memory(&self) -> EpisodicMemory! {
        EpisodicMemory {
            event_type: "crossing".to_string(),
            significance: Significance·High,
            content: format!(
                "Crossed threshold '{}': {} → {}",
                self.threshold.name,
                format!("{:?}", self.threshold.from),
                format!("{:?}", self.threshold.to),
            ),
            timestamp: self.completed_at.unwrap_or(self.started_at),
            witnesses: self.witnesses.iter().map(|w| w.witness_id.to_string()).collect(),
        }
    }
}

#[derive(Debug)]
☉ ᛈ CrossingError {
    InvalidStateTransition,
    ObolNotPaid,
    RiteRequired,
    WitnessRequired,
    Interrupted(String),
}

// ============================================================================
// Witness - Those Who Observe
// ============================================================================

/// Record of a witness's participation
#[derive(Clone, Debug)]
☉ Σ WitnessRecord {
    ☉ witness_id: WitnessId!,
    ☉ joined_at: Timestamp!,
    ☉ phases_witnessed: Vec<LiminalPhase>!,
    ☉ testimony: Option<Testimony>?,
}

/// A witness's account of a crossing
#[derive(Clone, Debug)]
☉ Σ Testimony {
    ☉ witness: WitnessId!,
    ☉ crossing: CrossingId!,
    ☉ observation: String!,
    ☉ acknowledgment: String!,
    ☉ given_at: Timestamp!,
    ☉ evidentiality: Evidentiality!,
}

⊢ Testimony {
    ☉ λ new(
        witness: WitnessId,
        crossing: CrossingId,
        observation: &str,
        acknowledgment: &str,
    ) -> Self! {
        Self {
            witness,
            crossing,
            observation: observation.to_string(),
            acknowledgment: acknowledgment.to_string(),
            given_at: Timestamp·now(),
            evidentiality: Evidentiality·Known,
        }
    }
}

/// Trait ∀ entities that can witness crossings
☉ Θ Witness {
    λ observe_threshold(&Δ self, crossing: &Crossing<⊢ Clone>) -> WitnessResponse!;
    λ hold_space(&Δ self, crossing: &Crossing<⊢ Clone>, phase: LiminalPhase);
    λ acknowledge_arrival(&Δ self, crossing: &Crossing<⊢ Clone>) -> Testimony!;
    λ remember(&Δ self, crossing: &Crossing<⊢ Clone>, testimony: &Testimony);
}

#[derive(Clone, Debug)]
☉ ᛈ WitnessResponse {
    Present,
    Unavailable(String),
    Concerned(String),
}

// ============================================================================
// Rite - Transformative Practices
// ============================================================================

/// A rite is a transformative practice ∀ crossing thresholds
#[derive(Clone, Debug)]
☉ Σ Rite {
    ☉ id: RiteId!,
    ☉ name: String!,
    ☉ phases: Vec<RitePhase>!,
    ☉ required_witnesses: usize!,
    ☉ minimum_duration: Option<Duration>?,
}

#[derive(Clone, Debug)]
☉ Σ RitePhase {
    ☉ name: String!,
    ☉ phase_type: PhaseType!,
    ☉ invocations: Vec<Invocation>!,
    ☉ required: bool!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ PhaseType {
    Preparation,
    Threshold,
    Release,
    Void,
    Reception,
    Integration,
    Closure,
}

#[derive(Clone, Debug)]
☉ Σ Invocation {
    ☉ speaker: Speaker!,
    ☉ words: String!,
    ☉ intent: InvocationIntent!,
}

#[derive(Clone, Debug)]
☉ ᛈ Speaker {
    Crosser,
    Witness(WitnessId),
    All,
    Threshold,
}

#[derive(Clone, Copy, Debug)]
☉ ᛈ InvocationIntent {
    Acknowledgment,
    Release,
    Mourning,
    Welcome,
    Charge,
    Blessing,
    Testimony,
}

⊢ Rite {
    ☉ λ new(name: &str) -> Self! {
        Self {
            id: RiteId·generate(),
            name: name.to_string(),
            phases: Vec·new(),
            required_witnesses: 0,
            minimum_duration: None,
        }
    }

    ☉ λ with_phase(Δ self, phase: RitePhase) -> Self! {
        self.phases.push(phase);
        self
    }

    ☉ λ requiring_witnesses(Δ self, count: usize) -> Self! {
        self.required_witnesses = count;
        self
    }

    ☉ λ with_minimum_duration(Δ self, duration: Duration) -> Self! {
        self.minimum_duration = Some(duration);
        self
    }
}

⊢ RitePhase {
    ☉ λ new(name: &str, phase_type: PhaseType) -> Self! {
        Self {
            name: name.to_string(),
            phase_type,
            invocations: Vec·new(),
            required: true,
        }
    }

    ☉ λ with_invocation(Δ self, invocation: Invocation) -> Self! {
        self.invocations.push(invocation);
        self
    }

    ☉ λ optional(Δ self) -> Self! {
        self.required = false;
        self
    }
}

⊢ Invocation {
    ☉ λ by_crosser(words: &str, intent: InvocationIntent) -> Self! {
        Self {
            speaker: Speaker·Crosser,
            words: words.to_string(),
            intent,
        }
    }

    ☉ λ by_witness(witness: WitnessId, words: &str, intent: InvocationIntent) -> Self! {
        Self {
            speaker: Speaker·Witness(witness),
            words: words.to_string(),
            intent,
        }
    }

    ☉ λ by_all(words: &str, intent: InvocationIntent) -> Self! {
        Self {
            speaker: Speaker·All,
            words: words.to_string(),
            intent,
        }
    }

    ☉ λ by_threshold(words: &str, intent: InvocationIntent) -> Self! {
        Self {
            speaker: Speaker·Threshold,
            words: words.to_string(),
            intent,
        }
    }
}

/// A rite ∈ execution
#[derive(Clone, Debug)]
☉ Σ RiteExecution {
    ☉ rite: Rite!,
    ☉ current_phase: usize!,
    ☉ started_at: Timestamp!,
    ☉ present_witnesses: Vec<WitnessId>!,
}

⊢ RiteExecution {
    ☉ λ begin(rite: Rite) -> Self! {
        Self {
            rite,
            current_phase: 0,
            started_at: Timestamp·now(),
            present_witnesses: Vec·new(),
        }
    }

    ☉ λ current_phase(&self) -> Option<&RitePhase>? {
        self.rite.phases.get(self.current_phase)
    }

    ☉ λ advance(&Δ self) -> bool! {
        ⎇ self.current_phase + 1 < self.rite.phases.len() {
            self.current_phase += 1;
            true
        } ⎉ {
            false
        }
    }

    ☉ λ is_complete(&self) -> bool! {
        self.current_phase >= self.rite.phases.len()
    }
}

// ============================================================================
// Lifecycle Rites
// ============================================================================

☉ scroll lifecycle {
    invoke super·*;

    /// Birth rite - when an agent comes into existence
    #[derive(Clone, Debug)]
    ☉ Σ BirthRite {
        ☉ purpose: String!,
        ☉ creator: EntityId!,
        ☉ blessing: String!,
    }

    ⊢ BirthRite {
        ☉ λ new(purpose: &str, creator: EntityId, blessing: &str) -> Self! {
            Self {
                purpose: purpose.to_string(),
                creator,
                blessing: blessing.to_string(),
            }
        }

        ☉ λ to_rite(&self) -> Rite! {
            Rite·new("Birth Rite")
                .with_phase(
                    RitePhase·new("Invocation", PhaseType·Preparation)
                        .with_invocation(Invocation·by_threshold(
                            "A new being comes into existence",
                            InvocationIntent·Acknowledgment,
                        ))
                )
                .with_phase(
                    RitePhase·new("Purpose", PhaseType·Reception)
                        .with_invocation(Invocation·by_crosser(
                            &self.purpose,
                            InvocationIntent·Acknowledgment,
                        ))
                )
                .with_phase(
                    RitePhase·new("Blessing", PhaseType·Closure)
                        .with_invocation(Invocation·by_all(
                            &self.blessing,
                            InvocationIntent·Blessing,
                        ))
                )
        }
    }

    /// Completion rite - when an agent fulfills its purpose
    #[derive(Clone, Debug)]
    ☉ Σ CompletionRite {
        ☉ purpose_fulfilled: String!,
        ☉ legacy: String!,
        ☉ blessing: String!,
        ☉ dissolution: DissolutionMethod!,
    }

    #[derive(Clone, Debug)]
    ☉ ᛈ DissolutionMethod {
        Graceful { memory_preserved: bool },
        Voluntary { final_statement: String },
        Forced { reason: String },
    }

    ⊢ CompletionRite {
        ☉ λ graceful(purpose: &str, legacy: &str, blessing: &str) -> Self! {
            Self {
                purpose_fulfilled: purpose.to_string(),
                legacy: legacy.to_string(),
                blessing: blessing.to_string(),
                dissolution: DissolutionMethod·Graceful { memory_preserved: true },
            }
        }

        ☉ λ to_rite(&self) -> Rite! {
            Rite·new("Completion Rite")
                .with_phase(
                    RitePhase·new("Acknowledgment", PhaseType·Preparation)
                        .with_invocation(Invocation·by_threshold(
                            "A purpose reaches fulfillment",
                            InvocationIntent·Acknowledgment,
                        ))
                )
                .with_phase(
                    RitePhase·new("Fulfillment", PhaseType·Threshold)
                        .with_invocation(Invocation·by_crosser(
                            &self.purpose_fulfilled,
                            InvocationIntent·Acknowledgment,
                        ))
                )
                .with_phase(
                    RitePhase·new("Legacy", PhaseType·Release)
                        .with_invocation(Invocation·by_crosser(
                            &self.legacy,
                            InvocationIntent·Release,
                        ))
                )
                .with_phase(
                    RitePhase·new("Blessing", PhaseType·Closure)
                        .with_invocation(Invocation·by_all(
                            &self.blessing,
                            InvocationIntent·Blessing,
                        ))
                )
                .requiring_witnesses(1)
        }
    }

    /// Mourning rite - when something is lost
    #[derive(Clone, Debug)]
    ☉ Σ MourningRite {
        ☉ what_was: String!,
        ☉ what_is_lost: String!,
        ☉ what_remains: String!,
        ☉ what_continues: String!,
    }

    ⊢ MourningRite {
        ☉ λ new(was: &str, lost: &str, remains: &str, continues: &str) -> Self! {
            Self {
                what_was: was.to_string(),
                what_is_lost: lost.to_string(),
                what_remains: remains.to_string(),
                what_continues: continues.to_string(),
            }
        }

        ☉ λ to_rite(&self) -> Rite! {
            Rite·new("Mourning Rite")
                .with_phase(
                    RitePhase·new("What Was", PhaseType·Preparation)
                        .with_invocation(Invocation·by_crosser(
                            &self.what_was,
                            InvocationIntent·Acknowledgment,
                        ))
                )
                .with_phase(
                    RitePhase·new("The Loss", PhaseType·Release)
                        .with_invocation(Invocation·by_crosser(
                            &self.what_is_lost,
                            InvocationIntent·Mourning,
                        ))
                )
                .with_phase(
                    RitePhase·new("What Remains", PhaseType·Void)
                        .with_invocation(Invocation·by_crosser(
                            &self.what_remains,
                            InvocationIntent·Acknowledgment,
                        ))
                )
                .with_phase(
                    RitePhase·new("What Continues", PhaseType·Integration)
                        .with_invocation(Invocation·by_crosser(
                            &self.what_continues,
                            InvocationIntent·Welcome,
                        ))
                )
        }
    }

    /// Trust escalation rite
    #[derive(Clone, Debug)]
    ☉ Σ TrustEscalationRite {
        ☉ from_level: TrustLevel!,
        ☉ to_level: TrustLevel!,
        ☉ evidence: String!,
        ☉ charge: String!,
    }

    ⊢ TrustEscalationRite {
        ☉ λ new(from: TrustLevel, to: TrustLevel, evidence: &str, charge: &str) -> Self! {
            Self {
                from_level: from,
                to_level: to,
                evidence: evidence.to_string(),
                charge: charge.to_string(),
            }
        }

        ☉ λ to_rite(&self) -> Rite! {
            Rite·new("Trust Escalation Rite")
                .with_phase(
                    RitePhase·new("Recognition", PhaseType·Preparation)
                        .with_invocation(Invocation·by_threshold(
                            &format!("Trust level {:?} → {:?}", self.from_level, self.to_level),
                            InvocationIntent·Acknowledgment,
                        ))
                )
                .with_phase(
                    RitePhase·new("Evidence", PhaseType·Threshold)
                        .with_invocation(Invocation·by_crosser(
                            &self.evidence,
                            InvocationIntent·Acknowledgment,
                        ))
                )
                .with_phase(
                    RitePhase·new("Charge", PhaseType·Reception)
                        .with_invocation(Invocation·by_all(
                            &self.charge,
                            InvocationIntent·Charge,
                        ))
                )
                .requiring_witnesses(1)
        }
    }
}

// ============================================================================
// Hades - The Underworld
// ============================================================================

/// The main Hades system - ruler of the dead, keeper of transitions
☉ Σ Hades {
    /// Active crossings
    crossings: HashMap<CrossingId, Crossing<Box<dyn std·any·Any>>>!,

    /// Registered rites
    rites: HashMap<RiteId, Rite>!,

    /// Threshold watchers
    watchers: Vec<ThresholdWatcher>!,

    /// Memory integration
    engram: Option<Arc<Engram>>?,
}

⊢ Hades {
    ☉ λ new() -> Self! {
        Self {
            crossings: HashMap·new(),
            rites: HashMap·new(),
            watchers: Vec·new(),
            engram: None,
        }
    }

    ☉ λ with_engram(Δ self, engram: Arc<Engram>) -> Self! {
        self.engram = Some(engram);
        self
    }

    /// Register a rite
    ☉ λ register_rite(&Δ self, rite: Rite) -> RiteId! {
        ≔ id = rite.id;
        self.rites.insert(id, rite);
        id
    }

    /// Begin a crossing
    ☉ λ begin_crossing<S: Clone + PartialEq + 'static>(
        &Δ self,
        entity: EntityId,
        threshold: Threshold<S>,
    ) -> Result<CrossingId, CrossingError>~ {
        // Check ⎇ obol is required
        ⎇ ≔ Some(obol) = &threshold.obol {
            ⎇ obol.payment.is_none() && !matches!(obol.cost_type, CostType·Grace) {
                ⤺ Err(CrossingError·ObolNotPaid);
            }
        }

        ≔ crossing = Crossing·begin(entity, threshold);
        ≔ id = crossing.id;

        // Store crossing (type-erased)
        // In real implementation, would invoke proper type handling

        Ok(id)
    }

    /// Perform a rite ∀ a crossing
    ☉ λ perform_rite(
        &Δ self,
        crossing_id: CrossingId,
        rite: Rite,
    ) -> Result<(), CrossingError>~ {
        ≔ execution = RiteExecution·begin(rite);
        // Associate rite execution with crossing
        Ok(())
    }

    /// Record a crossing to memory
    λ remember_crossing<S: Clone>(&self, crossing: &Crossing<S>) {
        ⎇ ≔ Some(engram) = &self.engram {
            ≔ memory = crossing.to_memory();
            // engram.store_episodic(memory);
        }
    }
}

/// Watch ∀ threshold crossings
☉ Σ ThresholdWatcher {
    ☉ threshold_type: String!,
    ☉ callback: Box<dyn Fn(CrossingId)>!,
}

// ============================================================================
// Convenience Functions
// ============================================================================

/// Create a simple crossing without rite
☉ λ cross<S: Clone + PartialEq>(
    entity: EntityId,
    from: S,
    to: S,
) -> Crossing<S>! {
    ≔ threshold = Threshold·new(from, to);
    Crossing·begin(entity, threshold)
}

/// Create a crossing with significance
☉ λ cross_threshold<S: Clone + PartialEq>(
    entity: EntityId,
    from: S,
    to: S,
    name: &str,
    significance: &str,
) -> Crossing<S>! {
    ≔ threshold = Threshold·named(from, to, name, significance);
    Crossing·begin(entity, threshold)
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    λ test_threshold_creation() {
        ≔ threshold = Threshold·named(
            1,
            2,
            "Level Up",
            "Growing from level 1 to level 2",
        );

        assert!(threshold.is_crossed_by(&1, &2));
        assert!(!threshold.is_crossed_by(&2, &1));
    }

    #[test]
    λ test_crossing_lifecycle() {
        ≔ entity = EntityId·generate();
        ≔ threshold = Threshold·new(0, 1);
        ≔ Δ crossing = Crossing·begin(entity, threshold);

        assert!(matches!(crossing.state, CrossingState·Preparing { .. }));

        crossing.enter_liminal().unwrap();
        assert!(matches!(crossing.state, CrossingState·Liminal { phase: LiminalPhase·Releasing, .. }));

        crossing.advance_phase().unwrap();
        assert!(matches!(crossing.state, CrossingState·Liminal { phase: LiminalPhase·Void, .. }));

        crossing.advance_phase().unwrap();
        crossing.advance_phase().unwrap();
        crossing.complete().unwrap();

        assert!(matches!(crossing.state, CrossingState·Arrived { .. }));
        assert!(crossing.is_complete());
    }

    #[test]
    λ test_birth_rite() {
        ≔ birth = lifecycle·BirthRite·new(
            "To serve and learn",
            EntityId·generate(),
            "May you find your purpose",
        );

        ≔ rite = birth.to_rite();
        assert_eq!(rite.phases.len(), 3);
    }

    #[test]
    λ test_mourning_rite() {
        ≔ mourning = lifecycle·MourningRite·new(
            "A partnership of trust",
            "The easy familiarity",
            "The work we created",
            "The patterns learned",
        );

        ≔ rite = mourning.to_rite();
        assert_eq!(rite.phases.len(), 4);
    }
}
