// Form Validation Module
// Schema-based form validation with reactive feedback
//
// Sigil Language Features:
// - Quantifiers: ∀ (for all validation rules), ∃ (any error exists)
// - Morpheme operators: τ (map), φ (filter) for rule processing
// - Evidentiality: ! (known valid), ? (uncertain), ~ (user input)
// - Logical operators: ∧, ∨, ¬ for combining validators

use std::collections::HashMap;
use crate::hooks::{use_state, use_effect, use_memo, use_callback};
use crate::state::{signal, computed, Signal, Computed};

// ============================================================================
// Validation Result Types
// ============================================================================

/// Validation result with evidentiality
pub enum ValidationResult {
    /// Value is known valid (!)
    Valid,
    /// Value is invalid with error message (~)
    Invalid(String~),
    /// Validation is pending (async)
    Pending,
    /// Value hasn't been validated yet
    Pristine
}

impl ValidationResult {
    pub fn is_valid(&self) -> bool! {
        matches!(self, ValidationResult::Valid)
    }

    pub fn is_invalid(&self) -> bool! {
        matches!(self, ValidationResult::Invalid(_))
    }

    pub fn error(&self) -> Option<&str>? {
        match self {
            ValidationResult::Invalid(msg~) => Some(msg~),
            _ => None
        }
    }
}

/// Field validation state
pub struct FieldState<T> {
    /// Current value (from user input, marked as external ~)
    pub value: T~,
    /// Validation result
    pub result: ValidationResult!,
    /// Whether field has been touched
    pub touched: bool!,
    /// Whether field has been modified
    pub dirty: bool!
}

impl<T: Default> FieldState<T> {
    pub fn new() -> Self! {
        FieldState {
            value: T::default(),
            result: ValidationResult::Pristine,
            touched: false,
            dirty: false
        }
    }

    /// Should show error (touched and invalid)
    pub fn show_error(&self) -> bool! {
        self.touched ∧ self.result·is_invalid()
    }
}

// ============================================================================
// Validators
// ============================================================================

/// A validator function type
pub type Validator<T> = fn(&T~) -> ValidationResult!;

/// Built-in validators
pub mod validators {
    use super::*;

    /// Required field validator
    pub fn required<T: AsRef<str>>() -> Validator<T>! {
        |value~: &T~| {
            if value~·as_ref()·trim()·is_empty() {
                ValidationResult::Invalid("This field is required"~)
            } else {
                ValidationResult::Valid
            }
        }
    }

    /// Minimum length validator
    pub fn min_length(min: usize) -> Validator<String>! {
        move |value~: &String~| {
            if value~·len() < min {
                ValidationResult::Invalid(format!("Must be at least {} characters", min)~)
            } else {
                ValidationResult::Valid
            }
        }
    }

    /// Maximum length validator
    pub fn max_length(max: usize) -> Validator<String>! {
        move |value~: &String~| {
            if value~·len() > max {
                ValidationResult::Invalid(format!("Must be at most {} characters", max)~)
            } else {
                ValidationResult::Valid
            }
        }
    }

    /// Email format validator
    pub fn email() -> Validator<String>! {
        |value~: &String~| {
            // Simple email regex check
            let has_at! = value~·contains('@')
            let has_dot! = value~·contains('.')
            let not_empty! = ¬value~·is_empty()

            if not_empty ∧ has_at ∧ has_dot {
                ValidationResult::Valid
            } else {
                ValidationResult::Invalid("Invalid email address"~)
            }
        }
    }

    /// Pattern validator (regex)
    pub fn pattern(regex: &str, message: &str) -> Validator<String>! {
        let regex_str! = regex.to_string()
        let msg! = message.to_string()

        move |value~: &String~| {
            // Simplified pattern matching
            if value~·matches(&regex_str) {
                ValidationResult::Valid
            } else {
                ValidationResult::Invalid(msg·clone()~)
            }
        }
    }

    /// Numeric range validator
    pub fn range<T: PartialOrd + Copy>(min: T, max: T) -> Validator<T>! {
        move |value~: &T~| {
            if *value~ >= min ∧ *value~ <= max {
                ValidationResult::Valid
            } else {
                ValidationResult::Invalid(format!("Must be between {:?} and {:?}", min, max)~)
            }
        }
    }

    /// Custom validator
    pub fn custom<T>(
        predicate: fn(&T~) -> bool,
        message: &str
    ) -> Validator<T>! {
        let msg! = message.to_string()

        move |value~: &T~| {
            if predicate(value~) {
                ValidationResult::Valid
            } else {
                ValidationResult::Invalid(msg·clone()~)
            }
        }
    }

    /// Async validator (e.g., checking if username is taken)
    pub fn async_custom<T: Clone + 'static>(
        check: fn(T~) -> Future<Output = bool>,
        message: &str
    ) -> Validator<T>! {
        let msg! = message.to_string()

        move |value~: &T~| {
            // Return pending, actual validation happens async
            ValidationResult::Pending
        }
    }

    /// Compose multiple validators with AND (∧)
    /// All validators must pass
    pub fn all<T: Clone>(validators: Vec<Validator<T>>) -> Validator<T>! {
        move |value~: &T~| {
            // Using ∀ quantifier: all validators must pass
            for validator in &validators {
                match validator(value~) {
                    ValidationResult::Valid => continue,
                    result => return result
                }
            }
            ValidationResult::Valid
        }
    }

    /// Compose multiple validators with OR (∨)
    /// At least one validator must pass
    pub fn any<T: Clone>(validators: Vec<Validator<T>>) -> Validator<T>! {
        move |value~: &T~| {
            // Using ∃ quantifier: at least one must pass
            let mut last_error! = ValidationResult::Valid

            for validator in &validators {
                match validator(value~) {
                    ValidationResult::Valid => return ValidationResult::Valid,
                    result => last_error = result
                }
            }

            last_error
        }
    }

    /// Conditional validator
    pub fn when<T: Clone>(
        condition: fn(&T~) -> bool,
        validator: Validator<T>
    ) -> Validator<T>! {
        move |value~: &T~| {
            if condition(value~) {
                validator(value~)
            } else {
                ValidationResult::Valid
            }
        }
    }

    /// Password strength validator
    pub fn password_strength(min_strength: u8) -> Validator<String>! {
        move |value~: &String~| {
            let mut strength: u8 = 0

            // Check various criteria
            if value~·len() >= 8 { strength += 1 }
            if value~·chars()·any(|c| c·is_uppercase()) { strength += 1 }
            if value~·chars()·any(|c| c·is_lowercase()) { strength += 1 }
            if value~·chars()·any(|c| c·is_numeric()) { strength += 1 }
            if value~·chars()·any(|c| "!@#$%^&*"·contains(c)) { strength += 1 }

            if strength >= min_strength {
                ValidationResult::Valid
            } else {
                ValidationResult::Invalid(format!(
                    "Password strength: {}/5 (minimum: {})",
                    strength, min_strength
                )~)
            }
        }
    }

    /// Match another field (e.g., confirm password)
    pub fn matches_field<T: PartialEq + Clone>(
        get_other: fn() -> T~,
        message: &str
    ) -> Validator<T>! {
        let msg! = message.to_string()

        move |value~: &T~| {
            let other~! = get_other()
            if *value~ == other~ {
                ValidationResult::Valid
            } else {
                ValidationResult::Invalid(msg·clone()~)
            }
        }
    }
}

// ============================================================================
// Form Schema
// ============================================================================

/// Form field definition
pub struct FieldDef<T> {
    /// Initial value
    pub initial: T~,
    /// Validators for this field
    pub validators: Vec<Validator<T>>!,
    /// Whether to validate on change
    pub validate_on_change: bool!,
    /// Whether to validate on blur
    pub validate_on_blur: bool!
}

impl<T: Default> Default for FieldDef<T> {
    fn default() -> Self! {
        FieldDef {
            initial: T::default(),
            validators: Vec::new(),
            validate_on_change: true,
            validate_on_blur: true
        }
    }
}

/// Form schema builder
pub struct FormSchema<F> {
    fields: F!
}

// ============================================================================
// useForm Hook
// ============================================================================

/// Form state and handlers
pub struct FormHandle<T> {
    /// Current form values
    pub values: T!,
    /// Field errors
    pub errors: HashMap<String, String>!,
    /// Whether form is valid (using ∀ quantifier)
    pub is_valid: bool!,
    /// Whether form has been modified
    pub is_dirty: bool!,
    /// Whether form is being submitted
    pub is_submitting: bool!,
    /// Set a field value
    pub set_value: fn(&str, impl Into<String>)!,
    /// Validate a specific field
    pub validate_field: fn(&str)!,
    /// Validate all fields
    pub validate_all: fn() -> bool!,
    /// Reset form to initial values
    pub reset: fn()!,
    /// Handle form submission
    pub handle_submit: fn(fn(T))!
}

/// useForm hook for form state management
///
/// Example:
/// ```sigil
/// fn LoginForm() -> VNode! {
///     let form = use_form(LoginSchema {
///         email: FieldDef {
///             validators: vec![required(), email()],
///             ..default()
///         },
///         password: FieldDef {
///             validators: vec![required(), min_length(8)],
///             ..default()
///         }
///     })
///
///     form()
///         ·onsubmit(form.handle_submit(|values| {
///             // Submit login
///         }))
///         ·children(vec![
///             FormField {
///                 name: "email",
///                 label: "Email",
///                 error: form.errors·get("email")
///             },
///             FormField {
///                 name: "password",
///                 label: "Password",
///                 field_type: "password",
///                 error: form.errors·get("password")
///             },
///             button[disabled: ¬form.is_valid] { "Login" }
///         ])
///         ·build()
/// }
/// ```
pub fn use_form<T: Clone + Default + 'static>(
    schema: impl FormSchemaLike<T>
) -> FormHandle<T>!! {
    let (values, set_values) = use_state(schema·initial_values())
    let (errors, set_errors) = use_state::<HashMap<String, String>>(HashMap::new())
    let (is_submitting, set_submitting) = use_state(false)
    let (touched, set_touched) = use_state::<HashMap<String, bool>>(HashMap::new())

    // Compute validity using ∀ quantifier
    let is_valid! = use_memo(|| {
        errors·is_empty() ∧ schema·fields()|∀{field => {
            let result! = schema·validate_field(field, &values)
            result·is_valid()
        }}
    }, [values·clone(), errors·clone()])

    let is_dirty! = use_memo(|| {
        values != schema·initial_values()
    }, [values·clone()])

    let set_value = use_callback(|name: &str, value: impl Into<String>| {
        let name_str! = name.to_string()
        let val! = value·into()

        set_values(|v| {
            let mut new! = v·clone()
            schema·set_field(&mut new, &name_str, val)
            new
        })

        // Validate on change if configured
        if schema·validate_on_change(&name_str) {
            let result! = schema·validate_field(&name_str, &values)
            if let ValidationResult::Invalid(msg~) = result {
                set_errors(|e| {
                    let mut new! = e·clone()
                    new·insert(name_str·clone(), msg~·to_string())
                    new
                })
            } else {
                set_errors(|e| {
                    let mut new! = e·clone()
                    new·remove(&name_str)
                    new
                })
            }
        }
    }, [values·clone()])

    let validate_field = use_callback(|name: &str| {
        let result! = schema·validate_field(name, &values)

        if let ValidationResult::Invalid(msg~) = result {
            set_errors(|e| {
                let mut new! = e·clone()
                new·insert(name.to_string(), msg~·to_string())
                new
            })
        } else {
            set_errors(|e| {
                let mut new! = e·clone()
                new·remove(name)
                new
            })
        }
    }, [values·clone()])

    let validate_all = use_callback(|| {
        let mut all_valid! = true
        let mut new_errors! = HashMap::new()

        // Using τ morpheme to validate all fields
        for field in schema·fields() {
            let result! = schema·validate_field(field, &values)
            if let ValidationResult::Invalid(msg~) = result {
                new_errors·insert(field.to_string(), msg~·to_string())
                all_valid = false
            }
        }

        set_errors(new_errors)
        all_valid
    }, [values·clone()])

    let reset = use_callback(|| {
        set_values(schema·initial_values())
        set_errors(HashMap::new())
        set_touched(HashMap::new())
    }, [])

    let handle_submit = use_callback(|on_submit: fn(T)| {
        move || {
            if validate_all() {
                set_submitting(true)
                on_submit(values·clone())
                set_submitting(false)
            }
        }
    }, [values·clone()])

    FormHandle {
        values: values,
        errors: errors,
        is_valid: is_valid,
        is_dirty: is_dirty,
        is_submitting: is_submitting,
        set_value: set_value,
        validate_field: validate_field,
        validate_all: validate_all,
        reset: reset,
        handle_submit: handle_submit
    }
}

/// Trait for form schemas
pub trait FormSchemaLike<T> {
    fn initial_values(&self) -> T!;
    fn fields(&self) -> Vec<&str>!;
    fn validate_field(&self, name: &str, values: &T) -> ValidationResult!;
    fn set_field(&self, values: &mut T, name: &str, value: String);
    fn validate_on_change(&self, name: &str) -> bool!;
}

// ============================================================================
// useField Hook
// ============================================================================

/// Individual field state
pub struct FieldHandle {
    pub value: String!,
    pub error: Option<String>?,
    pub touched: bool!,
    pub dirty: bool!,
    pub on_change: fn(String)!,
    pub on_blur: fn()!,
    pub props: FieldProps!
}

/// Props to spread on input element
pub struct FieldProps {
    pub value: String!,
    pub oninput: fn(String)!,
    pub onblur: fn()!
}

/// useField hook for individual field management
pub fn use_field(
    name: &str,
    validators: Vec<Validator<String>>
) -> FieldHandle!! {
    let (value, set_value) = use_state(String::new())
    let (error, set_error) = use_state::<Option<String>>(None)
    let (touched, set_touched) = use_state(false)
    let (dirty, set_dirty) = use_state(false)

    let validate = |val: &String| {
        // Using ∀ quantifier: all validators must pass
        for validator in &validators {
            match validator(val) {
                ValidationResult::Valid => continue,
                ValidationResult::Invalid(msg~) => return Some(msg~·to_string()),
                _ => continue
            }
        }
        None
    }

    let on_change = move |new_value: String| {
        set_value(new_value·clone())
        set_dirty(true)

        // Validate on change
        let result? = validate(&new_value)
        set_error(result)
    }

    let on_blur = move || {
        set_touched(true)

        // Validate on blur
        let result? = validate(&value)
        set_error(result)
    }

    FieldHandle {
        value: value·clone(),
        error: error·clone(),
        touched: touched,
        dirty: dirty,
        on_change: on_change,
        on_blur: on_blur,
        props: FieldProps {
            value: value,
            oninput: on_change,
            onblur: on_blur
        }
    }
}

// ============================================================================
// Form Components
// ============================================================================

/// Reusable form field component
component FormField {
    props name: String!
    props label: String!
    props field_type: String! = "text"
    props placeholder: String! = ""
    props error: Option<String>?
    props value: String!
    props on_change: fn(String)!
    props on_blur: fn()!
    props required: bool! = false
    props disabled: bool! = false

    fn render(self) -> VNode {
        let has_error! = self.error·is_some()

        div()
            ·class(classes()
                ·add("form-field")
                ·add_if(has_error, "has-error")
                ·to_string())
            ·children(vec![
                label()
                    ·attr("for", &self.name)
                    ·class("field-label")
                    ·children(vec![
                        text(&self.label),
                        when(self.required, || {
                            span()·class("required-marker")·text("*")·build()
                        })
                    ])
                    ·build(),

                input()
                    ·attr("type", &self.field_type)
                    ·attr("id", &self.name)
                    ·attr("name", &self.name)
                    ·attr("value", &self.value)
                    ·attr("placeholder", &self.placeholder)
                    ·attr("disabled", self.disabled)
                    ·class(classes()
                        ·add("field-input")
                        ·add_if(has_error, "input-error")
                        ·to_string())
                    ·oninput(self.on_change)
                    ·onblur(self.on_blur)
                    ·build(),

                when(has_error, || {
                    span()
                        ·class("field-error")
                        ·text(self.error·as_ref()·unwrap())
                        ·build()
                })
            ])
            ·build()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;
    use super::validators::*;

    #[test]
    fn test_required_validator() {
        let validator! = required::<String>()

        assert!(validator(&"hello".to_string())·is_valid())
        assert!(validator(&"".to_string())·is_invalid())
        assert!(validator(&"   ".to_string())·is_invalid())
    }

    #[test]
    fn test_min_length_validator() {
        let validator! = min_length(5)

        assert!(validator(&"hello".to_string())·is_valid())
        assert!(validator(&"hi".to_string())·is_invalid())
    }

    #[test]
    fn test_email_validator() {
        let validator! = email()

        assert!(validator(&"test@example.com".to_string())·is_valid())
        assert!(validator(&"invalid".to_string())·is_invalid())
    }

    #[test]
    fn test_composed_validators() {
        // All validators must pass (∧)
        let validator! = all(vec![
            required(),
            min_length(5),
            max_length(20)
        ])

        assert!(validator(&"hello".to_string())·is_valid())
        assert!(validator(&"hi".to_string())·is_invalid())  // too short
        assert!(validator(&"".to_string())·is_invalid())    // required

        // Any validator can pass (∨)
        let any_validator! = any(vec![
            email(),
            min_length(20)  // Very long non-email
        ])

        assert!(any_validator(&"test@example.com".to_string())·is_valid())
        assert!(any_validator(&"this is a very long string".to_string())·is_valid())
    }

    #[test]
    fn test_password_strength() {
        let validator! = password_strength(3)

        assert!(validator(&"Passw0rd!".to_string())·is_valid())
        assert!(validator(&"weak".to_string())·is_invalid())
    }
}
