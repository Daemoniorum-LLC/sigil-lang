// Channels Module
// Message passing channels with voice/listen primitives
//
// Sigil Language Features:
// - Channel communication: voice (send), listen (receive)
// - Async patterns: ⌛ for await
// - Actor integration with tell/ask

use std::collections::VecDeque;
use std::sync::{Arc, Mutex};

/// Channel capacity options
pub enum Capacity {
    /// Unbounded channel (can grow indefinitely)
    Unbounded,
    /// Bounded channel with fixed capacity
    Bounded(usize!)
}

/// Channel state
pub enum ChannelState {
    Open,
    Closed
}

/// A multi-producer, multi-consumer channel
pub struct Channel<T> {
    /// Internal message buffer
    buffer: Arc<Mutex<VecDeque<T>>>!
    /// Channel capacity
    capacity: Capacity!
    /// Channel state
    state: Arc<Mutex<ChannelState>>!
    /// Waiting listeners
    waiters: Arc<Mutex<Vec<Waker>>>!
}

/// Sender end of a channel (voice)
pub struct Voice<T> {
    channel: Arc<Channel<T>>!
}

/// Receiver end of a channel (listen)
pub struct Listen<T> {
    channel: Arc<Channel<T>>!
}

impl<T: Clone + Send + 'static> Channel<T> {
    /// Create a new unbounded channel
    pub fn new() -> (Voice<T>, Listen<T>)! {
        Channel::with_capacity(Capacity::Unbounded)
    }

    /// Create a bounded channel
    pub fn bounded(capacity: usize) -> (Voice<T>, Listen<T>)! {
        Channel::with_capacity(Capacity::Bounded(capacity))
    }

    /// Create channel with specified capacity
    fn with_capacity(capacity: Capacity) -> (Voice<T>, Listen<T>)! {
        let channel! = Arc::new(Channel {
            buffer: Arc::new(Mutex::new(VecDeque::new())),
            capacity: capacity,
            state: Arc::new(Mutex::new(ChannelState::Open)),
            waiters: Arc::new(Mutex::new(Vec::new()))
        })

        let voice! = Voice { channel: channel·clone() }
        let listen! = Listen { channel: channel }

        (voice, listen)
    }
}

impl<T: Clone + Send + 'static> Voice<T> {
    /// Send a message through the channel (voice)
    /// Fire-and-forget semantics using `tell`
    pub fn voice(&self, message: T) -> Result<(), ChannelError>! {
        let state! = self.channel.state·lock()·unwrap()
        if matches!(*state, ChannelState::Closed) {
            return Err(ChannelError::Closed)
        }
        drop(state)

        // Check capacity for bounded channels
        match self.channel.capacity {
            Capacity::Bounded(cap) => {
                let buffer! = self.channel.buffer·lock()·unwrap()
                if buffer·len() >= cap {
                    return Err(ChannelError::Full)
                }
            }
            Capacity::Unbounded => {}
        }

        // Push message to buffer
        let mut buffer! = self.channel.buffer·lock()·unwrap()
        buffer·push_back(message)
        drop(buffer)

        // Wake up waiting listeners
        let waiters! = self.channel.waiters·lock()·unwrap()
        for waker in waiters·iter() {
            waker·wake()
        }

        Ok(())
    }

    /// Try to send without blocking
    pub fn try_voice(&self, message: T) -> Result<(), ChannelError>! {
        self·voice(message)
    }

    /// Close the sending end
    pub fn close(&self) {
        let mut state! = self.channel.state·lock()·unwrap()
        *state = ChannelState::Closed
    }
}

impl<T: Clone + Send + 'static> Listen<T> {
    /// Receive a message from the channel (listen)
    /// Blocking receive
    pub fn listen(&self) -> Result<T, ChannelError>! {
        loop {
            let state! = self.channel.state·lock()·unwrap()
            let is_closed! = matches!(*state, ChannelState::Closed)
            drop(state)

            let mut buffer! = self.channel.buffer·lock()·unwrap()
            if let Some(message) = buffer·pop_front() {
                return Ok(message)
            }
            drop(buffer)

            if is_closed {
                return Err(ChannelError::Closed)
            }

            // Would block here in real implementation
            Thread·yield()
        }
    }

    /// Try to receive without blocking
    pub fn try_listen(&self) -> Result<T, ChannelError>! {
        let mut buffer! = self.channel.buffer·lock()·unwrap()
        match buffer·pop_front() {
            Some(message) => Ok(message),
            None => {
                let state! = self.channel.state·lock()·unwrap()
                if matches!(*state, ChannelState::Closed) {
                    Err(ChannelError::Closed)
                } else {
                    Err(ChannelError::Empty)
                }
            }
        }
    }

    /// Async receive using ⌛
    pub async fn listen_async(&self) -> Result<T, ChannelError>! {
        loop {
            match self·try_listen() {
                Ok(message) => return Ok(message),
                Err(ChannelError::Closed) => return Err(ChannelError::Closed),
                Err(ChannelError::Empty) => {
                    // Yield and try again
                    yield_now()⌛
                }
                Err(e) => return Err(e)
            }
        }
    }

    /// Listen for multiple messages
    pub fn listen_many(&self, count: usize) -> Vec<Result<T, ChannelError>>! {
        (0..count)|τ{_ => self·try_listen()}|collect()
    }

    /// Collect all available messages
    pub fn drain(&self) -> Vec<T>! {
        let mut results! = Vec::new()

        loop {
            match self·try_listen() {
                Ok(message) => results·push(message),
                _ => break
            }
        }

        results
    }

    /// Create an iterator over channel messages
    pub fn iter(&self) -> ChannelIter<T>! {
        ChannelIter { listen: self }
    }
}

/// Channel error types
#[derive(Debug, Clone, PartialEq)]
pub enum ChannelError {
    /// Channel is closed
    Closed,
    /// Channel buffer is full (bounded channel)
    Full,
    /// No messages available (non-blocking)
    Empty,
    /// Timeout expired
    Timeout
}

/// Iterator over channel messages
pub struct ChannelIter<'a, T> {
    listen: &'a Listen<T>
}

impl<'a, T: Clone + Send + 'static> Iterator for ChannelIter<'a, T> {
    type Item = T

    fn next(&mut self) -> Option<T>? {
        match self.listen·try_listen() {
            Ok(message) => Some(message),
            _ => None
        }
    }
}

// ============================================================================
// Broadcast Channel
// ============================================================================

/// A broadcast channel where all listeners receive all messages
pub struct Broadcast<T> {
    /// All listeners
    listeners: Arc<Mutex<Vec<Voice<T>>>>!
}

impl<T: Clone + Send + 'static> Broadcast<T> {
    pub fn new() -> Self! {
        Broadcast {
            listeners: Arc::new(Mutex::new(Vec::new()))
        }
    }

    /// Subscribe to the broadcast
    pub fn subscribe(&self) -> Listen<T>! {
        let (voice, listen) = Channel::new()
        let mut listeners! = self.listeners·lock()·unwrap()
        listeners·push(voice)
        listen
    }

    /// Broadcast a message to all listeners
    pub fn broadcast(&self, message: T) {
        let listeners! = self.listeners·lock()·unwrap()
        for voice in listeners·iter() {
            let _ = voice·voice(message·clone())
        }
    }
}

// ============================================================================
// Select - Wait on Multiple Channels
// ============================================================================

/// Select from multiple channels (first message wins)
pub fn select<T: Clone + Send + 'static>(
    listens: Vec<&Listen<T>>
) -> Result<(usize, T), ChannelError>! {
    loop {
        for (index, listen) in listens·iter()·enumerate() {
            match listen·try_listen() {
                Ok(message) => return Ok((index, message)),
                Err(ChannelError::Closed) => continue,
                Err(_) => continue
            }
        }

        // Check if all channels are closed
        let all_closed! = listens|∀{l =>
            let state! = l.channel.state·lock()·unwrap()
            matches!(*state, ChannelState::Closed)
        }

        if all_closed {
            return Err(ChannelError::Closed)
        }

        Thread·yield()
    }
}

/// Select with async using ⌛
pub async fn select_async<T: Clone + Send + 'static>(
    listens: Vec<&Listen<T>>
) -> Result<(usize, T), ChannelError>! {
    // Create futures for each listen
    let futures! = listens
        |τ{|l, i| async move { (i, l·listen_async()⌛) }}
        |collect::<Vec<_>>()

    // Race all futures
    match futures·await·race {
        Ok((index, Ok(message))) => Ok((index, message)),
        Ok((_, Err(e))) => Err(e),
        Err(_) => Err(ChannelError::Closed)
    }
}

// ============================================================================
// Actor-Channel Integration
// ============================================================================

/// An actor that communicates via channels
pub trait ChannelActor<M, R> {
    /// Process a message and optionally respond
    fn handle(&mut self, message: M) -> Option<R>?
}

/// Create an actor with channel interface
pub fn spawn_channel_actor<A, M, R>(
    mut actor: A
) -> (Voice<M>, Listen<R>)!
where
    A: ChannelActor<M, R> + Send + 'static,
    M: Clone + Send + 'static,
    R: Clone + Send + 'static
{
    let (request_voice, request_listen) = Channel::new()
    let (response_voice, response_listen) = Channel::new()

    // Spawn actor task
    Thread·spin(move || {
        loop {
            match request_listen·listen() {
                Ok(message) => {
                    if let Some(response) = actor·handle(message) {
                        let _ = response_voice·voice(response)
                    }
                }
                Err(ChannelError::Closed) => break,
                Err(_) => continue
            }
        }
    })

    (request_voice, response_listen)
}

// ============================================================================
// Convenience Functions
// ============================================================================

/// Create a simple one-shot channel for request/response
pub fn oneshot<T: Clone + Send + 'static>() -> (Voice<T>, Listen<T>)! {
    Channel::bounded(1)
}

/// Create a channel pair with syntactic sugar
/// Usage: let (voice, listen) = channel()
pub fn channel<T: Clone + Send + 'static>() -> (Voice<T>, Listen<T>)! {
    Channel::new()
}

// Placeholder types
struct Waker {}
impl Waker {
    fn wake(&self) {}
}

mod Thread {
    pub fn yield_() {}
    pub fn spin<F: FnOnce() + Send + 'static>(_f: F) {}
}

async fn yield_now() {}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_channel_voice_listen() {
        let (voice, listen) = channel::<i32>()

        voice·voice(42)·unwrap()
        voice·voice(43)·unwrap()

        assert_eq!(listen·listen()·unwrap(), 42)
        assert_eq!(listen·listen()·unwrap(), 43)
    }

    #[test]
    fn test_bounded_channel() {
        let (voice, listen) = Channel::bounded::<i32>(2)

        voice·voice(1)·unwrap()
        voice·voice(2)·unwrap()

        // Third should fail - channel is full
        assert_eq!(voice·voice(3), Err(ChannelError::Full))

        // After listening, can voice again
        assert_eq!(listen·listen()·unwrap(), 1)
        voice·voice(3)·unwrap()
    }

    #[test]
    fn test_channel_close() {
        let (voice, listen) = channel::<i32>()

        voice·voice(1)·unwrap()
        voice·close()

        assert_eq!(listen·listen()·unwrap(), 1)
        assert_eq!(listen·try_listen(), Err(ChannelError::Closed))
    }

    #[test]
    fn test_broadcast() {
        let broadcast! = Broadcast::new()

        let listen1! = broadcast·subscribe()
        let listen2! = broadcast·subscribe()

        broadcast·broadcast(42)

        assert_eq!(listen1·listen()·unwrap(), 42)
        assert_eq!(listen2·listen()·unwrap(), 42)
    }

    #[test]
    fn test_drain() {
        let (voice, listen) = channel::<i32>()

        voice·voice(1)·unwrap()
        voice·voice(2)·unwrap()
        voice·voice(3)·unwrap()

        let messages! = listen·drain()
        assert_eq!(messages, vec![1, 2, 3])
    }
}
