// demo_minimal.sigil - Minimal WASM demo testing core functionality

// =========================================================================
// Part 1: Arithmetic Demo
// =========================================================================

pub fn demo_arithmetic() {
    let a = 100;
    let b = 7;

    // Basic operations
    print(a + b);  // 107
    print(a - b);  // 93
    print(a * b);  // 700
    print(a / b);  // 14
    print(a % b);  // 2

    // Comparison results (1 = true, 0 = false)
    let is_greater = a > b;
    let is_equal = a == b;
    print(is_greater);  // 1
    print(is_equal);    // 0
}

// =========================================================================
// Part 2: Control Flow Demo
// =========================================================================

pub fn demo_control_flow() {
    // Basic if-else
    let x = 10;
    let result = if x > 5 { x * 2 } else { x };
    print(result);  // 20

    // While loop
    let mut counter = 0;
    while counter < 5 {
        counter = counter + 1;
    }
    print(counter);  // 5
}

// =========================================================================
// Part 3: Signal Reactivity Demo
// =========================================================================

pub fn demo_signals() {
    // Create signals with initial values
    let count = signal::create(0);
    let multiplier = signal::create(10);

    // Print initial signal IDs
    print(count);
    print(multiplier);

    // Modify signals
    signal::set(count, 5);
    signal::set(multiplier, 20);

    // Get updated values
    let count_val = signal::get(count);
    let mult_val = signal::get(multiplier);

    // Compute and print
    let result = count_val * mult_val;
    print(result);  // 100
}

// =========================================================================
// Main entry
// =========================================================================

pub fn main() {
    demo_arithmetic();
    demo_control_flow();
    demo_signals();
}
