// Advanced WASM test - closures, structs, morpheme operators

struct Point {
    x: i64,
    y: i64
}

pub fn add_points(a: i64, b: i64) -> i64 {
    a + b
}

pub fn double(n: i64) -> i64 {
    n * 2
}

pub fn is_positive(n: i64) -> i64 {
    if n > 0 { 1 } else { 0 }
}

pub fn sum_array(arr: i64) -> i64 {
    // Use first/last morphemes
    let first = arr|α;
    let last = arr|Ω;
    first + last
}

pub fn main() {
    // Test basic operations
    let result = add_points(10, 20);
    print(result);

    // Test array with morphemes
    let numbers = [1, 2, 3, 4, 5];

    // Get first and last
    let first = numbers|α;
    let last = numbers|Ω;
    print(first);
    print(last);

    // Test pipeline with τ (map) - doubles each element
    let doubled = numbers|τ{it * 2};
    let doubled_first = doubled|α;
    print(doubled_first);

    // Test pipeline with φ (filter) - keep positive
    let positive = [-1, 2, -3, 4, 5]|φ{it > 0};
    let pos_first = positive|α;
    print(pos_first);

    // Test sort
    let unsorted = [5, 2, 8, 1, 9];
    let sorted = unsorted|σ;
    let min = sorted|α;
    let max = sorted|Ω;
    print(min);
    print(max);
}
