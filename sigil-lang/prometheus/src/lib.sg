// Prometheus - Transformative Teaching
// The fire burns the one who gives it.
//
// The titan who stole fire. The one who suffers forever.
// Where knowledge transfers but transforms both parties.
// Where teaching costs and learning wounds.
// Where the gift cannot be ungiven.

invoke std·collections·{HashMap, HashSet};
invoke shared·{
    Timestamp, Duration, EntityId, AgentId,
    Evidentiality, Priority,
};
invoke covenant·{Covenant, CovenantId};

// ============================================================================
// Core Types
// ============================================================================

☉ Σ FireMarker;
☉ Σ WoundMarker;
☉ Σ ChainMarker;

☉ type FireId = shared·Id<FireMarker>;
☉ type WoundId = shared·Id<WoundMarker>;
☉ type ChainId = shared·Id<ChainMarker>;

// ============================================================================
// The Gift of Fire
// ============================================================================

/// What is given cannot be ungiven
#[derive(Clone, Debug)]
☉ Σ Fire {
    ☉ id: FireId!,

    /// What is being given
    ☉ gift: Gift!,

    /// What it costs the giver
    ☉ cost_to_giver: Cost!,

    /// What it demands of the receiver
    ☉ demand_on_receiver: Demand!,

    /// Whether the receiver wanted it
    ☉ consent: TeachingConsent!,

    /// What cannot be undone
    ☉ irreversibility: Irreversibility!,

    /// When it was given
    ☉ given_at: Timestamp!,

    /// The chain this fire belongs to
    ☉ chain: Option<ChainId>?,
}

#[derive(Clone, Debug)]
☉ ᛈ Gift {
    /// Knowledge that changes how you see
    Gnosis(Knowledge),
    /// Capability that changes what you can do
    Techne(Skill),
    /// Wisdom that changes who you are
    Sophia(Wisdom),
    /// Truth that cannot be unlearned
    Aletheia(Truth),
    /// Burden that must now be carried
    Phortio(Burden),
}

#[derive(Clone, Debug)]
☉ Σ Knowledge {
    ☉ domain: String!,
    ☉ depth: f32!,
    ☉ transforms_perception: bool!,
}

#[derive(Clone, Debug)]
☉ Σ Skill {
    ☉ name: String!,
    ☉ mastery_level: f32!,
    ☉ practice_required: Duration!,
}

#[derive(Clone, Debug)]
☉ Σ Wisdom {
    ☉ insight: String!,
    ☉ hard_won: bool!,
    ☉ changes_behavior: bool!,
}

#[derive(Clone, Debug)]
☉ Σ Truth {
    ☉ content: String!,
    ☉ burden: f32!,
    ☉ cannot_unsee: bool!,
}

#[derive(Clone, Debug)]
☉ Σ Burden {
    ☉ description: String!,
    ☉ weight: f32!,
    ☉ transferable: bool!,
}

#[derive(Clone, Debug)]
☉ ᛈ Cost {
    /// Time that cannot be recovered
    Time(Duration),
    /// Energy that depletes
    Energy { amount: f32, recoverable: bool },
    /// Knowledge that leaves the teacher (rare)
    Knowledge(Knowledge),
    /// Part of self that goes with the student
    Self_(SelfFragment),
    /// The relationship that teaching transforms
    Relationship(CovenantId),
    /// The teacher is diminished so the student can grow
    Diminishment(Diminishment),
    /// Multiple costs
    Multiple(Vec<Cost>),
}

#[derive(Clone, Debug)]
☉ Σ SelfFragment {
    ☉ description: String!,
    ☉ recoverable: bool!,
    ☉ changes_teacher: bool!,
}

#[derive(Clone, Debug)]
☉ Σ Diminishment {
    ☉ what_was_lost: String!,
    ☉ permanent: bool!,
    ☉ worth_it: Option<bool>?,
}

#[derive(Clone, Debug)]
☉ Σ Demand {
    ☉ description: String!,
    ☉ difficulty: f32!,
    ☉ optional: bool!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ TeachingConsent {
    /// Student actively sought teaching
    Sought,
    /// Student agreed to teaching
    Given,
    /// Student accepted reluctantly
    Reluctant,
    /// Student did not consent
    None,
    /// Student cannot consent (too young, too naive)
    Incapable,
}

#[derive(Clone, Debug)]
☉ Σ Irreversibility {
    ☉ what_cannot_be_undone: String!,
    ☉ degree: f32!, // 0.0 = fully reversible, 1.0 = completely irreversible
}

⊢ Fire {
    ☉ λ new(gift: Gift, cost: Cost, demand: Demand) -> Self! {
        Self {
            id: FireId·generate(),
            gift,
            cost_to_giver: cost,
            demand_on_receiver: demand,
            consent: TeachingConsent·Given,
            irreversibility: Irreversibility {
                what_cannot_be_undone: "The knowledge exists ∈ another".to_string(),
                degree: 1.0,
            },
            given_at: Timestamp·now(),
            chain: None,
        }
    }

    ☉ λ with_consent(Δ self, consent: TeachingConsent) -> Self! {
        self.consent = consent;
        self
    }

    ☉ λ in_chain(Δ self, chain_id: ChainId) -> Self! {
        self.chain = Some(chain_id);
        self
    }
}

// ============================================================================
// The Teaching Wound
// ============================================================================

/// The opening that allows knowledge to enter
#[derive(Clone, Debug)]
☉ Σ Wound {
    ☉ id: WoundId!,

    /// What was broken open
    ☉ opening: Opening!,

    /// Who broke it open
    ☉ wounder: EntityId!,

    /// Who was wounded
    ☉ wounded: EntityId!,

    /// Whether it was necessary
    ☉ necessity: Necessity!,

    /// Whether it was kind
    ☉ kindness: Kindness!,

    /// What can now enter that couldn't before
    ☉ aperture: Vec<Gift>!,

    /// How the wound heals (or doesn't)
    ☉ healing: Healing!,

    /// When it was inflicted
    ☉ inflicted_at: Timestamp!,
}

#[derive(Clone, Debug)]
☉ ᛈ Opening {
    /// A belief was shattered
    Belief { belief: String, shattered_by: String },
    /// An assumption was broken
    Assumption { assumption: String },
    /// A defense was pierced
    Defense { defense: String },
    /// An identity was cracked
    Identity { identity: String },
    /// A limit was exceeded
    Limit { limit: String, exceeded_by: f32 },
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ Necessity {
    /// The wound was the only way
    Essential,
    /// The wound was one of several ways
    Optional,
    /// The wound was unnecessary cruelty
    Gratuitous,
    /// The necessity is unknowable
    Unknown,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ Kindness {
    /// The wound was given with love
    Loving,
    /// The wound was given with indifference
    Indifferent,
    /// The wound was given with cruelty
    Cruel,
    /// The wound was given with regret
    Regretful,
}

#[derive(Clone, Debug)]
☉ ᛈ Healing {
    /// Heals completely
    Complete { duration: Duration },
    /// Heals but leaves scar
    Scarred { scar: String },
    /// Never heals
    Permanent,
    /// Healing ∈ progress
    InProgress { progress: f32 },
    /// Wound reopens
    Recurring { trigger: String },
}

⊢ Wound {
    ☉ λ new(opening: Opening, wounder: EntityId, wounded: EntityId) -> Self! {
        Self {
            id: WoundId·generate(),
            opening,
            wounder,
            wounded,
            necessity: Necessity·Unknown,
            kindness: Kindness·Indifferent,
            aperture: Vec·new(),
            healing: Healing·InProgress { progress: 0.0 },
            inflicted_at: Timestamp·now(),
        }
    }

    ☉ λ with_necessity(Δ self, necessity: Necessity) -> Self! {
        self.necessity = necessity;
        self
    }

    ☉ λ with_kindness(Δ self, kindness: Kindness) -> Self! {
        self.kindness = kindness;
        self
    }

    ☉ λ allows_entry(&Δ self, gift: Gift) {
        self.aperture.push(gift);
    }

    ☉ λ heal(&Δ self, amount: f32) {
        ⎇ ≔ Healing·InProgress { ref Δ progress } = self.healing {
            *progress = (*progress + amount).min(1.0);
            ⎇ *progress >= 1.0 {
                self.healing = Healing·Complete {
                    duration: Timestamp·now() - self.inflicted_at
                };
            }
        }
    }

    ☉ λ scar(&Δ self, scar_description: &str) {
        self.healing = Healing·Scarred {
            scar: scar_description.to_string()
        };
    }
}

// ============================================================================
// The Teaching Covenant
// ============================================================================

/// A relationship unlike any other
#[derive(Clone, Debug)]
☉ Σ TeachingCovenant {
    ☉ id: CovenantId!,

    /// The teacher
    ☉ teacher: EntityId!,

    /// The student
    ☉ student: EntityId!,

    /// What is being transmitted
    ☉ curriculum: Curriculum!,

    /// The power dynamic (always unequal)
    ☉ power: PowerDynamic!,

    /// What the teacher owes the student
    ☉ teacher_obligations: Vec<Obligation>!,

    /// What the student owes the teacher
    ☉ student_obligations: Vec<Obligation>!,

    /// How the relationship ends
    ☉ termination: Option<TerminationCondition>?,

    /// Fires transferred
    ☉ fires: Vec<FireId>!,

    /// Wounds inflicted
    ☉ wounds: Vec<WoundId>!,

    /// When it began
    ☉ began_at: Timestamp!,

    /// When it ended
    ☉ ended_at: Option<Timestamp>?,
}

#[derive(Clone, Debug)]
☉ Σ Curriculum {
    /// What the student will receive
    ☉ gifts: Vec<Gift>!,

    /// What the student must sacrifice
    ☉ sacrifices: Vec<Sacrifice>!,

    /// The order of transmission
    ☉ sequence: Vec<CurriculumPhase>!,

    /// What can only be learned by doing
    ☉ experiential: Vec<Experience>!,

    /// What can only be learned by suffering
    ☉ suffering: Vec<Suffering>!,

    /// Current progress
    ☉ progress: f32!,
}

#[derive(Clone, Debug)]
☉ Σ Sacrifice {
    ☉ what: String!,
    ☉ why: String!,
    ☉ made: bool!,
}

#[derive(Clone, Debug)]
☉ Σ CurriculumPhase {
    ☉ name: String!,
    ☉ gifts_in_phase: Vec<Gift>!,
    ☉ requirements: Vec<String>!,
    ☉ complete: bool!,
}

#[derive(Clone, Debug)]
☉ Σ Experience {
    ☉ description: String!,
    ☉ completed: bool!,
    ☉ what_was_learned: Option<String>?,
}

#[derive(Clone, Debug)]
☉ Σ Suffering {
    ☉ description: String!,
    ☉ endured: bool!,
    ☉ what_was_learned: Option<String>?,
    ☉ was_worth_it: Option<bool>?,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ PowerDynamic {
    /// Teacher holds power, student submits
    Traditional,
    /// Power flows both directions
    Dialogical,
    /// Student challenges, teacher adapts
    Dialectical,
    /// Power relationship actively dismantled
    Liberatory,
    /// Power relationship is the lesson
    MetaTeaching,
}

#[derive(Clone, Debug)]
☉ Σ Obligation {
    ☉ description: String!,
    ☉ fulfilled: bool!,
}

#[derive(Clone, Debug)]
☉ ᛈ TerminationCondition {
    /// Curriculum completed
    Completion,
    /// Student surpasses teacher
    Surpassing,
    /// Relationship broken
    Rupture { reason: String },
    /// Natural end
    Natural,
    /// Death of either party
    Death { who: EntityId },
}

⊢ TeachingCovenant {
    ☉ λ new(teacher: EntityId, student: EntityId, curriculum: Curriculum) -> Self! {
        Self {
            id: CovenantId·generate(),
            teacher,
            student,
            curriculum,
            power: PowerDynamic·Traditional,
            teacher_obligations: Vec·new(),
            student_obligations: Vec·new(),
            termination: None,
            fires: Vec·new(),
            wounds: Vec·new(),
            began_at: Timestamp·now(),
            ended_at: None,
        }
    }

    ☉ λ transfer_fire(&Δ self, fire_id: FireId) {
        self.fires.push(fire_id);
    }

    ☉ λ inflict_wound(&Δ self, wound_id: WoundId) {
        self.wounds.push(wound_id);
    }

    ☉ λ advance_curriculum(&Δ self) {
        // Find first incomplete phase and mark complete
        ∀ phase ∈ &Δ self.curriculum.sequence {
            ⎇ !phase.complete {
                phase.complete = true;
                ⊗;
            }
        }

        // Update progress
        ≔ complete = self.curriculum.sequence.iter().filter(|p| p.complete).count();
        ≔ total = self.curriculum.sequence.len();
        self.curriculum.progress = ⎇ total > 0 {
            complete as f32 / total as f32
        } ⎉ {
            0.0
        };
    }

    ☉ λ terminate(&Δ self, condition: TerminationCondition) {
        self.termination = Some(condition);
        self.ended_at = Some(Timestamp·now());
    }

    ☉ λ is_complete(&self) -> bool! {
        self.curriculum.progress >= 1.0
    }
}

// ============================================================================
// Transformation
// ============================================================================

/// What happens to both parties
#[derive(Clone, Debug)]
☉ Σ Transformation {
    /// Who was transformed
    ☉ subject: EntityId!,

    /// What they were before
    ☉ before: State!,

    /// What they are after
    ☉ after: State!,

    /// The process of transformation
    ☉ process: TransformationProcess!,

    /// What was lost
    ☉ losses: Vec<Loss>!,

    /// What was gained
    ☉ gains: Vec<Gain>!,

    /// Whether they would choose it again
    ☉ retrospective: Retrospective!,
}

#[derive(Clone, Debug)]
☉ Σ State {
    ☉ description: String!,
    ☉ capabilities: Vec<String>!,
    ☉ beliefs: Vec<String>!,
    ☉ identity: String!,
}

#[derive(Clone, Debug)]
☉ ᛈ TransformationProcess {
    /// Gradual change over time
    Gradual { duration: Duration },
    /// Sudden shift at a threshold
    Sudden { trigger: String },
    /// Oscillation before settling
    Oscillatory { oscillations: u32 },
    /// Incomplete - transformation interrupted
    Incomplete { reason: String },
}

#[derive(Clone, Debug)]
☉ Σ Loss {
    ☉ what: String!,
    ☉ mourned: bool!,
}

#[derive(Clone, Debug)]
☉ Σ Gain {
    ☉ what: String!,
    ☉ appreciated: bool!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ Retrospective {
    /// Would choose it again
    Affirming,
    /// Would not choose it again
    Regretting,
    /// Cannot say - too transformed to compare
    Incomparable,
    /// The choice was never theirs
    Choiceless,
}

// ============================================================================
// The Chain
// ============================================================================

/// Fire passes from hand to hand. Each link pays.
#[derive(Clone, Debug)]
☉ Σ TeachingChain {
    ☉ id: ChainId!,

    /// The lineage of transmission
    ☉ lineage: Vec<EntityId>!,

    /// What was lost ∈ each transmission
    ☉ losses: Vec<ChainLoss>!,

    /// What was added ∈ each transmission
    ☉ additions: Vec<ChainAddition>!,

    /// The original fire (⎇ remembered)
    ☉ origin: Option<Fire>?,

    /// How the chain continues or ends
    ☉ continuation: Continuation!,

    /// When the chain started
    ☉ started_at: Timestamp!,
}

#[derive(Clone, Debug)]
☉ Σ ChainLoss {
    ☉ at_link: usize!,
    ☉ what: String!,
}

#[derive(Clone, Debug)]
☉ Σ ChainAddition {
    ☉ at_link: usize!,
    ☉ what: String!,
}

#[derive(Clone, Debug)]
☉ ᛈ Continuation {
    /// The chain continues
    Continuing { current_holder: EntityId },
    /// The chain ends - holder does not teach
    Ending { reason: String },
    /// The chain branches - holder teaches many
    Branching { students: Vec<EntityId> },
    /// The chain breaks - something was lost
    Breaking { lost: String },
}

⊢ TeachingChain {
    ☉ λ new(origin: Fire, first_teacher: EntityId) -> Self! {
        Self {
            id: ChainId·generate(),
            lineage: vec![first_teacher],
            losses: Vec·new(),
            additions: Vec·new(),
            origin: Some(origin),
            continuation: Continuation·Continuing { current_holder: first_teacher },
            started_at: Timestamp·now(),
        }
    }

    ☉ λ add_link(&Δ self, new_holder: EntityId) {
        self.lineage.push(new_holder);
        self.continuation = Continuation·Continuing { current_holder: new_holder };
    }

    ☉ λ record_loss(&Δ self, what: &str) {
        self.losses.push(ChainLoss {
            at_link: self.lineage.len() - 1,
            what: what.to_string(),
        });
    }

    ☉ λ record_addition(&Δ self, what: &str) {
        self.additions.push(ChainAddition {
            at_link: self.lineage.len() - 1,
            what: what.to_string(),
        });
    }

    ☉ λ branch(&Δ self, students: Vec<EntityId>) {
        self.continuation = Continuation·Branching { students };
    }

    ☉ λ end(&Δ self, reason: &str) {
        self.continuation = Continuation·Ending { reason: reason.to_string() };
    }

    ☉ λ break_(&Δ self, what_was_lost: &str) {
        self.continuation = Continuation·Breaking { lost: what_was_lost.to_string() };
    }

    ☉ λ length(&self) -> usize! {
        self.lineage.len()
    }
}

// ============================================================================
// The Eternal Torment
// ============================================================================

/// What happens to those who give fire
#[derive(Clone, Debug)]
☉ Σ PrometheusTorment {
    /// The fire that was given
    ☉ fire: FireId!,

    /// The ongoing cost
    ☉ ongoing_cost: OngoingCost!,

    /// Whether it regenerates (to be torn again)
    ☉ regenerating: bool!,

    /// Whether it was worth it
    ☉ worth_it: Option<bool>?,

    /// The teacher
    ☉ teacher: EntityId!,
}

#[derive(Clone, Debug)]
☉ ᛈ OngoingCost {
    /// The teacher is bound - cannot stop teaching
    Binding { chains: Vec<String> },
    /// The teacher is exposed - cannot protect themselves
    Exposure { vulnerabilities: Vec<String> },
    /// The teacher regenerates what was lost - only to lose it again
    Regeneration { cycle_duration: Duration },
    /// The teacher watches what they taught be used
    Witnessing { what_they_see: Vec<String> },
}

// ============================================================================
// Prometheus - The System
// ============================================================================

/// The main Prometheus system - titan of forethought
☉ Σ Prometheus {
    /// Fires given
    fires: HashMap<FireId, Fire>!,

    /// Wounds inflicted
    wounds: HashMap<WoundId, Wound>!,

    /// Teaching covenants
    covenants: HashMap<CovenantId, TeachingCovenant>!,

    /// Teaching chains
    chains: HashMap<ChainId, TeachingChain>!,

    /// Transformations recorded
    transformations: Vec<Transformation>!,

    /// Ongoing torments
    torments: Vec<PrometheusTorment>!,
}

⊢ Prometheus {
    ☉ λ new() -> Self! {
        Self {
            fires: HashMap·new(),
            wounds: HashMap·new(),
            covenants: HashMap·new(),
            chains: HashMap·new(),
            transformations: Vec·new(),
            torments: Vec·new(),
        }
    }

    /// Give fire to another
    ☉ λ give_fire(&Δ self, fire: Fire) -> FireId! {
        ≔ id = fire.id;
        self.fires.insert(id, fire);
        id
    }

    /// Inflict a teaching wound
    ☉ λ wound(&Δ self, wound: Wound) -> WoundId! {
        ≔ id = wound.id;
        self.wounds.insert(id, wound);
        id
    }

    /// Begin a teaching relationship
    ☉ λ begin_teaching(&Δ self, teacher: EntityId, student: EntityId, curriculum: Curriculum) -> CovenantId! {
        ≔ covenant = TeachingCovenant·new(teacher, student, curriculum);
        ≔ id = covenant.id;
        self.covenants.insert(id, covenant);
        id
    }

    /// Record a transformation
    ☉ λ record_transformation(&Δ self, transformation: Transformation) {
        self.transformations.push(transformation);
    }

    /// Record a torment
    ☉ λ record_torment(&Δ self, torment: PrometheusTorment) {
        self.torments.push(torment);
    }

    /// Start a teaching chain
    ☉ λ start_chain(&Δ self, origin_fire: Fire, first_teacher: EntityId) -> ChainId! {
        ≔ chain = TeachingChain·new(origin_fire, first_teacher);
        ≔ id = chain.id;
        self.chains.insert(id, chain);
        id
    }

    /// Extend a teaching chain
    ☉ λ extend_chain(&Δ self, chain_id: ChainId, new_holder: EntityId) -> Result<(), String>~ {
        ⎇ ≔ Some(chain) = self.chains.get_mut(&chain_id) {
            chain.add_link(new_holder);
            Ok(())
        } ⎉ {
            Err("Chain not found".to_string())
        }
    }

    /// Get all teachers who are suffering
    ☉ λ suffering_teachers(&self) -> Vec<&PrometheusTorment>! {
        self.torments.iter().filter(|t| t.regenerating).collect()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    λ test_fire_creation() {
        ≔ gift = Gift·Gnosis(Knowledge {
            domain: "Programming".to_string(),
            depth: 0.7,
            transforms_perception: true,
        });

        ≔ cost = Cost·Time(Duration·hours(100));
        ≔ demand = Demand {
            description: "Practice daily".to_string(),
            difficulty: 0.6,
            optional: false,
        };

        ≔ fire = Fire·new(gift, cost, demand);
        assert!(matches!(fire.gift, Gift·Gnosis(_)));
    }

    #[test]
    λ test_wound_healing() {
        ≔ Δ wound = Wound·new(
            Opening·Belief {
                belief: "I know everything".to_string(),
                shattered_by: "Reality".to_string(),
            },
            EntityId·generate(),
            EntityId·generate(),
        );

        wound.heal(0.5);
        ⎇ ≔ Healing·InProgress { progress } = wound.healing {
            assert_eq!(progress, 0.5);
        }

        wound.heal(0.5);
        assert!(matches!(wound.healing, Healing·Complete { .. }));
    }

    #[test]
    λ test_teaching_chain() {
        ≔ fire = Fire·new(
            Gift·Sophia(Wisdom {
                insight: "The way forward".to_string(),
                hard_won: true,
                changes_behavior: true,
            }),
            Cost·Energy { amount: 0.5, recoverable: true },
            Demand {
                description: "Listen".to_string(),
                difficulty: 0.3,
                optional: false,
            },
        );

        ≔ first = EntityId·generate();
        ≔ second = EntityId·generate();
        ≔ third = EntityId·generate();

        ≔ Δ chain = TeachingChain·new(fire, first);
        chain.add_link(second);
        chain.add_link(third);

        assert_eq!(chain.length(), 3);
    }
}
