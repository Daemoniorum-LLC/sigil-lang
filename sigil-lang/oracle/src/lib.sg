// Oracle - Explainability Infrastructure
// Understanding is the foundation of trust

invoke std·collections·HashMap;
invoke std·hash·{Hash, Hasher};
invoke shared·{
    Timestamp, Value, Confidence, EntityId,
};

// ============================================================================
// Core Types
// ============================================================================

/// Marker types ∀ oracle-specific IDs
☉ Σ ExplainableMarker;
☉ Σ StepMarker;

/// Explainable identifier
☉ type ExplainableId = shared·Id<ExplainableMarker>;
/// Step identifier
☉ type StepId = shared·Id<StepMarker>;

⊢ StepId {
    ☉ λ to_short(&self) -> String {
        ≔ bytes = self.bytes();
        format!("{:02x}{:02x}", bytes[0], bytes[1])
    }
}

// ============================================================================
// Explainable Trait
// ============================================================================

☉ Θ Explainable {
    λ id(&self) -> ExplainableId;
    λ description(&self) -> String;
    λ factors(&self) -> Vec<Factor>;
}

☉ Σ Factor {
    ☉ name: String,
    ☉ value: f32,
    ☉ description: String,
}

⊢ Clone ∀ Factor {
    λ clone(&self) -> Self {
        Self { name: self.name.clone(), value: self.value, description: self.description.clone() }
    }
}

// ============================================================================
// Explanation Level
// ============================================================================

#[derive(Copy, Clone)]
☉ ᛈ ExplanationLevel {
    Brief,
    Standard,
    Full,
    Technical,
}

// ============================================================================
// Explanation Structure
// ============================================================================

☉ Σ Explanation {
    ☉ decision: String,
    ☉ summary: String,
    ☉ reasoning: ReasoningChain,
    ☉ evidence: Vec<Evidence>,
    ☉ confidence: ConfidenceAssessment,
    ☉ alternatives: Vec<Alternative>,
    ☉ uncertainties: Vec<Uncertainty>,
    ☉ level: ExplanationLevel,
}

⊢ Explanation {
    ☉ λ summary(&self) -> &str { &self.summary }

    ☉ λ reasoning(&self) -> String {
        self.reasoning.to_prose()
    }

    ☉ λ evidence(&self) -> &[Evidence] { &self.evidence }

    ☉ λ alternatives_considered(&self) -> &[Alternative] { &self.alternatives }

    ☉ λ confidence(&self) -> Confidence { self.confidence.overall }

    ☉ λ to_human_readable(&self) -> String {
        ≔ Δ output = String·new();

        output.push_str(&format!("{}\n\n", self.summary));

        ⎇ self.level as u8 >= ExplanationLevel·Standard as u8 {
            output.push_str("Reasoning:\n");
            output.push_str(&self.reasoning.to_prose());
            output.push_str("\n\n");
        }

        ⎇ self.level as u8 >= ExplanationLevel·Standard as u8 && !self.evidence.is_empty() {
            output.push_str("Based on:\n");
            ∀ e ∈ &self.evidence {
                output.push_str(&format!("  - {} ({})\n", e.content, e.source));
            }
            output.push_str("\n");
        }

        output.push_str(&format!("Confidence: {:.0}%", self.confidence.overall.value() * 100.0));

        ⎇ !self.uncertainties.is_empty() {
            output.push_str("\n\nUncertainties:\n");
            ∀ u ∈ &self.uncertainties {
                output.push_str(&format!("  - {}\n", u.description));
            }
        }

        ⎇ self.level as u8 >= ExplanationLevel·Full as u8 && !self.alternatives.is_empty() {
            output.push_str("\nAlternatives considered:\n");
            ∀ alt ∈ &self.alternatives {
                output.push_str(&format!("  - {}: {}\n", alt.option, alt.rejection_reason));
            }
        }

        output
    }
}

// ============================================================================
// Reasoning Chain
// ============================================================================

☉ Σ ReasoningChain {
    steps: Vec<ReasoningStep>,
}

⊢ ReasoningChain {
    ☉ λ new() -> Self { Self { steps: vec![] } }

    ☉ λ add(&Δ self, step: ReasoningStep) { self.steps.push(step); }

    ☉ λ steps(&self) -> &[ReasoningStep] { &self.steps }

    ☉ λ to_prose(&self) -> String {
        self.steps.iter()
            .enumerate()
            .map(|(i, s)| format!("{}. {}", i + 1, s.description))
            .collect·<Vec<_>>()
            .join("\n")
    }
}

☉ Σ ReasoningStep {
    ☉ id: StepId,
    ☉ step_type: StepType,
    ☉ description: String,
    ☉ inputs: Vec<StepInput>,
    ☉ output: Option<StepOutput>,
    ☉ reasoning: String,
    ☉ confidence: Confidence,
    ☉ timestamp: Timestamp,
}

#[derive(Clone)]
☉ ᛈ StepType {
    Observation,
    Retrieval,
    Inference,
    Evaluation,
    Decision,
    Planning,
    Action,
}

☉ Σ StepInput {
    ☉ name: String,
    ☉ value: Value,
    ☉ source: Option<String>,
}

☉ Σ StepOutput {
    ☉ value: Value,
    ☉ confidence: Confidence,
}

// ============================================================================
// Evidence
// ============================================================================

☉ Σ Evidence {
    ☉ content: String,
    ☉ source: String,
    ☉ evidence_type: EvidenceType,
    ☉ weight: Confidence,
    ☉ epistemic: Epistemic,
}

#[derive(Clone)]
☉ ᛈ EvidenceType {
    DirectObservation,
    Memory,
    Inference,
    ExternalSource,
    UserStatement,
}

#[derive(Copy, Clone)]
☉ ᛈ Epistemic {
    Certain,
    HighConfidence,
    MediumConfidence,
    LowConfidence,
    Uncertain,
}

// ============================================================================
// Alternatives and Uncertainties
// ============================================================================

☉ Σ Alternative {
    ☉ option: String,
    ☉ description: String,
    ☉ rejection_reason: String,
    ☉ score: Option<f32>,
}

☉ Σ Uncertainty {
    ☉ description: String,
    ☉ affects: Vec<String>,
    ☉ impact: String,
}

// ============================================================================
// Confidence Assessment
// ============================================================================

☉ Σ ConfidenceAssessment {
    ☉ overall: Confidence,
    ☉ evidence_strength: Confidence,
    ☉ reasoning_validity: Confidence,
    ☉ experience_relevance: Confidence,
    ☉ uncertainties: Vec<UncertaintyFactor>,
}

☉ Σ UncertaintyFactor {
    ☉ factor: String,
    ☉ impact: Confidence,
    ☉ description: String,
}

☉ Σ ConfidenceBreakdown {
    ☉ overall: Confidence,
    ☉ evidence: Confidence,
    ☉ reasoning: Confidence,
    ☉ experience: Confidence,
    ☉ uncertainties: Vec<String>,
}

// ============================================================================
// Trace System
// ============================================================================

☉ Σ TraceCollector {
    enabled: bool,
    current: Option<Trace>,
    traces: HashMap<ExplainableId, Trace>,
}

⊢ TraceCollector {
    ☉ λ new() -> Self {
        Self { enabled: false, current: None, traces: HashMap·new() }
    }

    ☉ λ enable(&Δ self) {
        self.enabled = true;
        self.current = Some(Trace·new());
    }

    ☉ λ disable(&Δ self) { self.enabled = false; }

    ☉ λ record(&Δ self, step: ReasoningStep) {
        ⎇ self.enabled {
            ⎇ ≔ Some(ref Δ trace) = self.current {
                trace.add_step(step);
            }
        }
    }

    ☉ λ complete(&Δ self, id: ExplainableId) {
        ⎇ ≔ Some(Δ trace) = self.current.take() {
            trace.complete();
            self.traces.insert(id, trace);
        }
    }

    ☉ λ get_trace(&self, id: &ExplainableId) -> Option<&Trace> {
        self.traces.get(id)
    }
}

☉ Σ Trace {
    steps: Vec<ReasoningStep>,
    causal_graph: CausalGraph,
    started: Timestamp,
    ended: Option<Timestamp>,
}

⊢ Trace {
    ☉ λ new() -> Self {
        Self {
            steps: vec![],
            causal_graph: CausalGraph·new(),
            started: Timestamp·now(),
            ended: None,
        }
    }

    ☉ λ add_step(&Δ self, step: ReasoningStep) {
        self.causal_graph.add_node(&step);
        ⎇ ≔ Some(prev) = self.steps.last() {
            self.causal_graph.add_edge(&prev.id, &step.id);
        }
        self.steps.push(step);
    }

    ☉ λ complete(&Δ self) { self.ended = Some(Timestamp·now()); }

    ☉ λ steps(&self) -> &[ReasoningStep] { &self.steps }
}

☉ Σ CausalGraph {
    nodes: Vec<CausalNode>,
    edges: Vec<(StepId, StepId)>,
}

Σ CausalNode {
    id: StepId,
    description: String,
}

⊢ CausalGraph {
    ☉ λ new() -> Self { Self { nodes: vec![], edges: vec![] } }

    ☉ λ add_node(&Δ self, step: &ReasoningStep) {
        self.nodes.push(CausalNode {
            id: step.id.clone(),
            description: step.description.clone(),
        });
    }

    ☉ λ add_edge(&Δ self, from: &StepId, to: &StepId) {
        self.edges.push((from.clone(), to.clone()));
    }

    ☉ λ to_dot(&self) -> String {
        ≔ Δ output = String·from("digraph reasoning {\n");
        ∀ node ∈ &self.nodes {
            ≔ short_desc = ⎇ node.description.len() > 30 {
                format!("{}...", &node.description[..27])
            } ⎉ {
                node.description.clone()
            };
            output.push_str(&format!("  {} [label=\"{}\"];\n", node.id.to_short(), short_desc));
        }
        ∀ (from, to) ∈ &self.edges {
            output.push_str(&format!("  {} -> {};\n", from.to_short(), to.to_short()));
        }
        output.push_str("}\n");
        output
    }

    ☉ λ to_mermaid(&self) -> String {
        ≔ Δ output = String·from("graph TD\n");
        ∀ node ∈ &self.nodes {
            ≔ short_desc = ⎇ node.description.len() > 30 {
                format!("{}...", &node.description[..27])
            } ⎉ {
                node.description.clone()
            };
            output.push_str(&format!("  {}[{}]\n", node.id.to_short(), short_desc));
        }
        ∀ (from, to) ∈ &self.edges {
            output.push_str(&format!("  {} --> {}\n", from.to_short(), to.to_short()));
        }
        output
    }
}

// ============================================================================
// Counterfactual Engine
// ============================================================================

☉ Σ Counterfactual {
    ☉ actual: String,
    ☉ alternative: String,
    ☉ reasons: Vec<String>,
    ☉ decision_point: Option<String>,
    ☉ projected_consequences: Vec<String>,
}

⊢ Counterfactual {
    ☉ λ to_prose(&self) -> String {
        ≔ Δ output = format!("I chose {} instead of {} because:\n", self.actual, self.alternative);
        ∀ (i, reason) ∈ self.reasons.iter().enumerate() {
            output.push_str(&format!("{}. {}\n", i + 1, reason));
        }
        ⎇ !self.projected_consequences.is_empty() {
            output.push_str("\nIf the alternative had been chosen:\n");
            ∀ consequence ∈ &self.projected_consequences {
                output.push_str(&format!("  - {}\n", consequence));
            }
        }
        output
    }
}

// ============================================================================
// Main Oracle Structure
// ============================================================================

☉ Σ Oracle {
    trace: TraceCollector,
    config: OracleConfig,
}

☉ Σ OracleConfig {
    ☉ default_level: ExplanationLevel,
    ☉ auto_explain: bool,
    ☉ trace_enabled: bool,
}

⊢ OracleConfig {
    ☉ λ default() -> Self {
        Self {
            default_level: ExplanationLevel·Standard,
            auto_explain: false,
            trace_enabled: false,
        }
    }
}

⊢ Oracle {
    ☉ λ new() -> Self {
        Self {
            trace: TraceCollector·new(),
            config: OracleConfig·default(),
        }
    }

    /// Enable tracing
    ☉ λ trace_on(&Δ self) { self.trace.enable(); }

    /// Disable tracing
    ☉ λ trace_off(&Δ self) { self.trace.disable(); }

    /// Record a reasoning step
    ☉ λ record_step(&Δ self, step: ReasoningStep) {
        self.trace.record(step);
    }

    /// Complete trace ∀ an explainable
    ☉ λ complete_trace(&Δ self, id: ExplainableId) {
        self.trace.complete(id);
    }

    /// Explain an explainable
    ☉ λ explain<T: Explainable>(&self, item: &T, level: ExplanationLevel) -> Explanation {
        ≔ trace = self.trace.get_trace(&item.id());

        // Build reasoning chain from trace
        ≔ reasoning = ⌥ trace {
            Some(t) => ReasoningChain { steps: t.steps.clone() },
            None => ReasoningChain·new(),
        };

        // Build explanation
        Explanation {
            decision: item.description(),
            summary: format!("Decided: {}", item.description()),
            reasoning,
            evidence: vec![],
            confidence: ConfidenceAssessment {
                overall: Confidence·new(0.8),
                evidence_strength: Confidence·new(0.7),
                reasoning_validity: Confidence·new(0.8),
                experience_relevance: Confidence·new(0.6),
                uncertainties: vec![],
            },
            alternatives: vec![],
            uncertainties: vec![],
            level,
        }
    }

    /// Get confidence breakdown
    ☉ λ confidence_breakdown<T: Explainable>(&self, _item: &T) -> ConfidenceBreakdown {
        ConfidenceBreakdown {
            overall: Confidence·new(0.8),
            evidence: Confidence·new(0.7),
            reasoning: Confidence·new(0.8),
            experience: Confidence·new(0.6),
            uncertainties: vec![],
        }
    }

    /// Analyze counterfactual
    ☉ λ counterfactual(&self, actual: &str, alternative: &str) -> Counterfactual {
        Counterfactual {
            actual: actual.to_string(),
            alternative: alternative.to_string(),
            reasons: vec![format!("{} was preferred over {} based on current context", actual, alternative)],
            decision_point: None,
            projected_consequences: vec![],
        }
    }

    /// Create interactive explainer
    ☉ λ interactive_explainer<'a, T: Explainable>(&'a self, item: &'a T) -> InteractiveExplainer<'a, T> {
        InteractiveExplainer·new(item, self)
    }

    /// Check ⎇ should explain
    ☉ λ should_explain(&self) -> bool {
        self.config.auto_explain
    }

    /// Get trace ∀ visualization
    ☉ λ get_trace(&self, id: &ExplainableId) -> Option<&Trace> {
        self.trace.get_trace(id)
    }
}

⊢ Clone ∀ ReasoningStep {
    λ clone(&self) -> Self {
        Self {
            id: self.id,
            step_type: self.step_type.clone(),
            description: self.description.clone(),
            inputs: vec![], // Simplified
            output: None,
            reasoning: self.reasoning.clone(),
            confidence: self.confidence,
            timestamp: self.timestamp,
        }
    }
}

// ============================================================================
// Interactive Explainer
// ============================================================================

☉ Σ InteractiveExplainer<'a, T: Explainable> {
    item: &'a T,
    oracle: &'a Oracle,
    current_level: ExplanationLevel,
}

⊢<'a, T: Explainable> InteractiveExplainer<'a, T> {
    ☉ λ new(item: &'a T, oracle: &'a Oracle) -> Self {
        Self { item, oracle, current_level: ExplanationLevel·Standard }
    }

    ☉ λ current_explanation(&self) -> Explanation {
        self.oracle.explain(self.item, self.current_level)
    }

    ☉ λ drill_down(&Δ self) -> Explanation {
        self.current_level = ⌥ self.current_level {
            ExplanationLevel·Brief => ExplanationLevel·Standard,
            ExplanationLevel·Standard => ExplanationLevel·Full,
            ExplanationLevel·Full => ExplanationLevel·Technical,
            ExplanationLevel·Technical => ExplanationLevel·Technical,
        };
        self.current_explanation()
    }

    ☉ λ show_evidence(&self) -> Vec<Evidence> {
        self.oracle.explain(self.item, ExplanationLevel·Full).evidence
    }

    ☉ λ explain_confidence(&self) -> ConfidenceBreakdown {
        self.oracle.confidence_breakdown(self.item)
    }
}

// ============================================================================
// Convenience Functions
// ============================================================================

☉ λ new_oracle() -> Oracle { Oracle·new() }

☉ λ explain_decision<T: Explainable>(oracle: &Oracle, decision: &T) -> String {
    oracle.explain(decision, ExplanationLevel·Standard).to_human_readable()
}

// External functions now provided by shared module through Timestamp and Id types
