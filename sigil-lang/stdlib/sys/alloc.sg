//! Native Memory Allocator
//!
//! Provides libc-free memory allocation using mmap/munmap syscalls.
//! This is the foundation for all dynamic memory in Sigil programs
//! compiled without libc.
//!
//! Architecture:
//!   - Small allocations (<= 4KB): Bump allocator with free list
//!   - Large allocations (> 4KB): Direct mmap
//!
//! Thread safety: NOT thread-safe in this version.
//! Use atomic operations for multi-threaded programs.
//!
//! Spec: docs/specs/SIGIL-NATIVE-RUNTIME-SPEC.md

use super::{SyscallError, PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANONYMOUS};
use super::{sys_mmap, sys_munmap, sys_mremap, MREMAP_MAYMOVE};

// ============================================================================
// Constants
// ============================================================================

≔ PAGE_SIZE: usize = 4096;
≔ CHUNK_SIZE: usize = 65536;      // 64KB chunks for small allocations
≔ LARGE_THRESHOLD: usize = 4096;  // Allocations > this use direct mmap
≔ MIN_ALIGNMENT: usize = 16;      // Minimum alignment for all allocations

// ============================================================================
// Allocation Header
// ============================================================================

/// Header prepended to each allocation
///
/// For small allocations: stored in free list when freed
/// For large allocations: stores size for munmap
struct AllocHeader {
    size: usize,      // Size of user data (not including header)
    flags: u32,       // Allocation flags
    magic: u32,       // Magic number for validation (debug only)
}

≔ ALLOC_FLAG_LARGE: u32 = 1;   // Direct mmap allocation
≔ ALLOC_FLAG_FREE: u32 = 2;    // On free list
≔ ALLOC_MAGIC: u32 = 0xDEADBEEF;

☉ impl AllocHeader {
    rite total_size(&self) -> usize! {
        size_of::<AllocHeader>() + self.size
    }

    rite is_large(&self) -> bool! {
        (self.flags & ALLOC_FLAG_LARGE) != 0
    }

    rite is_free(&self) -> bool! {
        (self.flags & ALLOC_FLAG_FREE) != 0
    }
}

// ============================================================================
// Free List Node
// ============================================================================

/// Node in the free list (overlays freed allocation)
struct FreeNode {
    header: AllocHeader,
    next: *vary FreeNode,
}

// ============================================================================
// Chunk (Arena for small allocations)
// ============================================================================

/// A chunk of memory for small allocations
struct Chunk {
    base: *vary u8,     // Base address of chunk
    size: usize,        // Total size of chunk
    used: usize,        // Bytes used (bump pointer offset)
    next: *vary Chunk,  // Next chunk in list
}

☉ impl Chunk {
    /// Create a new chunk via mmap
    rite new(size: usize) -> Result<*vary Chunk, SyscallError>! {
        // Allocate chunk + metadata in one mmap
        ≔ total = size + size_of::<Chunk>();
        ≔ mem = sys_mmap(
            null as *u8,
            total,
            PROT_READ | PROT_WRITE,
            MAP_PRIVATE | MAP_ANONYMOUS,
            -1,
            0
        )?;

        // Chunk metadata at start, usable memory follows
        ≔ chunk = mem as *vary Chunk;
        unsafe {
            (*chunk).base = mem.offset(size_of::<Chunk>() as isize);
            (*chunk).size = size;
            (*chunk).used = 0;
            (*chunk).next = null as *vary Chunk;
        }

        Ok(chunk)
    }

    /// Try to allocate from this chunk (bump allocation)
    rite try_alloc(&vary self, size: usize) -> ?*vary u8 {
        ≔ aligned_size = align_up(size + size_of::<AllocHeader>(), MIN_ALIGNMENT);

        ⎇ self.used + aligned_size <= self.size {
            unsafe {
                // Get pointer to header
                ≔ header_ptr = self.base.offset(self.used as isize) as *vary AllocHeader;
                (*header_ptr).size = size;
                (*header_ptr).flags = 0;
                (*header_ptr).magic = ALLOC_MAGIC;

                // User data follows header
                ≔ user_ptr = (header_ptr as *vary u8).offset(size_of::<AllocHeader>() as isize);
                self.used += aligned_size;

                Some(user_ptr)
            }
        } ⎉ {
            None
        }
    }

    /// Free the entire chunk
    rite destroy(&self) -> Result<(), SyscallError>! {
        ≔ total = self.size + size_of::<Chunk>();
        // The chunk struct is at the start of the mmap region
        ≔ base = (self as *Chunk as *u8).offset(-(size_of::<Chunk>() as isize));
        sys_munmap(base, total)
    }
}

// ============================================================================
// Global Allocator State
// ============================================================================

/// Global allocator state
///
/// WARNING: Not thread-safe. For multi-threaded programs, use
/// thread-local allocators or add synchronization.
struct GlobalAlloc {
    chunks: *vary Chunk,       // List of chunks for small allocations
    free_list: *vary FreeNode, // Free list for small allocations
    total_allocated: usize,    // Total bytes allocated
    total_freed: usize,        // Total bytes freed
}

// Global allocator instance
static vary ALLOCATOR: GlobalAlloc = GlobalAlloc {
    chunks: null as *vary Chunk,
    free_list: null as *vary FreeNode,
    total_allocated: 0,
    total_freed: 0,
};

// ============================================================================
// Allocator Implementation
// ============================================================================

/// Initialize the allocator
///
/// This is called automatically on first allocation, but can be
/// called explicitly for early initialization.
☉ rite alloc_init() -> Result<(), SyscallError>! {
    unsafe {
        ⎇ ALLOCATOR.chunks as usize == 0 {
            ≔ chunk = Chunk::new(CHUNK_SIZE)?;
            ALLOCATOR.chunks = chunk;
        }
    }
    Ok(())
}

/// Allocate memory
///
/// # Arguments
/// - `size`: Number of bytes to allocate
///
/// # Returns
/// Pointer to allocated memory, or error
☉ rite alloc(size: usize) -> Result<*vary u8, SyscallError>! {
    ⎇ size == 0 {
        ret Ok(null as *vary u8);
    }

    // Large allocations go directly to mmap
    ⎇ size > LARGE_THRESHOLD {
        ret alloc_large(size);
    }

    // Try free list first
    ⎇ let Some(ptr) = try_alloc_from_free_list(size) {
        ret Ok(ptr);
    }

    // Try current chunks
    unsafe {
        vary chunk = ALLOCATOR.chunks;
        ⌥ chunk as usize != 0 {
            ⎇ let Some(ptr) = (*chunk).try_alloc(size) {
                ALLOCATOR.total_allocated += size;
                ret Ok(ptr);
            }
            chunk = (*chunk).next;
        }

        // Need a new chunk
        ≔ chunk_size = ⎇ size + size_of::<AllocHeader>() > CHUNK_SIZE {
            align_up(size + size_of::<AllocHeader>(), PAGE_SIZE)
        } ⎉ {
            CHUNK_SIZE
        };

        ≔ new_chunk = Chunk::new(chunk_size)?;
        (*new_chunk).next = ALLOCATOR.chunks;
        ALLOCATOR.chunks = new_chunk;

        // Allocation from new chunk should succeed
        match (*new_chunk).try_alloc(size) {
            Some(ptr) => {
                ALLOCATOR.total_allocated += size;
                Ok(ptr)
            },
            None => Err(SyscallError::ENOMEM),
        }
    }
}

/// Allocate zeroed memory
☉ rite alloc_zeroed(size: usize) -> Result<*vary u8, SyscallError>! {
    ≔ ptr = alloc(size)?;
    // mmap returns zeroed memory, but free list entries might not be
    unsafe {
        memset(ptr, 0, size);
    }
    Ok(ptr)
}

/// Reallocate memory
///
/// # Arguments
/// - `ptr`: Pointer to existing allocation (can be null)
/// - `old_size`: Size of existing allocation
/// - `new_size`: Desired new size
///
/// # Returns
/// Pointer to reallocated memory
☉ rite realloc(ptr: *vary u8, old_size: usize, new_size: usize) -> Result<*vary u8, SyscallError>! {
    ⎇ ptr as usize == 0 {
        ret alloc(new_size);
    }

    ⎇ new_size == 0 {
        free(ptr, old_size)?;
        ret Ok(null as *vary u8);
    }

    ⎇ new_size <= old_size {
        // Shrinking - just return same pointer
        // (Could split and add to free list, but not worth complexity)
        ret Ok(ptr);
    }

    // Check if this is a large allocation that can use mremap
    unsafe {
        ≔ header = (ptr as *u8).offset(-(size_of::<AllocHeader>() as isize)) as *AllocHeader;
        ⎇ (*header).is_large() {
            // Try mremap
            ≔ old_total = (*header).total_size();
            ≔ new_total = size_of::<AllocHeader>() + new_size;
            ≔ new_total_aligned = align_up(new_total, PAGE_SIZE);

            ≔ new_base = sys_mremap(
                header as *u8,
                old_total,
                new_total_aligned,
                MREMAP_MAYMOVE
            )?;

            ≔ new_header = new_base as *vary AllocHeader;
            (*new_header).size = new_size;

            ret Ok(new_base.offset(size_of::<AllocHeader>() as isize));
        }
    }

    // Small allocation - allocate new, copy, free old
    ≔ new_ptr = alloc(new_size)?;
    unsafe {
        memcpy(new_ptr, ptr, old_size);
    }
    free(ptr, old_size)?;

    Ok(new_ptr)
}

/// Free memory
///
/// # Arguments
/// - `ptr`: Pointer to memory to free
/// - `size`: Size of allocation (used for validation)
☉ rite free(ptr: *vary u8, size: usize) -> Result<(), SyscallError>! {
    ⎇ ptr as usize == 0 {
        ret Ok(());
    }

    unsafe {
        ≔ header = (ptr as *u8).offset(-(size_of::<AllocHeader>() as isize)) as *vary AllocHeader;

        // Validate magic (debug)
        ⎇ (*header).magic != ALLOC_MAGIC {
            // Invalid free - corrupted or double-free
            ret Err(SyscallError::EFAULT);
        }

        ⎇ (*header).is_large() {
            // Large allocation - munmap
            ≔ total = (*header).total_size();
            ≔ aligned = align_up(total, PAGE_SIZE);
            sys_munmap(header as *u8, aligned)?;
        } ⎉ {
            // Small allocation - add to free list
            ≔ node = header as *vary FreeNode;
            (*node).header.flags |= ALLOC_FLAG_FREE;
            (*node).next = ALLOCATOR.free_list;
            ALLOCATOR.free_list = node;
        }

        ALLOCATOR.total_freed += size;
    }

    Ok(())
}

// ============================================================================
// Internal Helpers
// ============================================================================

/// Allocate large memory (> LARGE_THRESHOLD) directly via mmap
rite alloc_large(size: usize) -> Result<*vary u8, SyscallError>! {
    ≔ total = size_of::<AllocHeader>() + size;
    ≔ aligned = align_up(total, PAGE_SIZE);

    ≔ mem = sys_mmap(
        null as *u8,
        aligned,
        PROT_READ | PROT_WRITE,
        MAP_PRIVATE | MAP_ANONYMOUS,
        -1,
        0
    )?;

    unsafe {
        ≔ header = mem as *vary AllocHeader;
        (*header).size = size;
        (*header).flags = ALLOC_FLAG_LARGE;
        (*header).magic = ALLOC_MAGIC;

        ALLOCATOR.total_allocated += size;
        Ok(mem.offset(size_of::<AllocHeader>() as isize))
    }
}

/// Try to allocate from the free list
rite try_alloc_from_free_list(size: usize) -> ?*vary u8 {
    unsafe {
        vary prev: *vary FreeNode = null as *vary FreeNode;
        vary curr = ALLOCATOR.free_list;

        ⌥ curr as usize != 0 {
            ⎇ (*curr).header.size >= size {
                // Found a suitable block
                // Remove from free list
                ⎇ prev as usize != 0 {
                    (*prev).next = (*curr).next;
                } ⎉ {
                    ALLOCATOR.free_list = (*curr).next;
                }

                (*curr).header.flags &= !ALLOC_FLAG_FREE;
                ≔ user_ptr = (curr as *vary u8).offset(size_of::<AllocHeader>() as isize);
                ret Some(user_ptr);
            }
            prev = curr;
            curr = (*curr).next;
        }
    }

    None
}

/// Align size up to alignment
rite align_up(size: usize, alignment: usize) -> usize! {
    (size + alignment - 1) & !(alignment - 1)
}

/// Get size of a type (placeholder - should be compiler intrinsic)
rite size_of<T>() -> usize! {
    // This should be a compiler intrinsic
    // For now, hardcode known sizes
    8  // Default to pointer size
}

/// Simple memset (should be compiler intrinsic)
unsafe rite memset(dst: *vary u8, val: u8, count: usize) {
    vary i: usize = 0;
    ⌥ i < count {
        *dst.offset(i as isize) = val;
        i += 1;
    }
}

/// Simple memcpy (should be compiler intrinsic)
unsafe rite memcpy(dst: *vary u8, src: *u8, count: usize) {
    vary i: usize = 0;
    ⌥ i < count {
        *dst.offset(i as isize) = *src.offset(i as isize);
        i += 1;
    }
}

// ============================================================================
// Statistics
// ============================================================================

/// Get allocator statistics
☉ rite alloc_stats() -> (usize, usize)! {
    unsafe {
        (ALLOCATOR.total_allocated, ALLOCATOR.total_freed)
    }
}

/// Get number of chunks allocated
☉ rite alloc_chunk_count() -> usize! {
    unsafe {
        vary count: usize = 0;
        vary chunk = ALLOCATOR.chunks;
        ⌥ chunk as usize != 0 {
            count += 1;
            chunk = (*chunk).next;
        }
        count
    }
}

/// Get number of entries in free list
☉ rite alloc_free_list_count() -> usize! {
    unsafe {
        vary count: usize = 0;
        vary node = ALLOCATOR.free_list;
        ⌥ node as usize != 0 {
            count += 1;
            node = (*node).next;
        }
        count
    }
}
