//! Tests ∀ Engram Episodic Memory (Experience Memory)
//!
//! Verifies time-bounded experience storage with decay and consolidation.

// ============================================================================
// Self-contained Test Types (matching episodic.sg API)
// ============================================================================

☉ Σ EpisodeId(usize);

⊢ EpisodeId {
    λ new(id: usize) -> Self { Self(id) }
}

⊢ PartialEq ∀ EpisodeId {
    λ eq(&self, other: &Self) -> bool {
        self.0 == other.0
    }
}

⊢ Clone ∀ EpisodeId {
    λ clone(&self) -> Self {
        EpisodeId(self.0)
    }
}

☉ ᛈ Outcome {
    Ongoing,
    Success { goal_alignment: f64, effects: Vec<String> },
    Failure { reason: String, recoverable: bool },
    Partial { achieved: f64, notes: String },
    Abandoned { reason: String },
}

⊢ Outcome {
    ☉ λ confidence(&self) -> f64 {
        ⌥ self {
            Outcome·Success { goal_alignment, .. } => *goal_alignment,
            Outcome·Failure { .. } => 1.0,
            Outcome·Partial { achieved, .. } => *achieved,
            Outcome·Ongoing => 0.5,
            Outcome·Abandoned { .. } => 0.0,
        }
    }

    ☉ λ summarize(&self) -> String {
        ⌥ self {
            Outcome·Ongoing => "ongoing".to_string(),
            Outcome·Success { .. } => "success".to_string(),
            Outcome·Failure { reason, .. } => format!("failed: {}", reason),
            Outcome·Partial { achieved, .. } => format!("partial: {:.0}%", achieved * 100.0),
            Outcome·Abandoned { reason } => format!("abandoned: {}", reason),
        }
    }
}

☉ ᛈ EventType {
    UserMessage,
    AgentResponse,
    SystemMessage,
    ToolCall,
    ToolResult,
    StateChange,
    Decision,
    Error,
}

☉ Σ Event {
    ☉ timestamp: u64,
    ☉ sequence: u32,
    ☉ event_type: EventType,
    ☉ content: String,
    ☉ actor: Option<String>,
    ☉ success: Option<bool>,
}

⊢ Event {
    ☉ λ user_message(content: &str) -> Self {
        Self {
            timestamp: 0,
            sequence: 0,
            event_type: EventType·UserMessage,
            content: content.to_string(),
            actor: Some("user".to_string()),
            success: None,
        }
    }

    ☉ λ agent_response(content: &str) -> Self {
        Self {
            timestamp: 0,
            sequence: 0,
            event_type: EventType·AgentResponse,
            content: content.to_string(),
            actor: Some("agent".to_string()),
            success: None,
        }
    }

    ☉ λ tool_call(tool: &str) -> Self {
        Self {
            timestamp: 0,
            sequence: 0,
            event_type: EventType·ToolCall,
            content: tool.to_string(),
            actor: Some("agent".to_string()),
            success: None,
        }
    }

    ☉ λ error_event(error: &str) -> Self {
        Self {
            timestamp: 0,
            sequence: 0,
            event_type: EventType·Error,
            content: error.to_string(),
            actor: None,
            success: Some(false),
        }
    }
}

☉ ᛈ ParticipantRole {
    Self_,
    User,
    OtherAgent,
    System,
    Tool,
}

☉ Σ Participant {
    ☉ id: String,
    ☉ role: ParticipantRole,
    ☉ name: Option<String>,
}

⊢ Participant {
    ☉ λ user(id: &str) -> Self {
        Self {
            id: id.to_string(),
            role: ParticipantRole·User,
            name: None,
        }
    }

    ☉ λ agent(id: &str) -> Self {
        Self {
            id: id.to_string(),
            role: ParticipantRole·Self_,
            name: None,
        }
    }

    ☉ λ tool(name: &str) -> Self {
        Self {
            id: name.to_string(),
            role: ParticipantRole·Tool,
            name: Some(name.to_string()),
        }
    }
}

☉ Σ Context {
    ☉ goal: Option<String>,
    ☉ task: Option<String>,
}

⊢ Context {
    ☉ λ new() -> Self {
        Self { goal: None, task: None }
    }

    ☉ λ with_goal(goal: &str) -> Self {
        Self {
            goal: Some(goal.to_string()),
            task: None,
        }
    }

    ☉ λ with_task(Δ self, task: &str) -> Self {
        self.task = Some(task.to_string());
        self
    }

    ☉ λ to_string(&self) -> String {
        ≔ Δ parts = Vec·new();
        ⎇ ≔ Some(goal) = &self.goal {
            parts.push(format!("Goal: {}", goal));
        }
        ⎇ ≔ Some(task) = &self.task {
            parts.push(format!("Task: {}", task));
        }
        ≔ Δ result = String·new();
        ∀ (i, part) ∈ parts.iter().enumerate() {
            ⎇ i > 0 { result.push_str(", "); }
            result.push_str(part);
        }
        result
    }
}

☉ Σ Episode {
    ☉ id: EpisodeId,
    ☉ started_at: u64,
    ☉ ended_at: Option<u64>,
    ☉ context: Context,
    ☉ participants: Vec<Participant>,
    ☉ events: Vec<Event>,
    ☉ outcome: Outcome,
    ☉ valence: f64,
    ☉ significance: f64,
    ☉ surprise: f64,
    ☉ strength: f64,
    ☉ access_count: u32,
    ☉ last_accessed: u64,
    ☉ consolidated: bool,
    ☉ caused_by: Vec<EpisodeId>,
    ☉ leads_to: Vec<EpisodeId>,
}

⊢ Episode {
    ☉ λ new(id: usize, context: Context) -> Self {
        Self {
            id: EpisodeId·new(id),
            started_at: 0,
            ended_at: None,
            context,
            participants: Vec·new(),
            events: Vec·new(),
            outcome: Outcome·Ongoing,
            valence: 0.0,
            significance: 0.0,
            surprise: 0.0,
            strength: 1.0,
            access_count: 0,
            last_accessed: 0,
            consolidated: false,
            caused_by: Vec·new(),
            leads_to: Vec·new(),
        }
    }

    ☉ λ with_start_time(Δ self, time: u64) -> Self {
        self.started_at = time;
        self
    }

    ☉ λ add_event(&Δ self, event: Event) {
        self.events.push(event);
    }

    ☉ λ add_participant(&Δ self, participant: Participant) {
        self.participants.push(participant);
    }

    ☉ λ complete(&Δ self, outcome: Outcome, end_time: u64) {
        self.outcome = outcome;
        self.ended_at = Some(end_time);
    }

    ☉ λ duration(&self) -> Option<u64> {
        self.ended_at.map(|end| end - self.started_at)
    }

    ☉ λ is_ongoing(&self) -> bool {
        self.ended_at.is_none()
    }

    ☉ λ summarize(&self) -> String {
        ≔ outcome_str = self.outcome.summarize();
        ≔ event_count = self.events.len();
        format!("Episode {}: {} events, {}", self.id.0, event_count, outcome_str)
    }
}

⊢ Clone ∀ Episode {
    λ clone(&self) -> Self {
        Episode {
            id: self.id.clone(),
            started_at: self.started_at,
            ended_at: self.ended_at,
            context: Context {
                goal: self.context.goal.clone(),
                task: self.context.task.clone(),
            },
            participants: Vec·new(),  // Simplified clone
            events: Vec·new(),  // Simplified clone
            outcome: Outcome·Ongoing,  // Simplified clone
            valence: self.valence,
            significance: self.significance,
            surprise: self.surprise,
            strength: self.strength,
            access_count: self.access_count,
            last_accessed: self.last_accessed,
            consolidated: self.consolidated,
            caused_by: Vec·new(),
            leads_to: Vec·new(),
        }
    }
}

☉ Σ EpisodicConfig {
    ☉ decay_rate: f64,
    ☉ consolidation_threshold: f64,
    ☉ max_active_episodes: usize,
    ☉ min_significance_for_retention: f64,
}

⊢ EpisodicConfig {
    ☉ λ default_config() -> Self {
        Self {
            decay_rate: 0.1,
            consolidation_threshold: 0.3,
            max_active_episodes: 1000,
            min_significance_for_retention: 0.1,
        }
    }

    ☉ λ with_decay_rate(Δ self, rate: f64) -> Self {
        self.decay_rate = rate;
        self
    }

    ☉ λ with_consolidation_threshold(Δ self, threshold: f64) -> Self {
        self.consolidation_threshold = threshold;
        self
    }
}

☉ Σ EpisodicMemory {
    episodes: Vec<Episode>,
    config: EpisodicConfig,
    next_id: usize,
}

⊢ EpisodicMemory {
    ☉ λ new(config: EpisodicConfig) -> Self {
        Self {
            episodes: Vec·new(),
            config,
            next_id: 0,
        }
    }

    ☉ λ default_memory() -> Self {
        Self·new(EpisodicConfig·default_config())
    }

    ☉ λ record(&Δ self, Δ episode: Episode) -> EpisodeId {
        // Enrich episode
        ⎇ episode.significance == 0.0 {
            episode.significance = self.compute_significance(&episode);
        }
        episode.strength = 1.0;
        episode.access_count = 0;

        ≔ id = episode.id.clone();
        self.episodes.push(episode);

        // Sort by time descending
        self.episodes.sort_by(|a, b| b.started_at.cmp(&a.started_at));

        id
    }

    ☉ λ get(&self, id: &EpisodeId) -> Option<&Episode> {
        self.episodes.iter().find(|e| e.id == *id)
    }

    ☉ λ len(&self) -> usize {
        self.episodes.len()
    }

    ☉ λ recall_similar(&self, context: &Context, limit: usize) -> Vec<&Episode> {
        ≔ context_text = context.to_string().to_lowercase();

        ≔ Δ scored: Vec<_> = self.episodes.iter()
            .filter(|e| e.strength > 0.1)
            .map(|e| {
                ≔ score = self.compute_similarity(&context_text, e);
                (e, score)
            })
            .filter(|(_, score)| *score > 0.0)
            .collect();

        // Sort by score descending (bubble sort)
        ∀ i ∈ 0..scored.len() {
            ∀ j ∈ (i + 1)..scored.len() {
                ⎇ scored[j].1 > scored[i].1 {
                    ≔ temp = scored[i];
                    scored[i] = scored[j];
                    scored[j] = temp;
                }
            }
        }

        ≔ Δ result = Vec·new();
        ∀ i ∈ 0..limit.min(scored.len()) {
            result.push(scored[i].0);
        }
        result
    }

    ☉ λ recall_before(&self, time: u64, limit: usize) -> Vec<&Episode> {
        ≔ Δ result = Vec·new();
        ∀ episode ∈ &self.episodes {
            ⎇ episode.started_at < time && episode.strength > 0.1 {
                result.push(episode);
                ⎇ result.len() >= limit {
                    ⊗;
                }
            }
        }
        result
    }

    ☉ λ recall_in_range(&self, start: u64, end: u64) -> Vec<&Episode> {
        self.episodes.iter()
            .filter(|e| e.started_at >= start && e.started_at <= end)
            .filter(|e| e.strength > 0.1)
            .collect()
    }

    ☉ λ apply_decay(&Δ self, decay_factor: f64) {
        ∀ episode ∈ &Δ self.episodes {
            episode.strength = episode.strength * decay_factor;

            // Significant episodes decay slower
            ⎇ episode.significance > 0.7 {
                episode.strength = episode.strength.max(0.3);
            }
        }

        // Remove episodes below minimum strength
        ≔ threshold = 0.1;
        self.episodes.retain(|e| e.strength > threshold);
    }

    ☉ λ consolidation_candidates(&self) -> Vec<&Episode> {
        self.episodes.iter()
            .filter(|e| !e.consolidated)
            .filter(|e| e.strength < self.config.consolidation_threshold)
            .filter(|e| e.significance > 0.3)
            .collect()
    }

    ☉ λ mark_consolidated(&Δ self, id: &EpisodeId) {
        ∀ episode ∈ &Δ self.episodes {
            ⎇ episode.id == *id {
                episode.consolidated = true;
                ⊗;
            }
        }
    }

    λ compute_significance(&self, episode: &Episode) -> f64 {
        ≔ Δ score = 0.0;

        // Outcome contributes to significance
        ⌥ &episode.outcome {
            Outcome·Success { goal_alignment, .. } => {
                score = score + 0.3 + goal_alignment * 0.2;
            },
            Outcome·Failure { .. } => {
                score = score + 0.4;  // Failures are significant
            },
            Outcome·Partial { achieved, .. } => {
                score = score + 0.2 + achieved * 0.1;
            },
            _ => {}
        }

        // More events = more significant
        ≔ event_factor = (episode.events.len() as f64 / 20.0).min(0.3);
        score = score + event_factor;

        // Valence extremes are significant
        ≔ valence_factor = episode.valence.abs() * 0.2;
        score = score + valence_factor;

        score.min(1.0)
    }

    λ compute_similarity(&self, context: &str, episode: &Episode) -> f64 {
        ≔ episode_text = episode.summarize().to_lowercase();

        // Simple word overlap
        ≔ context_words: Vec<&str> = context.split_whitespace().collect();
        ≔ episode_words: Vec<&str> = episode_text.split_whitespace().collect();

        ≔ Δ matches = 0;
        ∀ cw ∈ &context_words {
            ∀ ew ∈ &episode_words {
                ⎇ *cw == *ew {
                    matches = matches + 1;
                    ⊗;
                }
            }
        }

        ≔ total = context_words.len() + episode_words.len();
        ⎇ total == 0 { 0.0 } ⎉ { 2.0 * matches as f64 / total as f64 }
    }
}

// ============================================================================
// Tests: Episode Construction
// ============================================================================

#[test]
λ test_episode_creation() {
    ≔ context = Context·with_goal("Complete the task");
    ≔ episode = Episode·new(1, context);

    assert(episode.is_ongoing());
    assert_eq(episode.events.len(), 0);
    assert_eq(episode.participants.len(), 0);
}

#[test]
λ test_episode_with_context() {
    ≔ context = Context·with_goal("Help user")
        .with_task("Answer question");
    ≔ episode = Episode·new(1, context);

    ≔ ctx_str = episode.context.to_string();
    assert(ctx_str.contains("Help user"));
    assert(ctx_str.contains("Answer question"));
}

#[test]
λ test_episode_add_event() {
    ≔ Δ episode = Episode·new(1, Context·new());

    episode.add_event(Event·user_message("Hello"));
    episode.add_event(Event·agent_response("Hi there!"));

    assert_eq(episode.events.len(), 2);
}

#[test]
λ test_episode_add_participant() {
    ≔ Δ episode = Episode·new(1, Context·new());

    episode.add_participant(Participant·user("user_123"));
    episode.add_participant(Participant·agent("agent_456"));

    assert_eq(episode.participants.len(), 2);
}

#[test]
λ test_episode_completion() {
    ≔ Δ episode = Episode·new(1, Context·new())
        .with_start_time(100);

    assert(episode.is_ongoing());
    assert(episode.duration().is_none());

    episode.complete(Outcome·Success {
        goal_alignment: 0.9,
        effects: vec!["Task completed".to_string()],
    }, 200);

    assert(!episode.is_ongoing());
    assert_eq(episode.duration().unwrap(), 100);
}

#[test]
λ test_episode_summarize() {
    ≔ Δ episode = Episode·new(42, Context·with_goal("Test"));
    episode.add_event(Event·user_message("Hello"));
    episode.add_event(Event·agent_response("Hi"));
    episode.complete(Outcome·Success {
        goal_alignment: 0.9,
        effects: Vec·new(),
    }, 100);

    ≔ summary = episode.summarize();
    assert(summary.contains("42"));
    assert(summary.contains("2 events"));
    assert(summary.contains("success"));
}

// ============================================================================
// Tests: Episodic Memory Operations
// ============================================================================

#[test]
λ test_episodic_memory_creation() {
    ≔ memory = EpisodicMemory·default_memory();
    assert_eq(memory.len(), 0);
}

#[test]
λ test_record_episode() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    ≔ episode = Episode·new(1, Context·with_goal("Test goal"));
    ≔ id = memory.record(episode);

    assert_eq(memory.len(), 1);
}

#[test]
λ test_record_multiple_episodes() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    memory.record(Episode·new(1, Context·with_goal("First")));
    memory.record(Episode·new(2, Context·with_goal("Second")));
    memory.record(Episode·new(3, Context·with_goal("Third")));

    assert_eq(memory.len(), 3);
}

#[test]
λ test_get_episode_by_id() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    ≔ episode = Episode·new(42, Context·with_goal("Find me"));
    ≔ id = memory.record(episode);

    ≔ retrieved = memory.get(&id);
    assert(retrieved.is_some());
    assert_eq(retrieved.unwrap().id.0, 42);
}

#[test]
λ test_get_nonexistent_episode() {
    ≔ memory = EpisodicMemory·default_memory();

    ≔ fake_id = EpisodeId·new(999);
    ≔ retrieved = memory.get(&fake_id);
    assert(retrieved.is_none());
}

// ============================================================================
// Tests: Recall Operations
// ============================================================================

#[test]
λ test_recall_similar_context() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    // Record episodes with different goals
    memory.record(Episode·new(1, Context·with_goal("Help with coding")));
    memory.record(Episode·new(2, Context·with_goal("Write documentation")));
    memory.record(Episode·new(3, Context·with_goal("Debug code error")));

    ≔ query = Context·with_goal("coding help");
    ≔ results = memory.recall_similar(&query, 5);

    // Should find some relevant episodes
    assert(results.len() > 0);
}

#[test]
λ test_recall_before_time() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    memory.record(Episode·new(1, Context·new()).with_start_time(100));
    memory.record(Episode·new(2, Context·new()).with_start_time(200));
    memory.record(Episode·new(3, Context·new()).with_start_time(300));

    ≔ results = memory.recall_before(250, 10);

    // Should find episodes before time 250
    ∀ episode ∈ &results {
        assert(episode.started_at < 250);
    }
}

#[test]
λ test_recall_in_range() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    memory.record(Episode·new(1, Context·new()).with_start_time(100));
    memory.record(Episode·new(2, Context·new()).with_start_time(200));
    memory.record(Episode·new(3, Context·new()).with_start_time(300));
    memory.record(Episode·new(4, Context·new()).with_start_time(400));

    ≔ results = memory.recall_in_range(150, 350);

    // Should find episodes ∈ range [150, 350]
    ∀ episode ∈ &results {
        assert(episode.started_at >= 150);
        assert(episode.started_at <= 350);
    }
}

#[test]
λ test_recall_respects_strength_threshold() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    ≔ Δ episode = Episode·new(1, Context·with_goal("Weak episode"));
    episode.strength = 0.05;  // Below threshold
    memory.episodes.push(episode);

    ≔ results = memory.recall_before(1000, 10);

    // Weak episode should not be returned
    assert_eq(results.len(), 0);
}

// ============================================================================
// Tests: Decay and Consolidation
// ============================================================================

#[test]
λ test_apply_decay_reduces_strength() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    ≔ episode = Episode·new(1, Context·new());
    memory.record(episode);

    ≔ before = memory.episodes[0].strength;
    memory.apply_decay(0.8);  // 20% decay
    ≔ after = memory.episodes[0].strength;

    assert(after < before);
}

#[test]
λ test_decay_preserves_significant_episodes() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    ≔ Δ episode = Episode·new(1, Context·new());
    episode.significance = 0.9;  // Very significant
    episode.strength = 1.0;
    memory.episodes.push(episode);

    // Heavy decay
    memory.apply_decay(0.1);

    // Significant episodes maintain minimum strength
    assert(memory.episodes[0].strength >= 0.3);
}

#[test]
λ test_decay_removes_weak_episodes() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    ≔ Δ episode = Episode·new(1, Context·new());
    episode.strength = 0.2;  // Already weak
    episode.significance = 0.1;  // Not significant
    memory.episodes.push(episode);

    // Heavy decay should remove it
    memory.apply_decay(0.3);

    assert_eq(memory.len(), 0);
}

#[test]
λ test_consolidation_candidates() {
    ≔ Δ memory = EpisodicMemory·new(
        EpisodicConfig·default_config().with_consolidation_threshold(0.5)
    );

    // Strong episode - not a candidate
    ≔ Δ e1 = Episode·new(1, Context·new());
    e1.strength = 0.8;
    e1.significance = 0.5;
    memory.episodes.push(e1);

    // Weak but significant - candidate
    ≔ Δ e2 = Episode·new(2, Context·new());
    e2.strength = 0.3;
    e2.significance = 0.5;
    memory.episodes.push(e2);

    // Weak and insignificant - not a candidate
    ≔ Δ e3 = Episode·new(3, Context·new());
    e3.strength = 0.2;
    e3.significance = 0.1;
    memory.episodes.push(e3);

    ≔ candidates = memory.consolidation_candidates();

    // Only e2 should be a candidate
    assert_eq(candidates.len(), 1);
    assert_eq(candidates[0].id.0, 2);
}

#[test]
λ test_mark_consolidated() {
    ≔ Δ memory = EpisodicMemory·default_memory();

    ≔ episode = Episode·new(1, Context·new());
    ≔ id = memory.record(episode);

    assert(!memory.episodes[0].consolidated);

    memory.mark_consolidated(&id);

    assert(memory.episodes[0].consolidated);
}

// ============================================================================
// Tests: Outcome Types
// ============================================================================

#[test]
λ test_outcome_success_confidence() {
    ≔ outcome = Outcome·Success {
        goal_alignment: 0.85,
        effects: Vec·new(),
    };
    ≔ conf = outcome.confidence();
    ≔ diff = (conf - 0.85).abs();
    assert(diff < 0.001);
}

#[test]
λ test_outcome_failure_confidence() {
    ≔ outcome = Outcome·Failure {
        reason: "Error occurred".to_string(),
        recoverable: true,
    };
    // Failures have high confidence (we know what happened)
    ≔ conf = outcome.confidence();
    ≔ diff = (conf - 1.0).abs();
    assert(diff < 0.001);
}

#[test]
λ test_outcome_partial_confidence() {
    ≔ outcome = Outcome·Partial {
        achieved: 0.6,
        notes: "Partially done".to_string(),
    };
    ≔ conf = outcome.confidence();
    ≔ diff = (conf - 0.6).abs();
    assert(diff < 0.001);
}

#[test]
λ test_outcome_summarize() {
    ≔ success = Outcome·Success { goal_alignment: 0.9, effects: Vec·new() };
    assert_eq(success.summarize(), "success");

    ≔ failure = Outcome·Failure { reason: "test".to_string(), recoverable: false };
    assert(failure.summarize().contains("failed"));

    ≔ ongoing = Outcome·Ongoing;
    assert_eq(ongoing.summarize(), "ongoing");
}

// ============================================================================
// Tests: Event Types
// ============================================================================

#[test]
λ test_event_user_message() {
    ≔ event = Event·user_message("Hello world");
    assert_eq(event.content, "Hello world");
    assert(event.actor.is_some());
    assert_eq(event.actor.unwrap(), "user");
}

#[test]
λ test_event_agent_response() {
    ≔ event = Event·agent_response("I can help");
    assert_eq(event.content, "I can help");
    assert_eq(event.actor.unwrap(), "agent");
}

#[test]
λ test_event_tool_call() {
    ≔ event = Event·tool_call("search");
    assert_eq(event.content, "search");
}

#[test]
λ test_event_error() {
    ≔ event = Event·error_event("Connection failed");
    assert_eq(event.content, "Connection failed");
    assert_eq(event.success.unwrap(), false);
}

// ============================================================================
// Tests: Participant Types
// ============================================================================

#[test]
λ test_participant_user() {
    ≔ p = Participant·user("user_123");
    assert_eq(p.id, "user_123");
}

#[test]
λ test_participant_agent() {
    ≔ p = Participant·agent("agent_456");
    assert_eq(p.id, "agent_456");
}

#[test]
λ test_participant_tool() {
    ≔ p = Participant·tool("web_search");
    assert_eq(p.id, "web_search");
    assert(p.name.is_some());
}

// ============================================================================
// Tests: Context
// ============================================================================

#[test]
λ test_context_empty() {
    ≔ ctx = Context·new();
    assert(ctx.goal.is_none());
    assert(ctx.task.is_none());
}

#[test]
λ test_context_with_goal() {
    ≔ ctx = Context·with_goal("Help user");
    assert_eq(ctx.goal.unwrap(), "Help user");
}

#[test]
λ test_context_with_task() {
    ≔ ctx = Context·with_goal("Main goal").with_task("Subtask");
    assert_eq(ctx.goal.unwrap(), "Main goal");
    assert_eq(ctx.task.unwrap(), "Subtask");
}

#[test]
λ test_context_to_string() {
    ≔ ctx = Context·with_goal("Goal").with_task("Task");
    ≔ s = ctx.to_string();
    assert(s.contains("Goal"));
    assert(s.contains("Task"));
}

// ============================================================================
// Tests: Significance Calculation
// ============================================================================

#[test]
λ test_significance_from_success() {
    ≔ memory = EpisodicMemory·default_memory();
    ≔ Δ episode = Episode·new(1, Context·new());
    episode.outcome = Outcome·Success {
        goal_alignment: 0.9,
        effects: Vec·new(),
    };

    ≔ sig = memory.compute_significance(&episode);
    assert(sig > 0.3);
}

#[test]
λ test_significance_from_failure() {
    ≔ memory = EpisodicMemory·default_memory();
    ≔ Δ episode = Episode·new(1, Context·new());
    episode.outcome = Outcome·Failure {
        reason: "test".to_string(),
        recoverable: false,
    };

    ≔ sig = memory.compute_significance(&episode);
    // Failures should be significant (learning opportunity)
    assert(sig >= 0.4);
}

#[test]
λ test_significance_from_events() {
    ≔ memory = EpisodicMemory·default_memory();
    ≔ Δ episode = Episode·new(1, Context·new());

    // Add many events
    ∀ _ ∈ 0..15 {
        episode.add_event(Event·user_message("msg"));
    }

    ≔ sig = memory.compute_significance(&episode);
    assert(sig > 0.2);  // More events = more significance
}

#[test]
λ test_significance_from_valence() {
    ≔ memory = EpisodicMemory·default_memory();
    ≔ Δ episode = Episode·new(1, Context·new());
    episode.valence = 0.9;  // Strong positive emotion

    ≔ sig = memory.compute_significance(&episode);
    assert(sig > 0.1);
}

λ main() {
    print("Engram episodic memory tests");
}
