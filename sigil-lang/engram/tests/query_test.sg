//! Tests ∀ Engram Query System
//!
//! Verifies query building, filters, and result handling.

// ============================================================================
// Self-contained Test Types
// ============================================================================

☉ ᛈ Comparator {
    Eq,
    Ne,
    Gt,
    Lt,
    Gte,
    Lte,
}

⊢ Comparator {
    ☉ λ compare(&self, a: f64, b: f64) -> bool {
        ⌥ self {
            Comparator·Eq => (a - b).abs() < 0.0001,
            Comparator·Ne => (a - b).abs() >= 0.0001,
            Comparator·Gt => a > b,
            Comparator·Lt => a < b,
            Comparator·Gte => a >= b,
            Comparator·Lte => a <= b,
        }
    }
}

☉ ᛈ TimePoint {
    Now,
    Absolute(u64),
    Relative { amount_secs: u64, is_ago: bool },
}

⊢ TimePoint {
    ☉ λ now() -> Self { TimePoint·Now }

    ☉ λ absolute(ts: u64) -> Self { TimePoint·Absolute(ts) }

    ☉ λ ago(secs: u64) -> Self {
        TimePoint·Relative { amount_secs: secs, is_ago: true }
    }

    ☉ λ from_now(secs: u64) -> Self {
        TimePoint·Relative { amount_secs: secs, is_ago: false }
    }

    ☉ λ to_timestamp(&self, current_time: u64) -> u64 {
        ⌥ self {
            TimePoint·Now => current_time,
            TimePoint·Absolute(t) => *t,
            TimePoint·Relative { amount_secs, is_ago } => {
                ⎇ *is_ago {
                    current_time - amount_secs
                } ⎉ {
                    current_time + amount_secs
                }
            }
        }
    }
}

☉ Σ TimeRange {
    ☉ start: u64,
    ☉ end: u64,
}

⊢ TimeRange {
    ☉ λ new(start: u64, end: u64) -> Self {
        Self { start, end }
    }

    ☉ λ contains(&self, ts: u64) -> bool {
        ts >= self.start && ts <= self.end
    }
}

☉ ᛈ TemporalConstraint {
    During(TimeRange),
    Before(TimePoint),
    After(TimePoint),
    At(TimePoint),
    Between(TimePoint, TimePoint),
}

⊢ TemporalConstraint {
    ☉ λ matches(&self, ts: u64, current_time: u64) -> bool {
        ⌥ self {
            TemporalConstraint·During(range) => range.contains(ts),
            TemporalConstraint·Before(point) => ts < point.to_timestamp(current_time),
            TemporalConstraint·After(point) => ts > point.to_timestamp(current_time),
            TemporalConstraint·At(point) => {
                ≔ target = point.to_timestamp(current_time);
                // Within 1 second
                ts >= target.saturating_sub(1) && ts <= target + 1
            },
            TemporalConstraint·Between(start, end) => {
                ≔ start_ts = start.to_timestamp(current_time);
                ≔ end_ts = end.to_timestamp(current_time);
                ts >= start_ts && ts <= end_ts
            }
        }
    }
}

☉ ᛈ MemorySource {
    Instant,
    Episodic,
    Semantic,
    Procedural,
}

⊢ Clone ∀ MemorySource {
    λ clone(&self) -> Self {
        ⌥ self {
            MemorySource·Instant => MemorySource·Instant,
            MemorySource·Episodic => MemorySource·Episodic,
            MemorySource·Semantic => MemorySource·Semantic,
            MemorySource·Procedural => MemorySource·Procedural,
        }
    }
}

⊢ PartialEq ∀ MemorySource {
    λ eq(&self, other: &Self) -> bool {
        ⌥ (self, other) {
            (MemorySource·Instant, MemorySource·Instant) => true,
            (MemorySource·Episodic, MemorySource·Episodic) => true,
            (MemorySource·Semantic, MemorySource·Semantic) => true,
            (MemorySource·Procedural, MemorySource·Procedural) => true,
            _ => false,
        }
    }
}

☉ Σ Memory {
    ☉ id: String,
    ☉ content: String,
    ☉ relevance: f64,
    ☉ confidence: f64,
    ☉ source: MemorySource,
    ☉ timestamp: u64,
}

☉ ᛈ Filter {
    Confidence { op: Comparator, value: f64 },
    Source(MemorySource),
    MinRelevance(f64),
}

⊢ Filter {
    ☉ λ matches(&self, memory: &Memory) -> bool {
        ⌥ self {
            Filter·Confidence { op, value } => op.compare(memory.confidence, *value),
            Filter·Source(source) => memory.source == *source,
            Filter·MinRelevance(min) => memory.relevance >= *min,
        }
    }
}

☉ ᛈ QueryHint {
    MaxCandidates(usize),
    TimeoutMs(u64),
    Approximate(bool),
    NoCache,
}

☉ Σ Query {
    text: Option<String>,
    entity: Option<String>,
    filters: Vec<Filter>,
    temporal: Option<TemporalConstraint>,
    limit: usize,
    offset: usize,
    include_gaps: bool,
    hints: Vec<QueryHint>,
}

⊢ Query {
    ☉ λ new(text: &str) -> Self {
        Self {
            text: Some(text.to_string()),
            entity: None,
            filters: Vec·new(),
            temporal: None,
            limit: 10,
            offset: 0,
            include_gaps: true,
            hints: Vec·new(),
        }
    }

    ☉ λ entity(label: &str) -> Self {
        Self {
            text: None,
            entity: Some(label.to_string()),
            filters: Vec·new(),
            temporal: None,
            limit: 10,
            offset: 0,
            include_gaps: false,
            hints: Vec·new(),
        }
    }

    ☉ λ filter(Δ self, f: Filter) -> Self {
        self.filters.push(f);
        self
    }

    ☉ λ where_confidence(self, op: Comparator, value: f64) -> Self {
        self.filter(Filter·Confidence { op, value })
    }

    ☉ λ where_source(self, source: MemorySource) -> Self {
        self.filter(Filter·Source(source))
    }

    ☉ λ during(Δ self, range: TimeRange) -> Self {
        self.temporal = Some(TemporalConstraint·During(range));
        self
    }

    ☉ λ before(Δ self, point: TimePoint) -> Self {
        self.temporal = Some(TemporalConstraint·Before(point));
        self
    }

    ☉ λ after(Δ self, point: TimePoint) -> Self {
        self.temporal = Some(TemporalConstraint·After(point));
        self
    }

    ☉ λ limit(Δ self, n: usize) -> Self {
        self.limit = n;
        self
    }

    ☉ λ offset(Δ self, n: usize) -> Self {
        self.offset = n;
        self
    }

    ☉ λ top(self, n: usize) -> Self {
        self.limit(n)
    }

    ☉ λ with_gap_analysis(Δ self) -> Self {
        self.include_gaps = true;
        self
    }

    ☉ λ hint(Δ self, h: QueryHint) -> Self {
        self.hints.push(h);
        self
    }

    ☉ λ text(&self) -> String {
        self.text.clone().unwrap_or_default()
    }

    ☉ λ get_limit(&self) -> usize {
        self.limit
    }

    ☉ λ has_temporal(&self) -> bool {
        self.temporal.is_some()
    }

    ☉ λ apply_filters(&self, memories: &Vec<Memory>) -> Vec<&Memory> {
        memories.iter()
            .filter(|m| self.filters.iter().all(|f| f.matches(m)))
            .collect()
    }
}

☉ Σ ConfidenceDistribution {
    ☉ min: f64,
    ☉ max: f64,
    ☉ mean: f64,
    ☉ median: f64,
}

⊢ ConfidenceDistribution {
    ☉ λ from_values(values: &Vec<f64>) -> Self {
        ⎇ values.is_empty() {
            ⤺ Self { min: 0.0, max: 0.0, mean: 0.0, median: 0.0 };
        }

        ≔ Δ sorted = values.clone();
        // Simple bubble sort
        ∀ i ∈ 0..sorted.len() {
            ∀ j ∈ (i + 1)..sorted.len() {
                ⎇ sorted[j] < sorted[i] {
                    ≔ temp = sorted[i];
                    sorted[i] = sorted[j];
                    sorted[j] = temp;
                }
            }
        }

        ≔ min = sorted[0];
        ≔ max = sorted[sorted.len() - 1];
        ≔ mean = sorted.iter().sum·<f64>() / sorted.len() as f64;
        ≔ median = sorted[sorted.len() / 2];

        Self { min, max, mean, median }
    }
}

☉ Σ Gap {
    ☉ description: String,
    ☉ severity: f64,
}

☉ Σ RecallResult {
    ☉ memories: Vec<Memory>,
    ☉ total_found: usize,
    ☉ returned: usize,
    ☉ confidence: ConfidenceDistribution,
    ☉ gaps: Vec<Gap>,
}

⊢ RecallResult {
    ☉ λ empty() -> Self {
        Self {
            memories: Vec·new(),
            total_found: 0,
            returned: 0,
            confidence: ConfidenceDistribution { min: 0.0, max: 0.0, mean: 0.0, median: 0.0 },
            gaps: Vec·new(),
        }
    }

    ☉ λ is_empty(&self) -> bool {
        self.memories.is_empty()
    }

    ☉ λ has_gaps(&self) -> bool {
        !self.gaps.is_empty()
    }

    ☉ λ high_confidence(&self) -> Vec<&Memory> {
        self.memories.iter().filter(|m| m.confidence > 0.8).collect()
    }
}

// ============================================================================
// Tests: Query Construction
// ============================================================================

#[test]
λ test_query_new() {
    ≔ q = Query·new("find information about AI");
    assert_eq(q.text(), "find information about AI");
    assert_eq(q.get_limit(), 10);
}

#[test]
λ test_query_entity() {
    ≔ q = Query·entity("Python");
    assert(q.text().is_empty());
    assert(!q.include_gaps);
}

#[test]
λ test_query_with_limit() {
    ≔ q = Query·new("test").limit(5);
    assert_eq(q.get_limit(), 5);
}

#[test]
λ test_query_with_offset() {
    ≔ q = Query·new("test").offset(10);
    assert_eq(q.offset, 10);
}

#[test]
λ test_query_top_alias() {
    ≔ q = Query·new("test").top(3);
    assert_eq(q.get_limit(), 3);
}

#[test]
λ test_query_with_gap_analysis() {
    ≔ q = Query·new("test").with_gap_analysis();
    assert(q.include_gaps);
}

// ============================================================================
// Tests: Comparator
// ============================================================================

#[test]
λ test_comparator_eq() {
    ≔ cmp = Comparator·Eq;
    assert(cmp.compare(0.5, 0.5));
    assert(!cmp.compare(0.5, 0.6));
}

#[test]
λ test_comparator_ne() {
    ≔ cmp = Comparator·Ne;
    assert(cmp.compare(0.5, 0.6));
    assert(!cmp.compare(0.5, 0.5));
}

#[test]
λ test_comparator_gt() {
    ≔ cmp = Comparator·Gt;
    assert(cmp.compare(0.6, 0.5));
    assert(!cmp.compare(0.5, 0.6));
}

#[test]
λ test_comparator_lt() {
    ≔ cmp = Comparator·Lt;
    assert(cmp.compare(0.4, 0.5));
    assert(!cmp.compare(0.6, 0.5));
}

#[test]
λ test_comparator_gte() {
    ≔ cmp = Comparator·Gte;
    assert(cmp.compare(0.5, 0.5));
    assert(cmp.compare(0.6, 0.5));
    assert(!cmp.compare(0.4, 0.5));
}

#[test]
λ test_comparator_lte() {
    ≔ cmp = Comparator·Lte;
    assert(cmp.compare(0.5, 0.5));
    assert(cmp.compare(0.4, 0.5));
    assert(!cmp.compare(0.6, 0.5));
}

// ============================================================================
// Tests: Filters
// ============================================================================

#[test]
λ test_filter_confidence() {
    ≔ filter = Filter·Confidence { op: Comparator·Gt, value: 0.7 };
    ≔ high = Memory {
        id: "1".to_string(), content: "test".to_string(),
        relevance: 0.8, confidence: 0.9,
        source: MemorySource·Semantic, timestamp: 0
    };
    ≔ low = Memory {
        id: "2".to_string(), content: "test".to_string(),
        relevance: 0.8, confidence: 0.5,
        source: MemorySource·Semantic, timestamp: 0
    };

    assert(filter.matches(&high));
    assert(!filter.matches(&low));
}

#[test]
λ test_filter_source() {
    ≔ filter = Filter·Source(MemorySource·Episodic);
    ≔ episodic = Memory {
        id: "1".to_string(), content: "test".to_string(),
        relevance: 0.8, confidence: 0.9,
        source: MemorySource·Episodic, timestamp: 0
    };
    ≔ semantic = Memory {
        id: "2".to_string(), content: "test".to_string(),
        relevance: 0.8, confidence: 0.9,
        source: MemorySource·Semantic, timestamp: 0
    };

    assert(filter.matches(&episodic));
    assert(!filter.matches(&semantic));
}

#[test]
λ test_filter_min_relevance() {
    ≔ filter = Filter·MinRelevance(0.6);
    ≔ high = Memory {
        id: "1".to_string(), content: "test".to_string(),
        relevance: 0.8, confidence: 0.5,
        source: MemorySource·Instant, timestamp: 0
    };
    ≔ low = Memory {
        id: "2".to_string(), content: "test".to_string(),
        relevance: 0.4, confidence: 0.5,
        source: MemorySource·Instant, timestamp: 0
    };

    assert(filter.matches(&high));
    assert(!filter.matches(&low));
}

#[test]
λ test_query_apply_filters() {
    ≔ q = Query·new("test")
        .where_confidence(Comparator·Gte, 0.7);

    ≔ memories = vec![
        Memory {
            id: "1".to_string(), content: "test".to_string(),
            relevance: 0.9, confidence: 0.8,
            source: MemorySource·Semantic, timestamp: 0
        },
        Memory {
            id: "2".to_string(), content: "test".to_string(),
            relevance: 0.5, confidence: 0.5,
            source: MemorySource·Semantic, timestamp: 0
        },
    ];

    ≔ filtered = q.apply_filters(&memories);
    assert_eq(filtered.len(), 1);
}

// ============================================================================
// Tests: Temporal Constraints
// ============================================================================

#[test]
λ test_time_range() {
    ≔ range = TimeRange·new(100, 200);
    assert(range.contains(150));
    assert(range.contains(100));
    assert(range.contains(200));
    assert(!range.contains(50));
    assert(!range.contains(250));
}

#[test]
λ test_time_point_now() {
    ≔ point = TimePoint·now();
    ≔ ts = point.to_timestamp(1000);
    assert_eq(ts, 1000);
}

#[test]
λ test_time_point_absolute() {
    ≔ point = TimePoint·absolute(500);
    ≔ ts = point.to_timestamp(1000);
    assert_eq(ts, 500);
}

#[test]
λ test_time_point_ago() {
    ≔ point = TimePoint·ago(100);
    ≔ ts = point.to_timestamp(1000);
    assert_eq(ts, 900);
}

#[test]
λ test_time_point_from_now() {
    ≔ point = TimePoint·from_now(100);
    ≔ ts = point.to_timestamp(1000);
    assert_eq(ts, 1100);
}

#[test]
λ test_temporal_during() {
    ≔ constraint = TemporalConstraint·During(TimeRange·new(100, 200));
    assert(constraint.matches(150, 1000));
    assert(!constraint.matches(50, 1000));
}

#[test]
λ test_temporal_before() {
    ≔ constraint = TemporalConstraint·Before(TimePoint·absolute(500));
    assert(constraint.matches(400, 1000));
    assert(!constraint.matches(600, 1000));
}

#[test]
λ test_temporal_after() {
    ≔ constraint = TemporalConstraint·After(TimePoint·absolute(500));
    assert(constraint.matches(600, 1000));
    assert(!constraint.matches(400, 1000));
}

#[test]
λ test_temporal_between() {
    ≔ constraint = TemporalConstraint·Between(
        TimePoint·absolute(100),
        TimePoint·absolute(300)
    );
    assert(constraint.matches(200, 1000));
    assert(!constraint.matches(400, 1000));
}

#[test]
λ test_query_has_temporal() {
    ≔ q1 = Query·new("test");
    ≔ q2 = Query·new("test").before(TimePoint·now());

    assert(!q1.has_temporal());
    assert(q2.has_temporal());
}

// ============================================================================
// Tests: Query Hints
// ============================================================================

#[test]
λ test_query_with_hints() {
    ≔ q = Query·new("test")
        .hint(QueryHint·MaxCandidates(100))
        .hint(QueryHint·Approximate(true))
        .hint(QueryHint·NoCache);

    assert_eq(q.hints.len(), 3);
}

// ============================================================================
// Tests: Confidence Distribution
// ============================================================================

#[test]
λ test_confidence_distribution_empty() {
    ≔ dist = ConfidenceDistribution·from_values(&Vec·new());
    assert_eq(dist.min, 0.0);
    assert_eq(dist.max, 0.0);
}

#[test]
λ test_confidence_distribution_single() {
    ≔ dist = ConfidenceDistribution·from_values(&vec![0.5]);
    assert_eq(dist.min, 0.5);
    assert_eq(dist.max, 0.5);
    assert_eq(dist.mean, 0.5);
}

#[test]
λ test_confidence_distribution_multiple() {
    ≔ dist = ConfidenceDistribution·from_values(&vec![0.2, 0.4, 0.6, 0.8]);
    assert_eq(dist.min, 0.2);
    assert_eq(dist.max, 0.8);
    ≔ mean_diff = (dist.mean - 0.5).abs();
    assert(mean_diff < 0.01);
}

// ============================================================================
// Tests: RecallResult
// ============================================================================

#[test]
λ test_recall_result_empty() {
    ≔ result = RecallResult·empty();
    assert(result.is_empty());
    assert_eq(result.total_found, 0);
}

#[test]
λ test_recall_result_has_gaps() {
    ≔ Δ result = RecallResult·empty();
    assert(!result.has_gaps());

    result.gaps.push(Gap {
        description: "Missing info".to_string(),
        severity: 0.5,
    });
    assert(result.has_gaps());
}

#[test]
λ test_recall_result_high_confidence() {
    ≔ Δ result = RecallResult·empty();
    result.memories.push(Memory {
        id: "1".to_string(), content: "high".to_string(),
        relevance: 0.9, confidence: 0.9,
        source: MemorySource·Semantic, timestamp: 0
    });
    result.memories.push(Memory {
        id: "2".to_string(), content: "low".to_string(),
        relevance: 0.9, confidence: 0.5,
        source: MemorySource·Semantic, timestamp: 0
    });

    ≔ high = result.high_confidence();
    assert_eq(high.len(), 1);
    assert_eq(high[0].content, "high");
}

λ main() {
    print("Engram query system tests");
}
