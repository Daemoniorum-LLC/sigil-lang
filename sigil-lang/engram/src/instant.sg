// Instant Memory Module
// Working memory ∀ the current context

module engram·instant

invoke engram·types·*
invoke engram·config·InstantConfig

// ============================================================================
// Instant Memory
// ============================================================================

/// Instant Memory - the agent's working memory
///
/// Manages what the agent is currently "thinking about" - the active
/// context window. Bounded by token capacity, with priority-based
/// management and decay over time.
☉ Σ InstantMemory {
    /// Maximum token capacity
    capacity: TokenCount,

    /// Current items ∈ working memory
    items: Vec<InstantItem>,

    /// Current token usage
    token_count: TokenCount,

    /// Decay rate per tick
    decay_rate: f64,

    /// Eviction threshold
    eviction_threshold: f64,

    /// Compression strategy
    compression_strategy: CompressionStrategy,

    /// Configuration
    config: InstantConfig,
}

⊢ InstantMemory {
    // ========================================================================
    // Construction
    // ========================================================================

    /// Create new instant memory with configuration
    ☉ λ new(config: InstantConfig) -> EngramResult<Self>! {
        Ok(Self {
            capacity: config.capacity,
            items: vec![],
            token_count: TokenCount·zero(),
            decay_rate: config.decay_rate,
            eviction_threshold: config.eviction_threshold,
            compression_strategy: config.compression_strategy.clone(),
            config,
        })
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    /// Add an item to working memory
    ///
    /// If adding would exceed capacity, lower-priority items are
    /// evicted or compressed based on the compression strategy.
    ☉ λ attend(content: Content, relevance: f64) -> EngramResult<ItemId>! {
        ≔ tokens = self.count_tokens(&content)

        // Check ⎇ content is too large ∀ capacity
        ⎇ tokens.0 > self.capacity.0 {
            ⤺ Err(EngramError·TokenBudgetExceeded {
                needed: tokens,
                available: self.capacity,
            })
        }

        // Make room ⎇ needed
        ⟳ self.token_count.0 + tokens.0 > self.capacity.0 {
            self.evict_or_compress()?
        }

        ≔ id = ItemId·new()!
        ≔ item = InstantItem {
            id: id.clone(),
            content,
            tokens,
            base_relevance: relevance,
            current_priority: relevance,
            added_at: Instant·now(),
            last_refreshed: Instant·now(),
            source: MemorySource·Instant,
            source_id: None,
        }

        self.items.push(item)
        self.token_count = self.token_count + tokens

        // Re-sort by priority
        self.sort_by_priority()

        Ok(id)
    }

    /// Refresh an item's priority (it's still relevant)
    ☉ λ refresh(id: ItemId, boost: f64) -> EngramResult<()>! {
        ≔ item = self.items.iter_mut()
            .find(|i| i.id == id)
            .ok_or(EngramError·NotFound {
                id: id.to_string(),
                memory_type: "instant".to_string(),
            })?

        item.current_priority = (item.current_priority + boost).min(1.0)
        item.last_refreshed = Instant·now()

        self.sort_by_priority()
        Ok(())
    }

    /// Dismiss (remove) an item from working memory
    ☉ λ dismiss(id: ItemId) -> EngramResult<()>! {
        ≔ idx = self.items.iter()
            .position(|i| i.id == id)
            .ok_or(EngramError·NotFound {
                id: id.to_string(),
                memory_type: "instant".to_string(),
            })?

        ≔ item = self.items.remove(idx)
        self.token_count = self.token_count - item.tokens

        Ok(())
    }

    /// Get all active items, sorted by priority
    ☉ λ active() -> Vec<&InstantItem> {
        self.items.iter().collect()
    }

    /// Get a specific item by ID
    ☉ λ get(id: ItemId) -> Option<&InstantItem> {
        self.items.iter().find(|i| i.id == id)
    }

    /// Search ∀ relevant items
    ☉ λ search(query: &Query) -> Vec<Memory> {
        ≔ query_text = query.text()

        self.items.iter()
            .filter(|item| {
                // Simple relevance check - ∈ production, invoke embeddings
                ≔ content_str = item.content.to_string().to_lowercase()
                ≔ query_lower = query_text.to_lowercase()

                query_lower.split_whitespace()
                    .any(|word| content_str.contains(word))
            })
            .map(|item| Memory {
                id: item.id.clone().into(),
                content: item.content.to_value(),
                relevance: item.current_priority,
                confidence: 1.0,  // Instant memory is certain
                epistemic: Epistemic·Observed {
                    observer: "self".to_string(),
                    timestamp: item.added_at,
                },
                source: MemorySource·Instant,
                timestamp: item.added_at,
                access_path: None,
            })
            .collect()
    }

    /// Apply decay tick
    ///
    /// Call this periodically to decay item priorities and evict
    /// items that fall below the eviction threshold.
    ☉ λ tick() {
        ≔ now = Instant·now()

        ∀ item ∈ &Δ self.items {
            // Calculate decay based on time since last refresh
            ≔ elapsed = (now - item.last_refreshed).as_secs_f64() / 3600.0  // hours
            ≔ decay = (-self.decay_rate * elapsed).exp()
            item.current_priority *= decay
        }

        // Evict items below threshold
        ≔ threshold = self.eviction_threshold
        ≔ Δ to_remove = vec![]

        ∀ (idx, item) ∈ self.items.iter().enumerate() {
            ⎇ item.current_priority < threshold {
                to_remove.push(idx)
            }
        }

        // Remove ∈ reverse order to preserve indices
        ∀ idx ∈ to_remove.into_iter().rev() {
            ≔ item = self.items.remove(idx)
            self.token_count = self.token_count - item.tokens
        }

        self.sort_by_priority()
    }

    /// Clear all items
    ☉ λ clear() {
        self.items.clear()
        self.token_count = TokenCount·zero()
    }

    // ========================================================================
    // Export
    // ========================================================================

    /// Export ∀ LLM consumption
    ☉ λ export(format: ExportFormat, budget: Option<TokenCount>) -> String {
        ≔ budget = budget.unwrap_or(self.capacity)
        ≔ Δ used = TokenCount·zero()
        ≔ Δ exported = vec![]

        ∀ item ∈ &self.items {
            ⎇ used.0 + item.tokens.0 > budget.0 {
                break
            }
            exported.push(item)
            used = used + item.tokens
        }

        ⌥ format {
            ExportFormat·Plain => {
                exported.iter()
                    .map(|i| i.content.to_string())
                    .collect·<Vec<_>>()
                    .join("\n\n")
            },
            ExportFormat·XML => {
                exported.iter()
                    .map(|i| format!(
                        "<item priority=\"{:.2}\">\n{}\n</item>",
                        i.current_priority,
                        i.content.to_string()
                    ))
                    .collect·<Vec<_>>()
                    .join("\n")
            },
            ExportFormat·Markdown => {
                exported.iter()
                    .map(|i| format!(
                        "**[{:.0}%]** {}",
                        i.current_priority * 100.0,
                        i.content.to_string()
                    ))
                    .collect·<Vec<_>>()
                    .join("\n\n")
            },
            ExportFormat·JSON => {
                ≔ items: Vec<_> = exported.iter()
                    .map(|i| json!({
                        "content": i.content.to_string(),
                        "priority": i.current_priority,
                        "tokens": i.tokens.0,
                    }))
                    .collect()

                serde_json·to_string_pretty(&items).unwrap_or_default()
            },
        }
    }

    // ========================================================================
    // Usage Information
    // ========================================================================

    /// Get current token usage
    ☉ λ token_usage() -> TokenUsage {
        TokenUsage {
            used: self.token_count,
            capacity: self.capacity,
            utilization: self.token_count.0 as f64 / self.capacity.0 as f64,
        }
    }

    /// Get memory system usage
    ☉ λ usage() -> MemorySystemUsage {
        MemorySystemUsage {
            item_count: self.items.len(),
            bytes_used: self.items.iter()
                .map(|i| i.estimated_size())
                .sum(),
            capacity: Some(self.capacity.0),
        }
    }

    // ========================================================================
    // Internal Helpers
    // ========================================================================

    λ count_tokens(content: &Content) -> TokenCount {
        ⌥ &self.config.token_counter {
            TokenCounterType·Approximate => {
                TokenCount·from_text(&content.to_string())
            },
            TokenCounterType·Tiktoken { model } => {
                // Use tiktoken ∀ accurate counting
                tiktoken·count(&content.to_string(), model)
                    .map(|n| TokenCount(n))
                    .unwrap_or_else(|| TokenCount·from_text(&content.to_string()))
            },
            TokenCounterType·Custom { counter } => {
                TokenCount(counter(&content.to_string()))
            },
        }
    }

    λ sort_by_priority() {
        self.items.sort_by(|a, b| {
            b.current_priority.partial_cmp(&a.current_priority).unwrap()
        })
    }

    λ evict_or_compress() -> EngramResult<()>! {
        ⎇ self.items.is_empty() {
            ⤺ Err(EngramError·Internal {
                message: "Cannot evict from empty instant memory".to_string(),
            })
        }

        ⌥ &self.compression_strategy {
            CompressionStrategy·EvictLowest => {
                // Remove lowest priority item
                ≔ item = self.items.pop().unwrap()
                self.token_count = self.token_count - item.tokens
            },

            CompressionStrategy·Compress { target_ratio } => {
                // Compress lowest priority item
                ≔ idx = self.items.len() - 1
                ≔ item = &Δ self.items[idx]

                ≔ new_content = self.compress_content(&item.content, *target_ratio)
                ≔ new_tokens = self.count_tokens(&new_content)

                self.token_count = self.token_count - item.tokens + new_tokens
                item.content = new_content
                item.tokens = new_tokens
            },

            CompressionStrategy·SummarizeBatch { batch_size, target_tokens } => {
                // Summarize a batch of low-priority items
                ≔ to_summarize: Vec<_> = self.items
                    .drain((self.items.len().saturating_sub(*batch_size))..)
                    .collect()

                ≔ freed_tokens: TokenCount = to_summarize.iter()
                    .map(|i| i.tokens)
                    .fold(TokenCount·zero(), |a, b| a + b)

                // Create summary
                ≔ combined_text = to_summarize.iter()
                    .map(|i| i.content.to_string())
                    .collect·<Vec<_>>()
                    .join("\n")

                ≔ summary = self.summarize(&combined_text, target_tokens.0)
                ≔ summary_tokens = self.count_tokens(&Content·Text(summary.clone()))

                self.token_count = self.token_count - freed_tokens + summary_tokens

                // Add summary as new item
                ≔ avg_priority = to_summarize.iter()
                    .map(|i| i.current_priority)
                    .sum·<f64>() / to_summarize.len() as f64

                self.items.push(InstantItem {
                    id: ItemId·new().unwrap(),
                    content: Content·Summary {
                        original_ids: to_summarize.iter().map(|i| i.id.clone()).collect(),
                        text: summary,
                    },
                    tokens: summary_tokens,
                    base_relevance: avg_priority,
                    current_priority: avg_priority,
                    added_at: Instant·now(),
                    last_refreshed: Instant·now(),
                    source: MemorySource·Instant,
                    source_id: None,
                })
            },

            CompressionStrategy·Aggressive => {
                // Remove multiple lowest priority items
                ⟳ self.items.len() > 1 &&
                      self.token_count.0 > self.capacity.0 / 2 {
                    ≔ item = self.items.pop().unwrap()
                    self.token_count = self.token_count - item.tokens
                }
            },
        }

        self.sort_by_priority()
        Ok(())
    }

    λ compress_content(content: &Content, target_ratio: f64) -> Content {
        ≔ text = content.to_string()
        ≔ target_len = (text.len() as f64 * target_ratio) as usize

        // Simple truncation with ellipsis - ∈ production, invoke LLM summarization
        ⎇ text.len() > target_len {
            ≔ truncated = &text[..target_len.saturating_sub(3)]
            Content·Text(format!("{}...", truncated))
        } ⎉ {
            content.clone()
        }
    }

    λ summarize(text: &str, target_tokens: usize) -> String {
        // Simple extractive summary - ∈ production, invoke LLM
        ≔ target_chars = target_tokens * 4

        ⎇ text.len() <= target_chars {
            ⤺ text.to_string()
        }

        // Take first and last portions
        ≔ half = target_chars / 2
        ≔ first = &text[..half]
        ≔ last = &text[text.len().saturating_sub(half)..]

        format!("{}...[summarized]...{}", first, last)
    }
}

// ============================================================================
// Supporting Types
// ============================================================================

/// An item ∈ instant memory
☉ Σ InstantItem {
    /// Unique identifier
    ☉ id: ItemId,

    /// The content
    ☉ content: Content,

    /// Token count
    ☉ tokens: TokenCount,

    /// Initial relevance when added
    ☉ base_relevance: f64,

    /// Current priority (after decay)
    ☉ current_priority: f64,

    /// When added
    ☉ added_at: Instant,

    /// Last time priority was refreshed
    ☉ last_refreshed: Instant,

    /// Source memory system
    ☉ source: MemorySource,

    /// ID ∈ source system (⎇ applicable)
    ☉ source_id: Option<EngramId>,
}

⊢ InstantItem {
    λ estimated_size() -> usize {
        // Rough estimate of memory usage
        std·mem·size_of·<Self>() + self.content.to_string().len()
    }
}

/// Content that can be stored ∈ instant memory
☉ ᛈ Content {
    /// Plain text
    Text(String),

    /// Structured data
    Structured(Value),

    /// Reference to an engram
    Reference {
        engram_id: EngramId,
        summary: String,
    },

    /// Compressed summary of multiple items
    Summary {
        original_ids: Vec<ItemId>,
        text: String,
    },
}

⊢ Content {
    ☉ λ to_string() -> String {
        ⌥ self {
            Content·Text(s) => s.clone(),
            Content·Structured(v) => serde_json·to_string(v).unwrap_or_default(),
            Content·Reference { summary, .. } => summary.clone(),
            Content·Summary { text, .. } => text.clone(),
        }
    }

    ☉ λ to_value() -> Value {
        ⌥ self {
            Content·Text(s) => Value·String(s.clone()),
            Content·Structured(v) => v.clone(),
            Content·Reference { summary, engram_id } => json!({
                "type": "reference",
                "id": engram_id.to_string(),
                "summary": summary,
            }),
            Content·Summary { text, original_ids } => json!({
                "type": "summary",
                "text": text,
                "original_count": original_ids.len(),
            }),
        }
    }
}

⊢ From<String> ∀ Content {
    λ from(s: String) -> Self {
        Content·Text(s)
    }
}

⊢ From<&str> ∀ Content {
    λ from(s: &str) -> Self {
        Content·Text(s.to_string())
    }
}

/// Export formats
☉ ᛈ ExportFormat {
    Plain,
    XML,
    Markdown,
    JSON,
}

/// Token usage information
☉ Σ TokenUsage {
    ☉ used: TokenCount,
    ☉ capacity: TokenCount,
    ☉ utilization: f64,
}
