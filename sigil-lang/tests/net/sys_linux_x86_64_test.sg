//! Syscall Layer Tests - Linux x86_64
//!
//! TDD Red Phase: These tests define expected behavior ∀ the syscall layer.
//! All tests should FAIL until the implementation is complete.
//!
//! Test IDs: SYS-001 through SYS-019
//! Spec: docs/specs/NATIVE-NETWORKING-SPEC.md Section 3

// Import the syscall module (does not exist yet - will fail)
invoke stdlib·net·sys·linux_x86_64·*;
invoke stdlib·net·sys·SyscallError;

// ============================================================================
// Test Helpers
// ============================================================================

λ test_assert_eq<T: Eq + Display>(actual: T, expected: T, test_id: &str, msg: &str) {
    ⎇ actual != expected {
        panic(format!("[{}] FAIL: {} - expected {}, got {}", test_id, msg, expected, actual));
    }
}

λ test_assert_ok<T, E: Display>(result: Result<T, E>, test_id: &str, msg: &str) -> T {
    ⌥ result {
        Result·Ok(v) => v,
        Result·Err(e) => panic(format!("[{}] FAIL: {} - got error: {}", test_id, msg, e)),
    }
}

λ test_assert_err<T, E>(result: Result<T, E>, test_id: &str, msg: &str) -> E {
    ⌥ result {
        Result·Ok(_) => panic(format!("[{}] FAIL: {} - expected error, got Ok", test_id, msg)),
        Result·Err(e) => e,
    }
}

λ test_assert_true(cond: bool, test_id: &str, msg: &str) {
    ⎇ !cond {
        panic(format!("[{}] FAIL: {}", test_id, msg));
    }
}

// ============================================================================
// SYS-001: test_sys_socket_creates_fd
// Create TCP socket via syscall, returns fd > 0
// ============================================================================

λ test_sys_socket_creates_fd() -> bool {
    print("  [SYS-001] sys_socket creates valid fd... ");

    // AF_INET = 2, SOCK_STREAM = 1, protocol = 0
    ≔ result = sys_socket(2, 1, 0);
    ≔ fd = test_assert_ok(result, "SYS-001", "socket creation");

    test_assert_true(fd > 0, "SYS-001", format!("fd should be > 0, got {}", fd));

    // Clean up
    sys_close(fd as i32);

    println("PASS");
    true
}

// ============================================================================
// SYS-002: test_sys_socket_invalid_domain
// Invalid domain parameter returns -EINVAL
// ============================================================================

λ test_sys_socket_invalid_domain() -> bool {
    print("  [SYS-002] sys_socket invalid domain... ");

    // Invalid domain = 9999
    ≔ result = sys_socket(9999, 1, 0);
    ≔ err = test_assert_err(result, "SYS-002", "invalid domain should fail");

    // Should be EINVAL (22) or EAFNOSUPPORT (97)
    test_assert_true(
        err == SyscallError·EINVAL || err == SyscallError·EAFNOSUPPORT,
        "SYS-002",
        format!("expected EINVAL or EAFNOSUPPORT, got {:?}", err)
    );

    println("PASS");
    true
}

// ============================================================================
// SYS-003: test_sys_close_valid_fd
// Close valid socket fd returns 0
// ============================================================================

λ test_sys_close_valid_fd() -> bool {
    print("  [SYS-003] sys_close valid fd... ");

    // Create a socket first
    ≔ fd = test_assert_ok(sys_socket(2, 1, 0), "SYS-003", "socket creation");

    // Close it
    ≔ result = sys_close(fd as i32);
    test_assert_ok(result, "SYS-003", "close should succeed");

    println("PASS");
    true
}

// ============================================================================
// SYS-004: test_sys_close_invalid_fd
// Close invalid fd (-1) returns -EBADF
// ============================================================================

λ test_sys_close_invalid_fd() -> bool {
    print("  [SYS-004] sys_close invalid fd... ");

    ≔ result = sys_close(-1);
    ≔ err = test_assert_err(result, "SYS-004", "close(-1) should fail");

    test_assert_eq(err, SyscallError·EBADF, "SYS-004", "expected EBADF");

    println("PASS");
    true
}

// ============================================================================
// SYS-005: test_sys_connect_localhost
// Connect to 127.0.0.1:port returns 0 on success
// ============================================================================

λ test_sys_connect_localhost() -> bool {
    print("  [SYS-005] sys_connect localhost... ");

    // This test requires a local server - will fail without one
    // For now, test that the syscall interface works

    ≔ fd = test_assert_ok(sys_socket(2, 1, 0), "SYS-005", "socket creation");

    // Build sockaddr_in ∀ 127.0.0.1:12345
    // Σ sockaddr_in {
    //   sa_family_t sin_family;  // AF_INET = 2
    //   in_port_t sin_port;      // port ∈ network byte order
    //   Σ in_addr sin_addr; // 127.0.0.1 = 0x7f000001
    //   char sin_zero[8];
    // }
    ≔ Δ sockaddr: [u8; 16] = [0; 16];
    sockaddr[0] = 2;   // AF_INET (little endian, but sin_family is host order)
    sockaddr[1] = 0;
    sockaddr[2] = 48;  // port 12345 >> 8 = 48
    sockaddr[3] = 57;  // port 12345 & 0xFF = 57
    sockaddr[4] = 127; // 127.0.0.1
    sockaddr[5] = 0;
    sockaddr[6] = 0;
    sockaddr[7] = 1;

    // Connect will fail (ECONNREFUSED) since no server is listening
    // But the syscall interface should work
    ≔ result = sys_connect(fd as i32, &sockaddr, 16);

    // We expect ECONNREFUSED since nothing is listening
    ≔ err = test_assert_err(result, "SYS-005", "connect should fail (no server)");
    test_assert_eq(err, SyscallError·ECONNREFUSED, "SYS-005", "expected ECONNREFUSED");

    sys_close(fd as i32);

    println("PASS");
    true
}

// ============================================================================
// SYS-006: test_sys_connect_refused
// Connect to closed port returns -ECONNREFUSED
// ============================================================================

λ test_sys_connect_refused() -> bool {
    print("  [SYS-006] sys_connect refused... ");

    ≔ fd = test_assert_ok(sys_socket(2, 1, 0), "SYS-006", "socket creation");

    // Connect to port 1 (likely closed, requires root)
    ≔ Δ sockaddr: [u8; 16] = [0; 16];
    sockaddr[0] = 2;   // AF_INET
    sockaddr[2] = 0;   // port 1 high byte
    sockaddr[3] = 1;   // port 1 low byte
    sockaddr[4] = 127;
    sockaddr[5] = 0;
    sockaddr[6] = 0;
    sockaddr[7] = 1;

    ≔ result = sys_connect(fd as i32, &sockaddr, 16);
    ≔ err = test_assert_err(result, "SYS-006", "connect to closed port should fail");

    // ECONNREFUSED or EACCES (permission denied ∀ port 1)
    test_assert_true(
        err == SyscallError·ECONNREFUSED || err == SyscallError·EACCES,
        "SYS-006",
        format!("expected ECONNREFUSED or EACCES, got {:?}", err)
    );

    sys_close(fd as i32);

    println("PASS");
    true
}

// ============================================================================
// SYS-007: test_sys_bind_port
// Bind to local port returns 0
// ============================================================================

λ test_sys_bind_port() -> bool {
    print("  [SYS-007] sys_bind port... ");

    ≔ fd = test_assert_ok(sys_socket(2, 1, 0), "SYS-007", "socket creation");

    // Set SO_REUSEADDR first
    ≔ Δ optval: i32 = 1;
    sys_setsockopt(fd as i32, 1, 2, &optval as *u8, 4); // SOL_SOCKET=1, SO_REUSEADDR=2

    // Bind to port 0 (≔ OS assign)
    ≔ Δ sockaddr: [u8; 16] = [0; 16];
    sockaddr[0] = 2;   // AF_INET
    sockaddr[2] = 0;   // port 0
    sockaddr[3] = 0;
    // INADDR_ANY = 0.0.0.0

    ≔ result = sys_bind(fd as i32, &sockaddr, 16);
    test_assert_ok(result, "SYS-007", "bind should succeed");

    sys_close(fd as i32);

    println("PASS");
    true
}

// ============================================================================
// SYS-008: test_sys_bind_address_in_use
// Bind to already bound port returns -EADDRINUSE
// ============================================================================

λ test_sys_bind_address_in_use() -> bool {
    print("  [SYS-008] sys_bind address ∈ use... ");

    // Create first socket and bind to a port
    ≔ fd1 = test_assert_ok(sys_socket(2, 1, 0), "SYS-008", "socket creation 1");

    ≔ Δ sockaddr: [u8; 16] = [0; 16];
    sockaddr[0] = 2;   // AF_INET
    sockaddr[2] = 0xC0; // port 49152 (high byte)
    sockaddr[3] = 0x00; // port 49152 (low byte)

    test_assert_ok(sys_bind(fd1 as i32, &sockaddr, 16), "SYS-008", "first bind");

    // Create second socket and try to bind to same port
    ≔ fd2 = test_assert_ok(sys_socket(2, 1, 0), "SYS-008", "socket creation 2");

    ≔ result = sys_bind(fd2 as i32, &sockaddr, 16);
    ≔ err = test_assert_err(result, "SYS-008", "second bind should fail");

    test_assert_eq(err, SyscallError·EADDRINUSE, "SYS-008", "expected EADDRINUSE");

    sys_close(fd1 as i32);
    sys_close(fd2 as i32);

    println("PASS");
    true
}

// ============================================================================
// SYS-009: test_sys_listen_backlog
// Set socket to listen mode returns 0
// ============================================================================

λ test_sys_listen_backlog() -> bool {
    print("  [SYS-009] sys_listen backlog... ");

    ≔ fd = test_assert_ok(sys_socket(2, 1, 0), "SYS-009", "socket creation");

    // Bind first
    ≔ Δ sockaddr: [u8; 16] = [0; 16];
    sockaddr[0] = 2;
    test_assert_ok(sys_bind(fd as i32, &sockaddr, 16), "SYS-009", "bind");

    // Listen with backlog of 10
    ≔ result = sys_listen(fd as i32, 10);
    test_assert_ok(result, "SYS-009", "listen should succeed");

    sys_close(fd as i32);

    println("PASS");
    true
}

// ============================================================================
// SYS-010: test_sys_accept_connection
// Accept incoming connection returns new fd > 0
// Skipped ∈ unit tests - requires integration test with client
// ============================================================================

λ test_sys_accept_connection() -> bool {
    print("  [SYS-010] sys_accept connection... ");

    // This test is marked as requiring integration test setup
    // For unit tests, we just verify the syscall interface exists

    ≔ fd = test_assert_ok(sys_socket(2, 1, 0), "SYS-010", "socket creation");

    ≔ Δ sockaddr: [u8; 16] = [0; 16];
    sockaddr[0] = 2;
    test_assert_ok(sys_bind(fd as i32, &sockaddr, 16), "SYS-010", "bind");
    test_assert_ok(sys_listen(fd as i32, 10), "SYS-010", "listen");

    // Set non-blocking mode to avoid hanging
    sys_fcntl(fd as i32, 4, 2048); // F_SETFL=4, O_NONBLOCK=2048

    // Accept should ⤺ EAGAIN/EWOULDBLOCK since no connection pending
    ≔ Δ client_addr: [u8; 16] = [0; 16];
    ≔ Δ addrlen: u32 = 16;
    ≔ result = sys_accept(fd as i32, &client_addr, &addrlen);
    ≔ err = test_assert_err(result, "SYS-010", "accept should ⤺ EAGAIN");

    test_assert_true(
        err == SyscallError·EAGAIN || err == SyscallError·EWOULDBLOCK,
        "SYS-010",
        format!("expected EAGAIN/EWOULDBLOCK, got {:?}", err)
    );

    sys_close(fd as i32);

    println("PASS (EAGAIN expected)");
    true
}

