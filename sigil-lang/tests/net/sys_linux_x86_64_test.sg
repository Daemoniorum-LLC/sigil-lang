// ============================================================================
// SYS-013: test_sys_setsockopt_reuseaddr
// Set SO_REUSEADDR returns 0
// ============================================================================

λ test_sys_setsockopt_reuseaddr() -> bool {
    print("  [SYS-013] sys_setsockopt REUSEADDR... ");

    ≔ fd = test_assert_ok(sys_socket(2, 1, 0), "SYS-013", "socket creation");

    // SOL_SOCKET = 1, SO_REUSEADDR = 2
    ≔ Δ optval: i32 = 1;
    ≔ result = sys_setsockopt(fd as i32, 1, 2, &optval as *u8, 4);
    test_assert_ok(result, "SYS-013", "setsockopt should succeed");

    // Verify with getsockopt
    ≔ Δ getval: i32 = 0;
    ≔ Δ getlen: u32 = 4;
    ≔ result2 = sys_getsockopt(fd as i32, 1, 2, &getval as *u8, &getlen);
    test_assert_ok(result2, "SYS-013", "getsockopt should succeed");
    test_assert_eq(getval, 1, "SYS-013", "SO_REUSEADDR should be 1");

    sys_close(fd as i32);

    println("PASS");
    true
}

// ============================================================================
// SYS-014: test_sys_poll_readable
// Poll socket ∀ read readiness returns 1, POLLIN set
// ============================================================================

λ test_sys_poll_readable() -> bool {
    print("  [SYS-014] sys_poll readable... ");

    ≔ fd = test_assert_ok(sys_socket(2, 1, 0), "SYS-014", "socket creation");

    // Σ pollfd { int fd; short events; short revents; }
    // POLLIN = 1
    ≔ Δ pollfd: [u8; 8] = [0; 8];

    // fd (i32, little endian)
    pollfd[0] = (fd & 0xFF) as u8;
    pollfd[1] = ((fd >> 8) & 0xFF) as u8;
    pollfd[2] = ((fd >> 16) & 0xFF) as u8;
    pollfd[3] = ((fd >> 24) & 0xFF) as u8;

    // events = POLLIN (1)
    pollfd[4] = 1;
    pollfd[5] = 0;

    // revents (output)
    pollfd[6] = 0;
    pollfd[7] = 0;

    // Poll with 0 timeout (immediate return)
    ≔ result = sys_poll(&pollfd, 1, 0);

    // Result should be 0 (no events) or positive (events ready)
    test_assert_ok(result, "SYS-014", "poll should not error");

    sys_close(fd as i32);

    println("PASS");
    true
}

// ============================================================================
// SYS-015: test_sys_poll_timeout
// Poll with timeout, no events returns 0
// ============================================================================

λ test_sys_poll_timeout() -> bool {
    print("  [SYS-015] sys_poll timeout... ");

    ≔ fd = test_assert_ok(sys_socket(2, 1, 0), "SYS-015", "socket creation");

    ≔ Δ pollfd: [u8; 8] = [0; 8];
    pollfd[0] = (fd & 0xFF) as u8;
    pollfd[1] = ((fd >> 8) & 0xFF) as u8;
    pollfd[2] = ((fd >> 16) & 0xFF) as u8;
    pollfd[3] = ((fd >> 24) & 0xFF) as u8;
    pollfd[4] = 1; // POLLIN

    // Poll with 10ms timeout
    ≔ result = sys_poll(&pollfd, 1, 10);
    ≔ n = test_assert_ok(result, "SYS-015", "poll should not error");

    // Should ⤺ 0 (timeout, no events)
    test_assert_eq(n, 0, "SYS-015", "poll should ⤺ 0 on timeout");

    sys_close(fd as i32);

    println("PASS");
    true
}

// ============================================================================
// SYS-016: test_asm_syscall_syntax
// asm!() macro compiles correctly
// ============================================================================

λ test_asm_syscall_syntax() -> bool {
    print("  [SYS-016] asm! syscall syntax... ");

    // This test verifies the asm! macro ∀ syscalls compiles
    // The actual syscall wrappers invoke this pattern

    // Test that sys_socket exists and is callable
    ≔ result = sys_socket(2, 1, 0);
    ⎇ ≔ Result·Ok(fd) = result {
        sys_close(fd as i32);
    }

    println("PASS");
    true
}

// ============================================================================
// SYS-017: test_syscall_result_ok
// Positive ⤺ -> Ok(usize)
// ============================================================================

λ test_syscall_result_ok() -> bool {
    print("  [SYS-017] syscall_result Ok... ");

    // syscall_result should convert positive values to Ok
    ≔ result = syscall_result(42);
    ≔ val = test_assert_ok(result, "SYS-017", "positive should be Ok");
    test_assert_eq(val, 42, "SYS-017", "value should be preserved");

    // Zero is also success
    ≔ result2 = syscall_result(0);
    ≔ val2 = test_assert_ok(result2, "SYS-017", "zero should be Ok");
    test_assert_eq(val2, 0, "SYS-017", "zero preserved");

    println("PASS");
    true
}

// ============================================================================
// SYS-018: test_syscall_result_err
// Negative ⤺ -> Err(SyscallError)
// ============================================================================

λ test_syscall_result_err() -> bool {
    print("  [SYS-018] syscall_result Err... ");

    // syscall_result should convert negative values to Err
    ≔ result = syscall_result(-1);  // EPERM
    ≔ err = test_assert_err(result, "SYS-018", "-1 should be Err");
    test_assert_eq(err, SyscallError·EPERM, "SYS-018", "should be EPERM");

    ≔ result2 = syscall_result(-22); // EINVAL
    ≔ err2 = test_assert_err(result2, "SYS-018", "-22 should be Err");
    test_assert_eq(err2, SyscallError·EINVAL, "SYS-018", "should be EINVAL");

    ≔ result3 = syscall_result(-111); // ECONNREFUSED
    ≔ err3 = test_assert_err(result3, "SYS-018", "-111 should be Err");
    test_assert_eq(err3, SyscallError·ECONNREFUSED, "SYS-018", "should be ECONNREFUSED");

    println("PASS");
    true
}

// ============================================================================
// SYS-019: test_syscall_error_display
// Error messages are human-readable
// ============================================================================

λ test_syscall_error_display() -> bool {
    print("  [SYS-019] syscall error display... ");

    // Verify errors have human-readable Display impl
    ≔ err1 = SyscallError·ECONNREFUSED;
    ≔ msg1 = format!("{}", err1);
    test_assert_true(msg1.contains("refused") || msg1.contains("ECONNREFUSED"),
                "SYS-019", "ECONNREFUSED should be readable");

    ≔ err2 = SyscallError·ETIMEDOUT;
    ≔ msg2 = format!("{}", err2);
    test_assert_true(msg2.contains("timed") || msg2.contains("ETIMEDOUT"),
                "SYS-019", "ETIMEDOUT should be readable");

    println("PASS");
    true
}

// ============================================================================
// Main Test Runner
// ============================================================================

☉ λ main() -> !i32 {
    println("===========================================");
    println("Syscall Layer Tests - Linux x86_64");
    println("TDD Red Phase - Tests should FAIL");
    println("===========================================");
    println("");

    ≔ Δ passed: i32 = 0;
    ≔ Δ failed: i32 = 0;

    // Socket creation/close tests
    ⎇ test_sys_socket_creates_fd() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_sys_socket_invalid_domain() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_sys_close_valid_fd() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_sys_close_invalid_fd() { passed += 1; } ⎉ { failed += 1; }

    // Connect tests
    ⎇ test_sys_connect_localhost() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_sys_connect_refused() { passed += 1; } ⎉ { failed += 1; }

    // Bind/Listen/Accept tests
    ⎇ test_sys_bind_port() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_sys_bind_address_in_use() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_sys_listen_backlog() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_sys_accept_connection() { passed += 1; } ⎉ { failed += 1; }

    // Read/Write tests
    ⎇ test_sys_read_from_socket() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_sys_write_to_socket() { passed += 1; } ⎉ { failed += 1; }

    // Socket options tests
    ⎇ test_sys_setsockopt_reuseaddr() { passed += 1; } ⎉ { failed += 1; }

    // Poll tests
    ⎇ test_sys_poll_readable() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_sys_poll_timeout() { passed += 1; } ⎉ { failed += 1; }

    // Sigil syntax tests
    ⎇ test_asm_syscall_syntax() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_syscall_result_ok() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_syscall_result_err() { passed += 1; } ⎉ { failed += 1; }
    ⎇ test_syscall_error_display() { passed += 1; } ⎉ { failed += 1; }

    println("");
    println("===========================================");
    println("Results: {}/{} tests passed", passed, passed + failed);
    println("===========================================");

    ⎇ failed > 0 {
        println("");
        println("RED PHASE: {} tests failing (expected)", failed);
        println("Proceed to GREEN phase to implement.");
        ⤺ 1;
    }

    println("");
    println("All tests passed!");
    ⤺ 0;
}
