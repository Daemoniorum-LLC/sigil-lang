    let failed: i64 = 0;

    // Test 1: IPv4 parsing
    let r1 = test_parse_ipv4();
    if r1 != 0 {
        failed = failed + 1;
    }

    // Test 2: TCP create/close
    let r2 = test_tcp_create_close();
    if r2 != 0 {
        failed = failed + 1;
    }

    // Test 3: TCP connect refused
    let r3 = test_tcp_connect_refused();
    if r3 != 0 {
        failed = failed + 1;
    }

    // Test 4: UDP bind
    let r4 = test_udp_bind();
    if r4 != 0 {
        failed = failed + 1;
    }

    // Test 5: UDP loopback
    let r5 = test_udp_loopback();
    if r5 != 0 {
        failed = failed + 1;
    }

    // Test 6: TCP listener
    let r6 = test_tcp_listener();
    if r6 != 0 {
        failed = failed + 1;
    }

    // Return number of failures (0 = all passed)
    failed
}
