// WebSocket Echo Integration Test
// Connects to a real WebSocket echo server and verifies round-trip messaging
// Uses: syscalls -> socket -> TLS -> WebSocket protocol

// ============================================================================
// Linux x86_64 Syscall Numbers
// ============================================================================

const SYS_READ: i64 = 0;
const SYS_WRITE: i64 = 1;
const SYS_CLOSE: i64 = 3;
const SYS_POLL: i64 = 7;
const SYS_MMAP: i64 = 9;
const SYS_MUNMAP: i64 = 11;
const SYS_NANOSLEEP: i64 = 35;
const SYS_SOCKET: i64 = 41;
const SYS_CONNECT: i64 = 42;
const SYS_GETRANDOM: i64 = 318;

// Socket constants
const AF_INET: i64 = 2;
const SOCK_STREAM: i64 = 1;

// mmap flags
const PROT_READ: i64 = 1;
const PROT_WRITE: i64 = 2;
const MAP_PRIVATE: i64 = 2;
const MAP_ANONYMOUS: i64 = 32;

// ============================================================================
// Syscall Wrappers
// ============================================================================

λ syscall1(num: i64, arg1: i64) -> i64 {
    ≔ ret: i64 = 0;
    unsafe {
        asm!("syscall",
            inout("rax") num => ret,
            in("rdi") arg1,
            out("rcx") _,
            out("r11") _,
            options(nostack));
    }
    ret
}

λ syscall2(num: i64, arg1: i64, arg2: i64) -> i64 {
    ≔ ret: i64 = 0;
    unsafe {
        asm!("syscall",
            inout("rax") num => ret,
            in("rdi") arg1,
            in("rsi") arg2,
            out("rcx") _,
            out("r11") _,
            options(nostack));
    }
    ret
}

λ syscall3(num: i64, arg1: i64, arg2: i64, arg3: i64) -> i64 {
    ≔ ret: i64 = 0;
    unsafe {
        asm!("syscall",
            inout("rax") num => ret,
            in("rdi") arg1,
            in("rsi") arg2,
            in("rdx") arg3,
            out("rcx") _,
            out("r11") _,
            options(nostack));
    }
    ret
}

λ syscall6(num: i64, arg1: i64, arg2: i64, arg3: i64, arg4: i64, arg5: i64, arg6: i64) -> i64 {
    ≔ ret: i64 = 0;
    unsafe {
        asm!("syscall",
            inout("rax") num => ret,
            in("rdi") arg1,
            in("rsi") arg2,
            in("rdx") arg3,
            in("r10") arg4,
            in("r8") arg5,
            in("r9") arg6,
            out("rcx") _,
            out("r11") _,
            options(nostack));
    }
    ret
}

// ============================================================================
// Memory Allocation
// ============================================================================

λ alloc_mem(size: i64) -> i64 {
    syscall6(SYS_MMAP, 0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)
}

λ free_mem(ptr: i64, size: i64) {
    syscall2(SYS_MUNMAP, ptr, size);
}

// ============================================================================
// String/Memory Utilities
// ============================================================================

λ mem_copy(dst: i64, src: i64, len: i64) {
    ≔ i: i64 = 0;
    ⟳ i < len {
        ≔ byte: i64 = 0;
        unsafe {
            asm!("movzx rax, byte ptr [rdi]", in("rdi") src + i, out("rax") byte, options(nostack, readonly));
            asm!("mov byte ptr [rdi], al", in("rdi") dst + i, in("al") byte as i8, options(nostack));
        }
        i = i + 1;
    }
}

λ mem_set(dst: i64, val: i8, len: i64) {
    ≔ i: i64 = 0;
    ⟳ i < len {
        unsafe {
            asm!("mov byte ptr [rdi], al", in("rdi") dst + i, in("al") val, options(nostack));
        }
        i = i + 1;
    }
}

λ str_len(s: i64) -> i64 {
    ≔ len: i64 = 0;
    ≔ byte: i64 = 1;
    ⟳ byte != 0 {
        unsafe {
            asm!("movzx rax, byte ptr [rdi]", in("rdi") s + len, out("rax") byte, options(nostack, readonly));
        }
        ⎇ byte != 0 {
            len = len + 1;
        }
    }
    len
}

λ get_random_bytes(buf: i64, len: i64) -> i64 {
    syscall3(SYS_GETRANDOM, buf, len, 0)
}

λ sleep_ms(ms: i64) {
    ≔ ts = alloc_mem(16);
    ≔ secs = ms / 1000;
    ≔ nsecs = (ms % 1000) * 1000000;
    unsafe {
        asm!("mov [rdi], rax", in("rdi") ts, in("rax") secs, options(nostack));
        asm!("mov [rdi], rax", in("rdi") ts + 8, in("rax") nsecs, options(nostack));
    }
    syscall2(SYS_NANOSLEEP, ts, 0);
    free_mem(ts, 16);
}

// ============================================================================
// Output Utilities
// ============================================================================

λ write_stdout(s: i64, len: i64) {
    syscall3(SYS_WRITE, 1, s, len);
}

λ write_cstr(s: i64) {
    write_stdout(s, str_len(s));
}

λ write_newline() {
    ≔ nl = alloc_mem(8);
    unsafe { asm!("mov byte ptr [rdi], 10", in("rdi") nl, options(nostack)); }
    write_stdout(nl, 1);
    free_mem(nl, 8);
}

λ write_int(n: i64) {
    ≔ buf = alloc_mem(32);
    ≔ num = n;
    ≔ neg = 0;
    ⎇ num < 0 {
        neg = 1;
        num = 0 - num;
    }
    ≔ idx: i64 = 30;
    ⎇ num == 0 {
        unsafe { asm!("mov byte ptr [rdi], 0x30", in("rdi") buf + idx, options(nostack)); }
        idx = idx - 1;
    } ⎉ {
        ⟳ num > 0 {
            ≔ digit = (num % 10) + 48;
            unsafe { asm!("mov byte ptr [rdi], al", in("rdi") buf + idx, in("al") digit as i8, options(nostack)); }
            idx = idx - 1;
            num = num / 10;
        }
    }
    ⎇ neg == 1 {
        unsafe { asm!("mov byte ptr [rdi], 0x2d", in("rdi") buf + idx, options(nostack)); }
        idx = idx - 1;
    }
    write_stdout(buf + idx + 1, 30 - idx);
    free_mem(buf, 32);
}

// ============================================================================
// Socket Operations
// ============================================================================

λ socket_tcp_create() -> i64 {
    syscall3(SYS_SOCKET, AF_INET, SOCK_STREAM, 0)
}

λ socket_close(fd: i64) {
    syscall1(SYS_CLOSE, fd);
}

λ socket_poll_read(fd: i64, timeout_ms: i64) -> i64 {
    ≔ pollfd = alloc_mem(16);
    ⎇ pollfd < 0 { ⤺ -1; }
    unsafe {
        asm!("mov dword ptr [rdi], esi", in("rdi") pollfd, in("esi") fd as i32, options(nostack));
        asm!("mov word ptr [rdi], 1", in("rdi") pollfd + 4, options(nostack));
        asm!("mov word ptr [rdi], 0", in("rdi") pollfd + 6, options(nostack));
    }
    ≔ result = syscall3(SYS_POLL, pollfd, 1, timeout_ms);
    free_mem(pollfd, 16);
    result
}

λ socket_connect_ipv4(fd: i64, ip_packed: i64, port: i64) -> i64 {
    ≔ addr_buf = alloc_mem(32);
    ⎇ addr_buf < 0 { ⤺ -1; }
    mem_set(addr_buf, 0, 16);
    unsafe {
        asm!("mov word ptr [rdi], 2", in("rdi") addr_buf, options(nostack));
    }
    ≔ port_hi = (port >> 8) & 255;
    ≔ port_lo = port & 255;
    unsafe {
        asm!("mov byte ptr [rdi], al", in("rdi") addr_buf + 2, in("al") port_hi as i8, options(nostack));
        asm!("mov byte ptr [rdi], al", in("rdi") addr_buf + 3, in("al") port_lo as i8, options(nostack));
        asm!("mov dword ptr [rdi], eax", in("rdi") addr_buf + 4, in("eax") ip_packed as i32, options(nostack));
    }
    ≔ result = syscall3(SYS_CONNECT, fd, addr_buf, 16);
    free_mem(addr_buf, 32);
    result
}

// ============================================================================
// WebSocket Protocol
// ============================================================================

λ generate_fixed_ws_key(key_buf: i64) -> i64 {
    // Fixed 24-char base64 key: "dGhlIHNhbXBsZSBub25jZQ=="
    ≔ key: [i8; 24] = [
        100, 71, 104, 108, 73, 72, 78, 104, 98, 88, 66, 115,
        90, 83, 66, 117, 98, 50, 53, 106, 90, 81, 61, 61
    ];
    ≔ i: i64 = 0;
    ⟳ i < 24 {
        unsafe {
            asm!("mov byte ptr [rdi], al", in("rdi") key_buf + i, in("al") key[i as usize], options(nostack));
        }
        i = i + 1;
    }
    24
}

λ build_ws_handshake(host: i64, host_len: i64, path: i64, path_len: i64, key: i64, key_len: i64) -> i64 {
    ≔ total_len: i64 = 200 + host_len + path_len + key_len;
    ≔ req = alloc_mem(total_len);
    ⎇ req < 0 { ⤺ 0; }

    ≔ pos: i64 = 0;

    // "GET "
    unsafe {
        asm!("mov byte ptr [rdi], 71", in("rdi") req + pos, options(nostack));
        asm!("mov byte ptr [rdi], 69", in("rdi") req + pos + 1, options(nostack));
        asm!("mov byte ptr [rdi], 84", in("rdi") req + pos + 2, options(nostack));
        asm!("mov byte ptr [rdi], 32", in("rdi") req + pos + 3, options(nostack));
    }
    pos = pos + 4;

    // path
    mem_copy(req + pos, path, path_len);
    pos = pos + path_len;

    // " HTTP/1.1\r\n"
    ≔ http_ver: [i8; 11] = [32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10];
    ≔ i: i64 = 0;
    ⟳ i < 11 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") req + pos + i, in("al") http_ver[i as usize], options(nostack)); }
        i = i + 1;
    }
    pos = pos + 11;

    // "Host: "
    ≔ host_hdr: [i8; 6] = [72, 111, 115, 116, 58, 32];
    i = 0;
    ⟳ i < 6 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") req + pos + i, in("al") host_hdr[i as usize], options(nostack)); }
        i = i + 1;
    }
    pos = pos + 6;
    mem_copy(req + pos, host, host_len);
    pos = pos + host_len;
    unsafe {
        asm!("mov byte ptr [rdi], 13", in("rdi") req + pos, options(nostack));
        asm!("mov byte ptr [rdi], 10", in("rdi") req + pos + 1, options(nostack));
    }
    pos = pos + 2;

    // "Upgrade: websocket\r\n"
    ≔ upgrade: [i8; 20] = [85, 112, 103, 114, 97, 100, 101, 58, 32, 119, 101, 98, 115, 111, 99, 107, 101, 116, 13, 10];
    i = 0;
    ⟳ i < 20 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") req + pos + i, in("al") upgrade[i as usize], options(nostack)); }
        i = i + 1;
    }
    pos = pos + 20;

    // "Connection: Upgrade\r\n"
    ≔ conn: [i8; 21] = [67, 111, 110, 110, 101, 99, 116, 105, 111, 110, 58, 32, 85, 112, 103, 114, 97, 100, 101, 13, 10];
    i = 0;
    ⟳ i < 21 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") req + pos + i, in("al") conn[i as usize], options(nostack)); }
        i = i + 1;
    }
    pos = pos + 21;

    // "Sec-WebSocket-Key: "
    ≔ ws_key_hdr: [i8; 19] = [83, 101, 99, 45, 87, 101, 98, 83, 111, 99, 107, 101, 116, 45, 75, 101, 121, 58, 32];
    i = 0;
    ⟳ i < 19 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") req + pos + i, in("al") ws_key_hdr[i as usize], options(nostack)); }
        i = i + 1;
    }
    pos = pos + 19;
    mem_copy(req + pos, key, key_len);
    pos = pos + key_len;
    unsafe {
        asm!("mov byte ptr [rdi], 13", in("rdi") req + pos, options(nostack));
        asm!("mov byte ptr [rdi], 10", in("rdi") req + pos + 1, options(nostack));
    }
    pos = pos + 2;

    // "Sec-WebSocket-Version: 13\r\n"
    ≔ ws_ver: [i8; 27] = [83, 101, 99, 45, 87, 101, 98, 83, 111, 99, 107, 101, 116, 45, 86, 101, 114, 115, 105, 111, 110, 58, 32, 49, 51, 13, 10];
    i = 0;
    ⟳ i < 27 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") req + pos + i, in("al") ws_ver[i as usize], options(nostack)); }
        i = i + 1;
    }
    pos = pos + 27;

    // "\r\n"
    unsafe {
        asm!("mov byte ptr [rdi], 13", in("rdi") req + pos, options(nostack));
        asm!("mov byte ptr [rdi], 10", in("rdi") req + pos + 1, options(nostack));
        asm!("mov byte ptr [rdi], 0", in("rdi") req + pos + 2, options(nostack));
    }
    pos = pos + 2;

    req
}

λ ws_frame_text(payload: i64, payload_len: i64, output: i64) -> i64 {
    ≔ pos: i64 = 0;

    // FIN + opcode (text = 0x81)
    unsafe {
        asm!("mov byte ptr [rdi], 0x81", in("rdi") output + pos, options(nostack));
    }
    pos = pos + 1;

    // Length (with MASK bit set)
    ⎇ payload_len < 126 {
        ≔ len_byte = (payload_len | 128) as i8;
        unsafe {
            asm!("mov byte ptr [rdi], al", in("rdi") output + pos, in("al") len_byte, options(nostack));
        }
        pos = pos + 1;
    } ⎉ {
        unsafe {
            asm!("mov byte ptr [rdi], 0xfe", in("rdi") output + pos, options(nostack));
        }
        pos = pos + 1;
        ≔ len_hi = ((payload_len >> 8) & 255) as i8;
        ≔ len_lo = (payload_len & 255) as i8;
        unsafe {
            asm!("mov byte ptr [rdi], al", in("rdi") output + pos, in("al") len_hi, options(nostack));
            asm!("mov byte ptr [rdi], al", in("rdi") output + pos + 1, in("al") len_lo, options(nostack));
        }
        pos = pos + 2;
    }

    // Generate masking key
    ≔ mask = alloc_mem(4);
    get_random_bytes(mask, 4);

    ≔ m0: i64 = 0;
    ≔ m1: i64 = 0;
    ≔ m2: i64 = 0;
    ≔ m3: i64 = 0;
    unsafe {
        asm!("movzx rax, byte ptr [rdi]", in("rdi") mask, out("rax") m0, options(nostack, readonly));
        asm!("movzx rax, byte ptr [rdi]", in("rdi") mask + 1, out("rax") m1, options(nostack, readonly));
        asm!("movzx rax, byte ptr [rdi]", in("rdi") mask + 2, out("rax") m2, options(nostack, readonly));
        asm!("movzx rax, byte ptr [rdi]", in("rdi") mask + 3, out("rax") m3, options(nostack, readonly));
        asm!("mov byte ptr [rdi], al", in("rdi") output + pos, in("al") m0 as i8, options(nostack));
        asm!("mov byte ptr [rdi], al", in("rdi") output + pos + 1, in("al") m1 as i8, options(nostack));
        asm!("mov byte ptr [rdi], al", in("rdi") output + pos + 2, in("al") m2 as i8, options(nostack));
        asm!("mov byte ptr [rdi], al", in("rdi") output + pos + 3, in("al") m3 as i8, options(nostack));
    }
    pos = pos + 4;

    // Mask and copy payload
    ≔ i: i64 = 0;
    ⟳ i < payload_len {
        ≔ byte: i64 = 0;
        unsafe {
            asm!("movzx rax, byte ptr [rdi]", in("rdi") payload + i, out("rax") byte, options(nostack, readonly));
        }
        ≔ mask_idx = i % 4;
        ≔ mask_byte = m0;
        ⎇ mask_idx == 1 { mask_byte = m1; }
        ⎉ ⎇ mask_idx == 2 { mask_byte = m2; }
        ⎉ ⎇ mask_idx == 3 { mask_byte = m3; }
        ≔ masked = byte ^ mask_byte;
        unsafe {
            asm!("mov byte ptr [rdi], al", in("rdi") output + pos + i, in("al") masked as i8, options(nostack));
        }
        i = i + 1;
    }

    free_mem(mask, 4);
    pos + payload_len
}

λ check_ws_upgrade_response(data: i64, data_len: i64) -> i64 {
    // Check ∀ "HTTP/1.1 101"
    ⎇ data_len < 12 { ⤺ 0; }

    ≔ b0: i64 = 0;
    ≔ b9: i64 = 0;
    ≔ b10: i64 = 0;
    ≔ b11: i64 = 0;
    unsafe {
        asm!("movzx rax, byte ptr [rdi]", in("rdi") data, out("rax") b0, options(nostack, readonly));
        asm!("movzx rax, byte ptr [rdi]", in("rdi") data + 9, out("rax") b9, options(nostack, readonly));
        asm!("movzx rax, byte ptr [rdi]", in("rdi") data + 10, out("rax") b10, options(nostack, readonly));
        asm!("movzx rax, byte ptr [rdi]", in("rdi") data + 11, out("rax") b11, options(nostack, readonly));
    }

    ⎇ b0 == 72 && b9 == 49 && b10 == 48 && b11 == 49 {
        ⤺ 1;
    }
    0
}

λ ws_parse_frame_payload(data: i64, data_len: i64, payload_buf: i64) -> i64 {
    // Parse server frame (not masked) and extract payload
    ⎇ data_len < 2 { ⤺ -1; }

    ≔ b0: i64 = 0;
    ≔ b1: i64 = 0;
    unsafe {
        asm!("movzx rax, byte ptr [rdi]", in("rdi") data, out("rax") b0, options(nostack, readonly));
        asm!("movzx rax, byte ptr [rdi]", in("rdi") data + 1, out("rax") b1, options(nostack, readonly));
    }

    ≔ opcode = b0 & 15;
    ≔ payload_len = b1 & 127;
    ≔ header_len: i64 = 2;

    ⎇ payload_len == 126 {
        ⎇ data_len < 4 { ⤺ -1; }
        ≔ hi: i64 = 0;
        ≔ lo: i64 = 0;
        unsafe {
            asm!("movzx rax, byte ptr [rdi]", in("rdi") data + 2, out("rax") hi, options(nostack, readonly));
            asm!("movzx rax, byte ptr [rdi]", in("rdi") data + 3, out("rax") lo, options(nostack, readonly));
        }
        payload_len = (hi << 8) | lo;
        header_len = 4;
    }

    // Copy payload to output buffer
    mem_copy(payload_buf, data + header_len, payload_len);
    payload_len
}

// ============================================================================
// Integration Test: WebSocket Echo
// ============================================================================

λ write_line(chars: &[i8], len: i64) {
    ≔ buf = alloc_mem(128);
    ≔ i: i64 = 0;
    ⟳ i < len {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") buf + i, in("al") chars[i as usize], options(nostack)); }
        i = i + 1;
    }
    write_stdout(buf, len);
    free_mem(buf, 128);
}

λ test_ws_echo() -> i64 {
    // "WebSocket Echo Integration Test\n"
    ≔ h1: [i8; 33] = [87, 101, 98, 83, 111, 99, 107, 101, 116, 32, 69, 99, 104, 111, 32, 73, 110, 116, 101, 103, 114, 97, 116, 105, 111, 110, 32, 84, 101, 115, 116, 10, 10];
    write_line(&h1, 33);

    // websocket-echo.com - 198.12.65.76
    ≔ ip_packed: i64 = 198 | (12 << 8) | (65 << 16) | (76 << 24);
    ≔ port: i64 = 443;

    // "1. Creating TCP socket... "
    ≔ s1: [i8; 26] = [49, 46, 32, 67, 114, 101, 97, 116, 105, 110, 103, 32, 84, 67, 80, 32, 115, 111, 99, 107, 101, 116, 46, 46, 46, 32];
    write_line(&s1, 26);

    ≔ sockfd = socket_tcp_create();
    ⎇ sockfd < 0 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        ⤺ 0;
    }
    ≔ ok: [i8; 3] = [79, 75, 10];
    write_line(&ok, 3);

    // "2. Connecting... "
    ≔ s2: [i8; 17] = [50, 46, 32, 67, 111, 110, 110, 101, 99, 116, 105, 110, 103, 46, 46, 46, 32];
    write_line(&s2, 17);

    ≔ conn_result = socket_connect_ipv4(sockfd, ip_packed, port);
    ⎇ conn_result < 0 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        socket_close(sockfd);
        ⤺ 0;
    }
    write_line(&ok, 3);

    // "3. TLS setup... "
    ≔ s3: [i8; 16] = [51, 46, 32, 84, 76, 83, 32, 115, 101, 116, 117, 112, 46, 46, 46, 32];
    write_line(&s3, 16);

    sigil_tls_init();
    ≔ ctx = sigil_tls_ctx_new();
    ⎇ ctx == 0 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        socket_close(sockfd);
        ⤺ 0;
    }
    ≔ ssl = sigil_tls_new(ctx);
    ⎇ ssl == 0 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        sigil_tls_ctx_free(ctx);
        socket_close(sockfd);
        ⤺ 0;
    }
    write_line(&ok, 3);

    // "4. TLS handshake... "
    ≔ s4: [i8; 20] = [52, 46, 32, 84, 76, 83, 32, 104, 97, 110, 100, 115, 104, 97, 107, 101, 46, 46, 46, 32];
    write_line(&s4, 20);

    sigil_tls_set_fd(ssl, sockfd);

    // Hostname: "websocket-echo.com"
    ≔ hostname = alloc_mem(32);
    // "websocket-echo.com" = 18 chars
    ≔ hn: [i8; 18] = [119, 101, 98, 115, 111, 99, 107, 101, 116, 45, 101, 99, 104, 111, 46, 99, 111, 109];
    ≔ i: i64 = 0;
    ⟳ i < 18 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") hostname + i, in("al") hn[i as usize], options(nostack)); }
        i = i + 1;
    }
    unsafe { asm!("mov byte ptr [rdi], 0", in("rdi") hostname + 18, options(nostack)); }
    sigil_tls_set_hostname(ssl, hostname as *i8);

    ≔ tls_result = sigil_tls_connect(ssl);
    ⎇ tls_result != 1 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        free_mem(hostname, 32);
        sigil_tls_free(ssl);
        sigil_tls_ctx_free(ctx);
        socket_close(sockfd);
        ⤺ 0;
    }
    write_line(&ok, 3);

    // "5. WS handshake... "
    ≔ s5: [i8; 19] = [53, 46, 32, 87, 83, 32, 104, 97, 110, 100, 115, 104, 97, 107, 101, 46, 46, 46, 32];
    write_line(&s5, 19);

    // Path: "/"
    ≔ path = alloc_mem(8);
    ≔ path_chars: [i8; 1] = [47];  // just "/"
    i = 0;
    ⟳ i < 1 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") path + i, in("al") path_chars[i as usize], options(nostack)); }
        i = i + 1;
    }

    ≔ ws_key = alloc_mem(32);
    ≔ key_len = generate_fixed_ws_key(ws_key);

    ≔ ws_req = build_ws_handshake(hostname, 18, path, 1, ws_key, key_len);
    free_mem(ws_key, 32);
    free_mem(path, 8);

    ⎇ ws_req == 0 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        free_mem(hostname, 32);
        sigil_tls_shutdown(ssl);
        sigil_tls_free(ssl);
        sigil_tls_ctx_free(ctx);
        socket_close(sockfd);
        ⤺ 0;
    }

    ≔ req_len = str_len(ws_req);
    ≔ write_result = sigil_tls_write(ssl, ws_req as *i8, req_len);
    free_mem(ws_req, 300);

    ⎇ write_result <= 0 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        free_mem(hostname, 32);
        sigil_tls_shutdown(ssl);
        sigil_tls_free(ssl);
        sigil_tls_ctx_free(ctx);
        socket_close(sockfd);
        ⤺ 0;
    }

    // Read upgrade response
    socket_poll_read(sockfd, 5000);
    ≔ resp_buf = alloc_mem(1024);
    ≔ resp_len = sigil_tls_read(ssl, resp_buf as *i8, 1000);

    ⎇ resp_len <= 0 || check_ws_upgrade_response(resp_buf, resp_len) != 1 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        free_mem(resp_buf, 1024);
        free_mem(hostname, 32);
        sigil_tls_shutdown(ssl);
        sigil_tls_free(ssl);
        sigil_tls_ctx_free(ctx);
        socket_close(sockfd);
        ⤺ 0;
    }
    free_mem(resp_buf, 1024);
    // "OK (101)\n"
    ≔ ok101: [i8; 9] = [79, 75, 32, 40, 49, 48, 49, 41, 10];
    write_line(&ok101, 9);

    // "6. Sending message... "
    ≔ s6: [i8; 22] = [54, 46, 32, 83, 101, 110, 100, 105, 110, 103, 32, 109, 101, 115, 115, 97, 103, 101, 46, 46, 46, 32];
    write_line(&s6, 22);

    // Send "Hello, Sigil!"
    ≔ test_msg = alloc_mem(16);
    ≔ msg_chars: [i8; 13] = [72, 101, 108, 108, 111, 44, 32, 83, 105, 103, 105, 108, 33];
    i = 0;
    ⟳ i < 13 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") test_msg + i, in("al") msg_chars[i as usize], options(nostack)); }
        i = i + 1;
    }

    ≔ frame_buf = alloc_mem(64);
    ≔ frame_len = ws_frame_text(test_msg, 13, frame_buf);
    free_mem(test_msg, 16);

    ≔ send_result = sigil_tls_write(ssl, frame_buf as *i8, frame_len);
    free_mem(frame_buf, 64);

    ⎇ send_result <= 0 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        free_mem(hostname, 32);
        sigil_tls_shutdown(ssl);
        sigil_tls_free(ssl);
        sigil_tls_ctx_free(ctx);
        socket_close(sockfd);
        ⤺ 0;
    }
    write_line(&ok, 3);

    // "7. Receiving echo... "
    ≔ s7: [i8; 21] = [55, 46, 32, 82, 101, 99, 101, 105, 118, 105, 110, 103, 32, 101, 99, 104, 111, 46, 46, 46, 32];
    write_line(&s7, 21);

    // Wait ∀ echo
    socket_poll_read(sockfd, 5000);
    ≔ echo_buf = alloc_mem(256);
    ≔ echo_len = sigil_tls_read(ssl, echo_buf as *i8, 200);

    ⎇ echo_len <= 0 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        free_mem(echo_buf, 256);
        free_mem(hostname, 32);
        sigil_tls_shutdown(ssl);
        sigil_tls_free(ssl);
        sigil_tls_ctx_free(ctx);
        socket_close(sockfd);
        ⤺ 0;
    }

    // Parse WebSocket frame
    ≔ payload_buf = alloc_mem(64);
    ≔ payload_len = ws_parse_frame_payload(echo_buf, echo_len, payload_buf);
    free_mem(echo_buf, 256);

    // Verify echo matches "Hello, Sigil!"
    ≔ match_ok: i64 = 1;
    ⎇ payload_len == 13 {
        i = 0;
        ⟳ i < 13 {
            ≔ expected = msg_chars[i as usize] as i64;
            ≔ actual: i64 = 0;
            unsafe {
                asm!("movzx rax, byte ptr [rdi]", in("rdi") payload_buf + i, out("rax") actual, options(nostack, readonly));
            }
            ⎇ actual != expected {
                match_ok = 0;
            }
            i = i + 1;
        }
    } ⎉ {
        match_ok = 0;
    }
    free_mem(payload_buf, 64);

    ⎇ match_ok != 1 {
        ≔ f: [i8; 6] = [70, 65, 73, 76, 10, 0];
        write_line(&f, 5);
        free_mem(hostname, 32);
        sigil_tls_shutdown(ssl);
        sigil_tls_free(ssl);
        sigil_tls_ctx_free(ctx);
        socket_close(sockfd);
        ⤺ 0;
    }
    write_line(&ok, 3);

    // Cleanup
    free_mem(hostname, 32);
    sigil_tls_shutdown(ssl);
    sigil_tls_free(ssl);
    sigil_tls_ctx_free(ctx);
    socket_close(sockfd);

    // Print "8. PASSED\n" directly
    ≔ passed_buf = alloc_mem(16);
    unsafe {
        asm!("mov byte ptr [rdi], 56", in("rdi") passed_buf, options(nostack));      // 8
        asm!("mov byte ptr [rdi], 46", in("rdi") passed_buf + 1, options(nostack));  // .
        asm!("mov byte ptr [rdi], 32", in("rdi") passed_buf + 2, options(nostack));  // space
        asm!("mov byte ptr [rdi], 80", in("rdi") passed_buf + 3, options(nostack));  // P
        asm!("mov byte ptr [rdi], 65", in("rdi") passed_buf + 4, options(nostack));  // A
        asm!("mov byte ptr [rdi], 83", in("rdi") passed_buf + 5, options(nostack));  // S
        asm!("mov byte ptr [rdi], 83", in("rdi") passed_buf + 6, options(nostack));  // S
        asm!("mov byte ptr [rdi], 69", in("rdi") passed_buf + 7, options(nostack));  // E
        asm!("mov byte ptr [rdi], 68", in("rdi") passed_buf + 8, options(nostack));  // D
        asm!("mov byte ptr [rdi], 10", in("rdi") passed_buf + 9, options(nostack));  // newline
    }
    write_stdout(passed_buf, 10);
    free_mem(passed_buf, 16);
    1
}

// ============================================================================
// Main
// ============================================================================

λ main() -> i64 {
    ≔ result = test_ws_echo();
    ⎇ result == 1 { 0 } ⎉ { 1 }
}
