// ============================================================================
// Main Test Runner
// ============================================================================

pub fn main() -> !i32 {
    println("===========================================");
    println("TLS Layer Tests");
    println("TDD Red Phase - Tests should FAIL");
    println("===========================================");
    println("");

    let mut passed: i32 = 0;
    let mut failed: i32 = 0;

    println("--- OpenSSL FFI Tests ---");
    if test_ssl_library_init() { passed += 1; } else { failed += 1; }
    if test_ssl_ctx_new() { passed += 1; } else { failed += 1; }
    if test_ssl_ctx_free() { passed += 1; } else { failed += 1; }
    if test_ssl_new() { passed += 1; } else { failed += 1; }
    if test_ssl_set_fd() { passed += 1; } else { failed += 1; }
    if test_ssl_set_hostname() { passed += 1; } else { failed += 1; }
    if test_ssl_connect_google() { passed += 1; } else { failed += 1; }
    if test_ssl_read() { passed += 1; } else { failed += 1; }
    if test_ssl_write() { passed += 1; } else { failed += 1; }
    if test_ssl_shutdown() { passed += 1; } else { failed += 1; }
    if test_ssl_cert_verify_pass() { passed += 1; } else { failed += 1; }
    if test_ssl_cert_verify_fail() { passed += 1; } else { failed += 1; }
    if test_ssl_error_string() { passed += 1; } else { failed += 1; }

    println("");
    println("--- TlsStream Tests ---");
    if test_tls_stream_connect() { passed += 1; } else { failed += 1; }
    if test_tls_handshake_failed() { passed += 1; } else { failed += 1; }
    if test_tls_hostname_mismatch() { passed += 1; } else { failed += 1; }

    println("");
    println("===========================================");
    println("Results: {}/{} tests passed", passed, passed + failed);
    println("===========================================");

    if failed > 0 {
        println("");
        println("RED PHASE: {} tests failing (expected)", failed);
        return 1;
    }

    println("");
    println("All tests passed!");
    return 0;
}
