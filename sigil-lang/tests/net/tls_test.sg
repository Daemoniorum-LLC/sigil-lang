// ============================================================================
// TLS Stream Tests
// ============================================================================

// TLS-017: test_tls_stream_connect
fn test_tls_stream_connect() -> bool {
    print("  [TLS-017] TlsStream connect... ");

    // Try to connect to a real HTTPS server
    let addr = test_assert_ok(SocketAddr::parse("1.1.1.1:443"), "TLS-017", "parse addr");

    match TcpStream::connect(&addr) {
        Result::Ok(tcp) => {
            match TlsStream::connect(tcp, "one.one.one.one") {
                Result::Ok(mut tls) => {
                    test_assert_true(tls.is_connected(), "TLS-017", "should be connected");
                    let version = tls.protocol_version();
                    tls.close();
                    println("PASS ({})", version.unwrap_or("unknown".to_string()));
                }
                Result::Err(e) => {
                    println("SKIP (TLS: {})", e);
                }
            }
        }
        Result::Err(e) => {
            println("SKIP (TCP: {})", e);
        }
    }

    true
}

// TLS-021: test_tls_handshake_failed
fn test_tls_handshake_failed() -> bool {
    print("  [TLS-021] TLS handshake fail... ");

    // Connect to a non-TLS port
    let addr = test_assert_ok(SocketAddr::parse("127.0.0.1:80"), "TLS-021", "parse addr");

    match TcpStream::connect(&addr) {
        Result::Ok(tcp) => {
            match TlsStream::connect(tcp, "localhost") {
                Result::Ok(_) => {
                    println("FAIL: should have failed");
                    return false;
                }
                Result::Err(TlsError::HandshakeFailed { .. }) => {
                    println("PASS");
                }
                Result::Err(e) => {
                    println("PASS (error: {})", e);
                }
            }
        }
        Result::Err(_) => {
            // No HTTP server running
            println("SKIP (no server)");
        }
    }

    true
}

