//! TLS Layer Tests
//!
//! TDD Red Phase: Tests for TLS FFI and TlsStream
//!
//! Test IDs: TLS-001 through TLS-022
//! Spec: docs/specs/NATIVE-NETWORKING-SPEC.md Section 8

use stdlib::net::tls::*;
use stdlib::net::socket::{TcpStream, SocketAddr};

// ============================================================================
// Test Helpers
// ============================================================================

fn test_assert_ok<T, E: Display>(result: Result<T, E>, test_id: &str, msg: &str) -> T {
    match result {
        Result::Ok(v) => v,
        Result::Err(e) => panic(format!("[{}] FAIL: {} - got error: {}", test_id, msg, e)),
    }
}

fn test_assert_err<T, E>(result: Result<T, E>, test_id: &str, msg: &str) -> E {
    match result {
        Result::Ok(_) => panic(format!("[{}] FAIL: {} - expected error, got Ok", test_id, msg)),
        Result::Err(e) => e,
    }
}

fn test_assert_true(cond: bool, test_id: &str, msg: &str) {
    if !cond {
        panic(format!("[{}] FAIL: {}", test_id, msg));
    }
}

// ============================================================================
// TLS-001: test_ssl_library_init
// ============================================================================

fn test_ssl_library_init() -> bool {
    print("  [TLS-001] TLS library init... ");

    let result = tls_init();
    test_assert_ok(result, "TLS-001", "init");

    // Should be idempotent
    let result2 = tls_init();
    test_assert_ok(result2, "TLS-001", "second init");

    println("PASS");
    true
}

// ============================================================================
// TLS-002: test_ssl_ctx_new
// ============================================================================

fn test_ssl_ctx_new() -> bool {
    print("  [TLS-002] SSL context new... ");

    test_assert_ok(tls_init(), "TLS-002", "init");

    let ctx = test_assert_ok(ssl_ctx_new(), "TLS-002", "ctx_new");
    test_assert_true(ctx as usize != 0, "TLS-002", "ctx should not be null");

    ssl_ctx_free(ctx);

    println("PASS");
    true
}

// ============================================================================
// TLS-003: test_ssl_ctx_free
// ============================================================================

fn test_ssl_ctx_free() -> bool {
    print("  [TLS-003] SSL context free... ");

    test_assert_ok(tls_init(), "TLS-003", "init");

    let ctx = test_assert_ok(ssl_ctx_new(), "TLS-003", "ctx_new");
    ssl_ctx_free(ctx);

    // Should not crash when freeing again (we skip null)
    ssl_ctx_free(0 as *void);

    println("PASS");
    true
}

// ============================================================================
// TLS-004: test_ssl_new
// ============================================================================

fn test_ssl_new() -> bool {
    print("  [TLS-004] SSL new... ");

    test_assert_ok(tls_init(), "TLS-004", "init");

    let ctx = test_assert_ok(ssl_ctx_new(), "TLS-004", "ctx_new");
    let ssl = test_assert_ok(ssl_new(ctx), "TLS-004", "ssl_new");

    test_assert_true(ssl as usize != 0, "TLS-004", "ssl should not be null");

    ssl_free(ssl);
    ssl_ctx_free(ctx);

    println("PASS");
    true
}

// ============================================================================
// TLS-005: test_ssl_set_fd
// ============================================================================

fn test_ssl_set_fd() -> bool {
    print("  [TLS-005] SSL set fd... ");

    test_assert_ok(tls_init(), "TLS-005", "init");

    let ctx = test_assert_ok(ssl_ctx_new(), "TLS-005", "ctx_new");
    let ssl = test_assert_ok(ssl_new(ctx), "TLS-005", "ssl_new");

    // Create a socket to get a valid fd
    let addr = test_assert_ok(SocketAddr::parse("127.0.0.1:0"), "TLS-005", "parse addr");
    let fd = 3;  // Typically a valid fd number

    // This might fail if fd 3 isn't valid, but tests the interface
    match ssl_set_fd(ssl, fd) {
        Result::Ok(_) => {}
        Result::Err(_) => {
            // Expected if fd isn't valid
        }
    }

    ssl_free(ssl);
    ssl_ctx_free(ctx);

    println("PASS");
    true
}

// ============================================================================
// TLS-006: test_ssl_set_hostname
// ============================================================================

fn test_ssl_set_hostname() -> bool {
    print("  [TLS-006] SSL set hostname... ");

    test_assert_ok(tls_init(), "TLS-006", "init");

    let ctx = test_assert_ok(ssl_ctx_new(), "TLS-006", "ctx_new");
    let ssl = test_assert_ok(ssl_new(ctx), "TLS-006", "ssl_new");

    let result = ssl_set_hostname(ssl, "example.com");
    test_assert_ok(result, "TLS-006", "set_hostname");

    ssl_free(ssl);
    ssl_ctx_free(ctx);

    println("PASS");
    true
}

// ============================================================================
// TLS-007: test_ssl_connect_google
// (Network test)
// ============================================================================

fn test_ssl_connect_google() -> bool {
    print("  [TLS-007] TLS connect to google.com... ");

    // Connect TCP first
    let addr = test_assert_ok(SocketAddr::parse("142.250.80.46:443"), "TLS-007", "parse addr");

    match TcpStream::connect(&addr) {
        Result::Ok(tcp) => {
            match TlsStream::connect(tcp, "google.com") {
                Result::Ok(mut tls) => {
                    test_assert_true(tls.is_connected(), "TLS-007", "should be connected");
                    tls.close();
                    println("PASS");
                }
                Result::Err(e) => {
                    println("SKIP (TLS error: {})", e);
                }
            }
        }
        Result::Err(e) => {
            println("SKIP (TCP error: {})", e);
        }
    }

    true
}

