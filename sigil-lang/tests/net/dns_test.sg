// ============================================================================
// Main Test Runner
// ============================================================================

pub fn main() -> !i32 {
    println("===========================================");
    println("DNS Layer Tests");
    println("TDD Red Phase - Tests should FAIL");
    println("===========================================");
    println("");

    let mut passed: i32 = 0;
    let mut failed: i32 = 0;

    println("--- DNS Packet Tests ---");
    if test_dns_header_encode() { passed += 1; } else { failed += 1; }
    if test_dns_header_decode() { passed += 1; } else { failed += 1; }
    if test_dns_question_encode() { passed += 1; } else { failed += 1; }
    if test_dns_name_encode() { passed += 1; } else { failed += 1; }
    if test_dns_name_decode() { passed += 1; } else { failed += 1; }
    if test_dns_name_compression() { passed += 1; } else { failed += 1; }
    if test_dns_answer_decode_a() { passed += 1; } else { failed += 1; }
    if test_dns_answer_decode_aaaa() { passed += 1; } else { failed += 1; }
    if test_dns_packet_id_random() { passed += 1; } else { failed += 1; }
    if test_dns_response_truncated() { passed += 1; } else { failed += 1; }

    println("");
    println("--- DNS Resolver Tests ---");
    if test_resolver_system() { passed += 1; } else { failed += 1; }
    if test_resolver_custom() { passed += 1; } else { failed += 1; }
    if test_resolve_a_google() { passed += 1; } else { failed += 1; }
    if test_resolve_aaaa_google() { passed += 1; } else { failed += 1; }
    if test_resolve_nonexistent() { passed += 1; } else { failed += 1; }
    if test_resolve_timeout() { passed += 1; } else { failed += 1; }
    if test_resolve_caches_result() { passed += 1; } else { failed += 1; }

    println("");
    println("===========================================");
    println("Results: {}/{} tests passed", passed, passed + failed);
    println("===========================================");

    if failed > 0 {
        println("");
        println("RED PHASE: {} tests failing (expected)", failed);
        return 1;
    }

    println("");
    println("All tests passed!");
    return 0;
}
