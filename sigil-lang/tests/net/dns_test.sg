// ============================================================================
// DNS-010: test_dns_response_truncated
// ============================================================================

fn test_dns_response_truncated() -> bool {
    print("  [DNS-010] DNS truncated response... ");

    // Create header with TC flag set
    let buf: [u8; 12] = [
        0x00, 0x01,  // ID
        0x82, 0x00,  // Flags: QR=1, TC=1
        0x00, 0x01,
        0x00, 0x00,
        0x00, 0x00,
        0x00, 0x00,
    ];

    let header = test_assert_ok(DnsHeader::decode(&buf), "DNS-010", "decode");
    test_assert_true(header.is_truncated(), "DNS-010", "should be truncated");

    println("PASS");
    true
}

// ============================================================================
// DNS-011: test_resolver_system
// ============================================================================

fn test_resolver_system() -> bool {
    print("  [DNS-011] DnsResolver system... ");

    let resolver = test_assert_ok(DnsResolver::system(), "DNS-011", "create system resolver");

    // Should have at least one server (fallback to Google/Cloudflare DNS)
    test_assert_true(resolver.servers.len() > 0, "DNS-011", "should have servers");

    println("PASS");
    true
}

// ============================================================================
// DNS-012: test_resolver_custom
// ============================================================================

fn test_resolver_custom() -> bool {
    print("  [DNS-012] DnsResolver custom... ");

    let resolver = test_assert_ok(
        DnsResolver::new(&["1.1.1.1", "8.8.8.8:53"]),
        "DNS-012",
        "create custom resolver"
    );

    test_assert_eq(resolver.servers.len(), 2, "DNS-012", "server count");

    println("PASS");
    true
}

// ============================================================================
// DNS-013: test_resolve_a_google
// (Network test - may be skipped in CI)
// ============================================================================

fn test_resolve_a_google() -> bool {
    print("  [DNS-013] Resolve google.com A... ");

    let mut resolver = test_assert_ok(DnsResolver::system(), "DNS-013", "create resolver");

    match resolver.resolve_a("google.com") {
        Result::Ok(addrs) => {
            test_assert_true(!addrs.is_empty(), "DNS-013", "should return addresses");
            println("PASS ({} addresses)", addrs.len());
        }
        Result::Err(DnsError::QueryTimedOut) => {
            println("SKIP (timeout - no network?)");
        }
        Result::Err(e) => {
            println("FAIL: {}", e);
            return false;
        }
    }

    true
}

