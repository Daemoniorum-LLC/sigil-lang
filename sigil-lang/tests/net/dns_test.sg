//! DNS Layer Tests
//!
//! TDD Red Phase: Tests for DNS packet encoding/decoding and resolver
//!
//! Test IDs: DNS-001 through DNS-017
//! Spec: docs/specs/NATIVE-NETWORKING-SPEC.md Section 5

use stdlib::net::dns::*;
use stdlib::net::socket::IpAddr;

// ============================================================================
// Test Helpers
// ============================================================================

fn test_assert_eq<T: Eq + Display>(actual: T, expected: T, test_id: &str, msg: &str) {
    if actual != expected {
        panic(format!("[{}] FAIL: {} - expected {}, got {}", test_id, msg, expected, actual));
    }
}

fn test_assert_ok<T, E: Display>(result: Result<T, E>, test_id: &str, msg: &str) -> T {
    match result {
        Result::Ok(v) => v,
        Result::Err(e) => panic(format!("[{}] FAIL: {} - got error: {}", test_id, msg, e)),
    }
}

fn test_assert_err<T, E>(result: Result<T, E>, test_id: &str, msg: &str) -> E {
    match result {
        Result::Ok(_) => panic(format!("[{}] FAIL: {} - expected error, got Ok", test_id, msg)),
        Result::Err(e) => e,
    }
}

fn test_assert_true(cond: bool, test_id: &str, msg: &str) {
    if !cond {
        panic(format!("[{}] FAIL: {}", test_id, msg));
    }
}

// ============================================================================
// DNS-001: test_dns_header_encode
// ============================================================================

fn test_dns_header_encode() -> bool {
    print("  [DNS-001] DNS header encode... ");

    let header = DnsHeader::new_query(0x1234);
    let mut buf: [u8; 12] = [0; 12];
    let len = header.encode(&mut buf);

    test_assert_eq(len, 12, "DNS-001", "header length");

    // ID
    test_assert_eq(buf[0], 0x12, "DNS-001", "id high byte");
    test_assert_eq(buf[1], 0x34, "DNS-001", "id low byte");

    // Flags (RD set = 0x0100)
    test_assert_eq(buf[2], 0x01, "DNS-001", "flags high byte");
    test_assert_eq(buf[3], 0x00, "DNS-001", "flags low byte");

    // QDCOUNT = 1
    test_assert_eq(buf[4], 0x00, "DNS-001", "qdcount high");
    test_assert_eq(buf[5], 0x01, "DNS-001", "qdcount low");

    println("PASS");
    true
}

// ============================================================================
// DNS-002: test_dns_header_decode
// ============================================================================

fn test_dns_header_decode() -> bool {
    print("  [DNS-002] DNS header decode... ");

    // Create a response header
    let buf: [u8; 12] = [
        0x12, 0x34,  // ID
        0x81, 0x80,  // Flags: QR=1, RD=1, RA=1
        0x00, 0x01,  // QDCOUNT
        0x00, 0x02,  // ANCOUNT
        0x00, 0x00,  // NSCOUNT
        0x00, 0x00,  // ARCOUNT
    ];

    let header = test_assert_ok(DnsHeader::decode(&buf), "DNS-002", "decode");

    test_assert_eq(header.id, 0x1234, "DNS-002", "id");
    test_assert_true(header.is_response(), "DNS-002", "should be response");
    test_assert_eq(header.qdcount, 1, "DNS-002", "qdcount");
    test_assert_eq(header.ancount, 2, "DNS-002", "ancount");
    test_assert_eq(header.rcode(), 0, "DNS-002", "rcode");

    println("PASS");
    true
}

// ============================================================================
// DNS-003: test_dns_question_encode
// ============================================================================

fn test_dns_question_encode() -> bool {
    print("  [DNS-003] DNS question encode... ");

    let mut buf: [u8; 64] = [0; 64];

    // Encode "example.com"
    let pos = encode_name("example.com", &mut buf, 0);

    // Should be: 7, e, x, a, m, p, l, e, 3, c, o, m, 0
    test_assert_eq(buf[0], 7, "DNS-003", "label 1 length");
    test_assert_eq(buf[1], 'e' as u8, "DNS-003", "e");
    test_assert_eq(buf[7], 'e' as u8, "DNS-003", "second e");
    test_assert_eq(buf[8], 3, "DNS-003", "label 2 length");
    test_assert_eq(buf[9], 'c' as u8, "DNS-003", "c");
    test_assert_eq(buf[12], 0, "DNS-003", "null terminator");

    test_assert_eq(pos, 13, "DNS-003", "encoded length");

    println("PASS");
    true
}

// ============================================================================
// DNS-004: test_dns_name_encode
// ============================================================================

fn test_dns_name_encode() -> bool {
    print("  [DNS-004] DNS name encode... ");

    let mut buf: [u8; 64] = [0; 64];

    // Test single label
    let pos1 = encode_name("localhost", &mut buf, 0);
    test_assert_eq(buf[0], 9, "DNS-004", "localhost length");
    test_assert_eq(pos1, 11, "DNS-004", "localhost encoded length");

    // Test longer name
    let mut buf2: [u8; 64] = [0; 64];
    let pos2 = encode_name("www.example.com", &mut buf2, 0);
    test_assert_eq(buf2[0], 3, "DNS-004", "www length");
    test_assert_eq(buf2[4], 7, "DNS-004", "example length");

    println("PASS");
    true
}

// ============================================================================
// DNS-005: test_dns_name_decode
// ============================================================================

fn test_dns_name_decode() -> bool {
    print("  [DNS-005] DNS name decode... ");

    // Create encoded name: "example.com"
    let buf: [u8; 13] = [
        7, 'e' as u8, 'x' as u8, 'a' as u8, 'm' as u8, 'p' as u8, 'l' as u8, 'e' as u8,
        3, 'c' as u8, 'o' as u8, 'm' as u8,
        0
    ];

    let (name, pos) = test_assert_ok(decode_name(&buf, 0), "DNS-005", "decode");

    test_assert_eq(name.as_str(), "example.com", "DNS-005", "decoded name");
    test_assert_eq(pos, 13, "DNS-005", "position after name");

    println("PASS");
    true
}

// ============================================================================
// DNS-006: test_dns_name_compression
// ============================================================================

fn test_dns_name_compression() -> bool {
    print("  [DNS-006] DNS name compression... ");

    // Create packet with compression pointer
    // First name at offset 0: "example.com"
    // Second name at offset 13: pointer to offset 0
    let mut buf: [u8; 16] = [0; 16];
    buf[0] = 7;
    buf[1] = 'e' as u8;
    buf[2] = 'x' as u8;
    buf[3] = 'a' as u8;
    buf[4] = 'm' as u8;
    buf[5] = 'p' as u8;
    buf[6] = 'l' as u8;
    buf[7] = 'e' as u8;
    buf[8] = 3;
    buf[9] = 'c' as u8;
    buf[10] = 'o' as u8;
    buf[11] = 'm' as u8;
    buf[12] = 0;
    buf[13] = 0xC0;  // Compression pointer
    buf[14] = 0x00;  // Points to offset 0

    // Decode second name (with pointer)
    let (name, pos) = test_assert_ok(decode_name(&buf, 13), "DNS-006", "decode pointer");

    test_assert_eq(name.as_str(), "example.com", "DNS-006", "resolved name");
    test_assert_eq(pos, 15, "DNS-006", "position after pointer");

    println("PASS");
    true
}

