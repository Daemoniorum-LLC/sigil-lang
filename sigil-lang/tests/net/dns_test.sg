}

// ============================================================================
// DNS-015: test_resolve_nonexistent
// ============================================================================

fn test_resolve_nonexistent() -> bool {
    print("  [DNS-015] Resolve nonexistent.invalid... ");

    let mut resolver = test_assert_ok(DnsResolver::system(), "DNS-015", "create resolver");

    match resolver.resolve("nonexistent.invalid") {
        Result::Ok(_) => {
            println("FAIL: should not resolve");
            return false;
        }
        Result::Err(DnsError::NameNotFound) => {
            println("PASS");
        }
        Result::Err(DnsError::QueryTimedOut) => {
            println("SKIP (timeout)");
        }
        Result::Err(e) => {
            println("PASS (error: {})", e);
        }
    }

    true
}

// ============================================================================
// DNS-016: test_resolve_timeout
// ============================================================================

fn test_resolve_timeout() -> bool {
    print("  [DNS-016] DNS timeout... ");

    // Use an unreachable server
    let mut resolver = test_assert_ok(
        DnsResolver::new(&["192.0.2.1"]),  // TEST-NET-1, should be unreachable
        "DNS-016",
        "create resolver"
    );
    resolver.timeout_ms = 100;  // Very short timeout
    resolver.max_retries = 1;

    match resolver.resolve("example.com") {
        Result::Err(DnsError::QueryTimedOut) => {
            println("PASS");
        }
        Result::Err(e) => {
            println("PASS (error: {})", e);
        }
        Result::Ok(_) => {
            println("FAIL: should have timed out");
            return false;
        }
    }

    true
}

