// HTTP Connection Pooling Benchmark
// Compares multiple requests with and without connection reuse

const SYS_WRITE: i64 = 1;
const SYS_CLOSE: i64 = 3;
const SYS_MMAP: i64 = 9;
const SYS_MUNMAP: i64 = 11;
const SYS_SOCKET: i64 = 41;
const SYS_CONNECT: i64 = 42;
const SYS_CLOCK_GETTIME: i64 = 228;

const AF_INET: i64 = 2;
const SOCK_STREAM: i64 = 1;
const CLOCK_MONOTONIC: i64 = 1;
const PROT_READ: i64 = 1;
const PROT_WRITE: i64 = 2;
const MAP_PRIVATE: i64 = 2;
const MAP_ANONYMOUS: i64 = 32;

fn syscall1(num: i64, arg1: i64) -> i64 {
    let ret: i64 = 0;
    unsafe {
        asm!("syscall", inout("rax") num => ret, in("rdi") arg1,
            out("rcx") _, out("r11") _, options(nostack));
    }
    ret
}

fn syscall2(num: i64, arg1: i64, arg2: i64) -> i64 {
    let ret: i64 = 0;
    unsafe {
        asm!("syscall", inout("rax") num => ret, in("rdi") arg1, in("rsi") arg2,
            out("rcx") _, out("r11") _, options(nostack));
    }
    ret
}

fn syscall3(num: i64, arg1: i64, arg2: i64, arg3: i64) -> i64 {
    let ret: i64 = 0;
    unsafe {
        asm!("syscall", inout("rax") num => ret, in("rdi") arg1, in("rsi") arg2, in("rdx") arg3,
            out("rcx") _, out("r11") _, options(nostack));
    }
    ret
}

fn syscall6(num: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) -> i64 {
    let ret: i64 = 0;
    unsafe {
        asm!("syscall", inout("rax") num => ret, in("rdi") a1, in("rsi") a2, in("rdx") a3,
            in("r10") a4, in("r8") a5, in("r9") a6, out("rcx") _, out("r11") _, options(nostack));
    }
    ret
}

fn alloc_mem(size: i64) -> i64 {
    syscall6(SYS_MMAP, 0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)
}

fn free_mem(ptr: i64, size: i64) { syscall2(SYS_MUNMAP, ptr, size); }

fn mem_set(dst: i64, val: i8, len: i64) {
    let i: i64 = 0;
    while i < len {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") dst + i, in("al") val, options(nostack)); }
        i = i + 1;
    }
}

fn get_time_ns() -> i64 {
    let ts = alloc_mem(16);
    syscall2(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC, ts);
    let secs: i64 = 0;
    let nsecs: i64 = 0;
    unsafe {
        asm!("mov rax, [rdi]", in("rdi") ts, out("rax") secs, options(nostack, readonly));
        asm!("mov rax, [rdi]", in("rdi") ts + 8, out("rax") nsecs, options(nostack, readonly));
    }
    free_mem(ts, 16);
    secs * 1000000000 + nsecs
}

fn write_stdout(s: i64, len: i64) { syscall3(SYS_WRITE, 1, s, len); }

fn print_int(n: i64) {
    let buf = alloc_mem(32);
    let num = n;
    let idx: i64 = 30;
    if num == 0 {
        unsafe { asm!("mov byte ptr [rdi], 0x30", in("rdi") buf + idx, options(nostack)); }
        idx = idx - 1;
    } else {
        while num > 0 {
            let digit = (num % 10) + 48;
            unsafe { asm!("mov byte ptr [rdi], al", in("rdi") buf + idx, in("al") digit as i8, options(nostack)); }
            idx = idx - 1;
            num = num / 10;
        }
    }
    write_stdout(buf + idx + 1, 30 - idx);
    free_mem(buf, 32);
}

fn print_msg(chars: i64, len: i64) {
    let buf = alloc_mem(len + 1);
    let i: i64 = 0;
    while i < len {
        let c: i8 = 0;
        unsafe { asm!("mov al, [rdi]", in("rdi") chars + i, out("al") c, options(nostack, readonly)); }
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") buf + i, in("al") c, options(nostack)); }
        i = i + 1;
    }
    write_stdout(buf, len);
    free_mem(buf, len + 1);
}

fn socket_create() -> i64 { syscall3(SYS_SOCKET, AF_INET, SOCK_STREAM, 0) }
fn socket_close(fd: i64) { syscall1(SYS_CLOSE, fd); }

fn socket_connect(fd: i64, ip_packed: i64, port: i64) -> i64 {
    let addr_buf = alloc_mem(32);
    mem_set(addr_buf, 0, 16);
    unsafe { asm!("mov word ptr [rdi], 2", in("rdi") addr_buf, options(nostack)); }
    let port_hi = (port >> 8) & 255;
    let port_lo = port & 255;
    unsafe {
        asm!("mov byte ptr [rdi], al", in("rdi") addr_buf + 2, in("al") port_hi as i8, options(nostack));
        asm!("mov byte ptr [rdi], al", in("rdi") addr_buf + 3, in("al") port_lo as i8, options(nostack));
        asm!("mov dword ptr [rdi], eax", in("rdi") addr_buf + 4, in("eax") ip_packed as i32, options(nostack));
    }
    let result = syscall3(SYS_CONNECT, fd, addr_buf, 16);
    free_mem(addr_buf, 32);
    result
}

fn do_tls_handshake(fd: i64, hostname: i64) -> i64 {
    sigil_tls_init();
    let ctx = sigil_tls_ctx_new();
    let ssl = sigil_tls_new(ctx);
    sigil_tls_set_fd(ssl, fd);
    sigil_tls_set_hostname(ssl, hostname as *i8);
    let result = sigil_tls_connect(ssl);
    // Return ssl handle for reuse, or 0 on failure
    if result == 1 { ssl } else { 0 }
}

fn tls_shutdown_and_free(ssl: i64, ctx: i64) {
    sigil_tls_shutdown(ssl);
    sigil_tls_free(ssl);
    sigil_tls_ctx_free(ctx);
}

fn main() -> i64 {
    // Header
    let header = alloc_mem(64);
    let h: [i8; 30] = [61, 61, 61, 32, 80, 111, 111, 108, 105, 110, 103, 32, 66, 101, 110, 99, 104, 109, 97, 114, 107, 32, 61, 61, 61, 10, 0, 0, 0, 0];
    // "=== Pooling Benchmark ===\n"
    let i: i64 = 0;
    while i < 26 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") header + i, in("al") h[i as usize], options(nostack)); }
        i = i + 1;
    }
    write_stdout(header, 26);

    // example.com IP: 104.18.27.120
    let ip = 104 | (18 << 8) | (27 << 16) | (120 << 24);

    let hostname = alloc_mem(16);
    let hn: [i8; 11] = [101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109];
    i = 0;
    while i < 11 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") hostname + i, in("al") hn[i as usize], options(nostack)); }
        i = i + 1;
    }
    unsafe { asm!("mov byte ptr [rdi], 0", in("rdi") hostname + 11, options(nostack)); }

    // ==== Test 1: 3 separate connections (no pooling) ====
    // "No pooling (3 conns): "
    let np: [i8; 22] = [78, 111, 32, 112, 111, 111, 108, 105, 110, 103, 32, 40, 51, 32, 99, 111, 110, 110, 115, 41, 58, 32];
    i = 0;
    while i < 22 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") header + i, in("al") np[i as usize], options(nostack)); }
        i = i + 1;
    }
    write_stdout(header, 22);

    sigil_tls_init();

    let start1 = get_time_ns();

    // Connection 1
    let fd1 = socket_create();
    socket_connect(fd1, ip, 443);
    let ctx1 = sigil_tls_ctx_new();
    let ssl1 = sigil_tls_new(ctx1);
    sigil_tls_set_fd(ssl1, fd1);
    sigil_tls_set_hostname(ssl1, hostname as *i8);
    sigil_tls_connect(ssl1);
    sigil_tls_shutdown(ssl1);
    sigil_tls_free(ssl1);
    sigil_tls_ctx_free(ctx1);
    socket_close(fd1);

    // Connection 2
    let fd2 = socket_create();
    socket_connect(fd2, ip, 443);
    let ctx2 = sigil_tls_ctx_new();
    let ssl2 = sigil_tls_new(ctx2);
    sigil_tls_set_fd(ssl2, fd2);
    sigil_tls_set_hostname(ssl2, hostname as *i8);
    sigil_tls_connect(ssl2);
    sigil_tls_shutdown(ssl2);
    sigil_tls_free(ssl2);
    sigil_tls_ctx_free(ctx2);
    socket_close(fd2);

    // Connection 3
    let fd3 = socket_create();
    socket_connect(fd3, ip, 443);
    let ctx3 = sigil_tls_ctx_new();
    let ssl3 = sigil_tls_new(ctx3);
    sigil_tls_set_fd(ssl3, fd3);
    sigil_tls_set_hostname(ssl3, hostname as *i8);
    sigil_tls_connect(ssl3);
    sigil_tls_shutdown(ssl3);
    sigil_tls_free(ssl3);
    sigil_tls_ctx_free(ctx3);
    socket_close(fd3);

    let end1 = get_time_ns();
    let elapsed1_ms = (end1 - start1) / 1000000;
    print_int(elapsed1_ms);
    // " ms\n"
    let ms: [i8; 4] = [32, 109, 115, 10];
    i = 0;
    while i < 4 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") header + i, in("al") ms[i as usize], options(nostack)); }
        i = i + 1;
    }
    write_stdout(header, 4);

    // Brief pause
    let pause_start = get_time_ns();
    while get_time_ns() - pause_start < 100000000 { }

    // ==== Test 2: Single connection, reused (simulated pooling) ====
    // "With pooling (1 conn): "
    let wp: [i8; 23] = [87, 105, 116, 104, 32, 112, 111, 111, 108, 105, 110, 103, 32, 40, 49, 32, 99, 111, 110, 110, 41, 58, 32];
    i = 0;
    while i < 23 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") header + i, in("al") wp[i as usize], options(nostack)); }
        i = i + 1;
    }
    write_stdout(header, 23);

    let start2 = get_time_ns();

    // Single connection, reused for "3 requests"
    let fd = socket_create();
    socket_connect(fd, ip, 443);
    let ctx = sigil_tls_ctx_new();
    let ssl = sigil_tls_new(ctx);
    sigil_tls_set_fd(ssl, fd);
    sigil_tls_set_hostname(ssl, hostname as *i8);
    sigil_tls_connect(ssl);

    // Simulate 3 requests on same connection (just TLS overhead once)
    // In real pooling, we'd send HTTP requests here
    // For benchmark, we're measuring connection establishment cost

    sigil_tls_shutdown(ssl);
    sigil_tls_free(ssl);
    sigil_tls_ctx_free(ctx);
    socket_close(fd);

    let end2 = get_time_ns();
    let elapsed2_ms = (end2 - start2) / 1000000;
    print_int(elapsed2_ms);
    i = 0;
    while i < 4 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") header + i, in("al") ms[i as usize], options(nostack)); }
        i = i + 1;
    }
    write_stdout(header, 4);

    // Calculate savings
    // "Savings: "
    let sv: [i8; 9] = [83, 97, 118, 105, 110, 103, 115, 58, 32];
    i = 0;
    while i < 9 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") header + i, in("al") sv[i as usize], options(nostack)); }
        i = i + 1;
    }
    write_stdout(header, 9);

    let savings = elapsed1_ms - elapsed2_ms;
    print_int(savings);

    // " ms ("
    let msp: [i8; 5] = [32, 109, 115, 32, 40];
    i = 0;
    while i < 5 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") header + i, in("al") msp[i as usize], options(nostack)); }
        i = i + 1;
    }
    write_stdout(header, 5);

    // Calculate percentage
    if elapsed1_ms > 0 {
        let pct = (savings * 100) / elapsed1_ms;
        print_int(pct);
    }

    // "%)\n"
    let pctend: [i8; 3] = [37, 41, 10];
    i = 0;
    while i < 3 {
        unsafe { asm!("mov byte ptr [rdi], al", in("rdi") header + i, in("al") pctend[i as usize], options(nostack)); }
        i = i + 1;
    }
    write_stdout(header, 3);

    free_mem(hostname, 16);
    free_mem(header, 64);

    0
}
