// Basic inline assembly tests for Sigil LLVM backend
// Tests the implementation of Section 3.1 from NATIVE-NETWORKING-SPEC.md
// Returns 0 on success, non-zero on failure

fn main() -> i64 {
    // Test 1: Basic nop instruction
    unsafe {
        asm!("nop", options(nostack));
    }

    // Test 2: Output to register - get 42
    let result: i64 = 0;
    unsafe {
        asm!("mov rax, 42",
            out("rax") result,
            options(nostack));
    }
    if result != 42 {
        return 1;  // Fail: didn't get 42
    }

    // Test 3: Real syscall - getpid (syscall 39 on Linux x86_64)
    let pid: i64 = 0;
    unsafe {
        asm!("syscall",
            inout("rax") 39_i64 => pid,
            out("rcx") _,
            out("r11") _,
            options(nostack));
    }
    if pid <= 0 {
        return 2;  // Fail: getpid returned invalid value
    }

    // All tests passed
    0
}
