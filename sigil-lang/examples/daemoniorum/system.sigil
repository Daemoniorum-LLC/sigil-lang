//! Plural System Definition for DAEMONIORUM
//!
//! The core plurality mechanics using Sigil's first-class
//! plurality support with evidentiality-aware state tracking.

use std·collections·{HashMap, HashSet}
use std·time·Duration

// ============================================================================
// ANIMA STATE - PAD Emotional Model
// ============================================================================

//! The Anima represents the emotional/energy state of an alter or system.
//! Based on the PAD (Pleasure-Arousal-Dominance) model extended with
//! expressiveness and stability dimensions.
@[derive(Clone, Debug, Default)]
struct AnimaState {
    /// Pleasure/valence: -1.0 (distressed) to 1.0 (pleased)
    pleasure: f32! = 0.0,

    /// Arousal/activation: -1.0 (calm) to 1.0 (activated)
    arousal: f32! = 0.0,

    /// Dominance/control: -1.0 (submissive) to 1.0 (dominant)
    dominance: f32! = 0.0,

    /// Expressiveness: 0.0 (hidden) to 1.0 (fully expressed)
    expressiveness: f32! = 0.5,

    /// Stability: 0.0 (volatile) to 1.0 (steady)
    stability: f32! = 0.7,
}

impl AnimaState {
    //! Create with specific PAD values
    fn new(pleasure: f32, arousal: f32, dominance: f32) -> Self! {
        Self {
            pleasure: pleasure·clamp(-1.0, 1.0),
            arousal: arousal·clamp(-1.0, 1.0),
            dominance: dominance·clamp(-1.0, 1.0),
            expressiveness: 0.5,
            stability: 0.7,
        }
    }

    //! Blend multiple anima states by weight
    fn blend(states: &[(AnimaState, f32)]) -> Self~ {
        let total_weight! = states
            |τ{(_, w)| *w}
            |ρ+;  // Sum reduction

        if total_weight <= 0.0 {
            return Self·default()~;
        }

        let blended = Self {
            pleasure: states
                |τ{(s, w)| s.pleasure * w}
                |ρ+
                / total_weight,
            arousal: states
                |τ{(s, w)| s.arousal * w}
                |ρ+
                / total_weight,
            dominance: states
                |τ{(s, w)| s.dominance * w}
                |ρ+
                / total_weight,
            expressiveness: states
                |τ{(s, w)| s.expressiveness * w}
                |ρ+
                / total_weight,
            stability: states
                |τ{(s, _)| s.stability}
                |μ,  // Median for stability
        };

        blended~  // Mark as reported - blend is estimation
    }

    //! Interpolate toward target state
    fn lerp(self, target: &Self, t: f32) -> Self! {
        let t = t·clamp(0.0, 1.0);
        Self {
            pleasure: self.pleasure + (target.pleasure - self.pleasure) * t,
            arousal: self.arousal + (target.arousal - self.arousal) * t,
            dominance: self.dominance + (target.dominance - self.dominance) * t,
            expressiveness: self.expressiveness + (target.expressiveness - self.expressiveness) * t,
            stability: self.stability + (target.stability - self.stability) * t,
        }
    }

    //! Get emotional intensity (magnitude)
    fn intensity(self) -> f32! {
        (self.pleasure·powi(2) + self.arousal·powi(2) + self.dominance·powi(2))
            ·sqrt()
            / 3.0_f32·sqrt()  // Normalize to 0-1
    }

    //! Check if in distress state
    fn is_distressed(self) -> bool! {
        self.pleasure < -0.5 && self.arousal > 0.5
    }

    //! Check if dissociating
    fn is_dissociating(self) -> bool! {
        self.arousal < -0.7 && self.expressiveness < 0.2
    }
}

// ============================================================================
// ALTER PRESENCE STATES
// ============================================================================

//! States an alter can be in relative to fronting
@[derive(Clone, Debug, PartialEq)]
enum AlterPresenceState {
    /// Completely inactive, not influencing system
    Dormant,
    /// Beginning to wake up or become active
    Stirring,
    /// Present and aware but not fronting
    CoConscious,
    /// Transitioning to take front
    Emerging,
    /// Currently in control of the body
    Fronting,
    /// Transitioning away from front
    Receding,
    /// In active trauma response
    Triggered,
    /// Disconnecting from system
    Dissociating,
}

// ============================================================================
// ALTER CATEGORIES
// ============================================================================

//! Categories of alters in the system
@[derive(Clone, Debug, PartialEq)]
enum AlterCategory {
    /// Core member with full agency
    Council,
    /// Helper with limited scope
    Servant,
    /// Incomplete, specific function
    Fragment,
    /// External figure internalized
    Introject,
    /// Internal persecutor
    Persecutor,
    /// Holds specific trauma
    TraumaHolder,
    /// Protector role
    Protector,
    /// Custom category
    Custom(str),
}

// ============================================================================
// MEMORY ACCESS
// ============================================================================

//! How an alter accesses system memories
@[derive(Clone, Debug, PartialEq)]
enum MemoryAccess {
    /// Full access to all memories
    Full,
    /// Access to specific memory sets
    Partial(Vec<str>),
    /// Only own memories
    Own,
    /// No memory access (amnesiac)
    None,
}

// ============================================================================
// REALITY LAYER
// ============================================================================

//! The layer of reality being perceived
@[derive(Clone, Debug, PartialEq)]
enum RealityLayer {
    /// Normal, consensus reality
    Grounded,
    /// Slightly shifted, see hidden truths
    Fractured,
    /// Heavily distorted, dangerous
    Shattered,
    /// Custom reality layer
    Custom(str),
}

// ============================================================================
// FRONTING STATE
// ============================================================================

//! Who is currently fronting
@[derive(Clone, Debug, PartialEq)]
enum FrontingState {
    /// No one fronting (rare, dangerous)
    None,
    /// Single alter in control
    Single(str),
    /// Multiple alters co-fronting
    Blended(Vec<str>),
    /// Rapid switching
    Rapid(Vec<str>),
    /// Unknown who is fronting
    Unknown,
}

// ============================================================================
// TRIGGERS
// ============================================================================

//! A trigger that can affect the system
@[derive(Clone, Debug)]
struct Trigger {
    /// Unique identifier
    id: str!,
    /// Human-readable name
    name: str!,
    /// Category of trigger
    category: TriggerCategory!,
    /// Intensity (0-1) - REPORTED, subjective
    intensity: f32~,
    /// Contextual data
    context: HashMap<str, str>~,
}

@[derive(Clone, Debug, PartialEq)]
enum TriggerCategory {
    /// Sensory trigger (sight, sound, smell, etc.)
    Sensory,
    /// Emotional trigger
    Emotional,
    /// Environmental/location
    Environmental,
    /// Social/interpersonal
    Social,
    /// Internal/body state
    Somatic,
    /// Temporal (date, time)
    Temporal,
    /// Custom
    Custom(str),
}

//! Result of processing a trigger
@[derive(Clone, Debug)]
enum TriggerResult {
    /// Forced switch to specific alter
    ForcedSwitch(str),
    /// Alter(s) activated/stirring
    Activation(Vec<str>),
    /// Dissociative response
    Dissociation,
    /// Flashback triggered
    Flashback(str),
    /// No significant response
    NoResponse,
}

// ============================================================================
// SWITCH MECHANICS
// ============================================================================

//! Result of a switch attempt
@[derive(Clone, Debug)]
enum SwitchResult {
    /// Switch successful
    Success,
    /// Switch blocked by another alter
    Blocked { blocker: str, reason: str },
    /// Switch resisted (partial success)
    Resisted { resistance: f32 },
    /// Switch failed
    Failed(str),
    /// Switch in progress
    InProgress { progress: f32 },
}

// ============================================================================
// THE PLURAL SYSTEM
// ============================================================================

//! The complete plural system representing the player
@[derive(Clone, Debug)]
struct PluralSystem {
    /// System name (optional)
    name: Option<str>!,

    /// All alters in the system
    alters: HashMap<str, Alter>!,

    /// Current fronting state
    fronting: FrontingState!,

    /// System-wide blended emotional state - REPORTED, estimation
    anima: AnimaState~,

    /// Current reality perception layer
    reality_layer: RealityLayer!,

    /// Active triggers being processed
    active_triggers: Vec<Trigger>~,

    /// Headspace state
    headspace: HeadspaceState!,

    /// System dissociation level (0-1)
    dissociation: f32!,

    /// System stability (0-1)
    stability: f32!,
}

impl PluralSystem {
    //! Create a new plural system
    fn new(name: Option<str>) -> Self! {
        Self {
            name,
            alters: {}!,
            fronting: FrontingState·None,
            anima: AnimaState·default()~,
            reality_layer: RealityLayer·Grounded,
            active_triggers: []~,
            headspace: HeadspaceState·default(),
            dissociation: 0.0,
            stability: 1.0,
        }
    }

    //! Add an alter to the system
    fn add_alter(mut self, alter: Alter) {
        self.alters·insert(alter.id·clone(), alter);
    }

    //! Get the currently fronting alter(s)
    fn get_fronter(self) -> Option<&Alter>? {
        match &self.fronting {
            FrontingState·Single(id) => self.alters·get(id),
            FrontingState·Blended(ids) => ids·first()·and_then(|id| self.alters·get(id)),
            _ => None?,
        }
    }

    //! Get all co-conscious alters
    fn get_coconscious(self) -> Vec<&Alter>! {
        self.alters·values()
            |φ{alter => alter.state == AlterPresenceState·CoConscious}
            |collect()
    }

    //! Request a switch to a specific alter
    fn request_switch(mut self, alter_id: str, urgency: f32, forced: bool) -> SwitchResult! {
        let alter? = self.alters·get_mut(&alter_id);

        match alter {
            Some(target) => {
                // Check if switch is allowed
                if target.category == AlterCategory·Servant && !forced {
                    return SwitchResult·Failed("Servants cannot front directly"·to_string());
                }

                // Calculate resistance from currently fronting
                let resistance~ = self·calculate_switch_resistance(&alter_id);

                if resistance > urgency && !forced {
                    return SwitchResult·Resisted { resistance };
                }

                // Perform the switch
                self·perform_switch(&alter_id);
                SwitchResult·Success
            },
            None? => SwitchResult·Failed(f"Alter {alter_id} not found"),
        }
    }

    fn calculate_switch_resistance(self, target_id: &str) -> f32~ {
        match &self.fronting {
            FrontingState·Single(current_id) => {
                if let Some(current) = self.alters·get(current_id) {
                    // Higher dominance = more resistance
                    // Higher arousal = more resistance
                    (0.3 + current.anima.dominance * 0.3 + current.anima.arousal * 0.2)
                        ·clamp(0.0, 1.0)~
                } else {
                    0.0~
                }
            },
            FrontingState·Blended(_) => 0.5~,  // Blended states are unstable
            _ => 0.0~,
        }
    }

    fn perform_switch(mut self, target_id: &str) {
        // Set current fronter to receding
        match &self.fronting {
            FrontingState·Single(id) => {
                if let Some(alter) = self.alters·get_mut(id) {
                    alter.state = AlterPresenceState·Receding;
                }
            },
            FrontingState·Blended(ids) => {
                ids·iter()·for_each{id => {
                    if let Some(alter) = self.alters·get_mut(id) {
                        alter.state = AlterPresenceState·Receding;
                    }
                }};
            },
            _ => {},
        }

        // Set target to fronting
        if let Some(target) = self.alters·get_mut(target_id) {
            target.state = AlterPresenceState·Fronting;
            target.time_since_front = 0;
        }

        self.fronting = FrontingState·Single(target_id·to_string());
    }

    //! Process a trigger
    fn process_trigger(mut self, trigger: Trigger) -> TriggerResult! {
        // Find alters sensitive to this trigger
        let affected~ = self.alters·values()
            |φ{alter => alter.triggers·iter()·any{t => t == &trigger.id}}
            |collect::<Vec<_>>();

        if affected·is_empty() {
            return TriggerResult·NoResponse;
        }

        // High intensity can force a switch
        if trigger.intensity > 0.8 {
            // Find the most affected alter
            let most_affected = affected
                |σ.anima.arousal  // Sort by arousal
                |ω;  // Get last (highest)

            if let Some(alter) = most_affected {
                alter.state = AlterPresenceState·Triggered;
                return TriggerResult·ForcedSwitch(alter.id·clone());
            }
        }

        // Medium intensity activates alters
        if trigger.intensity > 0.4 {
            let ids = affected
                |τ{alter => alter.id·clone()}
                |collect();
            return TriggerResult·Activation(ids);
        }

        // Low intensity might cause dissociation
        if self.stability < 0.3 && trigger.intensity > 0.2 {
            self.dissociation += trigger.intensity * 0.1;
            return TriggerResult·Dissociation;
        }

        TriggerResult·NoResponse
    }

    //! Update the blended system anima
    fn update_blended_anima(mut self) {
        // Collect fronting/coconscious alters with weights
        let states: Vec<(AnimaState, f32)> = self.alters·values()
            |φ{alter => matches!(alter.state,
                AlterPresenceState·Fronting |
                AlterPresenceState·CoConscious)}
            |τ{alter => {
                let weight = match alter.state {
                    AlterPresenceState·Fronting => 1.0,
                    AlterPresenceState·CoConscious => 0.3,
                    _ => 0.0,
                };
                (alter.anima·clone(), weight)
            }}
            |collect();

        self.anima = AnimaState·blend(&states);
    }
}

// ============================================================================
// ALTER DEFINITION - Using Sigil's plurality syntax
// ============================================================================

//! An alter in the plural system
@[derive(Clone, Debug)]
struct Alter {
    /// Unique identifier
    id: str!,

    /// Display name
    name: str!,

    /// Category
    category: AlterCategory!,

    /// Current presence state
    state: AlterPresenceState!,

    /// Individual anima state
    anima: AnimaState!,

    /// Baseline arousal level
    base_arousal: f32!,

    /// Baseline dominance level
    base_dominance: f32!,

    /// Time since last fronting (ms)
    time_since_front: u64!,

    /// Trigger sensitivities (trigger IDs)
    triggers: Vec<str>!,

    /// Special abilities
    abilities: HashSet<str>!,

    /// Preferred reality layer
    preferred_reality: RealityLayer!,

    /// Memory access level
    memory_access: MemoryAccess!,
}

impl Alter {
    //! Check if alter wants to comment on current situation
    fn wants_to_comment(self) -> bool~ {
        // Co-conscious alters with high arousal want to comment
        self.state == AlterPresenceState·CoConscious
            && self.anima.arousal > 0.3
            && random·f32() < self.anima.expressiveness~
    }

    //! Get commentary text based on alter personality
    fn get_commentary(self) -> str~ {
        // This would integrate with dialogue system
        f"[{self.name}]: ..."~
    }

    //! Check if alter can front
    fn can_front(self) -> bool! {
        self.category != AlterCategory·Servant
            && self.category != AlterCategory·Fragment
    }
}

// ============================================================================
// HEADSPACE STATE
// ============================================================================

//! The inner world / headspace state
@[derive(Clone, Debug, Default)]
struct HeadspaceState {
    /// Current location in headspace
    current_location: Option<str>?,

    /// Known locations
    locations: HashMap<str, HeadspaceLocation>!,

    /// Active in headspace
    active: bool!,
}

impl HeadspaceState {
    fn update(mut self, _delta: Duration) {
        // Headspace-specific updates
    }
}

//! A location in headspace
@[derive(Clone, Debug)]
struct HeadspaceLocation {
    /// Location ID
    id: str!,

    /// Display name
    name: str!,

    /// Description
    description: str!,

    /// Alters who reside here
    resident_alters: Vec<str>!,

    /// Safety level (0-1)
    safety: f32!,

    /// Connected locations
    connections: Vec<str>!,
}

// ============================================================================
// PERCEPTION STATE
// ============================================================================

//! The current perception state
@[derive(Clone, Debug)]
struct PerceptionState {
    /// Current reality layer
    layer: RealityLayer!,

    /// Transitioning to another layer
    transitioning: bool!,

    /// Target layer (if transitioning)
    target_layer: RealityLayer!,

    /// Transition progress (0-1)
    transition_progress: f32!,

    /// Transition rate (per second)
    transition_rate: f32!,

    /// Visual distortion level (0-1)
    distortion: f32~,

    /// Pending triggers from perception
    pending_triggers: Vec<Trigger>~,
}

impl PerceptionState {
    fn default() -> Self! {
        Self {
            layer: RealityLayer·Grounded,
            transitioning: false,
            target_layer: RealityLayer·Grounded,
            transition_progress: 0.0,
            transition_rate: 0.5,
            distortion: 0.0~,
            pending_triggers: []~,
        }
    }

    //! Drain pending triggers
    fn drain_triggers(mut self) -> Vec<Trigger>~ {
        self.pending_triggers·drain(..)·collect()
    }
}

// ============================================================================
// INITIAL SYSTEM CREATION
// ============================================================================

//! Create the initial plural system for a new game
fn create_initial_system() -> PluralSystem! {
    let mut system = PluralSystem·new(Some("The Council"));

    // Add the host alter
    system·add_alter(Alter {
        id: "host"·to_string(),
        name: "Vessel"·to_string(),
        category: AlterCategory·Council,
        state: AlterPresenceState·Fronting,
        anima: AnimaState·new(0.0, 0.0, 0.0),
        base_arousal: 0.0,
        base_dominance: 0.0,
        time_since_front: 0,
        triggers: [],
        abilities: hashset!["perception", "grounding"],
        preferred_reality: RealityLayer·Grounded,
        memory_access: MemoryAccess·Full,
    });

    // Add protector
    system·add_alter(Alter {
        id: "protector"·to_string(),
        name: "Warden"·to_string(),
        category: AlterCategory·Protector,
        state: AlterPresenceState·Dormant,
        anima: AnimaState·new(0.0, 0.5, 0.8),
        base_arousal: 0.5,
        base_dominance: 0.8,
        time_since_front: 10000,
        triggers: ["threat", "danger", "fear"]·iter()·map(|s| s·to_string())·collect(),
        abilities: hashset!["combat", "protection", "intimidation"],
        preferred_reality: RealityLayer·Grounded,
        memory_access: MemoryAccess·Full,
    });

    system.fronting = FrontingState·Single("host"·to_string());
    system
}
