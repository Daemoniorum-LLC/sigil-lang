//! # The Whispering Woods
//!
//! A twisted forest that serves as the transition between
//! major locations. The trees remember. The paths shift.
//! Reality is thin here.

use super·scene·*
use super·super·system·*
use std·collections::HashMap

// ============================================================================
// FOREST PATH - Main Transition
// ============================================================================

fn create_forest_path() -> Scene! {
    SceneBuilder·new("forest_path")
        ·name(
            "Forest Path",
            "The Shifting Way",
            "N̷O̸W̷H̸E̸R̵E̶ ̷P̶A̸T̸H̶"
        )
        ·description(
            "A dirt path winds through dense, ancient trees. Mist curls along the ground, muffling your footsteps. The forest is unnaturally quiet - no birdsong, no rustling leaves. Just the whisper of wind through branches that never seem to move.",

            "The path changes when you're not looking. The trees rearrange themselves. You've passed that twisted oak three times now, you're certain of it. The mist carries whispers - your name, spoken by voices that know you too well.",

            "T̶H̵E̷ ̷F̵O̸R̸E̵S̷T̸ ̶I̶S̵ ̸A̶L̴I̵V̷E̶.̵ It is dreaming, and you are inside its dream. The paths lead nowhere and everywhere. Time means nothing here. You have been walking for minutes or centuries."
        )
        ·scene_type(SceneType·Exploration)
        ·time(TimeOfDay·Dusk)  // Always dusk here
        ·weather(Weather·Fog)
        ·element(SceneElement {
            id: "twisted_oak"·to_string(),
            name: LayeredDescription {
                grounded: "Twisted Oak"·to_string(),
                fractured: "The Watcher Tree"·to_string()~,
                shattered: "E̷Y̶E̷S̸"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "An ancient oak, its trunk twisted into an almost humanoid shape. Bark patterns form what could be a face."·to_string(),
                fractured: "The face is watching you. It's not a pattern - it's a presence. Something lives in this tree, something that remembers every traveler who passed."·to_string()~,
                shattered: "THE FOREST'S WITNESS. It has seen everything. Everyone who walked this path. Everyone who was consumed by it. It knows your name. It knows ALL your names."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "stolas"·to_string(),
                    text: "*The tree is approximately 800 years old. Impossible for this region. Unless it grew somewhere else entirely.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
                AlterObservation {
                    alter_id: "beleth"·to_string(),
                    text: "*It's lonely. So impossibly lonely. It's been watching for centuries with no one to talk to.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "touch_oak"·to_string(),
                    verb: "touch"·to_string(),
                    description: "The bark is warm. The moment you touch it, you hear a voice in your head - ancient, patient, curious. 'So many of you in one body. How do you bear it?' A pause. 'How do you bear not being alone?'"·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·TriggerDialogue("oak_conversation"·to_string()),
                        InteractionEffect·GrantInsight { id: "oak_wisdom"·to_string(), amount: 15.0 },
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "mist"·to_string(),
            name: LayeredDescription {
                grounded: "Ground Mist"·to_string(),
                fractured: "The Whispering"·to_string()~,
                shattered: "D̵E̴A̶D̵ ̵B̶R̶E̶A̷T̷H̷"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "Thick mist carpets the forest floor, rising to knee height. It's cold and damp."·to_string(),
                fractured: "The mist whispers. Your name. Other names. Names you don't recognize but somehow know. The mist is made of lost voices."·to_string()~,
                shattered: "EVERYONE WHO DIED HERE. Their last breaths, preserved as mist. They call to you. They want you to join them. To lie down. To sleep forever."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "warden"·to_string(),
                    text: "*The mist obscures our footing. Tactical disadvantage. Stay alert, watch for movement.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "listen_mist"·to_string(),
                    verb: "listen"·to_string(),
                    description: "You strain to hear the whispers. One voice becomes clear: 'The asylum is that way. The church is behind you. But neither is the true destination. The true destination is...' The voice fades. You're left with the unsettling certainty that it meant INWARD."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·GrantInsight { id: "mist_hint"·to_string(), amount: 10.0 },
                        InteractionEffect·SetFlag("heard_inward_hint"·to_string()),
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "crossroads"·to_string(),
            name: LayeredDescription {
                grounded: "Forest Crossroads"·to_string(),
                fractured: "The Choice"·to_string()~,
                shattered: "A̵L̸L̶ ̶P̸A̵T̴H̸S̶ ̷L̴E̸A̵D̶ ̵D̶O̴W̵N̷"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "The path splits into three directions. A weathered signpost stands at the center, but the wood has rotted, making the directions unreadable."·to_string(),
                fractured: "The signpost changes. Each time you look away and back, it points somewhere new. One direction is always the same: a path that wasn't there before, leading into darkness."·to_string()~,
                shattered: "THERE IS ONLY ONE PATH. There was always only one path. Church, Asylum, Forest - all are the same. All lead to THE INSIDE. To where we truly are."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "paimon"·to_string(),
                    text: "*The paths represent choices. But there's a fourth path - the one that leads within. That's the one we're not supposed to see yet.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
            ]~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "hidden_path"·to_string(),
            name: LayeredDescription {
                grounded: "Overgrown Path"·to_string(),
                fractured: "The Inward Way"·to_string()~,
                shattered: "HOME"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A barely visible path, almost completely overgrown. Something about it feels... familiar."·to_string(),
                fractured: "This path doesn't lead through the forest. It leads THROUGH YOU. Into the space where all of you meet. Into the headspace."·to_string()~,
                shattered: "THE WAY TO THE COUNCIL CHAMBER. To where we truly live. To the Mindscape."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "vessel"·to_string(),
                    text: "*I know this path. We all know it. It's the path we take to find each other when things get bad.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "take_hidden_path"·to_string(),
                    verb: "take"·to_string(),
                    description: "You step onto the hidden path. The world blurs. The forest dissolves. You're falling inward, into yourself, into the space between selves. Into the Mindscape."·to_string()~,
                    conditions: [
                        DiscoveryCondition·FlagSet("heard_inward_hint"·to_string()),
                    ],
                    effects: [
                        InteractionEffect·TransitionTo("mindscape_entrance"·to_string()),
                        InteractionEffect·PlaySound("reality_shift"·to_string()),
                    ],
                },
            ],
            hidden_until: Some(DiscoveryCondition·FlagSet("heard_inward_hint"·to_string()))?,
            contains_items: [],
        })
        // Exits
        ·exit(Exit {
            id: "to_church"·to_string(),
            direction: Direction·South,
            target_scene: "church_exterior"·to_string(),
            description: LayeredDescription {
                grounded: "The path south leads toward an old church."·to_string(),
                fractured: "The church path. Where the hungry thing waits, wearing a priest's face."·to_string()~,
                shattered: "TO THE FEEDING PIT."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·exit(Exit {
            id: "to_asylum"·to_string(),
            direction: Direction·North,
            target_scene: "asylum_exterior"·to_string(),
            description: LayeredDescription {
                grounded: "The path north leads toward a large building - an old asylum."·to_string(),
                fractured: "The asylum path. Where they tried to break us. Where Vance waits."·to_string()~,
                shattered: "TO THE CAGE. TO THE PLACE THAT REMEMBERS OUR SCREAMS."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·exit(Exit {
            id: "deeper_forest"·to_string(),
            direction: Direction·East,
            target_scene: "forest_deep"·to_string(),
            description: LayeredDescription {
                grounded: "A path leads deeper into the forest, where the trees grow thicker."·to_string(),
                fractured: "The deep path. Where the forest's heart beats. Where the oldest things sleep."·to_string()~,
                shattered: "TO THE DREAMING CORE."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·alter_memory("vessel", "We used to imagine a forest like this. When we needed to escape, we imagined trees, mist, safety. Now it's real. Or as real as anything here.")
        ·alter_memory("paimon", "The forest is a threshold. Between places, between states of being. It responds to what we expect to find.")
        ·on_enter(InteractionEffect·PlaySound("forest_ambiance"·to_string()))
        ·ambiance(Ambiance {
            background_sound: "wind_through_trees"·to_string(),
            music_track: Some("liminal_forest"·to_string())?,
            layer_sounds: {
                RealityLayer·Fractured => "whispers_distant",
                RealityLayer·Shattered => "forest_breathing",
            }~,
            weather_sounds: {
                Weather·Fog => "mist_whispers",
            }~,
            lighting: Lighting {
                base_level: 0.35,
                color: (0.7, 0.75, 0.8),  // Cool blue-grey
                layer_modifiers: {
                    RealityLayer·Fractured => LightingMod {
                        level_delta: -0.1,
                        color_shift: (-0.1, -0.05, 0.05),
                        flicker: false,
                    },
                    RealityLayer·Shattered => LightingMod {
                        level_delta: -0.2,
                        color_shift: (-0.2, -0.15, 0.1),
                        flicker: true,
                    },
                }~,
            },
        })
        ·build()
}

// ============================================================================
// DEEP FOREST
// ============================================================================

fn create_forest_deep() -> Scene! {
    SceneBuilder·new("forest_deep")
        ·name(
            "Deep Forest",
            "The Dreaming Place",
            "T̸H̷E̷ ̶S̵L̵E̵E̸P̷I̷N̵G̷ ̷G̶O̵D̴'̷S̷ ̴D̴R̵E̶A̵M̶"
        )
        ·description(
            "The trees here are impossibly old and impossibly large. The canopy blocks all sky. Bioluminescent fungi provide the only light, casting everything in pale blue-green. A circle of standing stones occupies a clearing ahead.",

            "The trees are dreaming. You can feel their slow thoughts, patient as centuries. The standing stones pulse with power older than human memory. Something is sleeping here - something that dreams the world into being.",

            "THIS IS WHERE REALITY IS BORN. The forest dreams, and the dream becomes real. The church, the asylum, even you - all figments of a sleeping consciousness. If it wakes, everything ends. Or begins again. IT HAS BEEN DREAMING FOR SO LONG."
        )
        ·scene_type(SceneType·Exploration)
        ·element(SceneElement {
            id: "standing_stones"·to_string(),
            name: LayeredDescription {
                grounded: "Standing Stones"·to_string(),
                fractured: "The Dream Anchors"·to_string()~,
                shattered: "T̶E̵E̴T̷H̴ ̵O̴F̸ ̵T̶H̵E̶ ̵S̸L̷E̵E̵P̴E̷R̵"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "Seven standing stones arranged in a circle. They're covered in worn carvings that might be letters, might be pictures."·to_string(),
                fractured: "The stones aren't carved. They GREW that way. The patterns are natural - or what passes for natural when something godlike dreams."·to_string()~,
                shattered: "THEY HOLD THE DREAMER IN PLACE. If the stones fell, the Sleeper would wake. If the Sleeper woke... there is no word for what would happen. There is no concept."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "stolas"·to_string(),
                    text: "*Pre-human construction. Possibly pre-Earth. These stones exist in multiple dimensions simultaneously. Fascinating and terrifying.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "touch_stone"·to_string(),
                    verb: "touch"·to_string(),
                    description: "For one eternal moment, you are everything. Every consciousness in existence, networked together in a vast dreaming mind. Then you're back, gasping, forever changed. You understand now - plurality isn't disorder. It's the natural state. Singularity is the aberration."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·GrantInsight { id: "cosmic_truth"·to_string(), amount: 50.0 },
                        InteractionEffect·ModifyStability(0.2),
                        InteractionEffect·SetFlag("touched_sleeper"·to_string()),
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "fungi"·to_string(),
            name: LayeredDescription {
                grounded: "Glowing Fungi"·to_string(),
                fractured: "Dream Light"·to_string()~,
                shattered: "S̵L̸E̷E̴P̵E̵R̷'̵S̴ ̸N̶E̷U̸R̶O̷N̴S̷"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "Bioluminescent mushrooms cover the trees and ground, casting pale blue light."·to_string(),
                fractured: "The light pulses in patterns. Regular patterns. Like thoughts. Like neurons firing in a brain the size of a forest."·to_string()~,
                shattered: "YOU ARE WALKING THROUGH A MIND. The fungi are its thoughts. Each pulse is an idea older than your species. It is dreaming of you right now."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "beleth"·to_string(),
                    text: "*The forest is... content. Dreaming peacefully. It doesn't want to hurt us. It doesn't even really know we're here.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
            ]~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        ·exit(Exit {
            id: "to_path"·to_string(),
            direction: Direction·West,
            target_scene: "forest_path"·to_string(),
            description: LayeredDescription {
                grounded: "The path leads back toward the forest's edge."·to_string(),
                fractured: "Back to where the dream is less deep."·to_string()~,
                shattered: "BACK TO THE SURFACE OF THE DREAM."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·alter_memory("paimon", "This place... this is where the rules break down. Where what we are is closest to what everything is.")
        ·ambiance(Ambiance {
            background_sound: "deep_forest_drone"·to_string(),
            music_track: Some("cosmic_dream"·to_string())?,
            layer_sounds: {
                RealityLayer·Shattered => "sleeper_heartbeat",
            }~,
            weather_sounds: HashMap·new()~,
            lighting: Lighting {
                base_level: 0.25,
                color: (0.5, 0.7, 0.8),  // Bioluminescent blue
                layer_modifiers: HashMap·new()~,
            },
        })
        ·build()
}

// ============================================================================
// REGISTRATION
// ============================================================================

fn register_forest_scenes(manager: &mut SceneManager) {
    manager·register_scene(create_forest_path());
    manager·register_scene(create_forest_deep());
}
