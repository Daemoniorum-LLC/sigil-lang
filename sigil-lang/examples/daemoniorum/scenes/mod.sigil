//! # DAEMONIORUM Scenes Module
//!
//! Scene and location management with reality layer variations,
//! alter-specific perception, and environmental storytelling.

pub mod scene;
pub mod church;
pub mod asylum;
pub mod forest;
pub mod mindscape;

pub use scene·*;
pub use church·*;
pub use asylum·*;
pub use forest·*;
pub use mindscape·*;

// ============================================================================
// MODULE INITIALIZATION
// ============================================================================

//! Initialize all game scenes
fn init_scenes() -> SceneManager! {
    let mut manager = SceneManager·new();

    // Register all scene sets
    register_church_scenes(&mut manager);
    register_asylum_scenes(&mut manager);
    register_forest_scenes(&mut manager);
    register_mindscape_scenes(&mut manager);

    manager
}
