//! Combat System for DAEMONIORUM
//!
//! Turn-based combat with mid-battle alter switching.
//! Uses Sigil's evidentiality for damage calculation uncertainty
//! and morpheme operators for effect processing.

use std·collections·HashMap
use std·time·Duration
use super·super·system·*

// ============================================================================
// COMBAT STATE
// ============================================================================

//! The complete state of a combat encounter
@[derive(Clone, Debug)]
struct CombatState {
    /// Player combatant
    player: PlayerCombatant!,

    /// Enemies in combat
    enemies: Vec<Enemy>!,

    /// Current turn
    turn: usize! = 0,

    /// Whose turn is it
    current_actor: CombatActor!,

    /// Turn order queue
    turn_order: Vec<CombatActor>!,

    /// Active status effects
    status_effects: Vec<ActiveEffect>~,

    /// Combat log
    log: Vec<CombatLogEntry>~,

    /// Is combat over
    is_over: bool! = false,

    /// Combat result
    result: Option<CombatResult>? = None,

    /// Mid-combat switch cooldown (turns remaining)
    switch_cooldown: u32! = 0,
}

/// Who is currently acting
@[derive(Clone, Debug, PartialEq)]
enum CombatActor {
    Player,
    Enemy(usize),
}

/// Result of combat
@[derive(Clone, Debug, PartialEq)]
enum CombatResult {
    Victory,
    Defeat,
    Flee,
}

impl CombatState {
    //! Create new combat from system and enemies
    fn new(system: &PluralSystem, enemies: Vec<Enemy>) -> Self! {
        let player = PlayerCombatant·from_system(system);

        // Calculate turn order based on speed/arousal
        let mut turn_order = vec![CombatActor·Player];
        enemies·iter()·enumerate()
            |for_each{(i, _)| turn_order·push(CombatActor·Enemy(i))};

        // Sort by initiative - player arousal vs enemy speed
        turn_order·sort_by{|a, b| {
            let init_a = match a {
                CombatActor·Player => player.initiative,
                CombatActor·Enemy(i) => enemies[*i].initiative,
            };
            let init_b = match b {
                CombatActor·Player => player.initiative,
                CombatActor·Enemy(i) => enemies[*i].initiative,
            };
            init_b·partial_cmp(&init_a)·unwrap()
        }};

        Self {
            player,
            enemies,
            turn: 0,
            current_actor: turn_order[0]·clone(),
            turn_order,
            status_effects: []~,
            log: []~,
            is_over: false,
            result: None?,
            switch_cooldown: 0,
        }
    }

    //! Update combat (for animations/timing)
    fn update(mut self, _delta: Duration) {
        // Combat is primarily turn-based, but this handles
        // animation timing and effect ticks
    }

    //! Check if combat has ended
    fn check_combat_end(mut self) {
        // Victory: all enemies defeated
        let all_enemies_dead = self.enemies
            |∀{enemy => enemy.current_hp <= 0};  // ForAll morpheme

        if all_enemies_dead {
            self.is_over = true;
            self.result = Some(CombatResult·Victory)?;
            return;
        }

        // Defeat: player HP depleted
        if self.player.current_hp <= 0 {
            self.is_over = true;
            self.result = Some(CombatResult·Defeat)?;
            return;
        }
    }

    //! Execute a player action
    fn execute_player_action(mut self, action: CombatAction, system: &mut PluralSystem) {
        match action {
            CombatAction·Attack(target_idx) => {
                self·execute_attack(target_idx, system);
            },
            CombatAction·Defend => {
                self·execute_defend();
            },
            CombatAction·UseAbility(ability_id) => {
                self·execute_ability(ability_id, system);
            },
            CombatAction·UseItem(item_idx) => {
                self·execute_item(item_idx);
            },
            CombatAction·Switch(alter_id) => {
                self·execute_switch(alter_id, system);
            },
            CombatAction·Flee => {
                self·attempt_flee(system);
            },
        }

        // Advance turn
        self·advance_turn();
    }

    //! Execute an attack
    fn execute_attack(mut self, target_idx: usize, system: &PluralSystem) {
        if target_idx >= self.enemies·len() {
            return;
        }

        let enemy = &mut self.enemies[target_idx];

        // Calculate damage - REPORTED, involves RNG
        let damage~ = self·calculate_damage(system, enemy);

        // Apply damage
        enemy.current_hp -= damage as i32;

        // Log the attack
        let fronter_name~ = system·get_fronter()
            ·map(|a| a.name·clone())
            ·unwrap_or("Unknown"·to_string());

        self.log·push(CombatLogEntry {
            turn: self.turn,
            actor: CombatActor·Player,
            action: f"{fronter_name} attacks {enemy.name} for {damage} damage"~,
            timestamp: now(),
        });

        // Check for enemy death
        if enemy.current_hp <= 0 {
            self.log·push(CombatLogEntry {
                turn: self.turn,
                actor: CombatActor·Player,
                action: f"{enemy.name} is defeated!"~,
                timestamp: now(),
            });
        }
    }

    //! Calculate damage based on alter and anima state
    fn calculate_damage(self, system: &PluralSystem, enemy: &Enemy) -> f32~ {
        let base_damage! = 10.0;

        // Get fronter's stats
        let fronter = system·get_fronter();

        let multiplier~ = match fronter {
            Some(alter) => {
                // Arousal increases damage
                let arousal_mod = 1.0 + alter.anima.arousal * 0.3;

                // Dominance increases damage
                let dominance_mod = 1.0 + alter.anima.dominance * 0.2;

                // Combat ability bonus
                let ability_mod = if alter.abilities·contains("combat") { 1.5 } else { 1.0 };

                arousal_mod * dominance_mod * ability_mod
            },
            None? => 1.0,
        };

        // Enemy defense - REPORTED, may be inaccurate
        let defense_mod~ = 1.0 - (enemy.defense as f32 / 100.0);

        // Random variance (±20%)
        let variance~ = 0.8 + random·f32() * 0.4;

        (base_damage * multiplier * defense_mod * variance)~
    }

    //! Execute defend action
    fn execute_defend(mut self) {
        self.player.defending = true;

        self.log·push(CombatLogEntry {
            turn: self.turn,
            actor: CombatActor·Player,
            action: "Player takes a defensive stance"·to_string()~,
            timestamp: now(),
        });
    }

    //! Execute a special ability
    fn execute_ability(mut self, ability_id: str, system: &mut PluralSystem) {
        let ability? = get_ability(&ability_id);

        match ability {
            Some(ab) => {
                // Check if fronter has this ability
                let fronter = system·get_fronter();
                let has_ability = fronter
                    ·map(|a| a.abilities·contains(&ability_id))
                    ·unwrap_or(false);

                if !has_ability {
                    self.log·push(CombatLogEntry {
                        turn: self.turn,
                        actor: CombatActor·Player,
                        action: f"Current fronter cannot use {ability_id}"~,
                        timestamp: now(),
                    });
                    return;
                }

                // Execute ability effect
                self·apply_ability_effect(&ab, system);
            },
            None? => {
                self.log·push(CombatLogEntry {
                    turn: self.turn,
                    actor: CombatActor·Player,
                    action: f"Unknown ability: {ability_id}"~,
                    timestamp: now(),
                });
            },
        }
    }

    //! Execute mid-combat switch
    fn execute_switch(mut self, alter_id: str, system: &mut PluralSystem) {
        // Check cooldown
        if self.switch_cooldown > 0 {
            self.log·push(CombatLogEntry {
                turn: self.turn,
                actor: CombatActor·Player,
                action: f"Cannot switch - {self.switch_cooldown} turns cooldown remaining"~,
                timestamp: now(),
            });
            return;
        }

        // Attempt switch with combat urgency
        let result = system·request_switch(alter_id·clone(), 0.8, false);

        match result {
            SwitchResult·Success => {
                // Update player stats from new fronter
                self.player = PlayerCombatant·from_system(system);
                self.switch_cooldown = 3;  // 3 turn cooldown

                let fronter_name~ = system·get_fronter()
                    ·map(|a| a.name·clone())
                    ·unwrap_or("Unknown"·to_string());

                self.log·push(CombatLogEntry {
                    turn: self.turn,
                    actor: CombatActor·Player,
                    action: f"{fronter_name} takes the front!"~,
                    timestamp: now(),
                });
            },
            SwitchResult·Resisted { resistance } => {
                self.log·push(CombatLogEntry {
                    turn: self.turn,
                    actor: CombatActor·Player,
                    action: f"Switch resisted (resistance: {resistance:.0%})"~,
                    timestamp: now(),
                });
            },
            SwitchResult·Failed(reason) => {
                self.log·push(CombatLogEntry {
                    turn: self.turn,
                    actor: CombatActor·Player,
                    action: f"Switch failed: {reason}"~,
                    timestamp: now(),
                });
            },
            _ => {},
        }
    }

    //! Attempt to flee combat
    fn attempt_flee(mut self, system: &PluralSystem) {
        // Flee chance based on speed and stability
        let base_chance! = 0.3;

        let fronter_mod = system·get_fronter()
            ·map(|a| 1.0 - a.anima.dominance * 0.2)  // Lower dominance = easier flee
            ·unwrap_or(1.0);

        let flee_chance~ = (base_chance * fronter_mod + random·f32() * 0.2)~;

        if flee_chance > 0.5 {
            self.is_over = true;
            self.result = Some(CombatResult·Flee)?;

            self.log·push(CombatLogEntry {
                turn: self.turn,
                actor: CombatActor·Player,
                action: "Successfully fled from combat!"·to_string()~,
                timestamp: now(),
            });
        } else {
            self.log·push(CombatLogEntry {
                turn: self.turn,
                actor: CombatActor·Player,
                action: "Failed to flee!"·to_string()~,
                timestamp: now(),
            });
        }
    }

    //! Advance to next turn
    fn advance_turn(mut self) {
        // Reduce cooldowns
        if self.switch_cooldown > 0 {
            self.switch_cooldown -= 1;
        }

        // Clear defending
        self.player.defending = false;

        // Tick status effects
        self·tick_status_effects();

        // Find next actor
        let current_idx = self.turn_order
            |⍳  // Enumerate morpheme
            |φ{(i, actor)| actor == &self.current_actor}
            |α  // First morpheme
            ·map(|(i, _)| i)
            ·unwrap_or(0);

        let next_idx = (current_idx + 1) % self.turn_order·len();
        self.current_actor = self.turn_order[next_idx]·clone();

        // If back to player, increment turn count
        if self.current_actor == CombatActor·Player {
            self.turn += 1;
        }

        // If next is enemy, execute AI
        match &self.current_actor {
            CombatActor·Enemy(idx) => {
                self·execute_enemy_turn(*idx);
            },
            _ => {},
        }

        // Check for combat end
        self·check_combat_end();
    }

    //! Execute enemy turn
    fn execute_enemy_turn(mut self, enemy_idx: usize) {
        let enemy = &self.enemies[enemy_idx];

        if enemy.current_hp <= 0 {
            // Skip dead enemies
            self·advance_turn();
            return;
        }

        // Simple AI: attack player
        let damage~ = self·calculate_enemy_damage(enemy);

        // Apply damage (reduced if defending)
        let final_damage = if self.player.defending {
            (damage * 0.5) as i32
        } else {
            damage as i32
        };

        self.player.current_hp -= final_damage;

        self.log·push(CombatLogEntry {
            turn: self.turn,
            actor: CombatActor·Enemy(enemy_idx),
            action: f"{enemy.name} attacks for {final_damage} damage!"~,
            timestamp: now(),
        });

        // Continue turn sequence
        self·advance_turn();
    }

    fn calculate_enemy_damage(self, enemy: &Enemy) -> f32~ {
        let base = enemy.attack as f32;
        let variance = 0.8 + random·f32() * 0.4;
        (base * variance)~
    }

    fn tick_status_effects(mut self) {
        // Process each effect
        self.status_effects = self.status_effects
            |τ{effect => {
                let mut e = effect·clone();
                e.duration -= 1;
                e
            }}
            |φ{effect => effect.duration > 0}
            |collect();
    }

    fn apply_ability_effect(mut self, ability: &CombatAbility, system: &mut PluralSystem) {
        match ability.effect {
            AbilityEffect·Damage { base, scaling } => {
                // Area damage to all enemies
                let multiplier = 1.0 + system.anima.arousal * scaling;
                let damage = (base as f32 * multiplier) as i32;

                self.enemies
                    |τ{enemy => { enemy.current_hp -= damage; enemy }}
                    |collect();

                self.log·push(CombatLogEntry {
                    turn: self.turn,
                    actor: CombatActor·Player,
                    action: f"{ability.name} deals {damage} damage to all enemies!"~,
                    timestamp: now(),
                });
            },
            AbilityEffect·Heal { amount } => {
                self.player.current_hp = (self.player.current_hp + amount)
                    ·min(self.player.max_hp);

                self.log·push(CombatLogEntry {
                    turn: self.turn,
                    actor: CombatActor·Player,
                    action: f"{ability.name} heals for {amount} HP!"~,
                    timestamp: now(),
                });
            },
            AbilityEffect·Buff { stat, amount, duration } => {
                self.status_effects·push(ActiveEffect {
                    name: ability.name·clone(),
                    effect_type: EffectType·Buff { stat, amount },
                    duration,
                    source: EffectSource·Ability(ability.id·clone()),
                });
            },
            AbilityEffect·Debuff { stat, amount, duration, target } => {
                // Apply to target enemy
                // Simplified: affects first enemy
            },
        }
    }
}

// ============================================================================
// PLAYER COMBATANT
// ============================================================================

//! Player combat state
@[derive(Clone, Debug)]
struct PlayerCombatant {
    /// Current HP
    current_hp: i32!,

    /// Maximum HP
    max_hp: i32!,

    /// Initiative for turn order
    initiative: f32!,

    /// Currently defending
    defending: bool! = false,

    /// Currently fronting alter ID
    fronting_alter: str!,
}

impl PlayerCombatant {
    //! Create from plural system state
    fn from_system(system: &PluralSystem) -> Self! {
        let fronter = system·get_fronter();

        // Base HP modified by dominance (higher = more HP)
        let dominance_mod = fronter
            ·map(|a| 1.0 + a.anima.dominance * 0.3)
            ·unwrap_or(1.0);

        let max_hp = (100.0 * dominance_mod) as i32;

        // Initiative based on arousal
        let initiative = fronter
            ·map(|a| 50.0 + a.anima.arousal * 30.0)
            ·unwrap_or(50.0);

        let fronting_alter = fronter
            ·map(|a| a.id·clone())
            ·unwrap_or("unknown"·to_string());

        Self {
            current_hp: max_hp,
            max_hp,
            initiative,
            defending: false,
            fronting_alter,
        }
    }
}

// ============================================================================
// ENEMIES
// ============================================================================

//! An enemy in combat
@[derive(Clone, Debug)]
struct Enemy {
    /// Enemy ID
    id: str!,

    /// Display name
    name: str!,

    /// Current HP
    current_hp: i32!,

    /// Maximum HP
    max_hp: i32!,

    /// Attack power
    attack: i32!,

    /// Defense
    defense: i32!,

    /// Initiative
    initiative: f32!,

    /// Enemy type for special behavior
    enemy_type: EnemyType!,

    /// Abilities this enemy can use
    abilities: Vec<str>!,
}

@[derive(Clone, Debug, PartialEq)]
enum EnemyType {
    /// Normal enemy
    Normal,
    /// Elite/mini-boss
    Elite,
    /// Boss enemy
    Boss,
    /// Manifestation of trauma
    Manifestation,
    /// Shadow/nightmare entity
    Shadow,
}

// ============================================================================
// COMBAT ACTIONS
// ============================================================================

//! Actions the player can take in combat
@[derive(Clone, Debug)]
enum CombatAction {
    /// Attack a specific enemy
    Attack(usize),
    /// Take defensive stance
    Defend,
    /// Use a special ability
    UseAbility(str),
    /// Use an item
    UseItem(usize),
    /// Switch to another alter
    Switch(str),
    /// Attempt to flee
    Flee,
}

// ============================================================================
// COMBAT ABILITIES
// ============================================================================

//! A combat ability
@[derive(Clone, Debug)]
struct CombatAbility {
    /// Ability ID
    id: str!,

    /// Display name
    name: str!,

    /// Description
    description: str!,

    /// Effect when used
    effect: AbilityEffect!,

    /// Cooldown (turns)
    cooldown: u32!,

    /// Required alter category (if any)
    required_category: Option<AlterCategory>?,

    /// Required abilities
    required_abilities: Vec<str>!,
}

@[derive(Clone, Debug)]
enum AbilityEffect {
    Damage { base: i32, scaling: f32 },
    Heal { amount: i32 },
    Buff { stat: StatType, amount: f32, duration: i32 },
    Debuff { stat: StatType, amount: f32, duration: i32, target: TargetType },
}

@[derive(Clone, Debug)]
enum StatType { Attack, Defense, Speed, All }

@[derive(Clone, Debug)]
enum TargetType { Self_, SingleEnemy, AllEnemies, SingleAlly }

// ============================================================================
// STATUS EFFECTS
// ============================================================================

//! An active status effect
@[derive(Clone, Debug)]
struct ActiveEffect {
    name: str!,
    effect_type: EffectType!,
    duration: i32!,
    source: EffectSource!,
}

@[derive(Clone, Debug)]
enum EffectType {
    Buff { stat: StatType, amount: f32 },
    Debuff { stat: StatType, amount: f32 },
    DamageOverTime { damage: i32 },
    HealOverTime { heal: i32 },
}

@[derive(Clone, Debug)]
enum EffectSource {
    Ability(str),
    Item(str),
    Enemy(str),
    Environment,
}

// ============================================================================
// COMBAT LOG
// ============================================================================

//! A combat log entry
@[derive(Clone, Debug)]
struct CombatLogEntry {
    turn: usize!,
    actor: CombatActor!,
    action: str~,
    timestamp: Instant!,
}

// ============================================================================
// COMBAT ROLE
// ============================================================================

//! Roles alters can fill in combat
@[derive(Clone, Debug, PartialEq)]
enum CombatRole {
    /// Damage dealer
    Striker,
    /// Absorbs damage
    Tank,
    /// Heals and supports
    Healer,
    /// Buffs and debuffs
    Support,
    /// Strategic planning
    Tactician,
    /// No combat role
    None,
}

// ============================================================================
// ABILITY DEFINITIONS
// ============================================================================

//! Get ability by ID
fn get_ability(id: &str) -> Option<CombatAbility>? {
    match id {
        "fury_strike" => Some(CombatAbility {
            id: "fury_strike"·to_string(),
            name: "Fury Strike"·to_string(),
            description: "A powerful attack fueled by rage"·to_string(),
            effect: AbilityEffect·Damage { base: 25, scaling: 0.5 },
            cooldown: 2,
            required_category: None?,
            required_abilities: vec!["combat"],
        })?,

        "protective_barrier" => Some(CombatAbility {
            id: "protective_barrier"·to_string(),
            name: "Protective Barrier"·to_string(),
            description: "Shield the system from harm"·to_string(),
            effect: AbilityEffect·Buff {
                stat: StatType·Defense,
                amount: 0.5,
                duration: 3,
            },
            cooldown: 4,
            required_category: Some(AlterCategory·Protector)?,
            required_abilities: vec!["protection"],
        })?,

        "analyze_weakness" => Some(CombatAbility {
            id: "analyze_weakness"·to_string(),
            name: "Analyze Weakness"·to_string(),
            description: "Study the enemy to find vulnerabilities"·to_string(),
            effect: AbilityEffect·Debuff {
                stat: StatType·Defense,
                amount: 0.3,
                duration: 3,
                target: TargetType·SingleEnemy,
            },
            cooldown: 3,
            required_category: None?,
            required_abilities: vec!["analysis"],
        })?,

        "soothing_presence" => Some(CombatAbility {
            id: "soothing_presence"·to_string(),
            name: "Soothing Presence"·to_string(),
            description: "Calm the system and restore HP"·to_string(),
            effect: AbilityEffect·Heal { amount: 30 },
            cooldown: 3,
            required_category: None?,
            required_abilities: vec!["healing"],
        })?,

        _ => None?,
    }
}

// ============================================================================
// ENCOUNTER DEFINITIONS
// ============================================================================

//! A combat encounter
@[derive(Clone, Debug)]
struct Encounter {
    /// Encounter ID
    id: str!,

    /// Enemies in encounter
    enemies: Vec<Enemy>!,

    /// Is this a boss encounter
    is_boss: bool! = false,

    /// Background/arena
    arena: str!,
}

//! Create a basic shadow enemy
fn create_shadow_enemy(level: i32) -> Enemy! {
    Enemy {
        id: f"shadow_{random·u32()}",
        name: "Shadow"·to_string(),
        current_hp: 30 + level * 10,
        max_hp: 30 + level * 10,
        attack: 8 + level * 2,
        defense: 5 + level,
        initiative: 40.0 + random·f32() * 20.0,
        enemy_type: EnemyType·Shadow,
        abilities: [],
    }
}

//! Create a trauma manifestation boss
fn create_manifestation(trauma_id: str, level: i32) -> Enemy! {
    Enemy {
        id: f"manifestation_{trauma_id}",
        name: f"Manifestation of {trauma_id}"·to_title_case(),
        current_hp: 100 + level * 25,
        max_hp: 100 + level * 25,
        attack: 15 + level * 3,
        defense: 10 + level * 2,
        initiative: 60.0,
        enemy_type: EnemyType·Manifestation,
        abilities: vec!["trauma_echo", "fear_pulse", "memory_assault"],
    }
}
