//! DAEMONIORUM Runtime Module
//!
//! Bridges the game logic with the UI layer, providing:
//! - Reactive state management with signals
//! - Input handling (keyboard, mouse, touch)
//! - Web/WASM entry point
//! - Main application shell
//!
//! ## Architecture
//!
//! ```
//! ┌─────────────────────────────────────────────────────────────┐
//! │                        App Shell                            │
//! │  ┌───────────────┐  ┌───────────────┐  ┌───────────────┐   │
//! │  │   UI Layer    │  │  Game Logic   │  │    Assets     │   │
//! │  │  (game_hud)   │  │   (main.sigil)│  │  (scenes, etc)│   │
//! │  └───────┬───────┘  └───────┬───────┘  └───────────────┘   │
//! │          │                  │                               │
//! │          ▼                  ▼                               │
//! │  ┌───────────────────────────────────────────────────────┐ │
//! │  │              Reactive State Manager                   │ │
//! │  │  ┌─────────┐  ┌─────────┐  ┌─────────┐  ┌─────────┐  │ │
//! │  │  │ System  │  │ Combat  │  │ Scene   │  │Inventory│  │ │
//! │  │  │ Signal  │  │ Signal  │  │ Signal  │  │ Signal  │  │ │
//! │  │  └─────────┘  └─────────┘  └─────────┘  └─────────┘  │ │
//! │  └───────────────────────────────────────────────────────┘ │
//! │                           │                                 │
//! │                           ▼                                 │
//! │  ┌───────────────────────────────────────────────────────┐ │
//! │  │                 Input Handler                         │ │
//! │  │  Keyboard / Mouse / Touch / Gamepad                   │ │
//! │  └───────────────────────────────────────────────────────┘ │
//! └─────────────────────────────────────────────────────────────┘
//! ```
//!
//! ## Usage
//!
//! ```sigil
//! use daemoniorum::runtime::prelude::*;
//!
//! fn main() {
//!     // Initialize and run the game
//!     App::run();
//! }
//! ```

pub mod state;
pub mod input;
pub mod web;
pub mod app;

