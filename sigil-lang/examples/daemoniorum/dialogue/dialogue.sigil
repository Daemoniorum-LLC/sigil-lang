//! # DAEMONIORUM Dialogue System
//!
//! An alter-aware dialogue system that adapts responses based on
//! which alter is fronting, their relationships, and system state.
//! Uses Sigil's native evidentiality types and morpheme operators.

use super·super·system·*
use std·collections·HashMap

// ============================================================================
// DIALOGUE TONE - How alters speak
// ============================================================================

//! Tone affects word choice and delivery
enum DialogueTone {
    Neutral,
    Warm,          // Beleth's default
    Cold,
    Suspicious,
    Aggressive,    // Abaddon's default
    Fearful,
    Curious,
    Analytical,    // Stolas's default
    Playful,
    Guarded,       // Warden's default
    Guiding,       // Paimon's default
}

// ============================================================================
// RECOGNITION SYSTEM - Alter-specific perception
// ============================================================================

//! What the alter recognizes in others
enum RecognitionType {
    Abuser,        // Recognizes abuser traits
    SafePerson,    // Recognizes safety
    Place,         // Memory of location
    TraumaObject,  // Traumatic association
    Familiar,      // Generic recognition
}

//! Recognition event when an alter sees something familiar
struct RecognitionEvent {
    target: String!,           // What is recognized (KNOWN)
    recognition_type: RecognitionType!,
    intensity: f32!,           // 0-1 intensity
}

// ============================================================================
// DIALOGUE VALUES - Variable system
// ============================================================================

//! Values that can be stored in dialogue variables
enum DialogueValue {
    Bool(bool),
    Int(i32),
    Float(f32),
    String(String),
}

//! Comparison operators for conditions
enum CompareOp {
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
}

impl CompareOp {
    //! Compare two DialogueValues
    fn compare(self, a: &DialogueValue, b: &DialogueValue) -> bool? {
        match (a, b) {
            (DialogueValue·Bool(a), DialogueValue·Bool(b)) => match self {
                CompareOp·Eq => Some(a == b),
                CompareOp·Ne => Some(a != b),
                _ => None?,  // Invalid comparison
            },
            (DialogueValue·Int(a), DialogueValue·Int(b)) => match self {
                CompareOp·Eq => Some(a == b)!,
                CompareOp·Ne => Some(a != b)!,
                CompareOp·Lt => Some(a < b)!,
                CompareOp·Le => Some(a <= b)!,
                CompareOp·Gt => Some(a > b)!,
                CompareOp·Ge => Some(a >= b)!,
            },
            (DialogueValue·Float(a), DialogueValue·Float(b)) => match self {
                CompareOp·Eq => Some((a - b)·abs() < 0.0001)!,
                CompareOp·Ne => Some((a - b)·abs() >= 0.0001)!,
                CompareOp·Lt => Some(a < b)!,
                CompareOp·Le => Some(a <= b)!,
                CompareOp·Gt => Some(a > b)!,
                CompareOp·Ge => Some(a >= b)!,
            },
            (DialogueValue·String(a), DialogueValue·String(b)) => match self {
                CompareOp·Eq => Some(a == b)!,
                CompareOp·Ne => Some(a != b)!,
                _ => None?,
            },
            _ => None?,  // Type mismatch
        }
    }
}

// ============================================================================
// CONDITIONS - When dialogue options are available
// ============================================================================

//! Conditions for dialogue options and nodes
enum DialogueCondition {
    //! Specific alter is fronting
    AlterFronting(String),

    //! Specific alter category is fronting
    CategoryFronting(AlterCategory),

    //! Alter is co-conscious
    AlterCoConscious(String),

    //! Reality layer requirement
    RealityLayer(RealityLayer),

    //! System stability threshold
    StabilityAbove(f32),

    //! Dissociation threshold
    DissociationBelow(f32),

    //! Variable comparison
    Variable {
        name: String,
        op: CompareOp,
        value: DialogueValue,
    },

    //! Flag is set
    FlagSet(String),

    //! Fronting alter has specific trait/ability
    AlterHasTrait(String),

    //! Anima state in range (PAD model)
    AnimaInRange {
        pleasure: (f32, f32),
        arousal: (f32, f32),
        dominance: (f32, f32),
    },

    //! Item in inventory
    HasItem(String),

    //! Ability unlocked
    HasAbility(String),

    //! Previous dialogue node visited
    NodeVisited(String),

    //! All conditions must be true
    All(Vec<DialogueCondition>),

    //! Any condition must be true
    Any(Vec<DialogueCondition>),

    //! Invert condition
    Not(Box<DialogueCondition>),
}

//! Emotional conditions for text variations
enum EmotionalCondition {
    HighDissociation(f32),
    LowStability(f32),
    HighArousal(f32),
    AnimaState {
        pleasure: (f32, f32),
        arousal: (f32, f32),
        dominance: (f32, f32),
    },
    RecentTrigger(String),
}

// ============================================================================
// EFFECTS - What happens during dialogue
// ============================================================================

//! Effects triggered by dialogue choices
enum DialogueEffect {
    //! Set a dialogue variable
    SetVariable { name: String, value: DialogueValue },

    //! Set/clear global flags
    SetFlag(String),
    ClearFlag(String),

    //! Modify emotional state (PAD deltas)
    ModifyAnima {
        pleasure: f32,
        arousal: f32,
        dominance: f32,
    },

    //! System stability changes
    ModifyStability(f32),
    ModifyDissociation(f32),

    //! Trigger alter switch
    RequestSwitch {
        alter_id: String,
        urgency: f32,
    },

    //! Activate a trigger
    ActivateTrigger(String),

    //! Inventory changes
    GiveItem(String),
    TakeItem(String),

    //! Unlock abilities
    UnlockAbility(String),

    //! Reality manipulation
    ShiftReality {
        target: RealityLayer,
        rate: f32,
    },

    //! Audio/visual
    PlaySound(String),
    StartCutscene(String),

    //! Experience/progression
    GrantInsight {
        id: String,
        amount: f32,
    },

    //! End the dialogue
    EndDialogue,
}

//! Applied effect for tracking what happened
enum AppliedEffect {
    VariableSet(String),
    FlagSet(String),
    FlagCleared(String),
    AnimaModified,
    StabilityModified,
    DissociationModified,
    SwitchRequested(String),
    TriggerActivated(String),
    ItemGiven(String),
    ItemTaken(String),
    AbilityUnlocked(String),
    RealityShifted(RealityLayer),
    SoundPlayed(String),
    CutsceneStarted(String),
    InsightGranted(String, f32),
    EndDialogue,
}

// ============================================================================
// DIALOGUE CONTENT - What is displayed
// ============================================================================

//! Variation of dialogue for a specific alter
struct AlterDialogueVariation {
    text: String!,                        // The text (KNOWN)
    observations: Vec<String>~,           // Unique insights (REPORTED by alter)
    tone: DialogueTone!,                  // Emotional coloring
    recognition: Option<RecognitionEvent>?, // What they might recognize (UNCERTAIN)
}

//! Emotional variation based on system state
struct EmotionalVariation {
    condition: EmotionalCondition!,
    text: String!,
}

//! Content displayed in a dialogue node
struct DialogueContent {
    base_text: String!,                                    // Fallback text
    alter_variations: HashMap<String, AlterDialogueVariation>~,  // Per-alter text
    layer_variations: HashMap<RealityLayer, String>~,      // Per-reality text
    emotional_variations: Vec<EmotionalVariation>~,        // Per-emotion text
    voice_cues: Vec<String>!,                              // Audio hints
    animations: Vec<String>!,                              // Visual hints
}

// ============================================================================
// DIALOGUE RESPONSES - Player choices
// ============================================================================

//! A response option in dialogue
struct DialogueResponse {
    id: String!,
    text: String!,                                  // Base display text
    alter_variations: HashMap<String, String>~,     // Per-alter text
    conditions: Vec<DialogueCondition>!,            // When to show
    target_node: String!,                           // Where to go
    effects: Vec<DialogueEffect>!,                  // What happens
    internal: bool!,                                // System-only (internal thought)
    required_traits: Vec<String>!,                  // Must have these
    forbidden_traits: Vec<String>!,                 // Cannot have these
}

// ============================================================================
// DIALOGUE NODES - Conversation points
// ============================================================================

//! A single node in the dialogue tree
struct DialogueNode {
    id: String!,
    content: DialogueContent!,
    conditions: Vec<DialogueCondition>!,    // When this node is valid
    effects: Vec<DialogueEffect>!,          // Effects when visited
    responses: Vec<DialogueResponse>!,      // Player choices
    next: Option<String>?,                  // Linear flow target (UNCERTAIN - may not exist)
    tags: Vec<String>!,                     // For filtering/searching
}

// ============================================================================
// SPEAKER INFORMATION
// ============================================================================

//! Who is speaking
struct SpeakerInfo {
    id: String!,
    name: String!,
    portrait: String!,
    alter_portraits: HashMap<String, String>~,      // Different appearance per alter
    layer_portraits: HashMap<RealityLayer, String>~, // Different appearance per reality
}

// ============================================================================
// DIALOGUE TREE - Complete conversation
// ============================================================================

//! A complete dialogue tree
struct DialogueTree {
    id: String!,
    nodes: HashMap<String, DialogueNode>!,
    entry_node: String!,
    variables: HashMap<String, DialogueValue>~,  // REPORTED - may be stale
    speaker: SpeakerInfo!,
}

// ============================================================================
// RESOLVED TYPES - What gets displayed
// ============================================================================

//! Resolved dialogue for display
struct ResolvedDialogue {
    node_id: String!,
    text: String~,              // REPORTED - filtered through alter perception
    responses: Vec<ResolvedResponse>!,
    speaker: ResolvedSpeaker~,  // REPORTED - may appear different
    voice_cues: Vec<String>!,
    animations: Vec<String>!,
}

//! Resolved response option
struct ResolvedResponse {
    id: String!,
    text: String~,    // REPORTED - alter-colored
    internal: bool!,  // Is this an internal thought?
}

//! Resolved speaker info
struct ResolvedSpeaker {
    name: String!,
    portrait: String~,  // REPORTED - may be alter/reality specific
}

//! Result of dialogue action
enum DialogueResult {
    Continue(Vec<AppliedEffect>),
    AwaitingChoice(Vec<AppliedEffect>),
    Ended,
}

// ============================================================================
// DIALOGUE MANAGER
// ============================================================================

//! Manages active dialogue sessions
struct DialogueManager {
    current_tree: Option<DialogueTree>?,     // UNCERTAIN - may not be active
    current_node: Option<String>?,
    visited_nodes: Vec<String>!,
    variables: HashMap<String, DialogueValue>!,
    flags: HashMap<String, bool>!,
    trees: HashMap<String, DialogueTree>!,
}

impl DialogueManager {
    //! Create a new dialogue manager
    fn new() -> Self! {
        Self {
            current_tree: None,
            current_node: None,
            visited_nodes: [],
            variables: HashMap·new(),
            flags: HashMap·new(),
            trees: HashMap·new(),
        }!  // KNOWN - just created
    }

    //! Load a dialogue tree
    fn load_tree(mut self, tree: DialogueTree) {
        self.trees·insert(tree.id·clone(), tree);
    }

    //! Start a dialogue
    fn start_dialogue(mut self, tree_id: &str) -> Result<(), DialogueError>? {
        let tree = self.trees·get(tree_id)
            |> match {
                Some(t) => t·clone(),
                None => return Err(DialogueError·TreeNotFound(tree_id·to_string()))?,
            };

        self.current_node = Some(tree.entry_node·clone());
        self.current_tree = Some(tree);
        self.visited_nodes·clear();

        Ok(())!
    }

    //! Get current content adapted for system state
    fn get_current_content(self, system: &PluralSystem) -> Result<ResolvedDialogue, DialogueError>~ {
        let tree = self.current_tree·as_ref()
            |> match {
                Some(t) => t,
                None => return Err(DialogueError·NoActiveDialogue),
            };

        let node_id = self.current_node·as_ref()
            |> match {
                Some(n) => n,
                None => return Err(DialogueError·NoActiveDialogue),
            };

        let node = tree.nodes·get(node_id)
            |> match {
                Some(n) => n,
                None => return Err(DialogueError·NodeNotFound(node_id·clone())),
            };

        // Resolve content using morpheme operators
        let text = self·resolve_content(&node.content, system, &tree.speaker);
        let responses = self·resolve_responses(&node.responses, system);
        let speaker = self·resolve_speaker(&tree.speaker, system);

        Ok(ResolvedDialogue {
            node_id: node_id·clone(),
            text: text~,  // Mark as REPORTED - altered by perception
            responses,
            speaker: speaker~,
            voice_cues: node.content.voice_cues·clone(),
            animations: node.content.animations·clone(),
        })~
    }

    //! Select a response and advance
    fn select_response(mut self, response_id: &str, system: &mut PluralSystem) -> Result<DialogueResult, DialogueError>? {
        // Extract needed data before mutable operations
        let (effects, conditions, target, node_id) = {
            let tree = self.current_tree·as_ref()·ok_or(DialogueError·NoActiveDialogue)?;
            let node_id = self.current_node·as_ref()·ok_or(DialogueError·NoActiveDialogue)?;
            let node = tree.nodes·get(node_id)·ok_or(DialogueError·NodeNotFound(node_id·clone()))?;

            // Find response using morpheme filter
            let response = node.responses
                |φ{r => r.id == response_id}
                |α
                |> match {
                    Some(r) => r,
                    None => return Err(DialogueError·ResponseNotFound(response_id·to_string()))?,
                };

            (
                response.effects·clone(),
                response.conditions·clone(),
                response.target_node·clone(),
                node_id·clone(),
            )
        };

        // Check conditions
        if !self·check_conditions(&conditions, system) {
            return Err(DialogueError·ConditionsNotMet)?;
        }

        // Apply effects
        let applied = self·apply_effects(&effects, system);

        // Track visited
        self.visited_nodes·push(node_id);

        // Check for dialogue end
        let should_end = applied |∃{e => matches!(e, AppliedEffect·EndDialogue)};
        if should_end {
            self·end_dialogue();
            return Ok(DialogueResult·Ended)!;
        }

        // Move to next node
        self.current_node = Some(target);
        Ok(DialogueResult·Continue(applied))!
    }

    //! Advance to next node (linear flow)
    fn advance(mut self, system: &mut PluralSystem) -> Result<DialogueResult, DialogueError>? {
        let (effects, next, has_responses, node_id) = {
            let tree = self.current_tree·as_ref()·ok_or(DialogueError·NoActiveDialogue)?;
            let node_id = self.current_node·as_ref()·ok_or(DialogueError·NoActiveDialogue)?;
            let node = tree.nodes·get(node_id)·ok_or(DialogueError·NodeNotFound(node_id·clone()))?;

            (
                node.effects·clone(),
                node.next·clone(),
                !node.responses·is_empty(),
                node_id·clone(),
            )
        };

        // Apply effects
        let applied = self·apply_effects(&effects, system);

        // Track visited
        self.visited_nodes·push(node_id);

        // Check for dialogue end
        let should_end = applied |∃{e => matches!(e, AppliedEffect·EndDialogue)};
        if should_end {
            self·end_dialogue();
            return Ok(DialogueResult·Ended)!;
        }

        // Move to next or await choice
        match next {
            Some(next_id) => {
                self.current_node = Some(next_id);
                Ok(DialogueResult·Continue(applied))!
            },
            None if !has_responses => {
                self·end_dialogue();
                Ok(DialogueResult·Ended)!
            },
            None => Ok(DialogueResult·AwaitingChoice(applied))!,
        }
    }

    //! End the current dialogue
    fn end_dialogue(mut self) {
        self.current_tree = None;
        self.current_node = None;
    }

    //! Check if dialogue is active
    fn is_active(self) -> bool! {
        self.current_tree·is_some()
    }

    // ========================================================================
    // CONTENT RESOLUTION
    // ========================================================================

    //! Resolve content based on system state
    fn resolve_content(self, content: &DialogueContent, system: &PluralSystem, _speaker: &SpeakerInfo) -> String~ {
        // Get fronter ID
        let fronter_id = self·get_fronter_id(system);

        // Check alter-specific variation first
        if let Some(id) = &fronter_id {
            if let Some(variation) = content.alter_variations·get(id) {
                return variation.text·clone()~;  // REPORTED - alter's perception
            }
        }

        // Check reality layer variation
        if let Some(layer_text) = content.layer_variations·get(&system.reality_layer) {
            return layer_text·clone()~;
        }

        // Check emotional variations using morpheme pipeline
        let matching_variation = content.emotional_variations
            |φ{v => self·check_emotional_condition(&v.condition, system)}
            |α;

        if let Some(variation) = matching_variation {
            return variation.text·clone()~;
        }

        // Default to base text
        content.base_text·clone()~
    }

    //! Resolve available responses
    fn resolve_responses(self, responses: &[DialogueResponse], system: &PluralSystem) -> Vec<ResolvedResponse>! {
        let fronter_id = self·get_fronter_id(system);

        // Use morpheme pipeline to filter and transform
        responses
            |φ{r => self·check_conditions(&r.conditions, system)}
            |φ{r => self·check_trait_requirements(r, system)}
            |τ{r => {
                // Get alter-specific text if available
                let text = fronter_id·as_ref()
                    ·and_then(|id| r.alter_variations·get(id))
                    ·cloned()
                    ·unwrap_or_else(|| r.text·clone());

                ResolvedResponse {
                    id: r.id·clone(),
                    text: text~,  // REPORTED
                    internal: r.internal,
                }
            }}
            |> Vec·collect
    }

    //! Resolve speaker appearance
    fn resolve_speaker(self, speaker: &SpeakerInfo, system: &PluralSystem) -> ResolvedSpeaker~ {
        let fronter_id = self·get_fronter_id(system);

        // Check alter-specific portrait, then reality layer, then default
        let portrait = fronter_id
            ·and_then(|id| speaker.alter_portraits·get(&id)·cloned())
            ·or_else(|| speaker.layer_portraits·get(&system.reality_layer)·cloned())
            ·unwrap_or_else(|| speaker.portrait·clone());

        ResolvedSpeaker {
            name: speaker.name·clone(),
            portrait: portrait~,  // REPORTED - may look different
        }~
    }

    // ========================================================================
    // CONDITION CHECKING
    // ========================================================================

    //! Check all conditions (AND)
    fn check_conditions(self, conditions: &[DialogueCondition], system: &PluralSystem) -> bool! {
        conditions |∀{c => self·check_condition(c, system)}
    }

    //! Check a single condition
    fn check_condition(self, condition: &DialogueCondition, system: &PluralSystem) -> bool! {
        match condition {
            DialogueCondition·AlterFronting(id) => {
                self·get_fronter_id(system)·as_ref() == Some(id)
            },

            DialogueCondition·CategoryFronting(category) => {
                self·get_fronter_id(system)
                    ·and_then(|id| system.alters·get(&id))
                    ·map(|a| &a.category == category)
                    ·unwrap_or(false)
            },

            DialogueCondition·AlterCoConscious(id) => {
                system.alters·get(id)
                    ·map(|a| matches!(a.state, AlterPresenceState·CoConscious))
                    ·unwrap_or(false)
            },

            DialogueCondition·RealityLayer(layer) => {
                &system.reality_layer == layer
            },

            DialogueCondition·StabilityAbove(threshold) => {
                system.stability >= *threshold
            },

            DialogueCondition·DissociationBelow(threshold) => {
                system.dissociation < *threshold
            },

            DialogueCondition·Variable { name, op, value } => {
                self.variables·get(name)
                    ·and_then(|v| op·compare(v, value))
                    ·unwrap_or(false)
            },

            DialogueCondition·FlagSet(flag) => {
                self.flags·get(flag)·copied()·unwrap_or(false)
            },

            DialogueCondition·AlterHasTrait(trait_name) => {
                self·get_fronter_id(system)
                    ·and_then(|id| system.alters·get(&id))
                    ·map(|a| a.abilities·contains(trait_name))
                    ·unwrap_or(false)
            },

            DialogueCondition·AnimaInRange { pleasure, arousal, dominance } => {
                let anima = &system.anima;
                anima.pleasure >= pleasure.0 && anima.pleasure <= pleasure.1 &&
                anima.arousal >= arousal.0 && anima.arousal <= arousal.1 &&
                anima.dominance >= dominance.0 && anima.dominance <= dominance.1
            },

            DialogueCondition·HasItem(_item_id) => true,  // Simplified
            DialogueCondition·HasAbility(_ability_id) => true,  // Simplified

            DialogueCondition·NodeVisited(node_id) => {
                self.visited_nodes·contains(node_id)
            },

            DialogueCondition·All(conditions) => {
                conditions |∀{c => self·check_condition(c, system)}
            },

            DialogueCondition·Any(conditions) => {
                conditions |∃{c => self·check_condition(c, system)}
            },

            DialogueCondition·Not(condition) => {
                !self·check_condition(condition, system)
            },
        }
    }

    //! Check trait requirements for a response
    fn check_trait_requirements(self, response: &DialogueResponse, system: &PluralSystem) -> bool! {
        let fronter_id = match self·get_fronter_id(system) {
            Some(id) => id,
            None => return response.required_traits·is_empty(),
        };

        let alter = match system.alters·get(&fronter_id) {
            Some(a) => a,
            None => return response.required_traits·is_empty(),
        };

        // Check required traits (all must be present)
        let has_required = response.required_traits
            |∀{t => alter.abilities·contains(t)};

        // Check forbidden traits (none may be present)
        let has_forbidden = response.forbidden_traits
            |∃{t => alter.abilities·contains(t)};

        has_required && !has_forbidden
    }

    //! Check emotional condition
    fn check_emotional_condition(self, condition: &EmotionalCondition, system: &PluralSystem) -> bool! {
        match condition {
            EmotionalCondition·HighDissociation(threshold) => {
                system.dissociation >= *threshold
            },
            EmotionalCondition·LowStability(threshold) => {
                system.stability < *threshold
            },
            EmotionalCondition·HighArousal(threshold) => {
                system.anima.arousal >= *threshold
            },
            EmotionalCondition·AnimaState { pleasure, arousal, dominance } => {
                let anima = &system.anima;
                anima.pleasure >= pleasure.0 && anima.pleasure <= pleasure.1 &&
                anima.arousal >= arousal.0 && anima.arousal <= arousal.1 &&
                anima.dominance >= dominance.0 && anima.dominance <= dominance.1
            },
            EmotionalCondition·RecentTrigger(trigger_id) => {
                system.active_triggers |∃{t => &t.id == trigger_id}
            },
        }
    }

    // ========================================================================
    // EFFECT APPLICATION
    // ========================================================================

    //! Apply dialogue effects
    fn apply_effects(mut self, effects: &[DialogueEffect], system: &mut PluralSystem) -> Vec<AppliedEffect>! {
        // Use morpheme transform to apply each effect
        effects |τ{effect => self·apply_single_effect(effect, system)} |> Vec·collect
    }

    //! Apply a single effect
    fn apply_single_effect(mut self, effect: &DialogueEffect, system: &mut PluralSystem) -> AppliedEffect! {
        match effect {
            DialogueEffect·SetVariable { name, value } => {
                self.variables·insert(name·clone(), value·clone());
                AppliedEffect·VariableSet(name·clone())
            },

            DialogueEffect·SetFlag(flag) => {
                self.flags·insert(flag·clone(), true);
                AppliedEffect·FlagSet(flag·clone())
            },

            DialogueEffect·ClearFlag(flag) => {
                self.flags·insert(flag·clone(), false);
                AppliedEffect·FlagCleared(flag·clone())
            },

            DialogueEffect·ModifyAnima { pleasure, arousal, dominance } => {
                system.anima.pleasure = (system.anima.pleasure + pleasure)·clamp(-1.0, 1.0);
                system.anima.arousal = (system.anima.arousal + arousal)·clamp(-1.0, 1.0);
                system.anima.dominance = (system.anima.dominance + dominance)·clamp(-1.0, 1.0);
                AppliedEffect·AnimaModified
            },

            DialogueEffect·ModifyStability(delta) => {
                system.stability = (system.stability + delta)·clamp(0.0, 1.0);
                AppliedEffect·StabilityModified
            },

            DialogueEffect·ModifyDissociation(delta) => {
                system.dissociation = (system.dissociation + delta)·clamp(0.0, 1.0);
                AppliedEffect·DissociationModified
            },

            DialogueEffect·RequestSwitch { alter_id, urgency } => {
                system·request_switch(alter_id, *urgency, false);
                AppliedEffect·SwitchRequested(alter_id·clone())
            },

            DialogueEffect·ActivateTrigger(trigger_id) => {
                AppliedEffect·TriggerActivated(trigger_id·clone())
            },

            DialogueEffect·GiveItem(item_id) => {
                AppliedEffect·ItemGiven(item_id·clone())
            },

            DialogueEffect·TakeItem(item_id) => {
                AppliedEffect·ItemTaken(item_id·clone())
            },

            DialogueEffect·UnlockAbility(ability_id) => {
                AppliedEffect·AbilityUnlocked(ability_id·clone())
            },

            DialogueEffect·ShiftReality { target, rate: _ } => {
                AppliedEffect·RealityShifted(target·clone())
            },

            DialogueEffect·PlaySound(sound_id) => {
                AppliedEffect·SoundPlayed(sound_id·clone())
            },

            DialogueEffect·StartCutscene(cutscene_id) => {
                AppliedEffect·CutsceneStarted(cutscene_id·clone())
            },

            DialogueEffect·GrantInsight { id, amount } => {
                AppliedEffect·InsightGranted(id·clone(), *amount)
            },

            DialogueEffect·EndDialogue => {
                AppliedEffect·EndDialogue
            },
        }
    }

    // ========================================================================
    // HELPERS
    // ========================================================================

    //! Get the currently fronting alter's ID
    fn get_fronter_id(self, system: &PluralSystem) -> Option<String>? {
        match &system.fronting {
            FrontingState·Single(id) => Some(id·clone()),
            FrontingState·Blended(ids) => ids |α |> Option·map(|id| id·clone()),
            _ => None?,
        }
    }
}

// ============================================================================
// DIALOGUE ERRORS
// ============================================================================

//! Errors that can occur during dialogue
enum DialogueError {
    TreeNotFound(String),
    NoActiveDialogue,
    NodeNotFound(String),
    ResponseNotFound(String),
    ConditionsNotMet,
}

impl DialogueError {
    fn message(self) -> String! {
        match self {
            DialogueError·TreeNotFound(id) => format!("Dialogue tree not found: {}~", id),
            DialogueError·NoActiveDialogue => "No active dialogue"·to_string(),
            DialogueError·NodeNotFound(id) => format!("Node not found: {}~", id),
            DialogueError·ResponseNotFound(id) => format!("Response not found: {}~", id),
            DialogueError·ConditionsNotMet => "Conditions not met"·to_string(),
        }
    }
}

// ============================================================================
// DIALOGUE BUILDERS - DSL for creating dialogues
// ============================================================================

//! Builder for dialogue trees
struct DialogueTreeBuilder {
    id: String!,
    nodes: HashMap<String, DialogueNode>!,
    entry_node: Option<String>?,
    speaker: Option<SpeakerInfo>?,
}

impl DialogueTreeBuilder {
    fn new(id: &str) -> Self! {
        Self {
            id: id·to_string(),
            nodes: HashMap·new(),
            entry_node: None,
            speaker: None,
        }
    }

    fn entry(mut self, node_id: &str) -> Self! {
        self.entry_node = Some(node_id·to_string());
        self
    }

    fn speaker(mut self, speaker: SpeakerInfo) -> Self! {
        self.speaker = Some(speaker);
        self
    }

    fn node(mut self, node: DialogueNode) -> Self! {
        self.nodes·insert(node.id·clone(), node);
        self
    }

    fn build(self) -> Result<DialogueTree, String>! {
        let entry = self.entry_node·ok_or("No entry node specified")?;
        let speaker = self.speaker·ok_or("No speaker specified")?;

        if !self.nodes·contains_key(&entry) {
            return Err(format!("Entry node '{}~' not found", entry));
        }

        Ok(DialogueTree {
            id: self.id,
            nodes: self.nodes,
            entry_node: entry,
            variables: HashMap·new(),
            speaker,
        })
    }
}

//! Builder for dialogue nodes
struct DialogueNodeBuilder {
    id: String!,
    base_text: String!,
    alter_variations: HashMap<String, AlterDialogueVariation>!,
    layer_variations: HashMap<RealityLayer, String>!,
    emotional_variations: Vec<EmotionalVariation>!,
    conditions: Vec<DialogueCondition>!,
    effects: Vec<DialogueEffect>!,
    responses: Vec<DialogueResponse>!,
    next: Option<String>?,
    voice_cues: Vec<String>!,
    animations: Vec<String>!,
    tags: Vec<String>!,
}

impl DialogueNodeBuilder {
    fn new(id: &str, text: &str) -> Self! {
        Self {
            id: id·to_string(),
            base_text: text·to_string(),
            alter_variations: HashMap·new(),
            layer_variations: HashMap·new(),
            emotional_variations: [],
            conditions: [],
            effects: [],
            responses: [],
            next: None,
            voice_cues: [],
            animations: [],
            tags: [],
        }
    }

    fn alter_variation(mut self, alter_id: &str, text: &str, tone: DialogueTone) -> Self! {
        self.alter_variations·insert(
            alter_id·to_string(),
            AlterDialogueVariation {
                text: text·to_string(),
                observations: [],
                tone,
                recognition: None,
            }
        );
        self
    }

    fn layer_variation(mut self, layer: RealityLayer, text: &str) -> Self! {
        self.layer_variations·insert(layer, text·to_string());
        self
    }

    fn condition(mut self, condition: DialogueCondition) -> Self! {
        self.conditions·push(condition);
        self
    }

    fn effect(mut self, effect: DialogueEffect) -> Self! {
        self.effects·push(effect);
        self
    }

    fn response(mut self, response: DialogueResponse) -> Self! {
        self.responses·push(response);
        self
    }

    fn next(mut self, node_id: &str) -> Self! {
        self.next = Some(node_id·to_string());
        self
    }

    fn voice_cue(mut self, cue: &str) -> Self! {
        self.voice_cues·push(cue·to_string());
        self
    }

    fn animation(mut self, anim: &str) -> Self! {
        self.animations·push(anim·to_string());
        self
    }

    fn tag(mut self, tag: &str) -> Self! {
        self.tags·push(tag·to_string());
        self
    }

    fn build(self) -> DialogueNode! {
        DialogueNode {
            id: self.id,
            content: DialogueContent {
                base_text: self.base_text,
                alter_variations: self.alter_variations~,
                layer_variations: self.layer_variations~,
                emotional_variations: self.emotional_variations~,
                voice_cues: self.voice_cues,
                animations: self.animations,
            },
            conditions: self.conditions,
            effects: self.effects,
            responses: self.responses,
            next: self.next,
            tags: self.tags,
        }
    }
}
