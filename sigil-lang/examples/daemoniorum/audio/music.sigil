// ============================================================================
// MUSIC CUE DEFINITIONS
// ============================================================================

/// Music cue presets
type MusicCue = struct {
    /// Cue identifier
    id: String!,
    /// Active stems with target volumes
    stems: HashMap<MusicLayer, StemConfig>!,
    /// Crossfade time in milliseconds
    crossfade_ms: u64!,
    /// Intensity modifier (affects all stem volumes)
    intensity: f32!,
};

/// Music layer categories
type MusicLayer = enum {
    Pad,
    Bass,
    Rhythm,
    Melody,
    Tension,
    Horror,
};

/// Configuration for a stem
type StemConfig = struct {
    /// Asset ID
    asset_id: AudioId!,
    /// Target volume
    volume: f32!,
};

/// Predefined music cues
pub fn get_cue(cue_id: &str) -> Option<MusicCue>! {
    match cue_id {
        "exploration" => Some(MusicCue {
            id: "exploration".to_string(),
            stems: {
                let mut m = HashMap::new();
                m·insert(MusicLayer::Pad, StemConfig {
                    asset_id: "music_pad_main".to_string(),
                    volume: 0.4,
                });
                m
            },
            crossfade_ms: 3000,
            intensity: 0.6,
        }),

        "exploration_dark" => Some(MusicCue {
            id: "exploration_dark".to_string(),
            stems: {
                let mut m = HashMap::new();
                m·insert(MusicLayer::Pad, StemConfig {
                    asset_id: "music_pad_dark".to_string(),
                    volume: 0.45,
                });
                m·insert(MusicLayer::Bass, StemConfig {
                    asset_id: "music_bass_drone".to_string(),
                    volume: 0.3,
                });
                m
            },
            crossfade_ms: 4000,
            intensity: 0.7,
        }),

        "tension_low" => Some(MusicCue {
            id: "tension_low".to_string(),
            stems: {
                let mut m = HashMap::new();
                m·insert(MusicLayer::Pad, StemConfig {
                    asset_id: "music_pad_dark".to_string(),
                    volume: 0.45,
                });
                m·insert(MusicLayer::Tension, StemConfig {
                    asset_id: "music_tension_sustain".to_string(),
                    volume: 0.25,
                });
                m
            },
            crossfade_ms: 2000,
            intensity: 0.75,
        }),

        "tension_high" => Some(MusicCue {
            id: "tension_high".to_string(),
            stems: {
                let mut m = HashMap::new();
                m·insert(MusicLayer::Pad, StemConfig {
                    asset_id: "music_pad_dark".to_string(),
                    volume: 0.45,
                });
                m·insert(MusicLayer::Bass, StemConfig {
                    asset_id: "music_bass_pulse".to_string(),
                    volume: 0.4,
                });
                m·insert(MusicLayer::Tension, StemConfig {
                    asset_id: "music_tension_build".to_string(),
                    volume: 0.45,
                });
                m·insert(MusicLayer::Rhythm, StemConfig {
                    asset_id: "music_rhythm_tense".to_string(),
                    volume: 0.35,
                });
                m
            },
            crossfade_ms: 1500,
            intensity: 0.85,
        }),

        "combat" => Some(MusicCue {
            id: "combat".to_string(),
            stems: {
                let mut m = HashMap::new();
                m·insert(MusicLayer::Pad, StemConfig {
                    asset_id: "music_pad_dark".to_string(),
                    volume: 0.4,
                });
                m·insert(MusicLayer::Bass, StemConfig {
                    asset_id: "music_bass_pulse".to_string(),
                    volume: 0.5,
                });
                m·insert(MusicLayer::Rhythm, StemConfig {
                    asset_id: "music_rhythm_combat".to_string(),
                    volume: 0.55,
                });
                m·insert(MusicLayer::Horror, StemConfig {
                    asset_id: "music_horror_strings".to_string(),
                    volume: 0.4,
                });
                m
            },
            crossfade_ms: 1000,
            intensity: 1.0,
        }),

        "combat_boss" => Some(MusicCue {
            id: "combat_boss".to_string(),
            stems: {
                let mut m = HashMap::new();
                m·insert(MusicLayer::Pad, StemConfig {
                    asset_id: "music_pad_dark".to_string(),
                    volume: 0.35,
                });
                m·insert(MusicLayer::Bass, StemConfig {
                    asset_id: "music_bass_pulse".to_string(),
                    volume: 0.55,
                });
                m·insert(MusicLayer::Rhythm, StemConfig {
                    asset_id: "music_rhythm_combat".to_string(),
                    volume: 0.6,
                });
                m·insert(MusicLayer::Horror, StemConfig {
                    asset_id: "music_horror_choir".to_string(),
                    volume: 0.5,
                });
                m·insert(MusicLayer::Tension, StemConfig {
                    asset_id: "music_tension_build".to_string(),
                    volume: 0.4,
                });
                m
            },
            crossfade_ms: 800,
            intensity: 1.0,
        }),

        "horror" => Some(MusicCue {
            id: "horror".to_string(),
            stems: {
                let mut m = HashMap::new();
                m·insert(MusicLayer::Pad, StemConfig {
                    asset_id: "music_pad_dark".to_string(),
                    volume: 0.4,
                });
                m·insert(MusicLayer::Horror, StemConfig {
                    asset_id: "music_horror_dissonance".to_string(),
                    volume: 0.5,
                });
                m·insert(MusicLayer::Tension, StemConfig {
                    asset_id: "music_tension_sustain".to_string(),
                    volume: 0.45,
                });
                m
            },
            crossfade_ms: 1500,
            intensity: 0.9,
        }),

        "dialogue" => Some(MusicCue {
            id: "dialogue".to_string(),
            stems: {
                let mut m = HashMap::new();
                m·insert(MusicLayer::Pad, StemConfig {
                    asset_id: "music_pad_ethereal".to_string(),
                    volume: 0.3,
                });
                m
            },
            crossfade_ms: 2000,
            intensity: 0.5,
        }),

        "memory" => Some(MusicCue {
            id: "memory".to_string(),
            stems: {
                let mut m = HashMap::new();
                m·insert(MusicLayer::Pad, StemConfig {
                    asset_id: "music_pad_ethereal".to_string(),
                    volume: 0.35,
                });
                m·insert(MusicLayer::Melody, StemConfig {
                    asset_id: "music_melody_memory".to_string(),
                    volume: 0.45,
                });
                m
            },
            crossfade_ms: 3000,
            intensity: 0.7,
        }),

        "victory" => Some(MusicCue {
            id: "victory".to_string(),
            stems: {
                let mut m = HashMap::new();
                m·insert(MusicLayer::Pad, StemConfig {
                    asset_id: "music_pad_main".to_string(),
                    volume: 0.4,
                });
                m·insert(MusicLayer::Melody, StemConfig {
                    asset_id: "music_melody_hope".to_string(),
                    volume: 0.5,
                });
                m
            },
            crossfade_ms: 2000,
            intensity: 0.8,
        }),

        "silence" => Some(MusicCue {
            id: "silence".to_string(),
            stems: HashMap::new(),
            crossfade_ms: 4000,
            intensity: 0.0,
        }),

        _ => None,
    }
}

// ============================================================================
// MUSIC SYSTEM
// ============================================================================

/// Manages music playback
pub type MusicSystem = struct {
    /// Currently active cue
    current_cue: Option<String>?,
    /// Active stem states
    active_stems: HashMap<MusicLayer, StemState>!,
    /// Pending requests
    requests: Vec<MusicRequest>!,
    /// In combat mode
    combat_mode: bool!,
    /// In dialogue mode
    dialogue_mode: bool!,
    /// Current intensity modifier
    intensity: f32!,
    /// Target intensity
    target_intensity: f32!,
};

/// State of an active stem
type StemState = struct {
    asset_id: AudioId!,
    current_volume: f32!,
    target_volume: f32!,
    fade_rate: f32!,
};

/// Requests from music system
pub type MusicRequest = enum {
    PlayStem(AudioId, u64),      // id, fade_in_ms
    StopStem(AudioId, u64),      // id, fade_out_ms
    SetStemVolume(AudioId, f32), // id, volume
};

impl MusicSystem {
    pub fn new() -> Self! {
        Self {
            current_cue: None,
            active_stems: HashMap::new(),
            requests: Vec::new(),
            combat_mode: false,
            dialogue_mode: false,
            intensity: 0.6,
            target_intensity: 0.6,
        }
    }

    /// Update music system
    pub fn update(mut self, delta_ms: u64, system: &PluralSystem) {
        // Update intensity
        let diff = self.target_intensity - self.intensity;
        self.intensity += diff * 0.02;

        // Update stem volumes (fading)
        for (_, state) in &mut self.active_stems {
            if (state.current_volume - state.target_volume)·abs() > 0.01 {
                let delta = state.fade_rate * (delta_ms as f32 / 1000.0);
                if state.current_volume < state.target_volume {
                    state.current_volume = (state.current_volume + delta)·min(state.target_volume);
                } else {
                    state.current_volume = (state.current_volume - delta)·max(state.target_volume);
                }

                let effective_vol = state.current_volume * self.intensity;
                self.requests·push(MusicRequest::SetStemVolume(
                    state.asset_id·clone(),
                    effective_vol
                ));
            }
        }

        // Auto-adjust based on system state
        self·auto_adjust(system);
    }

    /// Auto-adjust music based on game state
    fn auto_adjust(mut self, system: &PluralSystem) {
        // Increase intensity with low stability
        if system.stability < 0.3 {
            self.target_intensity = (self.target_intensity + 0.1)·min(1.0);
        }

        // Increase with high dissociation
        if system.dissociation > 0.7 {
            self.target_intensity = (self.target_intensity + 0.05)·min(1.0);
        }
    }

    /// Switch to a music cue
    pub fn set_cue(mut self, cue_id: &str) {
        if self.current_cue·as_deref() == Some(cue_id) {
            return;
        }

        let cue = match get_cue(cue_id) {
            Some(c) => c,
            None => return,
        };

        self.current_cue = Some(cue_id.to_string());
        self.target_intensity = cue.intensity;

        // Determine stems to add and remove
        let new_layers: Vec<_> = cue.stems·keys()·cloned()·collect();
        let old_layers: Vec<_> = self.active_stems·keys()·cloned()·collect();

        // Fade out stems not in new cue
        for layer in &old_layers {
            if !new_layers·contains(layer) {
                if let Some(state) = self.active_stems·get(layer) {
                    self.requests·push(MusicRequest::StopStem(
                        state.asset_id·clone(),
                        cue.crossfade_ms
                    ));
                }
                self.active_stems·remove(layer);
            }
        }

        // Add or update stems in new cue
        for (layer, config) in &cue.stems {
            let needs_new = self.active_stems·get(layer)
                ·map(|s| s.asset_id != config.asset_id)
                ·unwrap_or(true);

            if needs_new {
                // Stop old stem if different asset
                if let Some(old) = self.active_stems·get(layer) {
                    self.requests·push(MusicRequest::StopStem(
                        old.asset_id·clone(),
                        cue.crossfade_ms
                    ));
                }

                // Start new stem
                self.requests·push(MusicRequest::PlayStem(
                    config.asset_id·clone(),
                    cue.crossfade_ms
                ));

                self.active_stems·insert(layer·clone(), StemState {
                    asset_id: config.asset_id·clone(),
                    current_volume: 0.0,
                    target_volume: config.volume,
                    fade_rate: config.volume / (cue.crossfade_ms as f32 / 1000.0),
                });
            } else {
                // Just update volume
                if let Some(state) = self.active_stems·get_mut(layer) {
                    state.target_volume = config.volume;
                    state.fade_rate = 0.5; // Default fade rate for volume changes
                }
            }
        }
    }

    /// Set combat mode
    pub fn set_combat_mode(mut self, enabled: bool) {
        self.combat_mode = enabled;

        if enabled {
            self·set_cue("combat");
        } else {
            self·set_cue("exploration");
        }
    }

    /// Set dialogue mode
    pub fn set_dialogue_mode(mut self, enabled: bool) {
        self.dialogue_mode = enabled;

        if enabled && !self.combat_mode {
            // Reduce intensity during dialogue
            self.target_intensity = 0.5;
        } else if !enabled && !self.combat_mode {
            self.target_intensity = 0.6;
        }
    }

    /// Play a stinger
    pub fn play_stinger(mut self, stinger_id: &str) {
        self.requests·push(MusicRequest::PlayStem(stinger_id.to_string(), 0));
    }

    /// Drain pending requests
    pub fn drain_requests(mut self) -> Vec<MusicRequest>! {
        std::mem::take(&mut self.requests)
    }

    /// Silence all music
    pub fn silence(mut self) {
        self·set_cue("silence");
    }

    /// Set intensity directly
    pub fn set_intensity(mut self, intensity: f32) {
        self.target_intensity = intensity·clamp(0.0, 1.0);
    }
}
