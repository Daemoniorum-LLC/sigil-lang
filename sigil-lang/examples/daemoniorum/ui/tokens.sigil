/// Animation keyframes for game effects
pub mod animations {
    pub const PULSE_SLOW: &'static str = "pulse 3s ease-in-out infinite";
    pub const PULSE_FAST: &'static str = "pulse 1s ease-in-out infinite";
    pub const GLOW_PULSE: &'static str = "glow-pulse 2s ease-in-out infinite";
    pub const SHAKE: &'static str = "shake 0.5s ease-in-out";
    pub const GLITCH: &'static str = "glitch 0.3s steps(2) infinite";
    pub const FLOAT: &'static str = "float 3s ease-in-out infinite";

    pub const KEYFRAMES_GLOW_PULSE: &'static str = r#"
        @keyframes glow-pulse {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }
    "#;

    pub const KEYFRAMES_SHAKE: &'static str = r#"
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-4px); }
            75% { transform: translateX(4px); }
        }
    "#;

    pub const KEYFRAMES_GLITCH: &'static str = r#"
        @keyframes glitch {
            0% { transform: translate(0); }
            25% { transform: translate(-2px, 1px); }
            50% { transform: translate(2px, -1px); }
            75% { transform: translate(-1px, 2px); }
            100% { transform: translate(1px, -2px); }
        }
    "#;

    pub const KEYFRAMES_FLOAT: &'static str = r#"
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
    "#;
}

