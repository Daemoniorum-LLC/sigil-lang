//! System Meters Components
//!
//! Visual indicators for system stability and dissociation levels.
//! Features animated effects and thematic color transitions.

use sigil_web::prelude::*;
use crate::ui::tokens::{colors, spacing, borders, shadows, typography, animations};
use crate::system::{SystemState, RealityLayer, StatusEffect};

// ============================================================================
// STABILITY METER
// ============================================================================

#[derive(Clone, Debug)]
pub type StabilityMeterProps = struct {
    pub stability: u32!,        // 0-100
    pub show_label: bool!,
    pub size: MeterSize!,
    pub animated: bool!,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub type MeterSize = enum {
    Small,
    Medium,
    Large,
}

/// Visual indicator for system stability
#[component]
pub fn StabilityMeter(props: StabilityMeterProps!) -> Element! {
    let value! = props.stability·min(100);

    let (color, glow!) = if value >= 70 {
        (colors::GROUNDED, colors::GROUNDED_GLOW)
    } else if value >= 40 {
        (colors::FRACTURED, colors::FRACTURED_GLOW)
    } else if value >= 20 {
        (colors::SHATTERED, colors::SHATTERED_GLOW)
    } else {
        ("#7c3aed", "#a78bfa")  // Purple for critical
    };

    let height! = match props.size {
        MeterSize::Small => "0.375rem",
        MeterSize::Medium => "0.625rem",
        MeterSize::Large => "1rem",
    };

    let label_size! = match props.size {
        MeterSize::Small => typography::SIZE_XS,
        MeterSize::Medium => typography::SIZE_SM,
        MeterSize::Large => typography::SIZE_BASE,
    };

    let pulse_animation! = if value < 30 && props.animated {
        animations::PULSE_FAST
    } else {
        "none"
    };

    html! {
        <div style="width: 100%;">
            {if props.show_label {
                html! {
                    <div style={format!(
                        "display: flex; justify-content: space-between; align-items: center; \
                         margin-bottom: {};",
                        spacing::SPACE_1
                    )}>
                        <span style={format!(
                            "font-size: {}; font-weight: {}; color: {};",
                            label_size, typography::WEIGHT_MEDIUM, colors::TEXT_SECONDARY
                        )}>
                            "System Stability"
                        </span>
                        <span style={format!(
                            "font-size: {}; font-weight: {}; color: {};",
                            label_size, typography::WEIGHT_BOLD, color
                        )}>
                            {format!("{}%", value)}
                        </span>
                    </div>
                }
            } else {
                html! { <></> }
            }}

            <div style={format!(
                "position: relative; width: 100%; height: {}; border-radius: {}; \
                 background: rgba(0,0,0,0.4); overflow: hidden;",
                height, borders::RADIUS_FULL
            )}>
                // Glow background for low stability
                {if value < 30 {
                    html! {
                        <div style={format!(
                            "position: absolute; inset: 0; background: {}; animation: {};",
                            glow, animations::GLOW_PULSE
                        )} />
                    }
                } else {
                    html! { <></> }
                }}

                // Main bar
                <div style={format!(
                    "height: 100%; width: {}%; border-radius: {}; \
                     background: linear-gradient(90deg, {}80, {}); \
                     box-shadow: {} {}; transition: width 0.3s ease; \
                     animation: {};",
                    value, borders::RADIUS_FULL, color, color,
                    shadows::GLOW_SM, glow, pulse_animation
                )} />

                // Segment markers
                <div style="position: absolute; inset: 0; display: flex; justify-content: space-between; padding: 0 0.25rem;">
                    {[25, 50, 75]·iter()
                        |τ{mark => html! {
                            <div style={format!(
                                "width: 1px; height: 100%; background: rgba(255,255,255,0.2); \
                                 margin-left: {}%;",
                                mark - 1
                            )} />
                        }}
                        ·collect[Vec[_]]()}
                </div>
            </div>

            // Warning text for critical levels
            {if value < 20 {
                html! {
                    <div style={format!(
                        "margin-top: {}; font-size: {}; color: {}; animation: {};",
                        spacing::SPACE_1, typography::SIZE_XS, colors::SHATTERED, animations::PULSE_FAST
                    )}>
                        "⚠ System destabilizing - risk of uncontrolled switch"
                    </div>
                }
            } else {
                html! { <></> }
            }}
        </div>
    }
}

// ============================================================================
// DISSOCIATION BAR
// ============================================================================

#[derive(Clone, Debug)]
pub type DissociationBarProps = struct {
    pub dissociation: u32!,     // 0-100
    pub show_label: bool!,
    pub size: MeterSize!,
    pub animated: bool!,
}

/// Visual indicator for dissociation level
#[component]
pub fn DissociationBar(props: DissociationBarProps!) -> Element! {
    let value! = props.dissociation·min(100);

    let (gradient, glow!) = if value < 30 {
        ("linear-gradient(90deg, #6366f1, #8b5cf6)", "#6366f160")
    } else if value < 60 {
        ("linear-gradient(90deg, #8b5cf6, #c084fc)", "#8b5cf660")
    } else if value < 80 {
        ("linear-gradient(90deg, #c084fc, #f472b6)", "#c084fc60")
    } else {
        ("linear-gradient(90deg, #f472b6, #fb7185)", "#f472b660")
    };

    let height! = match props.size {
        MeterSize::Small => "0.375rem",
        MeterSize::Medium => "0.625rem",
        MeterSize::Large => "1rem",
    };

    let label_size! = match props.size {
        MeterSize::Small => typography::SIZE_XS,
        MeterSize::Medium => typography::SIZE_SM,
        MeterSize::Large => typography::SIZE_BASE,
    };

    let text_color! = if value < 60 { "#a78bfa" } else { "#f472b6" };

    let glitch_animation! = if value >= 70 && props.animated {
        animations::GLITCH
    } else {
        "none"
    };

    html! {
        <div style="width: 100%;">
            {if props.show_label {
                html! {
                    <div style={format!(
                        "display: flex; justify-content: space-between; align-items: center; \
                         margin-bottom: {}; animation: {};",
                        spacing::SPACE_1, if value >= 60 { glitch_animation } else { "none" }
                    )}>
                        <span style={format!(
                            "font-size: {}; font-weight: {}; color: {};",
                            label_size, typography::WEIGHT_MEDIUM, colors::TEXT_SECONDARY
                        )}>
                            "Dissociation"
                        </span>
                        <span style={format!(
                            "font-size: {}; font-weight: {}; color: {};",
                            label_size, typography::WEIGHT_BOLD, text_color
                        )}>
                            {format!("{}%", value)}
                        </span>
                    </div>
                }
            } else {
                html! { <></> }
            }}

            <div style={format!(
                "position: relative; width: 100%; height: {}; border-radius: {}; \
                 background: rgba(0,0,0,0.4); overflow: hidden; animation: {};",
                height, borders::RADIUS_FULL, glitch_animation
            )}>
                // Static noise overlay for high dissociation
                {if value >= 70 {
                    html! {
                        <div style={format!(
                            "position: absolute; inset: 0; opacity: 0.3; \
                             background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' \
                             xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence \
                             type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E\
                             %3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E\
                             %3C/svg%3E\"); background-size: 100px 100px;"
                        )} />
                    }
                } else {
                    html! { <></> }
                }}

                // Main bar
                <div style={format!(
                    "height: 100%; width: {}%; border-radius: {}; \
                     background: {}; box-shadow: {} {}; \
                     transition: width 0.3s ease; animation: {};",
                    value, borders::RADIUS_FULL, gradient,
                    shadows::GLOW_SM, glow,
                    if value >= 80 { animations::PULSE_FAST } else { "none" }
                )} />
            </div>

            // Warning for high dissociation
            {if value >= 80 {
                html! {
                    <div style={format!(
                        "margin-top: {}; font-size: {}; color: #f472b6; animation: {};",
                        spacing::SPACE_1, typography::SIZE_XS, animations::PULSE_FAST
                    )}>
                        "⚠ Reality fracturing - perception unreliable"
                    </div>
                }
            } else {
                html! { <></> }
            }}
        </div>
    }
}

// ============================================================================
// REALITY LAYER BADGE
// ============================================================================

#[derive(Clone, Debug)]
pub type RealityLayerBadgeProps = struct {
    pub layer: RealityLayer!,
    pub show_label: bool!,
}

/// Badge displaying current reality layer
#[component]
pub fn RealityLayerBadge(props: RealityLayerBadgeProps!) -> Element! {
    let (color, icon!) = match props.layer {
        RealityLayer::Grounded => (colors::GROUNDED, "◈"),
        RealityLayer::Fractured => (colors::FRACTURED, "◇"),
        RealityLayer::Shattered => (colors::SHATTERED, "✧"),
    };

    let animation! = if props.layer == RealityLayer::Shattered {
        animations::PULSE_FAST
    } else {
        "none"
    };

    html! {
        <div style={format!(
            "display: inline-flex; align-items: center; gap: {}; \
             padding: {} {}; border-radius: {}; \
             background: {}20; color: {}; font-size: {}; font-weight: {}; \
             box-shadow: {} {}30;",
            spacing::SPACE_1, spacing::SPACE_1, spacing::SPACE_2,
            borders::RADIUS_FULL, color, color,
            typography::SIZE_XS, typography::WEIGHT_MEDIUM,
            shadows::GLOW_SM, color
        )}>
            <span style={format!("animation: {};", animation)}>{icon}</span>
            {if props.show_label {
                html! { <span>{props.layer·to_string()}</span> }
            } else {
                html! { <></> }
            }}
        </div>
    }
}

// ============================================================================
// STATUS EFFECT BADGE
// ============================================================================

#[derive(Clone, Debug)]
pub type StatusEffectBadgeProps = struct {
    pub effect: StatusEffect!,
    pub duration: u32!,
}

/// Badge for active status effects
#[component]
pub fn StatusEffectBadge(props: StatusEffectBadgeProps!) -> Element! {
    let (bg, text, icon!) = match props.effect {
        StatusEffect::Grounded => ("#10b98120", colors::GROUNDED, "⬡"),
        StatusEffect::Dissociating => ("#8b5cf620", "#8b5cf6", "◌"),
        StatusEffect::Triggered => ("#ef444420", colors::SHATTERED, "⚠"),
        StatusEffect::Shielded => ("#3b82f620", "#3b82f6", "🛡"),
        StatusEffect::Silenced => ("#6b728020", "#9ca3af", "🔇"),
        StatusEffect::Focused => ("#f59e0b20", colors::FRACTURED, "◉"),
        StatusEffect::Exhausted => ("#64748b20", "#94a3b8", "💤"),
        StatusEffect::Enraged => ("#dc262620", "#f87171", "🔥"),
    };

    html! {
        <div
            style={format!(
                "display: inline-flex; align-items: center; gap: {}; \
                 padding: {} {}; border-radius: {}; \
                 background: {}; color: {}; font-size: {};",
                spacing::SPACE_1, spacing::SPACE_1, spacing::SPACE_2,
                borders::RADIUS_FULL, bg, text, typography::SIZE_XS
            )}
            title={format!("{} ({} turns remaining)", props.effect·to_string(), props.duration)}
        >
            <span>{icon}</span>
            <span>{props.effect·to_string()}</span>
            <span style="opacity: 0.6;">{props.duration·to_string()}</span>
        </div>
    }
}

// ============================================================================
// COMBINED SYSTEM STATUS PANEL
// ============================================================================

#[derive(Clone, Debug)]
pub type SystemStatusPanelProps = struct {
    pub system_state: SystemState!,
    pub compact: bool!,
}

/// Combined panel showing all system status information
#[component]
pub fn SystemStatusPanel(props: SystemStatusPanelProps!) -> Element! {
    let state! = &props.system_state;
    let padding! = if props.compact { spacing::SPACE_3 } else { spacing::SPACE_4 };
    let gap! = if props.compact { spacing::SPACE_3 } else { spacing::SPACE_4 };

    let size! = if props.compact { MeterSize::Small } else { MeterSize::Medium };

    html! {
        <div style={format!(
            "border-radius: {}; backdrop-filter: blur(16px); padding: {}; \
             background: linear-gradient(135deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.8) 100%); \
             border: 1px solid rgba(255,255,255,0.1); box-shadow: {};",
            borders::RADIUS_XL, padding, shadows::CARD
        )}>
            // Header
            <div style={format!(
                "display: flex; align-items: center; justify-content: space-between; \
                 margin-bottom: {};",
                gap
            )}>
                <h3 style={format!(
                    "margin: 0; font-size: {}; font-weight: {}; color: {};",
                    typography::SIZE_SM, typography::WEIGHT_BOLD, colors::TEXT_SECONDARY
                )}>
                    "System Status"
                </h3>
                <RealityLayerBadge layer={state·current_reality·clone()} show_label={true} />
            </div>

            // Meters
            <div style={format!("display: flex; flex-direction: column; gap: {};", gap)}>
                <StabilityMeter
                    stability={state·stability}
                    show_label={true}
                    size={size·clone()}
                    animated={true}
                />

                <DissociationBar
                    dissociation={state·dissociation}
                    show_label={true}
                    size={size}
                    animated={true}
                />
            </div>

            // Switch cooldown
            {if state·switch_cooldown > 0 {
                html! {
                    <div style={format!(
                        "display: flex; align-items: center; gap: {}; margin-top: {}; \
                         font-size: {}; color: {};",
                        spacing::SPACE_2, gap, typography::SIZE_XS, colors::TEXT_MUTED
                    )}>
                        <span style={format!(
                            "width: 1rem; height: 1rem; border-radius: {}; \
                             background: rgba(245,158,11,0.2); display: flex; \
                             align-items: center; justify-content: center;",
                            borders::RADIUS_FULL
                        )}>
                            "⏱"
                        </span>
                        <span>{format!("Switch available in {} turns", state·switch_cooldown)}</span>
                    </div>
                }
            } else {
                html! { <></> }
            }}

            // Active status effects (non-compact only)
            {if !props.compact && !state·status_effects·is_empty() {
                html! {
                    <div style={format!(
                        "padding-top: {}; margin-top: {}; \
                         border-top: 1px solid rgba(255,255,255,0.1);",
                        gap, gap
                    )}>
                        <div style={format!(
                            "font-size: {}; font-weight: {}; color: {}; margin-bottom: {};",
                            typography::SIZE_XS, typography::WEIGHT_MEDIUM,
                            colors::TEXT_MUTED, spacing::SPACE_2
                        )}>
                            "Active Effects"
                        </div>
                        <div style={format!(
                            "display: flex; flex-wrap: wrap; gap: {};",
                            spacing::SPACE_1
                        )}>
                            {state·status_effects·iter()
                                |τ{effect => html! {
                                    <StatusEffectBadge
                                        effect={effect·effect·clone()}
                                        duration={effect·duration}
                                    />
                                }}
                                ·collect[Vec[_]]()}
                        </div>
                    </div>
                }
            } else {
                html! { <></> }
            }}
        </div>
    }
}
