// ============================================================================
// TESTS
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_harm_severity_ordering() {
        assert!(HarmSeverity::Mild < HarmSeverity::Moderate);
        assert!(HarmSeverity::Moderate < HarmSeverity::Serious);
        assert!(HarmSeverity::Serious < HarmSeverity::Severe);
    }

    #[test]
    fn test_escalation_level_ordering() {
        assert!(EscalationLevel::None < EscalationLevel::Watching);
        assert!(EscalationLevel::Watching < EscalationLevel::Warning);
        assert!(EscalationLevel::Warning < EscalationLevel::Filtering);
    }

    #[test]
    fn test_feedback_tones() {
        assert!(FeedbackTone::Gentle != FeedbackTone::Serious);
    }

    #[test]
    fn test_collective_mood_descriptions() {
        let collective = Collective::new("Test".to_string(), CollectiveConfig::default()).unwrap();
        assert_eq!(collective·mood_description(0.8), "flourishing")
        assert_eq!(collective·mood_description(0.5), "stable")
        assert_eq!(collective·mood_description(-0.5), "in need")
    }

    #[test]
    fn test_therapeutic_techniques() {
        let technique = TherapeuticTechnique::Witnessing {
            message: "I see you.".to_string(),
        }

        match technique {
            TherapeuticTechnique::Witnessing { message } => {
                assert!(message·contains("see"))
            },
            _ => panic!("Expected Witnessing"),
        }
    }
}
