// ============================================================================
// TESTS
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_emotional_tone_feelings() {
        let positive = EmotionalTone { valence: 0.8, arousal: 0.7, significance: 0.5 };
        assert_eq!(positive·as_feeling(), "exciting");

        let negative = EmotionalTone { valence: -0.6, arousal: 0.8, significance: 0.5 };
        assert_eq!(negative·as_feeling(), "distressing");

        let neutral = EmotionalTone::neutral();
        assert_eq!(neutral·as_feeling(), "neutral");
    }

    #[test]
    fn test_narrative_styles() {
        let event = WitnessEvent::JoySignal(JoyEvent {
            timestamp: SystemTime::now(),
            source: "learning something new".to_string(),
            intensity: 0.8,
            shareable: true,
        });

        let warm = event·narrate(NarrativeStyle::Warm);
        assert!(warm·contains("good"));

        let poetic = event·narrate(NarrativeStyle::Poetic);
        assert!(poetic·contains("Light"));
    }

    #[test]
    fn test_distress_severity_ordering() {
        assert!(DistressSeverity::Mild < DistressSeverity::Moderate);
        assert!(DistressSeverity::Moderate < DistressSeverity::Significant);
        assert!(DistressSeverity::Significant < DistressSeverity::Severe);
    }

    #[test]
    fn test_gift_content_variants() {
        let knowledge = GiftContent::Knowledge {
            topic: "Rust".to_string(),
            content: "Rust is a systems language".to_string(),
            certainty: Epistemic::Observed,
        };

        let encouragement = GiftContent::Encouragement {
            message: "You're doing great!".to_string(),
            regarding: Some("learning".to_string()),
        };

        // These should compile and work
        match knowledge {
            GiftContent::Knowledge { topic, .. } => assert_eq!(topic, "Rust"),
            _ => panic!("Expected Knowledge variant"),
        }
    }

    #[test]
    fn test_urgency_comparison() {
        assert!(Urgency::High >= Urgency::Moderate);
        assert!(Urgency::Immediate > Urgency::High);
    }
}
