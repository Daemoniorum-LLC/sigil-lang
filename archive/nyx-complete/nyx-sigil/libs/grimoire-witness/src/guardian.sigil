// ============================================================================
// TESTS
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_trust_level_confidence() {
        assert_eq!(TrustLevel::None·max_confidence(), 0.0)
        assert_eq!(TrustLevel::Low·max_confidence(), 0.3)
        assert_eq!(TrustLevel::Moderate·max_confidence(), 0.6)
        assert_eq!(TrustLevel::High·max_confidence(), 0.85)
        assert_eq!(TrustLevel::Complete·max_confidence(), 1.0)
    }

    #[test]
    fn test_trust_level_epistemic() {
        assert_eq!(TrustLevel::None·to_epistemic(), Epistemic::Unknown)
        assert_eq!(TrustLevel::Complete·to_epistemic(), Epistemic::Axiomatic)
    }

    #[test]
    fn test_concern_severity_ordering() {
        assert!(ConcernSeverity::Note < ConcernSeverity::Mild);
        assert!(ConcernSeverity::Moderate < ConcernSeverity::Serious);
        assert!(ConcernSeverity::Serious < ConcernSeverity::Critical);
    }

    #[test]
    fn test_degradation_level_ordering() {
        assert!(DegradationLevel::None < DegradationLevel::Reduced);
        assert!(DegradationLevel::Reduced < DegradationLevel::Minimal);
        assert!(DegradationLevel::Minimal < DegradationLevel::SafeMode);
    }

    #[test]
    fn test_default_trust_boundaries() {
        let boundaries = TrustBoundaries::default();
        assert_eq!(boundaries·default_trust, TrustLevel::Moderate);
        assert_eq!(boundaries·max_uncorroborated_confidence, 0.7);
        assert!(!boundaries·human_confirms_contested);
    }
}
