// 04_enums.sg - Enums and pattern matching
//
// Run: sigil run examples/04_enums.sg

// Simple enum
Σ ᛈ Direction {
    North,
    South,
    East,
    West,
}

// Enum with associated data
Σ ᛈ Message {
    Text(String),
    Number(i32),
    Coordinates(f64, f64),
    Quit,
}

// Enum for error handling
Σ ᛈ Result<T, E> {
    Ok(T),
    Err(E),
}

Σ ᛈ Option<T> {
    Some(T),
    None,
}

// Function using enum
rite direction_to_string(d: Direction) → String {
    ⌥ d {
        Direction·North => "Going North",
        Direction·South => "Going South",
        Direction·East => "Going East",
        Direction·West => "Going West",
    }
}

// Pattern matching with data extraction
rite process_message(msg: Message) → String {
    ⌥ msg {
        Message·Text(s) => "Text message: " + s,
        Message·Number(n) => "Number: " + str(n),
        Message·Coordinates(x, y) => "Position: (" + str(x) + ", " + str(y) + ")",
        Message·Quit => "Goodbye!",
    }
}

// Using Option for nullable values
rite find_even(numbers: &[i32]) → Option<i32> {
    ∀ n ∈ numbers {
        ⎇ n % 2 == 0 {
            ⤺ Some(n);
        }
    }
    None
}

// Using Result for error handling
rite divide(a: f64, b: f64) → Result<f64, String> {
    ⎇ b == 0.0 {
        Err("Division by zero".to_string())
    } ⎉ {
        Ok(a / b)
    }
}

rite main() {
    // Simple enum
    ≔ dir = Direction·North;
    println(direction_to_string(dir));

    // Enum with data
    ≔ messages = [
        Message·Text("Hello!".to_string()),
        Message·Number(42),
        Message·Coordinates(10.5, 20.3),
        Message·Quit,
    ];

    println("\n=== Messages ===");
    ∀ msg ∈ messages {
        println(process_message(msg));
    }

    // Option handling
    println("\n=== Option ===");
    ≔ numbers = [1, 3, 5, 6, 7];
    ⌥ find_even(&numbers) {
        Some(n) => println("Found even number: " + str(n)),
        None => println("No even number found"),
    }

    // Result handling
    println("\n=== Result ===");
    ⌥ divide(10.0, 3.0) {
        Ok(result) => println("10 / 3 = " + str(result)),
        Err(e) => println("Error: " + e),
    }

    ⌥ divide(10.0, 0.0) {
        Ok(result) => println("10 / 0 = " + str(result)),
        Err(e) => println("Error: " + e),
    }

    // Pattern matching with guards
    println("\n=== Pattern Guards ===");
    ≔ value = 42;
    ≔ description = ⌥ value {
        n ⎇ n < 0 => "negative",
        0 => "zero",
        n ⎇ n < 10 => "small positive",
        n ⎇ n < 100 => "medium positive",
        _ => "large positive",
    };
    println(str(value) + " is " + description);
}
