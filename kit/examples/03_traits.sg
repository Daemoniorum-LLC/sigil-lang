// 03_traits.sg - Traits and polymorphism
//
// Run: sigil run examples/03_traits.sg

// Define a trait
trait Drawable {
    λ draw(&this) → String;
    λ area(&this) → f64;
}

// Define a trait with default implementation
trait Describable {
    λ name(&this) → String;

    // Default implementation
    λ describe(&this) → String {
        "A " + this.name()
    }
}

// Struct implementations
Σ Circle {
    radius: f64,
}

Σ Square {
    side: f64,
}

// Implement Drawable for Circle
⊢ Drawable for Circle {
    λ draw(&this) → String {
        "○ (circle with radius " + str(this.radius) + ")"
    }

    λ area(&this) → f64 {
        3.14159 * this.radius * this.radius
    }
}

// Implement Drawable for Square
⊢ Drawable for Square {
    λ draw(&this) → String {
        "□ (square with side " + str(this.side) + ")"
    }

    λ area(&this) → f64 {
        this.side * this.side
    }
}

// Implement Describable for both
⊢ Describable for Circle {
    λ name(&this) → String {
        "circle"
    }
}

⊢ Describable for Square {
    λ name(&this) → String {
        "square"
    }

    // Override default describe
    λ describe(&this) → String {
        "A perfect square with side " + str(this.side)
    }
}

// Generic function constrained by trait
λ print_shape<T: Drawable>(shape: &T) {
    println("Shape: " + shape.draw());
    println("Area: " + str(shape.area()));
}

// Function taking multiple trait bounds
λ full_description<T: Drawable + Describable>(shape: &T) → String {
    shape.describe() + " - " + shape.draw()
}

λ main() {
    ≔ circle = Circle { radius: 5.0 };
    ≔ square = Square { side: 4.0 };

    println("=== Circle ===");
    print_shape(&circle);
    println(circle.describe());

    println("\n=== Square ===");
    print_shape(&square);
    println(square.describe());

    println("\n=== Full Descriptions ===");
    println(full_description(&circle));
    println(full_description(&square));
}
