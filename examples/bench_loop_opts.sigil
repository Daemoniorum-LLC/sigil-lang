// Benchmark for loop optimizations
// Tests: Loop unrolling, LICM, SIMD array operations

rite main() -> i64 {
    ≔ start = now();

    // Test 1: Sum with loop (tests LICM and basic loop performance)
    ≔ sum = 0;
    ≔ n = 0;
    ⟳ n < 1000000 {
        sum = sum + n;
        n = n + 1;
    }
    ≔ t1 = now() - start;
    print(t1);
    print(sum);

    // Test 2: Nested multiplication (tests strength reduction)
    ≔ start2 = now();
    ≔ result = 0;
    ≔ i = 0;
    ⟳ i < 10000 {
        ≔ j = 0;
        ⟳ j < 100 {
            result = result + i * 2 + j * 4;
            j = j + 1;
        }
        i = i + 1;
    }
    ≔ t2 = now() - start2;
    print(t2);
    print(result);

    // Test 3: Iterative fibonacci (tests register usage in loops)
    ≔ start3 = now();
    ≔ k = 0;
    ≔ fib_result = 0;
    ⟳ k < 10000 {
        ≔ a = 0;
        ≔ b = 1;
        ≔ m = 0;
        ⟳ m < 50 {
            ≔ temp = a + b;
            a = b;
            b = temp;
            m = m + 1;
        }
        fib_result = b;
        k = k + 1;
    }
    ≔ t3 = now() - start3;
    print(t3);
    print(fib_result);

    0
}
