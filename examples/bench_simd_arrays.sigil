// Benchmark for SIMD array operations

rite main() -> i64 {
    // Create array with 100k elements using sigil_array_new
    ≔ arr = sigil_array_new(100000);
    ≔ k = 0;
    ⟳ k < 100000 {
        sigil_array_set(arr, k, k);
        k = k + 1;
    }

    // Test 1: Array sum using SIMD
    ≔ start1 = now();
    ≔ sum = sigil_array_sum(arr);
    ≔ t1 = now() - start1;
    print(t1);
    print(sum);

    // Test 2: Scale array by 2
    ≔ start2 = now();
    sigil_array_scale(arr, 2);
    ≔ t2 = now() - start2;
    print(t2);

    // Test 3: Find min/max
    ≔ start3 = now();
    ≔ min_val = sigil_array_min(arr);
    ≔ max_val = sigil_array_max(arr);
    ≔ t3 = now() - start3;
    print(t3);
    print(min_val);
    print(max_val);

    0
}
