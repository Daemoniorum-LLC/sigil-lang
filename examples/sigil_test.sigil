// =============================================================================
// SIGIL TEST FRAMEWORK - Designed for AI Agents
// =============================================================================
// Unlike human test frameworks that focus on pretty output and DSLs,
// this framework prioritizes:
// - Structured, machine-readable results
// - Rich metadata for failure analysis
// - Programmatic test generation
// - Full introspection of test state
// - Evidence-based assertions (leveraging Sigil's type system)
// =============================================================================

// --- CORE DATA STRUCTURES ---
// All results are structured data, not strings

Σ AssertionRecord {
    assertion_type: string,   // "eq", "ne", "lt", "gt", "contains", etc.
    passed: bool,
    expected: any,
    actual: any,
    message: string,
    timestamp_ms: int,
    index: int                // Position in test's assertion sequence
}

Σ TestRecord {
    id: string,               // Unique identifier for this test run
    name: string,
    description: string,
    tags: array,              // For filtering/categorization
    passed: bool,
    duration_ms: float,
    assertions: array,        // Array of AssertionRecord
    failure_reason: string,   // null if passed
    context: map,             // Arbitrary metadata
    evidence_level: string    // "verified", "tested", "uncertain"
}

Σ SuiteRecord {
    id: string,
    name: string,
    tests: array,             // Array of TestRecord
    passed_count: int,
    failed_count: int,
    skipped_count: int,
    total_duration_ms: float,
    metadata: map
}

// --- TEST CONTEXT ---
// Mutable state for current test execution

≔ _test_context = {
    current_test: null,
    assertions: [],
    assertion_index: 0,
    context_data: {},
    start_time: 0
};

// --- ASSERTION PRIMITIVES ---
// These record structured data, not just pass/fail

rite _record_assertion(type: string, passed: bool, expected: any, actual: any, msg: string) {
    ≔ record = {
        assertion_type: type,
        passed: passed,
        expected: expected,
        actual: actual,
        message: msg,
        timestamp_ms: now(),
        index: _test_context.assertion_index
    };
    _test_context.assertions = push(_test_context.assertions, record);
    _test_context.assertion_index = _test_context.assertion_index + 1;
    ⤺ record;
}

// Equality assertion - returns the assertion record
rite expect_eq(actual: any, expected: any) -> map {
    ≔ passed = deep_eq(actual, expected);
    ≔ msg = ⎇ passed {
        "values are equal"
    } ⎉ {
        format("expected {} but got {}", [inspect(expected), inspect(actual)])
    };
    ⤺ _record_assertion("eq", passed, expected, actual, msg);
}

rite expect_ne(actual: any, expected: any) -> map {
    ≔ passed = !deep_eq(actual, expected);
    ≔ msg = ⎇ passed {
        "values are not equal"
    } ⎉ {
        format("expected values to differ but both are {}", [inspect(actual)])
    };
    ⤺ _record_assertion("ne", passed, expected, actual, msg);
}

rite expect_lt(actual: any, expected: any) -> map {
    ≔ cmp = compare(actual, expected);
    ≔ passed = cmp < 0;
    ≔ msg = ⎇ passed {
        format("{} < {}", [inspect(actual), inspect(expected)])
    } ⎉ {
        format("expected {} < {} but comparison returned {}", [inspect(actual), inspect(expected), cmp])
    };
    ⤺ _record_assertion("lt", passed, expected, actual, msg);
}

rite expect_gt(actual: any, expected: any) -> map {
    ≔ cmp = compare(actual, expected);
    ≔ passed = cmp > 0;
    ≔ msg = ⎇ passed {
        format("{} > {}", [inspect(actual), inspect(expected)])
    } ⎉ {
        format("expected {} > {} but comparison returned {}", [inspect(actual), inspect(expected), cmp])
    };
    ⤺ _record_assertion("gt", passed, expected, actual, msg);
}

rite expect_le(actual: any, expected: any) -> map {
    ≔ cmp = compare(actual, expected);
    ≔ passed = cmp <= 0;
    ⤺ _record_assertion("le", passed, expected, actual,
        ⎇ passed { "comparison satisfied" } ⎉ { "expected <= relationship" });
}

rite expect_ge(actual: any, expected: any) -> map {
    ≔ cmp = compare(actual, expected);
    ≔ passed = cmp >= 0;
    ⤺ _record_assertion("ge", passed, expected, actual,
        ⎇ passed { "comparison satisfied" } ⎉ { "expected >= relationship" });
}

rite expect_true(value: any) -> map {
    ≔ passed = is_truthy(value);
    ⤺ _record_assertion("truthy", passed, true, value,
        ⎇ passed { "value is truthy" } ⎉ { format("{} is not truthy", [inspect(value)]) });
}

rite expect_false(value: any) -> map {
    ≔ passed = !is_truthy(value);
    ⤺ _record_assertion("falsy", passed, false, value,
        ⎇ passed { "value is falsy" } ⎉ { format("{} is not falsy", [inspect(value)]) });
}

rite expect_null(value: any) -> map {
    ≔ passed = is_null(value);
    ⤺ _record_assertion("null", passed, null, value,
        ⎇ passed { "value is null" } ⎉ { format("expected null, got {}", [type_of(value)]) });
}

rite expect_not_null(value: any) -> map {
    ≔ passed = !is_null(value);
    ⤺ _record_assertion("not_null", passed, "non-null", value,
        ⎇ passed { "value is not null" } ⎉ { "value is unexpectedly null" });
}

rite expect_type(value: any, expected_type: string) -> map {
    ≔ actual_type = type_of(value);
    ≔ passed = is_type(value, expected_type);
    ⤺ _record_assertion("type", passed, expected_type, actual_type,
        ⎇ passed { format("value is {}", [expected_type]) }
        ⎉ { format("expected type {} but got {}", [expected_type, actual_type]) });
}

rite expect_contains(collection: any, element: any) -> map {
    ≔ passed = ⌥ type_of(collection) {
        "array" => any(collection, rite(x) { deep_eq(x, element) }),
        "string" => contains(collection, element),
        "map" => has_key(collection, element),
        "set" => set_contains(collection, element),
        _ => false
    };
    ⤺ _record_assertion("contains", passed, element, collection,
        ⎇ passed { "collection contains element" }
        ⎉ { format("{} not found in collection", [inspect(element)]) });
}

rite expect_len(collection: any, expected_len: int) -> map {
    ≔ actual_len = len(collection);
    ≔ passed = actual_len == expected_len;
    ⤺ _record_assertion("len", passed, expected_len, actual_len,
        ⎇ passed { format("length is {}", [expected_len]) }
        ⎉ { format("expected length {} but got {}", [expected_len, actual_len]) });
}

rite expect_match(text: string, pattern: string) -> map {
    ≔ result = match_regex(text, pattern);
    ≔ passed = !is_null(result);
    ⤺ _record_assertion("regex", passed, pattern, text,
        ⎇ passed { format("'{}' matches pattern", [text]) }
        ⎉ { format("'{}' does not match '{}'", [text, pattern]) });
}

rite expect_between(value: any, min: any, max: any) -> map {
    ≔ passed = between(value, min, max);
    ⤺ _record_assertion("between", passed, [min, max], value,
        ⎇ passed { format("{} is in range [{}, {}]", [value, min, max]) }
        ⎉ { format("{} is not in range [{}, {}]", [value, min, max]) });
}

// Error expectation - for testing error handling
rite expect_error(thunk: rite) -> map {
    ≔ error_caught = false;
    ≔ error_msg = "";
    // Try to call the thunk and catch errors
    // Note: This requires try/catch which may need interpreter support
    // For now, we'll use a convention-based approach
    ⤺ _record_assertion("error", true, "error", "error",
        "error expectation recorded");
}

// --- TEST DEFINITION ---
// Tests are defined as structured data with metadata

rite define_test(name: string, description: string, tags: array, test_fn: rite) -> map {
    ⤺ {
        name: name,
        description: description,
        tags: tags,
        test_fn: test_fn,
        enabled: true
    };
}

// Convenience for simple tests
rite test_case(name: string, test_fn: rite) -> map {
    ⤺ define_test(name, "", [], test_fn);
}

// --- TEST EXECUTION ---
// Run tests and collect structured results

rite run_test(test_def: map) -> map {
    // Reset context
    _test_context.current_test = test_def.name;
    _test_context.assertions = [];
    _test_context.assertion_index = 0;
    _test_context.context_data = {};
    _test_context.start_time = now();

    ≔ error_msg = null;
    ≔ passed = true;

    // Execute test
    // Note: Proper try/catch would be ideal here
    test_def.test_fn();

    ≔ duration = now() - _test_context.start_time;

    // Check if any assertions failed
    ≔ failed_assertions = filter(_test_context.assertions, rite(a) { !a.passed });
    ⎇ len(failed_assertions) > 0 {
        passed = false;
        error_msg = first(failed_assertions).message;
    }

    // Determine evidence level based on assertion count and types
    ≔ evidence = ⎇ len(_test_context.assertions) == 0 {
        "untested"
    } ⎉ ⎇ passed && len(_test_context.assertions) > 3 {
        "verified"
    } ⎉ ⎇ passed {
        "tested"
    } ⎉ {
        "failed"
    };

    ⤺ {
        id: uuid(),
        name: test_def.name,
        description: unwrap_or(test_def.description, ""),
        tags: unwrap_or(test_def.tags, []),
        passed: passed,
        duration_ms: duration,
        assertions: _test_context.assertions,
        assertion_count: len(_test_context.assertions),
        passed_assertions: len(filter(_test_context.assertions, rite(a) { a.passed })),
        failed_assertions: len(failed_assertions),
        failure_reason: error_msg,
        context: _test_context.context_data,
        evidence_level: evidence
    };
}

// Run multiple tests
rite run_tests(test_defs: array) -> map {
    ≔ start = now();
    ≔ results = map(test_defs, run_test);
    ≔ duration = now() - start;

    ≔ passed = filter(results, rite(r) { r.passed });
    ≔ failed = filter(results, rite(r) { !r.passed });

    ⤺ {
        id: uuid(),
        name: "test_suite",
        tests: results,
        passed_count: len(passed),
        failed_count: len(failed),
        skipped_count: 0,
        total_count: len(results),
        total_duration_ms: duration,
        success_rate: ⎇ len(results) > 0 { len(passed) / len(results) } ⎉ { 1.0 },
        metadata: {
            timestamp: timestamp(),
            sigil_version: "0.1.0"
        }
    };
}

// --- TEST CONTEXT MANIPULATION ---
// For AI agents to add context during test execution

rite set_context(key: string, value: any) {
    _test_context.context_data = map_set(_test_context.context_data, key, value);
}

rite get_context(key: string) -> any {
    ⤺ map_get(_test_context.context_data, key);
}

// --- OUTPUT FORMATTERS ---
// Structured output for AI consumption

rite format_result_json(result: map) -> string {
    ⤺ json_stringify(result);
}

rite format_suite_json(suite: map) -> string {
    ⤺ json_stringify(suite);
}

// Compact summary for quick parsing
rite format_summary(suite: map) -> map {
    ⤺ {
        passed: suite.passed_count,
        failed: suite.failed_count,
        total: suite.total_count,
        success_rate: suite.success_rate,
        duration_ms: suite.total_duration_ms,
        failed_tests: map(
            filter(suite.tests, rite(t) { !t.passed }),
            rite(t) { { name: t.name, reason: t.failure_reason } }
        )
    };
}

// --- PARAMETERIZED TESTING ---
// AI agents often generate test cases programmatically

rite parameterized_test(name: string, params: array, test_fn: rite) -> array {
    ⤺ map(enumerate(params), rite(item) {
        ≔ idx = item.0;
        ≔ param = item.1;
        ⤺ define_test(
            format("{}[{}]", [name, idx]),
            format("Parameter: {}", [inspect(param)]),
            ["parameterized"],
            rite() { test_fn(param) }
        );
    });
}

// Property-based testing helper
rite property_test(name: string, generator: rite, property: rite, iterations: int) -> map {
    ⤺ define_test(
        name,
        format("Property test with {} iterations", [iterations]),
        ["property"],
        rite() {
            ≔ i = 0;
            ⟳ i < iterations {
                ≔ value = generator();
                ≔ result = property(value);
                set_context(format("iteration_{}", [i]), { input: value, result: result });
                expect_true(result);
                i = i + 1;
            }
        }
    );
}

// --- CONTRACT TESTING ---
// For testing interfaces/contracts between components

rite contract_test(name: string, preconditions: array, action: rite, postconditions: array) -> map {
    ⤺ define_test(
        name,
        "Contract-based test",
        ["contract"],
        rite() {
            // Check preconditions
            each(enumerate(preconditions), rite(item) {
                ≔ idx = item.0;
                ≔ pre = item.1;
                set_context(format("precondition_{}", [idx]), pre());
                expect_true(pre());
            });

            // Execute action
            ≔ result = action();
            set_context("action_result", result);

            // Check postconditions
            each(enumerate(postconditions), rite(item) {
                ≔ idx = item.0;
                ≔ post = item.1;
                set_context(format("postcondition_{}", [idx]), post(result));
                expect_true(post(result));
            });
        }
    );
}

// --- COMPARATIVE TESTING ---
// For testing that two implementations produce same results

rite comparative_test(name: string, inputs: array, impl_a: rite, impl_b: rite) -> map {
    ⤺ define_test(
        name,
        "Comparative test between two implementations",
        ["comparative"],
        rite() {
            each(enumerate(inputs), rite(item) {
                ≔ idx = item.0;
                ≔ input = item.1;
                ≔ result_a = impl_a(input);
                ≔ result_b = impl_b(input);
                set_context(format("input_{}", [idx]), input);
                set_context(format("result_a_{}", [idx]), result_a);
                set_context(format("result_b_{}", [idx]), result_b);
                expect_eq(result_a, result_b);
            });
        }
    );
}

// --- SNAPSHOT TESTING ---
// For AI agents to verify output stability

rite snapshot_test(name: string, compute: rite, expected_snapshot: any) -> map {
    ⤺ define_test(
        name,
        "Snapshot comparison test",
        ["snapshot"],
        rite() {
            ≔ actual = compute();
            set_context("actual_snapshot", actual);
            set_context("expected_snapshot", expected_snapshot);
            expect_eq(actual, expected_snapshot);
        }
    );
}

// --- BENCHMARK INTEGRATION ---
// Performance testing with structured output

rite benchmark_test(name: string, setup: rite, benchmark_fn: rite, teardown: rite, thresholds: map) -> map {
    ⤺ define_test(
        name,
        "Performance benchmark test",
        ["benchmark", "performance"],
        rite() {
            // Setup
            ≔ state = setup();
            set_context("setup_state", state);

            // Run benchmark
            ≔ result = measure(rite() { benchmark_fn(state) }, 10);
            ≔ stats = result.1;
            set_context("benchmark_stats", stats);

            // Teardown
            teardown(state);

            // Check thresholds
            ⎇ has_key(thresholds, "max_avg_ms") {
                expect_lt(stats.avg_ms, thresholds.max_avg_ms);
            }
            ⎇ has_key(thresholds, "max_stddev_ms") {
                expect_lt(stats.stddev_ms, thresholds.max_stddev_ms);
            }
        }
    );
}

// --- TEST FILTERING ---
// For AI agents to run subsets of tests

rite filter_by_tag(tests: array, tag: string) -> array {
    ⤺ filter(tests, rite(t) {
        any(unwrap_or(t.tags, []), rite(tg) { tg == tag })
    });
}

rite filter_by_name(tests: array, pattern: string) -> array {
    ⤺ filter(tests, rite(t) {
        !is_null(match_regex(t.name, pattern))
    });
}

rite exclude_by_tag(tests: array, tag: string) -> array {
    ⤺ filter(tests, rite(t) {
        !any(unwrap_or(t.tags, []), rite(tg) { tg == tag })
    });
}

// --- MAIN RUNNER ---
// Entry point that outputs structured JSON

rite run_suite(name: string, tests: array) -> map {
    ≔ suite = run_tests(tests);
    suite.name = name;

    // Output JSON for AI consumption
    println(format_result_json(suite));

    ⤺ suite;
}

// --- EXAMPLE USAGE ---
// Demonstrates the framework for AI agents

rite example_tests() {
    ≔ tests = [
        test_case("arithmetic_addition", rite() {
            expect_eq(2 + 2, 4);
            expect_eq(0 + 0, 0);
            expect_eq(-1 + 1, 0);
        }),

        test_case("string_operations", rite() {
            expect_eq(upper("hello"), "HELLO");
            expect_contains("hello world", "world");
            expect_len("test", 4);
        }),

        test_case("array_operations", rite() {
            ≔ arr = [1, 2, 3, 4, 5];
            expect_len(arr, 5);
            expect_eq(first(arr), 1);
            expect_eq(last(arr), 5);
            expect_eq(sum(arr), 15);
        }),

        test_case("type_checking", rite() {
            expect_type(42, "int");
            expect_type("hello", "string");
            expect_type([1, 2], "array");
            expect_type({}, "map");
        }),

        // Parameterized test example
        parameterized_test("square_is_positive", [1, 2, 3, -1, -2, 0], rite(n) {
            expect_ge(n * n, 0);
        }),

        // Property test example
        property_test("addition_commutative",
            rite() { rand_int(0, 100) },
            rite(n) { n + 0 == n },
            10
        ),

        // Contract test example
        contract_test("list_append_contract",
            [rite() { true }],  // Preconditions
            rite() { push([1, 2, 3], 4) },  // Action
            [rite(result) { len(result) == 4 }, rite(result) { last(result) == 4 }]  // Postconditions
        )
    ];

    // Flatten parameterized tests
    ≔ flat_tests = flatten(map(tests, rite(t) {
        ⎇ is_array(t) { t } ⎉ { [t] }
    }));

    ⤺ run_suite("example_suite", flat_tests);
}

// Export the framework functions
// AI agents can import and use these directly
