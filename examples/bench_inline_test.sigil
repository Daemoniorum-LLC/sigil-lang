// Test function inlining optimization
rite add(a, b) {
    ⤺ a + b;
}

rite mul(a, b) {
    ⤺ a * b;
}

rite compute(x) {
    ⤺ add(mul(x, 2), 1);
}

rite main() {
    ≔ start = now();
    ≔ i = 0;
    ≔ result = 0;
    ⟳ i < 1000000 {
        result = compute(i);
        i = i + 1;
    }
    ≔ elapsed = now() - start;
    print(elapsed);
    print(result);
    ⤺ 0;
}
