// =============================================================================
// SIGIL TEST FRAMEWORK - Simple Version
// =============================================================================

// --- ASSERTIONS ---

rite assert_eq(actual: any, expected: any) {
    ⎇ actual == expected {
        ⤺ yea
    } ⎉ {
        println("  FAIL: expected " + to_string(expected) + " got " + to_string(actual));
        ⤺ nay
    }
}

rite assert_ne(actual: any, expected: any) {
    ⎇ actual != expected {
        ⤺ yea
    } ⎉ {
        println("  FAIL: values should differ");
        ⤺ nay
    }
}

rite assert_lt(actual: any, expected: any) {
    ⎇ actual < expected {
        ⤺ yea
    } ⎉ {
        println("  FAIL: " + to_string(actual) + " not < " + to_string(expected));
        ⤺ nay
    }
}

rite assert_gt(actual: any, expected: any) {
    ⎇ actual > expected {
        ⤺ yea
    } ⎉ {
        println("  FAIL: " + to_string(actual) + " not > " + to_string(expected));
        ⤺ nay
    }
}

rite assert_le(actual: any, expected: any) {
    ⎇ actual <= expected {
        ⤺ yea
    } ⎉ {
        println("  FAIL: not <=");
        ⤺ nay
    }
}

rite assert_ge(actual: any, expected: any) {
    ⎇ actual >= expected {
        ⤺ yea
    } ⎉ {
        println("  FAIL: not >=");
        ⤺ nay
    }
}

rite assert_true(value: any) {
    ⎇ value == yea {
        ⤺ yea
    } ⎉ {
        println("  FAIL: expected true");
        ⤺ nay
    }
}

rite assert_false(value: any) {
    ⎇ value == nay {
        ⤺ yea
    } ⎉ {
        println("  FAIL: expected false");
        ⤺ nay
    }
}

rite assert_not_null(value: any) {
    ⎇ !is_null(value) {
        ⤺ yea
    } ⎉ {
        println("  FAIL: expected non-null");
        ⤺ nay
    }
}

rite assert_type(value: any, expected_type: string) {
    ≔ actual_type = type_of(value);
    ⎇ actual_type == expected_type {
        ⤺ yea
    } ⎉ {
        println("  FAIL: expected type " + expected_type + " got " + actual_type);
        ⤺ nay
    }
}

rite assert_len(collection: any, expected_len: int) {
    ≔ actual_len = len(collection);
    ⎇ actual_len == expected_len {
        ⤺ yea
    } ⎉ {
        println("  FAIL: expected length " + to_string(expected_len) + " got " + to_string(actual_len));
        ⤺ nay
    }
}

rite assert_between(value: any, min_val: any, max_val: any) {
    ⎇ value >= min_val ∧ value <= max_val {
        ⤺ yea
    } ⎉ {
        println("  FAIL: out of range");
        ⤺ nay
    }
}

// --- TEST HELPERS ---

rite test_start(name: string) {
    print("  " + name + "... ");
}

rite test_pass() {
    println("PASS");
}

rite test_fail() {
    println("FAIL");
}

// --- EXAMPLE TESTS ---

rite test_arithmetic() {
    test_start("arithmetic");
    ≔ r = assert_eq(2 + 2, 4) ∧
          assert_eq(10 - 3, 7) ∧
          assert_gt(5, 3) ∧
          assert_lt(2, 8);
    ⎇ r { test_pass(); } ⎉ { test_fail(); }
    ⤺ r
}

rite test_strings() {
    test_start("strings");
    ≔ r = assert_eq(upper("hello"), "HELLO") ∧
          assert_eq(lower("WORLD"), "world") ∧
          assert_len("test", 4);
    ⎇ r { test_pass(); } ⎉ { test_fail(); }
    ⤺ r
}

rite test_arrays() {
    test_start("arrays");
    ≔ arr = [1, 2, 3, 4, 5];
    ≔ r = assert_len(arr, 5) ∧
          assert_eq(arr[0], 1) ∧
          assert_eq(sum(arr), 15);
    ⎇ r { test_pass(); } ⎉ { test_fail(); }
    ⤺ r
}

rite test_types() {
    test_start("types");
    ≔ r = assert_type(42, "I64") ∧
          assert_type("hi", "String") ∧
          assert_type([1, 2], "Array") ∧
          assert_type(3.14, "F64");
    ⎇ r { test_pass(); } ⎉ { test_fail(); }
    ⤺ r
}

rite main() {
    println("========================================");
    println("Suite: Example Tests");
    println("----------------------------------------");

    ≔ vary passed = 0;
    ≔ vary failed = 0;

    ⎇ test_arithmetic() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_strings() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_arrays() { passed = passed + 1; } ⎉ { failed = failed + 1; }
    ⎇ test_types() { passed = passed + 1; } ⎉ { failed = failed + 1; }

    println("----------------------------------------");
    println("Results: " + to_string(passed) + "/" + to_string(passed + failed) + " passed");
    ⎇ failed == 0 {
        println("ALL TESTS PASSED!");
    } ⎉ {
        println("SOME TESTS FAILED");
    }
    println("========================================");
}
