// Example demonstrating the AI-facing IR with pipelines and morphemes

Σ Point {
    x: f64,
    y: f64,
}

Σ Result {
    value: i64,
    success: bool,
}

// Simple function with pipeline
rite double_all(nums: [i64]) -> [i64] {
    nums|τ{_ * 2}
}

// Filter and sort
rite process_positive(nums: [i64]) -> [i64] {
    nums
        |φ{_ > 0}
        |σ
        |τ{_ + 1}
}

// Reduce to sum
rite sum_all(nums: [i64]) -> i64 {
    nums|ρ{a + _}
}

// Access morphemes
rite get_first(nums: [i64]) -> i64 {
    nums|α
}

rite get_last(nums: [i64]) -> i64 {
    nums|ω
}

// Function with evidentiality markers
rite compute_known(x: i64) -> i64 {
    x * 2 + 1
}

// Conditional
rite abs_value(x: i64) -> i64 {
    ⎇ x < 0 {
        -x
    } ⎉ {
        x
    }
}

// Binary operations
rite math_ops(a: i64, b: i64) -> i64 {
    ≔ sum = a + b;
    ≔ diff = a - b;
    ≔ prod = a * b;
    sum + diff + prod
}

// Main function
rite main() -> i64 {
    ≔ nums = [1, 2, 3, 4, 5];
    ≔ doubled = double_all(nums);
    ≔ summed = sum_all(doubled);
    summed
}
