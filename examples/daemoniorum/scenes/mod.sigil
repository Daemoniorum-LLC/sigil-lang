//! # DAEMONIORUM Scenes Module
//!
//! Scene and location management with reality layer variations,
//! alter-specific perception, and environmental storytelling.

☉ scroll scene;
☉ scroll church;
☉ scroll asylum;
☉ scroll forest;
☉ scroll mindscape;

☉ invoke scene·*;
☉ invoke church·*;
☉ invoke asylum·*;
☉ invoke forest·*;
☉ invoke mindscape·*;

// ============================================================================
// MODULE INITIALIZATION
// ============================================================================

//! Initialize all game scenes
rite init_scenes() -> SceneManager! {
    ≔ vary manager = SceneManager·new();

    // Register all scene sets
    register_church_scenes(&Δ manager);
    register_asylum_scenes(&Δ manager);
    register_forest_scenes(&Δ manager);
    register_mindscape_scenes(&Δ manager);

    manager
}
