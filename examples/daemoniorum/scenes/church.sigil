//! # The Abandoned Church
//!
//! The first major location - an abandoned church that serves
//! as Father Marcus's domain. Reality bends here.

use super·scene·*
use super·super·system·*
use std·collections·HashMap

// ============================================================================
// CHURCH EXTERIOR
// ============================================================================

//! Create the church exterior scene
fn create_church_exterior() -> Scene! {
    SceneBuilder·new("church_exterior")
        ·name(
            "St. Malachar's Church",
            "St. Malachar's... Church?",
            "T̷H̸E̴ ̵F̷E̶E̵D̶I̴N̶G̷ ̸P̵I̴T̷"
        )
        ·description(
            "An old stone church stands before you, ivy crawling up its walls. The stained glass windows are dark, but you see flickering candlelight within. The iron gate hangs open, rusted hinges creaking in a wind you don't feel.",

            "The church seems... wrong. Its proportions shift when you look away. The ivy moves against the wind. The candlelight pulses like a heartbeat, and you could swear the stained glass depicts scenes that weren't there a moment ago.",

            "T̷H̸E̴R̶E̵ ̷W̸A̵S̴ ̶N̴E̷V̵E̶R̸ ̵A̷ ̵C̸H̶U̴R̵C̴H̷.̶ ̵T̴H̸E̷R̷E̴ ̴W̸A̶S̷ ̵O̸N̶L̵Y̸ ̸T̷H̴E̸ ̷H̵U̴N̶G̶E̸R̵.̴ The thing wearing a church's skin pulses with ancient appetite. The gate is teeth. The windows are eyes. IT HAS ALWAYS BEEN WATCHING."
        )
        ·scene_type(SceneType·Exploration)
        ·time(TimeOfDay·Dusk)
        ·weather(Weather·Fog)
        // Elements
        ·element(SceneElement {
            id: "iron_gate"·to_string(),
            name: LayeredDescription {
                grounded: "Iron Gate"·to_string(),
                fractured: "Rusted Gate"·to_string()~,
                shattered: "TEETH"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A wrought-iron gate, ornate but rusted. It stands open, inviting you in."·to_string(),
                fractured: "The gate's iron bars form shapes that hurt to look at. You're not sure it was ever meant to keep things out. Perhaps it was meant to keep things in."·to_string()~,
                shattered: "TEETH TEETH TEETH. The mouth opens wider. Come in, little morsel. We've been so hungry."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "stolas"·to_string(),
                    text: "*The ironwork contains sigils. Old. Pre-Christian. This is a seal, not a gate.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
                AlterObservation {
                    alter_id: "warden"·to_string(),
                    text: "*Defensible? No. The gate opens inward. This place was built to trap, not protect.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
                AlterObservation {
                    alter_id: "abaddon"·to_string(),
                    text: "*Something inside. Strong. Old. It knows we're here.*"·to_string()~,
                    grants_insight: false,
                    triggers: ["threat_detected"·to_string()],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "examine_gate"·to_string(),
                    verb: "examine"·to_string(),
                    description: "You study the gate closely. The ironwork is old - centuries old - but the rust seems to have been artificially aged. Someone wanted this place to look abandoned."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·GrantInsight { id: "gate_fake"·to_string(), amount: 5.0 },
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "stained_glass"·to_string(),
            name: LayeredDescription {
                grounded: "Stained Glass Windows"·to_string(),
                fractured: "Shifting Glass"·to_string()~,
                shattered: "EYES"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "Beautiful stained glass windows depicting saints and angels. The candlelight from within makes them glow warmly."·to_string(),
                fractured: "The saints in the glass have too many eyes. The angels have too many wings. And are those... tentacles in the background of the Annunciation scene?"·to_string()~,
                shattered: "T̸H̶E̸Y̵ ̶S̶E̵E̸ ̵Y̶O̸U̵.̷ Every saint, every angel, every figure in the glass turns to face you. Their mouths open in silent screaming. Their eyes follow. THE WINDOWS ARE FULL OF THE DEVOURED."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "stolas"·to_string(),
                    text: "*The iconography is wrong. These aren't Christian saints - they're wearing the faces of older things. Goetic seals hidden in the halos.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
                AlterObservation {
                    alter_id: "beleth"·to_string(),
                    text: "*So much suffering crystallized in glass. They didn't just die here. They were... consumed. Made into something.*"·to_string()~,
                    grants_insight: true,
                    triggers: ["emotional_resonance"·to_string()],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "examine_glass"·to_string(),
                    verb: "examine"·to_string(),
                    description: "As you look closer, one of the glass figures seems to mouth words at you. You can almost read its lips: 'Run.'"·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·ModifyStability(-0.1),
                        InteractionEffect·ShiftReality { target: RealityLayer·Fractured, rate: 0.2 },
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "ivy"·to_string(),
            name: LayeredDescription {
                grounded: "Creeping Ivy"·to_string(),
                fractured: "Grasping Vines"·to_string()~,
                shattered: "VEINS"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "Thick ivy covers much of the church's exterior, giving it a picturesque, abandoned look."·to_string(),
                fractured: "The ivy moves. Not with the wind - against it. The leaves are the wrong shade of green. Too vital. Too hungry."·to_string()~,
                shattered: "B̸L̵O̴O̶D̵ ̸V̵E̶S̸S̴E̷L̶S̵ of the greater organism. The church feeds, and the ivy carries the nutrients to the roots buried deep below."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "stolas"·to_string(),
                    text: "*Not ivy. Possibly not even plant. The cellular structure is wrong. It's pretending.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "touch_ivy"·to_string(),
                    verb: "touch"·to_string(),
                    description: "The instant your fingers brush the leaves, they recoil. Not you - the ivy. It retreats from your touch, leaving a bare patch of stone. Something about you repels it."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·SetFlag("ivy_touched"·to_string()),
                        InteractionEffect·GrantInsight { id: "ivy_alive"·to_string(), amount: 10.0 },
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        // Exits
        ·exit(Exit {
            id: "enter_church"·to_string(),
            direction: Direction·Inside,
            target_scene: "church_nave"·to_string(),
            description: LayeredDescription {
                grounded: "The church doors stand open, candlelight spilling out."·to_string(),
                fractured: "The doors yawn open. The candlelight is too red. It looks like the entrance to a throat."·to_string()~,
                shattered: "THE MAW OPENS. Come in, little ones. We have been so very patient."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: [
                AlterObservation {
                    alter_id: "warden"·to_string(),
                    text: "*Every instinct says no. But there's no other path forward.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
        })
        ·exit(Exit {
            id: "leave"·to_string(),
            direction: Direction·Back,
            target_scene: "forest_path"·to_string(),
            description: LayeredDescription {
                grounded: "The forest path stretches back the way you came."·to_string(),
                fractured: "The path back seems longer than before. The trees have moved."·to_string()~,
                shattered: "THERE IS NO PATH BACK. There was never a path. You were always meant to be here."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        // Alter memories
        ·alter_memory("vessel", "Something about this place feels... familiar? Have we been here before?")
        ·alter_memory("abaddon", "We've faced things like this before. We survived. We'll survive again.")
        ·alter_memory("stolas", "The architecture predates the Christian era. Someone built this place to contain something.")
        // Ambiance
        ·ambiance(Ambiance {
            background_sound: "wind_through_stones"·to_string(),
            music_track: Some("ominous_ambient"·to_string())?,
            layer_sounds: {
                RealityLayer·Fractured => "heartbeat_subtle",
                RealityLayer·Shattered => "choir_screaming",
            }~,
            weather_sounds: {
                Weather·Fog => "fog_whispers",
            }~,
            lighting: Lighting {
                base_level: 0.3,
                color: (0.9, 0.8, 0.7),
                layer_modifiers: {
                    RealityLayer·Fractured => LightingMod {
                        level_delta: -0.1,
                        color_shift: (-0.2, -0.1, 0.0),
                        flicker: true,
                    },
                    RealityLayer·Shattered => LightingMod {
                        level_delta: -0.2,
                        color_shift: (-0.4, -0.3, -0.1),
                        flicker: true,
                    },
                }~,
            },
        })
        ·on_enter(InteractionEffect·PlaySound("church_bell_distant"·to_string()))
        ·build()
}

// ============================================================================
// CHURCH NAVE
// ============================================================================

//! Create the church nave (main interior)
fn create_church_nave() -> Scene! {
    SceneBuilder·new("church_nave")
        ·name(
            "Church Nave",
            "The Throat",
            "T̵H̸E̵ ̷S̴T̴O̷M̵A̸C̷H̵"
        )
        ·description(
            "The church interior is surprisingly well-maintained. Candles line the aisles, their flames steady despite no apparent source of wax. Wooden pews face a modest altar, behind which hangs a large crucifix. Father Marcus stands at the altar, hands clasped, smiling warmly.",

            "The candles burn without wax. The flames don't flicker despite the draft. The pews are made of a wood you don't recognize - too dark, too smooth. Father Marcus's shadow doesn't match his pose. The crucifix is upside down, but when you look directly at it, it seems right-side up.",

            "N̷O̷ ̵P̶E̵W̸S̶.̴ ̵N̶O̵ ̷C̷A̵N̶D̷L̷E̸S̶.̷ ̸N̸O̵ ̶C̵H̸U̷R̶C̸H̸.̶ Only THE FEEDING CHAMBER. The thing that wears Marcus like a suit unfolds in dimensions that shouldn't exist. The walls are lined with previous meals, still aware, still screaming silently. You were always going to end up here. It was always going to be hungry."
        )
        ·scene_type(SceneType·Dialogue)
        // Father Marcus is here
        ·npc("marcus")
        // Elements
        ·element(SceneElement {
            id: "altar"·to_string(),
            name: LayeredDescription {
                grounded: "The Altar"·to_string(),
                fractured: "The Feeding Stone"·to_string()~,
                shattered: "THE TONGUE"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A simple stone altar, covered with a white cloth. A golden chalice and a Bible rest upon it."·to_string(),
                fractured: "The altar stone is stained darker than the rest. The cloth is too white - bleached by something stronger than soap. The Bible is upside down."·to_string()~,
                shattered: "IT TASTES YOU THROUGH THE FLOOR. The altar is the tip of something vast buried below. The chalice is full of something that was never wine."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "stolas"·to_string(),
                    text: "*Pre-Romanesque stonework. Possibly Merovingian. This altar was here before Christianity reached these lands.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
                AlterObservation {
                    alter_id: "abaddon"·to_string(),
                    text: "*Blood. Old blood soaked into the stone. Decades of it. Centuries.*"·to_string()~,
                    grants_insight: true,
                    triggers: ["danger_sensed"·to_string()],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "examine_altar"·to_string(),
                    verb: "examine"·to_string(),
                    description: "Looking closely at the altar, you notice names carved into the stone. Hundreds of them. They weren't carved - they were scratched. By fingernails."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·ModifyStability(-0.15),
                        InteractionEffect·GrantInsight { id: "altar_victims"·to_string(), amount: 20.0 },
                        InteractionEffect·ShiftReality { target: RealityLayer·Fractured, rate: 0.3 },
                    ],
                },
                Interaction {
                    id: "read_bible"·to_string(),
                    verb: "read"·to_string(),
                    description: "The Bible's pages are blank. All of them. Except the last, which contains a single sentence in a language you shouldn't understand but do: 'They came seeking salvation. We gave them incorporation.'"·to_string()~,
                    conditions: [
                        DiscoveryCondition·RealityLayer(RealityLayer·Fractured),
                    ],
                    effects: [
                        InteractionEffect·GrantInsight { id: "incorporation"·to_string(), amount: 30.0 },
                        InteractionEffect·ModifyDissociation(0.1),
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "candles"·to_string(),
            name: LayeredDescription {
                grounded: "Candles"·to_string(),
                fractured: "Soul Flames"·to_string()~,
                shattered: "DIGESTION"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "Dozens of candles light the nave, their flames steady and warm."·to_string(),
                fractured: "The candles have no wicks. They have no wax. They're burning something else. Something that still remembers being human."·to_string()~,
                shattered: "E̵A̷C̸H̶ ̵F̸L̶A̶M̶E̸ ̷I̸S̸ ̶S̵O̸M̸E̸O̵N̵E̵.̴ The digestion of souls provides the light. They burn for centuries before they're finally gone."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "beleth"·to_string(),
                    text: "*Each flame... there's something inside. Tiny presences. They're aware. They're in pain.*"·to_string()~,
                    grants_insight: true,
                    triggers: ["empathy_overload"·to_string()],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "touch_flame"·to_string(),
                    verb: "touch"·to_string(),
                    description: "The flame is cold. It doesn't burn you - it reaches for you. A whisper brushes your mind: 'Help us. End us. Or run. Run now.'"·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·ModifyStability(-0.1),
                        InteractionEffect·SetFlag("candle_warning"·to_string()),
                        InteractionEffect·PlaySound("whisper_warning"·to_string()),
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "confessional"·to_string(),
            name: LayeredDescription {
                grounded: "Confessional Booth"·to_string(),
                fractured: "The Listening Box"·to_string()~,
                shattered: "THE EAR"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A wooden confessional booth stands in the corner, its curtains drawn."·to_string(),
                fractured: "The confessional's wood pulses slightly, like breathing. Something is inside. Listening."·to_string()~,
                shattered: "SECRETS MAKE THE BEST SEASONING. Everything whispered here was heard. Catalogued. Used."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "warden"·to_string(),
                    text: "*Enclosed space. Limited visibility. Perfect for an ambush. Don't go in.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "enter_confessional"·to_string(),
                    verb: "enter"·to_string(),
                    description: "The moment you sit down, you hear breathing from the other side. 'Confess, child,' a voice that isn't Marcus's says. 'Tell me your sins. Tell me your secrets. Tell me what you taste like on the inside.'"·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·TriggerDialogue("confessional_horror"·to_string()),
                        InteractionEffect·ShiftReality { target: RealityLayer·Fractured, rate: 0.4 },
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "hidden_passage"·to_string(),
            name: LayeredDescription {
                grounded: "Loose Flagstone"·to_string(),
                fractured: "The Way Down"·to_string()~,
                shattered: "THE THROAT"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A flagstone near the altar seems slightly loose."·to_string(),
                fractured: "The stone breathes. Something underneath wants you to find it. Is that a good thing?"·to_string()~,
                shattered: "DOWN DOWN DOWN. To where the true hunger waits. To the root of everything."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "stolas"·to_string(),
                    text: "*There's a passage below. Pre-dating the church by centuries. This is what Marcus guards.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "lift_stone"·to_string(),
                    verb: "lift"·to_string(),
                    description: "The flagstone lifts easily - too easily. Below, stone steps descend into darkness. The smell that rises is wrong. Ancient. Hungry."·to_string()~,
                    conditions: [
                        DiscoveryCondition·AlterFronting("stolas"·to_string()),
                    ],
                    effects: [
                        InteractionEffect·Reveal("church_crypt"·to_string()),
                        InteractionEffect·SetFlag("crypt_found"·to_string()),
                        InteractionEffect·PlaySound("stone_grinding"·to_string()),
                    ],
                },
            ],
            hidden_until: Some(DiscoveryCondition·Ability("perception_subtle"·to_string()))?,
            contains_items: [],
        })
        // Exits
        ·exit(Exit {
            id: "leave_church"·to_string(),
            direction: Direction·Outside,
            target_scene: "church_exterior"·to_string(),
            description: LayeredDescription {
                grounded: "The church doors lead back outside."·to_string(),
                fractured: "The doors seem farther away than they should be. The path between you and freedom stretches."·to_string()~,
                shattered: "THERE IS NO OUTSIDE. There was never an outside. You were always inside."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·exit(Exit {
            id: "descend_crypt"·to_string(),
            direction: Direction·Down,
            target_scene: "church_crypt"·to_string(),
            description: LayeredDescription {
                grounded: "Stone steps lead down into darkness."·to_string(),
                fractured: "The steps descend into the roots of the world."·to_string()~,
                shattered: "D̶O̷W̸N̸ ̸T̶O̷ ̶T̴H̷E̶ ̶H̵E̵A̶R̸T̸.̴"·to_string()‽,
            },
            locked: true,
            lock_condition: Some(LockCondition·RequiresFlag("crypt_found"·to_string()))?,
            alter_observations: []~,
        })
        // On enter effects
        ·on_enter(InteractionEffect·TriggerDialogue("marcus_greeting"·to_string()))
        ·on_enter(InteractionEffect·PlaySound("church_ambiance"·to_string()))
        // Alter memories
        ·alter_memory("vessel", "Churches used to feel safe. This one feels like a trap.")
        ·alter_memory("abaddon", "We've fought in places like this. Holy ground that forgot what it was supposed to be holy against.")
        ·alter_memory("beleth", "So much pain has happened here. The walls remember. The stone remembers.")
        // Ambiance
        ·ambiance(Ambiance {
            background_sound: "church_echoes"·to_string(),
            music_track: Some("dread_sacred"·to_string())?,
            layer_sounds: {
                RealityLayer·Fractured => "heartbeat_building",
                RealityLayer·Shattered => "reality_tear",
            }~,
            weather_sounds: HashMap·new()~,
            lighting: Lighting {
                base_level: 0.4,
                color: (0.9, 0.7, 0.5),  // Candlelight
                layer_modifiers: {
                    RealityLayer·Fractured => LightingMod {
                        level_delta: -0.15,
                        color_shift: (-0.2, -0.2, 0.0),
                        flicker: true,
                    },
                    RealityLayer·Shattered => LightingMod {
                        level_delta: 0.2,  // Too bright
                        color_shift: (0.3, -0.3, -0.2),  // Sickly red
                        flicker: true,
                    },
                }~,
            },
        })
        ·build()
}

// ============================================================================
// CHURCH CRYPT
// ============================================================================

//! Create the church crypt (hidden area)
fn create_church_crypt() -> Scene! {
    SceneBuilder·new("church_crypt")
        ·name(
            "The Crypt",
            "The Root Cellar",
            "T̴H̸E̷ ̴H̵E̸A̸R̶T̵ ̴C̵H̵A̷M̵B̸E̷R̶"
        )
        ·description(
            "Ancient stone chambers stretch before you, lit by phosphorescent fungi clinging to the walls. Alcoves hold bones arranged in patterns that seem almost purposeful. The air is thick and tastes of copper and age.",

            "The fungi pulse like a circulatory system. The bones in the alcoves aren't arranged - they're growing. New bones forming from nothing, then absorbed back into the walls. This place is alive. You're inside something alive.",

            "Y̸O̵U̶ ̴A̶R̸E̷ ̶I̸N̶S̶I̶D̸E̸.̶ The creature that wears the church like a shell reveals its true form here. The bones are teeth. The fungi are nerve endings. Every surface feels you, tastes you, considers you. This is where digestion happens."
        )
        ·scene_type(SceneType·Exploration)
        // This is where the boss fight happens
        ·enemy("marcus_true_form")
        ·element(SceneElement {
            id: "bone_walls"·to_string(),
            name: LayeredDescription {
                grounded: "Bone Arrangements"·to_string(),
                fractured: "Living Ossuary"·to_string()~,
                shattered: "TEETH"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "Thousands of bones arranged in ornate patterns. An ossuary built over centuries."·to_string(),
                fractured: "The bones move when you're not looking. They rearrange themselves to form words you don't want to read. Some of them are fresh."·to_string()~,
                shattered: "ALL OF THEM WERE PEOPLE. All of them are still aware. Incorporated but not dead. They join the choir of the consumed."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "stolas"·to_string(),
                    text: "*The arrangement follows a pattern. It's a binding circle. Something is imprisoned here - or was, until recently.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
                AlterObservation {
                    alter_id: "abaddon"·to_string(),
                    text: "*Thousands of kills. This thing has been feeding for centuries. And we're going to end it.*"·to_string()~,
                    grants_insight: false,
                    triggers: ["righteous_fury"·to_string()],
                },
            ]~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "heart_altar"·to_string(),
            name: LayeredDescription {
                grounded: "Central Altar"·to_string(),
                fractured: "The Heart"·to_string()~,
                shattered: "THE HEART"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A larger altar sits in the center of the crypt. Unlike the one above, this one is covered in dried blood that seems fresh despite its age."·to_string(),
                fractured: "The altar beats. Slowly, rhythmically. It's the heart of this place. Kill it, and the church dies. But the church is very, very old."·to_string()~,
                shattered: "K̸I̶L̵L̴ ̷I̸T̵.̸ ̵K̶I̵L̶L̷ ̸U̷S̶.̶ ̵E̴N̷D̴ ̶T̴H̸I̸S̷.̶ The heart of the creature. The source of its power. This is where the battle must happen."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "paimon"·to_string(),
                    text: "*This is the crossroads. Destroy it, and Marcus dies with it. But so might everyone it has consumed. There may be another way.*"·to_string()~,
                    grants_insight: true,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "attack_heart"·to_string(),
                    verb: "attack"·to_string(),
                    description: "The moment you raise your hand against the heart, the church SCREAMS. Father Marcus manifests between you and the altar, no longer bothering to appear human."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·TriggerCombat("marcus_boss_fight"·to_string()),
                        InteractionEffect·PlaySound("boss_reveal"·to_string()),
                        InteractionEffect·TriggerCutscene("marcus_transform"·to_string()),
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        // Exit back up
        ·exit(Exit {
            id: "ascend"·to_string(),
            direction: Direction·Up,
            target_scene: "church_nave"·to_string(),
            description: LayeredDescription {
                grounded: "Stone steps lead back up to the nave."·to_string(),
                fractured: "The stairs seem longer now. Steeper."·to_string()~,
                shattered: "IT WON'T LET YOU LEAVE. Not anymore. Not now that you've seen."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·on_enter(InteractionEffect·ShiftReality { target: RealityLayer·Fractured, rate: 0.5 })
        ·on_enter(InteractionEffect·ModifyStability(-0.15))
        ·on_enter(InteractionEffect·PlaySound("crypt_ambiance"·to_string()))
        ·ambiance(Ambiance {
            background_sound: "heartbeat_loud"·to_string(),
            music_track: Some("boss_approach"·to_string())?,
            layer_sounds: HashMap·new()~,
            weather_sounds: HashMap·new()~,
            lighting: Lighting {
                base_level: 0.2,
                color: (0.5, 0.8, 0.5),  // Phosphorescent green
                layer_modifiers: {
                    RealityLayer·Shattered => LightingMod {
                        level_delta: 0.3,
                        color_shift: (0.5, -0.3, -0.3),  // Blood red
                        flicker: true,
                    },
                }~,
            },
        })
        ·build()
}

// ============================================================================
// SCENE REGISTRATION
// ============================================================================

//! Register all church scenes
fn register_church_scenes(manager: &mut SceneManager) {
    manager·register_scene(create_church_exterior());
    manager·register_scene(create_church_nave());
    manager·register_scene(create_church_crypt());
}
