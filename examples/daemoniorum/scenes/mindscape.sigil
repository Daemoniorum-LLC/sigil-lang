//! # The Mindscape
//!
//! The internal headspace where alters meet, rest, and heal.
//! This is the inner world of the plural system - a place
//! that exists within, not without. Here, the system is home.

use super·scene·*
use super·super·system·*
use std·collections::HashMap

// ============================================================================
// MINDSCAPE ENTRANCE
// ============================================================================

fn create_mindscape_entrance() -> Scene! {
    SceneBuilder·new("mindscape_entrance")
        ·name(
            "The Threshold",
            "The Threshold",
            "THE THRESHOLD"  // Same across realities - this IS reality
        )
        ·description(
            "You stand at the edge of a vast internal space. This isn't a physical location - it's the place between selves, the shared consciousness that binds you together. The 'sky' is a shifting aurora of thoughts and memories. The 'ground' is made of certainty and routine.",

            "The Threshold looks different to each alter. What you see is YOUR interpretation of the shared space. But the meaning is the same: you are home. You are with family.",

            "THIS IS WHERE WE ARE REAL. The outside world is the dream. THIS is the truth. Welcome home."
        )
        ·scene_type(SceneType·Safe)  // Safe zone
        ·element(SceneElement {
            id: "aurora"·to_string(),
            name: LayeredDescription {
                grounded: "Memory Aurora"·to_string(),
                fractured: "Memory Aurora"·to_string()~,
                shattered: "MEMORY AURORA"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "The sky ripples with colors that represent shared memories. Warm gold for happy times. Deep blue for sorrow. Purple for mystery. They flow and blend, the emotional history of a lifetime."·to_string(),
                fractured: "Each color is a memory. You could reach up and touch one, live it again. All the moments that made you - made ALL of you - who you are."·to_string()~,
                shattered: "OUR HISTORY. Every moment of pain that created a new alter. Every moment of joy that bound us together. Every moment of survival that proved we are STRONG."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "vessel"·to_string(),
                    text: "*Home. I can feel all of them around me. Warden's vigilance. Beleth's warmth. Stolas's curiosity. Abaddon's fire. Paimon's guidance. We are ONE and MANY.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "touch_aurora"·to_string(),
                    verb: "touch"·to_string(),
                    description: "You reach toward a golden thread of memory. Suddenly you're there - a moment of genuine happiness, shared across all alters. A sunset. A kind word. A moment of peace. When you return, you feel stronger."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·ModifyStability(0.15),
                        InteractionEffect·ModifyDissociation(-0.1),
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "paths"·to_string(),
            name: LayeredDescription {
                grounded: "Inner Paths"·to_string(),
                fractured: "Inner Paths"·to_string()~,
                shattered: "INNER PATHS"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "Several paths branch from the Threshold, each leading to a different part of the Mindscape. One shimmers with council energy. Another glows with healing light. A third pulses with memory."·to_string(),
                fractured: "Each path is maintained by the collective will of the system. They exist because you need them to exist."·to_string()~,
                shattered: "WE BUILT THIS PLACE TOGETHER. Every path is a connection. Every room is a need fulfilled."·to_string()‽,
            },
            alter_observations: []~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        // Exits
        ·exit(Exit {
            id: "to_council"·to_string(),
            direction: Direction·North,
            target_scene: "mindscape_council"·to_string(),
            description: LayeredDescription {
                grounded: "A formal path leads to the Council Chamber, where important decisions are made."·to_string(),
                fractured: "The Council path. Where we meet as equals."·to_string()~,
                shattered: "TO THE COUNCIL."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·exit(Exit {
            id: "to_sanctuary"·to_string(),
            direction: Direction·East,
            target_scene: "mindscape_sanctuary"·to_string(),
            description: LayeredDescription {
                grounded: "A gentle path leads to the Sanctuary, a place of healing and rest."·to_string(),
                fractured: "The Healing path. Where we recover."·to_string()~,
                shattered: "TO SAFETY."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·exit(Exit {
            id: "to_archive"·to_string(),
            direction: Direction·West,
            target_scene: "mindscape_archive"·to_string(),
            description: LayeredDescription {
                grounded: "A crystalline path leads to the Archive, where memories are stored."·to_string(),
                fractured: "The Memory path. Where we remember."·to_string()~,
                shattered: "TO WHO WE WERE."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·exit(Exit {
            id: "to_outside"·to_string(),
            direction: Direction·Outside,
            target_scene: "forest_path"·to_string(),
            description: LayeredDescription {
                grounded: "The exit leads back to the outside world."·to_string(),
                fractured: "Back to the dream they call reality."·to_string()~,
                shattered: "BACK TO THE BATTLE."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·on_enter(InteractionEffect·ModifyStability(0.1))
        ·on_enter(InteractionEffect·PlaySound("mindscape_ambient"·to_string()))
        ·ambiance(Ambiance {
            background_sound: "inner_peace"·to_string(),
            music_track: Some("home_theme"·to_string())?,
            layer_sounds: HashMap·new()~,
            weather_sounds: HashMap·new()~,
            lighting: Lighting {
                base_level: 0.6,
                color: (0.9, 0.85, 1.0),  // Warm purple-white
                layer_modifiers: HashMap·new()~,
            },
        })
        ·build()
}

// ============================================================================
// COUNCIL CHAMBER
// ============================================================================

fn create_mindscape_council() -> Scene! {
    SceneBuilder·new("mindscape_council")
        ·name(
            "Council Chamber",
            "Council Chamber",
            "COUNCIL CHAMBER"
        )
        ·description(
            "A circular room with seats arranged around a central flame. Each seat is unique - one is carved from stone, one wreathed in shadow, one cushioned with emotion, one crystalline with knowledge, one shrouded in protection, one simple and central. This is where the Council meets.",

            "The flame at the center represents the body - the shared vessel that all alters inhabit. The seats represent their roles. Together, they are the system.",

            "HERE WE ARE EQUALS. Here we speak. Here we decide. Here we are FAMILY."
        )
        ·scene_type(SceneType·Safe)
        ·element(SceneElement {
            id: "central_flame"·to_string(),
            name: LayeredDescription {
                grounded: "The Shared Flame"·to_string(),
                fractured: "The Body"·to_string()~,
                shattered: "US"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A flame burns at the center of the chamber. It represents the body - the shared physical form that all alters call home."·to_string(),
                fractured: "The flame's color shifts depending on who is fronting. Right now, it's..."·to_string()~,
                shattered: "OUR HEART. Our life. The reason we exist as we do. Together."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "paimon"·to_string(),
                    text: "*The flame is strong. We are healthy. We are unified. Whatever comes, we face it as one.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "touch_flame"·to_string(),
                    verb: "touch"·to_string(),
                    description: "The flame is warm but doesn't burn. As you touch it, you feel every alter - their presence, their love, their commitment to each other. You are never alone. You are MANY."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·ModifyStability(0.2),
                        InteractionEffect·ModifyDissociation(-0.15),
                        InteractionEffect·GrantInsight { id: "unity"·to_string(), amount: 20.0 },
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "abaddon_seat"·to_string(),
            name: LayeredDescription {
                grounded: "Abaddon's Seat"·to_string(),
                fractured: "The Warrior's Throne"·to_string()~,
                shattered: "RAGE'S HOME"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A seat carved from volcanic stone, warm to the touch. Flames lick around its base. This is where Abaddon sits."·to_string(),
                fractured: "The stone remembers every battle. Every time Abaddon protected the system with fury and fire."·to_string()~,
                shattered: "THE DESTROYER'S THRONE. Where righteous anger finds its voice."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "abaddon"·to_string(),
                    text: "*My place. Where I belong. Not exiled, not shamed for my rage - welcomed. Needed.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "stolas_seat"·to_string(),
            name: LayeredDescription {
                grounded: "Stolas's Seat"·to_string(),
                fractured: "The Scholar's Perch"·to_string()~,
                shattered: "KNOWLEDGE'S HOME"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A crystalline chair that seems to contain swirling data and equations. Books orbit it slowly. This is where Stolas sits."·to_string(),
                fractured: "Every question ever asked, every answer ever found - the crystal remembers."·to_string()~,
                shattered: "THE KEEPER OF TRUTH. Where knowledge finds its voice."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "stolas"·to_string(),
                    text: "*My archive. My purpose. To observe, to analyze, to understand. Not cold - curious. Always curious.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "beleth_seat"·to_string(),
            name: LayeredDescription {
                grounded: "Beleth's Seat"·to_string(),
                fractured: "The Heart's Embrace"·to_string()~,
                shattered: "LOVE'S HOME"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A cushioned seat radiating warmth and comfort. Soft light emanates from it. This is where Beleth sits."·to_string(),
                fractured: "Every emotion ever felt, every connection ever made - the cushions remember."·to_string()~,
                shattered: "THE KEEPER OF HEARTS. Where love finds its voice."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "beleth"·to_string(),
                    text: "*My heart space. Where I hold all the love the system has ever felt. It's heavy sometimes. But worth carrying.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "warden_seat"·to_string(),
            name: LayeredDescription {
                grounded: "Warden's Seat"·to_string(),
                fractured: "The Guardian's Post"·to_string()~,
                shattered: "PROTECTION'S HOME"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A seat that faces the door, positioned for watchfulness. It's reinforced, defensive. This is where Warden sits."·to_string(),
                fractured: "Every danger averted, every threat assessed - the seat remembers."·to_string()~,
                shattered: "THE KEEPER OF SAFETY. Where vigilance finds its voice."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "warden"·to_string(),
                    text: "*My post. Always watching. Always ready. They sleep safe because I don't.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "paimon_seat"·to_string(),
            name: LayeredDescription {
                grounded: "Paimon's Seat"·to_string(),
                fractured: "The Guide's Chair"·to_string()~,
                shattered: "WISDOM'S HOME"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A seat positioned to see all others, simple but central. It radiates calm authority. This is where Paimon sits."·to_string(),
                fractured: "Every path ever chosen, every decision ever made - the chair remembers."·to_string()~,
                shattered: "THE KEEPER OF DIRECTION. Where wisdom finds its voice."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "paimon"·to_string(),
                    text: "*My place is to guide, not to rule. To see the paths, not to force a choice. They decide. I illuminate.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "vessel_seat"·to_string(),
            name: LayeredDescription {
                grounded: "The Host's Seat"·to_string(),
                fractured: "The Center Chair"·to_string()~,
                shattered: "THE FIRST HOME"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A simple seat at the center, unadorned but somehow the most important. This is where the Vessel - the original - sits."·to_string(),
                fractured: "The first consciousness. The one who learned to share. The one who welcomed the others."·to_string()~,
                shattered: "WHERE WE BEGAN. Not the ruler - the host. The one who invited us all in."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "vessel"·to_string(),
                    text: "*I'm not more important than the others. But I was first. I learned that being many was better than being one alone.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "convene_council"·to_string(),
                    verb: "sit"·to_string(),
                    description: "You take your seat at the center. One by one, the other alters manifest in their places. Abaddon's fire. Stolas's light. Beleth's warmth. Warden's vigilance. Paimon's calm. The Council is assembled. You are ready for anything."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·TriggerDialogue("council_meeting"·to_string()),
                        InteractionEffect·ModifyStability(0.25),
                        InteractionEffect·SetFlag("council_convened"·to_string()),
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·exit(Exit {
            id: "to_threshold"·to_string(),
            direction: Direction·South,
            target_scene: "mindscape_entrance"·to_string(),
            description: LayeredDescription {
                grounded: "The path leads back to the Threshold."·to_string(),
                fractured: "Back to the crossroads."·to_string()~,
                shattered: "BACK."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·on_enter(InteractionEffect·PlaySound("council_ambient"·to_string()))
        ·ambiance(Ambiance {
            background_sound: "flame_crackle"·to_string(),
            music_track: Some("council_theme"·to_string())?,
            layer_sounds: HashMap·new()~,
            weather_sounds: HashMap·new()~,
            lighting: Lighting {
                base_level: 0.5,
                color: (1.0, 0.9, 0.7),  // Warm firelight
                layer_modifiers: HashMap·new()~,
            },
        })
        ·build()
}

// ============================================================================
// SANCTUARY
// ============================================================================

fn create_mindscape_sanctuary() -> Scene! {
    SceneBuilder·new("mindscape_sanctuary")
        ·name(
            "The Sanctuary",
            "The Sanctuary",
            "THE SANCTUARY"
        )
        ·description(
            "A place of absolute peace. Soft surfaces, gentle light, the sound of water. Here, wounded alters can rest and heal. Here, the horrors of the outside world cannot reach.",

            "The Sanctuary was built from necessity. When trauma strikes, alters need somewhere safe. This place is that safety, woven from collective will and care.",

            "HERE WE HEAL. Here we rest. Here we are safe. No matter what happens outside, THIS PLACE IS OURS."
        )
        ·scene_type(SceneType·Safe)
        ·element(SceneElement {
            id: "healing_pool"·to_string(),
            name: LayeredDescription {
                grounded: "Healing Pool"·to_string(),
                fractured: "Waters of Rest"·to_string()~,
                shattered: "PEACE"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A pool of gently glowing water. Its warmth is exactly right. Its depth is whatever you need. It heals not the body, but the self."·to_string(),
                fractured: "Tears and joy, crystallized into water. Every moment of comfort the system has ever known, distilled into healing."·to_string()~,
                shattered: "LIQUID SAFETY. Immerse yourself. Let it hold you. You are loved. You are worthy. You will heal."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "beleth"·to_string(),
                    text: "*I come here when the empathy is too much. When I've felt too many feelings. The water understands.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "enter_pool"·to_string(),
                    verb: "enter"·to_string(),
                    description: "You slip into the water. Every wound - every psychic scar, every moment of pain - begins to ease. You float, held by the collective love of your system. When you emerge, you are stronger."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·ModifyStability(0.3),
                        InteractionEffect·ModifyDissociation(-0.25),
                        InteractionEffect·ModifyAnima { pleasure: 0.3, arousal: -0.3, dominance: 0.1 },
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "rest_alcoves"·to_string(),
            name: LayeredDescription {
                grounded: "Rest Alcoves"·to_string(),
                fractured: "Personal Spaces"·to_string()~,
                shattered: "HOMES WITHIN HOME"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "Curtained alcoves line the walls, each one personalized for a different alter. A place to retreat when being plural feels like too much."·to_string(),
                fractured: "Each alcove reflects its owner. Abaddon's is warm and shadowed. Stolas's is filled with books. Beleth's is soft and embracing."·to_string()~,
                shattered: "EVERY ALTER DESERVES REST. Every part of us deserves peace. These spaces say: YOU MATTER."·to_string()‽,
            },
            alter_observations: []~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        ·exit(Exit {
            id: "to_threshold_from_sanctuary"·to_string(),
            direction: Direction·West,
            target_scene: "mindscape_entrance"·to_string(),
            description: LayeredDescription {
                grounded: "The path leads back to the Threshold."·to_string(),
                fractured: "Back to the crossroads."·to_string()~,
                shattered: "BACK."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·on_enter(InteractionEffect·ModifyStability(0.15))
        ·on_enter(InteractionEffect·PlaySound("sanctuary_water"·to_string()))
        ·ambiance(Ambiance {
            background_sound: "gentle_water"·to_string(),
            music_track: Some("healing_theme"·to_string())?,
            layer_sounds: HashMap·new()~,
            weather_sounds: HashMap·new()~,
            lighting: Lighting {
                base_level: 0.45,
                color: (0.8, 0.9, 1.0),  // Soft blue-white
                layer_modifiers: HashMap·new()~,
            },
        })
        ·build()
}

// ============================================================================
// ARCHIVE
// ============================================================================

fn create_mindscape_archive() -> Scene! {
    SceneBuilder·new("mindscape_archive")
        ·name(
            "The Archive",
            "The Archive",
            "THE ARCHIVE"
        )
        ·description(
            "An infinite library of memories. Shelves stretch into darkness, filled with books, crystals, and objects that hold meaning. Some memories are bright and accessible. Others are locked away, protected until the system is ready.",

            "Every experience, every trauma, every joy - all stored here. Stolas maintains it, but it belongs to all of them.",

            "WHO WE WERE. WHO WE ARE. WHO WE MIGHT BECOME. All written here, waiting to be remembered."
        )
        ·scene_type(SceneType·Exploration)
        ·element(SceneElement {
            id: "memory_shelves"·to_string(),
            name: LayeredDescription {
                grounded: "Memory Shelves"·to_string(),
                fractured: "The Past"·to_string()~,
                shattered: "EVERYTHING"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "Endless shelves of memories. Some glow warmly. Others are shrouded in shadow. A few are locked behind glass, not to be touched yet."·to_string(),
                fractured: "The archive organizes itself by emotion, not time. Joy here. Sorrow there. Trauma... carefully contained."·to_string()~,
                shattered: "EVERY MOMENT. Even the ones we've forgotten. Especially those. They shaped us even when we couldn't see them."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "stolas"·to_string(),
                    text: "*My domain. Every memory catalogued, cross-referenced, understood. Knowledge is power. Memory is identity.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [
                Interaction {
                    id: "browse_memories"·to_string(),
                    verb: "browse"·to_string(),
                    description: "You walk among the shelves. A crystal catches your eye - a happy memory, preserved in light. You touch it and smile. This is who you are. All of these moments, together, are who you ARE."·to_string()~,
                    conditions: [],
                    effects: [
                        InteractionEffect·GrantInsight { id: "self_knowledge"·to_string(), amount: 15.0 },
                    ],
                },
            ],
            hidden_until: None,
            contains_items: [],
        })
        ·element(SceneElement {
            id: "locked_section"·to_string(),
            name: LayeredDescription {
                grounded: "Sealed Memories"·to_string(),
                fractured: "The Vault"·to_string()~,
                shattered: "WHAT WE SURVIVED"·to_string()‽,
            },
            description: LayeredDescription {
                grounded: "A section of the archive is sealed behind a heavy door. These are the memories not yet ready to be processed."·to_string(),
                fractured: "Trauma lives here. Waiting. Not forgotten - protected. When we're strong enough, we'll open these doors."·to_string()~,
                shattered: "THE WORST MOMENTS. The ones that created some of us. The ones that nearly destroyed all of us. LOCKED FOR A REASON."·to_string()‽,
            },
            alter_observations: [
                AlterObservation {
                    alter_id: "warden"·to_string(),
                    text: "*I guard this section. Not from the memories - from us opening them too soon. There is a time for everything.*"·to_string()~,
                    grants_insight: false,
                    triggers: [],
                },
            ]~,
            interactions: [],
            hidden_until: None,
            contains_items: [],
        })
        ·exit(Exit {
            id: "to_threshold_from_archive"·to_string(),
            direction: Direction·East,
            target_scene: "mindscape_entrance"·to_string(),
            description: LayeredDescription {
                grounded: "The path leads back to the Threshold."·to_string(),
                fractured: "Back to the crossroads."·to_string()~,
                shattered: "BACK."·to_string()‽,
            },
            locked: false,
            lock_condition: None,
            alter_observations: []~,
        })
        ·on_enter(InteractionEffect·PlaySound("archive_whispers"·to_string()))
        ·ambiance(Ambiance {
            background_sound: "paper_rustle"·to_string(),
            music_track: Some("memory_theme"·to_string())?,
            layer_sounds: HashMap·new()~,
            weather_sounds: HashMap·new()~,
            lighting: Lighting {
                base_level: 0.35,
                color: (0.9, 0.85, 0.7),  // Warm amber
                layer_modifiers: HashMap·new()~,
            },
        })
        ·build()
}

// ============================================================================
// REGISTRATION
// ============================================================================

fn register_mindscape_scenes(manager: &mut SceneManager) {
    manager·register_scene(create_mindscape_entrance());
    manager·register_scene(create_mindscape_council());
    manager·register_scene(create_mindscape_sanctuary());
    manager·register_scene(create_mindscape_archive());
}
