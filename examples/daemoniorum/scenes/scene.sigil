//! # DAEMONIORUM Scene System
//!
//! Scenes and locations with reality layer variations,
//! alter-specific perception, and environmental storytelling.

invoke super·super·system·*
invoke HashMap

// ============================================================================
// SCENE TYPES
// ============================================================================

//! Type of scene interaction
ᛈ SceneType {
    Exploration,    // Free movement
    Cutscene,       // Scripted sequence
    Combat,         // Battle arena
    Dialogue,       // Conversation focus
    Puzzle,         // Puzzle focus
    Safe,           // Rest area
}

//! Time of day affects visuals and available actions
ᛈ TimeOfDay {
    Dawn,
    Morning,
    Noon,
    Afternoon,
    Dusk,
    Night,
    Witching,   // 3 AM - special events
}

//! Weather conditions
ᛈ Weather {
    Clear,
    Cloudy,
    Rain,
    Storm,
    Fog,
    Unnatural,  // Reality is breaking
}

// ============================================================================
// SCENE DESCRIPTION
// ============================================================================

//! Description of a scene element across reality layers
Σ LayeredDescription {
    grounded: String!,              // Normal perception
    fractured: String~,             // Something's wrong (REPORTED)
    shattered: String‽,             // Full horror (PARADOX)
}

⊢ LayeredDescription {
    //! Get description for current reality layer
    rite for_layer(self, layer_: RealityLayer) -> String~ {
        ⌥ layer_ {
            RealityLayer·Grounded => self.grounded·clone()~,
            RealityLayer·Fractured => self.fractured·clone()~,
            RealityLayer·Shattered => self.shattered·clone()~,
        }
    }
}

//! Alter-specific observation about an element
Σ AlterObservation {
    alter_id: String!,
    text: String~,          // What they notice (REPORTED - subjective)
    grants_insight: bool!,  // Does this reveal something?
    triggers: Vec<String>!, // Triggers this might activate
}

// ============================================================================
// SCENE ELEMENTS
// ============================================================================

//! An interactable element in a scene
Σ SceneElement {
    id: String!,
    name: LayeredDescription!,
    description: LayeredDescription!,
    alter_observations: Vec<AlterObservation>~,
    interactions: Vec<Interaction>!,
    hidden_until: Option<DiscoveryCondition>?,
    contains_items: Vec<String>!,
}

//! How a discovery is made
ᛈ DiscoveryCondition {
    AlterFronting(String),
    RealityLayer(RealityLayer),
    FlagSet(String),
    Ability(String),
    InsightLevel(f32),
}

//! An interaction with a scene element
Σ Interaction {
    id: String!,
    verb: String!,                          // "examine", "take", "use"
    description: String~,                    // What happens
    conditions: Vec<DiscoveryCondition>!,   // When available
    effects: Vec<InteractionEffect>!,        // What happens
}

//! Effects of interacting with something
ᛈ InteractionEffect {
    Reveal(String),              // Reveal another element
    GiveItem(String),
    RemoveItem(String),
    SetFlag(String),
    ModifyStability(f32),
    ModifyDissociation(f32),
    TriggerDialogue(String),
    TriggerCombat(String),
    ShiftReality { target: RealityLayer, rate: f32 },
    PlaySound(String),
    TriggerCutscene(String),
    TransitionTo(String),        // Go to another scene
    GrantInsight { id: String, amount: f32 },
}

// ============================================================================
// EXITS AND NAVIGATION
// ============================================================================

//! An exit from a scene
Σ Exit {
    id: String!,
    direction: Direction!,
    target_scene: String!,
    description: LayeredDescription!,
    locked: bool!,
    lock_condition: Option<LockCondition>?,
    alter_observations: Vec<AlterObservation>~,
}

//! Cardinal and special directions
ᛈ Direction {
    North,
    South,
    East,
    West,
    Up,
    Down,
    Inside,
    Outside,
    Through,    // Through something
    Back,       // Return direction
}

//! What keeps an exit locked
ᛈ LockCondition {
    RequiresKey(String),
    RequiresFlag(String),
    RequiresAbility(String),
    RequiresAlter(String),
    RequiresReality(RealityLayer),
    RequiresInsight(f32),
    CombatCleared(String),
}

// ============================================================================
// SCENE AMBIANCE
// ============================================================================

//! Atmospheric elements of a scene
Σ Ambiance {
    background_sound: String!,
    music_track: String?,                           // Optional music
    layer_sounds: HashMap<RealityLayer, String>~,   // Per-reality sounds
    weather_sounds: HashMap<Weather, String>~,
    lighting: Lighting!,
}

//! Lighting conditions
Σ Lighting {
    base_level: f32!,           // 0.0 (dark) to 1.0 (bright)
    color: (f32, f32, f32)!,    // RGB
    layer_modifiers: HashMap<RealityLayer, LightingMod>~,
}

//! How lighting changes per reality
Σ LightingMod {
    level_delta: f32!,
    color_shift: (f32, f32, f32)!,
    flicker: bool!,
}

// ============================================================================
// SCENE DEFINITION
// ============================================================================

//! A complete scene/location
Σ Scene {
    id: String!,
    name: LayeredDescription!,
    scene_type: SceneType!,
    description: LayeredDescription!,
    elements: HashMap<String, SceneElement>!,
    exits: Vec<Exit>!,
    npcs: Vec<String>!,                     // NPC IDs present
    enemies: Vec<String>?,                  // Enemy IDs (UNCERTAIN - may not be visible)
    ambiance: Ambiance!,
    time_of_day: TimeOfDay!,
    weather: Weather!,
    on_enter: Vec<InteractionEffect>!,      // Triggered when entering
    on_exit: Vec<InteractionEffect>!,       // Triggered when leaving
    visited: bool!,
    alter_memories: HashMap<String, String>~, // Alter-specific memories of this place
}

⊢ Scene {
    //! Get the scene description for current state
    rite get_description(self, system: &PluralSystem) -> SceneDescription~ {
        ≔ base_desc = self.description·for_layer(system.reality_layer);

        // Collect visible elements
        ≔ visible_elements = self.elements·values()
            |φ{e => self·is_element_visible(e, system)}
            |τ{e => e.name·for_layer(system.reality_layer)}
            |> Vec·collect;

        // Collect available exits
        ≔ available_exits = self.exits
            |φ{e => self·is_exit_available(e, system)}
            |τ{e => (e.direction·clone(), e.description·for_layer(system.reality_layer))}
            |> Vec·collect;

        // Get alter-specific observations
        ≔ observations = self·get_alter_observations(system);

        SceneDescription {
            name: self.name·for_layer(system.reality_layer),
            description: base_desc,
            elements: visible_elements,
            exits: available_exits,
            observations: observations~,
            ambiance_cues: self·get_ambiance_cues(system),
        }~
    }

    //! Check if an element is visible
    rite is_element_visible(self, element: &SceneElement, system: &PluralSystem) -> bool! {
        ⌥ &element.hidden_until {
            None => true,
            Some(condition) => self·check_discovery(condition, system),
        }
    }

    //! Check if an exit is available
    rite is_exit_available(self, exit: &Exit, system: &PluralSystem) -> bool! {
        ⎇ !exit.locked {
            ⤺ true;
        }

        ⌥ &exit.lock_condition {
            None => true,
            Some(condition) => self·check_lock(condition, system),
        }
    }

    //! Check a discovery condition
    rite check_discovery(self, condition: &DiscoveryCondition, system: &PluralSystem) -> bool! {
        ⌥ condition {
            DiscoveryCondition·AlterFronting(id) => {
                ⌥ &system.fronting {
                    FrontingState·Single(fronter) => fronter == id,
                    FrontingState·Blended(fronters) => fronters·contains(id),
                    _ => false,
                }
            },
            DiscoveryCondition·RealityLayer(layer_) => {
                &system.reality_layer == layer_
            },
            DiscoveryCondition·FlagSet(_flag) => {
                true  // Would check game flags
            },
            DiscoveryCondition·Ability(ability) => {
                self·fronter_has_ability(ability, system)
            },
            DiscoveryCondition·InsightLevel(_level) => {
                true  // Would check insight system
            },
        }
    }

    //! Check a lock condition
    rite check_lock(self, condition: &LockCondition, system: &PluralSystem) -> bool! {
        ⌥ condition {
            LockCondition·RequiresKey(_key) => false,  // Would check inventory
            LockCondition·RequiresFlag(_flag) => false,  // Would check flags
            LockCondition·RequiresAbility(ability) => self·fronter_has_ability(ability, system),
            LockCondition·RequiresAlter(alter_id) => {
                ⌥ &system.fronting {
                    FrontingState·Single(fronter) => fronter == alter_id,
                    FrontingState·Blended(fronters) => fronters·contains(alter_id),
                    _ => false,
                }
            },
            LockCondition·RequiresReality(layer_) => &system.reality_layer == layer_,
            LockCondition·RequiresInsight(_level) => true,
            LockCondition·CombatCleared(_encounter) => false,  // Would check combat state
        }
    }

    //! Check if fronting alter has an ability
    rite fronter_has_ability(self, ability: &str, system: &PluralSystem) -> bool! {
        ≔ fronter_id = ⌥ &system.fronting {
            FrontingState·Single(id) => Some(id),
            FrontingState·Blended(ids) => ids |α,
            _ => None,
        };

        fronter_id
            ·and_then(|id| system.alters·get(id))
            ·map(|alter| alter.abilities·contains(ability))
            ·unwrap_or(false)
    }

    //! Get alter-specific observations for this scene
    rite get_alter_observations(self, system: &PluralSystem) -> Vec<String>~ {
        ≔ fronter_id = ⌥ &system.fronting {
            FrontingState·Single(id) => Some(id·clone()),
            FrontingState·Blended(ids) => ids |α |> Option·map(|id| id·clone()),
            _ => None,
        };

        ≔ vary observations = Vec·new();

        // Check for alter memory of this place
        ⎇ ≔ Some(id) = &fronter_id {
            ⎇ ≔ Some(memory) = self.alter_memories·get(id) {
                observations·push(format!("*{}~*", memory)~);
            }
        }

        // Check element observations
        ⎇ ≔ Some(id) = &fronter_id {
            ∀ element ∈ self.elements·values() {
                ∀ obs ∈ &element.alter_observations~ {
                    ⎇ &obs.alter_id == id {
                        observations·push(obs.text·clone());
                    }
                }
            }
        }

        observations~
    }

    //! Get ambiance cues for current state
    rite get_ambiance_cues(self, system: &PluralSystem) -> Vec<String>! {
        ≔ vary cues = Vec·new();

        // Add base sound
        cues·push(self.ambiance.background_sound·clone());

        // Add reality-specific sound
        ⎇ ≔ Some(layer_sound) = self.ambiance.layer_sounds·get(&system.reality_layer) {
            cues·push(layer_sound·clone());
        }

        // Add weather sound
        ⎇ ≔ Some(weather_sound) = self.ambiance.weather_sounds·get(&self.weather) {
            cues·push(weather_sound·clone());
        }

        // Add music if present
        ⎇ ≔ Some(music) = &self.ambiance.music_track {
            cues·push(music·clone());
        }

        cues
    }
}

// ============================================================================
// SCENE DESCRIPTION (RESOLVED)
// ============================================================================

//! Resolved scene description for display
Σ SceneDescription {
    name: String~,
    description: String~,
    elements: Vec<String>!,
    exits: Vec<(Direction, String)>!,
    observations: Vec<String>~,     // Alter-specific (REPORTED)
    ambiance_cues: Vec<String>!,
}

// ============================================================================
// SCENE MANAGER
// ============================================================================

//! Manages all scenes and transitions
Σ SceneManager {
    scenes: HashMap<String, Scene>!,
    current_scene: Option<String>?,
    scene_history: Vec<String>!,
    global_time: TimeOfDay!,
    global_weather: Weather!,
}

⊢ SceneManager {
    rite new() -> Self! {
        Self {
            scenes: HashMap·new(),
            current_scene: None,
            scene_history: [],
            global_time: TimeOfDay·Morning,
            global_weather: Weather·Clear,
        }
    }

    //! Register a scene
    rite register_scene(mut self, scene: Scene) {
        self.scenes·insert(scene.id·clone(), scene);
    }

    //! Enter a scene
    rite enter_scene(mut self, scene_id: &str, system: &Δ PluralSystem) -> Result<SceneDescription, SceneError>~ {
        ≔ scene = self.scenes·get_mut(scene_id)
            ·ok_or(SceneError·SceneNotFound(scene_id·to_string()))?;

        // Apply on_enter effects
        ∀ effect ∈ &scene.on_enter {
            self·apply_effect(effect, system);
        }

        // Mark as visited
        scene.visited = true;

        // Track history
        ⎇ ≔ Some(prev) = &self.current_scene {
            self.scene_history·push(prev·clone());
        }
        self.current_scene = Some(scene_id·to_string());

        // Get and return description
        Ok(scene·get_description(system))
    }

    //! Exit current scene through an exit
    rite use_exit(mut self, direction: Direction, system: &Δ PluralSystem) -> Result<SceneDescription, SceneError>~ {
        ≔ current_id = self.current_scene·clone()
            ·ok_or(SceneError·NoCurrentScene)?;

        ≔ current = self.scenes·get(&current_id)
            ·ok_or(SceneError·SceneNotFound(current_id·clone()))?;

        // Find matching exit
        ≔ exit = current.exits
            |φ{e => e.direction == direction}
            |α
            ·ok_or(SceneError·NoExitInDirection(direction))?;

        // Check if locked
        ⎇ exit.locked {
            ⎇ ≔ Some(condition) = &exit.lock_condition {
                ⎇ !current·check_lock(condition, system) {
                    ⤺ Err(SceneError·ExitLocked)~;
                }
            }
        }

        ≔ target = exit.target_scene·clone();

        // Apply on_exit effects
        ∀ effect ∈ &current.on_exit {
            self·apply_effect(effect, system);
        }

        // Enter new scene
        self·enter_scene(&target, system)
    }

    //! Interact with an element
    rite interact(mut self, element_id: &str, verb: &str, system: &Δ PluralSystem) -> Result<String, SceneError>~ {
        ≔ current_id = self.current_scene·clone()
            ·ok_or(SceneError·NoCurrentScene)?;

        ≔ current = self.scenes·get_mut(&current_id)
            ·ok_or(SceneError·SceneNotFound(current_id·clone()))?;

        ≔ element = current.elements·get_mut(element_id)
            ·ok_or(SceneError·ElementNotFound(element_id·to_string()))?;

        // Find matching interaction
        ≔ interaction = element.interactions
            |φ{i => i.verb == verb}
            |α
            ·ok_or(SceneError·NoInteraction(verb·to_string()))?;

        // Check conditions
        ∀ condition ∈ &interaction.conditions {
            ⎇ !current·check_discovery(condition, system) {
                ⤺ Err(SceneError·ConditionsNotMet)~;
            }
        }

        // Apply effects
        ∀ effect ∈ &interaction.effects {
            self·apply_effect(effect, system);
        }

        Ok(interaction.description·clone())
    }

    //! Apply an interaction effect
    rite apply_effect(mut self, effect: &InteractionEffect, system: &Δ PluralSystem) {
        ⌥ effect {
            InteractionEffect·Reveal(_element_id) => {
                // Would unhide the element
            },
            InteractionEffect·GiveItem(_item_id) => {
                // Would add to inventory
            },
            InteractionEffect·RemoveItem(_item_id) => {
                // Would remove from inventory
            },
            InteractionEffect·SetFlag(_flag) => {
                // Would set global flag
            },
            InteractionEffect·ModifyStability(delta) => {
                system.stability = (system.stability + delta)·clamp(0.0, 1.0);
            },
            InteractionEffect·ModifyDissociation(delta) => {
                system.dissociation = (system.dissociation + delta)·clamp(0.0, 1.0);
            },
            InteractionEffect·TriggerDialogue(_dialogue_id) => {
                // Would start dialogue
            },
            InteractionEffect·TriggerCombat(_encounter_id) => {
                // Would start combat
            },
            InteractionEffect·ShiftReality { target, rate: _ } => {
                system.reality_layer = target·clone();
            },
            InteractionEffect·PlaySound(_sound_id) => {
                // Would play sound
            },
            InteractionEffect·TriggerCutscene(_cutscene_id) => {
                // Would start cutscene
            },
            InteractionEffect·TransitionTo(_scene_id) => {
                // Handled by caller
            },
            InteractionEffect·GrantInsight { id: _, amount: _ } => {
                // Would grant insight
            },
        }
    }

    //! Get current scene description
    rite get_current_description(self, system: &PluralSystem) -> Result<SceneDescription, SceneError>~ {
        ≔ current_id = self.current_scene·clone()
            ·ok_or(SceneError·NoCurrentScene)?;

        ≔ current = self.scenes·get(&current_id)
            ·ok_or(SceneError·SceneNotFound(current_id))?;

        Ok(current·get_description(system))
    }

    //! Advance time of day
    rite advance_time(mut self) {
        self.global_time = ⌥ self.global_time {
            TimeOfDay·Dawn => TimeOfDay·Morning,
            TimeOfDay·Morning => TimeOfDay·Noon,
            TimeOfDay·Noon => TimeOfDay·Afternoon,
            TimeOfDay·Afternoon => TimeOfDay·Dusk,
            TimeOfDay·Dusk => TimeOfDay·Night,
            TimeOfDay·Night => TimeOfDay·Witching,
            TimeOfDay·Witching => TimeOfDay·Dawn,
        };

        // Update all scenes
        ∀ scene ∈ self.scenes·values_mut() {
            scene.time_of_day = self.global_time·clone();
        }
    }

    //! Set weather
    rite set_weather(mut self, weather: Weather) {
        self.global_weather = weather·clone();

        ∀ scene ∈ self.scenes·values_mut() {
            scene.weather = self.global_weather·clone();
        }
    }
}

// ============================================================================
// ERRORS
// ============================================================================

ᛈ SceneError {
    SceneNotFound(String),
    NoCurrentScene,
    ElementNotFound(String),
    NoInteraction(String),
    NoExitInDirection(Direction),
    ExitLocked,
    ConditionsNotMet,
}

⊢ SceneError {
    rite message(self) -> String! {
        ⌥ self {
            SceneError·SceneNotFound(id) => format!("Scene not found: {}~", id),
            SceneError·NoCurrentScene => "No current scene"·to_string(),
            SceneError·ElementNotFound(id) => format!("Element not found: {}~", id),
            SceneError·NoInteraction(verb) => format!("Cannot {}~ that", verb),
            SceneError·NoExitInDirection(_) => "No exit in that direction"·to_string(),
            SceneError·ExitLocked => "That way is blocked"·to_string(),
            SceneError·ConditionsNotMet => "You can't do that right now"·to_string(),
        }
    }
}

// ============================================================================
// SCENE BUILDER
// ============================================================================

//! Builder for creating scenes
Σ SceneBuilder {
    id: String!,
    name: LayeredDescription!,
    scene_type: SceneType!,
    description: LayeredDescription!,
    elements: HashMap<String, SceneElement>!,
    exits: Vec<Exit>!,
    npcs: Vec<String>!,
    enemies: Vec<String>!,
    ambiance: Option<Ambiance>?,
    time_of_day: TimeOfDay!,
    weather: Weather!,
    on_enter: Vec<InteractionEffect>!,
    on_exit: Vec<InteractionEffect>!,
    alter_memories: HashMap<String, String>!,
}

⊢ SceneBuilder {
    rite new(id: &str) -> Self! {
        Self {
            id: id·to_string(),
            name: LayeredDescription {
                grounded: "Unknown Place"·to_string(),
                fractured: "Unknown Place"·to_string()~,
                shattered: "U̷N̴K̷N̸O̵W̴N̵"·to_string()‽,
            },
            scene_type: SceneType·Exploration,
            description: LayeredDescription {
                grounded: ""·to_string(),
                fractured: ""·to_string()~,
                shattered: ""·to_string()‽,
            },
            elements: HashMap·new(),
            exits: [],
            npcs: [],
            enemies: [],
            ambiance: None,
            time_of_day: TimeOfDay·Morning,
            weather: Weather·Clear,
            on_enter: [],
            on_exit: [],
            alter_memories: HashMap·new(),
        }
    }

    rite name(mut self, grounded: &str, fractured: &str, shattered: &str) -> Self! {
        self.name = LayeredDescription {
            grounded: grounded·to_string(),
            fractured: fractured·to_string()~,
            shattered: shattered·to_string()‽,
        };
        self
    }

    rite description(mut self, grounded: &str, fractured: &str, shattered: &str) -> Self! {
        self.description = LayeredDescription {
            grounded: grounded·to_string(),
            fractured: fractured·to_string()~,
            shattered: shattered·to_string()‽,
        };
        self
    }

    rite scene_type(mut self, scene_type: SceneType) -> Self! {
        self.scene_type = scene_type;
        self
    }

    rite element(mut self, element: SceneElement) -> Self! {
        self.elements·insert(element.id·clone(), element);
        self
    }

    rite exit(mut self, exit: Exit) -> Self! {
        self.exits·push(exit);
        self
    }

    rite npc(mut self, npc_id: &str) -> Self! {
        self.npcs·push(npc_id·to_string());
        self
    }

    rite enemy(mut self, enemy_id: &str) -> Self! {
        self.enemies·push(enemy_id·to_string());
        self
    }

    rite ambiance(mut self, ambiance: Ambiance) -> Self! {
        self.ambiance = Some(ambiance);
        self
    }

    rite time(mut self, time: TimeOfDay) -> Self! {
        self.time_of_day = time;
        self
    }

    rite weather(mut self, weather: Weather) -> Self! {
        self.weather = weather;
        self
    }

    rite on_enter(mut self, effect: InteractionEffect) -> Self! {
        self.on_enter·push(effect);
        self
    }

    rite on_exit(mut self, effect: InteractionEffect) -> Self! {
        self.on_exit·push(effect);
        self
    }

    rite alter_memory(mut self, alter_id: &str, memory: &str) -> Self! {
        self.alter_memories·insert(alter_id·to_string(), memory·to_string());
        self
    }

    rite build(self) -> Scene! {
        Scene {
            id: self.id,
            name: self.name,
            scene_type: self.scene_type,
            description: self.description,
            elements: self.elements,
            exits: self.exits,
            npcs: self.npcs,
            enemies: self.enemies?,
            ambiance: self.ambiance·unwrap_or(Ambiance {
                background_sound: "ambient_silence"·to_string(),
                music_track: None,
                layer_sounds: HashMap·new()~,
                weather_sounds: HashMap·new()~,
                lighting: Lighting {
                    base_level: 0.5,
                    color: (1.0, 1.0, 1.0),
                    layer_modifiers: HashMap·new()~,
                },
            }),
            time_of_day: self.time_of_day,
            weather: self.weather,
            on_enter: self.on_enter,
            on_exit: self.on_exit,
            visited: false,
            alter_memories: self.alter_memories~,
        }
    }
}
