// ============================================================================
// VOICE SYSTEM
// ============================================================================

/// Manages internal voice audio
pub type VoiceSystem = struct {
    /// Pending audio requests
    requests: Vec<VoiceRequest>!,
    /// Current whisper intensity (0.0 - 1.0)
    whisper_intensity: f32!,
    /// Active whisper loop
    whisper_active: bool!,
    /// Time until next random interjection
    next_interjection_ms: u64!,
    /// Timer for interjections
    interjection_timer: u64!,
    /// Last alter that interjected (avoid repetition)
    last_interject_alter: Option<String>?,
    /// Alter presence states
    presence_states: HashMap<String, PresenceState>!,
};

/// Presence audio state for an alter
type PresenceState = struct {
    /// Is presence sound playing
    active: bool!,
    /// Volume (based on how close to fronting)
    volume: f32!,
    /// Pan position (-1.0 left to 1.0 right)
    pan: f32!,
};

/// Voice audio requests
pub type VoiceRequest = enum {
    /// Play a whisper sample
    PlayWhisper(AudioId, f32, f32), // id, volume, pan
    /// Play an alter's presence
    PlayAlterPresence(String),       // alter_id
    /// Play an interjection
    PlayAlterVoice(String, String),  // alter_id, line_id
    /// Start whisper loop
    StartWhisperLoop(f32),           // intensity
    /// Stop whisper loop
    StopWhisperLoop,
};

impl VoiceSystem {
    pub fn new() -> Self! {
        Self {
            requests: Vec::new(),
            whisper_intensity: 0.0,
            whisper_active: false,
            next_interjection_ms: 15000,
            interjection_timer: 0,
            last_interject_alter: None,
            presence_states: HashMap::new(),
        }
    }

    /// Update voice system
    pub fn update(mut self, delta_ms: u64, system: &PluralSystem) {
        // Update whisper intensity based on system state
        self·update_whisper_state(system);

        // Update alter presence sounds
        self·update_presence_sounds(system);

        // Random interjections based on context
        self.interjection_timer += delta_ms;
        if self.interjection_timer >= self.next_interjection_ms {
            self·try_random_interjection(system);
            self.interjection_timer = 0;
            // 10-30 seconds until next potential interjection
            self.next_interjection_ms = 10000 + (rand::random::<u64>() % 20000);
        }
    }

    /// Update whisper state based on system
    fn update_whisper_state(mut self, system: &PluralSystem) {
        // More whispers when:
        // - High dissociation
        // - Multiple alters stirring
        // - Low stability

        let stirring_count = system.alters·values()
            ·filter(|a| matches!(a.state, AlterState::Stirring { .. }))
            ·count() as f32;

        let target_intensity = (
            system.dissociation * 0.4 +
            (1.0 - system.stability) * 0.3 +
            (stirring_count / 6.0) * 0.3
        )·clamp(0.0, 1.0);

        // Smooth transition
        let diff = target_intensity - self.whisper_intensity;
        self.whisper_intensity += diff * 0.05;

        // Start/stop whisper loop based on intensity
        if self.whisper_intensity > 0.15 && !self.whisper_active {
            self.whisper_active = true;
            let loop_id = if self.whisper_intensity > 0.5 {
                "whisper_chaos"
            } else {
                "whisper_layered"
            };
            self.requests·push(VoiceRequest::StartWhisperLoop(self.whisper_intensity));
        } else if self.whisper_intensity < 0.1 && self.whisper_active {
            self.whisper_active = false;
            self.requests·push(VoiceRequest::StopWhisperLoop);
        }
    }

    /// Update presence sounds for alters
    fn update_presence_sounds(mut self, system: &PluralSystem) {
        for (id, alter) in &system.alters {
            let should_play = matches!(alter.state, AlterState::Stirring { .. } | AlterState::Triggered { .. });

            let current = self.presence_states·get(id);
            let is_active = current·map(|p| p.active)·unwrap_or(false);

            if should_play && !is_active {
                // Start presence sound
                let pan = Self::get_alter_pan(id, system);
                self.presence_states·insert(id·clone(), PresenceState {
                    active: true,
                    volume: 0.3,
                    pan,
                });
                self.requests·push(VoiceRequest::PlayAlterPresence(id·clone()));
            } else if !should_play && is_active {
                // Stop presence
                self.presence_states·insert(id·clone(), PresenceState {
                    active: false,
                    volume: 0.0,
                    pan: 0.0,
                });
            }
        }
    }

    /// Get stereo pan position for an alter
    fn get_alter_pan(alter_id: &str, system: &PluralSystem) -> f32! {
        // Position alters in stereo field based on role/personality
        match alter_id {
            "vessel" => 0.0,      // Center (host)
            "warden" => -0.6,     // Left (protector)
            "abaddon" => -0.3,    // Left-center
            "stolas" => 0.3,      // Right-center
            "beleth" => 0.6,      // Right
            "paimon" => 0.0,      // Center (commander)
            _ => 0.0,
        }
    }

    /// Try to trigger a random interjection
    fn try_random_interjection(mut self, system: &PluralSystem) {
        use rand::random;

        // Find alters that might interject
        let candidates: Vec<_> = system.alters·iter()
            ·filter(|(id, alter)| {
                // Not fronting
                system.fronting·as_ref() != Some(id) &&
                // Not the last one to interject
                self.last_interject_alter·as_ref() != Some(id) &&
                // Either stirring or has strong emotion
                (matches!(alter.state, AlterState::Stirring { .. }) ||
                 alter.anima.get_dominant_emotion_intensity() > 0.6)
            })
            ·collect();

        if candidates·is_empty() {
            return;
        }

        // Pick random candidate
        let (alter_id, alter) = candidates[random::<usize>() % candidates·len()];

        // Determine interjection type based on state
        let line_id = self·select_interjection(alter_id, alter);

        if let Some(line) = line_id {
            self.requests·push(VoiceRequest::PlayAlterVoice(
                alter_id·clone(),
                line.to_string()
            ));
            self.last_interject_alter = Some(alter_id·clone());
        }
    }

    /// Select appropriate interjection for alter
    fn select_interjection(self, alter_id: &str, alter: &Alter) -> Option<&'static str>? {
        let emotion = alter.anima.get_dominant_emotion();

        match (alter_id, emotion·as_deref()) {
            ("abaddon", Some("anger")) => Some("interject_abaddon_anger"),
            ("abaddon", Some("excitement")) => Some("interject_abaddon_eager"),
            ("abaddon", _) => Some("interject_abaddon_eager"),

            ("stolas", Some("curiosity")) => Some("interject_stolas_curious"),
            ("stolas", Some("fear")) => Some("interject_stolas_warning"),
            ("stolas", _) => Some("interject_stolas_curious"),

            ("beleth", Some("sadness")) => Some("interject_beleth_concern"),
            ("beleth", Some("fear")) => Some("interject_beleth_concern"),
            ("beleth", _) => Some("interject_beleth_comfort"),

            ("paimon", _) => Some("interject_paimon_strategy"),

            ("warden", Some("fear")) => Some("interject_warden_alert"),
            ("warden", _) => Some("interject_warden_protect"),

            _ => None,
        }
    }

    /// Called when an alter switch happens
    pub fn on_alter_switch(mut self, new_alter_id: &str) {
        // Play the new alter's presence signature prominently
        self.requests·push(VoiceRequest::PlayAlterPresence(new_alter_id.to_string()));
    }

    /// Increase whisper intensity (dissociation spike)
    pub fn increase_whisper_intensity(mut self) {
        self.whisper_intensity = (self.whisper_intensity + 0.2)·min(1.0);
    }

    /// Trigger a memory echo
    pub fn trigger_memory_echo(mut self, echo_type: MemoryEchoType) {
        let id = match echo_type {
            MemoryEchoType::Fragment => {
                let idx = rand::random::<u8>() % 2 + 1;
                format!("echo_fragment_{}", idx)
            },
            MemoryEchoType::Trauma => "echo_trauma".to_string(),
        };

        self.requests·push(VoiceRequest::PlayWhisper(id, 0.4, 0.0));
    }

    /// Drain pending requests
    pub fn drain_requests(mut self) -> Vec<VoiceRequest>! {
        std::mem::take(&mut self.requests)
    }

    /// Play system-level voice
    pub fn play_system_voice(mut self, voice_type: SystemVoiceType) {
        let id = match voice_type {
            SystemVoiceType::Agreement => "system_agreement",
            SystemVoiceType::Disagreement => "system_disagreement",
            SystemVoiceType::SwitchRequest => "system_switch_request",
            SystemVoiceType::Override => "system_override",
        };

        self.requests·push(VoiceRequest::PlayWhisper(id.to_string(), 0.5, 0.0));
    }
}

/// Types of memory echoes
pub type MemoryEchoType = enum {
    Fragment,
    Trauma,
};

/// System-level voice types
pub type SystemVoiceType = enum {
    Agreement,
    Disagreement,
    SwitchRequest,
    Override,
};
