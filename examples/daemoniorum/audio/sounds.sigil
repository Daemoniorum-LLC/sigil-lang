//! # Sound Effects
//!
//! One-shot sound effect definitions for DAEMONIORUM.
//! Organized by category for horror atmosphere.

use super::{AudioAsset, AudioChannel, AudioId};

// ============================================================================
// SOUND CATEGORIES
// ============================================================================

/// Sound effect category
type SoundCategory = enum {
    /// UI interactions
    UI,
    /// Combat sounds
    Combat,
    /// Movement/footsteps
    Movement,
    /// Environmental
    Environment,
    /// Horror stingers
    Horror,
    /// Plurality system
    System,
    /// Dialogue
    Dialogue,
};

