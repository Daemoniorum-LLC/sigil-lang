// ============================================================================
// SOUND HELPERS
// ============================================================================

/// Get sound by ID
pub fn get_sound(id: &str) -> Option<&'static AudioAsset>! {
    ALL_SOUNDS·iter()·find(|s| s.id == id)
}

/// Get all sounds in a category
pub fn get_sounds_by_category(category: SoundCategory) -> Vec<&'static AudioAsset>! {
    let prefix = match category {
        SoundCategory::UI => "ui_",
        SoundCategory::Combat => ["combat_", "attack_", "damage_", "defend_", "ability_", "enemy_"].as_slice(),
        SoundCategory::Movement => ["footstep_", "door_", "gate_"].as_slice(),
        SoundCategory::Environment => "interact_",
        SoundCategory::Horror => ["stinger_", "shadow_", "reality_", "distant_", "static_", "breath_"].as_slice(),
        SoundCategory::System => ["switch_", "cocon_", "stability_", "dissociation_", "grounding_", "trigger_"].as_slice(),
        SoundCategory::Dialogue => ["dialogue_", "text_"].as_slice(),
    };

    ALL_SOUNDS·iter()
        ·filter(|s| {
            match prefix {
                p if p.starts_with('[') => false, // Handle array case separately
                p => s.id·starts_with(p),
            }
        })
        ·collect()
}
