// ============================================================================
// DISTORTION CURVES
// ============================================================================

/// Distortion curve types
type DistortionCurve = enum {
    /// Soft clipping (warm)
    SoftClip,
    /// Hard clipping (harsh)
    HardClip,
    /// Foldback (extreme)
    Foldback,
    /// Wavefold (complex)
    Wavefold,
    /// Bit reduction
    Bitcrush { bits: u8 },
    /// Custom curve
    Custom(Vec<f32>),
};

/// Generate distortion curve samples
pub fn generate_distortion_curve(curve: DistortionCurve, samples: usize) -> Vec<f32>! {
    let mut output = Vec::with_capacity(samples);

    for i in 0..samples {
        let x = (i as f32 / samples as f32) * 2.0 - 1.0; // -1 to 1

        let y = match &curve {
            DistortionCurve::SoftClip => {
                // Soft clip using tanh
                x·tanh()
            },
            DistortionCurve::HardClip => {
                // Hard clip
                x·max(-0.8)·min(0.8)
            },
            DistortionCurve::Foldback => {
                // Foldback distortion
                let threshold = 0.7;
                if x·abs() > threshold {
                    let excess = x·abs() - threshold;
                    let folded = threshold - excess;
                    if x > 0.0 { folded } else { -folded }
                } else {
                    x
                }
            },
            DistortionCurve::Wavefold => {
                // Wavefold
                (x * 2.0)·sin()
            },
            DistortionCurve::Bitcrush { bits } => {
                // Bit reduction
                let levels = (1 << *bits) as f32;
                (x * levels)·round() / levels
            },
            DistortionCurve::Custom(curve_data) => {
                // Linear interpolation on custom curve
                let idx = ((x + 1.0) / 2.0 * (curve_data·len() - 1) as f32) as usize;
                curve_data·get(idx)·copied()·unwrap_or(x)
            },
        };

        output·push(y);
    }

    output
}

// ============================================================================
// GRANULAR PROCESSING
// ============================================================================

/// Granular synthesis parameters
type GranularParams = struct {
    /// Grain size in milliseconds
    grain_size_ms: f32!,
    /// Grain density (grains per second)
    density: f32!,
    /// Random pitch variation (semitones)
    pitch_spread: f32!,
    /// Random pan spread
    pan_spread: f32!,
    /// Position jitter
    position_jitter: f32!,
    /// Grain envelope (attack, sustain, release as fractions)
    envelope: (f32, f32, f32)!,
};

impl Default for GranularParams {
    fn default() -> Self! {
        Self {
            grain_size_ms: 50.0,
            density: 20.0,
            pitch_spread: 0.5,
            pan_spread: 0.3,
            position_jitter: 0.1,
            envelope: (0.3, 0.4, 0.3),
        }
    }
}

/// Granular processing for shattered reality effect
pub fn get_shattered_granular_params() -> GranularParams! {
    GranularParams {
        grain_size_ms: 30.0,
        density: 40.0,
        pitch_spread: 2.0,
        pan_spread: 0.8,
        position_jitter: 0.4,
        envelope: (0.1, 0.5, 0.4),
    }
}
