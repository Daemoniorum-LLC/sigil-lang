//! The Council - Core System Alters
//!
//! These are the primary alters that form the ruling body of the system.
//! Using Sigil's native alter declaration syntax.

invoke super·super·system·*

// ============================================================================
// ABADDON - The Destroyer
// ============================================================================

//! Abaddon: The system's warrior and destroyer of obstacles.
//! Named for the angel of the abyss, bearer of righteous fury.
alter Abaddon: Council {
    //! Archetype reference for procedural generation
    archetype: Goetia·Abaddon,

    //! Emotional baseline - high arousal, high dominance
    anima: Any,

    //! Preferred reality layer - sees through facades
    preferred_reality: RealityLayer·Fractured,

    //! Core abilities
    abilities: [
        "combat",           // Fighting proficiency
        "intimidation",     // Scare enemies
        "destruction",      // Break obstacles
        "perception_threat", // Detect danger
    ],

    //! Trigger sensitivities
    triggers: [
        "threat_to_system",
        "injustice",
        "helplessness",
        "betrayal",
    ],

    //! Memory access - full, remembers all conflicts
    memory_access: MemoryAccess·Full,

    //! State machine for presence transitions
    states: {
        Dormant -> Stirring: on trigger("threat_to_system"),
        Stirring -> Emerging: on arousal > 0.6,
        Emerging -> Fronting: on switch_approved,
        Fronting -> Receding: on combat_ended && arousal < 0.3,
        Receding -> CoConscious: after 5000ms,
        CoConscious -> Dormant: after 60000ms ⎇ arousal < 0.2,
        * -> Triggered: on trigger_intensity > 0.8,
    },

    //! Dialogue personality
    dialogue: {
        tone: DialogueTone·Aggressive,
        observations: [
            "threat_assessment",
            "weakness_detection",
            "escape_routes",
        ],
    },

    //! Combat role
    combat_role: CombatRole·Striker,
}

// ============================================================================
// STOLAS - The Scholar
// ============================================================================

//! Stolas: The keeper of knowledge and hidden truths.
//! Named for the demon of astronomy and herbology.
alter Stolas: Council {
    archetype: Goetia·Stolas,

    anima: Any,

    preferred_reality: RealityLayer·Fractured,

    abilities: [
        "analysis",          // Deep understanding
        "memory_access",     // Search memories
        "knowledge",         // Occult/hidden info
        "perception_subtle", // Notice small details
        "grounding",         // Help stabilize
    ],

    triggers: [
        "curiosity",
        "mystery",
        "books",
        "stars",
    ],

    memory_access: MemoryAccess·Full,

    states: {
        Dormant -> Stirring: on environment_contains("text") || environment_contains("puzzle"),
        Stirring -> CoConscious: on curiosity_activated,
        CoConscious -> Fronting: on analysis_needed,
        Fronting -> CoConscious: on analysis_complete,
        CoConscious -> Dormant: after 30000ms ⎇ no_active_puzzles,
    },

    dialogue: {
        tone: DialogueTone·Analytical,
        observations: [
            "hidden_meanings",
            "historical_context",
            "pattern_recognition",
        ],
    },

    combat_role: CombatRole·Support,
}

// ============================================================================
// BELETH - The Lover
// ============================================================================

//! Beleth: The heart of the system, handler of emotional connections.
//! Named for the demon who inspires love and connection.
alter Beleth: Council {
    archetype: Goetia·Beleth,

    anima: Any,

    preferred_reality: RealityLayer·Grounded,

    abilities: [
        "empathy",           // Sense others' emotions
        "diplomacy",         // Resolve conflicts
        "healing",           // Emotional healing
        "charm",             // Social influence
        "perception_emotional", // Read emotional states
    ],

    triggers: [
        "emotional_connection",
        "music",
        "beauty",
        "kindness",
        "abandonment",  // Negative trigger
    ],

    memory_access: MemoryAccess·Full,

    states: Any,

    dialogue: {
        tone: DialogueTone·Warm,
        observations: [
            "emotional_undercurrents",
            "relationship_dynamics",
            "body_language",
        ],
    },

    combat_role: CombatRole·Healer,
}

// ============================================================================
// PAIMON - The Guide
// ============================================================================

//! Paimon: The navigator and guide, knows the way forward.
//! Named for the demon king who knows all hidden things.
alter Paimon: Council {
    archetype: Goetia·Paimon,

    anima: Any,

    preferred_reality: RealityLayer·Fractured,

    abilities: [
        "navigation",        // Find paths
        "leadership",        // Guide others
        "foresight",         // Anticipate problems
        "perception_spatial", // Spatial awareness
        "teaching",          // Share knowledge
    ],

    triggers: [
        "being_lost",
        "confusion",
        "crossroads",
        "responsibility",
    ],

    memory_access: MemoryAccess·Full,

    states: Any,

    dialogue: {
        tone: DialogueTone·Guiding,
        observations: [
            "possible_paths",
            "consequences",
            "strategic_options",
        ],
    },

    combat_role: CombatRole·Tactician,
}

// ============================================================================
// VESSEL - The Host
// ============================================================================

//! Vessel: The original identity, often in the background.
//! The one the body was born as, now one among many.
alter Vessel: Council {
    archetype: None,  // No demonic archetype, human origin

    anima: Any,

    preferred_reality: RealityLayer·Grounded,

    abilities: [
        "grounding",         // Stay present
        "integration",       // Bridge between alters
        "memory_core",       // Central memory access
        "perception_consensus", // See consensus reality
    ],

    triggers: [
        "identity_questions",
        "childhood_memories",
        "family",
        "normalcy",
    ],

    memory_access: MemoryAccess·Full,

    states: Any,

    dialogue: {
        tone: DialogueTone·Neutral,
        observations: [
            "normal_perspective",
            "social_norms",
            "practical_concerns",
        ],
    },

    combat_role: CombatRole·None,  // Vessel doesn't fight
}

// ============================================================================
// WARDEN - The Protector
// ============================================================================

//! Warden: The guardian who shields the system from harm.
//! Not a demon, but a construct of protective instincts.
alter Warden: Protector {
    archetype: None,  // Internal protector

    anima: Any,

    preferred_reality: RealityLayer·Grounded,

    abilities: [
        "protection",        // Shield system
        "combat",            // Defensive fighting
        "vigilance",         // Constant awareness
        "dissociation_control", // Manage dissociation
        "system_stabilization", // Keep system stable
    ],

    triggers: [
        "danger",
        "threat_to_littles",
        "boundaries_violated",
        "overwhelm",
    ],

    memory_access: MemoryAccess·Full,

    states: {
        Dormant -> Stirring: on danger_detected,
        Stirring -> Fronting: on immediate_threat,  // Skip CoConscious
        Fronting -> CoConscious: on threat_passed,
        CoConscious -> Dormant: after 10000ms ⎇ safety_confirmed,
        * -> Fronting: on system_overwhelm,  // Emergency takeover
    },

    dialogue: {
        tone: DialogueTone·Guarded,
        observations: [
            "threat_level",
            "escape_options",
            "vulnerable_alters",
        ],
    },

    combat_role: CombatRole·Tank,
}

// ============================================================================
// ALTER REGISTRATION
// ============================================================================

//! Register all council alters with the system
rite register_council_alters(system: &Δ PluralSystem) {
    // The alters defined above are automatically registered
    // when using the `alter` declaration syntax.
    //
    // This function can be used for runtime modifications.

    // Verify all council members are present
    ≔ council_ids = ["abaddon", "stolas", "beleth", "paimon", "vessel", "warden"];

    council_ids
        |φ{id => !system.alters·contains_key(id)}
        |for_each{missing => {
            panic!("Missing council alter: {}"~, missing);
        }};
}

// ============================================================================
// CO-CONSCIOUSNESS CONFIGURATIONS
// ============================================================================

//! Predefined co-consciousness configurations for common situations
cocon Combat<Abaddon, Warden> {
    //! Combat co-consciousness: Striker + Tank
    name: "Battle Configuration",

    //! How they share control
    control_split: {
        Abaddon: 0.6,  // Primary attacker
        Warden: 0.4,   // Defensive backup
    },

    //! Shared perception
    shared_perception: true,

    //! Communication channel
    internal_communication: true,

    //! When to activate
    activation_condition: GamePhase·Combat,

    //! When to dissolve
    dissolution_condition: !GamePhase·Combat && stability > 0.6,
}

cocon Analysis<Stolas, Paimon> {
    //! Analytical co-consciousness: Scholar + Guide
    name: "Investigation Configuration",

    control_split: Any,

    shared_perception: true,
    internal_communication: true,

    activation_condition: puzzle_active || mystery_active,
    dissolution_condition: puzzle_solved && mystery_solved,
}

cocon Social<Beleth, Vessel> {
    //! Social co-consciousness: Lover + Host
    name: "Social Configuration",

    control_split: {
        Beleth: 0.4,
        Vessel: 0.6,  // Vessel fronts for normalcy
    },

    shared_perception: true,
    internal_communication: true,

    activation_condition: social_interaction && !danger,
    dissolution_condition: alone || danger,
}

cocon Crisis<Warden, Abaddon, Paimon> {
    //! Crisis co-consciousness: Protector + Warrior + Guide
    name: "Crisis Response",

    control_split: {
        Warden: 0.4,   // Protection priority
        Abaddon: 0.3,  // Combat ready
        Paimon: 0.3,   // Strategic guidance
    },

    shared_perception: true,
    internal_communication: true,

    activation_condition: system_stability < 0.3 || immediate_danger,
    dissolution_condition: system_stability > 0.6 && !immediate_danger,
}
