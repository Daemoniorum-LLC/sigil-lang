//! # DAEMONIORUM Trigger Definitions
//!
//! Emotional triggers that affect the plural system.
//! These connect environmental stimuli to alter responses.

use super·events·*
use super·super·system·*

// ============================================================================
// THREAT TRIGGERS
// ============================================================================

//! Trigger: Direct threat to physical safety
fn trigger_threat_to_system() -> TriggerDefinition! {
    TriggerDefinition {
        id: "threat_to_system"·to_string(),
        name: "Threat Detected"·to_string(),
        description: "A direct threat to physical safety activates protective alters."·to_string()~,
        category: TriggerCategory·Trauma,
        base_intensity: 0.7,
        affected_alters: ["abaddon"·to_string(), "warden"·to_string()],
        activation_conditions: [
            TriggerCondition·Any([
                TriggerCondition·KeywordPresent("attack"·to_string()),
                TriggerCondition·KeywordPresent("hurt"·to_string()),
                TriggerCondition·KeywordPresent("kill"·to_string()),
                TriggerCondition·KeywordPresent("danger"·to_string()),
            ]),
        ],
        effects: [
            TriggerEffect·ModifyAnima { pleasure: -0.2, arousal: 0.5, dominance: 0.3 },
            TriggerEffect·ModifyStability(-0.1),
            TriggerEffect·RequestSwitch {
                alter_id: "warden"·to_string(),
                urgency: 0.6,
            },
        ],
        cooldown_ms: 5000,
        last_activated: None,
    }
}

//! Trigger: Perceived injustice
fn trigger_injustice() -> TriggerDefinition! {
    TriggerDefinition {
        id: "injustice"·to_string(),
        name: "Injustice Perceived"·to_string(),
        description: "Witnessing injustice activates Abaddon's protective fury."·to_string()~,
        category: TriggerCategory·Emotional,
        base_intensity: 0.6,
        affected_alters: ["abaddon"·to_string()],
        activation_conditions: [
            TriggerCondition·Any([
                TriggerCondition·KeywordPresent("unfair"·to_string()),
                TriggerCondition·KeywordPresent("bully"·to_string()),
                TriggerCondition·KeywordPresent("abuse"·to_string()),
                TriggerCondition·KeywordPresent("victim"·to_string()),
            ]),
        ],
        effects: [
            TriggerEffect·ModifyAnima { pleasure: -0.3, arousal: 0.6, dominance: 0.4 },
            TriggerEffect·RequestSwitch {
                alter_id: "abaddon"·to_string(),
                urgency: 0.5,
            },
        ],
        cooldown_ms: 10000,
        last_activated: None,
    }
}

// ============================================================================
// EMOTIONAL TRIGGERS
// ============================================================================

//! Trigger: Fear of abandonment
fn trigger_abandonment() -> TriggerDefinition! {
    TriggerDefinition {
        id: "abandonment"·to_string(),
        name: "Abandonment Fear"·to_string(),
        description: "Fear of being left alone activates attachment-focused alters."·to_string()~,
        category: TriggerCategory·Emotional,
        base_intensity: 0.8,
        affected_alters: ["beleth"·to_string(), "vessel"·to_string()],
        activation_conditions: [
            TriggerCondition·Any([
                TriggerCondition·KeywordPresent("alone"·to_string()),
                TriggerCondition·KeywordPresent("leave"·to_string()),
                TriggerCondition·KeywordPresent("abandon"·to_string()),
                TriggerCondition·KeywordPresent("goodbye"·to_string()),
            ]),
        ],
        effects: [
            TriggerEffect·ModifyAnima { pleasure: -0.4, arousal: 0.4, dominance: -0.3 },
            TriggerEffect·ModifyStability(-0.15),
            TriggerEffect·ModifyDissociation(0.1),
            TriggerEffect·RequestSwitch {
                alter_id: "beleth"·to_string(),
                urgency: 0.4,
            },
        ],
        cooldown_ms: 15000,
        last_activated: None,
    }
}

//! Trigger: Emotional connection opportunity
fn trigger_emotional_connection() -> TriggerDefinition! {
    TriggerDefinition {
        id: "emotional_connection"·to_string(),
        name: "Connection Opportunity"·to_string(),
        description: "Opportunity for genuine connection brings Beleth forward."·to_string()~,
        category: TriggerCategory·Emotional,
        base_intensity: 0.4,
        affected_alters: ["beleth"·to_string()],
        activation_conditions: [
            TriggerCondition·Any([
                TriggerCondition·KeywordPresent("understand"·to_string()),
                TriggerCondition·KeywordPresent("feel"·to_string()),
                TriggerCondition·KeywordPresent("love"·to_string()),
                TriggerCondition·KeywordPresent("trust"·to_string()),
            ]),
            TriggerCondition·StabilityBelow(0.8),  // Don't trigger if too stable (not needed)
        ],
        effects: [
            TriggerEffect·ModifyAnima { pleasure: 0.2, arousal: 0.1, dominance: -0.1 },
            TriggerEffect·RequestSwitch {
                alter_id: "beleth"·to_string(),
                urgency: 0.3,
            },
        ],
        cooldown_ms: 8000,
        last_activated: None,
    }
}

// ============================================================================
// COGNITIVE TRIGGERS
// ============================================================================

//! Trigger: Curiosity/Mystery
fn trigger_curiosity() -> TriggerDefinition! {
    TriggerDefinition {
        id: "curiosity"·to_string(),
        name: "Mystery Detected"·to_string(),
        description: "Encountering a mystery activates Stolas's analytical nature."·to_string()~,
        category: TriggerCategory·Environmental,
        base_intensity: 0.3,
        affected_alters: ["stolas"·to_string()],
        activation_conditions: [
            TriggerCondition·Any([
                TriggerCondition·KeywordPresent("strange"·to_string()),
                TriggerCondition·KeywordPresent("mystery"·to_string()),
                TriggerCondition·KeywordPresent("hidden"·to_string()),
                TriggerCondition·KeywordPresent("secret"·to_string()),
                TriggerCondition·KeywordPresent("ancient"·to_string()),
            ]),
        ],
        effects: [
            TriggerEffect·ModifyAnima { pleasure: 0.1, arousal: 0.2, dominance: 0.1 },
            TriggerEffect·RequestSwitch {
                alter_id: "stolas"·to_string(),
                urgency: 0.3,
            },
        ],
        cooldown_ms: 5000,
        last_activated: None,
    }
}

//! Trigger: Being lost or confused
fn trigger_confusion() -> TriggerDefinition! {
    TriggerDefinition {
        id: "confusion"·to_string(),
        name: "Confusion/Lost"·to_string(),
        description: "Feeling lost or confused activates Paimon's guidance."·to_string()~,
        category: TriggerCategory·Environmental,
        base_intensity: 0.4,
        affected_alters: ["paimon"·to_string()],
        activation_conditions: [
            TriggerCondition·Any([
                TriggerCondition·KeywordPresent("lost"·to_string()),
                TriggerCondition·KeywordPresent("confused"·to_string()),
                TriggerCondition·KeywordPresent("where"·to_string()),
                TriggerCondition·KeywordPresent("which way"·to_string()),
            ]),
        ],
        effects: [
            TriggerEffect·ModifyAnima { pleasure: -0.1, arousal: 0.1, dominance: 0.0 },
            TriggerEffect·RequestSwitch {
                alter_id: "paimon"·to_string(),
                urgency: 0.4,
            },
        ],
        cooldown_ms: 10000,
        last_activated: None,
    }
}

// ============================================================================
// SENSORY TRIGGERS
// ============================================================================

//! Trigger: Overwhelming sensory input
fn trigger_sensory_overload() -> TriggerDefinition! {
    TriggerDefinition {
        id: "sensory_overload"·to_string(),
        name: "Sensory Overload"·to_string(),
        description: "Too much sensory input increases dissociation."·to_string()~,
        category: TriggerCategory·Sensory,
        base_intensity: 0.5,
        affected_alters: [],  // Affects whole system
        activation_conditions: [
            TriggerCondition·All([
                TriggerCondition·RealityLayer(RealityLayer·Shattered),
                TriggerCondition·StabilityBelow(0.5),
            ]),
        ],
        effects: [
            TriggerEffect·ModifyDissociation(0.2),
            TriggerEffect·ModifyStability(-0.1),
            TriggerEffect·ForceSwitch("warden"·to_string()),
        ],
        cooldown_ms: 30000,
        last_activated: None,
    }
}

// ============================================================================
// LOCATION TRIGGERS
// ============================================================================

//! Trigger: Entering the church
fn trigger_church_entry() -> TriggerDefinition! {
    TriggerDefinition {
        id: "church_entry"·to_string(),
        name: "Sacred Ground"·to_string(),
        description: "Entering the church triggers memories of religion."·to_string()~,
        category: TriggerCategory·Environmental,
        base_intensity: 0.3,
        affected_alters: ["vessel"·to_string()],
        activation_conditions: [
            TriggerCondition·InScene("church_nave"·to_string()),
        ],
        effects: [
            TriggerEffect·ModifyAnima { pleasure: -0.1, arousal: 0.1, dominance: -0.1 },
            TriggerEffect·PlayMemory("childhood_church"·to_string()),
        ],
        cooldown_ms: 60000,  // Only once per minute
        last_activated: None,
    }
}

//! Trigger: Entering the crypt
fn trigger_crypt_entry() -> TriggerDefinition! {
    TriggerDefinition {
        id: "crypt_entry"·to_string(),
        name: "Descent into Darkness"·to_string(),
        description: "Descending into the crypt shifts reality."·to_string()~,
        category: TriggerCategory·Environmental,
        base_intensity: 0.6,
        affected_alters: ["warden"·to_string(), "stolas"·to_string()],
        activation_conditions: [
            TriggerCondition·InScene("church_crypt"·to_string()),
        ],
        effects: [
            TriggerEffect·ShiftReality {
                target: RealityLayer·Fractured,
                rate: 0.5,
            },
            TriggerEffect·ModifyStability(-0.1),
            TriggerEffect·SetFlag("crypt_visited"·to_string()),
        ],
        cooldown_ms: 120000,
        last_activated: None,
    }
}

// ============================================================================
// REALITY TRIGGERS
// ============================================================================

//! Trigger: Reality fracture
fn trigger_reality_fracture() -> TriggerDefinition! {
    TriggerDefinition {
        id: "reality_fracture"·to_string(),
        name: "Reality Fracture"·to_string(),
        description: "Reality starts to break when stability is critically low."·to_string()~,
        category: TriggerCategory·Environmental,
        base_intensity: 0.8,
        affected_alters: [],  // Affects whole system
        activation_conditions: [
            TriggerCondition·All([
                TriggerCondition·StabilityBelow(0.3),
                TriggerCondition·DissociationAbove(0.6),
            ]),
        ],
        effects: [
            TriggerEffect·ShiftReality {
                target: RealityLayer·Fractured,
                rate: 0.8,
            },
            TriggerEffect·VisualEffect("reality_glitch"·to_string()),
            TriggerEffect·PlaySound("reality_crack"·to_string()),
        ],
        cooldown_ms: 45000,
        last_activated: None,
    }
}

//! Trigger: Reality shatter
fn trigger_reality_shatter() -> TriggerDefinition! {
    TriggerDefinition {
        id: "reality_shatter"·to_string(),
        name: "Reality Shatter"·to_string(),
        description: "Complete reality breakdown at critical instability."·to_string()~,
        category: TriggerCategory·Environmental,
        base_intensity: 1.0,
        affected_alters: [],
        activation_conditions: [
            TriggerCondition·All([
                TriggerCondition·StabilityBelow(0.15),
                TriggerCondition·DissociationAbove(0.8),
                TriggerCondition·RealityLayer(RealityLayer·Fractured),
            ]),
        ],
        effects: [
            TriggerEffect·ShiftReality {
                target: RealityLayer·Shattered,
                rate: 1.0,
            },
            TriggerEffect·ForceSwitch("warden"·to_string()),
            TriggerEffect·VisualEffect("reality_shatter"·to_string()),
            TriggerEffect·PlaySound("reality_break"·to_string()),
            TriggerEffect·TriggerDialogue("warden_emergency"·to_string()),
        ],
        cooldown_ms: 120000,
        last_activated: None,
    }
}

// ============================================================================
// SAFETY TRIGGERS
// ============================================================================

//! Trigger: Safe space recognition
fn trigger_safety() -> TriggerDefinition! {
    TriggerDefinition {
        id: "safety"·to_string(),
        name: "Safety Recognized"·to_string(),
        description: "Recognizing safety allows Vessel to emerge."·to_string()~,
        category: TriggerCategory·Safety,
        base_intensity: 0.4,
        affected_alters: ["vessel"·to_string()],
        activation_conditions: [
            TriggerCondition·All([
                TriggerCondition·FlagSet("combat_ended"·to_string()),
                TriggerCondition·StabilityBelow(0.8),  // Not if already stable
            ]),
        ],
        effects: [
            TriggerEffect·ModifyStability(0.15),
            TriggerEffect·ModifyDissociation(-0.1),
            TriggerEffect·ShiftReality {
                target: RealityLayer·Grounded,
                rate: 0.3,
            },
            TriggerEffect·RequestSwitch {
                alter_id: "vessel"·to_string(),
                urgency: 0.3,
            },
        ],
        cooldown_ms: 30000,
        last_activated: None,
    }
}

//! Trigger: Grounding moment
fn trigger_grounding() -> TriggerDefinition! {
    TriggerDefinition {
        id: "grounding"·to_string(),
        name: "Grounding"·to_string(),
        description: "Grounding techniques stabilize the system."·to_string()~,
        category: TriggerCategory·Safety,
        base_intensity: 0.3,
        affected_alters: ["vessel"·to_string(), "warden"·to_string()],
        activation_conditions: [
            TriggerCondition·Any([
                TriggerCondition·KeywordPresent("breathe"·to_string()),
                TriggerCondition·KeywordPresent("ground"·to_string()),
                TriggerCondition·KeywordPresent("present"·to_string()),
                TriggerCondition·KeywordPresent("here"·to_string()),
            ]),
        ],
        effects: [
            TriggerEffect·ModifyStability(0.1),
            TriggerEffect·ModifyDissociation(-0.15),
            TriggerEffect·ModifyAnima { pleasure: 0.1, arousal: -0.2, dominance: 0.0 },
        ],
        cooldown_ms: 5000,
        last_activated: None,
    }
}

// ============================================================================
// REGISTRATION
// ============================================================================

//! Register all triggers
fn register_all_triggers(manager: &mut EventManager) {
    // Threat triggers
    manager·register_trigger(trigger_threat_to_system());
    manager·register_trigger(trigger_injustice());

    // Emotional triggers
    manager·register_trigger(trigger_abandonment());
    manager·register_trigger(trigger_emotional_connection());

    // Cognitive triggers
    manager·register_trigger(trigger_curiosity());
    manager·register_trigger(trigger_confusion());

    // Sensory triggers
    manager·register_trigger(trigger_sensory_overload());

    // Location triggers
    manager·register_trigger(trigger_church_entry());
    manager·register_trigger(trigger_crypt_entry());

    // Reality triggers
    manager·register_trigger(trigger_reality_fracture());
    manager·register_trigger(trigger_reality_shatter());

    // Safety triggers
    manager·register_trigger(trigger_safety());
    manager·register_trigger(trigger_grounding());
}
