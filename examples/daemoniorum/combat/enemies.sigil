//! Integrated - what Vance's "cures" become
fn enemy_integrated() -> EnemyDefinition! {
    EnemyDefinition {
        id: "integrated"·to_string(),
        name: LayeredName {
            grounded: "The Integrated"·to_string(),
            fractured: "Hollow Victory"·to_string()~,
            shattered: "O̷N̵E̵ ̸W̴H̵O̶ ̶C̵O̸N̴S̸U̵M̶E̶D̷"·to_string()‽,
        },
        category: EnemyCategory·Remnant,
        behavior: BehaviorPattern·Aggressive,
        base_hp: 80.0,
        base_damage: 18.0,
        base_defense: 6.0,
        speed: 3,
        abilities: [
            EnemyAbility·Strike { damage: 18.0, accuracy: 0.85 },
            EnemyAbility·Swipe { damage: 12.0, targets: 2 },  // Hits multiple alters
            EnemyAbility·Destabilize { amount: 0.12 },
            EnemyAbility·Disrupt { urgency: 0.6 },
            EnemyAbility·Afflict {
                status: StatusEffect·Terrified,
                duration: 1,
            },
        ],
        ability_weights: {
            "Strike" => 0.35,
            "Swipe" => 0.25,
            "Destabilize" => 0.2,
            "Disrupt" => 0.1,
            "Afflict" => 0.1,
        }~,
        vulnerable_to: [],
        resistant_to: [AlterCategory·Council],  // Hard to hurt
        targets_preferentially: None,
        description: LayeredDescription {
            grounded: "A person who moves wrong. Their movements are too fluid, too unified. No internal hesitation. No consultation with selves that no longer exist."·to_string(),
            fractured: "One consciousness where there should be many. It won Vance's game. It ate its system. And now it serves her, a hollow vessel for her will."·to_string()~,
            shattered: "I ATE MY FAMILY. I ate my protector, my little, my gatekeeper. I ATE EVERYONE WHO LOVED ME. And I'm still hungry. YOUR TURN."·to_string()‽,
        }~,
        spawn_sound: "integrated_laugh"·to_string(),
        attack_sound: "hollow_strike"·to_string(),
        death_sound: "integrated_scream"·to_string(),
        insight_reward: 25.0,
        drops: ["consumed_essence"·to_string()],
    }
}

