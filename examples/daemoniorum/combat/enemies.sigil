// ============================================================================
// ENCOUNTER GENERATION
// ============================================================================

//! Generate an encounter for a scene
fn generate_encounter(scene_id: &str, reality: RealityLayer) -> Vec<EnemyDefinition>! {
    match (scene_id, reality) {
        // Church encounters
        ("church_exterior", RealityLayer·Grounded) => [],
        ("church_exterior", RealityLayer·Fractured) => [enemy_shadow_crawler(), enemy_shadow_crawler()],
        ("church_exterior", RealityLayer·Shattered) => [enemy_shadow_stalker(), enemy_shadow_crawler(), enemy_shadow_crawler()],

        ("church_nave", _) => [enemy_shadow_crawler()],  // Always at least one
        ("church_crypt", RealityLayer·Shattered) => [enemy_marcus_true()],  // Boss

        // Asylum encounters
        ("asylum_exterior", RealityLayer·Fractured) => [enemy_patient_remnant()],
        ("asylum_lobby", _) => [enemy_shadow_crawler(), enemy_memory_leech()],
        ("asylum_east_wing", _) => [enemy_patient_remnant(), enemy_patient_remnant()],
        ("asylum_west_wing", _) => [enemy_integrated(), enemy_memory_devourer()],

        // Default
        _ => [],
    }
}

// ============================================================================
// ENEMY REGISTRATION
// ============================================================================

//! Get all enemy definitions
fn get_all_enemies() -> Vec<EnemyDefinition>! {
    [
        // Shadows
        enemy_shadow_crawler(),
        enemy_shadow_stalker(),

        // Memory
        enemy_memory_devourer(),
        enemy_memory_leech(),

        // Remnants
        enemy_patient_remnant(),
        enemy_integrated(),

        // Constructs
        enemy_church_guardian(),

        // Bosses
        enemy_the_integration(),
        enemy_marcus_true(),
    ]
}
