            shattered: "A MOUTHPIECE OF THE BUILDING. The church itself attacking through carved stone. Every statue, every gargoyle - they're all its fingers."·to_string()‽,
        }~,
        spawn_sound: "stone_crumble"·to_string(),
        attack_sound: "stone_impact"·to_string(),
        death_sound: "stone_shatter"·to_string(),
        insight_reward: 30.0,
        drops: ["sacred_stone"·to_string()],
    }
}

