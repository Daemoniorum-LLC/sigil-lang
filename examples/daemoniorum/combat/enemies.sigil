//! # DAEMONIORUM Enemy Types
//!
//! Various enemy types with unique mechanics that interact
//! with the plurality system. Enemies can target alters,
//! manipulate memories, and exploit system vulnerabilities.

use super·combat·*
use super·super·system·*
use std·collections·HashMap

// ============================================================================
// ENEMY CATEGORIES
// ============================================================================

//! Types of enemies
enum EnemyCategory {
    Shadow,         // Basic manifestations of darkness
    Memory,         // Entities that feed on/manipulate memories
    Remnant,        // Remains of consumed consciousnesses
    Construct,      // Created by places of power
    Boss,           // Major threats
}

//! Enemy behavior patterns
enum BehaviorPattern {
    Aggressive,     // Always attack
    Defensive,      // Attack when threatened
    Stalker,        // Target weakened alters
    Feeder,         // Drain resources
    Swarm,          // Group tactics
    Ambusher,       // Strike from hiding
}

// ============================================================================
// ENEMY ABILITIES
// ============================================================================

//! Special abilities enemies can have
enum EnemyAbility {
    //! Basic damage attack
    Strike {
        damage: f32,
        accuracy: f32,
    },

    //! Multi-target attack
    Swipe {
        damage: f32,
        targets: u32,
    },

    //! Increase dissociation
    Unsettle {
        amount: f32,
    },

    //! Decrease stability
    Destabilize {
        amount: f32,
    },

    //! Force alter switch
    Disrupt {
        urgency: f32,
    },

    //! Steal a memory/ability temporarily
    MemoryDrain {
        duration_turns: u32,
    },

    //! Target specific alter
    Focus {
        alter_category: AlterCategory,
        damage_mod: f32,
    },

    //! Shift reality layer
    RealityWarp {
        target: RealityLayer,
    },

    //! Heal self
    Regenerate {
        amount: f32,
    },

    //! Summon more enemies
    Spawn {
        enemy_type: String,
        count: u32,
    },

    //! Buff other enemies
    Empower {
        damage_buff: f32,
        defense_buff: f32,
    },

    //! Afflict status
    Afflict {
        status: StatusEffect,
        duration: u32,
    },
}

//! Status effects
enum StatusEffect {
    Weakened,       // -damage
    Vulnerable,     // +damage taken
    Confused,       // Random actions
    Silenced,       // Can't use abilities
    Drained,        // -resource regen
    Terrified,      // Can't attack
    Dissociating,   // Random switches
}

// ============================================================================
// ENEMY DEFINITION
// ============================================================================

//! Complete enemy definition
struct EnemyDefinition {
    id: String!,
    name: LayeredName!,
    category: EnemyCategory!,
    behavior: BehaviorPattern!,

    // Stats
    base_hp: f32!,
    base_damage: f32!,
    base_defense: f32!,
    speed: u32!,

    // Abilities
    abilities: Vec<EnemyAbility>!,
    ability_weights: HashMap<String, f32>~,  // AI preference weights

    // Alter interactions
    vulnerable_to: Vec<AlterCategory>!,     // Takes extra damage from
    resistant_to: Vec<AlterCategory>!,       // Takes less damage from
    targets_preferentially: Option<AlterCategory>?,  // AI targeting

    // Visual
    description: LayeredDescription~,
    spawn_sound: String!,
    attack_sound: String!,
    death_sound: String!,

    // Rewards
    insight_reward: f32!,
    drops: Vec<String>!,
}

//! Layered name for different realities
struct LayeredName {
    grounded: String!,
    fractured: String~,
    shattered: String‽,
}

//! Layered description for different realities
struct LayeredDescription {
    grounded: String!,
    fractured: String~,
    shattered: String‽,
}

// ============================================================================
// SHADOW CRAWLERS - Basic Enemies
// ============================================================================

//! Create a basic Shadow Crawler
fn enemy_shadow_crawler() -> EnemyDefinition! {
    EnemyDefinition {
        id: "shadow_crawler"·to_string(),
        name: LayeredName {
            grounded: "Shadow Crawler"·to_string(),
            fractured: "Crawling Dark"·to_string()~,
            shattered: "P̸I̵E̷C̵E̶ ̷O̷F̵ ̸U̸S̴"·to_string()‽,
        },
        category: EnemyCategory·Shadow,
        behavior: BehaviorPattern·Swarm,
        base_hp: 30.0,
        base_damage: 8.0,
        base_defense: 2.0,
        speed: 3,
        abilities: [
            EnemyAbility·Strike { damage: 8.0, accuracy: 0.85 },
            EnemyAbility·Unsettle { amount: 0.05 },
        ],
        ability_weights: {
            "Strike" => 0.7,
            "Unsettle" => 0.3,
        }~,
        vulnerable_to: [AlterCategory·Council],  // Council members deal +damage
        resistant_to: [],
        targets_preferentially: None,
        description: LayeredDescription {
            grounded: "A mass of writhing shadows that skitters along the floor. It has no features, only hunger."·to_string(),
            fractured: "It was human once. You can see the shape of a face trying to form in the darkness. It's screaming."·to_string()~,
            shattered: "ONE OF THE DEVOURED. A consciousness stripped of form, reduced to instinct. It remembers nothing but pain."·to_string()‽,
        }~,
        spawn_sound: "shadow_emerge"·to_string(),
        attack_sound: "claw_swipe"·to_string(),
        death_sound: "shadow_disperse"·to_string(),
        insight_reward: 5.0,
        drops: [],
    }
}

//! Create a Shadow Stalker - ambush variant
fn enemy_shadow_stalker() -> EnemyDefinition! {
    EnemyDefinition {
        id: "shadow_stalker"·to_string(),
        name: LayeredName {
            grounded: "Shadow Stalker"·to_string(),
            fractured: "The Watcher"·to_string()~,
            shattered: "H̵U̴N̸G̶E̸R̶ ̵W̵I̷T̵H̴ ̴E̷Y̴E̸S̴"·to_string()‽,
        },
        category: EnemyCategory·Shadow,
        behavior: BehaviorPattern·Stalker,
        base_hp: 45.0,
        base_damage: 15.0,
        base_defense: 3.0,
        speed: 5,  // Fast
        abilities: [
            EnemyAbility·Strike { damage: 15.0, accuracy: 0.9 },
            EnemyAbility·Focus {
                alter_category: AlterCategory·Core,  // Targets Vessel
                damage_mod: 1.5,
            },
            EnemyAbility·Destabilize { amount: 0.1 },
        ],
        ability_weights: {
            "Strike" => 0.5,
            "Focus" => 0.3,
            "Destabilize" => 0.2,
        }~,
        vulnerable_to: [AlterCategory·Council],
        resistant_to: [],
        targets_preferentially: Some(AlterCategory·Core)?,  // Hunts the Vessel
        description: LayeredDescription {
            grounded: "A larger shadow that moves with predatory grace. Its eyes - if they are eyes - gleam with malevolent intelligence."·to_string(),
            fractured: "It's been watching you. Learning your patterns. It knows which alter is weakest right now."·to_string()~,
            shattered: "A PREDATOR OF SELVES. It hunts the core, the host, the one they think holds everything together. KILL THE CENTER AND THE REST WILL FALL."·to_string()‽,
        }~,
        spawn_sound: "stalker_emerge"·to_string(),
        attack_sound: "predator_strike"·to_string(),
        death_sound: "stalker_howl"·to_string(),
        insight_reward: 12.0,
        drops: ["shadow_essence"·to_string()],
    }
}

// ============================================================================
// MEMORY DEVOURERS - Special Enemies
// ============================================================================

//! Memory Devourer - can steal abilities temporarily
fn enemy_memory_devourer() -> EnemyDefinition! {
    EnemyDefinition {
        id: "memory_devourer"·to_string(),
        name: LayeredName {
            grounded: "Memory Devourer"·to_string(),
            fractured: "The Forgetting"·to_string()~,
            shattered: "W̷H̶A̵T̸ ̶Y̵O̵U̶ ̶W̷E̶R̴E̶"·to_string()‽,
        },
        category: EnemyCategory·Memory,
        behavior: BehaviorPattern·Feeder,
        base_hp: 60.0,
        base_damage: 10.0,
        base_defense: 5.0,
        speed: 2,  // Slow
        abilities: [
            EnemyAbility·Strike { damage: 10.0, accuracy: 0.8 },
            EnemyAbility·MemoryDrain { duration_turns: 3 },
            EnemyAbility·Unsettle { amount: 0.1 },
            EnemyAbility·Afflict {
                status: StatusEffect·Confused,
                duration: 2,
            },
        ],
        ability_weights: {
            "MemoryDrain" => 0.4,  // Primary ability
            "Strike" => 0.3,
            "Unsettle" => 0.2,
            "Afflict" => 0.1,
        }~,
        vulnerable_to: [],
        resistant_to: [AlterCategory·Introject],  // Resists alters formed from memories
        targets_preferentially: None,
        description: LayeredDescription {
            grounded: "A translucent figure that phases in and out of visibility. When solid, it appears to be made of flowing, liquid thought."·to_string(),
            fractured: "It's made of stolen memories. You see flashes in its form - a child's birthday, a first kiss, a mother's face. All devoured. All digested."·to_string()~,
            shattered: "IT WANTS WHAT MAKES YOU YOU. Every memory that defines an alter, every experience that shaped them - it will eat until there's nothing left but an empty shell."·to_string()‽,
        }~,
        spawn_sound: "memory_whisper"·to_string(),
        attack_sound: "mind_tear"·to_string(),
        death_sound: "memories_release"·to_string(),
        insight_reward: 20.0,
        drops: ["memory_fragment"·to_string()],
    }
}

