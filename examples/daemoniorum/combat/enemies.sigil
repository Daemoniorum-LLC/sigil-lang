//! Patient Remnant - souls trapped in the asylum
fn enemy_patient_remnant() -> EnemyDefinition! {
    EnemyDefinition {
        id: "patient_remnant"·to_string(),
        name: LayeredName {
            grounded: "Patient Remnant"·to_string(),
            fractured: "The Unintegrated"·to_string()~,
            shattered: "T̷H̵E̷Y̶ ̵D̵I̸D̸N̷'̷T̵ ̸S̵A̵V̵E̶ ̸U̷S̷"·to_string()‽,
        },
        category: EnemyCategory·Remnant,
        behavior: BehaviorPattern·Defensive,
        base_hp: 40.0,
        base_damage: 12.0,
        base_defense: 4.0,
        speed: 2,
        abilities: [
            EnemyAbility·Strike { damage: 12.0, accuracy: 0.8 },
            EnemyAbility·Destabilize { amount: 0.08 },
            EnemyAbility·Disrupt { urgency: 0.4 },  // Can force switches
        ],
        ability_weights: {
            "Strike" => 0.5,
            "Destabilize" => 0.3,
            "Disrupt" => 0.2,
        }~,
        vulnerable_to: [AlterCategory·Council],
        resistant_to: [],
        targets_preferentially: None,
        description: LayeredDescription {
            grounded: "A figure in a hospital gown, features blurred and indistinct. It reaches toward you with desperation, not malice."·to_string(),
            fractured: "You see what it was - a person, a system, someone like you. Vance's 'integration therapy' didn't heal them. It broke them into this."·to_string()~,
            shattered: "WE WERE LIKE YOU. We had names. We had selves. We had families inside us. THEY TOOK EVERYTHING. And now we're just... noise."·to_string()‽,
        }~,
        spawn_sound: "patient_moan"·to_string(),
        attack_sound: "desperate_grab"·to_string(),
        death_sound: "patient_release"·to_string(),
        insight_reward: 15.0,
