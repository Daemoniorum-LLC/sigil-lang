        },
        category: EnemyCategory·Boss,
        behavior: BehaviorPattern·Aggressive,
        base_hp: 500.0,
        base_damage: 25.0,
        base_defense: 8.0,
        speed: 4,
        abilities: [
            EnemyAbility·Strike { damage: 25.0, accuracy: 0.9 },
            EnemyAbility·Swipe { damage: 18.0, targets: 3 },
            EnemyAbility·MemoryDrain { duration_turns: 2 },
            EnemyAbility·Destabilize { amount: 0.15 },
            EnemyAbility·Disrupt { urgency: 0.8 },
            EnemyAbility·RealityWarp { target: RealityLayer·Shattered },
            EnemyAbility·Spawn { enemy_type: "patient_remnant"·to_string(), count: 2 },
            EnemyAbility·Regenerate { amount: 25.0 },
            EnemyAbility·Afflict {
                status: StatusEffect·Dissociating,
                duration: 2,
            },
        ],
        ability_weights: {
            "Strike" => 0.2,
            "Swipe" => 0.15,
            "MemoryDrain" => 0.15,
            "Destabilize" => 0.1,
            "Disrupt" => 0.1,
            "RealityWarp" => 0.1,
            "Spawn" => 0.1,
            "Regenerate" => 0.05,
            "Afflict" => 0.05,
        }~,
        vulnerable_to: [],  // No easy weaknesses
        resistant_to: [],
        targets_preferentially: Some(AlterCategory·Core)?,  // Wants the Vessel
        description: LayeredDescription {
            grounded: "Dr. Vance's form has become unstable. Faces push outward from beneath her skin - all the consciousnesses she has consumed over decades."·to_string(),
            fractured: "She's not one person wearing many faces. She's many people being worn by one will. Hundreds of screaming souls bound together by hunger and madness."·to_string()~,
            shattered: "W̷E̶ ̴A̴R̷E̴ ̵V̶A̷N̷C̶E̵.̷ We are her patients. We are her victims. We are her success and her failure. WE ARE WHAT INTEGRATION TRULY MEANS. And we will add you to us."·to_string()‽,
        }~,
        spawn_sound: "legion_manifest"·to_string(),
        attack_sound: "many_voices_strike"·to_string(),
        death_sound: "legion_unravel"·to_string(),
        insight_reward: 100.0,
        drops: ["integration_core"·to_string(), "vance_journal"·to_string()],
    }
}

