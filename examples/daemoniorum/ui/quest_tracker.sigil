//! DAEMONIORUM Game UI - Quest Tracker
//!
//! Displays active quests with objectives and progress:
//! - Collapsible quest cards
//! - Objective checklists with progress bars
//! - Category filtering
//! - Alter requirements highlighted

use super::tokens::colors;

// ============================================================================
// TYPES
// ============================================================================

/// Quest category
type QuestCategory = enum {
    Main,
    Side,
    Alter,
    Memory,
    Secret,
}

/// Quest status
type QuestStatus = enum {
    Available,
    Active,
    Completed,
    Failed,
}

/// Quest objective
type QuestObjective = struct {
    id: String!,
    description: String!,
    completed: bool!,
    current: u32!,
    required: u32!,
    optional: bool!,
}

/// Quest reward type
type QuestRewardType = enum {
    Item,
    Currency,
    Ability,
    Memory,
    AlterUnlock,
    TrustIncrease,
}

/// Quest reward
type QuestReward = struct {
    reward_type: QuestRewardType!,
    item_id: Option<String>?,
    amount: Option<u32>?,
}

/// Quest definition
type Quest = struct {
    id: String!,
    name: String!,
    description: String!,
    category: QuestCategory!,
    status: QuestStatus!,
    objectives: Vec<QuestObjective>!,
    rewards: Vec<QuestReward>!,
    is_main_quest: bool!,
    is_hidden: bool!,
    alter_requirement: Option<String>?,
}

// ============================================================================
// PROPS TYPES
// ============================================================================

/// Props for main quest tracker
type QuestTrackerProps = struct {
    quests: Vec<Quest>!,
    on_quest_select: Option<fn(Quest)>?,
    on_close: Option<fn()>?,
    compact: bool?,
}

/// Props for quest card
type QuestCardProps = struct {
    quest: Quest!,
    is_expanded: bool!,
    on_toggle: fn()!,
    on_select: fn()!,
}

/// Props for compact quest tracker
type CompactQuestTrackerProps = struct {
    quests: Vec<Quest>!,
    max_visible: u32?,
    on_expand: Option<fn()>?,
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

/// Get icon for category
fn get_category_icon(category: QuestCategory!) -> &'static str {
    match category {
        QuestCategory::Main => "⚔",
        QuestCategory::Side => "◇",
        QuestCategory::Alter => "✦",
        QuestCategory::Memory => "◈",
        QuestCategory::Secret => "?",
    }
}

/// Get status colors
fn get_status_colors(status: QuestStatus!) -> (String, String) {
    match status {
        QuestStatus::Available => ("rgba(59, 130, 246, 0.2)".to_string(), "#3b82f6".to_string()),
        QuestStatus::Active => ("rgba(251, 191, 36, 0.2)".to_string(), "#fbbf24".to_string()),
        QuestStatus::Completed => ("rgba(16, 185, 129, 0.2)".to_string(), "#10b981".to_string()),
        QuestStatus::Failed => ("rgba(239, 68, 68, 0.2)".to_string(), "#ef4444".to_string()),
    }
}

// ============================================================================
// MAIN QUEST TRACKER
// ============================================================================

#[component]
pub fn QuestTracker(props: QuestTrackerProps!) -> Element! {
    let (selected_category, set_selected_category) = use_signal::<Option<QuestCategory>>(None);
    let (expanded_quests, set_expanded_quests) = use_signal::<Vec<String>>(Vec::new());
    let (show_completed, set_show_completed) = use_signal(false);

    let categories = ["All", "Main", "Side", "Alter", "Memory", "Secret"];

    // If compact mode, render compact version
    if props.compact·unwrap_or(false) {
        return html! {
            <CompactQuestTracker
                quests={props.quests·iter()·|φ|q| q.status == QuestStatus::Active·collect()}
                on_expand={props.on_close·clone()}
            />
        };
    }

    // Filter quests
    let filtered_quests = props.quests·iter()
        ·|φ|quest| {
            // Hidden filter
            if quest.is_hidden && quest.status == QuestStatus::Available {
                return false;
            }

            // Completed filter
            if !show_completed() && (quest.status == QuestStatus::Completed || quest.status == QuestStatus::Failed) {
                return false;
            }

            // Category filter
            match selected_category() {
                None => true,
                Some(cat) => quest.category == cat,
            }
        }
        ·collect::<Vec<_>>()
        ·|τ|mut vec| {
            // Sort: Active first, then main quests
            vec·sort_by(|a, b| {
                if a.status == QuestStatus::Active && b.status != QuestStatus::Active {
                    std::cmp::Ordering::Less
                } else if a.status != QuestStatus::Active && b.status == QuestStatus::Active {
                    std::cmp::Ordering::Greater
                } else if a.is_main_quest && !b.is_main_quest {
                    std::cmp::Ordering::Less
                } else if !a.is_main_quest && b.is_main_quest {
                    std::cmp::Ordering::Greater
                } else {
                    std::cmp::Ordering::Equal
                }
            });
            vec
        };

    let toggle_expanded = |quest_id: String| {
        let mut current = expanded_quests();
        if current·contains(&quest_id) {
            current·retain(|id| id != &quest_id);
        } else {
            current·push(quest_id);
        }
        set_expanded_quests(current);
    };

    let active_count = props.quests·iter()·|φ|q| q.status == QuestStatus::Active·count();
    let completed_count = props.quests·iter()·|φ|q| q.status == QuestStatus::Completed·count();

    html! {
        <div style="display: flex; flex-direction: column; height: 100%; border-radius: 0.75rem; overflow: hidden; \
                    background: linear-gradient(135deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.95) 100%); \
                    border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 0 40px rgba(0,0,0,0.5);">

            // Header
            <div style="display: flex; align-items: center; justify-content: space-between; \
                        padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1);">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <h2 style="font-size: 1.125rem; font-weight: bold; color: white;">{"Quest Log"}</h2>
                    <div style="display: flex; gap: 0.5rem;">
                        <span style="padding: 0.125rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; \
                                     background: rgba(251,191,36,0.2); color: #fbbf24;">
                            {active_count}{" Active"}
                        </span>
                        <span style="padding: 0.125rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; \
                                     background: rgba(16,185,129,0.2); color: #10b981;">
                            {completed_count}{" Done"}
                        </span>
                    </div>
                </div>

                {if let Some(on_close) = &props.on_close {
                    html! {
                        <button
                            onclick={on_close·clone()}
                            style="padding: 0.375rem; border-radius: 0.5rem; \
                                   background: transparent; cursor: pointer; color: rgba(255,255,255,0.6);"
                        >
                            <span style="font-size: 1.25rem;">{"×"}</span>
                        </button>
                    }
                } else { html! {} }}
            </div>

            // Filters
            <div style="padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1);">
                // Category tabs
                <div style="display: flex; gap: 0.25rem; overflow-x: auto; padding-bottom: 0.75rem;">
                    {categories·iter()·|τ|cat| {
                        let is_selected = (*cat == "All" && selected_category()·is_none()) ||
                            selected_category()·map(|c| format!("{:?}", c) == *cat)·unwrap_or(false);

                        html! {
                            <button
                                onclick={move || {
                                    if *cat == "All" {
                                        set_selected_category(None);
                                    } else {
                                        let category = match *cat {
                                            "Main" => Some(QuestCategory::Main),
                                            "Side" => Some(QuestCategory::Side),
                                            "Alter" => Some(QuestCategory::Alter),
                                            "Memory" => Some(QuestCategory::Memory),
                                            "Secret" => Some(QuestCategory::Secret),
                                            _ => None,
                                        };
                                        set_selected_category(category);
                                    }
                                }}
                                style={format!(
                                    "padding: 0.375rem 0.75rem; border-radius: 0.5rem; \
                                     font-size: 0.75rem; font-weight: 500; white-space: nowrap; \
                                     cursor: pointer; transition: all 0.2s; \
                                     background: {}; color: {};",
                                    if is_selected { "rgba(255,255,255,0.2)" } else { "rgba(255,255,255,0.05)" },
                                    if is_selected { "white" } else { "rgba(255,255,255,0.6)" }
                                )}
                            >
                                {match *cat {
                                    "All" => "📜",
                                    "Main" => "⚔",
                                    "Side" => "◇",
                                    "Alter" => "✦",
                                    "Memory" => "◈",
                                    "Secret" => "?",
                                    _ => ""
                                }}{" "}{*cat}
                            </button>
                        }
                    }·collect::<Vec<_>>()}
                </div>

                // Show completed toggle
                <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; \
                              color: rgba(255,255,255,0.6); cursor: pointer;">
                    <input
                        type="checkbox"
                        checked={show_completed()}
                        onchange={move |e| set_show_completed(e.checked())}
                        style="border-radius: 0.25rem; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.2);"
                    />
                    {"Show completed quests"}
                </label>
            </div>

            // Quest list
            <div style="flex: 1; overflow-y: auto; padding: 1rem;">
                {if filtered_quests·is_empty() {
                    html! {
                        <div style="display: flex; flex-direction: column; align-items: center; \
                                    justify-content: center; height: 100%; color: rgba(255,255,255,0.4);">
                            <span style="font-size: 2.25rem; margin-bottom: 0.5rem;">{"📜"}</span>
                            <span style="font-size: 0.875rem;">{"No quests found"}</span>
                        </div>
                    }
                } else {
                    html! {
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            {filtered_quests·iter()·|τ|quest| {
                                let is_expanded = expanded_quests()·contains(&quest.id);
                                html! {
                                    <QuestCard
                                        quest={quest·clone()}
                                        is_expanded={is_expanded}
                                        on_toggle={move || toggle_expanded(quest.id·clone())}
                                        on_select={move || {
                                            if let Some(on_select) = &props.on_quest_select {
                                                on_select(quest·clone());
                                            }
                                        }}
                                    />
                                }
                            }·collect::<Vec<_>>()}
                        </div>
                    }
                }}
            </div>
        </div>
    }
}

// ============================================================================
// QUEST CARD
// ============================================================================

#[component]
pub fn QuestCard(props: QuestCardProps!) -> Element! {
    let quest! = &props.quest;
    let completed_objectives = quest.objectives·iter()·|φ|o| o.completed·count();
    let total_objectives = quest.objectives·len();
    let progress = (completed_objectives as f32 / total_objectives as f32) * 100.0;

    let (status_bg, status_color) = get_status_colors(quest.status);

    let bg_style = if quest.status == QuestStatus::Active {
        "linear-gradient(135deg, rgba(251,191,36,0.1) 0%, rgba(0,0,0,0.4) 100%)"
    } else {
        "rgba(0,0,0,0.4)"
    };

    html! {
        <div style={format!(
            "border-radius: 0.75rem; overflow: hidden; transition: all 0.3s; \
             background: {}; border: 1px solid rgba(255,255,255,0.1); {}",
            bg_style,
            if quest.is_main_quest { "outline: 1px solid rgba(251,191,36,0.3);" } else { "" }
        )}>
            // Header (clickable)
            <button
                onclick={props.on_toggle}
                style="width: 100%; padding: 1rem; text-align: left; cursor: pointer; \
                       background: transparent; transition: background 0.2s;"
            >
                <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                    // Category icon
                    <div style={format!(
                        "width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; \
                         display: flex; align-items: center; justify-content: center; font-size: 1.25rem; \
                         background: {};",
                        status_bg
                    )}>
                        {get_category_icon(quest.category)}
                    </div>

                    // Info
                    <div style="flex: 1; min-width: 0;">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            {if quest.is_main_quest {
                                html! {
                                    <span style="padding: 0.125rem 0.375rem; border-radius: 0.25rem; \
                                                 font-size: 0.75rem; font-weight: bold; \
                                                 background: rgba(251,191,36,0.2); color: #fbbf24;">
                                        {"MAIN"}
                                    </span>
                                }
                            } else { html! {} }}
                            <h3 style="font-weight: bold; color: white; white-space: nowrap; \
                                       overflow: hidden; text-overflow: ellipsis;">
                                {&quest.name}
                            </h3>
                        </div>

                        <p style="font-size: 0.875rem; color: rgba(255,255,255,0.6); margin-top: 0.125rem; \
                                  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; \
                                  overflow: hidden;">
                            {&quest.description}
                        </p>

                        // Progress bar
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
                            <div style="flex: 1; height: 0.375rem; border-radius: 9999px; \
                                        background: rgba(0,0,0,0.4); overflow: hidden;">
                                <div style={format!(
                                    "height: 100%; border-radius: 9999px; transition: all 0.3s; \
                                     width: {}%; background: {};",
                                    progress,
                                    if progress == 100.0 { "#10b981" } else { "#fbbf24" }
                                )}></div>
                            </div>
                            <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6);">
                                {completed_objectives}{"/"}{total_objectives}
                            </span>
                        </div>
                    </div>

                    // Status badge
                    <div style={format!(
                        "padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; \
                         background: {}; color: {};",
                        status_bg, status_color
                    )}>
                        {format!("{:?}", quest.status)}
                    </div>

                    // Expand arrow
                    <span style={format!(
                        "color: rgba(255,255,255,0.4); transition: transform 0.2s; \
                         transform: rotate({}deg);",
                        if props.is_expanded { 180 } else { 0 }
                    )}>
                        {"▼"}
                    </span>
                </div>
            </button>

            // Expanded content
            {if props.is_expanded {
                html! {
                    <div style="padding: 0 1rem 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
                        // Alter requirement
                        {if let Some(ref alter_req) = quest.alter_requirement {
                            html! {
                                <div style="margin-top: 0.75rem; padding: 0.5rem 0.75rem; border-radius: 0.5rem; \
                                            background: rgba(168,85,247,0.1); color: #c4b5fd; font-size: 0.875rem;">
                                    {"✦ Requires: "}<span style="font-weight: 500;">{alter_req}</span>
                                </div>
                            }
                        } else { html! {} }}

                        // Objectives
                        <div style="margin-top: 0.75rem;">
                            <div style="font-size: 0.75rem; font-weight: 500; color: rgba(255,255,255,0.6); margin-bottom: 0.5rem;">
                                {"Objectives"}
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                {quest.objectives·iter()·|τ|objective| {
                                    html! { <ObjectiveItem objective={objective·clone()} /> }
                                }·collect::<Vec<_>>()}
                            </div>
                        </div>

                        // Rewards
                        {if !quest.rewards·is_empty() {
                            html! {
                                <div style="margin-top: 1rem;">
                                    <div style="font-size: 0.75rem; font-weight: 500; color: rgba(255,255,255,0.6); margin-bottom: 0.5rem;">
                                        {"Rewards"}
                                    </div>
                                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                        {quest.rewards·iter()·|τ|reward| {
                                            html! { <RewardBadge reward={reward·clone()} /> }
                                        }·collect::<Vec<_>>()}
                                    </div>
                                </div>
                            }
                        } else { html! {} }}

                        // Track button
                        {if quest.status == QuestStatus::Active {
                            html! {
                                <button
                                    onclick={move |e| {
                                        e.stop_propagation();
                                        (props.on_select)();
                                    }}
                                    style="margin-top: 1rem; width: 100%; padding: 0.5rem; border-radius: 0.5rem; \
                                           background: rgba(251,191,36,0.2); color: #fbbf24; font-weight: 500; \
                                           cursor: pointer; transition: background 0.2s;"
                                >
                                    {"Track Quest"}
                                </button>
                            }
                        } else { html! {} }}
                    </div>
                }
            } else { html! {} }}
        </div>
    }
}

// ============================================================================
// OBJECTIVE ITEM
// ============================================================================

type ObjectiveItemProps = struct {
    objective: QuestObjective!,
}

#[component]
pub fn ObjectiveItem(props: ObjectiveItemProps!) -> Element! {
    let objective! = &props.objective;
    let progress = if objective.required > 1 {
        (objective.current as f32 / objective.required as f32) * 100.0
    } else if objective.completed {
        100.0
    } else {
        0.0
    };

    html! {
        <div style={format!(
            "display: flex; align-items: flex-start; gap: 0.5rem; padding: 0.5rem; border-radius: 0.5rem; \
             background: {};",
            if objective.completed { "rgba(16,185,129,0.1)" } else { "rgba(255,255,255,0.05)" }
        )}>
            // Checkbox
            <div style={format!(
                "width: 1.25rem; height: 1.25rem; border-radius: 0.25rem; flex-shrink: 0; margin-top: 0.125rem; \
                 display: flex; align-items: center; justify-content: center; \
                 background: {}; {}; color: white;",
                if objective.completed { "#10b981" } else { "transparent" },
                if !objective.completed { "border: 1px solid rgba(255,255,255,0.3)" } else { "" }
            )}>
                {if objective.completed { "✓" } else { "" }}
            </div>

            <div style="flex: 1; min-width: 0;">
                <div style={format!(
                    "font-size: 0.875rem; {} {};",
                    if objective.completed { "color: #34d399; text-decoration: line-through;" } else { "color: rgba(255,255,255,0.8);" },
                    if objective.optional { "font-style: italic;" } else { "" }
                )}>
                    {if objective.optional {
                        html! { <span style="color: rgba(255,255,255,0.4);">{"(Optional) "}</span> }
                    } else { html! {} }}
                    {&objective.description}
                </div>

                // Progress bar for countable objectives
                {if objective.required > 1 && !objective.completed {
                    html! {
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem;">
                            <div style="flex: 1; height: 0.25rem; border-radius: 9999px; \
                                        background: rgba(0,0,0,0.4); overflow: hidden;">
                                <div style={format!(
                                    "height: 100%; border-radius: 9999px; background: #fbbf24; width: {}%;",
                                    progress
                                )}></div>
                            </div>
                            <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6);">
                                {objective.current}{"/"}{objective.required}
                            </span>
                        </div>
                    }
                } else { html! {} }}
            </div>
        </div>
    }
}

// ============================================================================
// REWARD BADGE
// ============================================================================

type RewardBadgeProps = struct {
    reward: QuestReward!,
}

#[component]
pub fn RewardBadge(props: RewardBadgeProps!) -> Element! {
    let (icon, text, color) = match props.reward.reward_type {
        QuestRewardType::Item => ("◆", props.reward.item_id·clone()·unwrap_or("Item".to_string()), "#3b82f6"),
        QuestRewardType::Currency => ("◉", format!("{}", props.reward.amount·unwrap_or(0)), "#fbbf24"),
        QuestRewardType::Ability => ("✦", "New Ability".to_string(), "#a855f7"),
        QuestRewardType::Memory => ("◈", "Memory".to_string(), "#8b5cf6"),
        QuestRewardType::AlterUnlock => ("☆", "Alter Unlock".to_string(), "#ec4899"),
        QuestRewardType::TrustIncrease => ("♥", format!("+{} Trust", props.reward.amount·unwrap_or(0)), "#f43f5e"),
    };

    html! {
        <div style={format!(
            "display: inline-flex; align-items: center; gap: 0.375rem; \
             padding: 0.25rem 0.5rem; border-radius: 0.5rem; font-size: 0.75rem; font-weight: 500; \
             background: {}20; color: {};",
            color, color
        )}>
            <span>{icon}</span>
            <span>{text}</span>
        </div>
    }
}

// ============================================================================
// COMPACT QUEST TRACKER (for HUD)
// ============================================================================

#[component]
pub fn CompactQuestTracker(props: CompactQuestTrackerProps!) -> Element! {
    let max_visible = props.max_visible·unwrap_or(3) as usize;
    let visible_quests = props.quests·iter()·take(max_visible)·collect::<Vec<_>>();
    let remaining = props.quests·len()·saturating_sub(max_visible);

    html! {
        <div style="border-radius: 0.75rem; padding: 0.75rem; \
                    background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1);">
            // Header
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <span style="font-size: 0.75rem; font-weight: 500; color: rgba(255,255,255,0.6);">
                    {"Active Quests"}
                </span>
                {if !props.quests·is_empty() {
                    html! {
                        <span style="font-size: 0.75rem; color: #fbbf24;">
                            {props.quests·len()}
                        </span>
                    }
                } else { html! {} }}
            </div>

            // Quest list
            <div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
                {visible_quests·iter()·|τ|quest| {
                    let completed_objectives = quest.objectives·iter()·|φ|o| o.completed·count();
                    let total_objectives = quest.objectives·len();

                    html! {
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="font-size: 0.875rem;">{get_category_icon(quest.category)}</span>
                            <div style="flex: 1; min-width: 0;">
                                <div style="font-size: 0.875rem; color: white; white-space: nowrap; \
                                            overflow: hidden; text-overflow: ellipsis;">
                                    {&quest.name}
                                </div>
                                <div style="font-size: 0.75rem; color: rgba(255,255,255,0.4);">
                                    {completed_objectives}{"/"}{total_objectives}{" objectives"}
                                </div>
                            </div>
                        </div>
                    }
                }·collect::<Vec<_>>()}
            </div>

            // More quests button
            {if remaining > 0 {
                if let Some(on_expand) = &props.on_expand {
                    html! {
                        <button
                            onclick={on_expand·clone()}
                            style="width: 100%; margin-top: 0.5rem; font-size: 0.75rem; \
                                   color: rgba(255,255,255,0.4); background: transparent; cursor: pointer;"
                        >
                            {"+"}{remaining}{" more quests"}
                        </button>
                    }
                } else { html! {} }
            } else { html! {} }}

            // Empty state
            {if props.quests·is_empty() {
                html! {
                    <div style="font-size: 0.75rem; color: rgba(255,255,255,0.4); text-align: center; padding: 0.5rem;">
                        {"No active quests"}
                    </div>
                }
            } else { html! {} }}
        </div>
    }
}
