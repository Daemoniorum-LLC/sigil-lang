//! Alter Card Component
//!
//! Displays an alter's information with PAD emotional state visualization,
//! stats, and abilities. Features glass morphism and dynamic glow effects.

use sigil_web::prelude::*;
use crate::ui::tokens::{colors, spacing, borders, shadows, typography, animations};
use crate::system::{Alter, AlterRole, AlterStats, PADState, AlterAbility};

// ============================================================================
// PAD STATE
// ============================================================================

/// PAD (Pleasure-Arousal-Dominance) emotional state model
#[derive(Clone, Debug)]
pub type PADState = struct {
    pub pleasure: f32!,    // -1.0 to 1.0 (distress to joy)
    pub arousal: f32!,     // -1.0 to 1.0 (calm to alert)
    pub dominance: f32!,   // -1.0 to 1.0 (overwhelmed to in control)
}

impl PADState {
    /// Get emotion label based on PAD values
    pub fn emotion_label(self: &Self!) -> &'static str! {
        let p! = self·pleasure;
        let a! = self·arousal;
        let d! = self·dominance;

        if p > 0.3 && a < 0.0 && d > 0.0 { return "Calm"; }
        if p > 0.3 && a > 0.3 && d > 0.0 { return "Excited"; }
        if p < -0.3 && a > 0.3 && d < 0.0 { return "Anxious"; }
        if p < -0.3 && a > 0.3 && d > 0.0 { return "Angry"; }
        if p < -0.3 && a < -0.3 && d < 0.0 { return "Depressed"; }
        if p < -0.3 && a < 0.0 && d > 0.0 { return "Bored"; }
        if p > 0.0 && a > 0.0 && d < 0.0 { return "Surprised"; }
        if p > 0.3 && d > 0.3 { return "Content"; }

        "Neutral"
    }
}

// ============================================================================
// ALTER CARD PROPS
// ============================================================================

#[derive(Clone, Debug)]
pub type AlterCardProps = struct {
    pub alter: Alter!,
    pub is_active: bool!,
    pub is_cocon: bool!,
    pub on_select: Option[fn(Alter!) -> ()!]?,
    pub on_ability_select: Option[fn(AlterAbility!) -> ()!]?,
    pub compact: bool!,
    pub show_abilities: bool!,
}

// ============================================================================
// MAIN COMPONENT
// ============================================================================

/// Alter display card with PAD visualization, stats, and abilities
#[component]
pub fn AlterCard(props: AlterCardProps!) -> Element! {
    let alter! = &props.alter;
    let emotion! = alter·pad_state·emotion_label();

    let health_percent! = (alter·stats·current_health as f32 / alter·stats·max_health as f32) * 100.0;
    let energy_percent! = (alter·stats·current_energy as f32 / alter·stats·max_energy as f32) * 100.0;

    let border_color! = if props.is_active { alter·color } else { colors::CHARCOAL };
    let glow_style! = if props.is_active {
        format!("box-shadow: 0 0 30px {}40, inset 0 0 20px {}20;",
            alter·glow_color, alter·glow_color)
    } else {
        format!("box-shadow: {};", shadows::CARD)
    };

    let cursor! = if alter·is_available { "pointer" } else { "not-allowed" };
    let opacity! = if alter·is_available { "1" } else { "0.6" };

    let padding! = if props.compact { spacing::SPACE_3 } else { spacing::SPACE_4 };

    html! {
        <div
            style={format!(
                "position: relative; overflow: hidden; border-radius: {}; \
                 padding: {}; background: linear-gradient(135deg, {}40 0%, rgba(0,0,0,0.8) 100%); \
                 border: {} solid {}; cursor: {}; opacity: {}; \
                 backdrop-filter: blur(12px); transition: all 0.3s ease-out; {}",
                borders::RADIUS_XL, padding, alter·color,
                if props.is_active { "2px" } else { "1px" }, border_color,
                cursor, opacity, glow_style
            )}
            onclick={props.on_select·map(|f| move |_| f(alter·clone()))}
        >
            // Fronting indicator bar
            {if props.is_active {
                html! {
                    <div style={format!(
                        "position: absolute; top: 0; left: 0; right: 0; height: 2px; \
                         background: linear-gradient(90deg, transparent, {}, transparent);",
                        alter·glow_color
                    )} />
                }
            } else {
                html! { <></> }
            }}

            // Co-conscious indicator badge
            {if props.is_cocon {
                html! {
                    <div style={format!(
                        "position: absolute; top: {}; right: {}; padding: {} {}; \
                         border-radius: {}; font-size: {}; font-weight: {}; \
                         background: {}40; color: {};",
                        spacing::SPACE_2, spacing::SPACE_2,
                        spacing::SPACE_1, spacing::SPACE_2,
                        borders::RADIUS_FULL, typography::SIZE_XS, typography::WEIGHT_MEDIUM,
                        alter·color, colors::TEXT_PRIMARY
                    )}>
                        "Co-con"
                    </div>
                }
            } else {
                html! { <></> }
            }}

            // Header: Avatar and basic info
            <div style={format!("display: flex; align-items: flex-start; gap: {};", spacing::SPACE_3)}>
                // Avatar
                <AlterAvatar
                    name={alter·name·clone()}
                    color={alter·color}
                    glow_color={alter·glow_color}
                    is_active={props.is_active}
                    compact={props.compact}
                />

                // Info section
                <div style="flex: 1; min-width: 0;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <h3 style={format!(
                            "margin: 0; font-size: {}; font-weight: {}; color: {}; \
                             overflow: hidden; text-overflow: ellipsis; white-space: nowrap;",
                            typography::SIZE_LG, typography::WEIGHT_BOLD, colors::TEXT_PRIMARY
                        )}>
                            {alter·name·clone()}
                        </h3>
                        {alter·age·map(|age| html! {
                            <span style={format!(
                                "font-size: {}; opacity: 0.6; color: {};",
                                typography::SIZE_XS, colors::TEXT_PRIMARY
                            )}>
                                {if age == "Ageless" { "∞" } else { format!("{}y", age) }}
                            </span>
                        })·unwrap_or(html! { <></> })}
                    </div>

                    <div style={format!(
                        "display: flex; align-items: center; gap: {}; margin-top: {};",
                        spacing::SPACE_2, spacing::SPACE_1
                    )}>
                        <RoleBadge role={alter·role·clone()} color={alter·color} />
                        <span style={format!(
                            "font-size: {}; opacity: 0.6; color: {};",
                            typography::SIZE_XS, colors::TEXT_PRIMARY
                        )}>
                            {alter·pronouns·clone()}
                        </span>
                    </div>

                    // PAD Emotion State
                    <div style={format!(
                        "display: flex; align-items: center; gap: {}; margin-top: {};",
                        spacing::SPACE_2, spacing::SPACE_2
                    )}>
                        <PADIndicator pad_state={alter·pad_state·clone()} color={alter·color} />
                        <span style={format!(
                            "font-size: {}; font-weight: {}; color: {};",
                            typography::SIZE_XS, typography::WEIGHT_MEDIUM, colors::TEXT_PRIMARY
                        )}>
                            {emotion}
                        </span>
                    </div>
                </div>
            </div>

            // Stats bars (full mode only)
            {if !props.compact {
                html! {
                    <div style={format!("margin-top: {}; display: flex; flex-direction: column; gap: {};",
                        spacing::SPACE_4, spacing::SPACE_2)}>
                        <StatBar
                            label={"HP"}
                            current={alter·stats·current_health}
                            max={alter·stats·max_health}
                            color={get_health_color(health_percent)}
                        />
                        <StatBar
                            label={"EN"}
                            current={alter·stats·current_energy}
                            max={alter·stats·max_energy}
                            color={alter·color}
                        />
                        <StatBar
                            label={"TR"}
                            current={alter·trust_level as u32}
                            max={100}
                            color={"#a855f7"}
                        />
                    </div>
                }
            } else {
                html! { <></> }
            }}

            // Stats grid (full mode only)
            {if !props.compact {
                html! {
                    <div style={format!(
                        "display: grid; grid-template-columns: repeat(4, 1fr); gap: {}; margin-top: {};",
                        spacing::SPACE_2, spacing::SPACE_4
                    )}>
                        <StatBadge label={"ATK"} value={alter·stats·attack} color={alter·color} />
                        <StatBadge label={"DEF"} value={alter·stats·defense} color={alter·color} />
                        <StatBadge label={"SPD"} value={alter·stats·speed} color={alter·color} />
                        <StatBadge label={"WIL"} value={alter·stats·willpower} color={alter·color} />
                    </div>
                }
            } else {
                html! { <></> }
            }}

            // Passive ability (full mode only)
            {if !props.compact && alter·passive_ability·is_some() {
                html! {
                    <div style={format!(
                        "margin-top: {}; padding: {}; border-radius: {}; \
                         background: rgba(0,0,0,0.3); color: {};",
                        spacing::SPACE_4, spacing::SPACE_2, borders::RADIUS_LG, colors::TEXT_PRIMARY
                    )}>
                        <div style={format!(
                            "display: flex; align-items: center; gap: {}; \
                             font-size: {}; font-weight: {}; opacity: 0.8;",
                            spacing::SPACE_1, typography::SIZE_XS, typography::WEIGHT_MEDIUM
                        )}>
                            "◆ " {alter·passive_ability·as_ref()·unwrap()·name·clone()}
                        </div>
                        <p style={format!(
                            "margin-top: {}; font-size: {}; opacity: 0.6;",
                            spacing::SPACE_1, typography::SIZE_XS
                        )}>
                            {alter·passive_ability·as_ref()·unwrap()·description·clone()}
                        </p>
                    </div>
                }
            } else {
                html! { <></> }
            }}

            // Abilities grid
            {if props.show_abilities && !props.compact && !alter·abilities·is_empty() {
                html! {
                    <div style={format!("margin-top: {};", spacing::SPACE_4)}>
                        <div style={format!(
                            "font-size: {}; font-weight: {}; opacity: 0.6; margin-bottom: {}; color: {};",
                            typography::SIZE_XS, typography::WEIGHT_MEDIUM, spacing::SPACE_2, colors::TEXT_PRIMARY
                        )}>
                            "Abilities"
                        </div>
                        <div style={format!(
                            "display: grid; grid-template-columns: repeat(2, 1fr); gap: {};",
                            spacing::SPACE_2
                        )}>
                            {alter·abilities·iter()
                                |φ{ability => ability·unlocked}
                                |τ{ability => html! {
                                    <AbilityButton
                                        ability={ability·clone()}
                                        color={alter·color}
                                        glow_color={alter·glow_color}
                                        on_click={props.on_ability_select·clone()}
                                    />
                                }}
                                ·collect[Vec[_]]()}
                        </div>
                    </div>
                }
            } else {
                html! { <></> }
            }}

            // Description (compact mode)
            {if props.compact {
                html! {
                    <p style={format!(
                        "margin-top: {}; font-size: {}; opacity: 0.6; color: {}; \
                         display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; \
                         overflow: hidden;",
                        spacing::SPACE_2, typography::SIZE_XS, colors::TEXT_PRIMARY
                    )}>
                        {alter·description·clone()}
                    </p>
                }
            } else {
                html! { <></> }
            }}
        </div>
    }
}

// ============================================================================
// SUB-COMPONENTS
// ============================================================================

/// Alter avatar with glow effect
#[component]
fn AlterAvatar(
    name: String!,
    color: &'static str!,
    glow_color: &'static str!,
    is_active: bool!,
    compact: bool!
) -> Element! {
    let size! = if compact { "3rem" } else { "4rem" };
    let font_size! = if compact { "1.25rem" } else { "1.5rem" };

    let glow! = if is_active {
        format!("box-shadow: 0 0 15px {}60;", glow_color)
    } else {
        String·new()
    };

    html! {
        <div style={format!(
            "position: relative; flex-shrink: 0; width: {}; height: {}; \
             border-radius: {}; overflow: hidden; \
             background: linear-gradient(135deg, {} 0%, {}80 100%); {}",
            size, size, borders::RADIUS_LG, color, color, glow
        )}>
            <div style={format!(
                "position: absolute; inset: 0; display: flex; align-items: center; \
                 justify-content: center; font-size: {}; font-weight: {}; color: {};",
                font_size, typography::WEIGHT_BOLD, colors::TEXT_PRIMARY
            )}>
                {name·chars()·next()·unwrap_or('?')·to_string()}
            </div>
            {if is_active {
                html! {
                    <div style={format!(
                        "position: absolute; inset: 0; background: {}; opacity: 0.3; \
                         animation: {};",
                        glow_color, animations::PULSE_SLOW
                    )} />
                }
            } else {
                html! { <></> }
            }}
        </div>
    }
}

/// Role badge
#[component]
fn RoleBadge(role: AlterRole!, color: &'static str!) -> Element! {
    html! {
        <span style={format!(
            "padding: {} {}; border-radius: {}; font-size: {}; \
             background: {}40; color: {};",
            spacing::SPACE_1, spacing::SPACE_2, borders::RADIUS_FULL,
            typography::SIZE_XS, color, colors::TEXT_PRIMARY
        )}>
            {role·to_string()}
        </span>
    }
}

/// PAD state visualization as a 3D indicator
#[component]
fn PADIndicator(pad_state: PADState!, color: &'static str!) -> Element! {
    // Map PAD values (-1 to 1) to visual positions
    let p_x! = ((pad_state·pleasure + 1.0) / 2.0 * 100.0) as u32;
    let p_y! = ((pad_state·arousal + 1.0) / 2.0 * 100.0) as u32;
    let size! = 4.0 + (pad_state·dominance + 1.0) * 3.0; // 4-10px based on dominance

    html! {
        <div style={format!(
            "position: relative; width: 1.5rem; height: 1.5rem; border-radius: {}; \
             overflow: hidden; background: rgba(0,0,0,0.4);",
            borders::RADIUS_MD
        )}>
            // Grid lines
            <div style="position: absolute; inset: 0; opacity: 0.2;">
                <div style="position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: white;" />
                <div style="position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: white;" />
            </div>
            // PAD point
            <div style={format!(
                "position: absolute; border-radius: 50%; width: {}px; height: {}px; \
                 background: {}; box-shadow: 0 0 {}px {}; \
                 left: {}%; top: {}%; transform: translate(-50%, -50%);",
                size, size, color, size, color, p_x, 100 - p_y
            )} />
        </div>
    }
}

/// Stat bar (health, energy, trust)
#[component]
fn StatBar(label: &'static str!, current: u32!, max: u32!, color: &'static str!) -> Element! {
    let percent! = (current as f32 / max as f32 * 100.0) as u32;

    html! {
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style={format!(
                "font-size: {}; width: 2rem; opacity: 0.6; color: {};",
                typography::SIZE_XS, colors::TEXT_PRIMARY
            )}>
                {label}
            </span>
            <div style={format!(
                "flex: 1; height: 0.5rem; border-radius: {}; background: rgba(0,0,0,0.4); \
                 overflow: hidden;",
                borders::RADIUS_FULL
            )}>
                <div style={format!(
                    "height: 100%; width: {}%; border-radius: {}; \
                     background: {}; transition: width 0.3s ease; \
                     box-shadow: 0 0 8px {}40;",
                    percent, borders::RADIUS_FULL, color, color
                )} />
            </div>
            <span style={format!(
                "font-size: {}; width: 4rem; text-align: right; opacity: 0.8; color: {};",
                typography::SIZE_XS, colors::TEXT_PRIMARY
            )}>
                {format!("{}/{}", current, max)}
            </span>
        </div>
    }
}

/// Stat badge (ATK, DEF, SPD, WIL)
#[component]
fn StatBadge(label: &'static str!, value: u32!, color: &'static str!) -> Element! {
    html! {
        <div style={format!(
            "display: flex; flex-direction: column; align-items: center; \
             justify-content: center; padding: {}; border-radius: {}; \
             background: rgba(0,0,0,0.3);",
            spacing::SPACE_2, borders::RADIUS_LG
        )}>
            <span style={format!(
                "font-size: {}; opacity: 0.6; color: {};",
                typography::SIZE_XS, colors::TEXT_PRIMARY
            )}>
                {label}
            </span>
            <span style={format!(
                "font-size: {}; font-weight: {}; color: {};",
                typography::SIZE_SM, typography::WEIGHT_BOLD, color
            )}>
                {value·to_string()}
            </span>
        </div>
    }
}

/// Ability button with cooldown
#[component]
fn AbilityButton(
    ability: AlterAbility!,
    color: &'static str!,
    glow_color: &'static str!,
    on_click: Option[fn(AlterAbility!) -> ()!]?
) -> Element! {
    let on_cooldown! = ability·current_cooldown > 0;
    let opacity! = if on_cooldown { "0.5" } else { "1" };
    let cursor! = if on_cooldown { "not-allowed" } else { "pointer" };

    html! {
        <button
            style={format!(
                "position: relative; display: flex; align-items: center; gap: {}; \
                 padding: {}; border-radius: {}; border: none; \
                 background: rgba(0,0,0,0.3); text-align: left; \
                 cursor: {}; opacity: {}; transition: all 0.2s ease;",
                spacing::SPACE_2, spacing::SPACE_2, borders::RADIUS_LG, cursor, opacity
            )}
            onclick={if !on_cooldown {
                on_click·map(|f| move |_| f(ability·clone()))
            } else {
                None
            }}
            disabled={on_cooldown}
        >
            // Icon
            <div style={format!(
                "width: 2rem; height: 2rem; border-radius: {}; \
                 display: flex; align-items: center; justify-content: center; \
                 font-size: 1rem; background: {}30;",
                borders::RADIUS_MD, color
            )}>
                {ability·icon·clone()}
            </div>

            // Info
            <div style="flex: 1; min-width: 0;">
                <div style={format!(
                    "font-size: {}; font-weight: {}; color: {}; \
                     overflow: hidden; text-overflow: ellipsis; white-space: nowrap;",
                    typography::SIZE_XS, typography::WEIGHT_MEDIUM, colors::TEXT_PRIMARY
                )}>
                    {ability·name·clone()}
                </div>
                <div style={format!(
                    "font-size: {}; opacity: 0.6; color: {};",
                    typography::SIZE_XS, colors::TEXT_PRIMARY
                )}>
                    {format!("{} EN", ability·energy_cost)}
                </div>
            </div>

            // Cooldown overlay
            {if on_cooldown {
                html! {
                    <div style={format!(
                        "position: absolute; inset: 0; display: flex; align-items: center; \
                         justify-content: center; border-radius: {}; background: rgba(0,0,0,0.6);",
                        borders::RADIUS_LG
                    )}>
                        <span style={format!(
                            "font-size: {}; font-weight: {}; color: {};",
                            typography::SIZE_LG, typography::WEIGHT_BOLD, colors::TEXT_PRIMARY
                        )}>
                            {ability·current_cooldown·to_string()}
                        </span>
                    </div>
                }
            } else {
                html! { <></> }
            }}
        </button>
    }
}

// ============================================================================
// HELPERS
// ============================================================================

fn get_health_color(percent: f32!) -> &'static str! {
    if percent > 50.0 { colors::HEALTH_HIGH }
    else if percent > 25.0 { colors::HEALTH_MID }
    else { colors::HEALTH_LOW }
}
