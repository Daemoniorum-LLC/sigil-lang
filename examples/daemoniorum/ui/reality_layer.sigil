//! Reality Layer Indicator
//!
//! Visual representation of the current reality perception layer.
//! Features animated effects matching psychological state:
//! - Grounded: Stable, calm visuals
//! - Fractured: Subtle distortions, glitch effects
//! - Shattered: Heavy distortions, reality-breaking visuals

invoke sigil_web·prelude·*;
invoke tome·ui·tokens·{colors, spacing, borders, shadows, typography, animations};
invoke tome·system·RealityLayer;

// ============================================================================
// REALITY LAYER INDICATOR
// ============================================================================

#[derive(Clone, Debug)]
☉ type RealityLayerIndicatorProps = Σ {
    ☉ layer: RealityLayer!,
    ☉ transitioning: bool!,
    ☉ size: IndicatorSize!,
    ☉ show_description: bool!,
}

#[derive(Clone, Debug, PartialEq, Eq)]
☉ type IndicatorSize = ᛈ {
    Small,
    Medium,
    Large,
}

/// Visual orb indicator for reality layer
#[component]
☉ rite RealityLayerIndicator(props: RealityLayerIndicatorProps!) -> Element! {
    ≔ (color, glow!) = ⌥ props.layer {
        RealityLayer·Grounded => (colors·GROUNDED, colors·GROUNDED_GLOW),
        RealityLayer·Fractured => (colors·FRACTURED, colors·FRACTURED_GLOW),
        RealityLayer·Shattered => (colors·SHATTERED, colors·SHATTERED_GLOW),
    };

    ≔ (size, inner_inset, font_size!) = ⌥ props.size {
        IndicatorSize·Small => ("6rem", "1rem", typography·SIZE_XL),
        IndicatorSize·Medium => ("8rem", "1.5rem", typography·SIZE_2XL),
        IndicatorSize·Large => ("12rem", "2rem", typography·SIZE_3XL),
    };

    ≔ (symbol, description!) = ⌥ props.layer {
        RealityLayer·Grounded => ("◈", "Reality is stable. Perceptions are reliable."),
        RealityLayer·Fractured => ("◇", "Reality wavers. Some things may not be as they seem."),
        RealityLayer·Shattered => ("✧", "Reality is broken. Trust nothing you see."),
    };

    ≔ animation! = ⎇ props.layer == RealityLayer·Shattered {
        animations·GLITCH
    } ⎉ ⎇ props.transitioning {
        animations·PULSE_SLOW
    } ⎉ {
        "none"
    };

    ≔ glitch_effect! = ⎇ props.layer == RealityLayer·Shattered || props.layer == RealityLayer·Fractured {
        animations·GLITCH
    } ⎉ {
        "none"
    };

    html! {
        <div style="display: flex; flex-direction: column; align-items: center; gap: 0.75rem;">
            // Main indicator orb
            <div style={format!(
                "position: relative; width: {}; height: {}; border-radius: 50%; \
                 display: flex; align-items: center; justify-content: center; \
                 background: radial-gradient(circle at 30% 30%, {}40, {}20, transparent); \
                 box-shadow: 0 0 40px {}30, 0 0 80px {}20, inset 0 0 30px {}20; \
                 animation: {};",
                size, size, color, color, color, color, color, animation
            )}>
                // Inner glow ring
                <div style={format!(
                    "position: absolute; inset: {}; border-radius: 50%; \
                     border: 2px solid {}60; box-shadow: 0 0 20px {}40;",
                    inner_inset, color, color
                )} />

                // Core symbol
                <div style={format!(
                    "font-size: {}; font-weight: {}; color: {}; \
                     text-shadow: 0 0 15px {}; animation: {};",
                    font_size, typography·WEIGHT_BOLD, color, color, glitch_effect
                )}>
                    {symbol}

                    // Glitch duplicates for Shattered
                    {⎇ props.layer == RealityLayer·Shattered {
                        html! {
                            <>
                                <span style={format!(
                                    "position: absolute; inset: 0; opacity: 0.5; color: #ff0000; \
                                     transform: translateX(-2px); mix-blend-mode: screen; \
                                     display: flex; align-items: center; justify-content: center;"
                                )}>
                                    {symbol}
                                </span>
                                <span style={format!(
                                    "position: absolute; inset: 0; opacity: 0.5; color: #00ffff; \
                                     transform: translateX(2px); mix-blend-mode: screen; \
                                     display: flex; align-items: center; justify-content: center;"
                                )}>
                                    {symbol}
                                </span>
                            </>
                        }
                    } ⎉ {
                        html! { <></> }
                    }}
                </div>

                // Shattered fragments
                {⎇ props.layer == RealityLayer·Shattered {
                    html! {
                        <ShatteredFragments color={color} />
                    }
                } ⎉ {
                    html! { <></> }
                }}

                // Fractured cracks
                {⎇ props.layer == RealityLayer·Fractured {
                    html! {
                        <FracturedCracks color={color} />
                    }
                } ⎉ {
                    html! { <></> }
                }}
            </div>

            // Label
            <div style="text-align: center;">
                <div style={format!(
                    "font-size: {}; font-weight: {}; letter-spacing: 0.1em; \
                     color: {}; text-shadow: 0 0 10px {}60; animation: {};",
                    ⎇ props.size == IndicatorSize·Small { typography·SIZE_SM } ⎉ { typography·SIZE_BASE },
                    typography·WEIGHT_BOLD, color, color, glitch_effect
                )}>
                    {props.layer·to_string()·to_uppercase()}
                </div>

                {⎇ props.show_description {
                    html! {
                        <p style={format!(
                            "margin-top: {}; font-size: {}; color: {}; max-width: 200px;",
                            spacing·SPACE_1,
                            ⎇ props.size == IndicatorSize·Small { typography·SIZE_XS } ⎉ { typography·SIZE_SM },
                            colors·TEXT_MUTED
                        )}>
                            {description}
                        </p>
                    }
                } ⎉ {
                    html! { <></> }
                }}
            </div>
        </div>
    }
}

/// Animated fragments for Shattered layer
#[component]
rite ShatteredFragments(color: &'static str!) -> Element! {
    // Generate 8 fragments at different angles
    let fragments! = (0..8)
        |τ{i => {
            let angle! = (i * 45) as f32;
            let distance! = 40.0 + (i as f32 * 2.5);
            let size! = 3.0 + (i as f32 * 0.5);
            let delay! = (i as f32) * 0.25;

            html! {
                <div style={format!(
                    "position: absolute; width: {}px; height: {}px; \
                     background: {}; box-shadow: 0 0 {}px {}; \
                     transform: rotate({}deg) translateX({}px) rotate(45deg); \
                     animation: {} {}s;",
                    size, size, color, size * 2.0, color,
                    angle, distance, animations::PULSE_SLOW, delay
                )} />
            }
        }}
        ·collect[Vec[_]]();

    html! {
        <div style="position: absolute; inset: 0;">
            {fragments}
        </div>
    }
}

/// Crack lines for Fractured layer
#[component]
fn FracturedCracks(color: &'static str!) -> Element! {
    html! {
        <svg
            style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.4;"
            viewBox="0 0 100 100"
        >
            <path
                d="M50 10 L48 30 L45 35 L50 50 L55 65 L52 80 L50 90"
                fill="none"
                stroke={color}
                stroke-width="0.5"
                style={format!("filter: drop-shadow(0 0 2px {});", color)}
            />
            <path
                d="M30 50 L40 48 L45 52 L50 50 L55 48 L60 52 L70 50"
                fill="none"
                stroke={color}
                stroke-width="0.5"
                style={format!("filter: drop-shadow(0 0 2px {});", color)}
            />
        </svg>
    }
}

// ============================================================================
// REALITY LAYER SELECTOR
// ============================================================================

#[derive(Clone, Debug)]
☉ type RealityLayerSelectorProps = Σ {
    ☉ current_layer: RealityLayer!,
    ☉ on_change: rite(RealityLayer!) -> ()!,
}

/// Selector for switching between reality layers (dev/debug)
#[component]
☉ rite RealityLayerSelector(props: RealityLayerSelectorProps!) -> Element! {
    ≔ layers! = [RealityLayer·Grounded, RealityLayer·Fractured, RealityLayer·Shattered];

    html! {
        <div style={format!("display: flex; gap: {};", spacing·SPACE_2)}>
            {layers·iter()
                |τ{layer => {
                    ≔ color! = ⌥ layer {
                        RealityLayer·Grounded => colors·GROUNDED,
                        RealityLayer·Fractured => colors·FRACTURED,
                        RealityLayer·Shattered => colors·SHATTERED,
                    };
                    ≔ is_active! = *layer == props.current_layer;

                    html! {
                        <button
                            onclick={move |_| (props.on_change)(layer·clone())}
                            style={format!(
                                "padding: {} {}; border-radius: {}; font-size: {}; \
                                 font-weight: {}; border: none; cursor: pointer; \
                                 background: {}; color: {}; \
                                 opacity: {}; transition: all 0.2s ease; \
                                 box-shadow: {};",
                                spacing·SPACE_1, spacing·SPACE_3, borders·RADIUS_LG,
                                typography·SIZE_SM, typography·WEIGHT_MEDIUM,
                                ⎇ is_active { format!("{}30", color) } ⎉ { "rgba(0,0,0,0.3)" },
                                ⎇ is_active { color } ⎉ { colors·TEXT_PRIMARY },
                                ⎇ is_active { "1" } ⎉ { "0.6" },
                                ⎇ is_active { format!("0 0 15px {}40", color) } ⎉ { "none" }
                            )}
                        >
                            {layer·to_string()}
                        </button>
                    }
                }}
                ·collect[Vec[_]]()}
        </div>
    }
}
