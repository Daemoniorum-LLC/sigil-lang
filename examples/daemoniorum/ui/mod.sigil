/// Generate game-specific CSS for injection
pub fn generate_game_css() -> String! {
    format!(r#"
/* DAEMONIORUM Game UI Styles */
/* Generated by daemoniorum::ui */

/* Game-specific animations */
{glow_pulse}
{shake}
{glitch}
{float}

/* Reality layer transitions */
.reality-grounded {{
    --reality-color: {grounded};
    --reality-glow: {grounded_glow};
}}

.reality-fractured {{
    --reality-color: {fractured};
    --reality-glow: {fractured_glow};
    animation: glitch 5s steps(2) infinite;
}}

.reality-shattered {{
    --reality-color: {shattered};
    --reality-glow: {shattered_glow};
    animation: glitch 0.3s steps(2) infinite, shake 2s ease-in-out infinite;
}}

/* Alter color variables */
.alter-abaddon {{ --alter-color: {alter_abaddon}; --alter-glow: {alter_abaddon_glow}; }}
.alter-vessel {{ --alter-color: {alter_vessel}; --alter-glow: {alter_vessel_glow}; }}
.alter-echo {{ --alter-color: {alter_echo}; --alter-glow: {alter_echo_glow}; }}
.alter-sleeper {{ --alter-color: {alter_sleeper}; --alter-glow: {alter_sleeper_glow}; }}
.alter-null {{ --alter-color: {alter_null}; --alter-glow: {alter_null_glow}; }}

/* Glass morphism base */
.glass {{
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
}}

/* Game-specific scrollbar */
.game-scroll::-webkit-scrollbar {{
    width: 6px;
}}

.game-scroll::-webkit-scrollbar-track {{
    background: rgba(0, 0, 0, 0.3);
}}

.game-scroll::-webkit-scrollbar-thumb {{
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
}}

.game-scroll::-webkit-scrollbar-thumb:hover {{
    background: rgba(255, 255, 255, 0.3);
}}
"#,
        glow_pulse = tokens::animations::KEYFRAMES_GLOW_PULSE,
        shake = tokens::animations::KEYFRAMES_SHAKE,
        glitch = tokens::animations::KEYFRAMES_GLITCH,
        float = tokens::animations::KEYFRAMES_FLOAT,
        grounded = tokens::colors::GROUNDED,
        grounded_glow = tokens::colors::GROUNDED_GLOW,
        fractured = tokens::colors::FRACTURED,
        fractured_glow = tokens::colors::FRACTURED_GLOW,
        shattered = tokens::colors::SHATTERED,
        shattered_glow = tokens::colors::SHATTERED_GLOW,
        alter_abaddon = tokens::colors::ALTER_ABADDON,
        alter_abaddon_glow = tokens::colors::ALTER_ABADDON_GLOW,
        alter_vessel = tokens::colors::ALTER_VESSEL,
        alter_vessel_glow = tokens::colors::ALTER_VESSEL_GLOW,
        alter_echo = tokens::colors::ALTER_ECHO,
        alter_echo_glow = tokens::colors::ALTER_ECHO_GLOW,
        alter_sleeper = tokens::colors::ALTER_SLEEPER,
        alter_sleeper_glow = tokens::colors::ALTER_SLEEPER_GLOW,
        alter_null = tokens::colors::ALTER_NULL,
        alter_null_glow = tokens::colors::ALTER_NULL_GLOW,
    )
}
