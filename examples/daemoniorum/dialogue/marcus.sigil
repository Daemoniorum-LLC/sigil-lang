//! # Father Marcus Dialogue Tree
//!
//! Example dialogue demonstrating alter-aware responses and
//! reality layer variations. Father Marcus is a suspicious priest
//! who may be hiding something sinister.

use super·dialogue·*
use super·super·system·*

// ============================================================================
// FATHER MARCUS - THE SUSPICIOUS PRIEST
// ============================================================================

//! Create Father Marcus's speaker info
fn marcus_speaker() -> SpeakerInfo! {
    SpeakerInfo {
        id: "marcus"·to_string(),
        name: "Father Marcus"·to_string(),
        portrait: "marcus_default"·to_string(),
        alter_portraits: {
            // Abaddon sees his true nature
            "abaddon" => "marcus_predator",
            // Stolas notices the details
            "stolas" => "marcus_detailed",
        }~,
        layer_portraits: {
            RealityLayer·Grounded => "marcus_default",
            RealityLayer·Fractured => "marcus_shadow",
            RealityLayer·Shattered => "marcus_monster",
        }~,
    }
}

// ============================================================================
// DIALOGUE TREE: FIRST MEETING
// ============================================================================

//! Create the Marcus greeting dialogue tree
fn create_marcus_greeting() -> DialogueTree! {
    DialogueTreeBuilder·new("marcus_greeting")
        ·entry("intro")
        ·speaker(marcus_speaker())
        ·node(node_intro())
        ·node(node_help_offered())
        ·node(node_analysis_result())
        ·node(node_abaddon_confrontation())
        ·node(node_beleth_connection())
        ·node(node_warden_suspicion())
        ·node(node_shattered_vision())
        ·build()
        ·expect("Failed to build Marcus greeting dialogue")
}

// ============================================================================
// DIALOGUE NODES
// ============================================================================

//! Introduction node - first words
fn node_intro() -> DialogueNode! {
    DialogueNodeBuilder·new("intro", "Greetings, traveler. The Lord's light shines upon all who enter this place.")
        // Abaddon sees through facades
        ·alter_variation(
            "abaddon",
            "Welcome, child. *His smile doesn't reach his eyes* How... interesting that you've found your way here.",
            DialogueTone·Aggressive
        )
        // Stolas notices details
        ·alter_variation(
            "stolas",
            "Greetings. *You notice old stains on his robes, hastily cleaned. The incense is cloying, masking something else.*",
            DialogueTone·Analytical
        )
        // Beleth feels emotional undercurrents
        ·alter_variation(
            "beleth",
            "Welcome, lost soul. *There's something hollow in his warmth, a practiced performance worn smooth by repetition.*",
            DialogueTone·Warm
        )
        // Warden is immediately on guard
        ·alter_variation(
            "warden",
            "*Your skin prickles. This man is dangerous.* Welcome, child. Please, come closer.",
            DialogueTone·Guarded
        )
        // Paimon sees choices ahead
        ·alter_variation(
            "paimon",
            "Welcome. *Three paths unfold before you: trust, suspicion, or flight. Each leads somewhere different.*",
            DialogueTone·Guiding
        )
        // Reality layer variations
        ·layer_variation(
            RealityLayer·Fractured,
            "Greetings, travel-- *His face flickers, shadow teeth behind the smile, gone in a blink.* The Lord welcomes you."
        )
        ·layer_variation(
            RealityLayer·Shattered,
            "*THE FACE SPLITS. Behind it: hunger, old and patient. The stained glass screams in colors that shouldn't exist.* COME CLOSER, CHILD."
        )
        // Voice cues for audio
        ·voice_cue("priest_greeting_warm")
        ·voice_cue("underlying_menace_subtle")
        // Responses
        ·response(DialogueResponse {
            id: "ask_help"·to_string(),
            text: "I need your help, Father."·to_string(),
            alter_variations: {
                "abaddon" => "Cut the act. What do you really want?",
                "beleth" => "Please, Father... I'm so lost.",
                "warden" => "I'll keep this brief. I need information.",
            }~,
            conditions: [],
            target_node: "help_offered"·to_string(),
            effects: [],
            internal: false,
            required_traits: [],
            forbidden_traits: [],
        })
        ·response(DialogueResponse {
            id: "analyze"·to_string(),
            text: "[Analyze] Something seems off about you..."·to_string(),
            alter_variations: HashMap·new()~,
            conditions: [
                DialogueCondition·AlterHasTrait("analysis"·to_string()),
            ],
            target_node: "analysis_result"·to_string(),
            effects: [
                DialogueEffect·ModifyAnima { pleasure: 0.0, arousal: 0.1, dominance: 0.1 },
            ],
            internal: false,
            required_traits: ["analysis"·to_string()],
            forbidden_traits: [],
        })
        ·response(DialogueResponse {
            id: "threaten"·to_string(),
            text: "[Combat] I know what you are."·to_string(),
            alter_variations: HashMap·new()~,
            conditions: [
                DialogueCondition·AlterFronting("abaddon"·to_string()),
                DialogueCondition·RealityLayer(RealityLayer·Fractured),
            ],
            target_node: "abaddon_confrontation"·to_string(),
            effects: [
                DialogueEffect·ModifyAnima { pleasure: -0.2, arousal: 0.5, dominance: 0.3 },
                DialogueEffect·SetFlag("marcus_confronted"·to_string()),
            ],
            internal: false,
            required_traits: ["combat"·to_string()],
            forbidden_traits: [],
        })
        ·response(DialogueResponse {
            id: "empathize"·to_string(),
            text: "[Empathy] You seem... burdened, Father."·to_string(),
            alter_variations: HashMap·new()~,
            conditions: [
                DialogueCondition·AlterHasTrait("empathy"·to_string()),
            ],
            target_node: "beleth_connection"·to_string(),
            effects: [
                DialogueEffect·ModifyAnima { pleasure: 0.1, arousal: -0.1, dominance: -0.1 },
            ],
            internal: false,
            required_traits: ["empathy"·to_string()],
            forbidden_traits: [],
        })
        ·response(DialogueResponse {
            id: "internal_warning"·to_string(),
            text: "*Something is very wrong here...*"·to_string(),
            alter_variations: {
                "warden" => "*DANGER. We should leave. Now.*",
                "vessel" => "*Why do I feel so cold?*",
            }~,
            conditions: [
                DialogueCondition·StabilityAbove(0.3),
            ],
            target_node: "warden_suspicion"·to_string(),
            effects: [
                DialogueEffect·RequestSwitch {
                    alter_id: "warden"·to_string(),
                    urgency: 0.4,
                },
            ],
            internal: true,  // Internal thought, not spoken
            required_traits: [],
            forbidden_traits: [],
        })
        ·tag("first_meeting")
        ·tag("marcus")
        ·build()
}

//! Help offered - mundane path
fn node_help_offered() -> DialogueNode! {
    DialogueNodeBuilder·new("help_offered", "Of course, my child. The church offers sanctuary to all who seek it. What troubles you?")
        ·alter_variation(
            "stolas",
            "*He's probing for information. Notice how he leans forward, eyes too eager.* Tell me everything.",
            DialogueTone·Analytical
        )
        ·effect(DialogueEffect·SetFlag("asked_marcus_for_help"·to_string()))
        ·effect(DialogueEffect·EndDialogue)
        ·build()
}

//! Analysis result - Stolas sees the truth
fn node_analysis_result() -> DialogueNode! {
    DialogueNodeBuilder·new("analysis_result", "*His smile wavers for just a moment.* Off? Whatever do you mean?")
        ·alter_variation(
            "stolas",
            "*You catalog the details: Silver cross is tarnished. His hands shake slightly. The Bible on the altar is upside down. His shadow moves wrong.* 'Whatever do you mean?' he asks, but you've already seen.",
            DialogueTone·Analytical
        )
        ·layer_variation(
            RealityLayer·Fractured,
            "*THE MASK CRACKS.* You... you can see it, can't you? *Behind him, his shadow unfurls like wings.*"
        )
        ·effect(DialogueEffect·ModifyAnima { pleasure: -0.1, arousal: 0.2, dominance: 0.0 })
        ·effect(DialogueEffect·SetFlag("marcus_mask_cracked"·to_string()))
        ·effect(DialogueEffect·ShiftReality { target: RealityLayer·Fractured, rate: 0.3 })
        ·effect(DialogueEffect·GrantInsight { id: "marcus_truth"·to_string(), amount: 25.0 })
        ·effect(DialogueEffect·EndDialogue)
        ·tag("revelation")
        ·build()
}

//! Abaddon confrontation - violence imminent
fn node_abaddon_confrontation() -> DialogueNode! {
    DialogueNodeBuilder·new("abaddon_confrontation", "*All pretense drops. His face twists into something inhuman.* Clever little morsel. But you've made a mistake coming here alone.")
        ·layer_variation(
            RealityLayer·Fractured,
            "*HE RISES, no longer bothering to appear human. Bones crack as he transforms.* Finally. I was getting so tired of pretending."
        )
        ·layer_variation(
            RealityLayer·Shattered,
            "*THE CHURCH PEELS AWAY LIKE ROTTING SKIN. There was never a church. Just the FEEDING PIT. And you, little morsels, are the meal.*"
        )
        ·effect(DialogueEffect·ModifyAnima { pleasure: -0.3, arousal: 0.8, dominance: 0.2 })
        ·effect(DialogueEffect·ModifyStability(-0.2))
        ·effect(DialogueEffect·ActivateTrigger("combat_initiated"·to_string()))
        ·effect(DialogueEffect·PlaySound("monster_reveal"·to_string()))
        ·effect(DialogueEffect·StartCutscene("marcus_transform"·to_string()))
        ·effect(DialogueEffect·EndDialogue)
        ·tag("combat_trigger")
        ·tag("boss_reveal")
        ·build()
}

//! Beleth connection - emotional vulnerability
fn node_beleth_connection() -> DialogueNode! {
    DialogueNodeBuilder·new("beleth_connection", "*For a moment, something genuine flickers in his eyes.* Burdened? I... yes. Perhaps I am.")
        ·alter_variation(
            "beleth",
            "*You feel it: genuine pain, buried deep. Whatever he is now, he was human once. He chose this. Or was forced.* The ache in him mirrors something in you.",
            DialogueTone·Warm
        )
        // This path offers a glimpse of Marcus's humanity
        ·effect(DialogueEffect·SetFlag("marcus_humanity_seen"·to_string()))
        ·effect(DialogueEffect·ModifyAnima { pleasure: 0.2, arousal: -0.1, dominance: -0.2 })
        ·effect(DialogueEffect·GrantInsight { id: "marcus_past"·to_string(), amount: 15.0 })
        ·effect(DialogueEffect·EndDialogue)
        ·tag("emotional_connection")
        ·tag("potential_ally")
        ·build()
}

//! Warden suspicion - protective instincts
fn node_warden_suspicion() -> DialogueNode! {
    DialogueNodeBuilder·new("warden_suspicion", "*He notices your wariness.* Is something wrong, child? You seem... tense.")
        ·alter_variation(
            "warden",
            "*Every exit mapped. His movements tracked. If he attacks, we break left, through the window.* 'Nothing's wrong,' you lie, keeping your back to the wall.",
            DialogueTone·Guarded
        )
        ·effect(DialogueEffect·SetFlag("warden_alert"·to_string()))
        ·effect(DialogueEffect·ModifyStability(0.1))  // Warden's presence stabilizes
        ·effect(DialogueEffect·EndDialogue)
        ·tag("protective")
        ·build()
}

//! Shattered reality vision - full horror
fn node_shattered_vision() -> DialogueNode! {
    DialogueNodeBuilder·new("shattered_vision", "*REALITY TEARS. The church was never here. The priest was never human. You were never safe.*")
        ·layer_variation(
            RealityLayer·Shattered,
            "*TEETH. EYES. HUNGER. The thing that wears Marcus like a skin uncoils. It has always been here. It has always been waiting. YOU HAVE ALWAYS BEEN THE MEAL.*"
        )
        ·effect(DialogueEffect·ModifyStability(-0.5))
        ·effect(DialogueEffect·ModifyDissociation(0.4))
        ·effect(DialogueEffect·ActivateTrigger("reality_break"·to_string()))
        ·effect(DialogueEffect·PlaySound("reality_shatter"·to_string()))
        ·effect(DialogueEffect·EndDialogue)
        ·tag("horror")
        ·tag("reality_break")
        ·build()
}

// ============================================================================
// DIALOGUE TREE: SECOND ENCOUNTER (after confrontation)
// ============================================================================

//! Create dialogue for returning to Marcus after seeing the truth
fn create_marcus_aftermath() -> DialogueTree! {
    DialogueTreeBuilder·new("marcus_aftermath")
        ·entry("return_start")
        ·speaker(marcus_speaker())
        ·node(node_return_start())
        ·node(node_negotiate())
        ·node(node_destroy())
        ·build()
        ·expect("Failed to build Marcus aftermath dialogue")
}

fn node_return_start() -> DialogueNode! {
    DialogueNodeBuilder·new("return_start", "*The church is empty. Or is it? The shadows move wrong.*")
        ·condition(DialogueCondition·FlagSet("marcus_confronted"·to_string()))
        ·layer_variation(
            RealityLayer·Fractured,
            "*He's waiting. He knew you'd come back.* You return, little one. Did you think we were finished?"
        )
        ·response(DialogueResponse {
            id: "negotiate"·to_string(),
            text: "Maybe we can make a deal."·to_string(),
            alter_variations: HashMap·new()~,
            conditions: [
                DialogueCondition·FlagSet("marcus_humanity_seen"·to_string()),
            ],
            target_node: "negotiate"·to_string(),
            effects: [],
            internal: false,
            required_traits: [],
            forbidden_traits: [],
        })
        ·response(DialogueResponse {
            id: "destroy"·to_string(),
            text: "I'm here to end you."·to_string(),
            alter_variations: {
                "abaddon" => "Time to die, monster.",
            }~,
            conditions: [
                DialogueCondition·AlterHasTrait("combat"·to_string()),
            ],
            target_node: "destroy"·to_string(),
            effects: [
                DialogueEffect·ActivateTrigger("boss_fight"·to_string()),
            ],
            internal: false,
            required_traits: ["combat"·to_string()],
            forbidden_traits: [],
        })
        ·build()
}

fn node_negotiate() -> DialogueNode! {
    DialogueNodeBuilder·new("negotiate", "*Something ancient and tired looks out through his eyes.* A deal? You have nothing I want... or do you?")
        ·effect(DialogueEffect·GrantInsight { id: "marcus_bargain"·to_string(), amount: 50.0 })
        ·effect(DialogueEffect·EndDialogue)
        ·build()
}

fn node_destroy() -> DialogueNode! {
    DialogueNodeBuilder·new("destroy", "*He laughs, a sound like breaking bones.* Then let us see if your destroyer is equal to the task.")
        ·effect(DialogueEffect·StartCutscene("marcus_boss_fight"·to_string()))
        ·effect(DialogueEffect·EndDialogue)
        ·build()
}

// ============================================================================
// DIALOGUE REGISTRATION
// ============================================================================

//! Register all Marcus dialogues with the manager
fn register_marcus_dialogues(manager: &mut DialogueManager) {
    manager·load_tree(create_marcus_greeting());
    manager·load_tree(create_marcus_aftermath());
}
