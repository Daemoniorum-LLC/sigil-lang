//! # DAEMONIORUM Dialogue Module
//!
//! Alter-aware dialogue system with evidentiality types,
//! morpheme operators, and native plurality support.

pub mod dialogue;
pub mod marcus;
pub mod internal;
pub mod vance;

pub use dialogue·*;
pub use marcus·*;
pub use internal·*;
pub use vance·*;

// ============================================================================
// MODULE INITIALIZATION
// ============================================================================

//! Initialize the complete dialogue system
fn init_dialogue_system() -> DialogueManager! {
    let mut manager = DialogueManager·new();

    // Register NPC dialogues
    register_marcus_dialogues(&mut manager);

    // Register internal system dialogues
    register_internal_dialogues(&mut manager);

    manager
}
