//! # DAEMONIORUM Dialogue Module
//!
//! Alter-aware dialogue system with evidentiality types,
//! morpheme operators, and native plurality support.

☉ scroll dialogue;
☉ scroll marcus;
☉ scroll internal;
☉ scroll vance;

☉ invoke dialogue·*;
☉ invoke marcus·*;
☉ invoke internal·*;
☉ invoke vance·*;

// ============================================================================
// MODULE INITIALIZATION
// ============================================================================

//! Initialize the complete dialogue system
rite init_dialogue_system() -> DialogueManager! {
    ≔ vary manager = DialogueManager·new();

    // Register NPC dialogues
    register_marcus_dialogues(&Δ manager);

    // Register internal system dialogues
    register_internal_dialogues(&Δ manager);

    manager
}
