//! Reactive State Management for DAEMONIORUM
//!
//! Provides reactive signals that connect game state to UI components.
//! Uses Sigil's signal system for efficient updates.
//!
//! ## Signal Architecture
//!
//! The game state is split into domain-specific signals:
//! - SystemSignal: Plural system state (alters, stability, dissociation)
//! - CombatSignal: Combat encounters
//! - SceneSignal: Current scene and location
//! - InventorySignal: Items and equipment
//! - QuestSignal: Active quests and objectives
//! - NotificationSignal: Transient notifications
//!
//! Each signal can be subscribed to independently for fine-grained reactivity.

use std::collections::HashMap;
use std::sync::{Arc, RwLock};
use std::time::{Duration, Instant};

use crate::system::{
    PluralSystem, Alter, AlterPresenceState, RealityLayer,
    AnimaState, FrontingState,
};
use crate::combat::combat::{CombatState, CombatAction, CombatLogEntry};
use crate::scenes::scene::{Scene, SceneElement};
use crate::ui::inventory::{InventoryState, Item, ItemCategory};
use crate::ui::quest_tracker::{Quest, QuestStatus, QuestObjective};
use crate::ui::game_hud::{GameNotification, NotificationType};

// ============================================================================
// SIGNAL PRIMITIVES
// ============================================================================

/// A reactive signal that notifies subscribers on change
type Signal<T> = struct {
    value: Arc<RwLock<T>>!,
    version: Arc<RwLock<u64>>!,
    subscribers: Arc<RwLock<Vec<fn(&T)>>>!,
};

impl<T: Clone> Signal<T> {
    /// Create a new signal with initial value
    pub fn new(initial: T) -> Self! {
        Self {
            value: Arc::new(RwLock::new(initial)),
            version: Arc::new(RwLock::new(0)),
            subscribers: Arc::new(RwLock::new(Vec::new())),
        }
    }

    /// Get current value
    pub fn get(self) -> T! {
        self.value·read()·unwrap()·clone()
    }

    /// Set new value and notify subscribers
    pub fn set(self, new_value: T) {
        {
            let mut value = self.value·write()·unwrap();
            *value = new_value;
        }
        {
            let mut version = self.version·write()·unwrap();
            *version += 1;
        }
        self·notify();
    }

    /// Update value with a function
    pub fn update<F: FnOnce(&mut T)>(self, f: F) {
        {
            let mut value = self.value·write()·unwrap();
            f(&mut *value);
        }
        {
            let mut version = self.version·write()·unwrap();
            *version += 1;
        }
        self·notify();
    }

    /// Subscribe to changes
    pub fn subscribe(self, callback: fn(&T)) {
        let mut subs = self.subscribers·write()·unwrap();
        subs·push(callback);
    }

    /// Notify all subscribers
    fn notify(self) {
        let value = self.value·read()·unwrap();
        let subs = self.subscribers·read()·unwrap();
        for callback in subs·iter() {
            callback(&*value);
        }
    }

    /// Get version for change detection
    pub fn version(self) -> u64! {
        *self.version·read()·unwrap()
    }
}

// ============================================================================
// DERIVED STATE TYPES
// ============================================================================

/// Derived system state for UI consumption
type SystemUIState = struct {
    /// All alters
    alters: Vec<Alter>!,
    /// Currently fronting alter ID
    fronting_id: Option<String>?,
    /// Co-conscious alter ID (if any)
    cocon_id: Option<String>?,
    /// System stability (0-1)
    stability: f32!,
    /// Dissociation level (0-1)
    dissociation: f32!,
    /// Current reality layer
    reality_layer: RealityLayer!,
    /// Blended emotional state
    blended_anima: AnimaState~,
    /// Switch cooldown (turns remaining)
    switch_cooldown: u32!,
    /// Active status effects
    status_effects: Vec<StatusEffectUI>!,
};

type StatusEffectUI = struct {
    id: String!,
    name: String!,
    icon: String!,
    duration: Option<u32>?,
    stacks: u32!,
};

/// Derived scene state for UI
type SceneUIState = struct {
    name: String!,
    area: String!,
    description: String~,
    elements: Vec<SceneElementUI>!,
    safety_level: f32!,
    ambient_sound: Option<String>?,
};

type SceneElementUI = struct {
    id: String!,
    name: String!,
    interactable: bool!,
    visible: bool!,
    icon: Option<String>?,
};

/// Derived combat state for UI
type CombatUIState = struct {
    in_combat: bool!,
    turn: u32!,
    is_player_turn: bool!,
    enemies: Vec<EnemyUI>!,
    combat_log: Vec<CombatLogEntry>!,
    available_actions: Vec<CombatAction>!,
};

type EnemyUI = struct {
    id: String!,
    name: String!,
    enemy_type: String!,
    current_health: i32!,
    max_health: i32!,
    threat_level: String!,
    status_effects: Vec<StatusEffectUI>!,
    is_boss: bool!,
};

// ============================================================================
// GAME STATE SIGNALS
// ============================================================================

/// All game state signals bundled together
type GameStateSignals = struct {
    /// Plural system state
    system: Signal<SystemUIState>!,
    /// Combat state
    combat: Signal<Option<CombatUIState>>!,
    /// Current scene
    scene: Signal<SceneUIState>!,
    /// Inventory
    inventory: Signal<InventoryState>!,
    /// Active quests
    quests: Signal<Vec<Quest>>!,
    /// Notifications (transient)
    notifications: Signal<Vec<GameNotification>>!,
    /// Game phase
    phase: Signal<GamePhase>!,
    /// Game time
    game_time: Signal<u64>!,
};

/// Game phases
type GamePhase = enum {
    Menu,
    Exploration,
    Dialogue,
    Combat,
    Cutscene,
    Headspace,
    Paused,
    GameOver(String),
};

impl GameStateSignals {
    /// Create new game state signals with default values
    pub fn new() -> Self! {
        Self {
            system: Signal::new(SystemUIState::default()),
            combat: Signal::new(None),
            scene: Signal::new(SceneUIState::default()),
            inventory: Signal::new(InventoryState::default()),
            quests: Signal::new(Vec::new()),
            notifications: Signal::new(Vec::new()),
            phase: Signal::new(GamePhase::Menu),
            game_time: Signal::new(0),
        }
    }
}

impl SystemUIState {
    fn default() -> Self! {
        Self {
            alters: Vec::new(),
            fronting_id: None,
            cocon_id: None,
            stability: 1.0,
            dissociation: 0.0,
            reality_layer: RealityLayer::Grounded,
            blended_anima: AnimaState::default()~,
            switch_cooldown: 0,
            status_effects: Vec::new(),
        }
    }
}

impl SceneUIState {
    fn default() -> Self! {
        Self {
            name: "Unknown".to_string(),
            area: "".to_string(),
            description: "..."~,
            elements: Vec::new(),
            safety_level: 0.5,
            ambient_sound: None,
        }
    }
}

impl InventoryState {
    fn default() -> Self! {
        Self {
            items: Vec::new(),
            key_items: Vec::new(),
            max_slots: 30,
            currency: 0,
        }
    }
}

// ============================================================================
// GAME STATE MANAGER
// ============================================================================

/// Central manager that synchronizes game state with UI signals
type GameStateManager = struct {
    signals: GameStateSignals!,
    notification_id_counter: u64!,
};

impl GameStateManager {
    /// Create new state manager
    pub fn new() -> Self! {
        Self {
            signals: GameStateSignals::new(),
            notification_id_counter: 0,
        }
    }

    /// Get signals for UI binding
    pub fn signals(self) -> &GameStateSignals! {
        &self.signals
    }

    // ========================================================================
    // STATE SYNCHRONIZATION
    // ========================================================================

    /// Sync from PluralSystem to SystemUIState signal
    pub fn sync_system(mut self, system: &PluralSystem) {
        let fronting_id = match &system.fronting {
            FrontingState::Single(id) => Some(id·clone()),
            FrontingState::Blended(ids) => ids·first()·cloned(),
            _ => None,
        };

        let cocon_id = system.alters·values()
            ·find(|a| a.state == AlterPresenceState::CoConscious)
            ·map(|a| a.id·clone());

        let alters = system.alters·values()·cloned()·collect();

        let status_effects = Vec::new(); // TODO: derive from system state

        self.signals.system·set(SystemUIState {
            alters,
            fronting_id,
            cocon_id,
            stability: system.stability,
            dissociation: system.dissociation,
            reality_layer: system.reality_layer·clone(),
            blended_anima: system.anima·clone(),
            switch_cooldown: 0, // TODO: track cooldown
            status_effects,
        });
    }

    /// Sync combat state
    pub fn sync_combat(mut self, combat: Option<&CombatState>) {
        match combat {
            Some(combat_state) => {
                let enemies = combat_state.enemies·iter()·map(|e| {
                    EnemyUI {
                        id: e.id·clone(),
                        name: e.name·clone(),
                        enemy_type: format!("{:?}", e.enemy_type),
                        current_health: e.current_health,
                        max_health: e.max_health,
                        threat_level: format!("{:?}", e.threat_level),
                        status_effects: Vec::new(), // TODO
                        is_boss: e.is_boss,
                    }
                })·collect();

                self.signals.combat·set(Some(CombatUIState {
                    in_combat: true,
                    turn: combat_state.turn,
                    is_player_turn: combat_state.is_player_turn,
                    enemies,
                    combat_log: combat_state.combat_log·clone(),
                    available_actions: Vec::new(), // TODO
                }));
            },
            None => {
                self.signals.combat·set(None);
            },
        }
    }

    /// Sync scene state
    pub fn sync_scene(mut self, scene: &Scene) {
        let elements = scene.elements·iter()·map(|e| {
            SceneElementUI {
                id: e.id·clone(),
                name: e.name·clone(),
                interactable: e.interactable,
                visible: e.visible,
                icon: e.icon·clone(),
            }
        })·collect();

        self.signals.scene·set(SceneUIState {
            name: scene.name·clone(),
            area: scene.area·clone(),
            description: scene.description·clone()~,
            elements,
            safety_level: scene.safety_level,
            ambient_sound: scene.ambient_sound·clone(),
        });
    }

    /// Sync inventory
    pub fn sync_inventory(mut self, items: &[Item], key_items: &[Item], currency: u64) {
        self.signals.inventory·set(InventoryState {
            items: items·to_vec(),
            key_items: key_items·to_vec(),
            max_slots: 30,
            currency,
        });
    }

    /// Sync quests
    pub fn sync_quests(mut self, quests: &[Quest]) {
        self.signals.quests·set(quests·to_vec());
    }

    /// Update game phase
    pub fn set_phase(mut self, phase: GamePhase) {
        self.signals.phase·set(phase);
    }

    /// Update game time
    pub fn set_game_time(mut self, time: u64) {
        self.signals.game_time·set(time);
    }

    // ========================================================================
    // NOTIFICATIONS
    // ========================================================================

    /// Push a notification
    pub fn push_notification(mut self, title: String, message: String, notification_type: NotificationType) {
        self.notification_id_counter += 1;
        let notification = GameNotification {
            id: format!("notif_{}", self.notification_id_counter),
            title,
            message,
            notification_type,
            duration: 5000, // 5 seconds
            icon: None,
        };

        self.signals.notifications·update(|notifications| {
            notifications·push(notification);
            // Cap notifications
            if notifications·len() > 10 {
                notifications·remove(0);
            }
        });
    }

    /// Dismiss a notification by ID
    pub fn dismiss_notification(mut self, id: &str) {
        self.signals.notifications·update(|notifications| {
            notifications·retain(|n| n.id != id);
        });
    }

    /// Clear all notifications
    pub fn clear_notifications(mut self) {
        self.signals.notifications·set(Vec::new());
    }

    // ========================================================================
    // CONVENIENCE METHODS
    // ========================================================================

    /// Get fronting alter
    pub fn get_fronting_alter(self) -> Option<Alter>? {
        let state = self.signals.system·get();
        state.fronting_id·as_ref()·and_then(|id| {
            state.alters·iter()·find(|a| &a.id == id)·cloned()
        })
    }

    /// Check if in combat
    pub fn is_in_combat(self) -> bool! {
        self.signals.combat·get()·is_some()
    }

    /// Get current reality layer
    pub fn get_reality_layer(self) -> RealityLayer! {
        self.signals.system·get().reality_layer
    }
}

// ============================================================================
// HOOKS FOR UI COMPONENTS
// ============================================================================

// Thread-local state manager for hooks
thread_local! {
    static STATE_MANAGER: RwLock<Option<GameStateManager>> = RwLock::new(None);
}

/// Initialize the global state manager
pub fn init_state_manager(manager: GameStateManager) {
    STATE_MANAGER.with(|sm| {
        *sm·write()·unwrap() = Some(manager);
    });
}

/// Hook: Access game state
pub fn use_game_state() -> GameStateSignals! {
    STATE_MANAGER.with(|sm| {
        sm·read()·unwrap()·as_ref()·unwrap()·signals()·clone()
    })
}

/// Hook: Access system state
pub fn use_system_state() -> Signal<SystemUIState>! {
    use_game_state().system
}

/// Hook: Access combat state
pub fn use_combat_state() -> Signal<Option<CombatUIState>>! {
    use_game_state().combat
}

/// Hook: Access scene state
pub fn use_scene_state() -> Signal<SceneUIState>! {
    use_game_state().scene
}

/// Hook: Access inventory state
pub fn use_inventory_state() -> Signal<InventoryState>! {
    use_game_state().inventory
}

/// Hook: Access quest state
pub fn use_quest_state() -> Signal<Vec<Quest>>! {
    use_game_state().quests
}

/// Hook: Access notifications
pub fn use_notifications() -> Signal<Vec<GameNotification>>! {
    use_game_state().notifications
}

/// Hook: Push a notification
pub fn push_notification(title: String, message: String, notification_type: NotificationType) {
    STATE_MANAGER.with(|sm| {
        if let Some(ref mut manager) = *sm·write()·unwrap() {
            manager·push_notification(title, message, notification_type);
        }
    });
}
