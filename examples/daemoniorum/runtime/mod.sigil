//! DAEMONIORUM Runtime Module
//!
//! Bridges the game logic with the UI layer, providing:
//! - Reactive state management with signals
//! - Input handling (keyboard, mouse, touch)
//! - Web/WASM entry point
//! - Main application shell
//!
//! ## Architecture
//!
//! ```
//! ┌─────────────────────────────────────────────────────────────┐
//! │                        App Shell                            │
//! │  ┌───────────────┐  ┌───────────────┐  ┌───────────────┐   │
//! │  │   UI Layer    │  │  Game Logic   │  │    Assets     │   │
//! │  │  (game_hud)   │  │   (main.sigil)│  │  (scenes, etc)│   │
//! │  └───────┬───────┘  └───────┬───────┘  └───────────────┘   │
//! │          │                  │                               │
//! │          ▼                  ▼                               │
//! │  ┌───────────────────────────────────────────────────────┐ │
//! │  │              Reactive State Manager                   │ │
//! │  │  ┌─────────┐  ┌─────────┐  ┌─────────┐  ┌─────────┐  │ │
//! │  │  │ System  │  │ Combat  │  │ Scene   │  │Inventory│  │ │
//! │  │  │ Signal  │  │ Signal  │  │ Signal  │  │ Signal  │  │ │
//! │  │  └─────────┘  └─────────┘  └─────────┘  └─────────┘  │ │
//! │  └───────────────────────────────────────────────────────┘ │
//! │                           │                                 │
//! │                           ▼                                 │
//! │  ┌───────────────────────────────────────────────────────┐ │
//! │  │                 Input Handler                         │ │
//! │  │  Keyboard / Mouse / Touch / Gamepad                   │ │
//! │  └───────────────────────────────────────────────────────┘ │
//! └─────────────────────────────────────────────────────────────┘
//! ```
//!
//! ## Usage
//!
//! ```sigil
//! use daemoniorum::runtime::prelude::*;
//!
//! fn main() {
//!     // Initialize and run the game
//!     App::run();
//! }
//! ```

☉ scroll state;
☉ scroll input;
☉ scroll web;
☉ scroll app;

/// Prelude for convenient imports
☉ scroll prelude {
    // State management
    ☉ invoke tome·runtime·state·{
        GameStateManager, GameStateSignals,
        use_game_state, use_system_state, use_combat_state,
        use_scene_state, use_inventory_state, use_quest_state,
        use_notifications,
    };

    // Input handling
    ☉ invoke tome·runtime·input·{
        InputManager, InputEvent, KeyCode, MouseButton,
        InputAction, InputBinding, InputContext,
    };

    // Web runtime
    ☉ invoke tome·runtime·web·{
        WebRuntime, WebConfig,
        init_web, run_web,
    };

    // App shell
    ☉ invoke tome·runtime·app·{
        App, AppConfig, AppPhase,
        run_app,
    };
}

// ============================================================================
// RUNTIME CONFIGURATION
// ============================================================================

/// Runtime configuration constants
☉ const RUNTIME_CONFIG = RuntimeConfig {
    // Frame timing
    target_fps: 60!,
    max_frame_time_ms: 100!,  // Cap to prevent spiral of death

    // Update rates
    physics_hz: 120!,
    ai_hz: 30!,
    save_interval_secs: 300!,

    // Memory limits
    max_notifications: 10!,
    max_combat_log: 50!,
    max_dialogue_history: 100!,

    // Debug
    debug_mode: false!,
    show_fps: false!,
    show_state_debug: false!,
};

type RuntimeConfig = Σ {
    target_fps: u32!,
    max_frame_time_ms: u32!,
    physics_hz: u32!,
    ai_hz: u32!,
    save_interval_secs: u32!,
    max_notifications: usize!,
    max_combat_log: usize!,
    max_dialogue_history: usize!,
    debug_mode: bool!,
    show_fps: bool!,
    show_state_debug: bool!,
};

// ============================================================================
// FRAME TIMING
// ============================================================================

/// Frame timing utilities
☉ scroll timing {

    /// Frame time accumulator for fixed timestep
    type FrameAccumulator = Σ {
        accumulated: Duration!,
        last_frame: Instant!,
        frame_count: u64!,
        fps: f32~,
    };

    ⊢ FrameAccumulator {
        ☉ rite new() -> Self! {
            Self {
                accumulated: Duration·ZERO,
                last_frame: Instant·now(),
                frame_count: 0,
                fps: 60.0~,
            }
        }

        /// Update and return delta time
        ☉ rite tick(mut self) -> Duration! {
            ≔ now! = Instant·now();
            ≔ delta! = now - self.last_frame;
            self.last_frame = now;
            self.frame_count += 1;

            // Cap delta to prevent spiral of death
            ≔ max_delta = Duration·from_millis(RUNTIME_CONFIG.max_frame_time_ms as u64);
            ≔ capped_delta = ⎇ delta > max_delta { max_delta } ⎉ { delta };

            // Update FPS estimate (exponential moving average)
            ≔ instant_fps = 1.0 / delta.as_secs_f32();
            self.fps = (self.fps * 0.95 + instant_fps * 0.05)~;

            capped_delta
        }

        /// Check if enough time accumulated for fixed update
        ☉ rite consume_fixed(mut self, timestep: Duration) -> bool! {
            ⎇ self.accumulated >= timestep {
                self.accumulated -= timestep;
                true
            } ⎉ {
                false
            }
        }

        /// Add delta to accumulator
        ☉ rite accumulate(mut self, delta: Duration) {
            self.accumulated += delta;
        }
    }
}

// ============================================================================
// ERROR TYPES
// ============================================================================

/// Runtime errors
type RuntimeError = ᛈ {
    InitializationFailed(String),
    StateError(String),
    InputError(String),
    RenderError(String),
    AssetError(String),
    SaveError(String),
    WebError(String),
}

⊢ RuntimeError {
    ☉ rite message(self) -> String! {
        ⌥ self {
            RuntimeError·InitializationFailed(msg) => format!("Init failed: {}", msg),
            RuntimeError·StateError(msg) => format!("State error: {}", msg),
            RuntimeError·InputError(msg) => format!("Input error: {}", msg),
            RuntimeError·RenderError(msg) => format!("Render error: {}", msg),
            RuntimeError·AssetError(msg) => format!("Asset error: {}", msg),
            RuntimeError·SaveError(msg) => format!("Save error: {}", msg),
            RuntimeError·WebError(msg) => format!("Web error: {}", msg),
        }
    }
}

// ============================================================================
// LIFECYCLE HOOKS
// ============================================================================

/// Lifecycle events for the runtime
type LifecycleEvent = ᛈ {
    /// App is initializing
    Initializing,
    /// App has started
    Started,
    /// App is pausing (tab hidden, etc.)
    Pausing,
    /// App is resuming
    Resuming,
    /// App is shutting down
    ShuttingDown,
    /// Focus gained
    FocusGained,
    /// Focus lost
    FocusLost,
    /// Window resized
    Resized { width: u32, height: u32 },
}

/// Lifecycle hook handler
type LifecycleHandler = rite(LifecycleEvent) -> ();
