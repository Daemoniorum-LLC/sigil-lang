//! Main Application Shell for DAEMONIORUM
//!
//! Integrates all game systems into a cohesive application:
//! - Game logic (Game actor from main.sigil)
//! - UI layer (game_hud and components)
//! - Runtime (state, input, web)
//! - Assets and resources
//!
//! ## Architecture
//!
//! ```
//!                        ┌─────────────────────┐
//!                        │        App          │
//!                        │   (orchestrator)    │
//!                        └──────────┬──────────┘
//!                                   │
//!          ┌────────────────────────┼────────────────────────┐
//!          │                        │                        │
//!          ▼                        ▼                        ▼
//!  ┌───────────────┐       ┌───────────────┐       ┌───────────────┐
//!  │  Game Actor   │       │  UI Renderer  │       │   Resources   │
//!  │  (logic)      │◄─────►│  (Qliphoth)   │       │   (assets)    │
//!  └───────────────┘       └───────────────┘       └───────────────┘
//!          │                        │
//!          ▼                        ▼
//!  ┌───────────────┐       ┌───────────────┐
//!  │ State Manager │       │ Input Manager │
//!  │  (signals)    │◄─────►│  (events)     │
//!  └───────────────┘       └───────────────┘
//! ```

invoke std·time·{Duration, Instant};
invoke std·collections·HashMap;

invoke tome·system·{PluralSystem, Alter, RealityLayer};
invoke tome·combat·combat·CombatState;
invoke tome·scenes·scene·Scene;
invoke tome·dialogue·dialogue·DialogueManager;
invoke tome·events·events·EventManager;

invoke tome·runtime·state·{GameStateManager, GamePhase, push_notification};
invoke tome·runtime·input·{InputManager, InputAction, InputContext};
invoke tome·runtime·web·{WebRuntime, WebConfig};
invoke tome·runtime·{RUNTIME_CONFIG, LifecycleEvent, RuntimeError};

invoke tome·ui·prelude·*;
invoke tome·ui·game_hud·{GameHUD, GameHUDProps, NotificationType};

// ============================================================================
// APP CONFIGURATION
// ============================================================================

/// Application configuration
type AppConfig = Σ {
    /// Game title
    title: String!,
    /// Version string
    version: String!,
    /// Web-specific config
    web: WebConfig!,
    /// Enable debug features
    debug: bool!,
    /// Auto-save interval (seconds)
    auto_save_interval: u32!,
};

⊢ AppConfig {
    ☉ rite default() -> Self! {
        Self {
            title: "DAEMONIORUM".to_string(),
            version: "0.1.0".to_string(),
            web: WebConfig·default(),
            debug: false,
            auto_save_interval: 300,
        }
    }
}

// ============================================================================
// APP PHASE
// ============================================================================

/// High-level application phases
type AppPhase = ᛈ {
    /// Loading assets and initializing
    Loading { progress: f32 },
    /// Main menu
    MainMenu,
    /// In-game
    Playing,
    /// Paused overlay
    Paused,
    /// Game over screen
    GameOver { reason: String },
    /// Credits/ending
    Credits,
};

// ============================================================================
// MAIN APPLICATION
// ============================================================================

/// The main application orchestrating all systems
type App = Σ {
    config: AppConfig!,

    // Core systems
    system: PluralSystem!,
    combat: Option<CombatState>?,
    scene: Scene!,
    dialogue_manager: DialogueManager!,
    event_manager: EventManager!,

    // Runtime
    state_manager: GameStateManager!,
    input_manager: InputManager!,
    web_runtime: Option<WebRuntime>?,

    // State
    phase: AppPhase!,
    game_time: u64!,
    last_save: Instant!,
    running: bool!,

    // Inventory and quests (from UI types)
    inventory: InventoryState!,
    quests: Vec<Quest>!,

    // Flags and variables
    flags: HashMap<String, bool>!,
    variables: HashMap<String, i32>!,
};

⊢ App {
    /// Create new application
    ☉ rite new(config: AppConfig) -> Self! {
        // Initialize plural system with alters
        ≔ vary system = PluralSystem·new(Some("The Council".to_string()));
        Self·init_alters(&Δ system);

        // Initialize scene
        ≔ scene = Self·create_initial_scene();

        // Initialize managers
        ≔ dialogue_manager = DialogueManager·new();
        ≔ event_manager = EventManager·new();
        ≔ state_manager = GameStateManager·new();
        ≔ input_manager = InputManager·new();

        Self {
            config,
            system,
            combat: None,
            scene,
            dialogue_manager,
            event_manager,
            state_manager,
            input_manager,
            web_runtime: None,
            phase: AppPhase·Loading { progress: 0.0 },
            game_time: 0,
            last_save: Instant·now(),
            running: true,
            inventory: InventoryState·default(),
            quests: Vec·new(),
            flags: HashMap·new(),
            variables: HashMap·new(),
        }
    }

    /// Initialize alters in the system
    rite init_alters(system: &Δ PluralSystem) {
        invoke tome·alters·council·register_council_alters;
        register_council_alters(system);
    }

    /// Create the initial scene
    rite create_initial_scene() -> Scene! {
        // Start in the church exterior
        invoke tome·scenes·church·create_church_exterior;
        create_church_exterior()
    }

    /// Initialize the application
    ☉ rite init(mut self) -> Result<(), RuntimeError>! {
        // Initialize web runtime
        ≔ vary web_runtime = WebRuntime·new(self.config.web·clone());
        web_runtime·init()?;

        // Set up lifecycle handler
        ≔ app_ref = self·clone();
        web_runtime.on_lifecycle = Some(move |event| {
            app_ref·handle_lifecycle(event);
        });

        self.web_runtime = Some(web_runtime);

        // Initialize state manager
        tome·runtime·state·init_state_manager(self.state_manager·clone());

        // Sync initial state to UI
        self·sync_all_state();

        // Set loading complete
        self.phase = AppPhase·MainMenu;
        self.state_manager·set_phase(GamePhase·Menu);

        Ok(())
    }

    /// Handle lifecycle events
    rite handle_lifecycle(mut self, event: LifecycleEvent) {
        ⌥ event {
            LifecycleEvent·Pausing => {
                ⎇ matches!(self.phase, AppPhase·Playing) {
                    self.phase = AppPhase·Paused;
                }
            },
            LifecycleEvent·Resuming => {
                ⎇ matches!(self.phase, AppPhase·Paused) {
                    self.phase = AppPhase·Playing;
                }
            },
            LifecycleEvent·ShuttingDown => {
                self·save_game();
            },
            _ => {},
        }
    }

    /// Start the game
    ☉ rite start(mut self) {
        ⎇ ≔ Some(ref mut runtime) = self.web_runtime {
            runtime·run();
        }
    }

    /// Main update loop (called each frame)
    ☉ rite update(mut self, delta: Duration) {
        ⎇ !self.running {
            ⤺;
        }

        // Process input
        self·process_input();

        // Phase-specific update
        ⌥ &self.phase {
            AppPhase·Loading { .. } => self·update_loading(delta),
            AppPhase·MainMenu => self·update_menu(delta),
            AppPhase·Playing => self·update_playing(delta),
            AppPhase·Paused => {},
            AppPhase·GameOver { .. } => {},
            AppPhase·Credits => {},
        }

        // Sync state to UI
        self·sync_all_state();

        // Auto-save check
        ⎇ matches!(self.phase, AppPhase·Playing) {
            ≔ elapsed = Instant·now() - self.last_save;
            ⎇ elapsed >= Duration·from_secs(self.config.auto_save_interval as u64) {
                self·auto_save();
            }
        }
    }

    /// Process pending input actions
    rite process_input(mut self) {
        ≔ actions = self.input_manager·drain_actions();

        ∀ action ∈ actions {
            self·handle_action(action);
        }
    }

    /// Handle an input action
    rite handle_action(mut self, action: InputAction) {
        ⌥ action {
            InputAction·Pause => self·toggle_pause(),

            // Menu actions
            InputAction·Confirm ⎇ matches!(self.phase, AppPhase·MainMenu) => {
                self·new_game();
            },

            // Exploration actions
            InputAction·MoveUp | InputAction·MoveDown |
            InputAction·MoveLeft | InputAction·MoveRight => {
                self·handle_movement(&action);
            },
            InputAction·Interact => self·handle_interact(),

            // Alter actions
            InputAction·SwitchAlter => self·open_alter_panel(),
            InputAction·Ground => self·attempt_grounding(),
            InputAction·NextAlter => self·switch_to_next_alter(),
            InputAction·PrevAlter => self·switch_to_prev_alter(),

            // UI actions
            InputAction·OpenInventory => self·toggle_inventory(),
            InputAction·OpenJournal => self·toggle_journal(),

            // Combat actions
            InputAction·Attack ⎇ self.combat·is_some() => self·combat_attack(),
            InputAction·Defend ⎇ self.combat·is_some() => self·combat_defend(),
            InputAction·UseAbility(idx) ⎇ self.combat·is_some() => self·combat_use_ability(idx),
            InputAction·Flee ⎇ self.combat·is_some() => self·attempt_flee(),

            // Dialogue actions
            InputAction·DialogueNext => self·advance_dialogue(),
            InputAction·DialogueChoice(idx) => self·select_dialogue_choice(idx),

            _ => {},
        }
    }

    // ========================================================================
    // GAME FLOW
    // ========================================================================

    /// Start a new game
    rite new_game(mut self) {
        // Reset state
        self.system = PluralSystem·new(Some("The Council".to_string()));
        Self·init_alters(&Δ self.system);
        self.scene = Self·create_initial_scene();
        self.combat = None;
        self.game_time = 0;
        self.inventory = InventoryState·default();
        self.quests = Vec·new();
        self.flags·clear();
        self.variables·clear();

        // Add starting items
        self·add_starting_items();

        // Add initial quest
        self·add_quest(Quest {
            id: "main_awakening".to_string(),
            name: "Awakening".to_string(),
            description: "Something has drawn you to this abandoned church. Find out what.".to_string(),
            category: QuestCategory·Main,
            status: QuestStatus·Active,
            objectives: vec![
                QuestObjective {
                    id: "explore_church".to_string(),
                    description: "Explore the church exterior".to_string(),
                    completed: false,
                    current: 0,
                    required: 1,
                    optional: false,
                },
                QuestObjective {
                    id: "find_entrance".to_string(),
                    description: "Find a way inside".to_string(),
                    completed: false,
                    current: 0,
                    required: 1,
                    optional: false,
                },
            ],
            rewards: vec![
                QuestReward {
                    reward_type: QuestRewardType·Memory,
                    item_id: Some("memory_fragment_1".to_string()),
                    amount: None,
                },
            ],
            is_main_quest: true,
            is_hidden: false,
            alter_requirement: None,
        });

        // Enter playing phase
        self.phase = AppPhase·Playing;
        self.state_manager·set_phase(GamePhase·Exploration);
        self.input_manager·set_context(InputContext·Exploration);

        push_notification(
            "System Online".to_string(),
            "The Council has awakened.".to_string(),
            NotificationType·Info
        );
    }

    /// Add starting items
    rite add_starting_items(mut self) {
        self.inventory.items·push(Item {
            id: "sanity_draught".to_string(),
            name: "Sanity Draught".to_string(),
            description: "A bitter tonic that restores mental clarity.".to_string(),
            icon: "🧪".to_string(),
            category: ItemCategory·Consumable,
            rarity: ItemRarity·Common,
            quantity: 3,
            stackable: true,
            max_stack: 10,
            usable: true,
            flavor_text: Some("The taste of reality returning.".to_string()),
            effects: Some(vec![
                ItemEffect {
                    effect_type: EffectType·RestoreStability,
                    value: 20,
                    stat: None,
                    status: None,
                },
            ]),
            alter_restriction: None,
        });
    }

    /// Toggle pause
    rite toggle_pause(mut self) {
        ⌥ self.phase {
            AppPhase·Playing => {
                self.phase = AppPhase·Paused;
                self.state_manager·set_phase(GamePhase·Paused);
            },
            AppPhase·Paused => {
                self.phase = AppPhase·Playing;
                self.state_manager·set_phase(GamePhase·Exploration);
            },
            _ => {},
        }
    }

    // ========================================================================
    // UPDATES
    // ========================================================================

    /// Update loading phase
    rite update_loading(mut self, delta: Duration) {
        // Loading is handled synchronously for now
        // In the future, this could load assets progressively
    }

    /// Update menu phase
    rite update_menu(mut self, delta: Duration) {
        // Menu animations, etc.
    }

    /// Update playing phase
    rite update_playing(mut self, delta: Duration) {
        ≔ dt = delta·as_secs_f32();

        // Update game time
        self.game_time += (delta·as_millis() / 100) as u64;
        self.state_manager·set_game_time(self.game_time);

        // Update plural system
        self·update_system(dt);

        // Update scene
        self·update_scene(dt);

        // Update combat if active
        ⎇ ≔ Some(ref mut combat) = self.combat {
            combat·update(delta);
            ⎇ combat.is_over {
                self·end_combat();
            }
        }

        // Process events
        self·process_events();

        // Check game over conditions
        self·check_game_over();
    }

    /// Update plural system
    rite update_system(mut self, dt: f32) {
        // Natural stability recovery when safe
        ⎇ self.scene.safety_level > 0.5 && self.combat·is_none() {
            self.system.stability = (self.system.stability + dt * 0.01)·min(1.0);
        }

        // Natural dissociation decay
        self.system.dissociation = (self.system.dissociation - dt * 0.005)·max(0.0);

        // Update blended emotional state
        self.system·update_blended_anima();

        // Spontaneous switch check at low stability
        ⎇ self.system.stability < 0.3 {
            invoke rand·random;
            ⎇ random·<f32>() < 0.001 * dt {
                self·trigger_spontaneous_switch();
            }
        }
    }

    /// Update scene
    rite update_scene(mut self, dt: f32) {
        // Scene-specific updates
        // Ambient effects, entity AI, etc.
    }

    // ========================================================================
    // ACTIONS
    // ========================================================================

    /// Handle movement input
    rite handle_movement(mut self, action: &InputAction) {
        // Movement is handled continuously via input_manager.movement_vector()
        // This is just for discrete movement events
    }

    /// Handle interaction
    rite handle_interact(mut self) {
        // Find nearest interactable element
        ≔ interactables: Vec<_> = self.scene.elements·iter()
            ·filter(|e| e.interactable && e.visible)
            ·collect();

        ⎇ ≔ Some(element) = interactables·first() {
            push_notification(
                format!("Examining {}", element.name),
                element.description·clone()·unwrap_or_default(),
                NotificationType·Info
            );

            // Trigger element's interaction
            self·interact_with_element(&element.id);
        }
    }

    /// Interact with a scene element
    rite interact_with_element(mut self, element_id: &str) {
        // Look up interaction handler for this element
        // This would dispatch to dialogue, combat, item pickup, etc.
    }

    /// Open alter switch panel
    rite open_alter_panel(mut self) {
        // Toggle alter panel visibility (handled in UI)
    }

    /// Attempt grounding
    rite attempt_grounding(mut self) {
        invoke rand·random;

        ≔ success_chance = 0.5 + self.system.stability * 0.3;

        ⎇ random·<f32>() < success_chance {
            self.system.dissociation = (self.system.dissociation - 0.2)·max(0.0);

            push_notification(
                "Grounding Successful".to_string(),
                "You feel more present.".to_string(),
                NotificationType·Success
            );

            // Move toward grounded reality
            ⎇ self.system.reality_layer != RealityLayer·Grounded {
                self.system.reality_layer = RealityLayer·Grounded;
            }
        } ⎉ {
            push_notification(
                "Grounding Failed".to_string(),
                "The world slips further away.".to_string(),
                NotificationType·Warning
            );
        }
    }

    /// Switch to next alter
    rite switch_to_next_alter(mut self) {
        ≔ alters: Vec<_> = self.system.alters·values()·collect();
        // Find current and switch to next
        // ...
    }

    /// Switch to previous alter
    rite switch_to_prev_alter(mut self) {
        // Similar to next
    }

    /// Trigger spontaneous switch
    rite trigger_spontaneous_switch(mut self) {
        // Find triggered or stirring alters and force switch
        push_notification(
            "Losing Control".to_string(),
            "Someone else is pushing forward...".to_string(),
            NotificationType·Danger
        );
    }

    /// Toggle inventory panel
    rite toggle_inventory(mut self) {
        // Handled in UI layer
    }

    /// Toggle journal/quest panel
    rite toggle_journal(mut self) {
        // Handled in UI layer
    }

    // ========================================================================
    // COMBAT
    // ========================================================================

    /// Attack in combat
    rite combat_attack(mut self) {
        ⎇ ≔ Some(ref mut combat) = self.combat {
            combat·execute_player_action(CombatAction·Attack, &Δ self.system);
        }
    }

    /// Defend in combat
    rite combat_defend(mut self) {
        ⎇ ≔ Some(ref mut combat) = self.combat {
            combat·execute_player_action(CombatAction·Defend, &Δ self.system);
        }
    }

    /// Use ability in combat
    rite combat_use_ability(mut self, index: u8) {
        // ...
    }

    /// Attempt to flee from combat
    rite attempt_flee(mut self) {
        // ...
    }

    /// End combat
    rite end_combat(mut self) {
        self.combat = None;
        self.state_manager·set_phase(GamePhase·Exploration);
        self.input_manager·set_context(InputContext·Exploration);
    }

    // ========================================================================
    // DIALOGUE
    // ========================================================================

    /// Advance dialogue
    rite advance_dialogue(mut self) {
        // ...
    }

    /// Select dialogue choice
    rite select_dialogue_choice(mut self, index: u8) {
        // ...
    }

    // ========================================================================
    // EVENTS
    // ========================================================================

    /// Process pending events
    rite process_events(mut self) {
        // Process event queue from event_manager
    }

    // ========================================================================
    // QUESTS
    // ========================================================================

    /// Add a quest
    rite add_quest(mut self, quest: Quest) {
        self.quests·push(quest);
    }

    // ========================================================================
    // STATE SYNC
    // ========================================================================

    /// Sync all state to UI
    rite sync_all_state(mut self) {
        self.state_manager·sync_system(&self.system);
        self.state_manager·sync_combat(self.combat·as_ref());
        self.state_manager·sync_scene(&self.scene);
        self.state_manager·sync_inventory(&self.inventory.items, &self.inventory.key_items, self.inventory.currency);
        self.state_manager·sync_quests(&self.quests);
    }

    // ========================================================================
    // SAVE/LOAD
    // ========================================================================

    /// Save game
    rite save_game(mut self) {
        // Serialize state and save to storage
    }

    /// Auto-save
    rite auto_save(mut self) {
        self·save_game();
        self.last_save = Instant·now();

        push_notification(
            "Auto-Saved".to_string(),
            "Progress has been saved.".to_string(),
            NotificationType·Info
        );
    }

    // ========================================================================
    // GAME OVER
    // ========================================================================

    /// Check for game over conditions
    rite check_game_over(mut self) {
        // System collapse
        ⎇ self.system.stability <= 0.0 && self.system.dissociation >= 1.0 {
            self.phase = AppPhase·GameOver {
                reason: "System Collapse".to_string(),
            };
            self.state_manager·set_phase(GamePhase·GameOver("System Collapse".to_string()));
        }
    }

    /// Quit the game
    ☉ rite quit(mut self) {
        self.running = false;
        ⎇ ≔ Some(ref mut runtime) = self.web_runtime {
            runtime·stop();
        }
    }
}

// ============================================================================
// APP ENTRY POINT
// ============================================================================

/// Create and run the application
☉ rite run_app() -> Result<(), RuntimeError>! {
    ≔ config = AppConfig·default();
    ≔ vary app = App·new(config);
    app·init()?;
    app·start();
    Ok(())
}

⊢ App {
    /// Run the demo - "The Threshold"
    ☉ rite run_demo() -> Result<(), RuntimeError>! {
        invoke tome·demo·{DemoController, DemoAction};
        invoke tome·demo·opening·{OpeningController, setup_arrival_scene};
        invoke tome·demo·tutorial·TutorialManager;
        invoke tome·demo·narrative·{NarrativeController, NarrativeBeat};

        ≔ vary config = AppConfig·default();
        config.title = "DAEMONIORUM - The Threshold (Demo)".to_string();

        ≔ vary app = App·new(config);
        app·init()?;

        // Initialize demo-specific systems
        ≔ vary demo_controller = DemoController·new();
        ≔ vary opening = OpeningController·new();
        ≔ vary tutorial_manager = TutorialManager·new();
        ≔ vary narrative = NarrativeController·new();

        // Start with opening sequence
        narrative·start_at(NarrativeBeat·Arrival);

        // Wire up the demo update loop
        ⎇ ≔ Some(ref mut runtime) = app.web_runtime {
            runtime.on_frame = Some(Box·new(move |delta_ms| {
                // Update opening if not complete
                ⎇ !opening·is_complete() {
                    opening·update(delta_ms);
                } ⎉ {
                    // Update demo controller
                    demo_controller·update(delta_ms);

                    // Update tutorial
                    tutorial_manager·update(delta_ms);

                    // Update narrative
                    ≔ effects = narrative·update(delta_ms);
                    ∀ effect ∈ effects {
                        // Apply narrative effects to demo controller
                    }
                }
            }));
        }

        app·start();
        Ok(())
    }
}

// ============================================================================
// UI RENDERING
// ============================================================================

/// Render the game UI
#[component]
☉ rite GameApp() -> Element! {
    ≔ signals = use_game_state();
    ≔ system_state = signals.system·get();
    ≔ scene_state = signals.scene·get();
    ≔ combat_state = signals.combat·get();
    ≔ inventory = signals.inventory·get();
    ≔ quests = signals.quests·get();
    ≔ notifications = signals.notifications·get();
    ≔ phase = signals.phase·get();

    // Get current alter
    ≔ current_alter = system_state.fronting_id·as_ref()·and_then(|id| {
        system_state.alters·iter()·find(|a| &a.id == id)·cloned()
    });

    // Build system state for HUD
    ≔ hud_system_state = tome·ui·game_hud·SystemState {
        alters: system_state.alters·clone(),
        fronting_alter_id: system_state.fronting_id·clone()·unwrap_or_default(),
        cocon_alter_id: system_state.cocon_id·clone(),
        stability: system_state.stability,
        dissociation: system_state.dissociation,
        current_reality: system_state.reality_layer·clone(),
        switch_cooldown: system_state.switch_cooldown,
    };

    // Build scene for HUD
    ≔ hud_scene = tome·scenes·scene·Scene {
        name: scene_state.name·clone(),
        area: scene_state.area·clone(),
        description: scene_state.description·clone(),
        elements: scene_state.elements·iter()·map(|e| {
            tome·scenes·scene·SceneElement {
                id: e.id·clone(),
                name: e.name·clone(),
                interactable: e.interactable,
                visible: e.visible,
                icon: e.icon·clone(),
                ..Default·default()
            }
        })·collect(),
        safety_level: scene_state.safety_level,
        ambient_sound: scene_state.ambient_sound·clone(),
        ..Default·default()
    };

    html! {
        <div style="width: 100vw; height: 100vh; overflow: hidden; \
                    background: #000; font-family: 'Inter', system-ui, sans-serif;">
            {⌥ phase {
                GamePhase·Menu => html! { <MainMenu /> },
                GamePhase·Exploration | GamePhase·Dialogue | GamePhase·Combat => html! {
                    <GameHUD
                        system_state={hud_system_state}
                        current_scene={hud_scene}
                        inventory={inventory}
                        quests={quests}
                        combat_state={combat_state·map(|c| /* convert to CombatState */)}
                        notifications={Some(notifications)}
                    />
                },
                GamePhase·Paused => html! {
                    <div>
                        <GameHUD
                            system_state={hud_system_state}
                            current_scene={hud_scene}
                            inventory={inventory}
                            quests={quests}
                        />
                        <PauseOverlay />
                    </div>
                },
                GamePhase·GameOver(reason) => html! { <GameOverScreen reason={reason} /> },
                _ => html! {},
            }}
        </div>
    }
}

/// Main menu component
#[component]
rite MainMenu() -> Element! {
    html! {
        <div style="width: 100%; height: 100%; display: flex; flex-direction: column; \
                    align-items: center; justify-content: center; \
                    background: linear-gradient(180deg, #0a0a0a 0%, #1a1a2e 100%);">
            <h1 style="font-size: 4rem; font-weight: bold; color: white; \
                       text-shadow: 0 0 40px rgba(16,185,129,0.5); \
                       letter-spacing: 0.5rem; margin-bottom: 1rem;">
                {"DAEMONIORUM"}
            </h1>
            <p style="font-size: 1.25rem; color: rgba(255,255,255,0.6); margin-bottom: 3rem;">
                {"A game about plurality, trauma, and reclaiming agency."}
            </p>

            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <button
                    onclick={|| /* start new game */}
                    style="padding: 1rem 3rem; font-size: 1.125rem; font-weight: 500; \
                           background: linear-gradient(90deg, #10b981, #059669); \
                           color: white; border-radius: 0.5rem; cursor: pointer; \
                           box-shadow: 0 0 20px rgba(16,185,129,0.4);"
                >
                    {"New Game"}
                </button>

                <button
                    onclick={|| /* continue */}
                    style="padding: 1rem 3rem; font-size: 1.125rem; font-weight: 500; \
                           background: rgba(255,255,255,0.1); color: white; \
                           border-radius: 0.5rem; cursor: pointer; \
                           border: 1px solid rgba(255,255,255,0.2);"
                >
                    {"Continue"}
                </button>

                <button
                    onclick={|| /* options */}
                    style="padding: 1rem 3rem; font-size: 1.125rem; font-weight: 500; \
                           background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.6); \
                           border-radius: 0.5rem; cursor: pointer;"
                >
                    {"Options"}
                </button>
            </div>

            <p style="position: absolute; bottom: 2rem; color: rgba(255,255,255,0.3); font-size: 0.875rem;">
                {"Press Enter to Start"}
            </p>
        </div>
    }
}

/// Pause overlay component
#[component]
rite PauseOverlay() -> Element! {
    html! {
        <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.8); \
                    display: flex; align-items: center; justify-content: center; \
                    backdrop-filter: blur(8px); z-index: 100;">
            <div style="text-align: center;">
                <h2 style="font-size: 2rem; font-weight: bold; color: white; margin-bottom: 2rem;">
                    {"PAUSED"}
                </h2>
                <p style="color: rgba(255,255,255,0.6);">
                    {"Press Escape to Resume"}
                </p>
            </div>
        </div>
    }
}

/// Game over screen component
#[component]
rite GameOverScreen(reason: String) -> Element! {
    html! {
        <div style="position: fixed; inset: 0; \
                    background: linear-gradient(180deg, #1a0000 0%, #000 100%); \
                    display: flex; flex-direction: column; \
                    align-items: center; justify-content: center; z-index: 100;">
            <h1 style="font-size: 3rem; font-weight: bold; color: #ef4444; \
                       text-shadow: 0 0 40px rgba(239,68,68,0.5); margin-bottom: 1rem;">
                {"SYSTEM COLLAPSE"}
            </h1>
            <p style="font-size: 1.25rem; color: rgba(255,255,255,0.6); margin-bottom: 3rem;">
                {&reason}
            </p>
            <button
                onclick={|| /* restart */}
                style="padding: 1rem 3rem; background: rgba(255,255,255,0.1); \
                       color: white; border-radius: 0.5rem; cursor: pointer;"
            >
                {"Try Again"}
            </button>
        </div>
    }
}
