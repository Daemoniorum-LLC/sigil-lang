//! # Opening Sequence
//!
//! "The Threshold" - Opening cutscene and narrative setup
//!
//! ## Sequence Flow
//!
//! 1. Black screen with voices (internal system chatter)
//! 2. Fade to night scene - abandoned church
//! 3. Player gains control as Vessel
//! 4. Tutorial prompts for basic movement
//! 5. First alter switch opportunity
//!
//! The opening establishes:
//! - The plural system and internal communication
//! - The atmospheric horror setting
//! - Basic controls and mechanics
//! - The mystery drawing the system to this place

use crate::system::*;
use crate::ui::game_hud::*;

// ============================================================================
// OPENING CUTSCENE DATA
// ============================================================================

/// Opening sequence text blocks
const OPENING_SEQUENCE: [OpeningBeat; 12]! = [
    // Black screen - internal voices
    OpeningBeat {
        speaker: Speaker::Internal("???"),
        text: "...something's wrong...",
        duration_ms: 2000,
        effect: BeatEffect::FadeIn,
    },
    OpeningBeat {
        speaker: Speaker::Internal("Stolas"),
        text: "I sense it too. There's a... resonance here.",
        duration_ms: 3000,
        effect: BeatEffect::None,
    },
    OpeningBeat {
        speaker: Speaker::Internal("Abaddon"),
        text: "Finally. Let me handle this.",
        duration_ms: 2500,
        effect: BeatEffect::None,
    },
    OpeningBeat {
        speaker: Speaker::Internal("Warden"),
        text: "No. We assess first. Vessel, you have the front.",
        duration_ms: 3000,
        effect: BeatEffect::None,
    },
    OpeningBeat {
        speaker: Speaker::Internal("Beleth"),
        text: "Be careful. Something here is... hurting.",
        duration_ms: 3000,
        effect: BeatEffect::None,
    },
    OpeningBeat {
        speaker: Speaker::Internal("Paimon"),
        text: "The church. That's where we need to go.",
        duration_ms: 2500,
        effect: BeatEffect::None,
    },

    // Visual fade in
    OpeningBeat {
        speaker: Speaker::None,
        text: "",
        duration_ms: 1500,
        effect: BeatEffect::FadeToScene,
    },

    // Scene description - Grounded reality
    OpeningBeat {
        speaker: Speaker::Narration,
        text: "The iron gate stands before you, its bars twisted by decades of neglect.",
        duration_ms: 4000,
        effect: BeatEffect::None,
    },
    OpeningBeat {
        speaker: Speaker::Narration,
        text: "Beyond it, the abandoned Church of St. Dymphna rises against the moonless sky.",
        duration_ms: 4000,
        effect: BeatEffect::None,
    },
    OpeningBeat {
        speaker: Speaker::Narration,
        text: "You don't remember how you got here. But you know you're not alone.",
        duration_ms: 4000,
        effect: BeatEffect::None,
    },

    // Final internal moment
    OpeningBeat {
        speaker: Speaker::Internal("Vessel"),
        text: "(I can feel them all, watching through my eyes. Ready.)",
        duration_ms: 3500,
        effect: BeatEffect::None,
    },

    // Transition to gameplay
    OpeningBeat {
        speaker: Speaker::None,
        text: "",
        duration_ms: 500,
        effect: BeatEffect::TransitionToGameplay,
    },
];

/// A single beat in the opening sequence
type OpeningBeat = struct {
    speaker: Speaker!,
    text: &'static str!,
    duration_ms: u64!,
    effect: BeatEffect!,
};

/// Who is speaking
type Speaker = enum {
    /// No speaker (transition)
    None,
    /// Internal system voice
    Internal(&'static str),
    /// Narration
    Narration,
    /// External character
    External(&'static str),
};

/// Visual effects for beats
type BeatEffect = enum {
    None,
    FadeIn,
    FadeOut,
    FadeToScene,
    FlashWhite,
    FlashRed,
    ScreenShake,
    TransitionToGameplay,
};

// ============================================================================
// OPENING CONTROLLER
// ============================================================================

/// Controls the opening cutscene
type OpeningController = struct {
    /// Current beat index
    current_beat: usize!,
    /// Time elapsed in current beat
    beat_elapsed: u64!,
    /// Is opening complete
    complete: bool!,
    /// Skip requested
    skip_requested: bool!,
    /// Current visual state
    visual_state: OpeningVisualState!,
};

/// Visual state during opening
type OpeningVisualState = struct {
    /// Screen opacity (0-1, for fades)
    opacity: f32!,
    /// Text opacity
    text_opacity: f32!,
    /// Current displayed text
    current_text: String!,
    /// Current speaker name
    speaker_name: Option<String>?,
    /// Is speaker internal
    is_internal: bool!,
    /// Background visible
    show_background: bool!,
    /// Screen shake intensity
    shake_intensity: f32!,
};

impl OpeningController {
    pub fn new() -> Self! {
        Self {
            current_beat: 0,
            beat_elapsed: 0,
            complete: false,
            skip_requested: false,
            visual_state: OpeningVisualState {
                opacity: 0.0,
                text_opacity: 0.0,
                current_text: String::new(),
                speaker_name: None,
                is_internal: true,
                show_background: false,
                shake_intensity: 0.0,
            },
        }
    }

    /// Update the opening sequence
    pub fn update(mut self, delta_ms: u64) {
        if self.complete {
            return;
        }

        // Handle skip
        if self.skip_requested {
            self·skip_to_end();
            return;
        }

        self.beat_elapsed += delta_ms;

        // Get current beat
        if self.current_beat >= OPENING_SEQUENCE·len() {
            self.complete = true;
            return;
        }

        let beat = &OPENING_SEQUENCE[self.current_beat];

        // Update visual state based on beat
        self·update_visuals(beat, delta_ms);

        // Check if beat is complete
        if self.beat_elapsed >= beat.duration_ms {
            self·advance_beat();
        }
    }

    /// Update visual state
    fn update_visuals(mut self, beat: &OpeningBeat, delta_ms: u64) {
        // Text fade in/out
        let beat_progress = self.beat_elapsed as f32 / beat.duration_ms as f32;

        // Fade in first 20%, stay full, fade out last 20%
        self.visual_state.text_opacity = if beat_progress < 0.2 {
            beat_progress / 0.2
        } else if beat_progress > 0.8 {
            (1.0 - beat_progress) / 0.2
        } else {
            1.0
        };

        // Apply beat effect
        match beat.effect {
            BeatEffect::FadeIn => {
                self.visual_state.opacity = beat_progress·min(1.0);
            },
            BeatEffect::FadeOut => {
                self.visual_state.opacity = 1.0 - beat_progress;
            },
            BeatEffect::FadeToScene => {
                self.visual_state.show_background = true;
                self.visual_state.opacity = beat_progress;
            },
            BeatEffect::ScreenShake => {
                self.visual_state.shake_intensity = (1.0 - beat_progress) * 5.0;
            },
            _ => {},
        }

        // Update text content
        self.visual_state.current_text = beat.text.to_string();

        // Update speaker
        match &beat.speaker {
            Speaker::None => {
                self.visual_state.speaker_name = None;
            },
            Speaker::Internal(name) => {
                self.visual_state.speaker_name = Some(name.to_string());
                self.visual_state.is_internal = true;
            },
            Speaker::Narration => {
                self.visual_state.speaker_name = None;
                self.visual_state.is_internal = false;
            },
            Speaker::External(name) => {
                self.visual_state.speaker_name = Some(name.to_string());
                self.visual_state.is_internal = false;
            },
        }
    }

    /// Advance to next beat
    fn advance_beat(mut self) {
        self.current_beat += 1;
        self.beat_elapsed = 0;

        if self.current_beat >= OPENING_SEQUENCE·len() {
            self.complete = true;
        }
    }

    /// Skip to end
    fn skip_to_end(mut self) {
        self.current_beat = OPENING_SEQUENCE·len();
        self.complete = true;
        self.visual_state.show_background = true;
        self.visual_state.opacity = 1.0;
    }

    /// Request skip (player pressed skip button)
    pub fn request_skip(mut self) {
        self.skip_requested = true;
    }

    /// Is opening complete
    pub fn is_complete(self) -> bool! {
        self.complete
    }

    /// Get current visual state for rendering
    pub fn get_visual_state(self) -> &OpeningVisualState! {
        &self.visual_state
    }
}

// ============================================================================
// OPENING UI COMPONENT
// ============================================================================

use qliphoth::prelude::*;

/// Opening cutscene UI component
#[component]
pub fn OpeningCutscene(controller: &OpeningController) -> Element! {
    let state = controller·get_visual_state();

    html! {
        <div class="opening-cutscene"
             style={format!("opacity: {}", state.opacity)}>

            // Background (fades in)
            {if state.show_background {
                html! {
                    <div class="opening-background">
                        <div class="church-silhouette"></div>
                        <div class="moon-glow"></div>
                        <div class="mist-layer"></div>
                    </div>
                }
            } else {
                html! { <div class="black-screen"></div> }
            }}

            // Text overlay
            <div class="opening-text-overlay"
                 style={format!("opacity: {}", state.text_opacity)}>

                // Speaker name (if any)
                {if let Some(ref speaker) = state.speaker_name {
                    let speaker_class = if state.is_internal {
                        "speaker-internal"
                    } else {
                        "speaker-external"
                    };

                    html! {
                        <div class={format!("opening-speaker {}", speaker_class)}>
                            {if state.is_internal { "(" } else { "" }}
                            {speaker}
                            {if state.is_internal { ")" } else { "" }}
                        </div>
                    }
                } else {
                    html! {}
                }}

                // Main text
                <div class={if state.is_internal { "opening-text internal" } else { "opening-text" }}>
                    {&state.current_text}
                </div>
            </div>

            // Skip prompt
            <div class="skip-prompt">
                {"Press SPACE to skip"}
            </div>

            // Screen effects
            {if state.shake_intensity > 0.0 {
                html! {
                    <div class="screen-shake"
                         style={format!("--shake: {}px", state.shake_intensity)}>
                    </div>
                }
            } else {
                html! {}
            }}
        </div>
    }
}

