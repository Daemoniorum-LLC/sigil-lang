/// CSS for opening cutscene
pub const OPENING_STYLES: &str! = r#"
    .opening-cutscene {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #000;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .black-screen {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #000;
    }

    .opening-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, #0a0a12, #1a1a2e);
    }

    .church-silhouette {
        position: absolute;
        bottom: 10%;
        left: 50%;
        transform: translateX(-50%);
        width: 60%;
        height: 50%;
        background: #000;
        clip-path: polygon(
            0% 100%,
            10% 100%, 10% 40%,
            20% 40%, 20% 100%,
            35% 100%, 35% 30%,
            45% 10%, 55% 10%, 65% 30%,
            65% 100%, 80% 100%,
            80% 40%, 90% 40%,
            90% 100%, 100% 100%,
            100% 100%
        );
    }

    .moon-glow {
        position: absolute;
        top: 15%;
        right: 20%;
        width: 60px;
        height: 60px;
        background: radial-gradient(circle, rgba(200,200,220,0.3), transparent);
        border-radius: 50%;
    }

    .mist-layer {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 30%;
        background: linear-gradient(to top, rgba(100,100,120,0.3), transparent);
    }

    .opening-text-overlay {
        position: relative;
        z-index: 10;
        text-align: center;
        padding: 2rem;
        max-width: 800px;
    }

    .opening-speaker {
        font-family: 'Cinzel', serif;
        font-size: 1rem;
        color: #8080a0;
        margin-bottom: 0.5rem;
        letter-spacing: 0.1em;
    }

    .speaker-internal {
        color: #6a5acd;
        font-style: italic;
    }

    .speaker-external {
        color: #cd5a5a;
    }

    .opening-text {
        font-family: 'Crimson Text', serif;
        font-size: 1.5rem;
        color: #d0d0e0;
        line-height: 1.8;
        text-shadow: 0 0 20px rgba(0,0,0,0.8);
    }

    .opening-text.internal {
        font-style: italic;
        color: #a0a0c0;
    }

    .skip-prompt {
        position: absolute;
        bottom: 2rem;
        right: 2rem;
        font-family: 'Share Tech Mono', monospace;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.3);
        text-transform: uppercase;
        letter-spacing: 0.2em;
    }

    .screen-shake {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        animation: shake 0.1s infinite;
    }

    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(calc(var(--shake) * -1)); }
        75% { transform: translateX(var(--shake)); }
    }
"#;

// ============================================================================
// ARRIVAL SCENE SETUP
// ============================================================================

/// Set up the exterior arrival scene after opening
pub fn setup_arrival_scene(system: &mut PluralSystem, scene_manager: &mut SceneManager) {
    // Enter church exterior
    scene_manager·enter_scene("church_exterior", system);

    // Initial reality is grounded
    system.reality_layer = RealityLayer::Grounded;

    // Vessel is fronting
    system·switch_to("vessel");

    // Co-conscious with Warden (protective)
    system·enable_cocon("warden");
}

/// First observations when arriving at church
pub fn get_arrival_observations(system: &PluralSystem) -> Vec<String>! {
    let mut observations = vec![
        "The air is thick with the smell of decay and forgotten prayers.".to_string(),
    ];

    // Add alter-specific observations
    if let Some(cocon) = system·get_cocon() {
        match cocon.id·as_str() {
            "warden" => {
                observations·push(
                    "[Warden]: Stay alert. Something is watching from the bell tower.".to_string()
                );
            },
            "stolas" => {
                observations·push(
                    "[Stolas]: The architecture... 14th century. But the symbols are wrong.".to_string()
                );
            },
            _ => {},
        }
    }

    observations
}
