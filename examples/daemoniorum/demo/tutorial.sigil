    /* Position classes */
    .tutorial-top-left { top: 1rem; left: 1rem; }
    .tutorial-top-center { top: 1rem; left: 50%; transform: translateX(-50%); }
    .tutorial-top-right { top: 1rem; right: 1rem; }
    .tutorial-center { top: 50%; left: 50%; transform: translate(-50%, -50%); }
    .tutorial-bottom-left { bottom: 1rem; left: 1rem; }
    .tutorial-bottom-center { bottom: 1rem; left: 50%; transform: translateX(-50%); }
    .tutorial-bottom-right { bottom: 1rem; right: 1rem; }
    .tutorial-left { top: 50%; left: 1rem; transform: translateY(-50%); }
    .tutorial-right { top: 50%; right: 1rem; transform: translateY(-50%); }

    .tutorial-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(100,100,150,0.3);
    }

    .tutorial-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        background: linear-gradient(135deg, #6a5acd, #483d8b);
        border-radius: 50%;
        font-weight: bold;
        color: white;
        font-size: 0.875rem;
    }

    .tutorial-title {
        font-family: 'Cinzel', serif;
        font-size: 1rem;
        color: #d0c0f0;
        font-weight: 600;
    }

    .tutorial-content {
        font-family: 'Crimson Text', serif;
        font-size: 0.9375rem;
        color: #b0a0c0;
        line-height: 1.6;
        white-space: pre-line;
    }

    .tutorial-footer {
        margin-top: 0.75rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(100,100,150,0.2);
    }

    .tutorial-dismiss {
        font-family: 'Share Tech Mono', monospace;
        font-size: 0.75rem;
        color: rgba(150,140,180,0.6);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }
"#;

// ============================================================================
// COMBAT TUTORIAL
// ============================================================================

/// Combat tutorial helper
type CombatTutorial = struct {
    /// Current step
    step: CombatTutorialStep!,
    /// Highlighted element
    highlight: Option<String>?,
};

type CombatTutorialStep = enum {
    /// Show enemy info
    EnemyIntro,
    /// Explain actions
    ActionExplain,
    /// First attack
    FirstAttack,
    /// Show damage
    DamageResult,
    /// Enemy turn
    EnemyTurn,
    /// Explain switching
    SwitchExplain,
    /// Victory
    Victory,
    /// Complete
    Complete,
};

impl CombatTutorial {
    pub fn new() -> Self! {
        Self {
            step: CombatTutorialStep::EnemyIntro,
            highlight: None,
        }
    }

    /// Get current tutorial text
    pub fn get_text(self) -> Option<(&'static str, &'static str)>? {
        match self.step {
            CombatTutorialStep::EnemyIntro => Some((
                "Enemy Spotted!",
                "Shadow Crawlers - weak but numerous.\nCheck their health in the enemy panel."
            )),
            CombatTutorialStep::ActionExplain => Some((
                "Choose Your Action",
                "Click an action or press 1-4.\nVessel can STRIKE for damage\nor GROUND to restore stability."
            )),
            CombatTutorialStep::FirstAttack => Some((
                "Attack!",
                "Select STRIKE to attack the enemy.\nWatch the combat log for results."
            )),
            CombatTutorialStep::DamageResult => Some((
                "Hit!",
                "You dealt damage. The enemy's\nhealth bar shows remaining HP."
            )),
            CombatTutorialStep::EnemyTurn => Some((
                "Enemy Turn",
                "The shadows strike back!\nWatch your stability meter."
            )),
            CombatTutorialStep::SwitchExplain => Some((
                "Switch Alters",
                "Press 1-6 to switch alters mid-combat.\nTry switching to Abaddon (2) for\nmore damage, or Beleth (4) to heal."
            )),
            CombatTutorialStep::Victory => Some((
                "Victory!",
                "The shadows disperse.\nYou've mastered the basics of combat."
            )),
            CombatTutorialStep::Complete => None,
        }
    }

    /// Advance to next step
    pub fn advance(mut self) {
        self.step = match self.step {
            CombatTutorialStep::EnemyIntro => CombatTutorialStep::ActionExplain,
            CombatTutorialStep::ActionExplain => CombatTutorialStep::FirstAttack,
            CombatTutorialStep::FirstAttack => CombatTutorialStep::DamageResult,
            CombatTutorialStep::DamageResult => CombatTutorialStep::EnemyTurn,
            CombatTutorialStep::EnemyTurn => CombatTutorialStep::SwitchExplain,
            CombatTutorialStep::SwitchExplain => CombatTutorialStep::Victory,
            CombatTutorialStep::Victory => CombatTutorialStep::Complete,
            CombatTutorialStep::Complete => CombatTutorialStep::Complete,
        };

        // Update highlight
        self.highlight = match self.step {
            CombatTutorialStep::EnemyIntro => Some("enemy-panel".to_string()),
            CombatTutorialStep::ActionExplain => Some("action-panel".to_string()),
            CombatTutorialStep::FirstAttack => Some("action-strike".to_string()),
            CombatTutorialStep::SwitchExplain => Some("alter-bar".to_string()),
            _ => None,
        };
    }

    /// Is tutorial complete
    pub fn is_complete(self) -> bool! {
        matches!(self.step, CombatTutorialStep::Complete)
    }
}

/// Combat tutorial overlay component
#[component]
pub fn CombatTutorialOverlay(tutorial: &CombatTutorial) -> Element! {
    let (title, content) = match tutorial·get_text() {
        Some((t, c)) => (t, c),
        None => return html! {},
    };

    html! {
        <div class="combat-tutorial-overlay">
            <div class="combat-tutorial-popup">
                <div class="combat-tutorial-title">{title}</div>
                <div class="combat-tutorial-content">{content}</div>
                <div class="combat-tutorial-continue">
                    {"Press SPACE to continue"}
                </div>
            </div>

            // Highlight element if any
            {if let Some(ref highlight) = tutorial.highlight {
                html! {
                    <div class={format!("tutorial-highlight highlight-{}", highlight)}></div>
                }
            } else {
                html! {}
            }}
        </div>
    }
}
