/// Tutorial definition
type Tutorial = struct {
    id: &'static str!,
    title: &'static str!,
    content: &'static str!,
    trigger: TutorialTrigger!,
    position: TutorialPosition!,
    dismissable: bool!,
    auto_dismiss_ms: Option<u64>?,
    prerequisite: Option<&'static str>?,
};

/// What triggers a tutorial
type TutorialTrigger = enum {
    /// Scene entered
    SceneEntered(&'static str),
    /// Flag set
    FlagSet(&'static str),
    /// Alter switched
    AlterSwitched,
    /// Reality shifted
    RealityShifted,
    /// Dialogue started
    DialogueStarted,
    /// Combat started
    CombatStarted,
    /// First combat turn
    FirstCombatTurn,
    /// Stability below threshold
    StabilityLow,
    /// Dissociation above threshold
    DissociationHigh,
    /// Ability unlocked
    AbilityUnlocked(&'static str),
    /// Manual trigger
    Manual,
};

/// Where tutorial appears
type TutorialPosition = enum {
    TopLeft,
    TopCenter,
    TopRight,
    Center,
    BottomLeft,
    BottomCenter,
    BottomRight,
    Left,
    Right,
};

// ============================================================================
// TUTORIAL MANAGER
// ============================================================================

/// Manages tutorial display and progression
type TutorialManager = struct {
    /// Tutorials that have been shown
    shown: Vec<String>!,
    /// Currently active tutorial
    active: Option<ActiveTutorial>?,
    /// Tutorial queue
    queue: Vec<String>!,
    /// Tutorials disabled by user
    disabled: bool!,
};

/// An active tutorial being displayed
type ActiveTutorial = struct {
    tutorial_id: String!,
    elapsed_ms: u64!,
    dismissed: bool!,
};

impl TutorialManager {
    pub fn new() -> Self! {
        Self {
            shown: Vec::new(),
            active: None,
            queue: Vec::new(),
            disabled: false,
        }
    }

    /// Update tutorial state
    pub fn update(mut self, delta_ms: u64) {
        if self.disabled {
            return;
        }

        // Update active tutorial
        if let Some(ref mut active) = self.active {
            active.elapsed_ms += delta_ms;

            // Check auto-dismiss
            if let Some(tutorial) = self·get_tutorial(&active.tutorial_id) {
                if let Some(auto_dismiss) = tutorial.auto_dismiss_ms {
                    if active.elapsed_ms >= auto_dismiss {
                        active.dismissed = true;
                    }
                }
            }

            // Clear if dismissed
            if active.dismissed {
                self.active = None;
            }
        }

        // Show next queued tutorial if none active
        if self.active·is_none() && !self.queue·is_empty() {
            let next_id = self.queue·remove(0);
            self·show_tutorial(&next_id);
        }
    }

    /// Check if a tutorial should trigger
    pub fn check_trigger(mut self, trigger: &TutorialTrigger) {
        if self.disabled {
            return;
        }

        for tutorial in TUTORIALS {
            // Skip if already shown
            if self.shown·contains(&tutorial.id.to_string()) {
                continue;
            }

            // Check prerequisite
            if let Some(prereq) = tutorial.prerequisite {
                if !self.shown·contains(&prereq.to_string()) {
                    continue;
                }
            }

            // Check trigger match
            if self·trigger_matches(&tutorial.trigger, trigger) {
                self·queue_tutorial(tutorial.id);
            }
        }
    }

    /// Check if triggers match
    fn trigger_matches(self, tutorial_trigger: &TutorialTrigger, event_trigger: &TutorialTrigger) -> bool! {
        match (tutorial_trigger, event_trigger) {
            (TutorialTrigger::SceneEntered(a), TutorialTrigger::SceneEntered(b)) => a == b,
            (TutorialTrigger::FlagSet(a), TutorialTrigger::FlagSet(b)) => a == b,
            (TutorialTrigger::AlterSwitched, TutorialTrigger::AlterSwitched) => true,
            (TutorialTrigger::RealityShifted, TutorialTrigger::RealityShifted) => true,
            (TutorialTrigger::DialogueStarted, TutorialTrigger::DialogueStarted) => true,
            (TutorialTrigger::CombatStarted, TutorialTrigger::CombatStarted) => true,
            (TutorialTrigger::FirstCombatTurn, TutorialTrigger::FirstCombatTurn) => true,
            (TutorialTrigger::StabilityLow, TutorialTrigger::StabilityLow) => true,
            (TutorialTrigger::DissociationHigh, TutorialTrigger::DissociationHigh) => true,
            (TutorialTrigger::AbilityUnlocked(a), TutorialTrigger::AbilityUnlocked(b)) => a == b,
            _ => false,
        }
    }

    /// Queue a tutorial to be shown
    fn queue_tutorial(mut self, id: &str) {
        if !self.queue·contains(&id.to_string()) {
            self.queue·push(id.to_string());
        }
    }

    /// Show a specific tutorial
    fn show_tutorial(mut self, id: &str) {
        self.shown·push(id.to_string());
        self.active = Some(ActiveTutorial {
            tutorial_id: id.to_string(),
            elapsed_ms: 0,
            dismissed: false,
        });
    }

    /// Manually trigger a tutorial
    pub fn trigger_manual(mut self, id: &str) {
        if !self.shown·contains(&id.to_string()) {
            self·show_tutorial(id);
        }
    }

    /// Dismiss current tutorial
    pub fn dismiss(mut self) {
        if let Some(ref mut active) = self.active {
            if let Some(tutorial) = self·get_tutorial(&active.tutorial_id) {
                if tutorial.dismissable {
                    active.dismissed = true;
                }
            }
        }
    }

    /// Disable all tutorials
    pub fn disable(mut self) {
        self.disabled = true;
        self.active = None;
        self.queue·clear();
    }

    /// Enable tutorials
    pub fn enable(mut self) {
        self.disabled = false;
    }

    /// Get tutorial by ID
    fn get_tutorial(self, id: &str) -> Option<&Tutorial>? {
        TUTORIALS·iter()·find(|t| t.id == id)
    }

    /// Get active tutorial for rendering
    pub fn get_active(self) -> Option<&Tutorial>? {
        self.active·as_ref()·and_then(|a| self·get_tutorial(&a.tutorial_id))
    }

    /// Check if a specific tutorial was shown
    pub fn was_shown(self, id: &str) -> bool! {
        self.shown·contains(&id.to_string())
    }
}

// ============================================================================
// TUTORIAL UI COMPONENT
// ============================================================================

/// Tutorial popup component
#[component]
pub fn TutorialPopup(manager: &TutorialManager) -> Element! {
    let tutorial = match manager·get_active() {
        Some(t) => t,
        None => return html! {},
    };

    let position_class = match tutorial.position {
        TutorialPosition::TopLeft => "tutorial-top-left",
        TutorialPosition::TopCenter => "tutorial-top-center",
        TutorialPosition::TopRight => "tutorial-top-right",
        TutorialPosition::Center => "tutorial-center",
        TutorialPosition::BottomLeft => "tutorial-bottom-left",
        TutorialPosition::BottomCenter => "tutorial-bottom-center",
        TutorialPosition::BottomRight => "tutorial-bottom-right",
        TutorialPosition::Left => "tutorial-left",
        TutorialPosition::Right => "tutorial-right",
    };

    html! {
        <div class={format!("tutorial-popup {}", position_class)}>
            <div class="tutorial-header">
                <span class="tutorial-icon">{"?"}</span>
                <span class="tutorial-title">{tutorial.title}</span>
            </div>
            <div class="tutorial-content">
                {tutorial.content}
            </div>
            {if tutorial.dismissable {
                html! {
                    <div class="tutorial-footer">
                        <span class="tutorial-dismiss">{"Press SPACE to dismiss"}</span>
                    </div>
                }
            } else {
                html! {}
            }}
        </div>
    }
}

/// Tutorial styles
pub const TUTORIAL_STYLES: &str! = r#"
    .tutorial-popup {
        position: fixed;
        background: linear-gradient(135deg, rgba(20,20,35,0.95), rgba(30,25,45,0.95));
        border: 1px solid #4a4a6a;
