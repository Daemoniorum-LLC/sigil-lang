        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        z-index: 900;
        animation: tutorial-fade-in 0.3s ease-out;
    }

    @keyframes tutorial-fade-in {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
