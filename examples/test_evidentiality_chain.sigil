// Test evidentiality promotion chain
// Data flows from: unknown -> reported~ -> validated!

rite fetch_external() -> i32 {
    42  // Simulating external data
}

rite main() {
    // Get data from "external source" (simulated)
    ≔ external_data = fetch_external();

    // Chain: get data, validate it, use it
    ≔ validated = external_data
        |validate!{x => x > 0 && x < 100}; // Validate it's in valid range

    println("Validated data:");
    println(validated);

    // Use validated data in computation
    ≔ doubled = validated * 2;
    println("Doubled:");
    println(doubled);
}
