// =============================================================================
// SIGIL TEST FRAMEWORK - GLYPH EDITION
// =============================================================================
// Optimized for AI agent token efficiency using semantic glyphs.
// Symbols are unambiguous, pattern-matchable, and semantically dense.
// =============================================================================

// --- GLYPH VOCABULARY ---
// Assertion operators (mathematical precision):
//   ≡  equals (deep)       ≢  not equals
//   <  less than           >  greater than
//   ≤  less or equal       ≥  greater or equal
//   ∈  contains            ∉  not contains
//   ≈  approximately       ∼  matches pattern
//   τ  type is             ∅  is empty
//   ⊤  truthy              ⊥  falsy
//   ∃  exists (not null)   ∄  null
//   ⊆  subset of           ⊇  superset of
//   λ  callable            ℓ  length equals
//
// Status glyphs:
//   ✓  pass                ✗  fail
//   ⊘  skip                ◉  verified
//   ◐  tested              ◯  untested
//   ⚠  warning
//
// Record field sigils:
//   @  type/kind           ?  result (bool)
//   →  expected            ←  actual
//   !  message             #  index
//   Δ  duration            ⌚ timestamp

// --- COMPACT ASSERTION RECORD ---
// Fields use single-char sigils for minimal token overhead

≔ _ctx = { t: null, a: [], i: 0, c: {}, s: 0 };

rite _rec(op: string, ok: bool, exp: any, act: any, msg: string) -> map {
    ≔ r = { "@": op, "?": ok, "→": exp, "←": act, "!": msg, "⌚": now(), "#": _ctx.i };
    _ctx.a = push(_ctx.a, r);
    _ctx.i = _ctx.i + 1;
    ⤺ r;
}

// --- ASSERTION GLYPHS ---

// ≡ Deep equality
rite ≡(a: any, b: any) -> map {
    ≔ ok = deep_eq(a, b);
    ⤺ _rec("≡", ok, b, a, ⎇ ok { "≡" } ⎉ { format("{} ≢ {}", [inspect(a), inspect(b)]) });
}

// ≢ Not equal
rite ≢(a: any, b: any) -> map {
    ≔ ok = !deep_eq(a, b);
    ⤺ _rec("≢", ok, b, a, ⎇ ok { "≢" } ⎉ { "≡ (unexpected)" });
}

// < Less than
rite ⊲(a: any, b: any) -> map {  // Using ⊲ since < may conflict
    ≔ ok = compare(a, b) < 0;
    ⤺ _rec("<", ok, b, a, ⎇ ok { "<" } ⎉ { "≮" });
}

// > Greater than
rite ⊳(a: any, b: any) -> map {  // Using ⊳ since > may conflict
    ≔ ok = compare(a, b) > 0;
    ⤺ _rec(">", ok, b, a, ⎇ ok { ">" } ⎉ { "≯" });
}

// ≤ Less or equal
rite ≤(a: any, b: any) -> map {
    ≔ ok = compare(a, b) <= 0;
    ⤺ _rec("≤", ok, b, a, ⎇ ok { "≤" } ⎉ { "≰" });
}

// ≥ Greater or equal
rite ≥(a: any, b: any) -> map {
    ≔ ok = compare(a, b) >= 0;
    ⤺ _rec("≥", ok, b, a, ⎇ ok { "≥" } ⎉ { "≱" });
}

// ∈ Contains / member of
rite ∈(elem: any, coll: any) -> map {
    ≔ ok = ⌥ type_of(coll) {
        "array" => any(coll, rite(x) { deep_eq(x, elem) }),
        "string" => contains(coll, elem),
        "map" => has_key(coll, elem),
        "set" => set_contains(coll, elem),
        _ => false
    };
    ⤺ _rec("∈", ok, coll, elem, ⎇ ok { "∈" } ⎉ { "∉" });
}

// ∉ Not contains
rite ∉(elem: any, coll: any) -> map {
    ≔ r = ∈(elem, coll);
    ⤺ _rec("∉", !r["?"], coll, elem, ⎇ !r["?"] { "∉" } ⎉ { "∈ (unexpected)" });
}

// τ Type check
rite τ(val: any, typ: string) -> map {
    ≔ ok = is_type(val, typ);
    ⤺ _rec("τ", ok, typ, type_of(val), ⎇ ok { format("τ={}", [typ]) } ⎉ { format("τ≠{}", [typ]) });
}

// ⊤ Truthy
rite ⊤(val: any) -> map {
    ≔ ok = is_truthy(val);
    ⤺ _rec("⊤", ok, true, val, ⎇ ok { "⊤" } ⎉ { "⊥" });
}

// ⊥ Falsy
rite ⊥(val: any) -> map {
    ≔ ok = !is_truthy(val);
    ⤺ _rec("⊥", ok, false, val, ⎇ ok { "⊥" } ⎉ { "⊤" });
}

// ∃ Exists (not null)
rite ∃(val: any) -> map {
    ≔ ok = !is_null(val);
    ⤺ _rec("∃", ok, "∃", val, ⎇ ok { "∃" } ⎉ { "∄" });
}

// ∄ Null
rite ∄(val: any) -> map {
    ≔ ok = is_null(val);
    ⤺ _rec("∄", ok, null, val, ⎇ ok { "∄" } ⎉ { "∃" });
}

// ∅ Empty
rite ∅(val: any) -> map {
    ≔ ok = is_empty(val);
    ⤺ _rec("∅", ok, "∅", val, ⎇ ok { "∅" } ⎉ { "¬∅" });
}

// ℓ Length equals
rite ℓ(coll: any, n: int) -> map {
    ≔ actual = len(coll);
    ≔ ok = actual == n;
    ⤺ _rec("ℓ", ok, n, actual, ⎇ ok { format("ℓ={}", [n]) } ⎉ { format("ℓ≠{}", [n]) });
}

// ∼ Regex match
rite ∼(text: string, pattern: string) -> map {
    ≔ ok = !is_null(match_regex(text, pattern));
    ⤺ _rec("∼", ok, pattern, text, ⎇ ok { "∼" } ⎉ { "≁" });
}

// ≈ Approximately equal (for floats)
rite ≈(a: float, b: float, epsilon: float) -> map {
    ≔ ok = abs(a - b) < epsilon;
    ⤺ _rec("≈", ok, b, a, ⎇ ok { "≈" } ⎉ { format("Δ={}", [abs(a - b)]) });
}

// ⊆ Subset
rite ⊆(sub: array, sup: array) -> map {
    ≔ ok = all(sub, rite(x) { any(sup, rite(y) { deep_eq(x, y) }) });
    ⤺ _rec("⊆", ok, sup, sub, ⎇ ok { "⊆" } ⎉ { "⊄" });
}

// ∧ All conditions (AND)
rite ∧(conditions: array) -> map {
    ≔ ok = all(conditions, rite(c) { c["?"] });
    ⤺ _rec("∧", ok, true, conditions, ⎇ ok { "∧" } ⎉ { "¬∧" });
}

// ∨ Any condition (OR)
rite ∨(conditions: array) -> map {
    ≔ ok = any(conditions, rite(c) { c["?"] });
    ⤺ _rec("∨", ok, true, conditions, ⎇ ok { "∨" } ⎉ { "¬∨" });
}

// --- COMPACT TEST RECORD ---

rite _evidence(assertions: array) -> string {
    ≔ n = len(assertions);
    ≔ f = len(filter(assertions, rite(a) { !a["?"] }));
    ⎇ f > 0 { ⤺ "✗" }
    ⎇ n == 0 { ⤺ "◯" }
    ⎇ n < 3 { ⤺ "◐" }
    ⤺ "◉"
}

rite Σ(name: string, f: rite) -> map {  // Σ = test case (sum of assertions)
    _ctx.t = name;
    _ctx.a = [];
    _ctx.i = 0;
    _ctx.c = {};
    _ctx.s = now();

    f();

    ≔ Δ = now() - _ctx.s;
    ≔ fail = filter(_ctx.a, rite(a) { !a["?"] });

    ⤺ {
        "id": uuid(),
        "Σ": name,                          // test name
        "?": len(fail) == 0,                // passed
        "Δ": Δ,                             // duration
        "n": len(_ctx.a),                   // assertion count
        "✓": len(_ctx.a) - len(fail),       // passed count
        "✗": len(fail),                     // failed count
        "◎": _evidence(_ctx.a),             // evidence level
        "a": _ctx.a,                        // assertions
        "!": ⎇ len(fail) > 0 { first(fail)["!"] } ⎉ { null },  // first failure
        "c": _ctx.c                         // context
    };
}

// --- TEST SUITE ---

rite Π(name: string, tests: array) -> map {  // Π = product of tests
    ≔ s = now();
    ≔ results = map(tests, rite(t) { t });  // Already executed
    ≔ Δ = now() - s;

    ≔ pass = filter(results, rite(r) { r["?"] });
    ≔ fail = filter(results, rite(r) { !r["?"] });

    ⤺ {
        "id": uuid(),
        "Π": name,
        "n": len(results),
        "✓": len(pass),
        "✗": len(fail),
        "Δ": Δ,
        "%": ⎇ len(results) > 0 { len(pass) / len(results) } ⎉ { 1.0 },
        "r": results,
        "◎": ⎇ len(fail) > 0 { "✗" } ⎉ { "◉" }
    };
}

// --- CONTEXT ---

rite ⊕(k: string, v: any) { _ctx.c = map_set(_ctx.c, k, v); }  // Add context
rite ⊖(k: string) -> any { ⤺ map_get(_ctx.c, k); }         // Get context

// --- PARAMETERIZED ---

rite ∀Σ(name: string, params: array, f: rite) -> array {  // ∀ = for all params
    ⤺ map(enumerate(params), rite(p) {
        Σ(format("{}[{}]", [name, p.0]), rite() { f(p.1) })
    });
}

// --- PROPERTY TEST ---

rite ⊨(name: string, gen: rite, prop: rite, n: int) -> map {  // ⊨ = satisfies property
    ⤺ Σ(name, rite() {
        ≔ i = 0;
        ⟳ i < n {
            ≔ v = gen();
            ⊕(format("i{}", [i]), v);
            ⊤(prop(v));
            i = i + 1;
        }
    });
}

// --- OUTPUT ---

rite ⎙(result: map) -> string {  // ⎙ = print/output
    ⤺ json_stringify(result);
}

// Minimal summary
rite ∑(suite: map) -> map {
    ⤺ {
        "?": suite["◎"],
        "✓": suite["✓"],
        "✗": suite["✗"],
        "Δ": suite["Δ"],
        "×": map(filter(suite["r"], rite(r) { !r["?"] }), rite(r) { r["Σ"] })
    };
}

// --- EXAMPLE USAGE ---

rite demo() {
    ≔ t1 = Σ("math", rite() {
        ≡(2 + 2, 4);
        ≡(0 + 0, 0);
        ⊲(1, 2);
        ≥(5, 5);
    });

    ≔ t2 = Σ("strings", rite() {
        ≡(upper("hi"), "HI");
        ∈("o", "hello");
        ℓ("test", 4);
        ∼("abc123", "[a-z]+[0-9]+");
    });

    ≔ t3 = Σ("types", rite() {
        τ(42, "int");
        τ("x", "string");
        τ([], "array");
        ∃(42);
        ∄(null);
    });

    ≔ t4 = Σ("collections", rite() {
        ≔ a = [1, 2, 3];
        ℓ(a, 3);
        ∈(2, a);
        ∉(9, a);
        ⊆([1, 2], [1, 2, 3]);
        ¬∅(a);
        ∅([]);
    });

    // Parameterized
    ≔ t5 = ∀Σ("squared≥0", [-2, -1, 0, 1, 2], rite(n) {
        ≥(n * n, 0);
    });

    // Property test
    ≔ t6 = ⊨("add_identity", rite() { rand_int(0, 100) }, rite(n) { n + 0 == n }, 5);

    // Combine all
    ≔ all_tests = flatten([[t1, t2, t3, t4, t6], t5]);
    ≔ suite = Π("demo", all_tests);

    // Output
    println(⎙(∑(suite)));

    ⤺ suite;
}

// --- GLYPH QUICK REFERENCE ---
//
// ASSERTIONS:
//   ≡(a,b)     a equals b
//   ≢(a,b)     a not equals b
//   ⊲(a,b)     a < b
//   ⊳(a,b)     a > b
//   ≤(a,b)     a <= b
//   ≥(a,b)     a >= b
//   ∈(x,c)     x in collection c
//   ∉(x,c)     x not in c
//   τ(v,t)     v has type t
//   ⊤(v)       v is truthy
//   ⊥(v)       v is falsy
//   ∃(v)       v is not null
//   ∄(v)       v is null
//   ∅(c)       c is empty
//   ℓ(c,n)     len(c) == n
//   ∼(s,p)     s matches regex p
//   ≈(a,b,ε)   |a-b| < ε
//   ⊆(a,b)     a subset of b
//   ∧([...])   all pass
//   ∨([...])   any pass
//
// STRUCTURE:
//   Σ(name,fn)         define test
//   Π(name,tests)      define suite
//   ∀Σ(name,params,fn) parameterized test
//   ⊨(name,gen,prop,n) property test
//
// CONTEXT:
//   ⊕(k,v)     set context
//   ⊖(k)       get context
//
// OUTPUT:
//   ⎙(result)  to JSON
//   ∑(suite)   summary
//
// RECORD FIELDS:
//   @  assertion type    ?  passed (bool)
//   →  expected          ←  actual
//   !  message           #  index
//   Δ  duration          ⌚ timestamp
//   Σ  test name         Π  suite name
//   n  count             ◎  evidence
//   c  context           r  results
