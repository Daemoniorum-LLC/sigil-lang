// Comprehensive JIT Benchmark Suite
// Tests features supported by the Cranelift JIT backend

rite fib(n) {
    ⎇ n <= 1 {
        ⤺ n;
    }
    ⤺ fib(n - 1) + fib(n - 2);
}

rite ackermann(m, n) {
    ⎇ m == 0 {
        ⤺ n + 1;
    }
    ⎇ n == 0 {
        ⤺ ackermann(m - 1, 1);
    }
    ⤺ ackermann(m - 1, ackermann(m, n - 1));
}

rite tak(x, y, z) {
    ⎇ y >= x {
        ⤺ z;
    }
    ⤺ tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y));
}

rite gcd(a, b) {
    ≔ temp = 0;
    ⟳ b != 0 {
        temp = b;
        b = a - (a / b) * b;
        a = temp;
    }
    ⤺ a;
}

rite fib_iterative(n) {
    ⎇ n <= 1 {
        ⤺ n;
    }
    ≔ a = 0;
    ≔ b = 1;
    ≔ i = 2;
    ≔ temp = 0;
    ⟳ i <= n {
        temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    ⤺ b;
}

rite main() {
    // Test 1: fib(30) recursive
    ≔ start1 = now();
    ≔ r1 = fib(30);
    ≔ t1 = now() - start1;
    print(t1);
    print(r1);

    // Test 2: fib(35) recursive
    ≔ start2 = now();
    ≔ r2 = fib(35);
    ≔ t2 = now() - start2;
    print(t2);
    print(r2);

    // Test 3: ackermann(3, 7)
    ≔ start3 = now();
    ≔ r3 = ackermann(3, 7);
    ≔ t3 = now() - start3;
    print(t3);
    print(r3);

    // Test 4: tak(18, 12, 6)
    ≔ start4 = now();
    ≔ r4 = tak(18, 12, 6);
    ≔ t4 = now() - start4;
    print(t4);
    print(r4);

    // Test 5: GCD x10k
    ≔ start5 = now();
    ≔ i5 = 0;
    ≔ g5 = 0;
    ⟳ i5 < 10000 {
        g5 = gcd(48 * i5 + 1, 18 * i5 + 1);
        i5 = i5 + 1;
    }
    ≔ t5 = now() - start5;
    print(t5);

    // Test 6: Iterative fib x10k
    ≔ start6 = now();
    ≔ i6 = 0;
    ≔ f6 = 0;
    ⟳ i6 < 10000 {
        f6 = fib_iterative(50);
        i6 = i6 + 1;
    }
    ≔ t6 = now() - start6;
    print(t6);

    // Test 7: Sum 1M integers
    ≔ start7 = now();
    ≔ i7 = 0;
    ≔ sum7 = 0;
    ⟳ i7 < 1000000 {
        sum7 = sum7 + i7;
        i7 = i7 + 1;
    }
    ≔ t7 = now() - start7;
    print(t7);

    // Test 8: Nested loops 1000x1000
    ≔ start8 = now();
    ≔ outer8 = 0;
    ≔ inner8 = 0;
    ≔ count8 = 0;
    ⟳ outer8 < 1000 {
        inner8 = 0;
        ⟳ inner8 < 1000 {
            count8 = count8 + 1;
            inner8 = inner8 + 1;
        }
        outer8 = outer8 + 1;
    }
    ≔ t8 = now() - start8;
    print(t8);

    ⤺ 0;
}
