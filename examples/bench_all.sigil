// Comprehensive benchmark comparing all algorithms

rite fib(n) {
    ⎇ n <= 1 { ⤺ n; }
    ⤺ fib(n - 1) + fib(n - 2);
}

rite ackermann(m, n) {
    ⎇ m == 0 { ⤺ n + 1; }
    ⎇ n == 0 { ⤺ ackermann(m - 1, 1); }
    ⤺ ackermann(m - 1, ackermann(m, n - 1));
}

rite tak(x, y, z) {
    ⎇ y >= x { ⤺ z; }
    ⤺ tak(
        tak(x - 1, y, z),
        tak(y - 1, z, x),
        tak(z - 1, x, y)
    );
}

rite gcd(a, b) {
    ⎇ b == 0 { ⤺ a; }
    ⤺ gcd(b, a - (a / b) * b);
}

rite main() -> i64 {
    print(0);  // Header

    // Test 1: Fibonacci
    ≔ start1 = now();
    ≔ fib35 = fib(35);
    ≔ t1 = now() - start1;
    print(fib35);
    print(t1);

    // Test 2: Ackermann
    ≔ start2 = now();
    ≔ ack = ackermann(3, 7);
    ≔ t2 = now() - start2;
    print(ack);
    print(t2);

    // Test 3: Tak
    ≔ start3 = now();
    ≔ tak_result = tak(18, 12, 6);
    ≔ t3 = now() - start3;
    print(tak_result);
    print(t3);

    // Test 4: GCD x10k
    ≔ start4 = now();
    ≔ i = 0;
    ≔ gcd_result = 0;
    ⟳ i < 10000 {
        gcd_result = gcd(1071, 462);
        i = i + 1;
    }
    ≔ t4 = now() - start4;
    print(gcd_result);
    print(t4);

    0
}
