//! Concurrency with Cultural Metaphors
//! Weaving threads, ancestor voices, water flow.

invoke concurrency·weave·{Thread, Loom}
invoke concurrency·voice·{Channel, Sender, Receiver}
invoke concurrency·flow·{Stream, Source}
invoke concurrency·market·{Actor, Address}
invoke concurrency·dance·{Barrier, Mutex}

// === Async/Await ===

async rite fetch_data(url: str) -> Data~ {
    // Standard await with |await or ⌛
    ≔ response~ = http·get(url)|await
    ≔ data~ = response~|json·parse|await
    data~
}

async rite parallel_fetch() -> [Data~] {
    // Parallel await - all at once
    ≔ (a, b, c) = (
        fetch_data("/api/a"),
        fetch_data("/api/b"),
        fetch_data("/api/c"),
    )|await·all

    [a, b, c]
}

async rite race_fetch() -> Data~ {
    // Race - first to complete wins
    (fetch_fast(), fetch_slow())|await·race
}

async rite with_timeout() -> Data? {
    // Timeout as evidentiality
    fetch_slow()|await·timeout(5·sec)
}

// === Weaving (Threads) ===

rite weave_example() {
    // Spawn a thread (spin a new strand)
    ≔ handle = Thread·spin {
        heavy_computation()
    }

    // Join threads (bring strands together)
    ≔ result = handle|weave·join

    // Loom: manage multiple threads
    ≔ loom = Loom·new()
    ≔ threads = (0..4)|τ{i =>
        loom|spin{ compute_chunk(i) }
    }

    // Gather all results
    ≔ results = threads|weave·gather
}

// === Ancestor Voices (Channels) ===

rite channel_example() {
    // Create channel
    ≔ (send, recv): (Sender<Message>, Receiver<Message>) = Channel·new(100)

    // Send message (speak to ancestors)
    send|voice(Message { data: 42 })

    // Receive message (hear from ancestors)
    ≔ msg? = recv|listen        // Non-blocking
    ≔ msg! = recv|listen·await  // Blocking

    // Close channel (complete the ritual)
    send|silence
}

async rite select_example(a: Receiver<i32>, b: Receiver<str>) {
    // Listen to multiple voices
    ≔ result = select! {
        num = a|listen => handle_number(num),
        text = b|listen => handle_text(text),
        () = timeout(1·sec) => handle_timeout(),
    }
}

// === Water Flow (Streams) ===

async rite stream_example() {
    ≔ events: Stream<Event~> = websocket·connect(url)|stream

    // Stream operators with flow morphemes
    events
        |τ·flow{parse_event}        // Transform each element
        |φ·flow{.is_valid}          // Filter
        |buffer(100)                // Backpressure
        |throttle(10·per_sec)       // Rate limit
        |for_each·await{handle}     // Process each
}

// === Dance (Synchronization) ===

rite sync_example() {
    // Barrier: all dancers must arrive
    ≔ barrier = Barrier·new(num_threads)

    // In each thread:
    do_preparation()
    barrier|gather    // Wait for all
    do_main_work()    // All proceed together

    // Mutex: one dancer at a time
    ≔ shared = Mutex·new(data)
    {
        ≔ guard = shared|hold
        guard|mutate()
    }  // Released when guard drops
}

// === Market (Actors) ===

actor Counter {
    state: i64 = 0

    on Increment(n: i64) {
        self.state += n
    }

    on Decrement(n: i64) {
        self.state -= n
    }

    on GetValue -> i64 {
        self.state
    }
}

async rite actor_example() {
    // Open shop (spawn actor)
    ≔ counter: Address<Counter> = Counter·open()

    // Fire-and-forget messages
    counter|tell(Increment(5))
    counter|tell(Decrement(2))

    // Request-response (negotiate)
    ≔ value = counter|ask(GetValue)|await
    print!("Counter value: {value}")
}

// === Structured Concurrency ===

async rite structured_example() -> (A, B) {
    // All tasks must complete before scope exits
    scope |s| {
        ≔ a = s|spawn{ fetch_a() }
        ≔ b = s|spawn{ fetch_b() }

        // Cancel others if any fails
        s|cancel_on_error

        (a|await, b|await)
    }
}

// === Parallel Iteration ===

rite parallel_iteration() {
    ≔ data = load_large_dataset()

    // Sequential (default)
    data|τ{process}

    // Parallel
    data|par·τ{process}

    // Parallel with limit
    data|par(4)·τ{process}

    // Work stealing (ayni - reciprocal exchange)
    data|par·ayni·τ{process}
}

rite main() {
    // Run async main
    async {
        ≔ data = parallel_fetch()|await
        print!("Fetched {data.len} items")
    }|block_on
}
