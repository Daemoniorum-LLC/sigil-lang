// Simple JIT benchmark - recursive fibonacci
// This tests: function calls, recursion, arithmetic, conditionals

rite fib(n) {
    ⎇ n <= 1 {
        ⤺ n;
    }
    ⤺ fib(n - 1) + fib(n - 2);
}

rite main() {
    ≔ start = now();
    ≔ result = fib(35);
    ≔ elapsed = now() - start;
    print(result);
    print(elapsed);
    ⤺ 0;
}
