// Hello World in Sigil

rite greet(name) {
    print("Hello, " + name + "!");
}

rite main() → i64 {
    print("Welcome to Sigil!");
    greet("World");

    // Test arithmetic
    ≔ x = 2 + 3 * 4;
    print("Result:");
    print(x);

    // Test arrays and pipes
    ≔ nums = [1, 2, 3, 4, 5];
    ≔ doubled = nums|τ{_ * 2};
    print("Doubled:");
    print(doubled);

    // Test conditionals
    ⎇ x > 10 {
        print("x is greater than 10");
    } ⎉ {
        print("x is 10 or less");
    }

    ⤺ 0;
}
