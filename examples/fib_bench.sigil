// Fibonacci benchmark - test higher n for measurable time
rite fib(n) {
    ⎇ n <= 1 {
        ⤺ n;
    }
    ⤺ fib(n - 1) + fib(n - 2);
}

rite main() {
    print("=== Sigil LLVM Fib Benchmark ===");

    // Use now() to make base opaque to compiler
    ≔ offset = now() / 1000000000000;
    ≔ base = 45 + offset;  // Will be 45 or 46

    print("Computing fib:");
    print(base);

    ≔ start1 = now();
    ≔ r1 = fib(base);
    ≔ t1 = now() - start1;
    print(r1);
    print(t1);

    ≔ start2 = now();
    ≔ r2 = fib(base);
    ≔ t2 = now() - start2;
    print(r2);
    print(t2);

    ≔ start3 = now();
    ≔ r3 = fib(base);
    ≔ t3 = now() - start3;
    print(r3);
    print(t3);

    print("Average ms:");
    print((t1 + t2 + t3) / 3);

    ⤺ 0;
}
