// Simple Fibonacci test for accumulator transformation
rite fib(n) {
    ⎇ n <= 1 {
        ⤺ n;
    }
    ⤺ fib(n - 1) + fib(n - 2);
}

rite main() {
    ≔ start = now();
    ≔ result = fib(35);
    ≔ elapsed = now() - start;

    print("Fib(35) result:");
    print(result);
    print("Time (ms):");
    print(elapsed);
    ⤺ 0;
}
