// Sigil Standard Library Demo

rite main() {
    // Math functions
    ≔ x = sqrt(16.0);
    print(x);

    ≔ y = pow(2.0, 10.0);
    print(y);

    // Collection functions
    ≔ nums = [1, 2, 3, 4, 5];
    ≔ total = sum(nums);
    print(total);

    ≔ doubled = nums|τ{_ * 2};
    print(doubled);

    // String functions
    ≔ s = "hello world";
    ≔ upper_s = upper(s);
    print(upper_s);

    // Evidence functions
    ≔ certain = known(42);
    ≔ uncertain_val = uncertain(100);
    print(evidence_of(certain));
    print(evidence_of(uncertain_val));

    // Poly-cultural math (cycles)
    ≔ pitch = octave(14);
    print(pitch);

    ≔ frequency = freq(69);
    print(frequency);

    ⤺ 0;
}
