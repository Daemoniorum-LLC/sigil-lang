// Ackermann benchmark

rite ackermann(m, n) {
    ⎇ m == 0 { ⤺ n + 1; }
    ⎇ n == 0 { ⤺ ackermann(m - 1, 1); }
    ⤺ ackermann(m - 1, ackermann(m, n - 1));
}

rite main() -> i64 {
    // Warm up
    ≔ warm = ackermann(3, 5);
    print(warm);

    // Benchmark ackermann(3,7)
    ≔ start = now();
    ≔ result = ackermann(3, 7);
    ≔ elapsed = now() - start;
    print(result);
    print(elapsed);

    // Try ackermann(3,8) - much harder
    ≔ start2 = now();
    ≔ result2 = ackermann(3, 8);
    ≔ elapsed2 = now() - start2;
    print(result2);
    print(elapsed2);

    0
}
