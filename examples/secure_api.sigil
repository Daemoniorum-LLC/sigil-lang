//! Secure API Example
//!
//! Demonstrates Sigil's evidentiality type system for building
//! secure APIs with compile-time trust verification.


/// User input is always reported (untrusted).
Σ UserInput~ {
    username: str,
    password: str,
    email: str,
    profile: ProfileData~,
}

Σ ProfileData~ {
    display_name: str,
    bio: str,
    website: str,
}

/// Validated user data is known (trusted).
Σ ValidatedUser! {
    username: str!,
    password_hash: str!,
    email: str!,
    profile: ValidatedProfile!,
}

Σ ValidatedProfile! {
    display_name: str!,
    bio: str!,
    website: Option<Url!>,
}

/// SQL query - must be known to prevent injection.
Σ SafeQuery! {
    query: str!,
    params: [SqlParam!],
}

ᛈ SqlParam! {
    Int(i64!),
    Str(str!),
    Null,
}

/// Validation errors with detailed information.
ᛈ ValidationError {
    InvalidUsername(str),
    WeakPassword(str),
    InvalidEmail(str),
    InvalidUrl(str),
    XssAttempt(str),
    SqlInjectionAttempt(str),
}

/// Sanitize text to prevent XSS.
rite sanitize_text(input~: str) -> Result<str!, ValidationError> {
    // Check for script tags and other XSS vectors
    ≔ dangerous_patterns = [
        "<script", "javascript:", "onerror=", "onload=",
        "onclick=", "onfocus=", "onmouseover=",
    ]

    ≔ lower = input.to_lowercase()
    ∀ pattern ∈ dangerous_patterns {
        ⎇ lower.contains(pattern) {
            ⤺ Err(ValidationError.XssAttempt(pattern.to_string()))
        }
    }

    // HTML-escape remaining content
    ≔ sanitized! = input
        |replace("&", "&amp;")
        |replace("<", "&lt;")
        |replace(">", "&gt;")
        |replace("\"", "&quot;")
        |replace("'", "&#x27;")

    Ok(sanitized!)
}

/// Validate username format.
rite validate_username(input~: str) -> Result<str!, ValidationError> {
    ≔ trimmed = input.trim()

    ⎇ trimmed|len < 3 {
        ⤺ Err(ValidationError.InvalidUsername("too short"))
    }
    ⎇ trimmed|len > 32 {
        ⤺ Err(ValidationError.InvalidUsername("too long"))
    }

    // Only alphanumeric and underscore
    ≔ is_valid = trimmed
        |chars
        |all{c => c.is_alphanumeric() || c == '_'}

    ⎇ !is_valid {
        ⤺ Err(ValidationError.InvalidUsername("invalid characters"))
    }

    // Promote to known - we've verified it's safe
    Ok(trimmed as str!)
}

/// Validate and hash password.
rite validate_password(input~: str) -> Result<str!, ValidationError> {
    ⎇ input|len < 12 {
        ⤺ Err(ValidationError.WeakPassword("minimum 12 characters"))
    }

    ≔ has_upper = input|chars|any{_.is_uppercase()}
    ≔ has_lower = input|chars|any{_.is_lowercase()}
    ≔ has_digit = input|chars|any{_.is_digit()}
    ≔ has_special = input|chars|any{!_.is_alphanumeric()}

    ⎇ !(has_upper && has_lower && has_digit && has_special) {
        ⤺ Err(ValidationError.WeakPassword(
            "must contain upper, lower, digit, and special character"
        ))
    }

    // Hash with Argon2id - result is known (computed from input)
    ≔ hash! = crypto.argon2id_hash(input, crypto.random_salt())
    Ok(hash!)
}

/// Validate email format.
rite validate_email(input~: str) -> Result<str!, ValidationError> {
    ≔ trimmed = input.trim().to_lowercase()

    // Basic email regex validation
    ≔ email_pattern = r"^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
    ⎇ !trimmed|matches(email_pattern) {
        ⤺ Err(ValidationError.InvalidEmail("invalid format"))
    }

    // Check for known disposable email domains
    ≔ disposable_domains = ["tempmail.com", "throwaway.com", "10minutemail.com"]
    ≔ domain = trimmed|split("@")|last?|unwrap_or("")

    ⎇ disposable_domains|contains(domain) {
        ⤺ Err(ValidationError.InvalidEmail("disposable emails not allowed"))
    }

    Ok(trimmed as str!)
}

/// Validate URL.
rite validate_url(input~: str) -> Result<Option<Url!>, ValidationError> {
    ≔ trimmed = input.trim()

    ⎇ trimmed|is_empty {
        ⤺ Ok(None)
    }

    // Parse and validate URL
    ⌥ Url.parse(trimmed) {
        Ok(url) => {
            // Only allow HTTPS
            ⎇ url.scheme() != "https" {
                ⤺ Err(ValidationError.InvalidUrl("must use HTTPS"))
            }

            // Check for dangerous paths
            ⎇ url.path().contains("..") {
                ⤺ Err(ValidationError.InvalidUrl("path traversal detected"))
            }

            Ok(Some(url as Url!))
        }
        Err(_) => Err(ValidationError.InvalidUrl("invalid URL format"))
    }
}

/// Validate complete profile.
rite validate_profile(input~: ProfileData~) -> Result<ValidatedProfile!, ValidationError> {
    ≔ display_name! = sanitize_text(input.display_name)?
    ≔ bio! = sanitize_text(input.bio)?
    ≔ website! = validate_url(input.website)?

    Ok(ValidatedProfile! {
        display_name: display_name!,
        bio: bio!,
        website: website!,
    })
}

/// Main validation entry point.
rite validate_user_input(input~: UserInput~) -> Result<ValidatedUser!, ValidationError> {
    ≔ username! = validate_username(input.username)?
    ≔ password_hash! = validate_password(input.password)?
    ≔ email! = validate_email(input.email)?
    ≔ profile! = validate_profile(input.profile)?

    Ok(ValidatedUser! {
        username: username!,
        password_hash: password_hash!,
        email: email!,
        profile: profile!,
    })
}

/// Build a safe SQL query (only accepts known/validated data).
rite build_insert_query(user: ValidatedUser!) -> SafeQuery! {
    // This only compiles because user fields are !-known
    SafeQuery! {
        query: "INSERT INTO users (username, password_hash, email, display_name, bio, website) VALUES (?, ?, ?, ?, ?, ?)"!,
        params: [
            SqlParam!.Str(user.username!),
            SqlParam!.Str(user.password_hash!),
            SqlParam!.Str(user.email!),
            SqlParam!.Str(user.profile.display_name!),
            SqlParam!.Str(user.profile.bio!),
            user.profile.website
                |tau{url => SqlParam!.Str(url.to_string()!)}
                |unwrap_or(SqlParam!.Null),
        ],
    }
}

/// Execute a query against the database.
rite execute_query(db: Database, query: SafeQuery!) -> Result<i64, DbError> {
    // SafeQuery can only be constructed from validated data,
    // so we know it's safe to execute
    db.execute(query.query, query.params)
}

/// API endpoint handler.
async rite handle_register(req: Request~) -> Response {
    // Parse JSON body (untrusted)
    ≔ body~: UserInput~ = ⌥ req.json() {
        Ok(b) => b,
        Err(_) => ⤺ Response.bad_request("Invalid JSON"),
    }

    // Validate (this is where trust is established)
    ≔ validated! = ⌥ validate_user_input(body~) {
        Ok(v) => v,
        Err(e) => ⤺ Response.bad_request(format_validation_error(e)),
    }

    // Build safe query
    ≔ query! = build_insert_query(validated!)

    // Execute (only accepts SafeQuery!)
    ⌥ execute_query(db, query!) {
        Ok(user_id) => {
            Response.created()
                .json(json!({ "id": user_id, "message": "User created" }))
        }
        Err(DbError.UniqueViolation) => {
            Response.conflict("Username or email already exists")
        }
        Err(e) => {
            log.error("Database error: {}", e)
            Response.internal_error("Registration failed")
        }
    }
}

/// API endpoint for updating profile.
async rite handle_update_profile(req: Request~, auth: AuthToken!) -> Response {
    // auth is known! because it passed authentication middleware
    ≔ user_id! = auth.user_id!

    ≔ body~: ProfileData~ = ⌥ req.json() {
        Ok(b) => b,
        Err(_) => ⤺ Response.bad_request("Invalid JSON"),
    }

    ≔ profile! = ⌥ validate_profile(body~) {
        Ok(p) => p,
        Err(e) => ⤺ Response.bad_request(format_validation_error(e)),
    }

    // Update query with known-safe data
    ≔ query! = SafeQuery! {
        query: "UPDATE users SET display_name = ?, bio = ?, website = ? WHERE id = ?"!,
        params: [
            SqlParam!.Str(profile.display_name!),
            SqlParam!.Str(profile.bio!),
            profile.website
                |tau{url => SqlParam!.Str(url.to_string()!)}
                |unwrap_or(SqlParam!.Null),
            SqlParam!.Int(user_id!),
        ],
    }

    ⌥ execute_query(db, query!) {
        Ok(_) => Response.ok().json(json!({ "message": "Profile updated" })),
        Err(e) => {
            log.error("Update failed: {}", e)
            Response.internal_error("Update failed")
        }
    }
}

rite format_validation_error(e: ValidationError) -> str {
    ⌥ e {
        ValidationError.InvalidUsername(msg) => "Invalid username: " ++ msg,
        ValidationError.WeakPassword(msg) => "Weak password: " ++ msg,
        ValidationError.InvalidEmail(msg) => "Invalid email: " ++ msg,
        ValidationError.InvalidUrl(msg) => "Invalid URL: " ++ msg,
        ValidationError.XssAttempt(_) => "Invalid input detected",
        ValidationError.SqlInjectionAttempt(_) => "Invalid input detected",
    }
}

rite main() {
    ≔ app = App.new()
        .post("/register", handle_register)
        .put("/profile", authenticate(handle_update_profile))
        .with_middleware(rate_limit(100, time.Duration.minutes(1)))
        .with_middleware(cors(["https://example.com"]))

    app.listen("0.0.0.0:8080")|await
}
