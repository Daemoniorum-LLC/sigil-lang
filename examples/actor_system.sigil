//! Actor System Example
//!
//! Demonstrates Sigil's actor model for concurrent programming
//! with message passing and state isolation.

invoke std·time
invoke std·sync

/// Messages for the rate limiter actor.
ᛈ RateLimitMsg {
    Request(str, channel<bool>),
    GetStats(channel<RateLimitStats>),
    Reset,
}

/// Rate limit statistics.
Σ RateLimitStats {
    total_requests: i64,
    allowed_requests: i64,
    denied_requests: i64,
    window_start: time.Instant,
}

/// A token bucket rate limiter actor.
actor RateLimiter {
    capacity: i64,
    tokens: f64,
    refill_rate: f64,  // tokens per second
    last_refill: time.Instant,
    stats: RateLimitStats,

    rite new(capacity: i64, refill_rate: f64) -> RateLimiter {
        ≔ now = time.Instant.now()
        RateLimiter {
            capacity,
            tokens: capacity as f64,
            refill_rate,
            last_refill: now,
            stats: RateLimitStats {
                total_requests: 0,
                allowed_requests: 0,
                denied_requests: 0,
                window_start: now,
            },
        }
    }

    rite refill_tokens(mut self) {
        ≔ now = time.Instant.now()
        ≔ elapsed = now.duration_since(self.last_refill).as_secs_f64()
        self.tokens = min(
            self.capacity as f64,
            self.tokens + (elapsed * self.refill_rate)
        )
        self.last_refill = now
    }

    on Request(client_id: str, reply: channel<bool>) {
        self.refill_tokens()
        self.stats.total_requests += 1

        ⎇ self.tokens >= 1.0 {
            self.tokens -= 1.0
            self.stats.allowed_requests += 1
            reply <- true
        } ⎉ {
            self.stats.denied_requests += 1
            reply <- false
        }
    }

    on GetStats(reply: channel<RateLimitStats>) {
        reply <- self.stats
    }

    on Reset {
        self.tokens = self.capacity as f64
        self.stats = RateLimitStats {
            total_requests: 0,
            allowed_requests: 0,
            denied_requests: 0,
            window_start: time.Instant.now(),
        }
    }
}

/// Messages for the cache actor.
ᛈ CacheMsg<K, V> {
    Get(K, channel<Option<V>>),
    Set(K, V, Option<time.Duration>),
    Delete(K),
    Clear,
    Stats(channel<CacheStats>),
}

Σ CacheEntry<V> {
    value: V,
    expires_at: Option<time.Instant>,
}

Σ CacheStats {
    hits: i64,
    misses: i64,
    size: i64,
}

/// A TTL-aware cache actor.
actor Cache<K: Hash + Eq, V: Clone> {
    entries: Map<K, CacheEntry<V>>,
    stats: CacheStats,

    rite new() -> Cache<K, V> {
        Cache {
            entries: Map.new(),
            stats: CacheStats { hits: 0, misses: 0, size: 0 },
        }
    }

    rite cleanup_expired(mut self) {
        ≔ now = time.Instant.now()
        ≔ expired_keys = self.entries
            |phi{(_, entry) => entry.expires_at
                |tau{exp => exp < now}
                |unwrap_or(false)}
            |tau{(k, _) => k}
            |collect

        ∀ key ∈ expired_keys {
            self.entries.remove(key)
        }
        self.stats.size = self.entries|len as i64
    }

    on Get(key: K, reply: channel<Option<V>>) {
        self.cleanup_expired()

        ⌥ self.entries.get(key) {
            Some(entry) => {
                // Check if expired
                ≔ is_valid = entry.expires_at
                    |tau{exp => exp > time.Instant.now()}
                    |unwrap_or(true)

                ⎇ is_valid {
                    self.stats.hits += 1
                    reply <- Some(entry.value.clone())
                } ⎉ {
                    self.entries.remove(key)
                    self.stats.misses += 1
                    reply <- None
                }
            }
            None => {
                self.stats.misses += 1
                reply <- None
            }
        }
    }

    on Set(key: K, value: V, ttl: Option<time.Duration>) {
        ≔ expires_at = ttl|tau{d => time.Instant.now() + d}
        self.entries.insert(key, CacheEntry { value, expires_at })
        self.stats.size = self.entries|len as i64
    }

    on Delete(key: K) {
        self.entries.remove(key)
        self.stats.size = self.entries|len as i64
    }

    on Clear {
        self.entries.clear()
        self.stats.size = 0
    }

    on Stats(reply: channel<CacheStats>) {
        reply <- self.stats
    }
}

/// A worker pool for parallel task execution.
actor WorkerPool<T, R> {
    workers: [Worker<T, R>],
    pending: Queue<(T, channel<R>)>,
    available: Queue<Worker<T, R>>,

    rite new(size: i32, task_fn: rite(T) -> R) -> WorkerPool<T, R> {
        ≔ workers = (0..size)
            |tau{_ => spawn Worker.new(task_fn)}
            |collect

        WorkerPool {
            workers: workers.clone(),
            pending: Queue.new(),
            available: Queue.from_iter(workers),
        }
    }

    on Submit(task: T, reply: channel<R>) {
        ⌥ self.available.pop() {
            Some(worker) => {
                // Worker available, dispatch immediately
                worker <- Execute(task, reply, self)
            }
            None => {
                // Queue for later
                self.pending.push((task, reply))
            }
        }
    }

    on WorkerDone(worker: Worker<T, R>) {
        ⌥ self.pending.pop() {
            Some((task, reply)) => {
                worker <- Execute(task, reply, self)
            }
            None => {
                self.available.push(worker)
            }
        }
    }
}

actor Worker<T, R> {
    task_fn: rite(T) -> R,

    rite new(task_fn: rite(T) -> R) -> Worker<T, R> {
        Worker { task_fn }
    }

    on Execute(task: T, reply: channel<R>, pool: WorkerPool<T, R>) {
        ≔ result = (self.task_fn)(task)
        reply <- result
        pool <- WorkerDone(self)
    }
}

/// Example: Concurrent web scraper.
async rite scrape_urls(urls: [str]) -> [Result<Page, Error>] {
    // Create a worker pool with 10 concurrent workers
    ≔ pool = spawn WorkerPool.new(10, fetch_and_parse)

    // Rate limiter: 100 requests per second
    ≔ limiter = spawn RateLimiter.new(100, 100.0)

    // Cache for already-seen URLs
    ≔ cache: Cache<str, Page> = spawn Cache.new()

    // Process all URLs
    ≔ results = urls
        |tau{url => async {
            // Check cache first
            ≔ (cached_reply, cached_rx) = channel.new()
            cache <- Get(url.clone(), cached_reply)

            ⌥ cached_rx|await {
                Some(page) => Ok(page),
                None => {
                    // Check rate limit
                    ≔ (limit_reply, limit_rx) = channel.new()
                    limiter <- Request(url.clone(), limit_reply)

                    ⎇ !limit_rx|await {
                        ⤺ Err(Error.RateLimited)
                    }

                    // Submit to worker pool
                    ≔ (work_reply, work_rx) = channel.new()
                    pool <- Submit(url.clone(), work_reply)
                    ≔ result = work_rx|await

                    // Cache successful results
                    ⎇ ≔ Ok(page) = &result {
                        cache <- Set(url, page.clone(), Some(time.Duration.minutes(5)))
                    }

                    result
                }
            }
        }}
        |await_all

    // Get final stats
    ≔ (stats_reply, stats_rx) = channel.new()
    limiter <- GetStats(stats_reply)
    ≔ rate_stats = stats_rx|await

    println("Rate limiter stats: {} allowed, {} denied",
        rate_stats.allowed_requests,
        rate_stats.denied_requests)

    results
}

rite main() {
    ≔ urls = [
        "https://example.com/page1",
        "https://example.com/page2",
        "https://example.com/page3",
        // ... more URLs
    ]

    ≔ results = scrape_urls(urls)|await

    ≔ (successes, failures) = results|partition_results

    println("Scraped {} pages successfully, {} failed",
        successes|len,
        failures|len)
}
