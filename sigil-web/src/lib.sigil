/// Testing utilities
#[cfg(test)]
☉ scroll testing {
    invoke tome·core·vdom·VNode;
    invoke tome·components·Component;

    /// Render a component for testing
    ☉ rite render<C: Component>(component: C) -> TestRenderer! {
        TestRenderer {
            root: component·to_vnode()
        }
    }

    /// Test renderer for assertions
    ☉ Σ TestRenderer {
        root: VNode!
    }

    ⊢ TestRenderer {
        /// Find element by test ID
        ☉ rite find_by_test_id(&self, id: &str) -> Option<&VNode>? {
            // Search tree for data-testid attribute
            None
        }

        /// Find all elements matching selector
        ☉ rite find_all(&self, selector: &str) -> Vec<&VNode>! {
            Vec·new()
        }

        /// Get rendered HTML
        ☉ rite to_html(&self) -> String! {
            tome·platform·render_vnode_to_string(&self.root)
        }

        /// Simulate click event
        ☉ rite click(&Δ self, target: &str) {
            // Dispatch click event
        }

        /// Simulate input event
        ☉ rite input(&Δ self, target: &str, value: &str) {
            // Dispatch input event
        }

        /// Wait for async updates
        ☉ async rite wait_for_update(&Δ self) {
            // Wait for pending state updates
        }
    }

    /// Assert component renders expected HTML
    #[macro_export]
    macro_rules! assert_renders {
        ($component:expr, $expected:expr) => {
            ≔ renderer! = render($component)
            assert_eq!(renderer·to_html(), $expected)
        };
    }

    /// Assert element exists
    #[macro_export]
    macro_rules! assert_element {
        ($renderer:expr, $selector:expr) => {
            assert!($renderer·find_all($selector)·len() > 0, "Element not found: {}", $selector)
        };
    }
}
