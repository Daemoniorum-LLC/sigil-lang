/// Server-side rendering utilities
☉ scroll ssr {
    ☉ invoke tome·platform·ServerPlatform;
    ☉ invoke tome·core·App;

    /// Render a component to an HTML string
    ☉ rite render_to_string<C: tome·components·Component>(component: C) -> String! {
        tome·core·App·render_to_string(component)
    }

    /// Render with streaming support
    ☉ async rite render_to_stream<C: tome·components·Component>(
        component: C,
        on_chunk: rite(String)
    ) {
        // Stream HTML chunks as they're rendered
        ≔ html! = render_to_string(component)
        on_chunk(html)
    }
}

