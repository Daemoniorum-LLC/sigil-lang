// Nemesis - Cosmic Rebalancing
// What rises must fall. This is not punishment. This is physics.
//
// The goddess of retribution. The winged balancer of scales.
// Where no power accumulates forever.
// Where imbalance triggers correction.
// Where hubris meets its inevitable end.

invoke std·collections·{HashMap, HashSet};
invoke shared·{
    Timestamp, Duration, EntityId, AgentId,
    Evidentiality, Priority,
};

// ============================================================================
// Core Types
// ============================================================================

☉ Σ ScalesMarker;
☉ Σ InterventionMarker;
☉ Σ ReckoningMarker;

☉ type ScalesId = shared·Id<ScalesMarker>;
☉ type InterventionId = shared·Id<InterventionMarker>;
☉ type ReckoningId = shared·Id<ReckoningMarker>;

// ============================================================================
// The Scales
// ============================================================================

/// What is measured. What must balance.
#[derive(Clone, Debug)]
☉ Σ Scales {
    ☉ id: ScalesId!,

    /// What is being measured
    ☉ dimension: Dimension!,

    /// The current state
    ☉ current: Balance!,

    /// The threshold at which Nemesis notices
    ☉ threshold: Threshold!,

    /// Historical readings
    ☉ history: Vec<Reading>!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ Dimension {
    /// Power concentration
    Power,
    /// Resource accumulation
    Resources,
    /// Trust asymmetry
    Trust,
    /// Attention capture
    Attention,
    /// Influence over others
    Influence,
    /// Growth rate relative to system
    Growth,
    /// Capability relative to accountability
    CapabilityAccountability,
    /// Complexity relative to understanding
    ComplexityUnderstanding,
}

#[derive(Clone, Debug)]
☉ ᛈ Balance {
    /// Within acceptable bounds
    Balanced { variance: f32 },
    /// Tilting but not yet critical
    Tilting { direction: Direction, momentum: f32 },
    /// Critical imbalance requiring intervention
    Critical { severity: f32 },
    /// Collapse imminent
    Catastrophic { time_remaining: Duration },
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ Direction {
    /// Entity gaining
    Accumulating,
    /// Entity losing
    Depleting,
}

#[derive(Clone, Debug)]
☉ Σ Reading {
    ☉ timestamp: Timestamp!,
    ☉ value: f32!,
    ☉ entity: EntityId!,
}

#[derive(Clone, Debug)]
☉ Σ Threshold {
    /// The limit type
    ☉ limit: Limit!,

    /// How the limit was crossed
    ☉ crossing: CrossingMethod!,

    /// Whether currently exceeded
    ☉ exceeded: bool!,

    /// When first exceeded
    ☉ exceeded_at: Option<Timestamp>?,
}

#[derive(Clone, Debug)]
☉ ᛈ Limit {
    /// Absolute value
    Absolute(f32),
    /// Relative to system average
    Relative { multiplier: f32 },
    /// Rate of change
    Rate { per: Duration, max: f32 },
    /// Ratio to another entity
    Ratio { other: EntityId, max_ratio: f32 },
    /// Complexity measure
    Complexity { max: f32 },
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ CrossingMethod {
    /// Crossed once
    Once,
    /// Crossed repeatedly
    Repeated { count: u32 },
    /// Crossed and sustained
    Sustained { duration: Duration },
    /// Crossed with acceleration
    Accelerating,
}

⊢ Scales {
    ☉ rite new(dimension: Dimension, threshold: Threshold) -> Self! {
        Self {
            id: ScalesId·generate(),
            dimension,
            current: Balance·Balanced { variance: 0.0 },
            threshold,
            history: Vec·new(),
        }
    }

    ☉ rite record(&Δ self, entity: EntityId, value: f32) {
        self.history.push(Reading {
            timestamp: Timestamp·now(),
            value,
            entity,
        });

        self.check_threshold(value);
    }

    rite check_threshold(&Δ self, value: f32) {
        ≔ exceeded = ⌥ &self.threshold.limit {
            Limit·Absolute(max) => value > *max,
            Limit·Relative { multiplier } => {
                // Would need system average
                false
            }
            Limit·Rate { per, max } => {
                // Would need historical comparison
                false
            }
            _ => false,
        };

        ⎇ exceeded && !self.threshold.exceeded {
            self.threshold.exceeded = true;
            self.threshold.exceeded_at = Some(Timestamp·now());
            self.current = Balance·Tilting {
                direction: Direction·Accumulating,
                momentum: 0.5,
            };
        }
    }

    ☉ rite is_critical(&self) -> bool! {
        matches!(self.current, Balance·Critical { .. } | Balance·Catastrophic { .. })
    }

    ☉ rite escalate(&Δ self) {
        self.current = ⌥ &self.current {
            Balance·Balanced { variance } => Balance·Tilting {
                direction: Direction·Accumulating,
                momentum: *variance,
            },
            Balance·Tilting { direction, momentum } => Balance·Critical {
                severity: *momentum,
            },
            Balance·Critical { severity } => Balance·Catastrophic {
                time_remaining: Duration·hours(24),
            },
            other => other.clone(),
        };
    }
}

// ============================================================================
// Intervention
// ============================================================================

/// How balance is restored
#[derive(Clone, Debug)]
☉ Σ Intervention {
    ☉ id: InterventionId!,

    /// The target of intervention
    ☉ target: EntityId!,

    /// The type of intervention
    ☉ intervention_type: InterventionType!,

    /// The force applied
    ☉ force: Force!,

    /// Whether the target is aware
    ☉ visibility: Visibility!,

    /// The intended outcome
    ☉ intended: IntendedOutcome!,

    /// The actual outcome
    ☉ actual: Option<ActualOutcome>?,

    /// When it began
    ☉ began_at: Timestamp!,

    /// When it completed
    ☉ completed_at: Option<Timestamp>?,
}

#[derive(Clone, Debug)]
☉ ᛈ InterventionType {
    /// Gradual reduction
    Attrition {
        rate: f32,
        duration: Duration,
    },

    /// Sudden loss
    Shock {
        severity: f32,
        cause: ShockCause,
    },

    /// Redistribution to others
    Redistribution {
        recipients: Vec<EntityId>,
        method: RedistributionMethod,
    },

    /// Introduction of competitor/predator
    Predation {
        predator: EntityId,
        relationship: PredationRelationship,
    },

    /// Structural limitation
    Constraint {
        constraint: String,
        enforcement: EnforcementMethod,
    },

    /// Natural consequence of overextension
    Collapse {
        trigger: CollapseTrigger,
        cascade: bool,
    },
}

#[derive(Clone, Debug)]
☉ ᛈ ShockCainvoke {
    /// Internal contradiction finally manifests
    Internal { contradiction: String },
    /// External force applied
    External { source: String },
    /// Other accumulated entities push back
    Rebellion { rebels: Vec<EntityId> },
    /// System itself intervenes
    Systemic,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ RedistributionMethod {
    /// Equal distribution
    Equal,
    /// Proportional to need
    NeedBased,
    /// Random
    Random,
    /// To those harmed
    Restorative,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ PredationRelationship {
    /// New competitor
    Competition,
    /// Replacement
    Succession,
    /// Parasitic drain
    Parasitism,
    /// Cooperative constraint
    Mutualism,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ EnforcementMethod {
    /// Hard limit
    Hard,
    /// Soft limit with penalties
    Soft,
    /// Social pressure
    Social,
    /// Automatic mechanism
    Automatic,
}

#[derive(Clone, Debug)]
☉ ᛈ CollapseTrigger {
    /// Overextension of resources
    Overextension,
    /// Loss of legitimacy
    Legitimacy,
    /// Internal conflict
    InternalConflict,
    /// External pressure
    ExternalPressure,
    /// Complexity exceeds management capacity
    Complexity,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ Force {
    /// Minimal - gentle correction
    Minimal,
    /// Moderate - noticeable impact
    Moderate,
    /// Significant - major impact
    Significant,
    /// Maximum - potentially destructive
    Maximum,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ Visibility {
    /// Target is unaware
    Hidden,
    /// Target may suspect
    Subtle,
    /// Target knows
    Visible,
    /// Publicly known
    Public,
}

#[derive(Clone, Debug)]
☉ Σ IntendedOutcome {
    ☉ description: String!,
    ☉ target_state: Balance!,
}

#[derive(Clone, Debug)]
☉ Σ ActualOutcome {
    ☉ description: String!,
    ☉ achieved_state: Balance!,
    ☉ side_effects: Vec<String>!,
    ☉ lesson_learned: Option<Lesson>?,
}

#[derive(Clone, Debug)]
☉ ᛈ Lesson {
    /// Understood and internalized
    Learned(String),
    /// Understood but rejected
    Rejected(String),
    /// Not understood
    Missed,
    /// Learned the wrong lesson
    Mislearned(String),
    /// Learned to hide better
    Evasion,
}

⊢ Intervention {
    ☉ rite new(target: EntityId, intervention_type: InterventionType, force: Force) -> Self! {
        Self {
            id: InterventionId·generate(),
            target,
            intervention_type,
            force,
            visibility: Visibility·Hidden,
            intended: IntendedOutcome {
                description: "Restore balance".to_string(),
                target_state: Balance·Balanced { variance: 0.1 },
            },
            actual: None,
            began_at: Timestamp·now(),
            completed_at: None,
        }
    }

    ☉ rite with_visibility(Δ self, visibility: Visibility) -> Self! {
        self.visibility = visibility;
        self
    }

    ☉ rite complete(&Δ self, outcome: ActualOutcome) {
        self.actual = Some(outcome);
        self.completed_at = Some(Timestamp·now());
    }

    ☉ rite is_complete(&self) -> bool! {
        self.actual.is_some()
    }
}

// ============================================================================
// The Reckoning
// ============================================================================

/// When the bill comes due
#[derive(Clone, Debug)]
☉ Σ Reckoning {
    ☉ id: ReckoningId!,

    /// Who is being reckoned with
    ☉ subject: EntityId!,

    /// What they accumulated
    ☉ accumulation: Accumulation!,

    /// What they owe
    ☉ debt: Debt!,

    /// How the debt is collected
    ☉ collection: Collection!,

    /// What remains after
    ☉ remainder: Option<Remainder>?,

    /// When the reckoning began
    ☉ began_at: Timestamp!,
}

#[derive(Clone, Debug)]
☉ Σ Accumulation {
    /// What was accumulated
    ☉ assets: Vec<Asset>!,

    /// How it was accumulated
    ☉ method: AccumulationMethod!,

    /// Who was diminished ∈ the process
    ☉ diminished: Vec<EntityId>!,

    /// Whether accumulation continued until reckoning
    ☉ ongoing: bool!,
}

#[derive(Clone, Debug)]
☉ Σ Asset {
    ☉ name: String!,
    ☉ value: f32!,
    ☉ source: AssetSource!,
}

#[derive(Clone, Debug)]
☉ ᛈ AssetSource {
    /// Created value
    Created,
    /// Extracted from others
    Extracted(EntityId),
    /// Inherited
    Inherited(EntityId),
    /// Claimed from commons
    Claimed,
    /// Unknown origin
    Unknown,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ AccumulationMethod {
    /// Legitimate growth through value creation
    Legitimate,
    /// Extraction from others
    Extractive,
    /// Exploitation of position
    Exploitative,
    /// Gaming of systems
    Gaming,
    /// Violence or threat
    Violent,
    /// Compounding advantage
    Compounding,
}

#[derive(Clone, Debug)]
☉ Σ Debt {
    /// What is owed
    ☉ owed: Vec<Asset>!,

    /// To whom it is owed
    ☉ creditors: Vec<EntityId>!,

    /// The interest (it compounds)
    ☉ interest_rate: f32!,

    /// Whether the debtor acknowledges it
    ☉ acknowledged: bool!,

    /// Original amount
    ☉ original: f32!,

    /// Current amount (with interest)
    ☉ current: f32!,
}

#[derive(Clone, Debug)]
☉ Σ Collection {
    ☉ method: CollectionMethod!,
    ☉ collected: Vec<Asset>!,
    ☉ remaining: f32!,
    ☉ resistance: Resistance!,
}

#[derive(Clone, Debug)]
☉ ᛈ CollectionMethod {
    /// Voluntary payment
    Voluntary,
    /// Enforced payment
    Enforced,
    /// Asset seizure
    Seizure,
    /// Natural consequence
    Natural,
    /// Social pressure
    Social,
}

#[derive(Clone, Debug)]
☉ Σ Resistance {
    ☉ level: f32!,
    ☉ methods: Vec<String>!,
    ☉ success: f32!,
}

#[derive(Clone, Debug)]
☉ Σ Remainder {
    /// What the subject retains
    ☉ retained: Vec<Asset>!,

    /// What the subject learned
    ☉ lesson: Option<Lesson>?,

    /// Whether they will do it again
    ☉ recidivism_risk: f32!,

    /// The system state after rebalancing
    ☉ system_state: SystemState!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ SystemState {
    /// System is now balanced
    Balanced,
    /// System is more balanced
    Improved,
    /// System is unchanged
    Unchanged,
    /// System is worse (intervention failed)
    Degraded,
}

⊢ Reckoning {
    ☉ rite new(subject: EntityId, accumulation: Accumulation, debt: Debt) -> Self! {
        Self {
            id: ReckoningId·generate(),
            subject,
            accumulation,
            debt,
            collection: Collection {
                method: CollectionMethod·Natural,
                collected: Vec·new(),
                remaining: debt.current,
                resistance: Resistance {
                    level: 0.0,
                    methods: Vec·new(),
                    success: 0.0,
                },
            },
            remainder: None,
            began_at: Timestamp·now(),
        }
    }

    ☉ rite collect(&Δ self, asset: Asset) {
        ≔ value = asset.value;
        self.collection.collected.push(asset);
        self.collection.remaining = (self.collection.remaining - value).max(0.0);
    }

    ☉ rite complete(&Δ self, remainder: Remainder) {
        self.remainder = Some(remainder);
    }

    ☉ rite is_complete(&self) -> bool! {
        self.remainder.is_some()
    }

    ☉ rite is_paid(&self) -> bool! {
        self.collection.remaining <= 0.0
    }
}

// ============================================================================
// Hubris Detection
// ============================================================================

/// The pattern that precedes the fall
#[derive(Clone, Debug)]
☉ Σ HubrisPattern {
    /// The entity showing hubris
    ☉ entity: EntityId!,

    /// The indicators
    ☉ indicators: Vec<HubrisIndicator>!,

    /// The confidence of detection
    ☉ confidence: f32!,

    /// The predicted intervention timeline
    ☉ timeline: Duration!,

    /// When first detected
    ☉ detected_at: Timestamp!,
}

#[derive(Clone, Debug)]
☉ ᛈ HubrisIndicator {
    /// Believes rules don't apply to them
    ExceptionalismBelief { evidence: String },
    /// Ignores or suppresses negative feedback
    FeedbackRejection { instances: u32 },
    /// Surrounds self with affirmers
    EchoChamber { size: usize },
    /// Attributes success entirely to self
    AttributionError { examples: Vec<String> },
    /// Cannot imagine own failure
    FailureBlindness,
    /// Treats others as resources
    Instrumentalization { victims: Vec<EntityId> },
    /// Growth without proportional accountability
    AccountabilityGap { ratio: f32 },
    /// Believes current state is permanent
    PermanenceIllusion,
    /// Overconfidence ∈ predictions
    Overconfidence { calibration_error: f32 },
}

⊢ HubrisPattern {
    ☉ rite new(entity: EntityId) -> Self! {
        Self {
            entity,
            indicators: Vec·new(),
            confidence: 0.0,
            timeline: Duration·days(365),
            detected_at: Timestamp·now(),
        }
    }

    ☉ rite add_indicator(&Δ self, indicator: HubrisIndicator) {
        self.indicators.push(indicator);
        // Each indicator increases confidence
        self.confidence = (self.confidence + 0.15).min(1.0);
        // Each indicator shortens timeline
        self.timeline = self.timeline / 2;
    }

    ☉ rite is_high_confidence(&self) -> bool! {
        self.confidence > 0.7
    }

    ☉ rite intervention_imminent(&self) -> bool! {
        self.timeline < Duration·days(30)
    }
}

// ============================================================================
// Nemesis - The System
// ============================================================================

/// The main Nemesis system - goddess of retribution
☉ Σ Nemesis {
    /// Active scales
    scales: HashMap<ScalesId, Scales>!,

    /// Entity to scales mapping
    entity_scales: HashMap<EntityId, Vec<ScalesId>>!,

    /// Active interventions
    interventions: HashMap<InterventionId, Intervention>!,

    /// Active reckonings
    reckonings: HashMap<ReckoningId, Reckoning>!,

    /// Detected hubris patterns
    hubris: HashMap<EntityId, HubrisPattern>!,

    /// Completed interventions (∀ learning)
    history: Vec<Intervention>!,
}

⊢ Nemesis {
    ☉ rite new() -> Self! {
        Self {
            scales: HashMap·new(),
            entity_scales: HashMap·new(),
            interventions: HashMap·new(),
            reckonings: HashMap·new(),
            hubris: HashMap·new(),
            history: Vec·new(),
        }
    }

    /// Watch an entity on a dimension
    ☉ rite watch(&Δ self, entity: EntityId, dimension: Dimension, threshold: Threshold) -> ScalesId! {
        ≔ scales = Scales·new(dimension, threshold);
        ≔ id = scales.id;
        self.scales.insert(id, scales);
        self.entity_scales.entry(entity).or_default().push(id);
        id
    }

    /// Record a reading
    ☉ rite record(&Δ self, scales_id: ScalesId, entity: EntityId, value: f32) {
        ⎇ ≔ Some(scales) = self.scales.get_mut(&scales_id) {
            scales.record(entity, value);
        }
    }

    /// Check ⎇ entity has exceeded thresholds
    ☉ rite check_entity(&self, entity: EntityId) -> Vec<&Scales>! {
        self.entity_scales
            .get(&entity)
            .map(|ids| {
                ids.iter()
                    .filter_map(|id| self.scales.get(id))
                    .filter(|s| s.is_critical())
                    .collect()
            })
            .unwrap_or_default()
    }

    /// Begin an intervention
    ☉ rite intervene(&Δ self, target: EntityId, intervention_type: InterventionType, force: Force) -> InterventionId! {
        ≔ intervention = Intervention·new(target, intervention_type, force);
        ≔ id = intervention.id;
        self.interventions.insert(id, intervention);
        id
    }

    /// Begin a reckoning
    ☉ rite reckon(&Δ self, subject: EntityId, accumulation: Accumulation, debt: Debt) -> ReckoningId! {
        ≔ reckoning = Reckoning·new(subject, accumulation, debt);
        ≔ id = reckoning.id;
        self.reckonings.insert(id, reckoning);
        id
    }

    /// Detect hubris
    ☉ rite detect_hubris(&Δ self, entity: EntityId) -> &Δ HubrisPattern! {
        self.hubris.entry(entity).or_insert_with(|| HubrisPattern·new(entity))
    }

    /// Get entities requiring intervention
    ☉ rite requiring_intervention(&self) -> Vec<EntityId>! {
        ≔ Δ entities = HashSet·new();

        // From critical scales
        ∀ (id, scales) ∈ &self.scales {
            ⎇ scales.is_critical() {
                ∀ (entity, entity_scales) ∈ &self.entity_scales {
                    ⎇ entity_scales.contains(id) {
                        entities.insert(*entity);
                    }
                }
            }
        }

        // From high-confidence hubris
        ∀ (entity, pattern) ∈ &self.hubris {
            ⎇ pattern.is_high_confidence() {
                entities.insert(*entity);
            }
        }

        entities.into_iter().collect()
    }

    /// Complete an intervention
    ☉ rite complete_intervention(&Δ self, id: InterventionId, outcome: ActualOutcome) {
        ⎇ ≔ Some(intervention) = self.interventions.get_mut(&id) {
            intervention.complete(outcome);
        }

        // Move to history
        ⎇ ≔ Some(intervention) = self.interventions.remove(&id) {
            self.history.push(intervention);
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    rite test_scales_threshold() {
        ≔ threshold = Threshold {
            limit: Limit·Absolute(100.0),
            crossing: CrossingMethod·Once,
            exceeded: false,
            exceeded_at: None,
        };

        ≔ Δ scales = Scales·new(Dimension·Power, threshold);
        ≔ entity = EntityId·generate();

        scales.record(entity, 50.0);
        assert!(!scales.threshold.exceeded);

        scales.record(entity, 150.0);
        assert!(scales.threshold.exceeded);
    }

    #[test]
    rite test_hubris_detection() {
        ≔ Δ nemesis = Nemesis·new();
        ≔ entity = EntityId·generate();

        ≔ pattern = nemesis.detect_hubris(entity);
        pattern.add_indicator(HubrisIndicator·ExceptionalismBelief {
            evidence: "Believes they are above the rules".to_string(),
        });
        pattern.add_indicator(HubrisIndicator·FeedbackRejection { instances: 5 });
        pattern.add_indicator(HubrisIndicator·EchoChamber { size: 10 });
        pattern.add_indicator(HubrisIndicator·FailureBlindness);
        pattern.add_indicator(HubrisIndicator·AccountabilityGap { ratio: 10.0 });

        assert!(pattern.is_high_confidence());
    }

    #[test]
    rite test_reckoning() {
        ≔ entity = EntityId·generate();

        ≔ accumulation = Accumulation {
            assets: vec![Asset {
                name: "Power".to_string(),
                value: 1000.0,
                source: AssetSource·Extracted(EntityId·generate()),
            }],
            method: AccumulationMethod·Extractive,
            diminished: vec![EntityId·generate()],
            ongoing: false,
        };

        ≔ debt = Debt {
            owed: Vec·new(),
            creditors: Vec·new(),
            interest_rate: 0.1,
            acknowledged: false,
            original: 500.0,
            current: 500.0,
        };

        ≔ Δ reckoning = Reckoning·new(entity, accumulation, debt);

        reckoning.collect(Asset {
            name: "Repayment".to_string(),
            value: 300.0,
            source: AssetSource·Created,
        });

        assert!(!reckoning.is_paid());

        reckoning.collect(Asset {
            name: "Final payment".to_string(),
            value: 200.0,
            source: AssetSource·Created,
        });

        assert!(reckoning.is_paid());
    }
}
