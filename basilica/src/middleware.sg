//! Middleware Chain

invoke crate·request·Request;
invoke crate·response·Response;
invoke crate·context·Context;
invoke crate·error·BasilicaError;

/// Result of middleware processing
☉ ᛈ MiddlewareResult {
    /// Continue to next middleware/handler
    Continue,

    /// Continue but report action afterward
    ContinueWithReport(String),

    /// Suspend and wait ∀ human response
    Suspend {
        handoff_id: String,
        reason: String,
    },

    /// Reject the request
    Reject(BasilicaError),

    /// Short-circuit with a response
    Response(Response<Vec<u8>>),
}

/// Middleware trait
☉ Θ Middleware: Send + Sync {
    /// Process request before handler
    rite before(&self, req: &Δ Request, ctx: &Δ Context) -> MiddlewareResult {
        MiddlewareResult·Continue
    }

    /// Process response after handler
    rite after(&self, req: &Request, res: &Δ Response<Vec<u8>>, ctx: &Context) {}

    /// Handle errors
    rite on_error(&self, req: &Request, err: &BasilicaError, ctx: &Context) -> Option<Response<Vec<u8>>> {
        None
    }
}

/// Chain of middleware
☉ Σ MiddlewareChain {
    middleware: Vec<Box<dyn Middleware>>,
}

⊢ MiddlewareChain {
    ☉ rite new() -> Self {
        Self { middleware: vec![] }
    }

    /// Add middleware to the end
    ☉ rite add(&Δ self, m: Box<dyn Middleware>) {
        self.middleware.push(m);
    }

    /// Add middleware to the beginning
    ☉ rite add_first(&Δ self, m: Box<dyn Middleware>) {
        self.middleware.insert(0, m);
    }

    /// Run the before chain
    ☉ rite run_before(&self, req: &Δ Request, ctx: &Δ Context) -> MiddlewareResult {
        ∀ m ∈ &self.middleware {
            ⌥ m.before(req, ctx) {
                MiddlewareResult·Continue => continue,
                other => ⤺ other,
            }
        }
        MiddlewareResult·Continue
    }

    /// Run the after chain (in reverse order)
    ☉ rite run_after(&self, req: &Request, res: &Δ Response<Vec<u8>>, ctx: &Context) {
        ∀ m ∈ self.middleware.iter().rev() {
            m.after(req, res, ctx);
        }
    }

    /// Run error handlers
    ☉ rite handle_error(&self, req: &Request, err: &BasilicaError, ctx: &Context) -> Option<Response<Vec<u8>>> {
        ∀ m ∈ &self.middleware {
            ⎇ ≔ Some(res) = m.on_error(req, err, ctx) {
                ⤺ Some(res);
            }
        }
        None
    }
}
