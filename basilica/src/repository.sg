//! Repository - Data Access with Morphemes

invoke crate·query·{Query, QueryResult, QueryParam, Filter, CompareOp};
invoke crate·evidence·{Evidenced, HttpEvidence, EvidenceLevel};
invoke crate·error·{BasilicaError, BasilicaResult};
invoke shared·{Timestamp, Value};

/// Trait ∀ repository implementations
☉ Θ Repository<T>: Send + Sync {
    /// The ID type ∀ this entity
    type Id;

    /// Find by ID
    rite find(&self, id: Self·Id) -> BasilicaResult<Option<Evidenced<T>>>;

    /// Find all
    rite find_all(&self) -> BasilicaResult<Vec<Evidenced<T>>>;

    /// Save (insert or update)
    rite save(&self, entity: &T) -> BasilicaResult<Evidenced<T>>;

    /// Delete by ID
    rite delete(&self, id: Self·Id) -> BasilicaResult<bool>;

    /// Execute a query
    rite query(&self, query: Query<T>) -> BasilicaResult<QueryResult<T>>;

    /// Count all
    rite count(&self) -> BasilicaResult<usize> {
        Ok(self.find_all()?.len())
    }

    /// Check ⎇ exists
    rite exists(&self, id: Self·Id) -> BasilicaResult<bool> {
        Ok(self.find(id)?.is_some())
    }
}

/// Base implementation ∀ PostgreSQL repositories
☉ Σ PostgresRepository<T> {
    /// Table name
    table: String,

    /// ID column name
    id_column: String,

    /// Connection pool (placeholder)
    _marker: std·marker·PhantomData<T>,
}

⊢<T> PostgresRepository<T> {
    ☉ rite new(table: &str) -> Self {
        Self {
            table: table.to_string(),
            id_column: "id".to_string(),
            _marker: std·marker·PhantomData,
        }
    }

    ☉ rite with_id_column(Δ self, column: &str) -> Self {
        self.id_column = column.to_string();
        self
    }

    /// Create a query builder ∀ this table
    ☉ rite query_builder(&self) -> Query<T> {
        Query·from(&self.table)
    }
}

/// Macro ∀ defining repositories with morpheme queries
#[macro_export]
macro_rules! repository {
    (
        $name:ident ∀ $entity:ty {
            table: $table:literal,
            $(
                rite $method:ident($($arg:ident: $arg_ty:ty),*) -> $ret:ty $body:block
            )*
        }
    ) => {
        ☉ Σ $name {
            inner: PostgresRepository<$entity>,
        }

        ⊢ $name {
            ☉ rite new() -> Self {
                Self {
                    inner: PostgresRepository·new($table),
                }
            }

            $(
                ☉ rite $method(&self, $($arg: $arg_ty),*) -> $ret $body
            )*
        }
    };
}
