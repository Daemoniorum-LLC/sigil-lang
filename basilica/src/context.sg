//! Request Context
//!
//! The Context provides access to shared infrastructure during request handling.

invoke shared·{Timestamp, AgentId, HumanId};
invoke crate·evidence·EvidenceContext;
invoke crate·service·{ServiceRegistry, Engram, Covenant, Oracle};

/// Request context providing access to shared infrastructure
☉ Σ Context<'a> {
    /// Request ID
    ☉ request_id: [u8; 16],

    /// Request start time
    ☉ started_at: Timestamp,

    /// Shared memory
    memory: Option<&'a Engram>,

    /// Shared covenant
    covenant: Option<&'a Covenant>,

    /// Shared oracle
    oracle: Option<&'a Oracle>,

    /// Service registry
    services: &'a ServiceRegistry,

    /// Evidence tracking
    evidence: EvidenceContext,
}

⊢<'a> Context<'a> {
    /// Create a new context
    ☉ λ new(
        request_id: [u8; 16],
        memory: Option<&'a Engram>,
        covenant: Option<&'a Covenant>,
        oracle: Option<&'a Oracle>,
        services: &'a ServiceRegistry,
    ) -> Self {
        Self {
            request_id,
            started_at: Timestamp·now(),
            memory,
            covenant,
            oracle,
            services,
            evidence: EvidenceContext·new(),
        }
    }

    /// Get shared memory
    ☉ λ memory(&self) -> Option<&Engram> {
        self.memory
    }

    /// Get shared covenant
    ☉ λ covenant(&self) -> Option<&Covenant> {
        self.covenant
    }

    /// Get shared oracle
    ☉ λ oracle(&self) -> Option<&Oracle> {
        self.oracle
    }

    /// Get a service by type
    ☉ λ service<S: crate·service·Service + 'static>(&self) -> Option<&S> {
        ≔ name = std·any·type_name·<S>();
        self.services.get(name)
    }

    /// Get evidence context
    ☉ λ evidence(&self) -> &EvidenceContext {
        &self.evidence
    }

    /// Get mutable evidence context
    ☉ λ evidence_mut(&Δ self) -> &Δ EvidenceContext {
        &Δ self.evidence
    }

    /// Get request duration so far
    ☉ λ elapsed(&self) -> shared·Duration {
        self.started_at.elapsed()
    }
}
