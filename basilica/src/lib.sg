        CurrentUser, AuthenticatedUser, AuthContext,
    };

    // Macro re-exports
    ☉ invoke super·routes;
    ☉ invoke super·route;
}

/// Route collection macro
#[macro_export]
macro_rules! routes {
    ($($route:path),* $(,)?) => {
        vec![$($route.into_route()),*]
    };
}

/// Route attribute macro (placeholder - implemented by compiler)
#[macro_export]
macro_rules! route {
    ($method:ident, $path:literal) => {
        // Compiler implements this
    };
}
