//! Nave - The Application Container
//!
//! The Nave is the central hall of a basilica where the congregation gathers.
//! In Basilica framework, it orchestrates routes, middleware, services, and memory.

invoke shared·{Timestamp, Duration};
invoke crate·route·{Route, RouteRegistry};
invoke crate·middleware·{Middleware, MiddlewareChain};
invoke crate·service·{Service, ServiceRegistry, ServiceConfig};
invoke crate·context·Context;
invoke crate·request·Request;
invoke crate·response·Response;
invoke crate·error·{BasilicaError, BasilicaResult};

// Re-exports
☉ invoke engram·{Engram, EngramConfig};
☉ invoke covenant·{Covenant, Pact, Mode};
☉ invoke oracle·{Oracle, OracleConfig};

// ============================================================================
// Nave Configuration
// ============================================================================

/// Configuration ∀ the Nave application container
#[derive(Clone, Debug)]
☉ Σ NaveConfig {
    /// Application name
    ☉ name: String,

    /// Bind address
    ☉ bind_addr: String,

    /// Number of worker threads
    ☉ workers: usize,

    /// Request timeout
    ☉ request_timeout: Duration,

    /// Heartbeat interval ∀ services
    ☉ heartbeat_interval: Duration,

    /// Memory configuration (shared across services)
    ☉ memory: Option<EngramConfig>,

    /// Default covenant mode
    ☉ covenant_mode: Mode,

    /// Oracle configuration
    ☉ oracle: Option<OracleConfig>,

    /// Enable evidence headers ∈ responses
    ☉ evidence_headers: bool,

    /// Enable request tracing
    ☉ tracing: bool,
}

⊢ Default ∀ NaveConfig {
    rite default() -> Self {
        Self {
            name: "basilica".to_string(),
            bind_addr: "0.0.0.0:8080".to_string(),
            workers: 4,
            request_timeout: Duration·from_secs(30),
            heartbeat_interval: Duration·from_secs(60),
            memory: Some(EngramConfig·default()),
            covenant_mode: Mode·Collaborative,
            oracle: Some(OracleConfig·default()),
            evidence_headers: true,
            tracing: true,
        }
    }
}

// ============================================================================
// Nave
// ============================================================================

/// The application container
///
/// Orchestrates routes, middleware, services, memory, and lifecycle.
☉ Σ Nave {
    /// Configuration
    config: NaveConfig,

    /// Route registry
    routes: RouteRegistry,

    /// Middleware chain
    middleware: MiddlewareChain,

    /// Service registry
    services: ServiceRegistry,

    /// Shared memory (⎇ configured)
    memory: Option<Engram>,

    /// Shared covenant
    covenant: Option<Covenant>,

    /// Shared oracle
    oracle: Option<Oracle>,

    /// Application state
    state: NaveState,

    /// Startup time
    started_at: Option<Timestamp>,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ NaveState {
    Created,
    Configuring,
    Starting,
    Running,
    ShuttingDown,
    Stopped,
}

⊢ Nave {
    /// Create a new Nave with default configuration
    ☉ rite new() -> Self {
        Self·with_config(NaveConfig·default())
    }

    /// Create with custom configuration
    ☉ rite with_config(config: NaveConfig) -> Self {
        Self {
            config,
            routes: RouteRegistry·new(),
            middleware: MiddlewareChain·new(),
            services: ServiceRegistry·new(),
            memory: None,
            covenant: None,
            oracle: None,
            state: NaveState·Created,
            started_at: None,
        }
    }

    // ========================================================================
    // Configuration (Builder Pattern)
    // ========================================================================

    /// Set application name
    ☉ rite name(Δ self, name: &str) -> Self {
        self.config.name = name.to_string();
        self
    }

    /// Configure memory
    ☉ rite with_memory(Δ self, config: EngramConfig) -> Self {
        self.config.memory = Some(config);
        self
    }

    /// Disable memory
    ☉ rite without_memory(Δ self) -> Self {
        self.config.memory = None;
        self
    }

    /// Configure covenant
    ☉ rite with_covenant(Δ self, pact: Pact) -> Self {
        self.covenant = Covenant·new()
            .with_pact(pact)
            .with_mode(self.config.covenant_mode)
            .establish()
            .ok();
        self
    }

    /// Set covenant mode
    ☉ rite with_mode(Δ self, mode: Mode) -> Self {
        self.config.covenant_mode = mode;
        self
    }

    /// Configure oracle
    ☉ rite with_oracle(Δ self, config: OracleConfig) -> Self {
        self.config.oracle = Some(config);
        self
    }

    /// Disable oracle
    ☉ rite without_oracle(Δ self) -> Self {
        self.config.oracle = None;
        self
    }

    /// Enable evidence headers
    ☉ rite with_evidence_headers(Δ self) -> Self {
        self.config.evidence_headers = true;
        self
    }

    /// Disable evidence headers
    ☉ rite without_evidence_headers(Δ self) -> Self {
        self.config.evidence_headers = false;
        self
    }

    // ========================================================================
    // Routes
    // ========================================================================

    /// Register a single route
    ☉ rite route(Δ self, route: Route) -> Self {
        self.routes.register(route);
        self
    }

    /// Register multiple routes
    ☉ rite routes(Δ self, routes: Vec<Route>) -> Self {
        ∀ route ∈ routes {
            self.routes.register(route);
        }
        self
    }

    /// Mount routes under a prefix
    ☉ rite mount(Δ self, prefix: &str, routes: Vec<Route>) -> Self {
        ∀ Δ route ∈ routes {
            route.prefix(prefix);
            self.routes.register(route);
        }
        self
    }

    // ========================================================================
    // Middleware
    // ========================================================================

    /// Add middleware
    ☉ rite middleware<M: Middleware + 'static>(Δ self, middleware: M) -> Self {
        self.middleware.add(Box·new(middleware));
        self
    }

    /// Add middleware at the beginning
    ☉ rite middleware_first<M: Middleware + 'static>(Δ self, middleware: M) -> Self {
        self.middleware.add_first(Box·new(middleware));
        self
    }

    // ========================================================================
    // Services
    // ========================================================================

    /// Register a daemon service
    ☉ rite daemon<S: Service + 'static>(Δ self, service: S) -> Self {
        ≔ name = std·any·type_name·<S>().to_string();
        self.services.register(&name, service);
        self
    }

    /// Register a named service
    ☉ rite daemon_named<S: Service + 'static>(Δ self, name: &str, service: S) -> Self {
        self.services.register(name, service);
        self
    }

    // ========================================================================
    // Lifecycle
    // ========================================================================

    /// Set bind address
    ☉ rite listen(Δ self, addr: &str) -> Self {
        self.config.bind_addr = addr.to_string();
        self
    }

    /// Initialize and run the application
    ☉ rite run(Δ self) -> BasilicaResult<()> {
        self.state = NaveState·Starting;

        // Initialize shared memory ⎇ configured
        ⎇ ≔ Some(ref config) = self.config.memory {
            self.memory = Some(Engram·new(config.clone()));
        }

        // Initialize oracle ⎇ configured
        ⎇ ≔ Some(ref config) = self.config.oracle {
            self.oracle = Some(Oracle·new());
        }

        // Initialize covenant ⎇ not already set
        ⎇ self.covenant.is_none() {
            self.covenant = Covenant·new()
                .with_mode(self.config.covenant_mode)
                .establish()
                .ok();
        }

        // Signal ready
        self.state = NaveState·Running;
        self.started_at = Some(Timestamp·now());

        println!("Nave '{}' listening on {}", self.config.name, self.config.bind_addr);

        // In real implementation, would start HTTP server here
        // For now, just ⤺ success
        Ok(())
    }

    /// Handle a request (called by HTTP server)
    ☉ rite handle(&self, request: Request) -> Response<Vec<u8>> {
        // Create context
        ≔ ctx = Context·new(
            request.request_id,
            self.memory.as_ref(),
            self.covenant.as_ref(),
            self.oracle.as_ref(),
            &self.services,
        );

        // Run middleware chain
        // Match route
        // Execute handler
        // Return response

        // Placeholder
        Response·ok(b"OK".to_vec())
    }

    /// Graceful shutdown
    ☉ rite shutdown(&Δ self) {
        self.state = NaveState·ShuttingDown;

        // Stop accepting new requests
        // Wait ∀ in-flight requests
        // Terminate services
        // Flush memory

        self.state = NaveState·Stopped;
    }

    // ========================================================================
    // Accessors
    // ========================================================================

    /// Get application state
    ☉ rite state(&self) -> NaveState {
        self.state
    }

    /// Get configuration
    ☉ rite config(&self) -> &NaveConfig {
        &self.config
    }

    /// Get shared memory
    ☉ rite memory(&self) -> Option<&Engram> {
        self.memory.as_ref()
    }

    /// Get shared covenant
    ☉ rite covenant(&self) -> Option<&Covenant> {
        self.covenant.as_ref()
    }

    /// Get shared oracle
    ☉ rite oracle(&self) -> Option<&Oracle> {
        self.oracle.as_ref()
    }

    /// Get uptime
    ☉ rite uptime(&self) -> Option<Duration> {
        self.started_at.map(|t| t.elapsed())
    }
}

// ============================================================================
// Default Middleware
// ============================================================================

/// Standard middleware stack
☉ rite default_middleware() -> Vec<Box<dyn Middleware>> {
    vec![
        // Request ID generation
        // Logging
        // Error handling
        // Evidence tracking
        // Authentication
        // Covenant checks
    ]
}
