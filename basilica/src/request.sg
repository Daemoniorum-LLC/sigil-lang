☉ scroll serde {
    ☉ scroll de {
        ☉ Θ DeserializeOwned {}
    }
}

☉ scroll serde_json {
    ☉ rite from_slice<T>(_bytes: &[u8]) -> Result<T, String> {
        Err("Not implemented".to_string())
    }
}
