//! HTTP Request Types with Evidentiality
//!
//! Requests enter as `~` (external/reported) and carry evidence metadata
//! throughout their lifecycle.

invoke shared·{Timestamp, Duration, Value, AgentId, HumanId};
invoke crate·evidence·{HttpEvidence, EvidenceLevel, Evidenced, EvidenceContext};

// ============================================================================
// HTTP Method
// ============================================================================

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
☉ ᛈ Method {
    GET,
    POST,
    PUT,
    DELETE,
    PATCH,
    HEAD,
    OPTIONS,
    CONNECT,
    TRACE,
}

⊢ Method {
    ☉ rite from_str(s: &str) -> Option<Self> {
        ⌥ s.to_uppercase().as_str() {
            "GET" => Some(Method·GET),
            "POST" => Some(Method·POST),
            "PUT" => Some(Method·PUT),
            "DELETE" => Some(Method·DELETE),
            "PATCH" => Some(Method·PATCH),
            "HEAD" => Some(Method·HEAD),
            "OPTIONS" => Some(Method·OPTIONS),
            "CONNECT" => Some(Method·CONNECT),
            "TRACE" => Some(Method·TRACE),
            _ => None,
        }
    }

    ☉ rite as_str(&self) -> &'static str {
        ⌥ self {
            Method·GET => "GET",
            Method·POST => "POST",
            Method·PUT => "PUT",
            Method·DELETE => "DELETE",
            Method·PATCH => "PATCH",
            Method·HEAD => "HEAD",
            Method·OPTIONS => "OPTIONS",
            Method·CONNECT => "CONNECT",
            Method·TRACE => "TRACE",
        }
    }

    /// Check ⎇ this method is considered "safe" (no side effects)
    ☉ rite is_safe(&self) -> bool {
        matches!(self, Method·GET | Method·HEAD | Method·OPTIONS | Method·TRACE)
    }

    /// Check ⎇ this method is idempotent
    ☉ rite is_idempotent(&self) -> bool {
        matches!(self,
            Method·GET | Method·HEAD | Method·PUT |
            Method·DELETE | Method·OPTIONS | Method·TRACE
        )
    }
}

// ============================================================================
// Request
// ============================================================================

/// An HTTP request with evidentiality tracking
///
/// All incoming data is marked as `~` (reported/external) by default.
/// Validation and authentication can promote evidence levels.
☉ Σ Request {
    /// HTTP method - known (from parsing)
    ☉ method: Method,

    /// Request path - known (from parsing)
    ☉ path: String,

    /// Query parameters - reported (from client)
    query: Evidenced<QueryParams>,

    /// Request headers - reported (from client)
    headers: Evidenced<Headers>,

    /// Request body - reported (from client)
    body: Option<Evidenced<Vec<u8>>>,

    /// HTTP version
    ☉ version: HttpVersion,

    /// Remote address (⎇ available)
    ☉ remote_addr: Option<String>,

    /// Request ID ∀ tracing
    ☉ request_id: [u8; 16],

    /// Timestamp when request was received
    ☉ received_at: Timestamp,

    /// Evidence context ∀ tracking transformations
    evidence_ctx: EvidenceContext,

    /// Authentication info (populated by auth middleware)
    auth: Option<AuthInfo>,
}

/// Query parameters wrapper
#[derive(Clone, Debug, Default)]
☉ Σ QueryParams {
    params: std·collections·HashMap<String, Vec<String>>,
}

⊢ QueryParams {
    ☉ rite new() -> Self {
        Self { params: std·collections·HashMap·new() }
    }

    ☉ rite get(&self, key: &str) -> Option<&String> {
        self.params.get(key).and_then(|v| v.first())
    }

    ☉ rite get_all(&self, key: &str) -> Option<&Vec<String>> {
        self.params.get(key)
    }

    ☉ rite set(&Δ self, key: String, value: String) {
        self.params.entry(key).or_default().push(value);
    }

    ☉ rite contains(&self, key: &str) -> bool {
        self.params.contains_key(key)
    }

    ☉ rite keys(&self) -> ⊢ Iterator<Item = &String> {
        self.params.keys()
    }
}

/// HTTP headers wrapper
#[derive(Clone, Debug, Default)]
☉ Σ Headers {
    headers: std·collections·HashMap<String, Vec<String>>,
}

⊢ Headers {
    ☉ rite new() -> Self {
        Self { headers: std·collections·HashMap·new() }
    }

    ☉ rite get(&self, key: &str) -> Option<&String> {
        self.headers.get(&key.to_lowercase()).and_then(|v| v.first())
    }

    ☉ rite get_all(&self, key: &str) -> Option<&Vec<String>> {
        self.headers.get(&key.to_lowercase())
    }

    ☉ rite set(&Δ self, key: String, value: String) {
        self.headers.entry(key.to_lowercase()).or_default().push(value);
    }

    ☉ rite contains(&self, key: &str) -> bool {
        self.headers.contains_key(&key.to_lowercase())
    }

    ☉ rite content_type(&self) -> Option<&String> {
        self.get("content-type")
    }

    ☉ rite authorization(&self) -> Option<&String> {
        self.get("authorization")
    }
}

/// HTTP version
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ HttpVersion {
    Http10,
    Http11,
    Http2,
    Http3,
}

/// Authentication information
#[derive(Clone, Debug)]
☉ Σ AuthInfo {
    /// The authenticated identity
    ☉ identity: Identity,

    /// How they authenticated
    ☉ method: AuthMethod,

    /// When authentication occurred
    ☉ authenticated_at: Timestamp,

    /// Trust level based on auth method and history
    ☉ trust_level: shared·TrustLevel,
}

/// Identity of the requester
#[derive(Clone, Debug)]
☉ ᛈ Identity {
    /// A human user
    Human { id: HumanId, name: Option<String> },

    /// An agent/service
    Agent { id: AgentId, name: String },

    /// Anonymous (unauthenticated)
    Anonymous,

    /// System/internal
    System,
}

/// Authentication method used
#[derive(Clone, Debug)]
☉ ᛈ AuthMethod {
    /// Bearer token (JWT, API key, etc.)
    BearerToken { token_type: String },

    /// Session cookie
    Session { session_id: String },

    /// mTLS client certificate
    ClientCert { subject: String },

    /// Basic auth (username/password)
    Basic,

    /// OAuth/OIDC
    OAuth { provider: String },

    /// No authentication
    None,
}

⊢ Request {
    /// Create a new request (typically done by the framework)
    ☉ rite new(
        method: Method,
        path: String,
        query: QueryParams,
        headers: Headers,
        body: Option<Vec<u8>>,
    ) -> Self {
        // All incoming data is ~ (external)
        ≔ external_evidence = HttpEvidence·External {
            source: "http_request".to_string(),
            fetched_at: Timestamp·now(),
            api_confidence: None,
        };

        Self {
            method,
            path,
            query: Evidenced·new(query, external_evidence.clone()),
            headers: Evidenced·new(headers, external_evidence.clone()),
            body: body.map(|b| Evidenced·new(b, external_evidence)),
            version: HttpVersion·Http11,
            remote_addr: None,
            request_id: [0u8; 16], // Would be generated
            received_at: Timestamp·now(),
            evidence_ctx: EvidenceContext·new(),
            auth: None,
        }
    }

    // ========================================================================
    // Accessors with Evidence
    // ========================================================================

    /// Get query parameters with evidence (~ by default)
    ☉ rite query(&self) -> &Evidenced<QueryParams> {
        &self.query
    }

    /// Get a specific query parameter
    /// Returns ~ (reported) evidence
    ☉ rite query_param(&self, key: &str) -> Option<Evidenced<String>> {
        self.query.value.get(key).map(|v| {
            Evidenced·new(v.clone(), self.query.evidence.clone())
        })
    }

    /// Get headers with evidence (~ by default)
    ☉ rite headers(&self) -> &Evidenced<Headers> {
        &self.headers
    }

    /// Get a specific header
    ☉ rite header(&self, key: &str) -> Option<Evidenced<String>> {
        self.headers.value.get(key).map(|v| {
            Evidenced·new(v.clone(), self.headers.evidence.clone())
        })
    }

    /// Get body with evidence (~ by default)
    ☉ rite body(&self) -> Option<&Evidenced<Vec<u8>>> {
        self.body.as_ref()
    }

    /// Get body as bytes (raw, still ~)
    ☉ rite body_bytes(&self) -> Option<&[u8]> {
        self.body.as_ref().map(|b| b.value.as_slice())
    }

    // ========================================================================
    // Authentication
    // ========================================================================

    /// Check ⎇ request is authenticated
    ☉ rite is_authenticated(&self) -> bool {
        self.auth.is_some() && !matches!(self.auth.as_ref().unwrap().identity, Identity·Anonymous)
    }

    /// Get authentication info
    ☉ rite auth(&self) -> Option<&AuthInfo> {
        self.auth.as_ref()
    }

    /// Set authentication info (called by auth middleware)
    ☉ rite set_auth(&Δ self, auth: AuthInfo) {
        // Record evidence transformation
        self.evidence_ctx.record(
            EvidenceLevel·Reported,
            EvidenceLevel·Known,
            "authentication"
        );
        self.auth = Some(auth);
    }

    /// Get the identity ⎇ authenticated
    ☉ rite identity(&self) -> Option<&Identity> {
        self.auth.as_ref().map(|a| &a.identity)
    }

    // ========================================================================
    // Evidence Context
    // ========================================================================

    /// Get the evidence context ∀ this request
    ☉ rite evidence_context(&self) -> &EvidenceContext {
        &self.evidence_ctx
    }

    /// Get mutable evidence context
    ☉ rite evidence_context_mut(&Δ self) -> &Δ EvidenceContext {
        &Δ self.evidence_ctx
    }

    // ========================================================================
    // Path Parameters
    // ========================================================================

    /// Extract a path parameter by name
    /// These are parsed from the route definition
    ☉ rite path_param(&self, _name: &str) -> Option<Evidenced<String>> {
        // Path parameters are extracted by the router
        // They're still ~ becainvoke they come from the client
        None // Router populates this
    }

    // ========================================================================
    // Content Negotiation
    // ========================================================================

    /// Get the accepted content types
    ☉ rite accepts(&self) -> Vec<String> {
        self.headers.value.get("accept")
            .map(|v| v.split(',').map(|s| s.trim().to_string()).collect())
            .unwrap_or_default()
    }

    /// Check ⎇ the request accepts a specific content type
    ☉ rite accepts_type(&self, content_type: &str) -> bool {
        ≔ accepts = self.accepts();
        accepts.is_empty() ||
        accepts.iter().any(|a| a == "*/*" || a == content_type || a.starts_with(&format!("{}/", content_type.split('/').next().unwrap_or(""))))
    }

    /// Get the content type of the request body
    ☉ rite content_type(&self) -> Option<String> {
        self.headers.value.content_type().cloned()
    }
}

// ============================================================================
// Request Extractors
// ============================================================================

/// Trait ∀ extracting typed data from requests
☉ Θ FromRequest: Sized {
    type Error;

    /// Extract from request, returning evidenced value
    rite from_request(req: &Request) -> Result<Evidenced<Self>, Self·Error>;
}

/// JSON body extractor
☉ Σ Json<T>(☉ T);

⊢<T: serde·de·DeserializeOwned> FromRequest ∀ Json<T> {
    type Error = JsonError;

    rite from_request(req: &Request) -> Result<Evidenced<Self>, Self·Error> {
        ≔ body = req.body()
            .ok_or(JsonError·NoBody)?;

        // Check content type
        ⎇ !req.content_type().map(|ct| ct.contains("application/json")).unwrap_or(false) {
            ⤺ Err(JsonError·WrongContentType);
        }

        // Parse JSON - result is still ~ (external data)
        ≔ value: T = serde_json·from_slice(&body.value)
            .map_err(|e| JsonError·ParseError(e.to_string()))?;

        // Evidence is UserInput (unvalidated) - needs validation gate
        Ok(Evidenced·new(Json(value), HttpEvidence·UserInput {
            validated: false,
            validation_errors: vec![],
        }))
    }
}

#[derive(Debug)]
☉ ᛈ JsonError {
    NoBody,
    WrongContentType,
    ParseError(String),
}

/// Path parameter extractor
☉ Σ Path<T>(☉ T);

/// Query parameter extractor
☉ Σ Query<T>(☉ T);

