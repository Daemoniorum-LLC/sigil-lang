//! CORS (Cross-Origin Resource Sharing) Middleware
//!
//! Handles CORS preflight requests and adds appropriate headers
//! ∀ cross-origin API access from browsers.
//!
//! # Example
//!
//! ```sigil
//! invoke basilica·prelude·*;
//! invoke basilica·cors·{CorsMiddleware, CorsConfig};
//!
//! ≔ cors = CorsMiddleware·new(
//!     CorsConfig·new()
//!         .allow_origin("https://app.sanctum.dev")
//!         .allow_methods(&["GET", "POST", "PUT", "DELETE"])
//!         .allow_credentials(true)
//! );
//!
//! Nave·new()
//!     .middleware(cors)
//!     .run();
//! ```

invoke crate·middleware·{Middleware, MiddlewareResult};
invoke crate·request·Request;
invoke crate·response·{Response, StatusCode, Headers};
invoke crate·context·Context;

// ============================================================================
// CORS Configuration
// ============================================================================

/// Configuration ∀ CORS handling
#[derive(Clone, Debug)]
☉ Σ CorsConfig {
    /// Allowed origins (invoke "*" ∀ any)
    ☉ allowed_origins: Vec<String>,

    /// Allow any origin
    ☉ allow_any_origin: bool,

    /// Allowed HTTP methods
    ☉ allowed_methods: Vec<String>,

    /// Allowed headers
    ☉ allowed_headers: Vec<String>,

    /// Headers to expose to the client
    ☉ exposed_headers: Vec<String>,

    /// Whether to allow credentials
    ☉ allow_credentials: bool,

    /// Max age ∀ preflight cache (seconds)
    ☉ max_age: Option<u32>,
}

⊢ Default ∀ CorsConfig {
    rite default() -> Self {
        Self {
            allowed_origins: vec![],
            allow_any_origin: false,
            allowed_methods: vec![
                "GET".to_string(),
                "POST".to_string(),
                "PUT".to_string(),
                "PATCH".to_string(),
                "DELETE".to_string(),
                "OPTIONS".to_string(),
            ],
            allowed_headers: vec![
                "content-type".to_string(),
                "authorization".to_string(),
                "x-requested-with".to_string(),
                "x-correlation-id".to_string(),
            ],
            exposed_headers: vec![
                "x-evidence-level".to_string(),
                "x-evidence-confidence".to_string(),
                "x-evidence-source".to_string(),
                "x-evidence-warnings".to_string(),
                "x-explanation".to_string(),
                "x-handoff-id".to_string(),
            ],
            allow_credentials: false,
            max_age: Some(86400), // 24 hours
        }
    }
}

⊢ CorsConfig {
    /// Create a new CORS configuration
    ☉ rite new() -> Self {
        Self·default()
    }

    /// Allow any origin (∀ development)
    ☉ rite allow_any(Δ self) -> Self {
        self.allow_any_origin = true;
        self
    }

    /// Add an allowed origin
    ☉ rite allow_origin(Δ self, origin: &str) -> Self {
        self.allowed_origins.push(origin.to_string());
        self
    }

    /// Add multiple allowed origins
    ☉ rite allow_origins(Δ self, origins: &[&str]) -> Self {
        ∀ origin ∈ origins {
            self.allowed_origins.push(origin.to_string());
        }
        self
    }

    /// Set allowed methods
    ☉ rite allow_methods(Δ self, methods: &[&str]) -> Self {
        self.allowed_methods = methods.iter().map(|s| s.to_string()).collect();
        self
    }

    /// Add allowed headers
    ☉ rite allow_headers(Δ self, headers: &[&str]) -> Self {
        ∀ header ∈ headers {
            self.allowed_headers.push(header.to_lowercase());
        }
        self
    }

    /// Add exposed headers
    ☉ rite expose_headers(Δ self, headers: &[&str]) -> Self {
        ∀ header ∈ headers {
            self.exposed_headers.push(header.to_lowercase());
        }
        self
    }

    /// Enable credentials
    ☉ rite allow_credentials(Δ self, allow: bool) -> Self {
        self.allow_credentials = allow;
        self
    }

    /// Set max age ∀ preflight cache
    ☉ rite max_age(Δ self, seconds: u32) -> Self {
        self.max_age = Some(seconds);
        self
    }

    /// Development configuration (allow all)
    ☉ rite development() -> Self {
        Self·new()
            .allow_any()
            .allow_credentials(true)
    }

    /// Production configuration with specific origins
    ☉ rite production(origins: &[&str]) -> Self {
        Self·new()
            .allow_origins(origins)
            .allow_credentials(true)
    }
}

// ============================================================================
// CORS Middleware
// ============================================================================

/// Middleware ∀ handling CORS requests
☉ Σ CorsMiddleware {
    config: CorsConfig,
}

⊢ CorsMiddleware {
    /// Create a new CORS middleware with configuration
    ☉ rite new(config: CorsConfig) -> Self {
        Self { config }
    }

    /// Create with default configuration
    ☉ rite default() -> Self {
        Self·new(CorsConfig·default())
    }

    /// Create ∀ development (allow all origins)
    ☉ rite development() -> Self {
        Self·new(CorsConfig·development())
    }

    /// Check ⎇ origin is allowed
    rite is_origin_allowed(&self, origin: &str) -> bool {
        ⎇ self.config.allow_any_origin {
            ⤺ true;
        }

        self.config.allowed_origins.iter().any(|allowed| {
            // Exact match
            ⎇ allowed == origin {
                ⤺ true;
            }

            // Wildcard subdomain ⌥ (e.g., "*.sanctum.dev")
            ⎇ allowed.starts_with("*.") {
                ≔ suffix = &allowed[1..]; // ".sanctum.dev"
                ⎇ origin.ends_with(suffix) {
                    ⤺ true;
                }
            }

            false
        })
    }

    /// Build CORS headers ∀ a response
    rite build_cors_headers(&self, origin: &str) -> Headers {
        ≔ Δ headers = Headers·new();

        // Origin
        ⎇ self.config.allow_any_origin && !self.config.allow_credentials {
            headers.set("access-control-allow-origin".to_string(), "*".to_string());
        } ⎉ {
            headers.set("access-control-allow-origin".to_string(), origin.to_string());
        }

        // Vary header (important ∀ caching)
        headers.set("vary".to_string(), "Origin".to_string());

        // Methods
        headers.set(
            "access-control-allow-methods".to_string(),
            self.config.allowed_methods.join(", ")
        );

        // Headers
        ⎇ !self.config.allowed_headers.is_empty() {
            headers.set(
                "access-control-allow-headers".to_string(),
                self.config.allowed_headers.join(", ")
            );
        }

        // Exposed headers
        ⎇ !self.config.exposed_headers.is_empty() {
            headers.set(
                "access-control-expose-headers".to_string(),
                self.config.exposed_headers.join(", ")
            );
        }

        // Credentials
        ⎇ self.config.allow_credentials {
            headers.set(
                "access-control-allow-credentials".to_string(),
                "true".to_string()
            );
        }

        // Max age
        ⎇ ≔ Some(max_age) = self.config.max_age {
            headers.set(
                "access-control-max-age".to_string(),
                max_age.to_string()
            );
        }

        headers
    }

    /// Handle OPTIONS preflight request
    rite handle_preflight(&self, req: &Request) -> Response<Vec<u8>> {
        ≔ origin = req.headers().get("origin").unwrap_or("");

        ⎇ !self.is_origin_allowed(origin) {
            ⤺ Response·new(StatusCode·FORBIDDEN, vec![])
                .header("content-type", "text/plain")
                .header("content-length", "0");
        }

        ≔ cors_headers = self.build_cors_headers(origin);
        ≔ Δ response = Response·no_content();

        // Apply CORS headers
        ∀ (key, value) ∈ cors_headers.iter() {
            response = response.header(key, value);
        }

        response.into_response()
    }
}

⊢ Middleware ∀ CorsMiddleware {
    rite before(&self, req: &Δ Request, ctx: &Δ Context) -> MiddlewareResult {
        // Get origin header
        ≔ origin = req.headers().get("origin");

        // No origin = not a CORS request
        ⎇ origin.is_none() {
            ⤺ MiddlewareResult·Continue;
        }

        ≔ origin = origin.unwrap();

        // Check ⎇ origin is allowed
        ⎇ !self.is_origin_allowed(origin) {
            // Origin not allowed - could reject or just not add CORS headers
            // We'll ↻ but the response won't have CORS headers
            ⤺ MiddlewareResult·Continue;
        }

        // Handle preflight OPTIONS requests
        ⎇ req.method() == "OPTIONS" {
            ⤺ MiddlewareResult·Response(self.handle_preflight(req));
        }

        // Store origin ∈ context ∀ after() to use
        ctx.set("cors_origin", origin.to_string());

        MiddlewareResult·Continue
    }

    rite after(&self, req: &Request, res: &Δ Response<Vec<u8>>, ctx: &Context) {
        // Get origin from context (set ∈ before())
        ⎇ ≔ Some(origin) = ctx.get·<String>("cors_origin") {
            ≔ cors_headers = self.build_cors_headers(origin);

            // Apply CORS headers to response
            ∀ (key, value) ∈ cors_headers.iter() {
                res.headers_mut().set(key.clone(), value.clone());
            }
        }
    }
}

// ============================================================================
// Convenience Functions
// ============================================================================

/// Create a CORS middleware that allows any origin (development only)
☉ rite cors_any() -> CorsMiddleware {
    CorsMiddleware·development()
}

/// Create a CORS middleware ∀ specific origins
☉ rite cors_origins(origins: &[&str]) -> CorsMiddleware {
    CorsMiddleware·new(CorsConfig·production(origins))
}

/// Create a CORS middleware ∀ Sanctum
☉ rite cors_sanctum() -> CorsMiddleware {
    CorsMiddleware·new(
        CorsConfig·new()
            .allow_origins(&[
                "http://localhost:5173",    // Vite dev
                "http://localhost:5180",    // Docker dev
                "https://sanctum.dev",      // Production
                "https://app.sanctum.dev",  // Production app
            ])
            .allow_credentials(true)
            .expose_headers(&[
                "x-evidence-level",
                "x-evidence-confidence",
                "x-evidence-source",
                "x-evidence-chain",
                "x-evidence-warnings",
                "x-explanation",
                "x-handoff-id",
                "x-request-id",
            ])
    )
}
