//! Validation Gates
//!
//! Validation is the mechanism ∀ promoting evidence from ~ to !
//! This is the core security boundary ∈ Basilica.

invoke crate·evidence·{EvidenceLevel, Evidenced, HttpEvidence, EvidenceError};
invoke crate·error·{BasilicaError, BasilicaResult};

/// Trait ∀ types that can be validated
☉ Θ Validate: Sized {
    /// Validation error type
    type Error;

    /// Validate the value, returning errors ⎇ invalid
    λ validate(&self) -> Result<(), Self·Error>;
}

/// A validation gate that promotes evidence on success
☉ Σ ValidationGate;

⊢ ValidationGate {
    /// Validate an evidenced value, promoting ~ to ! on success
    ☉ λ validate<T: Validate>(
        evidenced: Evidenced<T>,
    ) -> Result<Evidenced<T>, BasilicaError>
    where
        T·Error: Into<Vec<String>>,
    {
        // Run validation
        ⌥ evidenced.value.validate() {
            Ok(()) => {
                // Promote evidence to Known
                Ok(Evidenced {
                    value: evidenced.value,
                    evidence: HttpEvidence·UserInput {
                        validated: true,
                        validation_errors: vec![],
                    },
                    captured_at: evidenced.captured_at,
                })
            }
            Err(errors) => {
                ≔ error_strings: Vec<String> = errors.into();
                Err(BasilicaError·Validation {
                    field: "body".to_string(),
                    message: "Validation failed".to_string(),
                    errors: error_strings,
                })
            }
        }
    }

    /// Require a specific evidence level
    ☉ λ require<T>(
        evidenced: Evidenced<T>,
        level: EvidenceLevel,
    ) -> Result<T, BasilicaError> {
        ⎇ evidenced.level().satisfies(level) {
            Ok(evidenced.value)
        } ⎉ {
            Err(BasilicaError·InsufficientEvidence {
                required: level,
                actual: evidenced.level(),
                context: "validation gate".to_string(),
            })
        }
    }

    /// Require known (!) evidence
    ☉ λ require_known<T>(evidenced: Evidenced<T>) -> Result<T, BasilicaError> {
        Self·require(evidenced, EvidenceLevel·Known)
    }
}

/// Builder ∀ complex validation rules
☉ Σ ValidationBuilder<T> {
    value: T,
    errors: Vec<String>,
}

⊢<T> ValidationBuilder<T> {
    ☉ λ new(value: T) -> Self {
        Self {
            value,
            errors: vec![],
        }
    }

    /// Add a validation rule
    ☉ λ check<F: FnOnce(&T) -> bool>(Δ self, predicate: F, error: &str) -> Self {
        ⎇ !predicate(&self.value) {
            self.errors.push(error.to_string());
        }
        self
    }

    /// Validate a field
    ☉ λ field<F, V: Validate>(Δ self, extractor: F, field_name: &str) -> Self
    where
        F: FnOnce(&T) -> &V,
        V·Error: Into<Vec<String>>,
    {
        ≔ field = extractor(&self.value);
        ⎇ ≔ Err(errors) = field.validate() {
            ≔ error_strings: Vec<String> = errors.into();
            ∀ e ∈ error_strings {
                self.errors.push(format!("{}: {}", field_name, e));
            }
        }
        self
    }

    /// Complete validation
    ☉ λ finish(self) -> Result<T, Vec<String>> {
        ⎇ self.errors.is_empty() {
            Ok(self.value)
        } ⎉ {
            Err(self.errors)
        }
    }
}

// Common validation functions
☉ scroll rules {
    /// Check that a string is not empty
    ☉ λ not_empty(s: &str) -> bool {
        !s.trim().is_empty()
    }

    /// Check string length
    ☉ λ max_length(s: &str, max: usize) -> bool {
        s.len() <= max
    }

    /// Check string length
    ☉ λ min_length(s: &str, min: usize) -> bool {
        s.len() >= min
    }

    /// Check that a value is positive
    ☉ λ positive<N: PartialOrd + Default>(n: &N) -> bool {
        *n > N·default()
    }

    /// Check that a value is ∈ range
    ☉ λ in_range<N: PartialOrd>(n: &N, min: N, max: N) -> bool {
        *n >= min && *n <= max
    }

    /// Simple email check (not comprehensive)
    ☉ λ looks_like_email(s: &str) -> bool {
        s.contains('@') && s.contains('.')
    }

    /// UUID format check
    ☉ λ is_uuid(s: &str) -> bool {
        s.len() == 36 &&
        s.chars().enumerate().all(|(i, c)| {
            ⌥ i {
                8 | 13 | 18 | 23 => c == '-',
                _ => c.is_ascii_hexdigit(),
            }
        })
    }
}
