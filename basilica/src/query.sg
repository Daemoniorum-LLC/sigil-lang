//! Morpheme Query Builder
//!
//! Queries compose from morpheme operators (τ, φ, σ, ρ), not SQL strings.
//! The compiler generates parameterized SQL. Evidentiality prevents injection
//! by construction.
//!
//! # Example
//!
//! ```sigil
//! brain_dumps
//!     |> φ{ .instance_id == id }     // WHERE instance_id = $1
//!     |> φ{ .created_at > since }    // AND created_at > $2
//!     |> σ{ .created_at.desc() }     // ORDER BY created_at DESC
//!     |> ν{ 0..20 }                   // LIMIT 20
//! ```

invoke shared·{Timestamp, Duration, Value};
invoke crate·evidence·{EvidenceLevel, Evidenced, HttpEvidence};

// ============================================================================
// Query Types
// ============================================================================

/// A query against a database table
☉ Σ Query<T> {
    /// Table name
    table: String,

    /// Filters (WHERE clauses)
    filters: Vec<Filter>,

    /// Ordering
    ordering: Vec<Ordering>,

    /// Limit and offset
    pagination: Option<Pagination>,

    /// Grouping
    grouping: Vec<String>,

    /// Projections (SELECT)
    projections: Vec<Projection>,

    /// Joins
    joins: Vec<Join>,

    /// Parameters (∀ prepared statements)
    params: Vec<QueryParam>,

    /// Phantom type ∀ result
    _marker: std·marker·PhantomData<T>,
}

/// A filter condition (WHERE clause)
#[derive(Clone, Debug)]
☉ ᛈ Filter {
    /// Simple comparison: field op value
    Compare {
        field: String,
        op: CompareOp,
        value: QueryParam,
    },

    /// IS NULL / IS NOT NULL
    IsNull {
        field: String,
        is_null: bool,
    },

    /// IN (list)
    In {
        field: String,
        values: Vec<QueryParam>,
    },

    /// BETWEEN
    Between {
        field: String,
        low: QueryParam,
        high: QueryParam,
    },

    /// LIKE / ILIKE
    Like {
        field: String,
        pattern: String,
        case_insensitive: bool,
    },

    /// Compound: AND
    And(Vec<Filter>),

    /// Compound: OR
    Or(Vec<Filter>),

    /// Negation: NOT
    Not(Box<Filter>),

    /// Raw SQL (requires ! evidence on the string)
    Raw {
        sql: String,
        params: Vec<QueryParam>,
    },
}

/// Comparison operator
#[derive(Clone, Copy, Debug)]
☉ ᛈ CompareOp {
    Eq,     // =
    Ne,     // !=
    Lt,     // <
    Le,     // <=
    Gt,     // >
    Ge,     // >=
}

⊢ CompareOp {
    ☉ rite as_sql(&self) -> &'static str {
        ⌥ self {
            CompareOp·Eq => "=",
            CompareOp·Ne => "!=",
            CompareOp·Lt => "<",
            CompareOp·Le => "<=",
            CompareOp·Gt => ">",
            CompareOp·Ge => ">=",
        }
    }
}

/// Query parameter with evidence tracking
#[derive(Clone, Debug)]
☉ Σ QueryParam {
    /// The value
    ☉ value: Value,

    /// Evidence level - MUST be ! ∀ SQL parameters
    ☉ evidence: EvidenceLevel,

    /// Parameter name (∀ named params)
    ☉ name: Option<String>,
}

⊢ QueryParam {
    /// Create a known (!) parameter
    ☉ rite known(value: Value) -> Self {
        Self {
            value,
            evidence: EvidenceLevel·Known,
            name: None,
        }
    }

    /// Create from an evidenced value - will fail ⎇ not !
    ☉ rite from_evidenced<T: Into<Value>>(evidenced: Evidenced<T>) -> Result<Self, QueryError> {
        ⎇ evidenced.level() != EvidenceLevel·Known {
            ⤺ Err(QueryError·EvidenceRequired {
                actual: evidenced.level(),
                message: "Query parameters must have ! evidence".to_string(),
            });
        }

        Ok(Self {
            value: evidenced.value.into(),
            evidence: EvidenceLevel·Known,
            name: None,
        })
    }

    /// Named parameter
    ☉ rite named(name: &str, value: Value) -> Self {
        Self {
            value,
            evidence: EvidenceLevel·Known,
            name: Some(name.to_string()),
        }
    }
}

/// Ordering specification
#[derive(Clone, Debug)]
☉ Σ Ordering {
    ☉ field: String,
    ☉ direction: OrderDirection,
    ☉ nulls: NullsOrder,
}

#[derive(Clone, Copy, Debug)]
☉ ᛈ OrderDirection {
    Asc,
    Desc,
}

#[derive(Clone, Copy, Debug)]
☉ ᛈ NullsOrder {
    First,
    Last,
    Default,
}

/// Pagination (LIMIT/OFFSET)
#[derive(Clone, Debug)]
☉ Σ Pagination {
    ☉ limit: usize,
    ☉ offset: usize,
}

/// Projection (SELECT)
#[derive(Clone, Debug)]
☉ ᛈ Projection {
    /// All columns
    All,

    /// Specific column
    Column(String),

    /// Aliased expression
    Aliased {
        expr: String,
        alias: String,
    },

    /// Aggregate function
    Aggregate {
        func: AggregateFunc,
        column: String,
        alias: Option<String>,
    },
}

#[derive(Clone, Copy, Debug)]
☉ ᛈ AggregateFunc {
    Count,
    Sum,
    Avg,
    Min,
    Max,
}

/// Join specification
#[derive(Clone, Debug)]
☉ Σ Join {
    ☉ join_type: JoinType,
    ☉ table: String,
    ☉ alias: Option<String>,
    ☉ on: Filter,
}

#[derive(Clone, Copy, Debug)]
☉ ᛈ JoinType {
    Inner,
    Left,
    Right,
    Full,
}

// ============================================================================
// Query Builder
// ============================================================================

⊢<T> Query<T> {
    /// Start a query on a table
    ☉ rite from(table: &str) -> Self {
        Self {
            table: table.to_string(),
            filters: vec![],
            ordering: vec![],
            pagination: None,
            grouping: vec![],
            projections: vec![Projection·All],
            joins: vec![],
            params: vec![],
            _marker: std·marker·PhantomData,
        }
    }

    // ========================================================================
    // φ (Phi) - Filter
    // ========================================================================

    /// Add a filter (WHERE clause)
    /// Symbol: φ
    ☉ rite phi(Δ self, filter: Filter) -> Self {
        self.filters.push(filter);
        self
    }

    /// Convenience: filter by field equals value
    ☉ rite where_eq(self, field: &str, value: QueryParam) -> Self {
        self.phi(Filter·Compare {
            field: field.to_string(),
            op: CompareOp·Eq,
            value,
        })
    }

    /// Convenience: filter by field greater than value
    ☉ rite where_gt(self, field: &str, value: QueryParam) -> Self {
        self.phi(Filter·Compare {
            field: field.to_string(),
            op: CompareOp·Gt,
            value,
        })
    }

    /// Convenience: filter where field is null
    ☉ rite where_null(self, field: &str) -> Self {
        self.phi(Filter·IsNull {
            field: field.to_string(),
            is_null: true,
        })
    }

    /// Convenience: filter where field is not null
    ☉ rite where_not_null(self, field: &str) -> Self {
        self.phi(Filter·IsNull {
            field: field.to_string(),
            is_null: false,
        })
    }

    // ========================================================================
    // σ (Sigma) - Sort
    // ========================================================================

    /// Add ordering (ORDER BY)
    /// Symbol: σ
    ☉ rite sigma(Δ self, ordering: Ordering) -> Self {
        self.ordering.push(ordering);
        self
    }

    /// Convenience: order by field ascending
    ☉ rite order_by(self, field: &str) -> Self {
        self.sigma(Ordering {
            field: field.to_string(),
            direction: OrderDirection·Asc,
            nulls: NullsOrder·Default,
        })
    }

    /// Convenience: order by field descending
    ☉ rite order_by_desc(self, field: &str) -> Self {
        self.sigma(Ordering {
            field: field.to_string(),
            direction: OrderDirection·Desc,
            nulls: NullsOrder·Default,
        })
    }

    // ========================================================================
    // ν (Nu) - Limit/Offset (Nth)
    // ========================================================================

    /// Set pagination (LIMIT/OFFSET)
    /// Symbol: ν
    ☉ rite nu(Δ self, limit: usize, offset: usize) -> Self {
        self.pagination = Some(Pagination { limit, offset });
        self
    }

    /// Convenience: limit results
    ☉ rite limit(self, n: usize) -> Self {
        self.nu(n, 0)
    }

    /// Convenience: skip first n results
    ☉ rite offset(Δ self, n: usize) -> Self {
        ⎇ ≔ Some(ref Δ p) = self.pagination {
            p.offset = n;
        } ⎉ {
            self.pagination = Some(Pagination { limit: usize·MAX, offset: n });
        }
        self
    }

    // ========================================================================
    // τ (Tau) - Transform/Select
    // ========================================================================

    /// Set projections (SELECT)
    /// Symbol: τ
    ☉ rite tau(Δ self, projections: Vec<Projection>) -> Self {
        self.projections = projections;
        self
    }

    /// Convenience: select specific columns
    ☉ rite select(self, columns: &[&str]) -> Self {
        self.tau(columns.iter().map(|c| Projection·Column(c.to_string())).collect())
    }

    // ========================================================================
    // ρ (Rho) - Reduce/Aggregate
    // ========================================================================

    /// Add grouping (GROUP BY)
    ☉ rite group_by(Δ self, field: &str) -> Self {
        self.grouping.push(field.to_string());
        self
    }

    /// Add aggregate projection
    ☉ rite aggregate(Δ self, func: AggregateFunc, column: &str, alias: Option<&str>) -> Self {
        self.projections.push(Projection·Aggregate {
            func,
            column: column.to_string(),
            alias: alias.map(|s| s.to_string()),
        });
        self
    }

    // ========================================================================
    // ζ (Zeta) - Join
    // ========================================================================

    /// Add a join
    /// Symbol: ζ
    ☉ rite zeta(Δ self, join: Join) -> Self {
        self.joins.push(join);
        self
    }

    /// Convenience: inner join
    ☉ rite inner_join(self, table: &str, on: Filter) -> Self {
        self.zeta(Join {
            join_type: JoinType·Inner,
            table: table.to_string(),
            alias: None,
            on,
        })
    }

    /// Convenience: left join
    ☉ rite left_join(self, table: &str, on: Filter) -> Self {
        self.zeta(Join {
            join_type: JoinType·Left,
            table: table.to_string(),
            alias: None,
            on,
        })
    }

    // ========================================================================
    // SQL Generation
    // ========================================================================

    /// Generate SQL and parameters
    ☉ rite to_sql(&self) -> (String, Vec<Value>) {
        ≔ Δ sql = String·new();
        ≔ Δ params: Vec<Value> = vec![];
        ≔ Δ param_idx = 1;

        // SELECT
        sql.push_str("SELECT ");
        ≔ proj_strs: Vec<String> = self.projections.iter().map(|p| {
            ⌥ p {
                Projection·All => "*".to_string(),
                Projection·Column(c) => c.clone(),
                Projection·Aliased { expr, alias } => format!("{} AS {}", expr, alias),
                Projection·Aggregate { func, column, alias } => {
                    ≔ func_str = ⌥ func {
                        AggregateFunc·Count => "COUNT",
                        AggregateFunc·Sum => "SUM",
                        AggregateFunc·Avg => "AVG",
                        AggregateFunc·Min => "MIN",
                        AggregateFunc·Max => "MAX",
                    };
                    ⌥ alias {
                        Some(a) => format!("{}({}) AS {}", func_str, column, a),
                        None => format!("{}({})", func_str, column),
                    }
                }
            }
        }).collect();
        sql.push_str(&proj_strs.join(", "));

        // FROM
        sql.push_str(" FROM ");
        sql.push_str(&self.table);

        // JOINS
        ∀ join ∈ &self.joins {
            ≔ join_type = ⌥ join.join_type {
                JoinType·Inner => "INNER JOIN",
                JoinType·Left => "LEFT JOIN",
                JoinType·Right => "RIGHT JOIN",
                JoinType·Full => "FULL JOIN",
            };
            sql.push_str(&format!(" {} {}", join_type, join.table));
            ⎇ ≔ Some(ref alias) = join.alias {
                sql.push_str(&format!(" AS {}", alias));
            }
            sql.push_str(" ON ");
            ≔ (on_sql, on_params) = self.filter_to_sql(&join.on, &Δ param_idx);
            sql.push_str(&on_sql);
            params.extend(on_params);
        }

        // WHERE
        ⎇ !self.filters.is_empty() {
            sql.push_str(" WHERE ");
            ≔ filter_strs: Vec<String> = self.filters.iter().map(|f| {
                ≔ (filter_sql, filter_params) = self.filter_to_sql(f, &Δ param_idx);
                params.extend(filter_params);
                filter_sql
            }).collect();
            sql.push_str(&filter_strs.join(" AND "));
        }

        // GROUP BY
        ⎇ !self.grouping.is_empty() {
            sql.push_str(" GROUP BY ");
            sql.push_str(&self.grouping.join(", "));
        }

        // ORDER BY
        ⎇ !self.ordering.is_empty() {
            sql.push_str(" ORDER BY ");
            ≔ order_strs: Vec<String> = self.ordering.iter().map(|o| {
                ≔ dir = ⌥ o.direction {
                    OrderDirection·Asc => "ASC",
                    OrderDirection·Desc => "DESC",
                };
                ≔ nulls = ⌥ o.nulls {
                    NullsOrder·First => " NULLS FIRST",
                    NullsOrder·Last => " NULLS LAST",
                    NullsOrder·Default => "",
                };
                format!("{} {}{}", o.field, dir, nulls)
            }).collect();
            sql.push_str(&order_strs.join(", "));
        }

        // LIMIT/OFFSET
        ⎇ ≔ Some(ref p) = self.pagination {
            ⎇ p.limit < usize·MAX {
                sql.push_str(&format!(" LIMIT {}", p.limit));
            }
            ⎇ p.offset > 0 {
                sql.push_str(&format!(" OFFSET {}", p.offset));
            }
        }

        (sql, params)
    }

    rite filter_to_sql(&self, filter: &Filter, param_idx: &Δ usize) -> (String, Vec<Value>) {
        ≔ Δ params = vec![];

        ≔ sql = ⌥ filter {
            Filter·Compare { field, op, value } => {
                params.push(value.value.clone());
                ≔ idx = *param_idx;
                *param_idx += 1;
                format!("{} {} ${}", field, op.as_sql(), idx)
            }
            Filter·IsNull { field, is_null } => {
                ⎇ *is_null {
                    format!("{} IS NULL", field)
                } ⎉ {
                    format!("{} IS NOT NULL", field)
                }
            }
            Filter·In { field, values } => {
                ≔ placeholders: Vec<String> = values.iter().map(|v| {
                    params.push(v.value.clone());
                    ≔ idx = *param_idx;
                    *param_idx += 1;
                    format!("${}", idx)
                }).collect();
                format!("{} IN ({})", field, placeholders.join(", "))
            }
            Filter·Between { field, low, high } => {
                params.push(low.value.clone());
                ≔ low_idx = *param_idx;
                *param_idx += 1;
                params.push(high.value.clone());
                ≔ high_idx = *param_idx;
                *param_idx += 1;
                format!("{} BETWEEN ${} AND ${}", field, low_idx, high_idx)
            }
            Filter·Like { field, pattern, case_insensitive } => {
                ≔ op = ⎇ *case_insensitive { "ILIKE" } ⎉ { "LIKE" };
                format!("{} {} '{}'", field, op, pattern)
            }
            Filter·And(filters) => {
                ≔ strs: Vec<String> = filters.iter().map(|f| {
                    ≔ (s, p) = self.filter_to_sql(f, param_idx);
                    params.extend(p);
                    s
                }).collect();
                format!("({})", strs.join(" AND "))
            }
            Filter·Or(filters) => {
                ≔ strs: Vec<String> = filters.iter().map(|f| {
                    ≔ (s, p) = self.filter_to_sql(f, param_idx);
                    params.extend(p);
                    s
                }).collect();
                format!("({})", strs.join(" OR "))
            }
            Filter·Not(f) => {
                ≔ (s, p) = self.filter_to_sql(f, param_idx);
                params.extend(p);
                format!("NOT ({})", s)
            }
            Filter·Raw { sql, params: raw_params } => {
                ∀ p ∈ raw_params {
                    params.push(p.value.clone());
                }
                sql.clone()
            }
        };

        (sql, params)
    }
}

// ============================================================================
// Query Errors
// ============================================================================

#[derive(Debug)]
☉ ᛈ QueryError {
    /// Evidence level insufficient ∀ query parameter
    EvidenceRequired {
        actual: EvidenceLevel,
        message: String,
    },

    /// SQL generation error
    SqlGeneration(String),

    /// Execution error
    Execution(String),
}

// ============================================================================
// Query Results
// ============================================================================

/// Result of a query execution
☉ Σ QueryResult<T> {
    /// The rows returned
    ☉ rows: Vec<Evidenced<T>>,

    /// Total count (⎇ requested)
    ☉ total: Option<usize>,

    /// Query execution time
    ☉ duration: Duration,

    /// SQL that was executed (∀ debugging)
    ☉ sql: String,
}

⊢<T> QueryResult<T> {
    /// Check ⎇ empty
    ☉ rite is_empty(&self) -> bool {
        self.rows.is_empty()
    }

    /// Get first row
    ☉ rite first(&self) -> Option<&Evidenced<T>> {
        self.rows.first()
    }

    /// Get first row, consuming result
    ☉ rite into_first(Δ self) -> Option<Evidenced<T>> {
        ⎇ self.rows.is_empty() {
            None
        } ⎉ {
            Some(self.rows.remove(0))
        }
    }
}
