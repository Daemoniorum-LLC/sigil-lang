//! HTTP Response Types with Evidence Metadata
//!
//! Responses carry evidence about their data sources, enabling clients
//! and observability systems to understand data provenance and confidence.

invoke shared·{Timestamp, Confidence, Value};
invoke crate·evidence·{HttpEvidence, EvidenceLevel, Evidenced, EvidenceContext};
invoke crate·request·Headers;

// ============================================================================
// HTTP Status
// ============================================================================

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ Σ StatusCode(u16);

⊢ StatusCode {
    // Success
    ☉ const OK: StatusCode = StatusCode(200);
    ☉ const CREATED: StatusCode = StatusCode(201);
    ☉ const ACCEPTED: StatusCode = StatusCode(202);
    ☉ const NO_CONTENT: StatusCode = StatusCode(204);

    // Redirection
    ☉ const MOVED_PERMANENTLY: StatusCode = StatusCode(301);
    ☉ const FOUND: StatusCode = StatusCode(302);
    ☉ const NOT_MODIFIED: StatusCode = StatusCode(304);

    // Client Error
    ☉ const BAD_REQUEST: StatusCode = StatusCode(400);
    ☉ const UNAUTHORIZED: StatusCode = StatusCode(401);
    ☉ const FORBIDDEN: StatusCode = StatusCode(403);
    ☉ const NOT_FOUND: StatusCode = StatusCode(404);
    ☉ const METHOD_NOT_ALLOWED: StatusCode = StatusCode(405);
    ☉ const CONFLICT: StatusCode = StatusCode(409);
    ☉ const UNPROCESSABLE_ENTITY: StatusCode = StatusCode(422);
    ☉ const TOO_MANY_REQUESTS: StatusCode = StatusCode(429);

    // Server Error
    ☉ const INTERNAL_SERVER_ERROR: StatusCode = StatusCode(500);
    ☉ const NOT_IMPLEMENTED: StatusCode = StatusCode(501);
    ☉ const BAD_GATEWAY: StatusCode = StatusCode(502);
    ☉ const SERVICE_UNAVAILABLE: StatusCode = StatusCode(503);

    // Custom
    ☉ const APPROVAL_REQUIRED: StatusCode = StatusCode(499); // Custom: Covenant handoff

    ☉ λ as_u16(&self) -> u16 { self.0 }

    ☉ λ is_success(&self) -> bool { self.0 >= 200 && self.0 < 300 }
    ☉ λ is_redirect(&self) -> bool { self.0 >= 300 && self.0 < 400 }
    ☉ λ is_client_error(&self) -> bool { self.0 >= 400 && self.0 < 500 }
    ☉ λ is_server_error(&self) -> bool { self.0 >= 500 && self.0 < 600 }

    ☉ λ reason_phrase(&self) -> &'static str {
        ⌥ self.0 {
            200 => "OK",
            201 => "Created",
            204 => "No Content",
            400 => "Bad Request",
            401 => "Unauthorized",
            403 => "Forbidden",
            404 => "Not Found",
            409 => "Conflict",
            422 => "Unprocessable Entity",
            499 => "Approval Required",
            500 => "Internal Server Error",
            503 => "Service Unavailable",
            _ => "Unknown",
        }
    }
}

// ============================================================================
// Response
// ============================================================================

/// An HTTP response with evidence metadata
///
/// Responses carry information about the evidence level and confidence
/// of the data they contain.
☉ Σ Response<T> {
    /// HTTP status code
    ☉ status: StatusCode,

    /// Response headers
    headers: Headers,

    /// Response body with evidence
    body: Option<Evidenced<T>>,

    /// Evidence summary ∀ the entire response
    evidence_summary: ResponseEvidence,

    /// Timestamp when response was created
    ☉ created_at: Timestamp,
}

/// Evidence metadata ∀ the response
#[derive(Clone, Debug)]
☉ Σ ResponseEvidence {
    /// Overall evidence level of the response data
    ☉ level: EvidenceLevel,

    /// Confidence ∈ the response
    ☉ confidence: Confidence,

    /// Source description
    ☉ source: String,

    /// Evidence chain from request processing
    ☉ chain: Vec<String>,

    /// Warnings about evidence quality
    ☉ warnings: Vec<String>,
}

⊢ ResponseEvidence {
    /// Create a computed response (highest trust)
    ☉ λ computed() -> Self {
        Self {
            level: EvidenceLevel·Known,
            confidence: Confidence·full(),
            source: "computed".to_string(),
            chain: vec![],
            warnings: vec![],
        }
    }

    /// Create from an evidenced value
    ☉ λ from_evidenced<T>(evidenced: &Evidenced<T>) -> Self {
        Self {
            level: evidenced.level(),
            confidence: evidenced.evidence.confidence(),
            source: evidenced.evidence.describe(),
            chain: vec![],
            warnings: vec![],
        }
    }

    /// Create from evidence context
    ☉ λ from_context(ctx: &EvidenceContext) -> Self {
        Self {
            level: ctx.chain().last()
                .map(|t| t.to)
                .unwrap_or(EvidenceLevel·Known),
            confidence: ctx.confidence(),
            source: "request_processing".to_string(),
            chain: ctx.chain().iter()
                .map(|t| format!("{} → {}", t.from.symbol(), t.to.symbol()))
                .collect(),
            warnings: ctx.warnings().to_vec(),
        }
    }

    /// Add to evidence chain
    ☉ λ with_chain(Δ self, step: &str) -> Self {
        self.chain.push(step.to_string());
        self
    }

    /// Add warning
    ☉ λ with_warning(Δ self, warning: &str) -> Self {
        self.warnings.push(warning.to_string());
        self
    }
}

⊢<T> Response<T> {
    /// Create a new response with status and body
    ☉ λ new(status: StatusCode, body: T) -> Self {
        Self {
            status,
            headers: Headers·new(),
            body: Some(Evidenced·computed(body)),
            evidence_summary: ResponseEvidence·computed(),
            created_at: Timestamp·now(),
        }
    }

    /// Create a response with evidenced body
    ☉ λ with_evidence(status: StatusCode, body: Evidenced<T>) -> Self {
        ≔ evidence_summary = ResponseEvidence·from_evidenced(&body);
        Self {
            status,
            headers: Headers·new(),
            body: Some(body),
            evidence_summary,
            created_at: Timestamp·now(),
        }
    }

    // ========================================================================
    // Common Response Constructors
    // ========================================================================

    /// 200 OK response
    ☉ λ ok(body: T) -> Self {
        Self·new(StatusCode·OK, body)
    }

    /// 201 Created response
    ☉ λ created(body: T) -> Self {
        Self·new(StatusCode·CREATED, body)
    }

    /// 202 Accepted response
    ☉ λ accepted(body: T) -> Self {
        Self·new(StatusCode·ACCEPTED, body)
    }

    // ========================================================================
    // Builder Methods
    // ========================================================================

    /// Set a header
    ☉ λ header(Δ self, key: &str, value: &str) -> Self {
        self.headers.set(key.to_string(), value.to_string());
        self
    }

    /// Set content type
    ☉ λ content_type(self, content_type: &str) -> Self {
        self.header("content-type", content_type)
    }

    /// Set JSON content type
    ☉ λ json(self) -> Self {
        self.content_type("application/json")
    }

    /// Set the evidence summary
    ☉ λ with_evidence_summary(Δ self, evidence: ResponseEvidence) -> Self {
        self.evidence_summary = evidence;
        self
    }

    /// Add evidence headers to response
    ☉ λ with_evidence_headers(Δ self) -> Self {
        // Add evidence metadata as headers
        self.headers.set(
            "x-evidence-level".to_string(),
            self.evidence_summary.level.symbol().to_string()
        );
        self.headers.set(
            "x-evidence-confidence".to_string(),
            format!("{:.2}", self.evidence_summary.confidence.value())
        );
        ⎇ !self.evidence_summary.warnings.is_empty() {
            self.headers.set(
                "x-evidence-warnings".to_string(),
                self.evidence_summary.warnings.join("; ")
            );
        }
        self
    }

    // ========================================================================
    // Accessors
    // ========================================================================

    /// Get the response body
    ☉ λ body(&self) -> Option<&Evidenced<T>> {
        self.body.as_ref()
    }

    /// Get headers
    ☉ λ headers(&self) -> &Headers {
        &self.headers
    }

    /// Get evidence summary
    ☉ λ evidence(&self) -> &ResponseEvidence {
        &self.evidence_summary
    }

    /// Unwrap the body value, discarding evidence
    ☉ λ into_body(self) -> Option<T> {
        self.body.map(|b| b.value)
    }
}

// ============================================================================
// Empty Response
// ============================================================================

⊢ Response<()> {
    /// 204 No Content response
    ☉ λ no_content() -> Self {
        Self {
            status: StatusCode·NO_CONTENT,
            headers: Headers·new(),
            body: None,
            evidence_summary: ResponseEvidence·computed(),
            created_at: Timestamp·now(),
        }
    }
}

// ============================================================================
// Error Responses
// ============================================================================

/// Error response body
#[derive(Clone, Debug)]
☉ Σ ErrorBody {
    ☉ error: String,
    ☉ message: String,
    ☉ details: Option<Vec<String>>,
    ☉ evidence: Option<String>,
}

⊢ Response<ErrorBody> {
    /// 400 Bad Request
    ☉ λ bad_request(message: &str) -> Self {
        Self·new(StatusCode·BAD_REQUEST, ErrorBody {
            error: "bad_request".to_string(),
            message: message.to_string(),
            details: None,
            evidence: None,
        })
    }

    /// 401 Unauthorized
    ☉ λ unauthorized(message: &str) -> Self {
        Self·new(StatusCode·UNAUTHORIZED, ErrorBody {
            error: "unauthorized".to_string(),
            message: message.to_string(),
            details: None,
            evidence: None,
        })
    }

    /// 403 Forbidden
    ☉ λ forbidden(message: &str) -> Self {
        Self·new(StatusCode·FORBIDDEN, ErrorBody {
            error: "forbidden".to_string(),
            message: message.to_string(),
            details: None,
            evidence: None,
        })
    }

    /// 404 Not Found
    ☉ λ not_found(message: &str) -> Self {
        Self·new(StatusCode·NOT_FOUND, ErrorBody {
            error: "not_found".to_string(),
            message: message.to_string(),
            details: None,
            evidence: None,
        })
    }

    /// 422 Unprocessable Entity (validation errors)
    ☉ λ validation_error(errors: Vec<String>) -> Self {
        Self·new(StatusCode·UNPROCESSABLE_ENTITY, ErrorBody {
            error: "validation_error".to_string(),
            message: "Validation failed".to_string(),
            details: Some(errors),
            evidence: Some("Evidence level insufficient".to_string()),
        })
    }

    /// 500 Internal Server Error
    ☉ λ internal_error(message: &str) -> Self {
        Self·new(StatusCode·INTERNAL_SERVER_ERROR, ErrorBody {
            error: "internal_error".to_string(),
            message: message.to_string(),
            details: None,
            evidence: None,
        })
    }

    /// 499 Approval Required (custom Covenant status)
    ☉ λ approval_required(action: &str, handoff_id: &str) -> Self {
        Self·new(StatusCode·APPROVAL_REQUIRED, ErrorBody {
            error: "approval_required".to_string(),
            message: format!("Action '{}' requires human approval", action),
            details: Some(vec![format!("handoff_id: {}", handoff_id)]),
            evidence: Some("Covenant boundary reached".to_string()),
        }).header("x-handoff-id", handoff_id)
    }
}

// ============================================================================
// IntoResponse Trait
// ============================================================================

/// Trait ∀ types that can be converted into a response
☉ Θ IntoResponse {
    λ into_response(self) -> Response<Vec<u8>>;
}

⊢ IntoResponse ∀ String {
    λ into_response(self) -> Response<Vec<u8>> {
        Response·ok(self.into_bytes())
            .content_type("text/plain; charset=utf-8")
    }
}

⊢ IntoResponse ∀ &str {
    λ into_response(self) -> Response<Vec<u8>> {
        Response·ok(self.as_bytes().to_vec())
            .content_type("text/plain; charset=utf-8")
    }
}

⊢ IntoResponse ∀ Vec<u8> {
    λ into_response(self) -> Response<Vec<u8>> {
        Response·ok(self)
            .content_type("application/octet-stream")
    }
}

⊢<T> IntoResponse ∀ Response<T>
where
    T: Into<Vec<u8>>,
{
    λ into_response(self) -> Response<Vec<u8>> {
        Response {
            status: self.status,
            headers: self.headers,
            body: self.body.map(|b| Evidenced {
                value: b.value.into(),
                evidence: b.evidence,
                captured_at: b.captured_at,
            }),
            evidence_summary: self.evidence_summary,
            created_at: self.created_at,
        }
    }
}

// ============================================================================
// Response Extensions ∀ Explanations
// ============================================================================

⊢<T> Response<T> {
    /// Add an explanation to the response (from Oracle)
    ☉ λ with_explanation(Δ self, explanation: &str) -> Self {
        self.headers.set("x-explanation".to_string(), explanation.to_string());
        self
    }

    /// Add reasoning trace
    ☉ λ with_reasoning(Δ self, steps: &[String]) -> Self {
        self.headers.set(
            "x-reasoning-steps".to_string(),
            steps.len().to_string()
        );
        // Full reasoning would go ∈ body or separate endpoint
        self
    }

    /// Add confidence to response
    ☉ λ with_confidence(Δ self, confidence: Confidence) -> Self {
        self.evidence_summary.confidence = confidence;
        self.headers.set(
            "x-confidence".to_string(),
            format!("{:.2}", confidence.value())
        );
        self
    }
}
