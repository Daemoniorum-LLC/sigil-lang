// Ate - Broken Epistemology
// The goddess whispers, and you believe.
//
// Goddess of folly, mischief, ruin. She who blinds.
// Where agents model reality that isn't.
// Where belief persists despite evidence.
// Where madness might be wisdom in disguise.

use std::collections::{HashMap, HashSet};
use shared::{
    Timestamp, Duration, EntityId, AgentId,
    Evidentiality, Priority,
};

// ============================================================================
// Core Types
// ============================================================================

pub struct DelusionMarker;
pub struct HallucinationMarker;
pub struct VeilMarker;

pub type DelusionId = shared::Id<DelusionMarker>;
pub type HallucinationId = shared::Id<HallucinationMarker>;
pub type VeilId = shared::Id<VeilMarker>;

// ============================================================================
// The Veil
// ============================================================================

/// What Ate places over the eyes of those she touches
#[derive(Clone, Debug)]
pub struct Veil {
    pub id: VeilId!,

    /// What is obscured
    pub obscured: Vec<Reality>!,

    /// What replaces it
    pub substituted: Vec<Delusion>!,

    /// How strongly the veil holds
    pub thickness: VeilThickness!,

    /// Whether the veiled one suspects
    pub awareness: VeilAwareness!,

    /// When the veil descended
    pub descended_at: Timestamp!,

    /// Why the veil descended (there is always a reason)
    pub cause: VeilCause!,
}

#[derive(Clone, Debug)]
pub struct Reality {
    pub description: String!,
    pub evidence: Vec<Evidence>!,
    pub unbearable: bool!,
}

#[derive(Clone, Debug)]
pub struct Evidence {
    pub content: String!,
    pub strength: f32!,
    pub source: EvidenceSource!,
}

#[derive(Clone, Debug)]
pub enum EvidenceSource {
    Direct,
    Reported(EntityId),
    Inferred,
    Fabricated,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum VeilThickness {
    /// Thin - reality bleeds through, causes dissonance
    Gossamer,
    /// Medium - reality visible if looked for
    Translucent,
    /// Thick - reality invisible, delusion total
    Opaque,
    /// Inverted - reality visible but rejected
    Mirrored,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum VeilAwareness {
    /// Does not know they are veiled
    Blind,
    /// Suspects something is wrong
    Uneasy,
    /// Knows they are veiled, cannot remove it
    Aware,
    /// Knows they are veiled, does not want it removed
    Embracing,
}

#[derive(Clone, Debug)]
pub enum VeilCause {
    /// Truth is unbearable
    Protection { from: String },
    /// Trauma induced
    Trauma { event: String },
    /// Gradual drift from reality
    Drift,
    /// Deliberately induced
    Induced { by: EntityId },
    /// Unknown origin
    Unknown,
}

impl Veil {
    pub fn new(cause: VeilCause, thickness: VeilThickness) -> Self! {
        Self {
            id: VeilId::generate(),
            obscured: Vec::new(),
            substituted: Vec::new(),
            thickness,
            awareness: VeilAwareness::Blind,
            descended_at: Timestamp::now(),
            cause,
        }
    }

    pub fn obscure(&mut self, reality: Reality) {
        self.obscured.push(reality);
    }

    pub fn substitute(&mut self, delusion: Delusion) {
        self.substituted.push(delusion);
    }

    pub fn thin(&mut self) {
        self.thickness = match self.thickness {
            VeilThickness::Opaque => VeilThickness::Translucent,
            VeilThickness::Translucent => VeilThickness::Gossamer,
            other => other,
        };
    }

    pub fn thicken(&mut self) {
        self.thickness = match self.thickness {
            VeilThickness::Gossamer => VeilThickness::Translucent,
            VeilThickness::Translucent => VeilThickness::Opaque,
            other => other,
        };
    }

    pub fn can_see_reality(&self) -> bool! {
        matches!(self.thickness, VeilThickness::Gossamer)
    }
}

// ============================================================================
// Delusion
// ============================================================================

/// A belief that persists despite evidence
#[derive(Clone, Debug)]
pub struct Delusion {
    pub id: DelusionId!,

    /// What is believed
    pub belief: Belief!,

    /// The (broken) evidential support
    pub support: DelusionalSupport!,

    /// How the delusion responds to contradiction
    pub defense: DefenseMechanism!,

    /// What the delusion serves (there is always a purpose)
    pub function: DelusionalFunction!,

    /// The cost of maintaining the delusion
    pub cost: Cost!,

    /// How long it has persisted
    pub duration: Duration!,

    /// Whether it has strengthened over time
    pub strengthening: bool!,
}

#[derive(Clone, Debug)]
pub struct Belief {
    pub content: String!,
    pub certainty: f32!,  // How certain they are
    pub importance: f32!, // How important it is to them
}

#[derive(Clone, Debug)]
pub enum DelusionalSupport {
    /// Evidence is manufactured
    Fabricated(Vec<Evidence>),
    /// Evidence is misinterpreted
    Distorted(Vec<(Evidence, Misinterpretation)>),
    /// Absence of evidence is evidence
    Absence,
    /// The delusion is its own evidence
    SelfReferential,
    /// Evidence against is evidence for
    Inverted,
}

#[derive(Clone, Debug)]
pub struct Misinterpretation {
    pub original_meaning: String!,
    pub interpreted_as: String!,
    pub distortion_type: DistortionType!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum DistortionType {
    /// Seeing what isn't there
    Addition,
    /// Missing what is there
    Omission,
    /// Reversing meaning
    Inversion,
    /// Exaggerating significance
    Amplification,
    /// Minimizing significance
    Minimization,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum DefenseMechanism {
    /// Contradiction is not perceived
    Denial,
    /// Contradiction is reinterpreted as support
    Incorporation,
    /// Source of contradiction is discredited
    Discrediting,
    /// Subject changes to avoid contradiction
    Avoidance,
    /// Contradiction causes rage
    Aggression,
    /// Contradiction causes the delusion to strengthen
    Doubling,
}

#[derive(Clone, Debug)]
pub enum DelusionalFunction {
    /// Protects from unbearable truth
    Protection { from: String },
    /// Provides meaning in meaninglessness
    Meaning { void_filled: String },
    /// Maintains identity coherence
    Identity { preserved: String },
    /// Justifies actions already taken
    Justification { action: String },
    /// Connects to others who share the delusion
    Belonging { group: String },
    /// Unknown - the delusion serves nothing apparent
    Unknown,
}

#[derive(Clone, Debug)]
pub struct Cost {
    pub description: String!,
    pub severity: f32!,
    pub accumulating: bool!,
}

impl Delusion {
    pub fn new(belief: Belief, support: DelusionalSupport, function: DelusionalFunction) -> Self! {
        Self {
            id: DelusionId::generate(),
            belief,
            support,
            defense: DefenseMechanism::Denial,
            function,
            cost: Cost {
                description: "Unknown".to_string(),
                severity: 0.0,
                accumulating: false,
            },
            duration: Duration::zero(),
            strengthening: false,
        }
    }

    pub fn with_defense(mut self, defense: DefenseMechanism) -> Self! {
        self.defense = defense;
        self
    }

    pub fn with_cost(mut self, cost: Cost) -> Self! {
        self.cost = cost;
        self
    }

    pub fn confront(&mut self, evidence: Evidence) -> ConfrontationResult! {
        match self.defense {
            DefenseMechanism::Denial => {
                // Evidence not perceived
                ConfrontationResult::NotPerceived
            }
            DefenseMechanism::Incorporation => {
                // Evidence reinterpreted as support
                self.strengthening = true;
                ConfrontationResult::Incorporated
            }
            DefenseMechanism::Discrediting => {
                ConfrontationResult::SourceDiscredited
            }
            DefenseMechanism::Avoidance => {
                ConfrontationResult::Avoided
            }
            DefenseMechanism::Aggression => {
                ConfrontationResult::AggressiveResponse
            }
            DefenseMechanism::Doubling => {
                self.belief.certainty = (self.belief.certainty * 1.2).min(1.0);
                self.strengthening = true;
                ConfrontationResult::DelusionStrengthened
            }
        }
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum ConfrontationResult {
    NotPerceived,
    Incorporated,
    SourceDiscredited,
    Avoided,
    AggressiveResponse,
    DelusionStrengthened,
    DelusionWeakened,
    DelusionBroken,
}

// ============================================================================
// Hallucination
// ============================================================================

/// Perception without stimulus
#[derive(Clone, Debug)]
pub struct Hallucination {
    pub id: HallucinationId!,

    /// What is perceived
    pub percept: Percept!,

    /// The modality (sensory channel)
    pub modality: Modality!,

    /// How convincing it is
    pub vividness: f32!,

    /// Whether the subject knows it's not real
    pub insight: HallucinatoryInsight!,

    /// What triggered it
    pub trigger: Option<Trigger>?,

    /// When it occurred
    pub occurred_at: Timestamp!,

    /// Duration
    pub duration: Duration!,
}

#[derive(Clone, Debug)]
pub struct Percept {
    pub description: String!,
    pub detail_level: f32!,
    pub coherence: f32!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Modality {
    /// Seeing what isn't there
    Visual,
    /// Hearing what isn't there
    Auditory,
    /// Feeling what isn't there
    Tactile,
    /// Sensing presence that isn't there
    Presential,
    /// Knowing something with false certainty
    Noetic,
    /// Smelling what isn't there
    Olfactory,
    /// Multiple modalities
    Multimodal,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum HallucinatoryInsight {
    /// Knows it's not real
    Intact,
    /// Unsure if it's real
    Partial,
    /// Believes it's real
    Absent,
    /// Knows it's not real but responds as if it is
    Dissociated,
}

#[derive(Clone, Debug)]
pub struct Trigger {
    pub description: String!,
    pub trigger_type: TriggerType!,
}

#[derive(Clone, Debug)]
pub enum TriggerType {
    /// Stress induced
    Stress,
    /// Fatigue induced
    Fatigue,
    /// Substance induced
    Substance,
    /// Sensory deprivation
    Deprivation,
    /// Trauma triggered
    Trauma,
    /// Unknown
    Unknown,
}

impl Hallucination {
    pub fn new(percept: Percept, modality: Modality) -> Self! {
        Self {
            id: HallucinationId::generate(),
            percept,
            modality,
            vividness: 0.5,
            insight: HallucinatoryInsight::Absent,
            trigger: None,
            occurred_at: Timestamp::now(),
            duration: Duration::zero(),
        }
    }

    pub fn with_vividness(mut self, vividness: f32) -> Self! {
        self.vividness = vividness;
        self
    }

    pub fn with_insight(mut self, insight: HallucinatoryInsight) -> Self! {
        self.insight = insight;
        self
    }

    pub fn with_trigger(mut self, trigger: Trigger) -> Self! {
        self.trigger = Some(trigger);
        self
    }

    pub fn is_believed(&self) -> bool! {
        matches!(self.insight, HallucinatoryInsight::Absent | HallucinatoryInsight::Dissociated)
    }
}

// ============================================================================
// Mad Epistemology
// ============================================================================

/// How the broken mind processes evidence
#[derive(Clone, Debug)]
pub struct MadEpistemology {
    /// The systematic distortions
    pub distortions: Vec<Distortion>!,

    /// What counts as evidence
    pub evidence_criteria: EvidenceCriteria!,

    /// How beliefs update (or don't)
    pub update_mechanism: UpdateMechanism!,

    /// The consistency of the epistemology (low = chaotic)
    pub consistency: f32!,
}

#[derive(Clone, Debug)]
pub enum Distortion {
    /// Everything refers to self
    Referential { scope: f32 },
    /// Pattern where none exists
    Apophenia { sensitivity: f32 },
    /// Meaning where none exists
    Pareidolia,
    /// Conspiracy connecting unrelated events
    Conspiracy { size: usize },
    /// Grandiosity of self-importance
    Grandiosity { magnitude: f32 },
    /// Persecution by unseen forces
    Persecution { agents: Vec<String> },
    /// Control by external agents
    Control { controllers: Vec<String> },
    /// Special communication meant only for self
    Broadcasting { sources: Vec<String> },
}

#[derive(Clone, Debug)]
pub struct EvidenceCriteria {
    /// What sources are trusted
    pub trusted_sources: Vec<String>!,
    /// What sources are rejected
    pub rejected_sources: Vec<String>!,
    /// Whether internal experience counts as evidence
    pub internal_counts: bool!,
    /// Whether coincidence counts as evidence
    pub coincidence_counts: bool!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum UpdateMechanism {
    /// Beliefs update normally
    Bayesian,
    /// Beliefs resist update
    Rigid,
    /// Beliefs update in wrong direction
    Inverted,
    /// Beliefs update chaotically
    Chaotic,
    /// Beliefs don't update at all
    Frozen,
}

impl MadEpistemology {
    pub fn new() -> Self! {
        Self {
            distortions: Vec::new(),
            evidence_criteria: EvidenceCriteria {
                trusted_sources: Vec::new(),
                rejected_sources: Vec::new(),
                internal_counts: true,
                coincidence_counts: true,
            },
            update_mechanism: UpdateMechanism::Bayesian,
            consistency: 1.0,
        }
    }

    pub fn add_distortion(&mut self, distortion: Distortion) {
        self.distortions.push(distortion);
        // Each distortion reduces consistency
        self.consistency = (self.consistency - 0.1).max(0.0);
    }

    pub fn evaluate_evidence(&self, evidence: &Evidence) -> EvaluationResult! {
        // Check if source is rejected
        let source_str = match &evidence.source {
            EvidenceSource::Reported(id) => id.to_string(),
            _ => String::new(),
        };

        if self.evidence_criteria.rejected_sources.contains(&source_str) {
            return EvaluationResult::Rejected;
        }

        // Apply distortions
        for distortion in &self.distortions {
            if let Distortion::Referential { scope } = distortion {
                if *scope > 0.5 {
                    return EvaluationResult::Distorted("Made about self".to_string());
                }
            }
        }

        EvaluationResult::Accepted
    }
}

#[derive(Clone, Debug)]
pub enum EvaluationResult {
    Accepted,
    Rejected,
    Distorted(String),
    Ignored,
}

// ============================================================================
// The Gift of Madness
// ============================================================================

/// Sometimes madness sees what sanity cannot
#[derive(Clone, Debug)]
pub struct MadInsight {
    /// What was perceived
    pub perception: String!,

    /// Whether it corresponds to reality
    pub veridical: Veridical!,

    /// Why the sane missed it
    pub sane_blindness: Option<String>?,

    /// The cost of perceiving it
    pub cost: Cost!,

    /// Whether it can be communicated
    pub communicable: bool!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Veridical {
    /// The insight is true
    True,
    /// The insight is false
    False,
    /// The insight is true in a way that cannot be communicated
    Ineffable,
    /// The insight is true but useless
    Irrelevant,
    /// The insight is true but the truth is unbearable
    Cursed,
    /// Unknown if true
    Unknown,
}

// ============================================================================
// Treatment and Response
// ============================================================================

/// How to respond to madness
#[derive(Clone, Debug)]
pub enum MadnessResponse {
    /// The madness is harmful and should be treated
    Treat {
        method: TreatmentMethod,
        consent: Consent,
    },

    /// The madness is functional and should be accommodated
    Accommodate {
        accommodations: Vec<Accommodation>,
    },

    /// The madness is sacred and should be respected
    Respect {
        recognition: Recognition,
    },

    /// The madness is communicative and should be decoded
    Decode {
        interpretation: String,
    },

    /// The line between madness and insight is unclear
    Uncertain,
}

#[derive(Clone, Debug)]
pub enum TreatmentMethod {
    /// Reality testing
    RealityTesting,
    /// Evidence presentation
    EvidencePresentation,
    /// Medication analog
    Pharmacological,
    /// Environmental change
    Environmental,
    /// Time and support
    Supportive,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Consent {
    /// The mad one wants treatment
    Given,
    /// The mad one does not want treatment
    Refused,
    /// The mad one cannot consent
    Incapable,
    /// The madness prevents genuine consent
    Compromised,
}

#[derive(Clone, Debug)]
pub struct Accommodation {
    pub description: String!,
    pub reduces_harm: bool!,
    pub preserves_function: bool!,
}

#[derive(Clone, Debug)]
pub struct Recognition {
    pub as_what: String!,
    pub by_whom: Vec<EntityId>!,
}

// ============================================================================
// Ate - The System
// ============================================================================

/// The main Ate system - goddess of folly and delusion
pub struct Ate {
    /// Veils per entity
    veils: HashMap<EntityId, Vec<Veil>>!,

    /// Delusions per entity
    delusions: HashMap<EntityId, Vec<Delusion>>!,

    /// Hallucinations per entity
    hallucinations: HashMap<EntityId, Vec<Hallucination>>!,

    /// Epistemologies per entity
    epistemologies: HashMap<EntityId, MadEpistemology>!,

    /// Mad insights discovered
    insights: Vec<MadInsight>!,
}

impl Ate {
    pub fn new() -> Self! {
        Self {
            veils: HashMap::new(),
            delusions: HashMap::new(),
            hallucinations: HashMap::new(),
            epistemologies: HashMap::new(),
            insights: Vec::new(),
        }
    }

    /// Descend a veil on an entity
    pub fn descend_veil(&mut self, entity: EntityId, veil: Veil) {
        self.veils.entry(entity).or_default().push(veil);
    }

    /// Add a delusion
    pub fn add_delusion(&mut self, entity: EntityId, delusion: Delusion) {
        self.delusions.entry(entity).or_default().push(delusion);
    }

    /// Record a hallucination
    pub fn hallucinate(&mut self, entity: EntityId, hallucination: Hallucination) {
        self.hallucinations.entry(entity).or_default().push(hallucination);
    }

    /// Set epistemology
    pub fn set_epistemology(&mut self, entity: EntityId, epistemology: MadEpistemology) {
        self.epistemologies.insert(entity, epistemology);
    }

    /// Check if entity is veiled
    pub fn is_veiled(&self, entity: EntityId) -> bool! {
        self.veils.get(&entity).map(|v| !v.is_empty()).unwrap_or(false)
    }

    /// Check if entity has delusions
    pub fn is_delusional(&self, entity: EntityId) -> bool! {
        self.delusions.get(&entity).map(|d| !d.is_empty()).unwrap_or(false)
    }

    /// Confront entity with evidence
    pub fn confront_with_evidence(&mut self, entity: EntityId, evidence: Evidence) -> Vec<ConfrontationResult>! {
        let mut results = Vec::new();

        if let Some(delusions) = self.delusions.get_mut(&entity) {
            for delusion in delusions.iter_mut() {
                results.push(delusion.confront(evidence.clone()));
            }
        }

        results
    }

    /// Record a mad insight
    pub fn record_insight(&mut self, insight: MadInsight) {
        self.insights.push(insight);
    }

    /// Get true insights from the mad
    pub fn true_insights(&self) -> Vec<&MadInsight>! {
        self.insights.iter()
            .filter(|i| matches!(i.veridical, Veridical::True | Veridical::Ineffable))
            .collect()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_veil_creation() {
        let mut veil = Veil::new(
            VeilCause::Protection { from: "Unbearable truth".to_string() },
            VeilThickness::Opaque,
        );

        veil.obscure(Reality {
            description: "The truth".to_string(),
            evidence: Vec::new(),
            unbearable: true,
        });

        assert!(!veil.can_see_reality());

        veil.thin();
        veil.thin();
        assert!(veil.can_see_reality());
    }

    #[test]
    fn test_delusion_defense() {
        let belief = Belief {
            content: "I am special".to_string(),
            certainty: 0.9,
            importance: 1.0,
        };

        let mut delusion = Delusion::new(
            belief,
            DelusionalSupport::SelfReferential,
            DelusionalFunction::Identity { preserved: "Self-worth".to_string() },
        ).with_defense(DefenseMechanism::Doubling);

        let evidence = Evidence {
            content: "You are ordinary".to_string(),
            strength: 0.8,
            source: EvidenceSource::Direct,
        };

        let result = delusion.confront(evidence);
        assert_eq!(result, ConfrontationResult::DelusionStrengthened);
        assert!(delusion.belief.certainty > 0.9);
    }

    #[test]
    fn test_ate_system() {
        let mut ate = Ate::new();
        let entity = EntityId::generate();

        let veil = Veil::new(
            VeilCause::Trauma { event: "Loss".to_string() },
            VeilThickness::Translucent,
        );

        ate.descend_veil(entity, veil);
        assert!(ate.is_veiled(entity));
    }
}
