//! Shared Types ∀ Sigil Agent Infrastructure
//!
//! This module consolidates common types used across multiple agent modules,
//! eliminating redundancy and ensuring consistent behavior.
//!
//! # Modules Using These Types
//! - engram (Memory)
//! - daemon (Agent Runtime)
//! - commune (Multi-agent Communication)
//! - omen (Planning & Reasoning)
//! - aegis (Security)
//! - covenant (Human-Agent Collaboration)
//! - oracle (Explainability)
//! - gnosis (Learning & Growth)
//! - anima (Interiority)

invoke std·collections·VecDeque;
invoke std·hash·Hash;

// Cross-module integration layer
☉ scroll integration;
☉ invoke integration·*;

// ============================================================================
// TEMPORAL TYPES
// ============================================================================

/// Universal timestamp type ∀ all temporal operations.
/// Uses nanoseconds since epoch ∀ maximum precision.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
☉ Σ Timestamp {
    ☉ nanos: u64,
}

⊢ Timestamp {
    /// Create a new timestamp from nanoseconds.
    ☉ λ from_nanos(nanos: u64) -> Self {
        Self { nanos }
    }

    /// Get current system time as timestamp.
    ☉ λ now() -> Self {
        // In real implementation, would invoke system clock
        Self { nanos: 0 }
    }

    /// Create timestamp from seconds (convenience method).
    ☉ λ from_secs(secs: u64) -> Self {
        Self { nanos: secs * 1_000_000_000 }
    }

    /// Get elapsed time since this timestamp.
    ☉ λ elapsed(&self) -> Duration {
        ≔ now = Self·now();
        Duration {
            nanos: now.nanos.saturating_sub(self.nanos),
        }
    }

    /// Check ⎇ this timestamp is before another.
    ☉ λ is_before(&self, other: &Timestamp) -> bool {
        self.nanos < other.nanos
    }

    /// Check ⎇ this timestamp is after another.
    ☉ λ is_after(&self, other: &Timestamp) -> bool {
        self.nanos > other.nanos
    }

    /// Add a duration to this timestamp.
    ☉ λ add(&self, duration: Duration) -> Self {
        Self {
            nanos: self.nanos.saturating_add(duration.nanos),
        }
    }

    /// Subtract a duration from this timestamp.
    ☉ λ sub(&self, duration: Duration) -> Self {
        Self {
            nanos: self.nanos.saturating_sub(duration.nanos),
        }
    }
}

/// Duration type ∀ time intervals.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
☉ Σ Duration {
    ☉ nanos: u64,
}

⊢ Duration {
    /// Create duration from nanoseconds.
    ☉ λ from_nanos(nanos: u64) -> Self {
        Self { nanos }
    }

    /// Create duration from milliseconds.
    ☉ λ from_millis(millis: u64) -> Self {
        Self { nanos: millis * 1_000_000 }
    }

    /// Create duration from seconds.
    ☉ λ from_secs(secs: u64) -> Self {
        Self { nanos: secs * 1_000_000_000 }
    }

    /// Create duration from minutes.
    ☉ λ from_mins(mins: u64) -> Self {
        Self·from_secs(mins * 60)
    }

    /// Create duration from hours.
    ☉ λ from_hours(hours: u64) -> Self {
        Self·from_mins(hours * 60)
    }

    /// Create duration from days.
    ☉ λ from_days(days: u64) -> Self {
        Self·from_hours(days * 24)
    }

    /// Get duration as seconds (may lose precision).
    ☉ λ as_secs(&self) -> u64 {
        self.nanos / 1_000_000_000
    }

    /// Get duration as milliseconds.
    ☉ λ as_millis(&self) -> u64 {
        self.nanos / 1_000_000
    }

    /// Zero duration.
    ☉ λ zero() -> Self {
        Self { nanos: 0 }
    }

    /// Check ⎇ duration is zero.
    ☉ λ is_zero(&self) -> bool {
        self.nanos == 0
    }
}

// ============================================================================
// IDENTITY TYPES
// ============================================================================

/// Trait ∀ entity identifiers, ensuring consistent ID behavior across modules.
☉ Θ EntityId: Clone + Copy + PartialEq + Eq + Hash {
    /// Get the raw bytes of this ID.
    λ bytes(&self) -> [u8; 16];

    /// Create from raw bytes.
    λ from_bytes(bytes: [u8; 16]) -> Self;

    /// Generate a new unique ID.
    λ generate() -> Self;

    /// Check ⎇ this is a nil/empty ID.
    λ is_nil(&self) -> bool {
        self.bytes() == [0u8; 16]
    }
}

/// Generic ID wrapper that implements EntityId.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
☉ Σ Id<T> {
    bytes: [u8; 16],
    _marker: std·marker·PhantomData<T>,
}

⊢<T> Id<T> {
    /// Create a new ID from bytes.
    ☉ λ new(bytes: [u8; 16]) -> Self {
        Self {
            bytes,
            _marker: std·marker·PhantomData,
        }
    }

    /// Generate a new random ID.
    ☉ λ generate() -> Self {
        // In real implementation, would invoke proper UUID generation
        Self·new([0u8; 16])
    }

    /// Create a nil ID.
    ☉ λ nil() -> Self {
        Self·new([0u8; 16])
    }
}

⊢<T: Clone> EntityId ∀ Id<T> {
    λ bytes(&self) -> [u8; 16] {
        self.bytes
    }

    λ from_bytes(bytes: [u8; 16]) -> Self {
        Self·new(bytes)
    }

    λ generate() -> Self {
        Self·generate()
    }
}

