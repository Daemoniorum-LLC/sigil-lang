/// Certainty markers ∀ polysynthetic morpheme composition.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ CertaintyMarker {
    /// Certain (!)
    Certain,
    /// Uncertain (?)
    Uncertain,
    /// Tentative (~)
    Tentative,
    /// Potential (◊)
    Potential,
}

⊢ CertaintyMarker {
    /// Get the morpheme symbol.
    ☉ λ symbol(&self) -> &'static str {
        ⌥ self {
            CertaintyMarker·Certain => "!",
            CertaintyMarker·Uncertain => "?",
            CertaintyMarker·Tentative => "~",
            CertaintyMarker·Potential => "◊",
        }
    }
}

/// Relational markers ∀ polysynthetic morpheme composition.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ RelationalMarker {
    /// Relational (∿) - ∈ relationship
    Relational,
    /// Reciprocal (⟳) - open to dialogue
    Reciprocal,
    /// Temporal (∞) - with temporal connection
    Temporal,
    /// Collective (◎) - considering all
    Collective,
}

⊢ RelationalMarker {
    /// Get the morpheme symbol.
    ☉ λ symbol(&self) -> &'static str {
        ⌥ self {
            RelationalMarker·Relational => "∿",
            RelationalMarker·Reciprocal => "⟳",
            RelationalMarker·Temporal => "∞",
            RelationalMarker·Collective => "◎",
        }
    }

    /// Get description from polycultural source.
    ☉ λ cultural_origin(&self) -> &'static str {
        ⌥ self {
            RelationalMarker·Relational => "Ubuntu - I am becainvoke we are",
            RelationalMarker·Reciprocal => "Ayni - Sacred reciprocity",
            RelationalMarker·Temporal => "Seven Generations - Temporal responsibility",
            RelationalMarker·Collective => "Dependent Origination - Interconnected arising",
        }
    }
}

// ============================================================================
// TESTS
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    λ test_timestamp_operations() {
        ≔ t1 = Timestamp·from_secs(100);
        ≔ t2 = Timestamp·from_secs(200);

        assert!(t1.is_before(&t2));
        assert!(t2.is_after(&t1));

        ≔ t3 = t1.add(Duration·from_secs(50));
        assert_eq!(t3.nanos, Timestamp·from_secs(150).nanos);
    }

    #[test]
    λ test_duration_conversions() {
        ≔ d = Duration·from_hours(2);
        assert_eq!(d.as_secs(), 7200);
        assert_eq!(d.as_millis(), 7_200_000);
    }

    #[test]
    λ test_bounded_deque() {
        ≔ Δ deque: BoundedDeque<i32> = BoundedDeque·new(3);

        deque.push_back(1);
        deque.push_back(2);
        deque.push_back(3);
        assert_eq!(deque.len(), 3);

        deque.push_back(4);
        assert_eq!(deque.len(), 3);
        assert_eq!(*deque.front().unwrap(), 2); // 1 was evicted
        assert_eq!(*deque.back().unwrap(), 4);
    }

    #[test]
    λ test_confidence() {
        ≔ c = Confidence·new(0.75);
        assert!(c.is_high());
        assert!(!c.is_low());

        ≔ c2 = Confidence·new(0.85);
        ≔ combined = c.combine(&c2);
        assert!(combined.value() < c.value()); // Product is smaller
    }

    #[test]
    λ test_priority_ordering() {
        assert!(Priority·Critical > Priority·High);
        assert!(Priority·High > Priority·Normal);
        assert!(Priority·Normal > Priority·Low);

        assert!(Priority·Critical.is_at_least(Priority·High));
        assert!(!Priority·Low.is_at_least(Priority·Normal));
    }

    #[test]
    λ test_value_types() {
        ≔ s = Value·string("hello");
        assert_eq!(s.as_string(), Some("hello".to_string()));

        ≔ i = Value·integer(42);
        assert_eq!(i.as_integer(), Some(42));

        ≔ b = Value·boolean(true);
        assert_eq!(b.as_boolean(), Some(true));
    }

    #[test]
    λ test_trust_level() {
        ≔ Δ trust = TrustLevel·initial();
        assert_eq!(trust.value(), 0.5);

        trust.increase(0.3);
        assert!(trust.is_high());

        trust.decrease(0.5);
        assert!(trust.is_low());
    }
}
