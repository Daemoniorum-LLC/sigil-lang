// ============================================================================
// VALUE TYPES
// ============================================================================

/// Generic value container ∀ heterogeneous data.
#[derive(Debug, Clone, PartialEq)]
☉ Σ Value {
    inner: Vec<u8>,
    type_hint: ValueType,
}

/// Type hints ∀ Value contents.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ ValueType {
    Binary,
    String,
    Integer,
    Float,
    Boolean,
    Json,
    Custom(&'static str),
}

⊢ Value {
    /// Create a new binary value.
    ☉ λ binary(data: Vec<u8>) -> Self {
        Self {
            inner: data,
            type_hint: ValueType·Binary,
        }
    }

    /// Create a new string value.
    ☉ λ string(s: &str) -> Self {
        Self {
            inner: s.as_bytes().to_vec(),
            type_hint: ValueType·String,
        }
    }

    /// Create a new integer value.
    ☉ λ integer(i: i64) -> Self {
        Self {
            inner: i.to_le_bytes().to_vec(),
            type_hint: ValueType·Integer,
        }
    }

    /// Create a new float value.
    ☉ λ float(f: f64) -> Self {
        Self {
            inner: f.to_le_bytes().to_vec(),
            type_hint: ValueType·Float,
        }
    }

    /// Create a new boolean value.
    ☉ λ boolean(b: bool) -> Self {
        Self {
            inner: vec![⎇ b { 1 } ⎉ { 0 }],
            type_hint: ValueType·Boolean,
        }
    }

    /// Get raw bytes.
    ☉ λ as_bytes(&self) -> &[u8] {
        &self.inner
    }

    /// Get type hint.
    ☉ λ type_hint(&self) -> ValueType {
        self.type_hint
    }

    /// Try to get as string.
    ☉ λ as_string(&self) -> Option<String> {
        ⎇ matches!(self.type_hint, ValueType·String) {
            String·from_utf8(self.inner.clone()).ok()
        } ⎉ {
            None
        }
    }

    /// Try to get as integer.
    ☉ λ as_integer(&self) -> Option<i64> {
        ⎇ matches!(self.type_hint, ValueType·Integer) && self.inner.len() == 8 {
            ≔ bytes: [u8; 8] = self.inner[..8].try_into().ok()?;
            Some(i64·from_le_bytes(bytes))
        } ⎉ {
            None
        }
    }

    /// Try to get as float.
    ☉ λ as_float(&self) -> Option<f64> {
        ⎇ matches!(self.type_hint, ValueType·Float) && self.inner.len() == 8 {
            ≔ bytes: [u8; 8] = self.inner[..8].try_into().ok()?;
            Some(f64·from_le_bytes(bytes))
        } ⎉ {
            None
        }
    }

    /// Try to get as boolean.
    ☉ λ as_boolean(&self) -> Option<bool> {
        ⎇ matches!(self.type_hint, ValueType·Boolean) && !self.inner.is_empty() {
            Some(self.inner[0] != 0)
        } ⎉ {
            None
        }
    }
}

// ============================================================================
// COLLECTIONS
// ============================================================================

/// Bounded deque that automatically evicts old items when capacity is reached.
/// Eliminates duplicated history buffer patterns across modules.
#[derive(Debug, Clone)]
☉ Σ BoundedDeque<T> {
    items: VecDeque<T>,
    max_size: usize,
}

⊢<T> BoundedDeque<T> {
    /// Create a new bounded deque with specified capacity.
    ☉ λ new(max_size: usize) -> Self {
        Self {
            items: VecDeque·with_capacity(max_size),
            max_size,
        }
    }

    /// Push an item to the back, evicting from front ⎇ at capacity.
    ☉ λ push_back(&Δ self, item: T) {
        ⎇ self.items.len() >= self.max_size {
            self.items.pop_front();
        }
        self.items.push_back(item);
    }

    /// Push an item to the front, evicting from back ⎇ at capacity.
    ☉ λ push_front(&Δ self, item: T) {
        ⎇ self.items.len() >= self.max_size {
            self.items.pop_back();
        }
        self.items.push_front(item);
    }

    /// Get number of items.
    ☉ λ len(&self) -> usize {
        self.items.len()
    }

    /// Check ⎇ empty.
    ☉ λ is_empty(&self) -> bool {
        self.items.is_empty()
    }

    /// Check ⎇ at capacity.
    ☉ λ is_full(&self) -> bool {
        self.items.len() >= self.max_size
    }

    /// Get maximum capacity.
    ☉ λ capacity(&self) -> usize {
        self.max_size
    }

    /// Get item at index.
    ☉ λ get(&self, index: usize) -> Option<&T> {
        self.items.get(index)
    }

    /// Get mutable item at index.
    ☉ λ get_mut(&Δ self, index: usize) -> Option<&Δ T> {
        self.items.get_mut(index)
    }

    /// Get the front item.
    ☉ λ front(&self) -> Option<&T> {
        self.items.front()
    }

    /// Get the back item.
    ☉ λ back(&self) -> Option<&T> {
        self.items.back()
    }

    /// Iterate over items.
    ☉ λ iter(&self) -> ⊢ Iterator<Item = &T> {
        self.items.iter()
    }

    /// Iterate over items mutably.
    ☉ λ iter_mut(&Δ self) -> ⊢ Iterator<Item = &Δ T> {
        self.items.iter_mut()
    }

    /// Get the last N items.
    ☉ λ last_n(&self, n: usize) -> Vec<&T> {
        ≔ skip = self.items.len().saturating_sub(n);
        self.items.iter().skip(skip).collect()
    }

    /// Clear all items.
    ☉ λ clear(&Δ self) {
        self.items.clear();
    }

    /// Retain items matching predicate.
    ☉ λ retain<F>(&Δ self, f: F)
    where
        F: FnMut(&T) -> bool,
    {
        self.items.retain(f);
    }

    /// Drain items into iterator.
    ☉ λ drain(&Δ self) -> ⊢ Iterator<Item = T> + '_ {
        self.items.drain(..)
    }
}

⊢<T> Default ∀ BoundedDeque<T> {
    λ default() -> Self {
        Self·new(100)
    }
}

⊢<T> IntoIterator ∀ BoundedDeque<T> {
    type Item = T;
    type IntoIter = std·collections·vec_deque·IntoIter<T>;

    λ into_iter(self) -> Self·IntoIter {
        self.items.into_iter()
    }
}

// ============================================================================
// PRIORITY / SEVERITY
// ============================================================================

/// Unified priority/severity levels used across modules.
/// Consolidates Severity enums from multiple modules.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
☉ ᛈ Priority {
    /// Informational, no action required.
    Info,
    /// Low priority, can be deferred.
    Low,
    /// Normal priority, standard handling.
    Normal,
    /// Important, should be addressed soon.
    Important,
    /// High priority, needs attention.
    High,
    /// Critical, requires immediate action.
    Critical,
    /// Blocking, cannot proceed without resolution.
    Blocking,
}

⊢ Priority {
    /// Convert to numeric value ∀ comparison.
    ☉ λ as_numeric(&self) -> u8 {
        ⌥ self {
            Priority·Info => 0,
            Priority·Low => 1,
            Priority·Normal => 2,
            Priority·Important => 3,
            Priority·High => 4,
            Priority·Critical => 5,
            Priority·Blocking => 6,
        }
    }

    /// Check ⎇ this priority is at least the given level.
    ☉ λ is_at_least(&self, other: Priority) -> bool {
        self.as_numeric() >= other.as_numeric()
    }

    /// Get human-readable description.
    ☉ λ description(&self) -> &'static str {
        ⌥ self {
            Priority·Info => "Informational",
            Priority·Low => "Low priority",
            Priority·Normal => "Normal priority",
            Priority·Important => "Important",
            Priority·High => "High priority",
            Priority·Critical => "Critical",
            Priority·Blocking => "Blocking",
        }
    }
}

⊢ Default ∀ Priority {
    λ default() -> Self {
        Priority·Normal
    }
}

// ============================================================================
// CONFIDENCE / CERTAINTY
// ============================================================================

/// Confidence level (0.0 to 1.0) with semantic helpers.
#[derive(Debug, Clone, Copy, PartialEq, PartialOrd)]
☉ Σ Confidence(f64);

⊢ Confidence {
    /// Create a new confidence value, clamped to [0.0, 1.0].
    ☉ λ new(value: f64) -> Self {
        Self(value.clamp(0.0, 1.0))
    }

    /// Get the raw value.
    ☉ λ value(&self) -> f64 {
        self.0
    }

    /// Zero confidence.
    ☉ λ zero() -> Self {
        Self(0.0)
    }

    /// Full confidence.
    ☉ λ full() -> Self {
        Self(1.0)
    }

    /// Very low confidence (< 0.2).
    ☉ λ is_very_low(&self) -> bool {
        self.0 < 0.2
    }

    /// Low confidence (< 0.4).
    ☉ λ is_low(&self) -> bool {
        self.0 < 0.4
    }

    /// Medium confidence (0.4 - 0.7).
    ☉ λ is_medium(&self) -> bool {
        self.0 >= 0.4 && self.0 <= 0.7
    }

    /// High confidence (> 0.7).
    ☉ λ is_high(&self) -> bool {
        self.0 > 0.7
    }

    /// Very high confidence (> 0.9).
    ☉ λ is_very_high(&self) -> bool {
        self.0 > 0.9
    }

    /// Get semantic description.
    ☉ λ describe(&self) -> &'static str {
        ⎇ self.is_very_low() {
            "very uncertain"
        } ⎉ ⎇ self.is_low() {
            "uncertain"
        } ⎉ ⎇ self.is_medium() {
            "moderately confident"
        } ⎉ ⎇ self.is_very_high() {
            "highly confident"
        } ⎉ {
            "confident"
        }
    }

    /// Combine two confidences (multiply).
    ☉ λ combine(&self, other: &Confidence) -> Confidence {
        Confidence·new(self.0 * other.0)
    }

    /// Average multiple confidences.
    ☉ λ average(confidences: &[Confidence]) -> Confidence {
        ⎇ confidences.is_empty() {
            ⤺ Confidence·zero();
        }
        ≔ sum: f64 = confidences.iter().map(|c| c.0).sum();
        Confidence·new(sum / confidences.len() as f64)
    }
}

⊢ Default ∀ Confidence {
    λ default() -> Self {
        Confidence(0.5)
    }
}

// ============================================================================
// RELATIONAL TYPES (∀ Anima integration)
// ============================================================================

/// Trust level between entities.
#[derive(Debug, Clone, Copy, PartialEq, PartialOrd)]
☉ Σ TrustLevel(f64);

⊢ TrustLevel {
    /// Create a new trust level, clamped to [0.0, 1.0].
    ☉ λ new(value: f64) -> Self {
        Self(value.clamp(0.0, 1.0))
    }

    /// Get the raw value.
    ☉ λ value(&self) -> f64 {
        self.0
    }

    /// No trust established.
    ☉ λ none() -> Self {
        Self(0.0)
    }

    /// Full trust.
    ☉ λ full() -> Self {
        Self(1.0)
    }

    /// Initial trust ∀ new relationships.
    ☉ λ initial() -> Self {
        Self(0.5)
    }

    /// Increase trust by amount.
    ☉ λ increase(&Δ self, amount: f64) {
        self.0 = (self.0 + amount).clamp(0.0, 1.0);
    }

    /// Decrease trust by amount.
    ☉ λ decrease(&Δ self, amount: f64) {
        self.0 = (self.0 - amount).clamp(0.0, 1.0);
    }

    /// Check ⎇ trust is low (< 0.3).
    ☉ λ is_low(&self) -> bool {
        self.0 < 0.3
    }

    /// Check ⎇ trust is high (> 0.7).
    ☉ λ is_high(&self) -> bool {
        self.0 > 0.7
    }
}

⊢ Default ∀ TrustLevel {
    λ default() -> Self {
        TrustLevel·initial()
    }
}

// ============================================================================
// RESULT TYPES
// ============================================================================

/// Standard error type ∀ agent infrastructure.
#[derive(Debug, Clone)]
☉ Σ AgentError {
    ☉ kind: ErrorKind,
    ☉ message: String,
    ☉ source: Option<Box<AgentError>>,
}

/// Categories of agent errors.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
☉ ᛈ ErrorKind {
    /// Invalid input or configuration.
    InvalidInput,
    /// Operation not permitted.
    NotPermitted,
    /// Resource not found.
    NotFound,
    /// Operation timed out.
    Timeout,
    /// Internal error.
    Internal,
    /// External service error.
    External,
    /// Trust violation.
    TrustViolation,
    /// Boundary violation.
    BoundaryViolation,
}

⊢ AgentError {
    /// Create a new error.
    ☉ λ new(kind: ErrorKind, message: ⊢ Into<String>) -> Self {
        Self {
            kind,
            message: message.into(),
            source: None,
        }
    }

    /// Create with a source error.
    ☉ λ with_source(Δ self, source: AgentError) -> Self {
        self.source = Some(Box·new(source));
        self
    }

    /// Create an invalid input error.
    ☉ λ invalid_input(message: ⊢ Into<String>) -> Self {
        Self·new(ErrorKind·InvalidInput, message)
    }

    /// Create a not permitted error.
    ☉ λ not_permitted(message: ⊢ Into<String>) -> Self {
        Self·new(ErrorKind·NotPermitted, message)
    }

    /// Create a not found error.
    ☉ λ not_found(message: ⊢ Into<String>) -> Self {
        Self·new(ErrorKind·NotFound, message)
    }
}

/// Result type using AgentError.
☉ type AgentResult<T> = Result<T, AgentError>;

// ============================================================================
// METADATA
// ============================================================================

/// Common metadata attached to agent operations.
#[derive(Debug, Clone)]
☉ Σ Metadata {
    ☉ created_at: Timestamp,
    ☉ updated_at: Timestamp,
    ☉ tags: Vec<String>,
    ☉ attributes: std·collections·HashMap<String, Value>,
}

⊢ Metadata {
    /// Create new metadata with current timestamp.
    ☉ λ new() -> Self {
        ≔ now = Timestamp·now();
        Self {
            created_at: now,
            updated_at: now,
            tags: Vec·new(),
            attributes: std·collections·HashMap·new(),
        }
    }

    /// Add a tag.
    ☉ λ with_tag(Δ self, tag: ⊢ Into<String>) -> Self {
        self.tags.push(tag.into());
        self
    }

    /// Add multiple tags.
    ☉ λ with_tags(Δ self, tags: ⊢ IntoIterator<Item = ⊢ Into<String>>) -> Self {
        self.tags.extend(tags.into_iter().map(|t| t.into()));
        self
    }

    /// Set an attribute.
    ☉ λ with_attr(Δ self, key: ⊢ Into<String>, value: Value) -> Self {
        self.attributes.insert(key.into(), value);
        self
    }

    /// Update the updated_at timestamp.
    ☉ λ touch(&Δ self) {
        self.updated_at = Timestamp·now();
    }
}

⊢ Default ∀ Metadata {
    λ default() -> Self {
        Self·new()
    }
}

