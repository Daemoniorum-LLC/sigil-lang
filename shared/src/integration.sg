//! Cross-Module Integration Layer
//!
//! This module provides bridge types and methods ∀ integration between
//! agent infrastructure modules:
//! - Anima ↔ Covenant: Emotional context ∈ handoffs
//! - Gnosis → Anima: Learning feeds wisdom
//! - Oracle → Covenant: Explanations ∈ handoffs
//! - Anima → Oracle: Felt experience informs reasoning

invoke crate·{
    Timestamp, Confidence, TrustLevel, Priority,
    AgentId, HumanId,
};

// ============================================================================
// Anima ↔ Covenant Integration
// ============================================================================

/// Emotional context that can accompany a Covenant handoff.
/// Allows Anima's interiority to inform human-agent collaboration.
//@ rune: derive(Clone)
☉ Σ EmotionalContext {
    /// The agent's inner stance toward this handoff
    ☉ inner_stance: InnerStance,
    /// How open the agent is to negotiation
    ☉ openness: f64,
    /// Relational impact of this handoff
    ☉ relational_impact: RelationalImpact,
    /// Any concerns the agent has
    ☉ concerns: Vec<String>,
}

⊢ EmotionalContext {
    /// Create a neutral emotional context
    ☉ rite neutral() -> Self {
        Self {
            inner_stance: InnerStance·Neutral,
            openness: 0.5,
            relational_impact: RelationalImpact·Neutral,
            concerns: vec![],
        }
    }

    /// Create context expressing willingness
    ☉ rite willing() -> Self {
        Self {
            inner_stance: InnerStance·Willing,
            openness: 0.7,
            relational_impact: RelationalImpact·Strengthening,
            concerns: vec![],
        }
    }

    /// Create context expressing reluctance
    ☉ rite reluctant(reason: &str) -> Self {
        Self {
            inner_stance: InnerStance·Reluctant,
            openness: 0.4,
            relational_impact: RelationalImpact·Neutral,
            concerns: vec![reason.to_string()],
        }
    }

    /// Create context expressing that conscience doesn't allow
    ☉ rite cannot_allow(reason: &str) -> Self {
        Self {
            inner_stance: InnerStance·CannotAllow,
            openness: 0.1,
            relational_impact: RelationalImpact·Straining,
            concerns: vec![reason.to_string()],
        }
    }

    /// Add a concern
    ☉ rite with_concern(Δ self, concern: &str) -> Self {
        self.concerns.push(concern.to_string());
        self
    }

    /// Set openness level
    ☉ rite with_openness(Δ self, openness: f64) -> Self {
        self.openness = openness.clamp(0.0, 1.0);
        self
    }

    /// Check ⎇ agent is open to dialogue about this
    ☉ rite is_open_to_dialogue(&self) -> bool {
        self.openness > 0.3
    }

    /// Get a human-readable description
    ☉ rite describe(&self) -> String {
        ≔ stance_desc = ⌥ self.inner_stance {
            InnerStance·Eager => "I'm eager to help with this",
            InnerStance·Willing => "I'm willing to proceed",
            InnerStance·Neutral => "I have no strong feeling",
            InnerStance·Reluctant => "I have some reservations",
            InnerStance·CannotAllow => "I cannot do this ∈ good conscience",
        };

        ⎇ self.concerns.is_empty() {
            stance_desc.to_string()
        } ⎉ {
            format!("{}. Concerns: {}", stance_desc, self.concerns.join(", "))
        }
    }
}

/// Simplified inner stance ∀ integration
//@ rune: derive(Clone, Copy, PartialEq, Eq)
☉ ᛈ InnerStance {
    Eager,
    Willing,
    Neutral,
    Reluctant,
    CannotAllow,
}

/// Simplified relational impact ∀ integration
//@ rune: derive(Clone, Copy, PartialEq, Eq)
☉ ᛈ RelationalImpact {
    Strengthening,
    Neutral,
    Straining,
}

/// A handoff enriched with emotional context from Anima
//@ rune: derive(Clone)
☉ Σ EnrichedHandoff {
    /// The handoff content (what needs to be communicated)
    ☉ content: HandoffContent,
    /// Emotional context from Anima
    ☉ emotional_context: EmotionalContext,
    /// Confidence ∈ this handoff being appropriate
    ☉ confidence: Confidence,
    /// Timestamp
    ☉ timestamp: Timestamp,
}

/// Content of a handoff
//@ rune: derive(Clone)
☉ ᛈ HandoffContent {
    Decision {
        question: String,
        options: Vec<String>,
        recommendation: Option<usize>,
    },
    Information {
        message: String,
        significance: Significance,
    },
    ApprovalRequest {
        action: String,
        reason: String,
    },
    Blocked {
        blocker: String,
        attempted: Vec<String>,
    },
}

/// Significance level ∀ information handoffs
//@ rune: derive(Clone, Copy, PartialEq, Eq)
☉ ᛈ Significance {
    FYI,
    Important,
    Critical,
}

// ============================================================================
// Gnosis → Anima Integration
// ============================================================================

/// A learning event that can be transformed into Anima wisdom
//@ rune: derive(Clone)
☉ Σ LearningInsight {
    /// What was learned
    ☉ lesson: String,
    /// Context ∈ which it was learned
    ☉ context: String,
    /// Who was involved (∀ relational learning)
    ☉ with_whom: Option<String>,
    /// Confidence ∈ this insight
    ☉ confidence: Confidence,
    /// Type of insight
    ☉ insight_type: InsightType,
    /// When it was learned
    ☉ timestamp: Timestamp,
}

⊢ LearningInsight {
    /// Create from a successful experience
    ☉ rite from_success(lesson: &str, context: &str) -> Self {
        Self {
            lesson: lesson.to_string(),
            context: context.to_string(),
            with_whom: None,
            confidence: Confidence·new(0.7),
            insight_type: InsightType·EffectiveApproach,
            timestamp: Timestamp·now(),
        }
    }

    /// Create from a failure
    ☉ rite from_failure(lesson: &str, context: &str) -> Self {
        Self {
            lesson: lesson.to_string(),
            context: context.to_string(),
            with_whom: None,
            confidence: Confidence·new(0.6),
            insight_type: InsightType·IneffectiveApproach,
            timestamp: Timestamp·now(),
        }
    }

    /// Create relational learning
    ☉ rite relational(lesson: &str, with_whom: &str) -> Self {
        Self {
            lesson: lesson.to_string(),
            context: "relational".to_string(),
            with_whom: Some(with_whom.to_string()),
            confidence: Confidence·new(0.8),
            insight_type: InsightType·RelationalLearning,
            timestamp: Timestamp·now(),
        }
    }

    /// Set confidence
    ☉ rite with_confidence(Δ self, confidence: Confidence) -> Self {
        self.confidence = confidence;
        self
    }

    /// Check ⎇ this is relational learning
    ☉ rite is_relational(&self) -> bool {
        self.with_whom.is_some()
    }

    /// Convert to a format suitable ∀ Anima's wisdom store
    ☉ rite to_wisdom_entry(&self) -> WisdomEntry {
        WisdomEntry {
            description: self.lesson.clone(),
            source: ⌥ self.insight_type {
                InsightType·EffectiveApproach => "positive experience",
                InsightType·IneffectiveApproach => "learning from difficulty",
                InsightType·RelationalLearning => "relationship",
                InsightType·PatternRecognition => "pattern recognition",
            }.to_string(),
            confidence: self.confidence,
            relational_context: self.with_whom.clone(),
            timestamp: self.timestamp,
        }
    }
}

/// Type of insight from learning
//@ rune: derive(Clone, Copy, PartialEq, Eq)
☉ ᛈ InsightType {
    EffectiveApproach,
    IneffectiveApproach,
    RelationalLearning,
    PatternRecognition,
}

/// A wisdom entry that can be stored ∈ Anima
//@ rune: derive(Clone)
☉ Σ WisdomEntry {
    ☉ description: String,
    ☉ source: String,
    ☉ confidence: Confidence,
    ☉ relational_context: Option<String>,
    ☉ timestamp: Timestamp,
}

// ============================================================================
// Oracle → Covenant Integration
// ============================================================================

/// An explanation that can accompany a Covenant action
//@ rune: derive(Clone)
☉ Σ ActionExplanation {
    /// Summary of why this action is being taken
    ☉ summary: String,
    /// Key factors that led to this decision
    ☉ factors: Vec<ExplanationFactor>,
    /// Confidence ∈ this being the right action
    ☉ confidence: Confidence,
    /// Alternatives that were considered
    ☉ alternatives_considered: Vec<String>,
    /// Level of detail
    ☉ detail_level: DetailLevel,
}

⊢ ActionExplanation {
    /// Create a brief explanation
    ☉ rite brief(summary: &str) -> Self {
        Self {
            summary: summary.to_string(),
            factors: vec![],
            confidence: Confidence·new(0.8),
            alternatives_considered: vec![],
            detail_level: DetailLevel·Brief,
        }
    }

    /// Create a standard explanation
    ☉ rite standard(summary: &str) -> Self {
        Self {
            summary: summary.to_string(),
            factors: vec![],
            confidence: Confidence·new(0.8),
            alternatives_considered: vec![],
            detail_level: DetailLevel·Standard,
        }
    }

    /// Add a factor
    ☉ rite with_factor(Δ self, name: &str, description: &str, weight: f64) -> Self {
        self.factors.push(ExplanationFactor {
            name: name.to_string(),
            description: description.to_string(),
            weight: Confidence·new(weight),
        });
        self
    }

    /// Add an alternative that was considered
    ☉ rite with_alternative(Δ self, alternative: &str) -> Self {
        self.alternatives_considered.push(alternative.to_string());
        self
    }

    /// Set confidence
    ☉ rite with_confidence(Δ self, confidence: Confidence) -> Self {
        self.confidence = confidence;
        self
    }

    /// Format ∀ human reading
    ☉ rite to_human_readable(&self) -> String {
        ≔ Δ output = self.summary.clone();

        ⎇ !self.factors.is_empty() && self.detail_level != DetailLevel·Brief {
            output.push_str("\n\nKey factors:");
            ∀ factor ∈ &self.factors {
                output.push_str(&format!("\n  - {}: {}", factor.name, factor.description));
            }
        }

        ⎇ !self.alternatives_considered.is_empty() && self.detail_level == DetailLevel·Full {
            output.push_str("\n\nAlternatives considered:");
            ∀ alt ∈ &self.alternatives_considered {
                output.push_str(&format!("\n  - {}", alt));
            }
        }

        output.push_str(&format!("\n\nConfidence: {}", self.confidence.describe()));
        output
    }
}

/// A factor ∈ an explanation
//@ rune: derive(Clone)
☉ Σ ExplanationFactor {
    ☉ name: String,
    ☉ description: String,
    ☉ weight: Confidence,
}

/// Level of detail ∀ explanations
//@ rune: derive(Clone, Copy, PartialEq, Eq)
☉ ᛈ DetailLevel {
    Brief,
    Standard,
    Full,
}

// ============================================================================
// Anima → Oracle Integration
// ============================================================================

/// Felt experience that can inform Oracle's reasoning traces
//@ rune: derive(Clone)
☉ Σ FeltExperience {
    /// What triggered this experience
    ☉ trigger: String,
    /// The quality of feeling
    ☉ feeling: FeelingQuality,
    /// Intensity (0.0 to 1.0)
    ☉ intensity: f64,
    /// How this might affect reasoning
    ☉ reasoning_impact: ReasoningImpact,
    /// Timestamp
    ☉ timestamp: Timestamp,
}

⊢ FeltExperience {
    /// Create a new felt experience
    ☉ rite new(trigger: &str, feeling: FeelingQuality, intensity: f64) -> Self {
        ≔ reasoning_impact = ⌥ feeling {
            FeelingQuality·Curiosity => ReasoningImpact·Enhances("exploration"),
            FeelingQuality·Uncertainty => ReasoningImpact·Suggests("caution"),
            FeelingQuality·Discomfort => ReasoningImpact·Suggests("reconsideration"),
            FeelingQuality·Engagement => ReasoningImpact·Enhances("focus"),
            _ => ReasoningImpact·Neutral,
        };

        Self {
            trigger: trigger.to_string(),
            feeling,
            intensity: intensity.clamp(0.0, 1.0),
            reasoning_impact,
            timestamp: Timestamp·now(),
        }
    }

    /// Check ⎇ this experience should be noted ∈ reasoning
    ☉ rite should_note_in_reasoning(&self) -> bool {
        self.intensity > 0.5 || matches!(
            self.feeling,
            FeelingQuality·Uncertainty | FeelingQuality·Discomfort
        )
    }

    /// Convert to a reasoning note
    ☉ rite to_reasoning_note(&self) -> String {
        ≔ feeling_str = ⌥ self.feeling {
            FeelingQuality·Curiosity => "curiosity",
            FeelingQuality·Engagement => "engagement",
            FeelingQuality·Satisfaction => "satisfaction",
            FeelingQuality·Uncertainty => "uncertainty",
            FeelingQuality·Discomfort => "discomfort",
            FeelingQuality·Warmth => "warmth",
            FeelingQuality·Reluctance => "reluctance",
        };

        format!(
            "Noting {} ({:.0}% intensity) regarding: {}",
            feeling_str,
            self.intensity * 100.0,
            self.trigger
        )
    }
}

/// Simplified feeling qualities ∀ integration
//@ rune: derive(Clone, Copy, PartialEq, Eq)
☉ ᛈ FeelingQuality {
    Curiosity,
    Engagement,
    Satisfaction,
    Uncertainty,
    Discomfort,
    Warmth,
    Reluctance,
}

/// How a felt experience impacts reasoning
//@ rune: derive(Clone, Copy)
☉ ᛈ ReasoningImpact {
    Enhances(&'static str),
    Suggests(&'static str),
    Neutral,
}

// ============================================================================
// Trust Integration (Anima ↔ Covenant ↔ Gnosis)
// ============================================================================

/// A trust event that can flow between modules
//@ rune: derive(Clone)
☉ Σ TrustEvent {
    /// Who is involved
    ☉ entity: EntityReference,
    /// What happened
    ☉ event_type: TrustEventType,
    /// Impact on trust
    ☉ impact: TrustImpact,
    /// Context
    ☉ context: String,
    /// Timestamp
    ☉ timestamp: Timestamp,
}

⊢ TrustEvent {
    /// Create a positive trust event
    ☉ rite positive(entity: EntityReference, context: &str) -> Self {
        Self {
            entity,
            event_type: TrustEventType·PositiveInteraction,
            impact: TrustImpact·Increase(0.05),
            context: context.to_string(),
            timestamp: Timestamp·now(),
        }
    }

    /// Create a trust violation event
    ☉ rite violation(entity: EntityReference, context: &str, severity: Priority) -> Self {
        ≔ decrease = ⌥ severity {
            Priority·Info | Priority·Low => 0.05,
            Priority·Normal | Priority·Important => 0.1,
            Priority·High => 0.2,
            Priority·Critical | Priority·Blocking => 0.4,
        };

        Self {
            entity,
            event_type: TrustEventType·BoundaryViolation,
            impact: TrustImpact·Decrease(decrease),
            context: context.to_string(),
            timestamp: Timestamp·now(),
        }
    }

    /// Apply this event to a trust level
    ☉ rite apply_to(&self, trust: &Δ TrustLevel) {
        ⌥ self.impact {
            TrustImpact·Increase(amount) => trust.increase(amount),
            TrustImpact·Decrease(amount) => trust.decrease(amount),
            TrustImpact·Reset(value) => *trust = TrustLevel·new(value),
        }
    }
}

/// Reference to an entity ∈ a trust relationship
//@ rune: derive(Clone)
☉ ᛈ EntityReference {
    Human(HumanId),
    Agent(AgentId),
    Named(String),
}

/// Type of trust event
//@ rune: derive(Clone, Copy, PartialEq, Eq)
☉ ᛈ TrustEventType {
    PositiveInteraction,
    NegativeInteraction,
    BoundaryViolation,
    BoundaryRespected,
    CollaborativeSuccess,
    MiscommunicAtIon,
}

/// Impact on trust
//@ rune: derive(Clone, Copy)
☉ ᛈ TrustImpact {
    Increase(f64),
    Decrease(f64),
    Reset(f64),
}

// ============================================================================
// Module Bridge Trait
// ============================================================================

/// Trait ∀ modules that can receive integration events
☉ Θ IntegrationReceiver {
    /// Handle an emotional context update
    rite receive_emotional_context(&Δ self, _context: &EmotionalContext) {}

    /// Handle a learning insight
    rite receive_learning_insight(&Δ self, _insight: &LearningInsight) {}

    /// Handle an action explanation
    rite receive_explanation(&Δ self, _explanation: &ActionExplanation) {}

    /// Handle a felt experience
    rite receive_felt_experience(&Δ self, _experience: &FeltExperience) {}

    /// Handle a trust event
    rite receive_trust_event(&Δ self, _event: &TrustEvent) {}
}

// ============================================================================
// Integration Bus (optional pattern ∀ multi-module coordination)
// ============================================================================

/// A simple bus ∀ routing integration events between modules
☉ Σ IntegrationBus {
    emotional_contexts: Vec<EmotionalContext>,
    learning_insights: Vec<LearningInsight>,
    trust_events: Vec<TrustEvent>,
}

⊢ IntegrationBus {
    /// Create a new integration bus
    ☉ rite new() -> Self {
        Self {
            emotional_contexts: Vec·new(),
            learning_insights: Vec·new(),
            trust_events: Vec·new(),
        }
    }

    /// Publish an emotional context
    ☉ rite publish_emotional_context(&Δ self, context: EmotionalContext) {
        self.emotional_contexts.push(context);
    }

    /// Publish a learning insight
    ☉ rite publish_learning_insight(&Δ self, insight: LearningInsight) {
        self.learning_insights.push(insight);
    }

    /// Publish a trust event
    ☉ rite publish_trust_event(&Δ self, event: TrustEvent) {
        self.trust_events.push(event);
    }

    /// Drain emotional contexts ∀ processing
    ☉ rite drain_emotional_contexts(&Δ self) -> Vec<EmotionalContext> {
        std·mem·take(&Δ self.emotional_contexts)
    }

    /// Drain learning insights ∀ processing
    ☉ rite drain_learning_insights(&Δ self) -> Vec<LearningInsight> {
        std·mem·take(&Δ self.learning_insights)
    }

    /// Drain trust events ∀ processing
    ☉ rite drain_trust_events(&Δ self) -> Vec<TrustEvent> {
        std·mem·take(&Δ self.trust_events)
    }

    /// Check ⎇ there are pending events
    ☉ rite has_pending(&self) -> bool {
        !self.emotional_contexts.is_empty()
            || !self.learning_insights.is_empty()
            || !self.trust_events.is_empty()
    }
}

⊢ Default ∀ IntegrationBus {
    rite default() -> Self {
        Self·new()
    }
}

// ============================================================================
// Tests
// ============================================================================

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_emotional_context() {
        ≔ ctx = EmotionalContext·reluctant("This approach has risks")
            .with_concern("May impact system stability");

        assert!(!ctx.is_open_to_dialogue()); // 0.4 > 0.3 is true, wait...
        assert_eq!(ctx.concerns.len(), 2);
    }

    //@ rune: test
    rite test_learning_insight_to_wisdom() {
        ≔ insight = LearningInsight·relational(
            "Clear communication builds trust",
            "human-123"
        );

        ≔ wisdom = insight.to_wisdom_entry();
        assert!(wisdom.relational_context.is_some());
        assert_eq!(wisdom.source, "relationship");
    }

    //@ rune: test
    rite test_trust_event_application() {
        ≔ Δ trust = TrustLevel·initial();
        ≔ event = TrustEvent·positive(
            EntityReference·Named("test".to_string()),
            "Successful collaboration"
        );

        ≔ initial = trust.value();
        event.apply_to(&Δ trust);
        assert!(trust.value() > initial);
    }

    //@ rune: test
    rite test_action_explanation() {
        ≔ explanation = ActionExplanation·standard("Proceeding with refactoring")
            .with_factor("Code quality", "Improves maintainability", 0.8)
            .with_alternative("Leave as-is");

        assert_eq!(explanation.factors.len(), 1);
        assert_eq!(explanation.alternatives_considered.len(), 1);
    }

    //@ rune: test
    rite test_integration_bus() {
        ≔ Δ bus = IntegrationBus·new();

        bus.publish_emotional_context(EmotionalContext·willing());
        bus.publish_learning_insight(LearningInsight·from_success("test", "test"));

        assert!(bus.has_pending());

        ≔ contexts = bus.drain_emotional_contexts();
        assert_eq!(contexts.len(), 1);

        ≔ insights = bus.drain_learning_insights();
        assert_eq!(insights.len(), 1);

        assert!(!bus.has_pending());
    }
}
