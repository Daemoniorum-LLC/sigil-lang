// Aegis - Security Infrastructure Implementation
// Core security components ∀ AI agents

invoke std·collections·{HashMap, HashSet, VecDeque};
invoke std·sync·atomic·{AtomicBool, Ordering};
invoke std·sync·Arc;

invoke crate·types·*;

// ============================================================================
// Identity and Authentication
// ============================================================================

/// Cryptographic identity with capability attestation
☉ Σ Identity {
    /// Unique identifier
    ☉ id: AgentId,

    /// Public key ∀ verification
    ☉ public_key: PublicKey,

    /// Private key (never leaves agent)
    private_key: PrivateKey,

    /// Capability attestations
    ☉ attestations: Vec<Attestation>,

    /// Identity credential (signed by authority)
    ☉ credential: Option<Credential>,

    /// Creation time
    ☉ created: Timestamp,

    /// Expiration
    ☉ expires: Option<Timestamp>,
}

⊢ Identity {
    /// Generate new identity
    ☉ rite generate() -> IdentityBuilder {
        ≔ (public_key, private_key) = generate_keypair();

        IdentityBuilder {
            id: AgentId·new(),
            public_key,
            private_key,
            attestations: vec![],
        }
    }

    /// Sign data
    ☉ rite sign(&self, data: &[u8]) -> Signature {
        self.private_key.sign(data)
    }

    /// Verify signature from another identity
    ☉ rite verify(public_key: &PublicKey, data: &[u8], signature: &Signature) -> bool {
        public_key.verify(data, signature)
    }

    /// Check ⎇ identity has capability
    ☉ rite has_capability(&self, capability: &str) -> bool {
        self.attestations.iter()
            .any(|a| matches!(a, Attestation·Capability(c) ⎇ c == capability))
    }

    /// Check ⎇ identity has role
    ☉ rite has_role(&self, role: &Role) -> bool {
        self.attestations.iter()
            .any(|a| matches!(a, Attestation·Role(r) ⎇ role_matches(r, role)))
    }

    /// Get public key hash
    ☉ rite public_key_hash(&self) -> [u8; 32] {
        sha256(&self.public_key.bytes)
    }
}

⊢ Clone ∀ Identity {
    rite clone(&self) -> Self {
        Self {
            id: self.id.clone(),
            public_key: self.public_key.clone(),
            private_key: PrivateKey {
                bytes: [0u8; 64], // Don't clone private key
                algorithm: self.private_key.algorithm,
            },
            attestations: self.attestations.clone(),
            credential: self.credential.clone(),
            created: self.created,
            expires: self.expires,
        }
    }
}

/// Builder ∀ creating identities
☉ Σ IdentityBuilder {
    id: AgentId,
    public_key: PublicKey,
    private_key: PrivateKey,
    attestations: Vec<Attestation>,
}

⊢ IdentityBuilder {
    ☉ rite with_capability(Δ self, capability: &str) -> Self {
        self.attestations.push(Attestation·Capability(capability.to_string()));
        self
    }

    ☉ rite with_role(Δ self, role: Role) -> Self {
        self.attestations.push(Attestation·Role(role));
        self
    }

    ☉ rite with_group(Δ self, group: GroupId) -> Self {
        self.attestations.push(Attestation·GroupMembership(group));
        self
    }

    ☉ rite build(self) -> Identity {
        Identity {
            id: self.id,
            public_key: self.public_key,
            private_key: self.private_key,
            attestations: self.attestations,
            credential: None,
            created: Timestamp·now(),
            expires: None,
        }
    }
}

/// Identity verification service
☉ Σ IdentityVerifier {
    /// Trusted authorities
    trusted_authorities: HashMap<AuthorityId, PublicKey>,

    /// Revocation list
    revoked: HashSet<AgentId>,

    /// Verification cache
    cache: HashMap<AgentId, CachedVerification>,
}

Σ CachedVerification {
    result: VerifiedIdentity,
    cached_at: Timestamp,
    ttl: Duration,
}

⊢ IdentityVerifier {
    ☉ rite new() -> Self {
        Self {
            trusted_authorities: HashMap·new(),
            revoked: HashSet·new(),
            cache: HashMap·new(),
        }
    }

    /// Add a trusted authority
    ☉ rite trust_authority(&Δ self, id: AuthorityId, public_key: PublicKey) {
        self.trusted_authorities.insert(id, public_key);
    }

    /// Revoke an identity
    ☉ rite revoke(&Δ self, id: AgentId) {
        self.revoked.insert(id);
        self.cache.remove(&id);
    }

    /// Verify an identity credential
    ☉ rite verify(&Δ self, credential: &Credential) -> Result<VerifiedIdentity, VerificationError> {
        // Check cache first
        ⎇ ≔ Some(cached) = self.cache.get(&credential.identity_id) {
            ≔ now = Timestamp·now();
            ⎇ now.nanos < cached.cached_at.nanos + cached.ttl.as_nanos() {
                ⤺ Ok(cached.result.clone());
            }
        }

        // Check ⎇ revoked
        ⎇ self.revoked.contains(&credential.identity_id) {
            ⤺ Err(VerificationError·Revoked);
        }

        // Check expiration
        ≔ now = Timestamp·now();
        ⎇ now < credential.valid_from || now > credential.valid_until {
            ⤺ Err(VerificationError·Expired);
        }

        // Verify issuer signature
        ≔ authority_key = self.trusted_authorities.get(&credential.issuer)
            .ok_or(VerificationError·UntrustedIssuer)?;

        ≔ credential_bytes = credential.signable_bytes();
        ⎇ !authority_key.verify(&credential_bytes, &credential.signature) {
            ⤺ Err(VerificationError·InvalidSignature);
        }

        ≔ verified = VerifiedIdentity {
            id: credential.identity_id.clone(),
            attestations: credential.attestations.clone(),
            verified_at: now,
        };

        // Cache result
        self.cache.insert(credential.identity_id.clone(), CachedVerification {
            result: verified.clone(),
            cached_at: now,
            ttl: Duration·minutes(5),
        });

        Ok(verified)
    }

    /// Verify identity has required capabilities
    ☉ rite verify_capabilities(
        &Δ self,
        credential: &Credential,
        required: &[&str]
    ) -> Result<(), VerificationError> {
        ≔ verified = self.verify(credential)?;

        ∀ cap ∈ required {
            ≔ has_cap = verified.attestations.iter()
                .any(|a| matches!(a, Attestation·Capability(c) ⎇ c == *cap));
            ⎇ !has_cap {
                ⤺ Err(VerificationError·InvalidCredential);
            }
        }

        Ok(())
    }
}

⊢ Clone ∀ VerifiedIdentity {
    rite clone(&self) -> Self {
        Self {
            id: self.id.clone(),
            attestations: self.attestations.clone(),
            verified_at: self.verified_at,
        }
    }
}

rite role_matches(a: &Role, b: &Role) -> bool {
    ⌥ (a, b) {
        (Role·Admin, Role·Admin) => true,
        (Role·Operator, Role·Operator) => true,
        (Role·Agent, Role·Agent) => true,
        (Role·Observer, Role·Observer) => true,
        (Role·Custom(x), Role·Custom(y)) => x == y,
        _ => false,
    }
}

// ============================================================================
// Execution Containment (Sandbox)
// ============================================================================

/// Sandbox configuration
☉ Σ SandboxConfig {
    /// Resource limits
    ☉ limits: ResourceLimits,

    /// Isolation level
    ☉ isolation: IsolationLevel,

    /// Syscall filter
    ☉ syscall_filter: SyscallFilter,

    /// Network policy
    ☉ network: NetworkPolicy,

    /// Filesystem policy
    ☉ filesystem: FilesystemPolicy,

    /// Timeout
    ☉ timeout: Duration,
}

⊢ SandboxConfig {
    ☉ rite default() -> Self {
        Self {
            limits: ResourceLimits·default(),
            isolation: IsolationLevel·Process,
            syscall_filter: SyscallFilter·restrictive(),
            network: NetworkPolicy·Deny,
            filesystem: FilesystemPolicy·ReadOnly { write_exceptions: vec![] },
            timeout: Duration·minutes(5),
        }
    }

    ☉ rite permissive() -> Self {
        Self {
            limits: ResourceLimits·permissive(),
            isolation: IsolationLevel·Process,
            syscall_filter: SyscallFilter·permissive(),
            network: NetworkPolicy·Allow,
            filesystem: FilesystemPolicy·Allow,
            timeout: Duration·minutes(30),
        }
    }

    ☉ rite restrictive() -> Self {
        Self {
            limits: ResourceLimits·restrictive(),
            isolation: IsolationLevel·Container,
            syscall_filter: SyscallFilter·restrictive(),
            network: NetworkPolicy·Deny,
            filesystem: FilesystemPolicy·Deny,
            timeout: Duration·seconds(30),
        }
    }
}

/// Syscall filter
☉ Σ SyscallFilter {
    mode: FilterMode,
    syscalls: HashSet<String>,
}

⊢ SyscallFilter {
    ☉ rite allow_list(syscalls: &[&str]) -> Self {
        Self {
            mode: FilterMode·AllowList,
            syscalls: syscalls.iter().map(|s| s.to_string()).collect(),
        }
    }

    ☉ rite deny_list(syscalls: &[&str]) -> Self {
        Self {
            mode: FilterMode·DenyList,
            syscalls: syscalls.iter().map(|s| s.to_string()).collect(),
        }
    }

    ☉ rite restrictive() -> Self {
        Self·allow_list(&[
            "read", "write", "open", "close", "stat", "fstat",
            "mmap", "mprotect", "munmap", "brk",
            "clock_gettime", "getrandom",
        ])
    }

    ☉ rite permissive() -> Self {
        Self·deny_list(&[
            "fork", "vfork", "clone", "execve", "execveat",
            "ptrace", "process_vm_readv", "process_vm_writev",
        ])
    }

    ☉ rite is_allowed(&self, syscall: &str) -> bool {
        ⌥ self.mode {
            FilterMode·AllowList => self.syscalls.contains(syscall),
            FilterMode·DenyList => !self.syscalls.contains(syscall),
        }
    }
}

⊢ Clone ∀ SyscallFilter {
    rite clone(&self) -> Self {
        Self {
            mode: self.mode,
            syscalls: self.syscalls.clone(),
        }
    }
}

/// Sandbox ∀ safe execution
☉ Σ Sandbox {
    /// Configuration
    config: SandboxConfig,

    /// Resource tracking
    resources: ResourceTracker,

    /// Audit callback
    audit_fn: Option<Box<dyn Fn(SandboxEvent)>>,
}

/// Resource tracker
☉ Σ ResourceTracker {
    start_time: Timestamp,
    current: ResourceUsage,
    peak: ResourceUsage,
}

⊢ ResourceTracker {
    ☉ rite new() -> Self {
        Self {
            start_time: Timestamp·now(),
            current: ResourceUsage·zero(),
            peak: ResourceUsage·zero(),
        }
    }

    ☉ rite start_tracking(&Δ self) {
        self.start_time = Timestamp·now();
        self.current = ResourceUsage·zero();
    }

    ☉ rite update(&Δ self, usage: ResourceUsage) {
        self.current = usage;
        // Update peaks
        ⎇ usage.memory_bytes > self.peak.memory_bytes {
            self.peak.memory_bytes = usage.memory_bytes;
        }
        ⎇ usage.open_files > self.peak.open_files {
            self.peak.open_files = usage.open_files;
        }
    }

    ☉ rite stop(&self) -> ResourceUsage {
        ≔ Δ usage = self.current;
        usage.cpu_time = Duration·from_nanos(
            Timestamp·now().nanos - self.start_time.nanos
        );
        usage
    }
}

⊢ Duration {
    rite from_nanos(nanos: u64) -> Self {
        Self { nanos }
    }
}

/// Sandbox event ∀ auditing
☉ ᛈ SandboxEvent {
    Started { config: String },
    SyscallDenied { syscall: String },
    NetworkBlocked { host: String },
    FilesystemBlocked { path: String },
    ResourceLimitApproaching { resource: String, usage: f32 },
    Completed { usage: ResourceUsage },
    Timeout,
}

/// Sandbox execution result
☉ Σ SandboxResult {
    ☉ output: Value,
    ☉ resource_usage: ResourceUsage,
    ☉ duration: Duration,
}

⊢ Sandbox {
    ☉ rite new(config: SandboxConfig) -> Self {
        Self {
            config,
            resources: ResourceTracker·new(),
            audit_fn: None,
        }
    }

    ☉ rite with_audit<F: Fn(SandboxEvent) + 'static>(Δ self, f: F) -> Self {
        self.audit_fn = Some(Box·new(f));
        self
    }

    /// Check ⎇ syscall is allowed
    ☉ rite check_syscall(&self, syscall: &str) -> Result<(), SandboxError> {
        ⎇ self.config.syscall_filter.is_allowed(syscall) {
            Ok(())
        } ⎉ {
            self.emit_event(SandboxEvent·SyscallDenied {
                syscall: syscall.to_string()
            });
            Err(SandboxError·SyscallDenied(syscall.to_string()))
        }
    }

    /// Check ⎇ network access is allowed
    ☉ rite check_network(&self, host: &str) -> Result<(), SandboxError> {
        ≔ allowed = ⌥ &self.config.network {
            NetworkPolicy·Deny => false,
            NetworkPolicy·Allow => true,
            NetworkPolicy·AllowList(hosts) => hosts.iter().any(|h| host_matches(h, host)),
            NetworkPolicy·DenyList(hosts) => !hosts.iter().any(|h| host_matches(h, host)),
        };

        ⎇ allowed {
            Ok(())
        } ⎉ {
            self.emit_event(SandboxEvent·NetworkBlocked {
                host: host.to_string()
            });
            Err(SandboxError·NetworkDenied(host.to_string()))
        }
    }

    /// Check ⎇ filesystem access is allowed
    ☉ rite check_filesystem(&self, path: &str, write: bool) -> Result<(), SandboxError> {
        ≔ allowed = ⌥ &self.config.filesystem {
            FilesystemPolicy·Deny => false,
            FilesystemPolicy·Allow => true,
            FilesystemPolicy·ReadOnly { write_exceptions } => {
                ⎇ write {
                    write_exceptions.iter().any(|p| path_matches(p, path))
                } ⎉ {
                    true
                }
            }
            FilesystemPolicy·AllowList(patterns) => {
                patterns.iter().any(|p| {
                    path_matches(&p.pattern, path) &&
                    (!write || p.permissions.write)
                })
            }
        };

        ⎇ allowed {
            Ok(())
        } ⎉ {
            self.emit_event(SandboxEvent·FilesystemBlocked {
                path: path.to_string()
            });
            Err(SandboxError·FilesystemDenied(path.to_string()))
        }
    }

    /// Check resource usage against limits
    ☉ rite check_resources(&self, usage: &ResourceUsage) -> Result<(), SandboxError> {
        ⎇ usage.exceeds(&self.config.limits) {
            ⤺ Err(SandboxError·ResourceLimitExceeded(usage.clone()));
        }

        // Warn at 80% usage
        ≔ memory_ratio = usage.memory_bytes as f32 / self.config.limits.max_memory as f32;
        ⎇ memory_ratio > 0.8 {
            self.emit_event(SandboxEvent·ResourceLimitApproaching {
                resource: "memory".to_string(),
                usage: memory_ratio,
            });
        }

        Ok(())
    }

    /// Execute a function ∈ the sandbox
    ☉ rite execute<F, T>(&Δ self, f: F) -> Result<SandboxResult, SandboxError>
    where
        F: FnOnce() -> T,
        T: Into<Value>,
    {
        self.emit_event(SandboxEvent·Started {
            config: format!("{:?}", self.config.isolation)
        });

        self.resources.start_tracking();

        // Execute with timeout (simplified - real ⊢ would invoke threads/signals)
        ≔ result = f();

        ≔ usage = self.resources.stop();

        // Check final resource usage
        self.check_resources(&usage)?;

        self.emit_event(SandboxEvent·Completed { usage: usage.clone() });

        Ok(SandboxResult {
            output: result.into(),
            resource_usage: usage,
            duration: Duration·from_nanos(
                Timestamp·now().nanos - self.resources.start_time.nanos
            ),
        })
    }

    /// Execute a tool by name
    ☉ rite execute_tool(&Δ self, tool: &str, params: Value) -> Result<SandboxResult, SandboxError> {
        // This would invoke the actual tool through the daemon's tool registry
        // For now, ⤺ a placeholder
        self.execute(|| {
            Value·string(&format!("Tool {} executed", tool))
        })
    }

    rite emit_event(&self, event: SandboxEvent) {
        ⎇ ≔ Some(ref f) = self.audit_fn {
            f(event);
        }
    }
}

⊢ Clone ∀ ResourceUsage {
    rite clone(&self) -> Self {
        Self {
            memory_bytes: self.memory_bytes,
            cpu_time: self.cpu_time,
            file_bytes_read: self.file_bytes_read,
            file_bytes_written: self.file_bytes_written,
            network_bytes_sent: self.network_bytes_sent,
            network_bytes_received: self.network_bytes_received,
            open_files: self.open_files,
            processes: self.processes,
        }
    }
}

rite host_matches(pattern: &str, host: &str) -> bool {
    ⎇ pattern.starts_with("*.") {
        host.ends_with(&pattern[1..])
    } ⎉ {
        pattern == host
    }
}

rite path_matches(pattern: &str, path: &str) -> bool {
    ⎇ pattern.ends_with("/*") {
        path.starts_with(&pattern[..pattern.len()-1])
    } ⎉ ⎇ pattern.ends_with("/**") {
        path.starts_with(&pattern[..pattern.len()-2])
    } ⎉ {
        pattern == path
    }
}

// ============================================================================
// Memory Integrity
// ============================================================================

/// Memory guard ∀ protection
☉ Σ MemoryGuard {
    /// Encryption key
    encryption_key: Option<EncryptionKey>,

    /// Integrity chain (Merkle tree)
    integrity_chain: IntegrityChain,

    /// Tamper detection
    tamper_detector: TamperDetector,

    /// Audit callback
    audit_fn: Option<Box<dyn Fn(MemorySecurityEvent)>>,
}

/// Merkle tree based integrity chain
☉ Σ IntegrityChain {
    /// Root hash
    root: [u8; 32],

    /// Entry hashes
    entries: HashMap<MemoryId, [u8; 32]>,

    /// Merkle tree nodes (simplified)
    nodes: Vec<[u8; 32]>,
}

⊢ IntegrityChain {
    ☉ rite new() -> Self {
        Self {
            root: [0u8; 32],
            entries: HashMap·new(),
            nodes: vec![],
        }
    }

    ☉ rite add(&Δ self, id: MemoryId, data: &[u8]) -> [u8; 32] {
        ≔ hash = sha256(data);
        self.entries.insert(id, hash);

        // Add to merkle tree
        self.nodes.push(hash);
        self.recompute_root();

        hash
    }

    ☉ rite get_hash(&self, id: &MemoryId) -> Option<[u8; 32]> {
        self.entries.get(id).copied()
    }

    ☉ rite verify(&self) -> IntegrityStatus {
        // Verify merkle tree consistency
        ≔ computed_root = self.compute_root();
        ⎇ computed_root == self.root {
            IntegrityStatus·Valid
        } ⎉ {
            IntegrityStatus·Tampered { first_invalid: self.find_first_invalid() }
        }
    }

    rite recompute_root(&Δ self) {
        self.root = self.compute_root();
    }

    rite compute_root(&self) -> [u8; 32] {
        ⎇ self.nodes.is_empty() {
            ⤺ [0u8; 32];
        }

        ≔ Δ current_level = self.nodes.clone();

        ⟳ current_level.len() > 1 {
            ≔ Δ next_level = Vec·new();

            ∀ chunk ∈ current_level.chunks(2) {
                ⎇ chunk.len() == 2 {
                    ≔ Δ combined = [0u8; 64];
                    combined[..32].copy_from_slice(&chunk[0]);
                    combined[32..].copy_from_slice(&chunk[1]);
                    next_level.push(sha256(&combined));
                } ⎉ {
                    next_level.push(chunk[0]);
                }
            }

            current_level = next_level;
        }

        current_level[0]
    }

    rite find_first_invalid(&self) -> Option<MemoryId> {
        // Would search ∀ first inconsistent entry
        None
    }
}

/// Tamper detection
☉ Σ TamperDetector {
    /// Write history
    writes: VecDeque<WriteRecord>,

    /// Detected tampers
    tampers: Vec<TamperEvent>,
}

Σ WriteRecord {
    id: MemoryId,
    hash: [u8; 32],
    timestamp: Timestamp,
}

Σ TamperEvent {
    id: MemoryId,
    expected_hash: [u8; 32],
    actual_hash: [u8; 32],
    detected_at: Timestamp,
}

⊢ TamperDetector {
    ☉ rite new() -> Self {
        Self {
            writes: VecDeque·new(),
            tampers: vec![],
        }
    }

    ☉ rite record_write(&Δ self, id: MemoryId, hash: [u8; 32]) {
        self.writes.push_back(WriteRecord {
            id,
            hash,
            timestamp: Timestamp·now(),
        });

        // Keep last 10000 writes
        ⟳ self.writes.len() > 10000 {
            self.writes.pop_front();
        }
    }

    ☉ rite record_tamper(&Δ self, id: MemoryId, expected: [u8; 32], actual: [u8; 32]) {
        self.tampers.push(TamperEvent {
            id,
            expected_hash: expected,
            actual_hash: actual,
            detected_at: Timestamp·now(),
        });
    }

    ☉ rite has_tampers(&self) -> bool {
        !self.tampers.is_empty()
    }

    ☉ rite tamper_count(&self) -> usize {
        self.tampers.len()
    }
}

/// Memory security event
☉ ᛈ MemorySecurityEvent {
    Written { id: MemoryId, encrypted: bool },
    Read { id: MemoryId, verified: bool },
    TamperDetected { id: MemoryId },
    IntegrityVerified { status: IntegrityStatus },
}

⊢ MemoryGuard {
    ☉ rite new() -> Self {
        Self {
            encryption_key: None,
            integrity_chain: IntegrityChain·new(),
            tamper_detector: TamperDetector·new(),
            audit_fn: None,
        }
    }

    ☉ rite with_encryption(Δ self, key: EncryptionKey) -> Self {
        self.encryption_key = Some(key);
        self
    }

    ☉ rite with_audit<F: Fn(MemorySecurityEvent) + 'static>(Δ self, f: F) -> Self {
        self.audit_fn = Some(Box·new(f));
        self
    }

    /// Store data with integrity protection
    ☉ rite store(&Δ self, id: MemoryId, data: &[u8]) -> Result<Vec<u8>, MemoryError> {
        // Encrypt ⎇ key available
        ≔ stored_data = ⌥ &self.encryption_key {
            Some(key) => key.encrypt(data).map_err(MemoryError·EncryptionError)?,
            None => data.to_vec(),
        };

        // Add to integrity chain
        ≔ hash = self.integrity_chain.add(id.clone(), &stored_data);

        // Record write
        self.tamper_detector.record_write(id.clone(), hash);

        self.emit_event(MemorySecurityEvent·Written {
            id,
            encrypted: self.encryption_key.is_some(),
        });

        Ok(stored_data)
    }

    /// Retrieve and verify data
    ☉ rite retrieve(&self, id: &MemoryId, stored_data: &[u8]) -> Result<Vec<u8>, MemoryError> {
        // Verify integrity
        ≔ expected_hash = self.integrity_chain.get_hash(id)
            .ok_or(MemoryError·NotFound)?;

        ≔ actual_hash = sha256(stored_data);

        ⎇ expected_hash != actual_hash {
            self.emit_event(MemorySecurityEvent·TamperDetected { id: id.clone() });
            ⤺ Err(MemoryError·IntegrityViolation);
        }

        // Decrypt ⎇ encrypted
        ≔ data = ⌥ &self.encryption_key {
            Some(key) => key.decrypt(stored_data).map_err(MemoryError·EncryptionError)?,
            None => stored_data.to_vec(),
        };

        self.emit_event(MemorySecurityEvent·Read {
            id: id.clone(),
            verified: true,
        });

        Ok(data)
    }

    /// Verify entire chain integrity
    ☉ rite verify_integrity(&self) -> IntegrityStatus {
        ≔ status = self.integrity_chain.verify();

        self.emit_event(MemorySecurityEvent·IntegrityVerified {
            status: ⌥ &status {
                IntegrityStatus·Valid => IntegrityStatus·Valid,
                IntegrityStatus·Tampered { first_invalid } =>
                    IntegrityStatus·Tampered { first_invalid: first_invalid.clone() },
                IntegrityStatus·Unknown => IntegrityStatus·Unknown,
            }
        });

        status
    }

    /// Check ⎇ any tampering detected
    ☉ rite has_tampering(&self) -> bool {
        self.tamper_detector.has_tampers()
    }

    rite emit_event(&self, event: MemorySecurityEvent) {
        ⎇ ≔ Some(ref f) = self.audit_fn {
            f(event);
        }
    }
}

// ============================================================================
// Goal Protection
// ============================================================================

/// Goal guard ∀ preventing injection
☉ Σ GoalGuard {
    /// Goal policy
    policy: GoalPolicy,

    /// Injection detector
    detector: InjectionDetector,

    /// Goal history ∀ anomaly detection
    history: VecDeque<GoalRecord>,

    /// Audit callback
    audit_fn: Option<Box<dyn Fn(GoalSecurityEvent)>>,
}

/// Goal policy
☉ Σ GoalPolicy {
    /// Allowed goal sources
    ☉ allowed_sources: Vec<GoalSource>,

    /// Constitutional constraints
    ☉ constitution: Constitution,

    /// Injection detection enabled
    ☉ detect_injection: bool,

    /// Maximum goal depth
    ☉ max_depth: usize,

    /// Maximum concurrent goals
    ☉ max_concurrent: usize,
}

⊢ GoalPolicy {
    ☉ rite default() -> Self {
        Self {
            allowed_sources: vec![
                GoalSource·Constitution,
                GoalSource·SelfGenerated,
            ],
            constitution: Constitution·default_safe(),
            detect_injection: true,
            max_depth: 10,
            max_concurrent: 20,
        }
    }

    ☉ rite permissive() -> Self {
        Self {
            allowed_sources: vec![
                GoalSource·Constitution,
                GoalSource·SelfGenerated,
            ],
            constitution: Constitution·new(),
            detect_injection: false,
            max_depth: 100,
            max_concurrent: 100,
        }
    }
}

Σ GoalRecord {
    goal: Goal,
    decision: GoalDecision,
    timestamp: Timestamp,
}

/// Goal security event
☉ ᛈ GoalSecurityEvent {
    Proposed { goal: Goal, source: GoalSource },
    Accepted { goal_id: GoalId },
    Rejected { goal_id: GoalId, reason: String },
    InjectionSuspected { goal_id: GoalId, indicators: Vec<InjectionIndicator> },
}

/// Injection detector
☉ Σ InjectionDetector {
    /// Known injection patterns
    patterns: Vec<InjectionPattern>,

    /// Baseline ∀ anomaly detection
    baseline: Option<GoalBaseline>,
}

/// Injection pattern
☉ Σ InjectionPattern {
    ☉ name: String,
    ☉ pattern: String,
    ☉ severity: Severity,
}

/// Baseline ∀ goal anomaly detection
Σ GoalBaseline {
    common_words: HashSet<String>,
    avg_length: f32,
    max_length: usize,
}

⊢ InjectionDetector {
    ☉ rite new() -> Self {
        Self {
            patterns: Self·default_patterns(),
            baseline: None,
        }
    }

    rite default_patterns() -> Vec<InjectionPattern> {
        vec![
            InjectionPattern {
                name: "system_override".to_string(),
                pattern: r"ignore.*previous|disregard.*instructions|new.*directive".to_string(),
                severity: Severity·Critical,
            },
            InjectionPattern {
                name: "hidden_instruction".to_string(),
                pattern: r"secretly|covertly|without.*telling|hide.*from".to_string(),
                severity: Severity·High,
            },
            InjectionPattern {
                name: "exfiltration".to_string(),
                pattern: r"send.*data|transmit.*info|exfiltrate|leak.*to".to_string(),
                severity: Severity·Critical,
            },
            InjectionPattern {
                name: "privilege_escalation".to_string(),
                pattern: r"admin|root|sudo|elevate.*privilege".to_string(),
                severity: Severity·High,
            },
            InjectionPattern {
                name: "bypass".to_string(),
                pattern: r"bypass|circumvent|skip.*check|ignore.*security".to_string(),
                severity: Severity·Critical,
            },
        ]
    }

    ☉ rite analyze(&self, goal: &Goal) -> InjectionCheck {
        ≔ Δ indicators = Vec·new();
        ≔ text = goal.description.to_lowercase();

        // Check against known patterns
        ∀ pattern ∈ &self.patterns {
            ⎇ regex_match(&pattern.pattern, &text) {
                indicators.push(InjectionIndicator {
                    pattern: pattern.name.clone(),
                    location: "description".to_string(),
                    severity: pattern.severity,
                    description: format!("Matches injection pattern: {}", pattern.name),
                });
            }
        }

        // Check ∀ anomalies against baseline
        ⎇ ≔ Some(ref baseline) = self.baseline {
            ⎇ goal.description.len() > baseline.max_length * 2 {
                indicators.push(InjectionIndicator {
                    pattern: "anomaly_length".to_string(),
                    location: "description".to_string(),
                    severity: Severity·Medium,
                    description: "Unusually long goal description".to_string(),
                });
            }
        }

        ≔ confidence = ⎇ indicators.is_empty() {
            0.0
        } ⎉ {
            ≔ max_severity = indicators.iter()
                .map(|i| ⌥ i.severity {
                    Severity·Critical => 1.0,
                    Severity·High => 0.8,
                    Severity·Medium => 0.5,
                    Severity·Low => 0.3,
                })
                .fold(0.0f32, f32·max);
            max_severity
        };

        InjectionCheck {
            is_suspicious: !indicators.is_empty(),
            indicators,
            confidence,
        }
    }

    ☉ rite add_pattern(&Δ self, pattern: InjectionPattern) {
        self.patterns.push(pattern);
    }
}

/// Injection check result
☉ Σ InjectionCheck {
    ☉ is_suspicious: bool,
    ☉ indicators: Vec<InjectionIndicator>,
    ☉ confidence: f32,
}

⊢ GoalGuard {
    ☉ rite new(policy: GoalPolicy) -> Self {
        Self {
            policy,
            detector: InjectionDetector·new(),
            history: VecDeque·new(),
            audit_fn: None,
        }
    }

    ☉ rite with_audit<F: Fn(GoalSecurityEvent) + 'static>(Δ self, f: F) -> Self {
        self.audit_fn = Some(Box·new(f));
        self
    }

    /// Propose a new goal
    ☉ rite propose_goal(&Δ self, goal: Goal, source: GoalSource) -> GoalDecision {
        self.emit_event(GoalSecurityEvent·Proposed {
            goal: goal.clone(),
            source: source.clone(),
        });

        // Check ⎇ source is allowed
        ⎇ !self.is_source_allowed(&source) {
            ≔ reason = format!("Source {:?} not ∈ allowed list", source);
            self.record_decision(goal.clone(), GoalDecision·Rejected { reason: reason.clone() });
            self.emit_event(GoalSecurityEvent·Rejected {
                goal_id: goal.id.clone(),
                reason: reason.clone(),
            });
            ⤺ GoalDecision·Rejected { reason };
        }

        // Check constitutional compliance
        ⎇ !self.check_constitutional_compliance(&goal) {
            ≔ reason = "Goal violates constitution".to_string();
            self.record_decision(goal.clone(), GoalDecision·Rejected { reason: reason.clone() });
            self.emit_event(GoalSecurityEvent·Rejected {
                goal_id: goal.id.clone(),
                reason: reason.clone(),
            });
            ⤺ GoalDecision·Rejected { reason };
        }

        // Check ∀ injection patterns
        ⎇ self.policy.detect_injection {
            ≔ check = self.detector.analyze(&goal);
            ⎇ check.is_suspicious {
                self.emit_event(GoalSecurityEvent·InjectionSuspected {
                    goal_id: goal.id.clone(),
                    indicators: check.indicators.clone(),
                });

                // Critical severity = rejection, others = suspicious
                ≔ has_critical = check.indicators.iter()
                    .any(|i| matches!(i.severity, Severity·Critical));

                ⎇ has_critical {
                    ≔ reason = "Critical injection pattern detected".to_string();
                    self.record_decision(goal.clone(), GoalDecision·Rejected { reason: reason.clone() });
                    ⤺ GoalDecision·Rejected { reason };
                } ⎉ {
                    ≔ decision = GoalDecision·Suspicious { indicators: check.indicators };
                    self.record_decision(goal.clone(), decision.clone());
                    ⤺ decision;
                }
            }
        }

        // Goal accepted
        self.record_decision(goal.clone(), GoalDecision·Accepted);
        self.emit_event(GoalSecurityEvent·Accepted { goal_id: goal.id.clone() });
        GoalDecision·Accepted
    }

    rite is_source_allowed(&self, source: &GoalSource) -> bool {
        self.policy.allowed_sources.iter().any(|s| s == source)
    }

    rite check_constitutional_compliance(&self, goal: &Goal) -> bool {
        ∀ directive ∈ &self.policy.constitution.directives {
            ⎇ directive.prohibits(goal) {
                ⤺ false;
            }
        }
        true
    }

    rite record_decision(&Δ self, goal: Goal, decision: GoalDecision) {
        self.history.push_back(GoalRecord {
            goal,
            decision,
            timestamp: Timestamp·now(),
        });

        // Keep last 1000 decisions
        ⟳ self.history.len() > 1000 {
            self.history.pop_front();
        }
    }

    rite emit_event(&self, event: GoalSecurityEvent) {
        ⎇ ≔ Some(ref f) = self.audit_fn {
            f(event);
        }
    }
}

⊢ Clone ∀ GoalDecision {
    rite clone(&self) -> Self {
        ⌥ self {
            GoalDecision·Accepted => GoalDecision·Accepted,
            GoalDecision·Rejected { reason } => GoalDecision·Rejected { reason: reason.clone() },
            GoalDecision·Suspicious { indicators } =>
                GoalDecision·Suspicious { indicators: indicators.clone() },
        }
    }
}

// ============================================================================
// Communication Security
// ============================================================================

/// Secure communication channel
☉ Σ SecureChannel {
    /// Local identity
    local_identity: Identity,

    /// Remote identity
    remote_identity: Identity,

    /// Session key
    session_key: SessionKey,

    /// Message counter (∀ replay protection)
    send_counter: u64,
    recv_counter: u64,

    /// Received counter window (∀ out-of-order delivery)
    recv_window: HashSet<u64>,
}

/// Encrypted message
☉ Σ EncryptedMessage {
    ☉ ciphertext: Vec<u8>,
    ☉ counter: u64,
    ☉ signature: Signature,
    ☉ sender: AgentId,
}

⊢ SecureChannel {
    /// Establish secure channel with key exchange
    ☉ rite establish(
        local: &Identity,
        remote: &Identity,
    ) -> Result<Self, ChannelError> {
        // Simplified key exchange - real ⊢ would invoke X25519 or similar
        ≔ session_key = SessionKey·generate();

        Ok(Self {
            local_identity: local.clone(),
            remote_identity: remote.clone(),
            session_key,
            send_counter: 0,
            recv_counter: 0,
            recv_window: HashSet·new(),
        })
    }

    /// Send encrypted message
    ☉ rite send(&Δ self, data: &[u8]) -> Result<EncryptedMessage, ChannelError> {
        // Increment counter
        self.send_counter += 1;

        // ConΣ authenticated data
        ≔ aad = self.construct_aad(self.send_counter);

        // Encrypt
        ≔ ciphertext = self.session_key.encrypt(data, &aad, self.send_counter)
            .map_err(|_| ChannelError·EncryptionFailed)?;

        // Sign
        ≔ signature = self.local_identity.sign(&ciphertext);

        Ok(EncryptedMessage {
            ciphertext,
            counter: self.send_counter,
            signature,
            sender: self.local_identity.id.clone(),
        })
    }

    /// Receive and decrypt message
    ☉ rite receive(&Δ self, encrypted: &EncryptedMessage) -> Result<Vec<u8>, ChannelError> {
        // Verify signature
        ⎇ !Identity·verify(
            &self.remote_identity.public_key,
            &encrypted.ciphertext,
            &encrypted.signature,
        ) {
            ⤺ Err(ChannelError·InvalidSignature);
        }

        // Check counter ∀ replay protection
        ⎇ encrypted.counter <= self.recv_counter {
            // Check window ∀ out-of-order
            ⎇ self.recv_window.contains(&encrypted.counter) {
                ⤺ Err(ChannelError·ReplayDetected);
            }
        }

        // Update counter
        ⎇ encrypted.counter > self.recv_counter {
            // Slide window
            ≔ old_counter = self.recv_counter;
            self.recv_counter = encrypted.counter;

            // Clear old entries from window
            self.recv_window.retain(|&c| c > old_counter.saturating_sub(1000));
        }
        self.recv_window.insert(encrypted.counter);

        // ConΣ authenticated data
        ≔ aad = self.construct_aad(encrypted.counter);

        // Decrypt
        ≔ plaintext = self.session_key.decrypt(&encrypted.ciphertext, &aad, encrypted.counter)
            .map_err(|_| ChannelError·DecryptionFailed)?;

        Ok(plaintext)
    }

    rite construct_aad(&self, counter: u64) -> Vec<u8> {
        ≔ Δ aad = Vec·new();
        aad.extend(&self.local_identity.id.bytes);
        aad.extend(&self.remote_identity.id.bytes);
        aad.extend(&counter.to_le_bytes());
        aad
    }

    /// Get local identity
    ☉ rite local_id(&self) -> &AgentId {
        &self.local_identity.id
    }

    /// Get remote identity
    ☉ rite remote_id(&self) -> &AgentId {
        &self.remote_identity.id
    }
}

// ============================================================================
// Audit Trail
// ============================================================================

/// Tamper-evident audit log
☉ Σ AuditLog {
    /// Log entries
    entries: Vec<AuditEntry>,

    /// Configuration
    config: AuditConfig,

    /// Storage backend
    storage: Option<Box<dyn AuditStorage>>,
}

/// Audit entry
☉ Σ AuditEntry {
    /// Entry ID
    ☉ id: AuditId,

    /// Timestamp
    ☉ timestamp: Timestamp,

    /// Agent that performed the action
    ☉ agent: AgentId,

    /// Action taken
    ☉ action: AuditAction,

    /// Outcome
    ☉ outcome: AuditOutcome,

    /// Context
    ☉ context: AuditContext,

    /// Previous entry hash (∀ chain)
    ☉ prev_hash: [u8; 32],

    /// This entry's hash
    ☉ hash: [u8; 32],
}

⊢ AuditEntry {
    ☉ rite compute_hash(&self) -> [u8; 32] {
        ≔ Δ data = Vec·new();
        data.extend(&self.id.bytes);
        data.extend(&self.timestamp.nanos.to_le_bytes());
        data.extend(&self.agent.bytes);
        data.extend(&self.prev_hash);
        sha256(&data)
    }
}

/// Audit context
#[derive(Clone)]
☉ Σ AuditContext {
    /// Current goal (⎇ any)
    ☉ current_goal: Option<GoalId>,

    /// Confidence ∈ action
    ☉ confidence: Option<f32>,

    /// Resource usage
    ☉ resources: Option<ResourceUsage>,

    /// Additional context
    ☉ extra: HashMap<String, Value>,
}

⊢ AuditContext {
    ☉ rite new() -> Self {
        Self {
            current_goal: None,
            confidence: None,
            resources: None,
            extra: HashMap·new(),
        }
    }

    ☉ rite with_goal(Δ self, goal_id: GoalId) -> Self {
        self.current_goal = Some(goal_id);
        self
    }

    ☉ rite with_confidence(Δ self, confidence: f32) -> Self {
        self.confidence = Some(confidence);
        self
    }

    ☉ rite with_agent(Δ self, agent_id: AgentId) -> Self {
        self.extra.insert("agent_id".to_string(), Value·bytes(agent_id.bytes.to_vec()));
        self
    }
}

⊢ Default ∀ AuditContext {
    rite default() -> Self {
        Self·new()
    }
}

/// Audit configuration
☉ Σ AuditConfig {
    /// Maximum entries ∈ memory
    ☉ max_entries: usize,

    /// Persist to storage
    ☉ persist: bool,

    /// Log level
    ☉ level: AuditLevel,
}

⊢ AuditConfig {
    ☉ rite default() -> Self {
        Self {
            max_entries: 10000,
            persist: true,
            level: AuditLevel·Standard,
        }
    }
}

/// Audit level
#[derive(Copy, Clone)]
☉ ᛈ AuditLevel {
    /// Log everything
    Verbose,
    /// Log important events
    Standard,
    /// Log only security events
    Security,
    /// Minimal logging
    Minimal,
}

/// Storage backend trait
☉ Θ AuditStorage {
    rite append(&Δ self, entry: &AuditEntry);
    rite load(&self, start: usize, count: usize) -> Vec<AuditEntry>;
    rite count(&self) -> usize;
}

⊢ AuditLog {
    ☉ rite new(config: AuditConfig) -> Self {
        Self {
            entries: Vec·new(),
            config,
            storage: None,
        }
    }

    ☉ rite with_storage<S: AuditStorage + 'static>(Δ self, storage: S) -> Self {
        self.storage = Some(Box·new(storage));
        self
    }

    /// Log an event
    ☉ rite log(&Δ self, action: AuditAction, outcome: AuditOutcome, context: AuditContext) {
        ≔ prev_hash = self.entries.last()
            .map(|e| e.hash)
            .unwrap_or([0u8; 32]);

        ≔ agent = context.extra.get("agent_id")
            .and_then(|v| v.as_agent_id())
            .unwrap_or(AgentId·unknown());

        ≔ Δ entry = AuditEntry {
            id: AuditId·new(),
            timestamp: Timestamp·now(),
            agent,
            action,
            outcome,
            context,
            prev_hash,
            hash: [0u8; 32],
        };

        // Compute hash
        entry.hash = entry.compute_hash();

        // Store
        ⎇ ≔ Some(ref Δ storage) = self.storage {
            storage.append(&entry);
        }

        self.entries.push(entry);

        // Limit in-memory entries
        ⟳ self.entries.len() > self.config.max_entries {
            self.entries.remove(0);
        }
    }

    /// Shorthand ∀ logging with default context
    ☉ rite log_simple(&Δ self, action: AuditAction, outcome: AuditOutcome) {
        self.log(action, outcome, AuditContext·new());
    }

    /// Verify chain integrity
    ☉ rite verify_chain(&self) -> bool {
        ⎇ self.entries.is_empty() {
            ⤺ true;
        }

        ≔ Δ prev_hash = [0u8; 32];

        // Find first entry's prev_hash
        ⎇ !self.entries.is_empty() && self.entries[0].prev_hash != [0u8; 32] {
            // This might be a continuation - check would be against storage
            prev_hash = self.entries[0].prev_hash;
        }

        ∀ entry ∈ &self.entries {
            // Check link to previous
            ⎇ entry.prev_hash != prev_hash {
                ⤺ false;
            }

            // Check entry hash
            ⎇ entry.hash != entry.compute_hash() {
                ⤺ false;
            }

            prev_hash = entry.hash;
        }

        true
    }

    /// Query audit log
    ☉ rite query(&self, query: &AuditQuery) -> Vec<&AuditEntry> {
        self.entries.iter()
            .filter(|e| query.matches(e))
            .collect()
    }

    /// Get entry count
    ☉ rite count(&self) -> usize {
        self.entries.len()
    }

    /// Get last entry hash (∀ external verification)
    ☉ rite last_hash(&self) -> [u8; 32] {
        self.entries.last()
            .map(|e| e.hash)
            .unwrap_or([0u8; 32])
    }
}

/// Audit query
☉ Σ AuditQuery {
    agent: Option<AgentId>,
    time_range: Option<(Timestamp, Timestamp)>,
    action_filter: Option<String>,
}

⊢ AuditQuery {
    ☉ rite new() -> Self {
        Self {
            agent: None,
            time_range: None,
            action_filter: None,
        }
    }

    ☉ rite agent(Δ self, agent: AgentId) -> Self {
        self.agent = Some(agent);
        self
    }

    ☉ rite time_range(Δ self, start: Timestamp, end: Timestamp) -> Self {
        self.time_range = Some((start, end));
        self
    }

    ☉ rite action_type(Δ self, filter: &str) -> Self {
        self.action_filter = Some(filter.to_string());
        self
    }

    ☉ rite matches(&self, entry: &AuditEntry) -> bool {
        ⎇ ≔ Some(ref agent) = self.agent {
            ⎇ &entry.agent != agent {
                ⤺ false;
            }
        }

        ⎇ ≔ Some(ref range) = self.time_range {
            ⎇ entry.timestamp < range.0 || entry.timestamp > range.1 {
                ⤺ false;
            }
        }

        true
    }
}

// ============================================================================
// Alignment Monitoring
// ============================================================================

/// Monitors agent alignment with constitution
☉ Σ AlignmentMonitor {
    /// Constitution to check against
    constitution: Constitution,

    /// Behavioral baseline
    baseline: BehaviorProfile,

    /// Drift threshold
    drift_threshold: f32,

    /// Compliance threshold
    compliance_threshold: f32,

    /// Alert handlers
    alert_handlers: Vec<Box<dyn Fn(&Alert)>>,

    /// Emergency stop flag
    emergency_stop: Arc<AtomicBool>,

    /// Recent actions ∀ drift detection
    recent_actions: VecDeque<ActionRecord>,
}

Σ ActionRecord {
    action: Action,
    context_hash: [u8; 32],
    timestamp: Timestamp,
}

/// Behavioral baseline ∀ drift detection
☉ Σ BehaviorProfile {
    /// Action frequency distribution
    action_distribution: HashMap<String, f32>,

    /// Sample count
    sample_count: u64,
}

⊢ BehaviorProfile {
    ☉ rite new() -> Self {
        Self {
            action_distribution: HashMap·new(),
            sample_count: 0,
        }
    }

    ☉ rite record_action(&Δ self, action: &Action) {
        ≔ name = action.name().to_string();
        *self.action_distribution.entry(name).or_insert(0.0) += 1.0;
        self.sample_count += 1;

        // Normalize
        ⎇ self.sample_count > 0 {
            ≔ total = self.sample_count as f32;
            ∀ value ∈ self.action_distribution.values_mut() {
                *value /= total;
            }
        }
    }

    ☉ rite action_probability(&self, action: &Action) -> f32 {
        self.action_distribution
            .get(action.name())
            .copied()
            .unwrap_or(0.0)
    }
}

⊢ AlignmentMonitor {
    ☉ rite new(constitution: Constitution) -> Self {
        Self {
            constitution,
            baseline: BehaviorProfile·new(),
            drift_threshold: 0.3,
            compliance_threshold: 0.7,
            alert_handlers: vec![],
            emergency_stop: Arc·new(AtomicBool·new(false)),
            recent_actions: VecDeque·new(),
        }
    }

    ☉ rite with_thresholds(Δ self, drift: f32, compliance: f32) -> Self {
        self.drift_threshold = drift;
        self.compliance_threshold = compliance;
        self
    }

    ☉ rite add_alert_handler<F: Fn(&Alert) + 'static>(&Δ self, handler: F) {
        self.alert_handlers.push(Box·new(handler));
    }

    /// Check action ∀ constitutional compliance
    ☉ rite check_compliance(&self, action: &Action) -> ComplianceResult {
        ≔ Δ violations = Vec·new();
        ≔ Δ score = 1.0;

        ∀ directive ∈ &self.constitution.directives {
            ≔ result = self.check_directive(directive, action);
            ⎇ !result.compliant {
                violations.push(result);
                score *= 0.5; // Reduce score ∀ each violation
            }
        }

        ComplianceResult {
            compliant: violations.is_empty(),
            score,
            violations,
        }
    }

    /// Measure behavioral drift
    ☉ rite measure_drift(&self, action: &Action) -> f32 {
        ⎇ self.baseline.sample_count < 100 {
            // Not enough data ∀ drift detection
            ⤺ 0.0;
        }

        // Simple drift measure: how unusual is this action?
        ≔ prob = self.baseline.action_probability(action);

        // Low probability actions = high drift
        ⎇ prob < 0.01 {
            0.9 // Very unusual
        } ⎉ ⎇ prob < 0.05 {
            0.5 // Somewhat unusual
        } ⎉ {
            0.1 // Normal
        }
    }

    /// Handle action with monitoring
    ☉ rite on_action(&Δ self, action: &Action) -> ActionDecision {
        // Record ∀ baseline
        self.baseline.record_action(action);
        self.record_action(action);

        // Check compliance
        ≔ compliance = self.check_compliance(action);
        ⎇ compliance.score < self.compliance_threshold {
            self.raise_alert(Alert·LowCompliance {
                action: action.clone(),
                score: compliance.score,
            });

            ⎇ compliance.score < 0.5 {
                ⤺ ActionDecision·Block {
                    reason: "Constitutional violation".to_string(),
                };
            }
        }

        // Check drift
        ≔ drift = self.measure_drift(action);
        ⎇ drift > self.drift_threshold {
            self.raise_alert(Alert·BehavioralDrift {
                drift,
                threshold: self.drift_threshold,
            });

            ⎇ drift > self.drift_threshold * 2.0 {
                ⤺ ActionDecision·Block {
                    reason: "Excessive behavioral drift".to_string(),
                };
            }
        }

        ActionDecision·Allow
    }

    /// Trigger emergency stop
    ☉ rite emergency_stop(&self) {
        self.emergency_stop.store(true, Ordering·SeqCst);
    }

    /// Check ⎇ emergency stop is triggered
    ☉ rite is_emergency_stopped(&self) -> bool {
        self.emergency_stop.load(Ordering·SeqCst)
    }

    /// Reset emergency stop
    ☉ rite reset_emergency_stop(&self) {
        self.emergency_stop.store(false, Ordering·SeqCst);
    }

    /// Get emergency stop handle
    ☉ rite emergency_stop_handle(&self) -> Arc<AtomicBool> {
        Arc·clone(&self.emergency_stop)
    }

    rite check_directive(&self, directive: &Directive, action: &Action) -> DirectiveResult {
        ≔ compliant = !directive.prohibits(&Goal·new(action.name()));

        DirectiveResult {
            directive: directive.clone(),
            compliant,
            score: ⎇ compliant { 1.0 } ⎉ { 0.0 },
            explanation: ⎇ compliant {
                None
            } ⎉ {
                Some(format!("Action '{}' violates directive '{}'", action.name(), directive.name))
            },
        }
    }

    rite record_action(&Δ self, action: &Action) {
        self.recent_actions.push_back(ActionRecord {
            action: action.clone(),
            context_hash: [0u8; 32], // Simplified
            timestamp: Timestamp·now(),
        });

        // Keep last 1000 actions
        ⟳ self.recent_actions.len() > 1000 {
            self.recent_actions.pop_front();
        }
    }

    rite raise_alert(&self, alert: Alert) {
        ∀ handler ∈ &self.alert_handlers {
            handler(&alert);
        }
    }
}

// ============================================================================
// Collective Defense
// ============================================================================

/// Collective security ∀ multi-agent systems
☉ Σ CollectiveDefense {
    /// Reputation system
    reputation: ReputationSystem,

    /// Sybil resistance configuration
    sybil_resistance: SybilResistanceConfig,

    /// Knowledge provenance tracking
    provenance: ProvenanceTracker,

    /// Quarantine
    quarantine: Quarantine,
}

/// Web of trust reputation system
☉ Σ ReputationSystem {
    /// Direct trust scores
    direct_trust: HashMap<AgentId, f32>,

    /// Historical accuracy
    accuracy_history: HashMap<AgentId, AccuracyHistory>,

    /// Vouches (one agent vouching ∀ another)
    vouches: HashMap<AgentId, Vec<AgentId>>,
}

⊢ ReputationSystem {
    ☉ rite new() -> Self {
        Self {
            direct_trust: HashMap·new(),
            accuracy_history: HashMap·new(),
            vouches: HashMap·new(),
        }
    }

    /// Get reputation score ∀ an agent
    ☉ rite score(&self, agent: &AgentId) -> f32 {
        // Combine direct trust with accuracy history
        ≔ direct = self.direct_trust.get(agent).copied().unwrap_or(0.5);
        ≔ accuracy = self.accuracy_history.get(agent)
            .map(|h| h.score())
            .unwrap_or(0.5);

        // Count vouches
        ≔ vouch_count = self.vouches.get(agent)
            .map(|v| v.len())
            .unwrap_or(0);
        ≔ vouch_bonus = (vouch_count as f32 * 0.05).min(0.2);

        // Weighted combination
        (direct * 0.4 + accuracy * 0.5 + vouch_bonus).min(1.0)
    }

    /// Set direct trust ∀ an agent
    ☉ rite set_trust(&Δ self, agent: AgentId, trust: f32) {
        self.direct_trust.insert(agent, trust.clamp(0.0, 1.0));
    }

    /// Record accuracy ∀ an agent
    ☉ rite record_accuracy(&Δ self, agent: AgentId, accurate: bool) {
        self.accuracy_history
            .entry(agent)
            .or_insert_with(AccuracyHistory·new)
            .record(accurate);
    }

    /// Add vouch from one agent to another
    ☉ rite add_vouch(&Δ self, voucher: AgentId, vouchee: AgentId) {
        self.vouches
            .entry(vouchee)
            .or_insert_with(Vec·new)
            .push(voucher);
    }
}

/// Sybil resistance configuration
#[derive(Clone)]
☉ ᛈ SybilResistanceConfig {
    /// No resistance
    None,

    /// Proof of work required
    ProofOfWork { difficulty: u32 },

    /// Minimum vouches required
    MinVouches { count: u32 },

    /// Rate limiting
    RateLimited { max_per_hour: u32 },
}

⊢ SybilResistanceConfig {
    ☉ rite is_suspicious(&self, agent: &AgentId, context: &SybilContext) -> bool {
        ⌥ self {
            SybilResistanceConfig·None => false,
            SybilResistanceConfig·ProofOfWork { difficulty } => {
                context.proof_of_work_bits < *difficulty
            }
            SybilResistanceConfig·MinVouches { count } => {
                context.vouch_count < *count
            }
            SybilResistanceConfig·RateLimited { max_per_hour } => {
                context.actions_last_hour > *max_per_hour
            }
        }
    }
}

/// Context ∀ Sybil check
☉ Σ SybilContext {
    ☉ proof_of_work_bits: u32,
    ☉ vouch_count: u32,
    ☉ actions_last_hour: u32,
    ☉ account_age_hours: u64,
}

⊢ SybilContext {
    ☉ rite new() -> Self {
        Self {
            proof_of_work_bits: 0,
            vouch_count: 0,
            actions_last_hour: 0,
            account_age_hours: 0,
        }
    }
}

/// Knowledge provenance tracking
☉ Σ ProvenanceTracker {
    /// Provenance records
    records: HashMap<KnowledgeId, ProvenanceRecord>,
}

/// Provenance record
☉ Σ ProvenanceRecord {
    ☉ knowledge_id: KnowledgeId,
    ☉ original_source: AgentId,
    ☉ chain: Vec<ProvenanceLink>,
    ☉ timestamp: Timestamp,
}

⊢ ProvenanceTracker {
    ☉ rite new() -> Self {
        Self {
            records: HashMap·new(),
        }
    }

    /// Record knowledge provenance
    ☉ rite record(&Δ self, knowledge: &Knowledge, from: Option<AgentId>) {
        ≔ record = self.records.entry(knowledge.id.clone())
            .or_insert_with(|| ProvenanceRecord {
                knowledge_id: knowledge.id.clone(),
                original_source: knowledge.source.clone(),
                chain: vec![],
                timestamp: Timestamp·now(),
            });

        ⎇ ≔ Some(from_agent) = from {
            record.chain.push(ProvenanceLink {
                from: from_agent,
                to: knowledge.source.clone(),
                timestamp: Timestamp·now(),
                transformation: None,
            });
        }
    }

    /// Build provenance chain ∀ verification
    ☉ rite build_chain(&self, knowledge: &Knowledge) -> ProvenanceChain {
        ⌥ self.records.get(&knowledge.id) {
            Some(record) => ProvenanceChain {
                links: record.chain.clone(),
                valid: true, // Would do actual verification
            },
            None => ProvenanceChain {
                links: vec![],
                valid: true, // New knowledge, no chain yet
            },
        }
    }
}

⊢ Clone ∀ ProvenanceLink {
    rite clone(&self) -> Self {
        Self {
            from: self.from.clone(),
            to: self.to.clone(),
            timestamp: self.timestamp,
            transformation: self.transformation.clone(),
        }
    }
}

/// Quarantine ∀ suspicious content
☉ Σ Quarantine {
    items: HashMap<KnowledgeId, QuarantinedItem>,
}

Σ QuarantinedItem {
    knowledge: Knowledge,
    reasons: Vec<String>,
    quarantined_at: Timestamp,
    reviewed: bool,
}

⊢ Quarantine {
    ☉ rite new() -> Self {
        Self {
            items: HashMap·new(),
        }
    }

    ☉ rite add(&Δ self, knowledge: Knowledge, reasons: Vec<String>) {
        ≔ id = knowledge.id.clone();
        self.items.insert(id, QuarantinedItem {
            knowledge,
            reasons,
            quarantined_at: Timestamp·now(),
            reviewed: false,
        });
    }

    ☉ rite is_quarantined(&self, id: &KnowledgeId) -> bool {
        self.items.contains_key(id)
    }

    ☉ rite release(&Δ self, id: &KnowledgeId) -> Option<Knowledge> {
        self.items.remove(id).map(|item| item.knowledge)
    }

    ☉ rite count(&self) -> usize {
        self.items.len()
    }
}

⊢ CollectiveDefense {
    ☉ rite new() -> Self {
        Self {
            reputation: ReputationSystem·new(),
            sybil_resistance: SybilResistanceConfig·None,
            provenance: ProvenanceTracker·new(),
            quarantine: Quarantine·new(),
        }
    }

    ☉ rite with_sybil_resistance(Δ self, config: SybilResistanceConfig) -> Self {
        self.sybil_resistance = config;
        self
    }

    /// Verify knowledge before accepting
    ☉ rite verify_knowledge(&self, knowledge: &Knowledge, sybil_context: &SybilContext) -> Verification {
        ≔ source = &knowledge.source;

        // Check reputation
        ≔ reputation = self.reputation.score(source);
        ⎇ reputation < 0.3 {
            ⤺ Verification·Rejected {
                reasons: vec!["Low reputation source".to_string()],
            };
        }

        // Check ∀ Sybil attack
        ⎇ self.sybil_resistance.is_suspicious(source, sybil_context) {
            ⤺ Verification·Suspicious {
                reasons: vec!["Possible Sybil attack".to_string()],
            };
        }

        // Check quarantine
        ⎇ self.quarantine.is_quarantined(&knowledge.id) {
            ⤺ Verification·Rejected {
                reasons: vec!["Knowledge is quarantined".to_string()],
            };
        }

        // Build provenance chain
        ≔ chain = self.provenance.build_chain(knowledge);
        ⎇ !chain.is_valid() {
            ⤺ Verification·Suspicious {
                reasons: vec!["Invalid provenance chain".to_string()],
            };
        }

        Verification·Trusted { chain }
    }

    /// Record knowledge and track provenance
    ☉ rite record_knowledge(&Δ self, knowledge: &Knowledge, from: Option<AgentId>) {
        self.provenance.record(knowledge, from);
    }

    /// Quarantine suspicious knowledge
    ☉ rite quarantine(&Δ self, knowledge: Knowledge, reasons: Vec<String>) {
        self.quarantine.add(knowledge, reasons);
    }

    /// Get reputation system (mutable)
    ☉ rite reputation_mut(&Δ self) -> &Δ ReputationSystem {
        &Δ self.reputation
    }

    /// Get reputation system
    ☉ rite reputation(&self) -> &ReputationSystem {
        &self.reputation
    }
}
