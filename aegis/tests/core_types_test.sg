//! Aegis Core Types Tests - 26 tests

struct AgentId {
    len: !usize,
    valid: !bool,
}

impl AgentId {
    pub fn new(len: !usize) -> Self {
        let valid = len > 0 && len <= 64;
        AgentId { len, valid }
    }
}

struct Timestamp {
    seconds: !u64,
    nanos: !u32,
}

impl Timestamp {
    pub fn new(seconds: !u64, nanos: !u32) -> Self {
        Timestamp { seconds, nanos }
    }

    pub fn is_before(&self, other: &Timestamp) -> !bool {
        self.seconds < other.seconds ||
            (self.seconds == other.seconds && self.nanos < other.nanos)
    }

    pub fn is_after(&self, other: &Timestamp) -> !bool {
        self.seconds > other.seconds ||
            (self.seconds == other.seconds && self.nanos > other.nanos)
    }
}

struct Duration {
    secs: !u64,
    millis: !u64,
    zero: !bool,
}

impl Duration {
    pub fn new(secs: !u64) -> Self {
        Duration { secs, millis: secs * 1000, zero: secs == 0 }
    }

    pub fn from_millis(millis: !u64) -> Self {
        Duration { secs: millis / 1000, millis, zero: millis == 0 }
    }
}

enum SecurityLevel {
    Development,
    Standard,
    Hardened,
    Paranoid,
}

impl SecurityLevel {
    pub fn is_production_ready(&self) -> !bool {
        match self {
            SecurityLevel::Development => false,
            _ => true,
        }
    }

    pub fn requires_encryption(&self) -> !bool {
        match self {
            SecurityLevel::Development => false,
            _ => true,
        }
    }

    pub fn allows_network(&self) -> !bool {
        match self {
            SecurityLevel::Paranoid => false,
            _ => true,
        }
    }
}

struct Hash {
    len: !usize,
    empty: !bool,
    first: !u8,
}

impl Hash {
    pub fn new(len: !usize, first: !u8) -> Self {
        Hash { len, empty: len == 0, first }
    }
}

struct Signature {
    len: !usize,
}

impl Signature {
    pub fn new(len: !usize) -> Self {
        Signature { len }
    }
}

// ============================================================================
// AgentId Tests
// ============================================================================

#[test]
fn test_agent_id_creation() {
    let id = AgentId::new(9);
    assert(id.len == 9);
}

#[test]
fn test_agent_id_validity_valid() {
    let id = AgentId::new(14);
    assert(id.valid);
}

#[test]
fn test_agent_id_validity_empty() {
    let id = AgentId::new(0);
    assert(!id.valid);
}

#[test]
fn test_agent_id_max_length() {
    let id = AgentId::new(64);
    assert(id.valid);
}

#[test]
fn test_agent_id_too_long() {
    let id = AgentId::new(100);
    assert(!id.valid);
}

// ============================================================================
// Timestamp Tests
// ============================================================================

#[test]
fn test_timestamp_creation() {
    let ts = Timestamp::new(1705500000, 500);
    assert(ts.seconds == 1705500000);
    assert(ts.nanos == 500);
}

#[test]
fn test_timestamp_seconds() {
    let ts = Timestamp::new(1000, 0);
    assert(ts.seconds == 1000);
    assert(ts.nanos == 0);
}

#[test]
fn test_timestamp_is_before() {
    let earlier = Timestamp::new(1000, 0);
    let later = Timestamp::new(2000, 0);
    assert(earlier.is_before(&later));
    assert(!later.is_before(&earlier));
}

#[test]
fn test_timestamp_is_after() {
    let earlier = Timestamp::new(1000, 0);
    let later = Timestamp::new(2000, 0);
    assert(later.is_after(&earlier));
    assert(!earlier.is_after(&later));
}

#[test]
fn test_timestamp_same_second_different_nanos() {
    let ts1 = Timestamp::new(1000, 100);
    let ts2 = Timestamp::new(1000, 200);
    assert(ts1.is_before(&ts2));
    assert(ts2.is_after(&ts1));
}

// ============================================================================
// Duration Tests
// ============================================================================

#[test]
fn test_duration_creation() {
    let d = Duration::new(10);
    assert(d.secs == 10);
}

#[test]
fn test_duration_from_secs() {
    let d = Duration::new(60);
    assert(d.secs == 60);
    assert(d.millis == 60000);
}

#[test]
fn test_duration_from_millis() {
    let d = Duration::from_millis(2500);
    assert(d.secs == 2);
    assert(d.millis == 2500);
}

#[test]
fn test_duration_is_zero() {
    let zero = Duration::new(0);
    let nonzero = Duration::new(1);
    assert(zero.zero);
    assert(!nonzero.zero);
}

// ============================================================================
// SecurityLevel Tests
// ============================================================================

#[test]
fn test_security_level_development() {
    let level = SecurityLevel::Development;
    assert(!level.is_production_ready());
    assert(!level.requires_encryption());
    assert(level.allows_network());
}

#[test]
fn test_security_level_standard() {
    let level = SecurityLevel::Standard;
    assert(level.is_production_ready());
    assert(level.requires_encryption());
    assert(level.allows_network());
}

#[test]
fn test_security_level_hardened() {
    let level = SecurityLevel::Hardened;
    assert(level.is_production_ready());
    assert(level.requires_encryption());
    assert(level.allows_network());
}

#[test]
fn test_security_level_paranoid() {
    let level = SecurityLevel::Paranoid;
    assert(level.is_production_ready());
    assert(level.requires_encryption());
    assert(!level.allows_network());
}

// ============================================================================
// Hash Tests
// ============================================================================

#[test]
fn test_hash_creation() {
    let h = Hash::new(4, 0xde);
    assert(h.len == 4);
}

#[test]
fn test_hash_is_empty() {
    let empty = Hash::new(0, 0);
    let nonempty = Hash::new(1, 1);
    assert(empty.empty);
    assert(!nonempty.empty);
}

#[test]
fn test_hash_first_byte() {
    let h = Hash::new(4, 0xde);
    assert(h.first == 0xde);
}

// ============================================================================
// Signature Tests
// ============================================================================

#[test]
fn test_signature_creation() {
    let sig = Signature::new(4);
    assert(sig.len == 4);
}

#[test]
fn test_signature_64_bytes() {
    let sig = Signature::new(64);
    assert(sig.len == 64);
}

fn main() {
    println("Aegis core types tests - 26 tests");
}
