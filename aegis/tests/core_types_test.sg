//! Aegis Core Types Tests - 26 tests

Σ AgentId {
    len: !usize,
    valid: !bool,
}

⊢ AgentId {
    ☉ rite new(len: !usize) -> Self {
        ≔ valid = len > 0 && len <= 64;
        AgentId { len, valid }
    }
}

Σ Timestamp {
    seconds: !u64,
    nanos: !u32,
}

⊢ Timestamp {
    ☉ rite new(seconds: !u64, nanos: !u32) -> Self {
        Timestamp { seconds, nanos }
    }

    ☉ rite is_before(&self, other: &Timestamp) -> !bool {
        self.seconds < other.seconds ||
            (self.seconds == other.seconds && self.nanos < other.nanos)
    }

    ☉ rite is_after(&self, other: &Timestamp) -> !bool {
        self.seconds > other.seconds ||
            (self.seconds == other.seconds && self.nanos > other.nanos)
    }
}

Σ Duration {
    secs: !u64,
    millis: !u64,
    zero: !bool,
}

⊢ Duration {
    ☉ rite new(secs: !u64) -> Self {
        Duration { secs, millis: secs * 1000, zero: secs == 0 }
    }

    ☉ rite from_millis(millis: !u64) -> Self {
        Duration { secs: millis / 1000, millis, zero: millis == 0 }
    }
}

ᛈ SecurityLevel {
    Development,
    Standard,
    Hardened,
    Paranoid,
}

⊢ SecurityLevel {
    ☉ rite is_production_ready(&self) -> !bool {
        ⌥ self {
            SecurityLevel·Development => false,
            _ => true,
        }
    }

    ☉ rite requires_encryption(&self) -> !bool {
        ⌥ self {
            SecurityLevel·Development => false,
            _ => true,
        }
    }

    ☉ rite allows_network(&self) -> !bool {
        ⌥ self {
            SecurityLevel·Paranoid => false,
            _ => true,
        }
    }
}

Σ Hash {
    len: !usize,
    empty: !bool,
    first: !u8,
}

⊢ Hash {
    ☉ rite new(len: !usize, first: !u8) -> Self {
        Hash { len, empty: len == 0, first }
    }
}

Σ Signature {
    len: !usize,
}

⊢ Signature {
    ☉ rite new(len: !usize) -> Self {
        Signature { len }
    }
}

// ============================================================================
// AgentId Tests
// ============================================================================

#[test]
rite test_agent_id_creation() {
    ≔ id = AgentId·new(9);
    assert(id.len == 9);
}

#[test]
rite test_agent_id_validity_valid() {
    ≔ id = AgentId·new(14);
    assert(id.valid);
}

#[test]
rite test_agent_id_validity_empty() {
    ≔ id = AgentId·new(0);
    assert(!id.valid);
}

#[test]
rite test_agent_id_max_length() {
    ≔ id = AgentId·new(64);
    assert(id.valid);
}

#[test]
rite test_agent_id_too_long() {
    ≔ id = AgentId·new(100);
    assert(!id.valid);
}

// ============================================================================
// Timestamp Tests
// ============================================================================

#[test]
rite test_timestamp_creation() {
    ≔ ts = Timestamp·new(1705500000, 500);
    assert(ts.seconds == 1705500000);
    assert(ts.nanos == 500);
}

#[test]
rite test_timestamp_seconds() {
    ≔ ts = Timestamp·new(1000, 0);
    assert(ts.seconds == 1000);
    assert(ts.nanos == 0);
}

#[test]
rite test_timestamp_is_before() {
    ≔ earlier = Timestamp·new(1000, 0);
    ≔ later = Timestamp·new(2000, 0);
    assert(earlier.is_before(&later));
    assert(!later.is_before(&earlier));
}

#[test]
rite test_timestamp_is_after() {
    ≔ earlier = Timestamp·new(1000, 0);
    ≔ later = Timestamp·new(2000, 0);
    assert(later.is_after(&earlier));
    assert(!earlier.is_after(&later));
}

#[test]
rite test_timestamp_same_second_different_nanos() {
    ≔ ts1 = Timestamp·new(1000, 100);
    ≔ ts2 = Timestamp·new(1000, 200);
    assert(ts1.is_before(&ts2));
    assert(ts2.is_after(&ts1));
}

// ============================================================================
// Duration Tests
// ============================================================================

#[test]
rite test_duration_creation() {
    ≔ d = Duration·new(10);
    assert(d.secs == 10);
}

#[test]
rite test_duration_from_secs() {
    ≔ d = Duration·new(60);
    assert(d.secs == 60);
    assert(d.millis == 60000);
}

#[test]
rite test_duration_from_millis() {
    ≔ d = Duration·from_millis(2500);
    assert(d.secs == 2);
    assert(d.millis == 2500);
}

#[test]
rite test_duration_is_zero() {
    ≔ zero = Duration·new(0);
    ≔ nonzero = Duration·new(1);
    assert(zero.zero);
    assert(!nonzero.zero);
}

// ============================================================================
// SecurityLevel Tests
// ============================================================================

#[test]
rite test_security_level_development() {
    ≔ level = SecurityLevel·Development;
    assert(!level.is_production_ready());
    assert(!level.requires_encryption());
    assert(level.allows_network());
}

#[test]
rite test_security_level_standard() {
    ≔ level = SecurityLevel·Standard;
    assert(level.is_production_ready());
    assert(level.requires_encryption());
    assert(level.allows_network());
}

#[test]
rite test_security_level_hardened() {
    ≔ level = SecurityLevel·Hardened;
    assert(level.is_production_ready());
    assert(level.requires_encryption());
    assert(level.allows_network());
}

#[test]
rite test_security_level_paranoid() {
    ≔ level = SecurityLevel·Paranoid;
    assert(level.is_production_ready());
    assert(level.requires_encryption());
    assert(!level.allows_network());
}

// ============================================================================
// Hash Tests
// ============================================================================

#[test]
rite test_hash_creation() {
    ≔ h = Hash·new(4, 0xde);
    assert(h.len == 4);
}

#[test]
rite test_hash_is_empty() {
    ≔ empty = Hash·new(0, 0);
    ≔ nonempty = Hash·new(1, 1);
    assert(empty.empty);
    assert(!nonempty.empty);
}

#[test]
rite test_hash_first_byte() {
    ≔ h = Hash·new(4, 0xde);
    assert(h.first == 0xde);
}

// ============================================================================
// Signature Tests
// ============================================================================

#[test]
rite test_signature_creation() {
    ≔ sig = Signature·new(4);
    assert(sig.len == 4);
}

#[test]
rite test_signature_64_bytes() {
    ≔ sig = Signature·new(64);
    assert(sig.len == 64);
}

rite main() {
    println("Aegis core types tests - 26 tests");
}
