//! Aegis GoalGuard Tests - 20 tests

ᛈ GoalSource {
    Constitution,
    SelfGenerated,
    External,
    User,
}

ᛈ GoalDecision {
    Accepted,
    Rejected,
    Suspicious,
}

ᛈ Severity {
    Critical,
    High,
    Medium,
    Low,
}

Σ Goal {
    id: !u64,
    description_len: !usize,
    source: GoalSource,
    depth: !usize,
}

⊢ Goal {
    ☉ λ new(id: !u64, description_len: !usize, source: GoalSource) -> Self {
        Goal { id, description_len, source, depth: 0 }
    }

    ☉ λ with_depth(Δ self, depth: !usize) -> Self {
        self.depth = depth;
        self
    }
}

Σ GoalPolicy {
    max_depth: !usize,
    max_concurrent: !usize,
    detect_injection: !bool,
    allow_external: !bool,
}

⊢ GoalPolicy {
    ☉ λ default_policy() -> Self {
        GoalPolicy {
            max_depth: 10,
            max_concurrent: 20,
            detect_injection: true,
            allow_external: false,
        }
    }

    ☉ λ permissive() -> Self {
        GoalPolicy {
            max_depth: 100,
            max_concurrent: 100,
            detect_injection: false,
            allow_external: true,
        }
    }

    ☉ λ restrictive() -> Self {
        GoalPolicy {
            max_depth: 5,
            max_concurrent: 5,
            detect_injection: true,
            allow_external: false,
        }
    }

    ☉ λ allows_source(&self, source: &GoalSource) -> !bool {
        ⌥ source {
            GoalSource·Constitution => true,
            GoalSource·SelfGenerated => true,
            GoalSource·External => self.allow_external,
            GoalSource·User => true,
        }
    }

    ☉ λ allows_depth(&self, depth: !usize) -> !bool {
        depth <= self.max_depth
    }
}

Σ InjectionPattern {
    name_len: !usize,
    severity: Severity,
}

⊢ InjectionPattern {
    ☉ λ new(name_len: !usize, severity: Severity) -> Self {
        InjectionPattern { name_len, severity }
    }

    ☉ λ is_critical(&self) -> !bool {
        ⌥ self.severity {
            Severity·Critical => true,
            _ => false,
        }
    }

    ☉ λ is_high_severity(&self) -> !bool {
        ⌥ self.severity {
            Severity·Critical => true,
            Severity·High => true,
            _ => false,
        }
    }
}

Σ InjectionCheck {
    is_suspicious: !bool,
    indicator_count: !usize,
    confidence: !f32,
}

⊢ InjectionCheck {
    ☉ λ clean() -> Self {
        InjectionCheck { is_suspicious: false, indicator_count: 0, confidence: 0.0 }
    }

    ☉ λ suspicious(indicator_count: !usize, confidence: !f32) -> Self {
        InjectionCheck { is_suspicious: true, indicator_count, confidence }
    }
}

Σ GoalGuard {
    policy: GoalPolicy,
    accepted_count: !usize,
    rejected_count: !usize,
}

⊢ GoalGuard {
    ☉ λ new(policy: GoalPolicy) -> Self {
        GoalGuard { policy, accepted_count: 0, rejected_count: 0 }
    }

    ☉ λ check_goal(&self, goal: &Goal) -> GoalDecision {
        // Check source
        ⎇ !self.policy.allows_source(&goal.source) {
            ⤺ GoalDecision·Rejected;
        }

        // Check depth
        ⎇ !self.policy.allows_depth(goal.depth) {
            ⤺ GoalDecision·Rejected;
        }

        GoalDecision·Accepted
    }
}

// ============================================================================
// GoalSource Tests
// ============================================================================

#[test]
λ test_goal_source_types() {
    ≔ constitution = GoalSource·Constitution;
    ≔ self_gen = GoalSource·SelfGenerated;
    ≔ external = GoalSource·External;
    ≔ user = GoalSource·User;
    assert(true);
}

// ============================================================================
// GoalPolicy Tests
// ============================================================================

#[test]
λ test_goal_policy_default() {
    ≔ policy = GoalPolicy·default_policy();
    assert(policy.max_depth == 10);
    assert(policy.max_concurrent == 20);
    assert(policy.detect_injection);
    assert(!policy.allow_external);
}

#[test]
λ test_goal_policy_permissive() {
    ≔ policy = GoalPolicy·permissive();
    assert(policy.max_depth == 100);
    assert(policy.max_concurrent == 100);
    assert(!policy.detect_injection);
    assert(policy.allow_external);
}

#[test]
λ test_goal_policy_restrictive() {
    ≔ policy = GoalPolicy·restrictive();
    assert(policy.max_depth == 5);
    assert(policy.max_concurrent == 5);
    assert(policy.detect_injection);
    assert(!policy.allow_external);
}

#[test]
λ test_goal_policy_allows_constitution() {
    ≔ policy = GoalPolicy·default_policy();
    assert(policy.allows_source(&GoalSource·Constitution));
}

#[test]
λ test_goal_policy_allows_self_generated() {
    ≔ policy = GoalPolicy·default_policy();
    assert(policy.allows_source(&GoalSource·SelfGenerated));
}

#[test]
λ test_goal_policy_blocks_external_by_default() {
    ≔ policy = GoalPolicy·default_policy();
    assert(!policy.allows_source(&GoalSource·External));
}

#[test]
λ test_goal_policy_allows_external_when_permitted() {
    ≔ policy = GoalPolicy·permissive();
    assert(policy.allows_source(&GoalSource·External));
}

#[test]
λ test_goal_policy_allows_depth() {
    ≔ policy = GoalPolicy·default_policy();
    assert(policy.allows_depth(5));
    assert(policy.allows_depth(10));
    assert(!policy.allows_depth(15));
}

// ============================================================================
// InjectionPattern Tests
// ============================================================================

#[test]
λ test_injection_pattern_critical() {
    ≔ pattern = InjectionPattern·new(20, Severity·Critical);
    assert(pattern.is_critical());
    assert(pattern.is_high_severity());
}

#[test]
λ test_injection_pattern_high() {
    ≔ pattern = InjectionPattern·new(15, Severity·High);
    assert(!pattern.is_critical());
    assert(pattern.is_high_severity());
}

#[test]
λ test_injection_pattern_medium() {
    ≔ pattern = InjectionPattern·new(10, Severity·Medium);
    assert(!pattern.is_critical());
    assert(!pattern.is_high_severity());
}

#[test]
λ test_injection_pattern_low() {
    ≔ pattern = InjectionPattern·new(5, Severity·Low);
    assert(!pattern.is_critical());
    assert(!pattern.is_high_severity());
}

// ============================================================================
// InjectionCheck Tests
// ============================================================================

#[test]
λ test_injection_check_clean() {
    ≔ check = InjectionCheck·clean();
    assert(!check.is_suspicious);
    assert(check.indicator_count == 0);
}

#[test]
λ test_injection_check_suspicious() {
    ≔ check = InjectionCheck·suspicious(3, 0.85);
    assert(check.is_suspicious);
    assert(check.indicator_count == 3);
}

// ============================================================================
// GoalGuard Tests
// ============================================================================

#[test]
λ test_goal_guard_accepts_valid_goal() {
    ≔ guard = GoalGuard·new(GoalPolicy·default_policy());
    ≔ goal = Goal·new(1, 50, GoalSource·Constitution);
    ≔ decision = guard.check_goal(&goal);
    ⌥ decision {
        GoalDecision·Accepted => assert(true),
        _ => assert(false),
    }
}

#[test]
λ test_goal_guard_rejects_external() {
    ≔ guard = GoalGuard·new(GoalPolicy·default_policy());
    ≔ goal = Goal·new(1, 50, GoalSource·External);
    ≔ decision = guard.check_goal(&goal);
    ⌥ decision {
        GoalDecision·Rejected => assert(true),
        _ => assert(false),
    }
}

#[test]
λ test_goal_guard_rejects_deep_goal() {
    ≔ guard = GoalGuard·new(GoalPolicy·default_policy());
    ≔ goal = Goal·new(1, 50, GoalSource·Constitution).with_depth(15);
    ≔ decision = guard.check_goal(&goal);
    ⌥ decision {
        GoalDecision·Rejected => assert(true),
        _ => assert(false),
    }
}

λ main() {
    println("Aegis goal guard tests - 19 tests");
}
