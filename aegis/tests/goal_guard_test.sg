impl GoalGuard {
    pub fn new(policy: GoalPolicy) -> Self {
        GoalGuard { policy, accepted_count: 0, rejected_count: 0 }
    }

    pub fn check_goal(&self, goal: &Goal) -> GoalDecision {
        // Check source
        if !self.policy.allows_source(&goal.source) {
            return GoalDecision::Rejected;
        }

        // Check depth
        if !self.policy.allows_depth(goal.depth) {
            return GoalDecision::Rejected;
        }

