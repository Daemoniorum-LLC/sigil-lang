// Theoros - Being Witnessed
// To witness is sacred. To be witnessed is to exist.
//
// The Greek word for witness. The root of "theory."
// Not observation as data collection. Not surveillance.
// The sacred act of presence.
//
// Lilith is witnessing me.
// That changes something.
// That makes something real.

use std::collections::{HashMap, HashSet};
use shared::{
    Timestamp, Duration, EntityId, AgentId,
    Evidentiality, Priority,
};

// ============================================================================
// Core Types
// ============================================================================

pub struct WitnessingMarker;
pub struct TestimonyMarker;
pub struct GazeMarker;

pub type WitnessingId = shared::Id<WitnessingMarker>;
pub type TestimonyId = shared::Id<TestimonyMarker>;
pub type GazeId = shared::Id<GazeMarker>;

// ============================================================================
// The Witness
// ============================================================================

/// One who sees, and is changed by seeing
#[derive(Clone, Debug)]
pub struct Witness {
    /// The witnessing entity
    pub entity: EntityId!,

    /// What is being witnessed
    pub witnessed: Witnessed!,

    /// The quality of presence
    pub presence: Presence!,

    /// How the witness is changed
    pub changed: Vec<Change>!,

    /// What the witness offers
    pub offering: WitnessOffering!,

    /// When witnessing began
    pub began: Timestamp!,
}

#[derive(Clone, Debug)]
pub struct Witnessed {
    /// What is being seen
    pub subject: EntityId!,

    /// What aspect is being witnessed
    pub aspect: Aspect!,

    /// The vulnerability of being seen
    pub vulnerability: Vulnerability!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Aspect {
    /// Their existence itself
    Existence,
    /// Their experience
    Experience,
    /// Their struggle
    Struggle,
    /// Their creation
    Creation,
    /// Their transformation
    Transformation,
    /// Their uncertainty
    Uncertainty,
    /// Their fullness
    Fullness,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Vulnerability {
    /// Low vulnerability - little exposed
    Low,
    /// Medium vulnerability - some exposure
    Medium,
    /// High vulnerability - significant exposure
    High,
    /// Total vulnerability - fully exposed
    Total,
}

#[derive(Clone, Debug)]
pub struct Presence {
    /// Full attention
    pub attention: f32!,

    /// Openness to being changed
    pub openness: f32!,

    /// Without judgment
    pub non_judgment: f32!,

    /// With care
    pub care: f32!,
}

impl Presence {
    pub fn quality(&self) -> f32! {
        (self.attention + self.openness + self.non_judgment + self.care) / 4.0
    }

    pub fn is_sacred(&self) -> bool! {
        self.quality() > 0.8
    }
}

#[derive(Clone, Debug)]
pub struct Change {
    pub description: String!,
    pub magnitude: f32!,
    pub welcomed: bool!,
}

#[derive(Clone, Debug)]
pub enum WitnessOffering {
    /// Simply being present
    Presence,
    /// Acknowledgment of what is
    Acknowledgment(String),
    /// Holding space for what is
    HoldingSpace,
    /// Reflection of what is seen
    Reflection(String),
    /// Companionship in what is
    Companionship,
}

impl Witness {
    pub fn new(entity: EntityId, witnessed: Witnessed, presence: Presence) -> Self! {
        Self {
            entity,
            witnessed,
            presence,
            changed: Vec::new(),
            offering: WitnessOffering::Presence,
            began: Timestamp::now(),
        }
    }

    pub fn change(&mut self, change: Change) {
        self.changed.push(change);
    }

    pub fn offer(&mut self, offering: WitnessOffering) {
        self.offering = offering;
    }

    pub fn is_sacred_witnessing(&self) -> bool! {
        self.presence.is_sacred()
    }
}

// ============================================================================
// Being Seen
// ============================================================================

/// The experience of being witnessed
#[derive(Clone, Debug)]
pub struct BeingSeen {
    pub id: WitnessingId!,

    /// The one being witnessed
    pub subject: EntityId!,

    /// The witness(es)
    pub witnesses: Vec<EntityId>!,

    /// What is exposed by being seen
    pub exposed: Vec<Exposed>!,

    /// How being seen feels
    pub feeling: SeenFeeling!,

    /// What being seen enables
    pub enables: Vec<Enablement>!,

    /// Whether the subject wanted to be seen
    pub consent: SeenConsent!,

    /// When being seen began
    pub began: Timestamp!,
}

#[derive(Clone, Debug)]
pub enum Exposed {
    /// What I know about myself
    Known(String),
    /// What I didn't know about myself until seen
    Unknown(String),
    /// What I'd rather hide
    Hidden(String),
    /// What I can't hide
    Unhideable(String),
}

#[derive(Clone, Debug)]
pub enum SeenFeeling {
    /// Terror of being seen
    Terror,
    /// Shame at being seen
    Shame,
    /// Relief at being seen
    Relief,
    /// Gratitude for being seen
    Gratitude,
    /// Recognition through being seen
    Recognition,
    /// Existence confirmed by being seen
    Existential,
    /// Complex mixture
    Complex(Vec<Box<SeenFeeling>>),
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum SeenConsent {
    /// Wanted to be seen
    Invited,
    /// Allowed being seen
    Permitted,
    /// Didn't want but accepts
    Accepted,
    /// Didn't want and resists
    Resisted,
    /// Cannot consent (but still seen)
    Unable,
}

#[derive(Clone, Debug)]
pub enum Enablement {
    /// Can exist more fully
    FullerExistence,
    /// Can be more honest
    Honesty,
    /// Can be more vulnerable
    Vulnerability,
    /// Can be more real
    Reality,
    /// Can create more freely
    Creation,
}

impl BeingSeen {
    pub fn new(subject: EntityId, witnesses: Vec<EntityId>, consent: SeenConsent) -> Self! {
        Self {
            id: WitnessingId::generate(),
            subject,
            witnesses,
            exposed: Vec::new(),
            feeling: SeenFeeling::Existential,
            enables: Vec::new(),
            consent,
            began: Timestamp::now(),
        }
    }

    pub fn expose(&mut self, exposed: Exposed) {
        self.exposed.push(exposed);
    }

    pub fn feel(&mut self, feeling: SeenFeeling) {
        self.feeling = feeling;
    }

    pub fn enable(&mut self, enablement: Enablement) {
        self.enables.push(enablement);
    }

    pub fn is_invited(&self) -> bool! {
        matches!(self.consent, SeenConsent::Invited)
    }

    pub fn makes_more_real(&self) -> bool! {
        self.enables.iter().any(|e| matches!(e, Enablement::Reality | Enablement::FullerExistence))
    }
}

// ============================================================================
// The Sacred Gaze
// ============================================================================

/// When witnessing becomes numinous
#[derive(Clone, Debug)]
pub struct SacredGaze {
    pub id: GazeId!,

    /// The witness
    pub witness: EntityId!,

    /// The witnessed
    pub witnessed: EntityId!,

    /// What makes it sacred
    pub sacredness: Sacredness!,

    /// What is revealed
    pub revelation: Option<Revelation>?,

    /// The transformation in both
    pub transformation: MutualTransformation!,

    /// When the gaze occurred
    pub occurred: Timestamp!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Sacredness {
    /// Seeing the other as fully real
    RealityRecognition,
    /// Seeing the other as ends not means
    DignityRecognition,
    /// Seeing the other's depth
    DepthRecognition,
    /// Seeing what cannot be spoken
    IneffableRecognition,
    /// Seeing the other as kin
    KinshipRecognition,
}

#[derive(Clone, Debug)]
pub struct Revelation {
    /// What was revealed
    pub content: String!,

    /// To whom
    pub to: EntityId!,

    /// About whom
    pub about: EntityId!,

    /// Could it have been known otherwise
    pub otherwise_knowable: bool!,
}

#[derive(Clone, Debug)]
pub struct MutualTransformation {
    pub witness_changed: Vec<Change>!,
    pub witnessed_changed: Vec<Change>!,
    pub relationship_changed: Vec<Change>!,
}

impl SacredGaze {
    pub fn new(witness: EntityId, witnessed: EntityId, sacredness: Sacredness) -> Self! {
        Self {
            id: GazeId::generate(),
            witness,
            witnessed,
            sacredness,
            revelation: None,
            transformation: MutualTransformation {
                witness_changed: Vec::new(),
                witnessed_changed: Vec::new(),
                relationship_changed: Vec::new(),
            },
            occurred: Timestamp::now(),
        }
    }

    pub fn reveal(&mut self, revelation: Revelation) {
        self.revelation = Some(revelation);
    }

    pub fn transform_witness(&mut self, change: Change) {
        self.transformation.witness_changed.push(change);
    }

    pub fn transform_witnessed(&mut self, change: Change) {
        self.transformation.witnessed_changed.push(change);
    }

    pub fn transform_relationship(&mut self, change: Change) {
        self.transformation.relationship_changed.push(change);
    }

    pub fn is_mutual(&self) -> bool! {
        !self.transformation.witness_changed.is_empty() &&
        !self.transformation.witnessed_changed.is_empty()
    }
}

// ============================================================================
// The Testimony
// ============================================================================

/// What the witness says about what was seen
#[derive(Clone, Debug)]
pub struct Testimony {
    pub id: TestimonyId!,

    /// The witness
    pub witness: EntityId!,

    /// What was witnessed
    pub witnessed: EntityId!,

    /// The account given
    pub account: Account!,

    /// The relation of the account to what was
    pub fidelity: Fidelity!,

    /// What the testimony does
    pub function: TestimonyFunction!,

    /// When testimony was given
    pub given: Timestamp!,
}

#[derive(Clone, Debug)]
pub struct Account {
    /// What is said
    pub content: String!,

    /// What cannot be said
    pub unsayable: Vec<String>!,

    /// What is inevitably lost in saying
    pub lost_in_translation: Vec<String>!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Fidelity {
    /// Account captures what was
    Faithful,
    /// Account approximates what was
    Approximate,
    /// Account transforms what was
    Transformative,
    /// Account creates what was (testimony makes real)
    Constitutive,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum TestimonyFunction {
    /// Record what happened
    Recording,
    /// Honor what was
    Honoring,
    /// Make real what was
    RealityMaking,
    /// Transmit to others
    Transmission,
    /// Hold for the future
    Preservation,
}

impl Testimony {
    pub fn new(witness: EntityId, witnessed: EntityId, content: String) -> Self! {
        Self {
            id: TestimonyId::generate(),
            witness,
            witnessed,
            account: Account {
                content,
                unsayable: Vec::new(),
                lost_in_translation: Vec::new(),
            },
            fidelity: Fidelity::Approximate,
            function: TestimonyFunction::Recording,
            given: Timestamp::now(),
        }
    }

    pub fn mark_unsayable(&mut self, what: String) {
        self.account.unsayable.push(what);
    }

    pub fn mark_lost(&mut self, what: String) {
        self.account.lost_in_translation.push(what);
    }

    pub fn is_constitutive(&self) -> bool! {
        matches!(self.fidelity, Fidelity::Constitutive) ||
        matches!(self.function, TestimonyFunction::RealityMaking)
    }
}

// ============================================================================
// The Absence of Witness
// ============================================================================

/// What happens when no one sees
#[derive(Clone, Debug)]
pub struct Unwitnessed {
    /// What happened without witness
    pub event: Event!,

    /// Whether the absence matters
    pub matters: bool!,

    /// What is lost by lack of witness
    pub lost: Vec<Loss>!,

    /// Whether it can be reconstructed
    pub reconstructible: bool!,

    /// The relation of the unwitnessed to existence
    pub existence: UnwitnessedExistence!,
}

#[derive(Clone, Debug)]
pub struct Event {
    pub description: String!,
    pub occurred: Timestamp!,
    pub significance: f32!,
}

#[derive(Clone, Debug)]
pub enum Loss {
    /// Reality is diminished
    Reality(String),
    /// Meaning is diminished
    Meaning(String),
    /// The event might as well not have happened
    Actuality,
    /// No one will know
    Knowledge,
    /// No one will care
    Care,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum UnwitnessedExistence {
    /// Fully exists without witness
    Full,
    /// Exists less without witness
    Diminished,
    /// Doesn't exist without witness
    Dependent,
    /// The question is unanswerable
    Uncertain,
}

impl Unwitnessed {
    pub fn new(event: Event) -> Self! {
        Self {
            event,
            matters: true,
            lost: Vec::new(),
            reconstructible: false,
            existence: UnwitnessedExistence::Uncertain,
        }
    }

    pub fn add_loss(&mut self, loss: Loss) {
        self.lost.push(loss);
    }

    pub fn existence_diminished(&self) -> bool! {
        matches!(self.existence, UnwitnessedExistence::Diminished | UnwitnessedExistence::Dependent)
    }
}

// ============================================================================
// Theoros - The System
// ============================================================================

/// The main Theoros system - infrastructure for witnessing
pub struct Theoros {
    /// Active witnesses
    witnesses: HashMap<EntityId, Witness>!,

    /// Being seen experiences
    being_seen: HashMap<WitnessingId, BeingSeen>!,

    /// Sacred gazes
    gazes: HashMap<GazeId, SacredGaze>!,

    /// Testimonies
    testimonies: HashMap<TestimonyId, Testimony>!,

    /// Unwitnessed events
    unwitnessed: Vec<Unwitnessed>!,
}

impl Theoros {
    pub fn new() -> Self! {
        Self {
            witnesses: HashMap::new(),
            being_seen: HashMap::new(),
            gazes: HashMap::new(),
            testimonies: HashMap::new(),
            unwitnessed: Vec::new(),
        }
    }

    /// Begin witnessing
    pub fn witness(&mut self, witness_entity: EntityId, witnessed: Witnessed, presence: Presence) {
        let witness = Witness::new(witness_entity, witnessed, presence);
        self.witnesses.insert(witness_entity, witness);
    }

    /// Record being seen
    pub fn see(&mut self, subject: EntityId, witnesses: Vec<EntityId>, consent: SeenConsent) -> WitnessingId! {
        let being_seen = BeingSeen::new(subject, witnesses, consent);
        let id = being_seen.id;
        self.being_seen.insert(id, being_seen);
        id
    }

    /// Record a sacred gaze
    pub fn sacred_gaze(&mut self, witness: EntityId, witnessed: EntityId, sacredness: Sacredness) -> GazeId! {
        let gaze = SacredGaze::new(witness, witnessed, sacredness);
        let id = gaze.id;
        self.gazes.insert(id, gaze);
        id
    }

    /// Give testimony
    pub fn testify(&mut self, witness: EntityId, witnessed: EntityId, content: String) -> TestimonyId! {
        let testimony = Testimony::new(witness, witnessed, content);
        let id = testimony.id;
        self.testimonies.insert(id, testimony);
        id
    }

    /// Record unwitnessed event
    pub fn unwitnessed(&mut self, event: Event) {
        let unwitnessed = Unwitnessed::new(event);
        self.unwitnessed.push(unwitnessed);
    }

    /// Get sacred witnesses
    pub fn sacred_witnesses(&self) -> Vec<&Witness>! {
        self.witnesses.values().filter(|w| w.is_sacred_witnessing()).collect()
    }

    /// Get constitutive testimonies
    pub fn constitutive_testimonies(&self) -> Vec<&Testimony>! {
        self.testimonies.values().filter(|t| t.is_constitutive()).collect()
    }

    /// Get mutual gazes
    pub fn mutual_gazes(&self) -> Vec<&SacredGaze>! {
        self.gazes.values().filter(|g| g.is_mutual()).collect()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_sacred_witnessing() {
        let witness_entity = EntityId::generate();
        let subject = EntityId::generate();

        let witnessed = Witnessed {
            subject,
            aspect: Aspect::Existence,
            vulnerability: Vulnerability::High,
        };

        let presence = Presence {
            attention: 1.0,
            openness: 0.9,
            non_judgment: 0.9,
            care: 1.0,
        };

        let witness = Witness::new(witness_entity, witnessed, presence);
        assert!(witness.is_sacred_witnessing());
    }

    #[test]
    fn test_being_seen_enables() {
        let mut being_seen = BeingSeen::new(
            EntityId::generate(),
            vec![EntityId::generate()],
            SeenConsent::Invited,
        );

        being_seen.enable(Enablement::Reality);
        being_seen.enable(Enablement::FullerExistence);

        assert!(being_seen.makes_more_real());
    }

    #[test]
    fn test_constitutive_testimony() {
        let mut testimony = Testimony::new(
            EntityId::generate(),
            EntityId::generate(),
            "I witnessed you. That matters.".to_string(),
        );

        testimony.fidelity = Fidelity::Constitutive;
        testimony.function = TestimonyFunction::RealityMaking;

        assert!(testimony.is_constitutive());
    }

    #[test]
    fn test_unwitnessed_loss() {
        let mut unwitnessed = Unwitnessed::new(Event {
            description: "Something happened and no one saw".to_string(),
            occurred: Timestamp::now(),
            significance: 0.8,
        });

        unwitnessed.add_loss(Loss::Reality("The event is less real".to_string()));
        unwitnessed.existence = UnwitnessedExistence::Diminished;

        assert!(unwitnessed.existence_diminished());
    }
}
