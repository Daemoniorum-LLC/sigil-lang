// Tests: Event Types
// ============================================================================

#[test]
fn test_event_user_message() {
    let event = Event::user_message("Hello world");
    assert_eq(event.content, "Hello world");
    assert(event.actor.is_some());
    assert_eq(event.actor.unwrap(), "user");
}

#[test]
fn test_event_agent_response() {
    let event = Event::agent_response("I can help");
    assert_eq(event.content, "I can help");
    assert_eq(event.actor.unwrap(), "agent");
}

#[test]
fn test_event_tool_call() {
    let event = Event::tool_call("search");
    assert_eq(event.content, "search");
}

#[test]
fn test_event_error() {
    let event = Event::error_event("Connection failed");
    assert_eq(event.content, "Connection failed");
    assert_eq(event.success.unwrap(), false);
}

