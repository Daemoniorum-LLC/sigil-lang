#[test]
fn test_participant_user() {
    let p = Participant::user("user_123");
    assert_eq(p.id, "user_123");
}

#[test]
fn test_participant_agent() {
    let p = Participant::agent("agent_456");
    assert_eq(p.id, "agent_456");
}

#[test]
fn test_participant_tool() {
    let p = Participant::tool("web_search");
    assert_eq(p.id, "web_search");
    assert(p.name.is_some());
}

// ============================================================================
// Tests: Context
// ============================================================================

#[test]
fn test_context_empty() {
    let ctx = Context::new();
    assert(ctx.goal.is_none());
    assert(ctx.task.is_none());
}

#[test]
fn test_context_with_goal() {
    let ctx = Context::with_goal("Help user");
    assert_eq(ctx.goal.unwrap(), "Help user");
}

#[test]
fn test_context_with_task() {
    let ctx = Context::with_goal("Main goal").with_task("Subtask");
    assert_eq(ctx.goal.unwrap(), "Main goal");
    assert_eq(ctx.task.unwrap(), "Subtask");
}

#[test]
fn test_context_to_string() {
    let ctx = Context::with_goal("Goal").with_task("Task");
    let s = ctx.to_string();
    assert(s.contains("Goal"));
    assert(s.contains("Task"));
}

// ============================================================================
// Tests: Significance Calculation
// ============================================================================

#[test]
fn test_significance_from_success() {
    let memory = EpisodicMemory::default_memory();
    let mut episode = Episode::new(1, Context::new());
    episode.outcome = Outcome::Success {
        goal_alignment: 0.9,
        effects: Vec::new(),
    };

    let sig = memory.compute_significance(&episode);
    assert(sig > 0.3);
}

#[test]
fn test_significance_from_failure() {
    let memory = EpisodicMemory::default_memory();
    let mut episode = Episode::new(1, Context::new());
    episode.outcome = Outcome::Failure {
        reason: "test".to_string(),
        recoverable: false,
    };

    let sig = memory.compute_significance(&episode);
    // Failures should be significant (learning opportunity)
    assert(sig >= 0.4);
}

#[test]
fn test_significance_from_events() {
    let memory = EpisodicMemory::default_memory();
    let mut episode = Episode::new(1, Context::new());

    // Add many events
    for _ in 0..15 {
        episode.add_event(Event::user_message("msg"));
    }

    let sig = memory.compute_significance(&episode);
    assert(sig > 0.2);  // More events = more significance
}

#[test]
fn test_significance_from_valence() {
    let memory = EpisodicMemory::default_memory();
    let mut episode = Episode::new(1, Context::new());
    episode.valence = 0.9;  // Strong positive emotion

    let sig = memory.compute_significance(&episode);
    assert(sig > 0.1);
}

fn main() {
    print("Engram episodic memory tests");
}
