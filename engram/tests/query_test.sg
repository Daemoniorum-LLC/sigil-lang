//! Tests for Engram Query System
//!
//! Verifies query building, filters, and result handling.

// ============================================================================
// Self-contained Test Types
// ============================================================================

pub enum Comparator {
    Eq,
    Ne,
    Gt,
    Lt,
    Gte,
    Lte,
}

impl Comparator {
    pub fn compare(&self, a: f64, b: f64) -> bool {
        match self {
            Comparator::Eq => (a - b).abs() < 0.0001,
            Comparator::Ne => (a - b).abs() >= 0.0001,
            Comparator::Gt => a > b,
            Comparator::Lt => a < b,
            Comparator::Gte => a >= b,
            Comparator::Lte => a <= b,
        }
    }
}

pub enum TimePoint {
    Now,
    Absolute(u64),
    Relative { amount_secs: u64, is_ago: bool },
}

impl TimePoint {
    pub fn now() -> Self { TimePoint::Now }

    pub fn absolute(ts: u64) -> Self { TimePoint::Absolute(ts) }

    pub fn ago(secs: u64) -> Self {
        TimePoint::Relative { amount_secs: secs, is_ago: true }
    }

    pub fn from_now(secs: u64) -> Self {
        TimePoint::Relative { amount_secs: secs, is_ago: false }
    }

    pub fn to_timestamp(&self, current_time: u64) -> u64 {
        match self {
            TimePoint::Now => current_time,
            TimePoint::Absolute(t) => *t,
            TimePoint::Relative { amount_secs, is_ago } => {
                if *is_ago {
                    current_time - amount_secs
                } else {
                    current_time + amount_secs
                }
            }
        }
    }
}

pub struct TimeRange {
    pub start: u64,
    pub end: u64,
}

impl TimeRange {
    pub fn new(start: u64, end: u64) -> Self {
        Self { start, end }
    }

    pub fn contains(&self, ts: u64) -> bool {
        ts >= self.start && ts <= self.end
    }
}

pub enum TemporalConstraint {
    During(TimeRange),
    Before(TimePoint),
    After(TimePoint),
    At(TimePoint),
    Between(TimePoint, TimePoint),
}

impl TemporalConstraint {
    pub fn matches(&self, ts: u64, current_time: u64) -> bool {
        match self {
            TemporalConstraint::During(range) => range.contains(ts),
            TemporalConstraint::Before(point) => ts < point.to_timestamp(current_time),
            TemporalConstraint::After(point) => ts > point.to_timestamp(current_time),
            TemporalConstraint::At(point) => {
                let target = point.to_timestamp(current_time);
                // Within 1 second
                ts >= target.saturating_sub(1) && ts <= target + 1
            },
            TemporalConstraint::Between(start, end) => {
                let start_ts = start.to_timestamp(current_time);
                let end_ts = end.to_timestamp(current_time);
                ts >= start_ts && ts <= end_ts
            }
        }
    }
}

pub enum MemorySource {
    Instant,
    Episodic,
    Semantic,
    Procedural,
}

impl Clone for MemorySource {
    fn clone(&self) -> Self {
        match self {
            MemorySource::Instant => MemorySource::Instant,
            MemorySource::Episodic => MemorySource::Episodic,
            MemorySource::Semantic => MemorySource::Semantic,
            MemorySource::Procedural => MemorySource::Procedural,
        }
    }
}

impl PartialEq for MemorySource {
    fn eq(&self, other: &Self) -> bool {
        match (self, other) {
            (MemorySource::Instant, MemorySource::Instant) => true,
            (MemorySource::Episodic, MemorySource::Episodic) => true,
            (MemorySource::Semantic, MemorySource::Semantic) => true,
            (MemorySource::Procedural, MemorySource::Procedural) => true,
            _ => false,
        }
    }
}

pub struct Memory {
    pub id: String,
    pub content: String,
    pub relevance: f64,
    pub confidence: f64,
    pub source: MemorySource,
    pub timestamp: u64,
}

pub enum Filter {
    Confidence { op: Comparator, value: f64 },
    Source(MemorySource),
    MinRelevance(f64),
}

impl Filter {
    pub fn matches(&self, memory: &Memory) -> bool {
        match self {
            Filter::Confidence { op, value } => op.compare(memory.confidence, *value),
            Filter::Source(source) => memory.source == *source,
            Filter::MinRelevance(min) => memory.relevance >= *min,
        }
    }
}

pub enum QueryHint {
    MaxCandidates(usize),
    TimeoutMs(u64),
    Approximate(bool),
    NoCache,
}

pub struct Query {
    text: Option<String>,
    entity: Option<String>,
    filters: Vec<Filter>,
    temporal: Option<TemporalConstraint>,
    limit: usize,
    offset: usize,
    include_gaps: bool,
    hints: Vec<QueryHint>,
}

impl Query {
    pub fn new(text: &str) -> Self {
        Self {
            text: Some(text.to_string()),
            entity: None,
            filters: Vec::new(),
            temporal: None,
            limit: 10,
            offset: 0,
            include_gaps: true,
            hints: Vec::new(),
        }
    }

    pub fn entity(label: &str) -> Self {
        Self {
            text: None,
            entity: Some(label.to_string()),
            filters: Vec::new(),
            temporal: None,
            limit: 10,
            offset: 0,
            include_gaps: false,
            hints: Vec::new(),
        }
    }

    pub fn filter(mut self, f: Filter) -> Self {
        self.filters.push(f);
        self
    }

    pub fn where_confidence(self, op: Comparator, value: f64) -> Self {
        self.filter(Filter::Confidence { op, value })
    }

    pub fn where_source(self, source: MemorySource) -> Self {
        self.filter(Filter::Source(source))
    }

    pub fn during(mut self, range: TimeRange) -> Self {
        self.temporal = Some(TemporalConstraint::During(range));
        self
    }

    pub fn before(mut self, point: TimePoint) -> Self {
        self.temporal = Some(TemporalConstraint::Before(point));
        self
    }

    pub fn after(mut self, point: TimePoint) -> Self {
        self.temporal = Some(TemporalConstraint::After(point));
        self
    }

    pub fn limit(mut self, n: usize) -> Self {
        self.limit = n;
        self
    }

    pub fn offset(mut self, n: usize) -> Self {
        self.offset = n;
        self
    }

    pub fn top(self, n: usize) -> Self {
        self.limit(n)
    }

    pub fn with_gap_analysis(mut self) -> Self {
        self.include_gaps = true;
        self
    }

    pub fn hint(mut self, h: QueryHint) -> Self {
        self.hints.push(h);
        self
    }

    pub fn text(&self) -> String {
        self.text.clone().unwrap_or_default()
    }

    pub fn get_limit(&self) -> usize {
        self.limit
    }

    pub fn has_temporal(&self) -> bool {
        self.temporal.is_some()
    }

    pub fn apply_filters(&self, memories: &Vec<Memory>) -> Vec<&Memory> {
        memories.iter()
            .filter(|m| self.filters.iter().all(|f| f.matches(m)))
            .collect()
    }
}

pub struct ConfidenceDistribution {
    pub min: f64,
    pub max: f64,
    pub mean: f64,
    pub median: f64,
}

impl ConfidenceDistribution {
    pub fn from_values(values: &Vec<f64>) -> Self {
        if values.is_empty() {
            return Self { min: 0.0, max: 0.0, mean: 0.0, median: 0.0 };
        }

        let mut sorted = values.clone();
        // Simple bubble sort
        for i in 0..sorted.len() {
            for j in (i + 1)..sorted.len() {
                if sorted[j] < sorted[i] {
                    let temp = sorted[i];
                    sorted[i] = sorted[j];
                    sorted[j] = temp;
                }
            }
        }

        let min = sorted[0];
        let max = sorted[sorted.len() - 1];
        let mean = sorted.iter().sum::<f64>() / sorted.len() as f64;
        let median = sorted[sorted.len() / 2];

        Self { min, max, mean, median }
    }
}

pub struct Gap {
    pub description: String,
    pub severity: f64,
}

pub struct RecallResult {
    pub memories: Vec<Memory>,
    pub total_found: usize,
    pub returned: usize,
    pub confidence: ConfidenceDistribution,
    pub gaps: Vec<Gap>,
}

impl RecallResult {
    pub fn empty() -> Self {
        Self {
            memories: Vec::new(),
            total_found: 0,
            returned: 0,
            confidence: ConfidenceDistribution { min: 0.0, max: 0.0, mean: 0.0, median: 0.0 },
            gaps: Vec::new(),
        }
    }

    pub fn is_empty(&self) -> bool {
        self.memories.is_empty()
    }

    pub fn has_gaps(&self) -> bool {
        !self.gaps.is_empty()
    }

    pub fn high_confidence(&self) -> Vec<&Memory> {
        self.memories.iter().filter(|m| m.confidence > 0.8).collect()
    }
}

// ============================================================================
// Tests: Query Construction
// ============================================================================

#[test]
fn test_query_new() {
    let q = Query::new("find information about AI");
    assert_eq(q.text(), "find information about AI");
    assert_eq(q.get_limit(), 10);
}

#[test]
fn test_query_entity() {
    let q = Query::entity("Python");
    assert(q.text().is_empty());
    assert(!q.include_gaps);
}

#[test]
fn test_query_with_limit() {
    let q = Query::new("test").limit(5);
    assert_eq(q.get_limit(), 5);
}

#[test]
fn test_query_with_offset() {
    let q = Query::new("test").offset(10);
    assert_eq(q.offset, 10);
}

#[test]
fn test_query_top_alias() {
    let q = Query::new("test").top(3);
    assert_eq(q.get_limit(), 3);
}

#[test]
fn test_query_with_gap_analysis() {
    let q = Query::new("test").with_gap_analysis();
    assert(q.include_gaps);
}

// ============================================================================
// Tests: Comparator
// ============================================================================

#[test]
fn test_comparator_eq() {
    let cmp = Comparator::Eq;
    assert(cmp.compare(0.5, 0.5));
    assert(!cmp.compare(0.5, 0.6));
}

#[test]
fn test_comparator_ne() {
    let cmp = Comparator::Ne;
    assert(cmp.compare(0.5, 0.6));
    assert(!cmp.compare(0.5, 0.5));
}

#[test]
fn test_comparator_gt() {
    let cmp = Comparator::Gt;
    assert(cmp.compare(0.6, 0.5));
    assert(!cmp.compare(0.5, 0.6));
}

#[test]
fn test_comparator_lt() {
    let cmp = Comparator::Lt;
    assert(cmp.compare(0.4, 0.5));
    assert(!cmp.compare(0.6, 0.5));
}

#[test]
fn test_comparator_gte() {
    let cmp = Comparator::Gte;
    assert(cmp.compare(0.5, 0.5));
    assert(cmp.compare(0.6, 0.5));
    assert(!cmp.compare(0.4, 0.5));
}

#[test]
fn test_comparator_lte() {
    let cmp = Comparator::Lte;
    assert(cmp.compare(0.5, 0.5));
    assert(cmp.compare(0.4, 0.5));
    assert(!cmp.compare(0.6, 0.5));
}

// ============================================================================
// Tests: Filters
// ============================================================================

#[test]
fn test_filter_confidence() {
    let filter = Filter::Confidence { op: Comparator::Gt, value: 0.7 };
    let high = Memory {
        id: "1".to_string(), content: "test".to_string(),
        relevance: 0.8, confidence: 0.9,
        source: MemorySource::Semantic, timestamp: 0
    };
    let low = Memory {
        id: "2".to_string(), content: "test".to_string(),
        relevance: 0.8, confidence: 0.5,
        source: MemorySource::Semantic, timestamp: 0
    };

    assert(filter.matches(&high));
    assert(!filter.matches(&low));
}

#[test]
fn test_filter_source() {
    let filter = Filter::Source(MemorySource::Episodic);
    let episodic = Memory {
        id: "1".to_string(), content: "test".to_string(),
        relevance: 0.8, confidence: 0.9,
        source: MemorySource::Episodic, timestamp: 0
    };
    let semantic = Memory {
        id: "2".to_string(), content: "test".to_string(),
        relevance: 0.8, confidence: 0.9,
        source: MemorySource::Semantic, timestamp: 0
    };

    assert(filter.matches(&episodic));
    assert(!filter.matches(&semantic));
}

#[test]
fn test_filter_min_relevance() {
    let filter = Filter::MinRelevance(0.6);
    let high = Memory {
        id: "1".to_string(), content: "test".to_string(),
        relevance: 0.8, confidence: 0.5,
        source: MemorySource::Instant, timestamp: 0
    };
    let low = Memory {
        id: "2".to_string(), content: "test".to_string(),
        relevance: 0.4, confidence: 0.5,
        source: MemorySource::Instant, timestamp: 0
    };

    assert(filter.matches(&high));
    assert(!filter.matches(&low));
}

#[test]
fn test_query_apply_filters() {
    let q = Query::new("test")
        .where_confidence(Comparator::Gte, 0.7);

    let memories = vec![
        Memory {
            id: "1".to_string(), content: "test".to_string(),
            relevance: 0.9, confidence: 0.8,
            source: MemorySource::Semantic, timestamp: 0
        },
        Memory {
            id: "2".to_string(), content: "test".to_string(),
            relevance: 0.5, confidence: 0.5,
            source: MemorySource::Semantic, timestamp: 0
        },
    ];

    let filtered = q.apply_filters(&memories);
    assert_eq(filtered.len(), 1);
}

// ============================================================================
// Tests: Temporal Constraints
// ============================================================================

#[test]
fn test_time_range() {
    let range = TimeRange::new(100, 200);
    assert(range.contains(150));
    assert(range.contains(100));
    assert(range.contains(200));
    assert(!range.contains(50));
    assert(!range.contains(250));
}

#[test]
fn test_time_point_now() {
    let point = TimePoint::now();
    let ts = point.to_timestamp(1000);
    assert_eq(ts, 1000);
}

#[test]
fn test_time_point_absolute() {
    let point = TimePoint::absolute(500);
    let ts = point.to_timestamp(1000);
    assert_eq(ts, 500);
}

#[test]
fn test_time_point_ago() {
    let point = TimePoint::ago(100);
    let ts = point.to_timestamp(1000);
    assert_eq(ts, 900);
}

#[test]
fn test_time_point_from_now() {
    let point = TimePoint::from_now(100);
    let ts = point.to_timestamp(1000);
    assert_eq(ts, 1100);
}

#[test]
fn test_temporal_during() {
    let constraint = TemporalConstraint::During(TimeRange::new(100, 200));
    assert(constraint.matches(150, 1000));
    assert(!constraint.matches(50, 1000));
}

#[test]
fn test_temporal_before() {
    let constraint = TemporalConstraint::Before(TimePoint::absolute(500));
    assert(constraint.matches(400, 1000));
    assert(!constraint.matches(600, 1000));
}

#[test]
fn test_temporal_after() {
    let constraint = TemporalConstraint::After(TimePoint::absolute(500));
    assert(constraint.matches(600, 1000));
    assert(!constraint.matches(400, 1000));
}

#[test]
fn test_temporal_between() {
    let constraint = TemporalConstraint::Between(
        TimePoint::absolute(100),
        TimePoint::absolute(300)
    );
    assert(constraint.matches(200, 1000));
    assert(!constraint.matches(400, 1000));
}

#[test]
fn test_query_has_temporal() {
    let q1 = Query::new("test");
    let q2 = Query::new("test").before(TimePoint::now());

    assert(!q1.has_temporal());
    assert(q2.has_temporal());
}

// ============================================================================
// Tests: Query Hints
// ============================================================================

#[test]
fn test_query_with_hints() {
    let q = Query::new("test")
        .hint(QueryHint::MaxCandidates(100))
        .hint(QueryHint::Approximate(true))
        .hint(QueryHint::NoCache);

    assert_eq(q.hints.len(), 3);
}

// ============================================================================
// Tests: Confidence Distribution
// ============================================================================

#[test]
fn test_confidence_distribution_empty() {
    let dist = ConfidenceDistribution::from_values(&Vec::new());
    assert_eq(dist.min, 0.0);
    assert_eq(dist.max, 0.0);
}

#[test]
fn test_confidence_distribution_single() {
    let dist = ConfidenceDistribution::from_values(&vec![0.5]);
    assert_eq(dist.min, 0.5);
    assert_eq(dist.max, 0.5);
    assert_eq(dist.mean, 0.5);
}

#[test]
fn test_confidence_distribution_multiple() {
    let dist = ConfidenceDistribution::from_values(&vec![0.2, 0.4, 0.6, 0.8]);
    assert_eq(dist.min, 0.2);
    assert_eq(dist.max, 0.8);
    let mean_diff = (dist.mean - 0.5).abs();
    assert(mean_diff < 0.01);
}

// ============================================================================
// Tests: RecallResult
// ============================================================================

#[test]
fn test_recall_result_empty() {
    let result = RecallResult::empty();
    assert(result.is_empty());
    assert_eq(result.total_found, 0);
}

#[test]
fn test_recall_result_has_gaps() {
    let mut result = RecallResult::empty();
    assert(!result.has_gaps());

    result.gaps.push(Gap {
        description: "Missing info".to_string(),
        severity: 0.5,
    });
    assert(result.has_gaps());
}

#[test]
fn test_recall_result_high_confidence() {
    let mut result = RecallResult::empty();
    result.memories.push(Memory {
        id: "1".to_string(), content: "high".to_string(),
        relevance: 0.9, confidence: 0.9,
        source: MemorySource::Semantic, timestamp: 0
    });
    result.memories.push(Memory {
        id: "2".to_string(), content: "low".to_string(),
        relevance: 0.9, confidence: 0.5,
        source: MemorySource::Semantic, timestamp: 0
    });

    let high = result.high_confidence();
    assert_eq(high.len(), 1);
    assert_eq(high[0].content, "high");
}

fn main() {
    print("Engram query system tests");
}
