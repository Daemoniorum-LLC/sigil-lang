// Engram Integration Tests
// Comprehensive tests ∀ the memory system

invoke engram·*

scroll types_tests {
    invoke super·*

    #[test]
    λ test_epistemic_strength() {
        assert_eq!(Epistemic·Axiomatic.strength(), 1.0);
        assert!(Epistemic·Observed {
            observer: "test".to_string(),
            timestamp: Instant·now(),
        }.strength() > 0.9);
        assert!(Epistemic·Unknown.strength() == 0.0);
    }

    #[test]
    λ test_epistemic_checks() {
        ≔ observed = Epistemic·Observed {
            observer: "test".to_string(),
            timestamp: Instant·now(),
        };
        assert!(observed.is_observed!());
        assert!(observed.is_certain());
        assert!(!observed.is_uncertain());

        ≔ reported = Epistemic·Reported {
            source: Source·Unknown,
            trust_level: 0.3,
        };
        assert!(reported.is_reported~());
        assert!(!reported.is_observed!());
    }

    #[test]
    λ test_vector_operations() {
        ≔ v1 = Vector·new(vec![1.0, 0.0, 0.0]);
        ≔ v2 = Vector·new(vec![0.0, 1.0, 0.0]);
        ≔ v3 = Vector·new(vec![1.0, 0.0, 0.0]);

        // Orthogonal vectors have zero similarity
        ≔ sim_12 = v1.cosine_similarity(&v2);
        assert!(sim_12.abs() < 0.01);

        // Identical vectors have similarity 1
        ≔ sim_13 = v1.cosine_similarity(&v3);
        assert!((sim_13 - 1.0).abs() < 0.01);

        // Normalization
        ≔ unnorm = Vector·new(vec![3.0, 4.0, 0.0]);
        ≔ norm = unnorm.normalize();
        ≔ magnitude: f32 = norm.as_slice().iter().map(|x| x * x).sum·<f32>().sqrt();
        assert!((magnitude - 1.0).abs() < 0.01);
    }

    #[test]
    λ test_outcome_confidence() {
        ≔ success = Outcome·Success {
            result: json!({}),
            goal_alignment: 0.8,
        };
        assert_eq!(success.confidence(), 0.8);

        ≔ failure = Outcome·Failure {
            error: "test".to_string(),
            recoverable: true,
            learned: None,
        };
        assert!(failure.confidence() < 0.5);

        ≔ partial = Outcome·Partial {
            completed: vec!["a".to_string(), "b".to_string()],
            remaining: vec!["c".to_string()],
            blockers: vec![],
        };
        assert!((partial.confidence() - 0.666).abs() < 0.01);
    }
}

scroll instant_memory_tests {
    invoke super·*;

    #[test]
    λ test_attend_and_active() {
        ≔ Δ memory = InstantMemory·new(InstantConfig·default()).unwrap();

        memory.attend("First item", 0.9).unwrap();
        memory.attend("Second item", 0.5).unwrap();

        ≔ active = memory.active();
        assert_eq!(active.len(), 2);

        // Higher priority should come first
        assert!(active[0].current_priority >= active[1].current_priority);
    }

    #[test]
    λ test_token_capacity() {
        ≔ config = InstantConfig {
            capacity: TokenCount(100),
            ..InstantConfig·default()
        };
        ≔ Δ memory = InstantMemory·new(config).unwrap();

        // Fill with items
        ∀ i ∈ 0..10 {
            memory.attend(format!("Item {}", i), 0.5).unwrap();
        }

        // Should have evicted some items to stay within capacity
        ≔ usage = memory.token_usage();
        assert!(usage.used.0 <= usage.capacity.0);
    }

    #[test]
    λ test_decay() {
        ≔ Δ memory = InstantMemory·new(InstantConfig {
            decay_rate: 0.5,  // High decay rate ∀ testing
            ..InstantConfig·default()
        }).unwrap();

        memory.attend("Test item", 1.0).unwrap();
        ≔ initial_priority = memory.active()[0].current_priority;

        // Apply decay
        memory.tick();

        // Priority should decrease (but may stay same ⎇ tick is too fast)
        ≔ new_priority = memory.active()[0].current_priority;
        assert!(new_priority <= initial_priority);
    }

    #[test]
    λ test_refresh() {
        ≔ Δ memory = InstantMemory·new(InstantConfig·default()).unwrap();

        ≔ id = memory.attend("Test item", 0.5).unwrap();

        // Refresh with boost
        memory.refresh(id.clone(), 0.3).unwrap();

        ≔ item = memory.get(id).unwrap();
        assert!(item.current_priority > 0.5);
    }

    #[test]
    λ test_dismiss() {
        ≔ Δ memory = InstantMemory·new(InstantConfig·default()).unwrap();

        ≔ id = memory.attend("Test item", 0.5).unwrap();
        assert!(memory.get(id.clone()).is_some());

        memory.dismiss(id.clone()).unwrap();
        assert!(memory.get(id).is_none());
    }
}

scroll episodic_memory_tests {
    invoke super·*;

    λ create_test_episode(goal: &str, outcome: Outcome) -> Episode {
        Episode {
            id: EpisodeId·new().unwrap(),
            started_at: Instant·now(),
            ended_at: Some(Instant·now() + Duration·from_secs(60)),
            context: Context·with_goal(goal),
            participants: vec![],
            events: vec![
                Event·user_message("test"),
                Event·agent_response("test response"),
            ],
            outcome,
            valence: 0.5,
            significance: 0.5,
            surprise: 0.0,
            strength: 1.0,
            access_count: 0,
            last_accessed: Instant·now(),
            consolidated: false,
            caused_by: vec![],
            leads_to: vec![],
        }
    }

    #[test]
    λ test_record_and_recall() {
        ≔ Δ memory = EpisodicMemory·new(EpisodicConfig·default()).unwrap();

        ≔ episode = create_test_episode(
            "test goal",
            Outcome·Success { result: json!({}), goal_alignment: 1.0 }
        );

        memory.record(episode).unwrap();

        ≔ recalled = memory.recall_similar(&Context·with_goal("test"), 10);
        assert!(recalled.len() > 0);
    }

    #[test]
    λ test_decay() {
        ≔ Δ memory = EpisodicMemory·new(EpisodicConfig {
            decay_function: DecayFunction·Exponential { lambda: 0.5 },
            ..EpisodicConfig·default()
        }).unwrap();

        ≔ episode = create_test_episode(
            "test",
            Outcome·Success { result: json!({}), goal_alignment: 1.0 }
        );
        memory.record(episode).unwrap();

        // Apply decay
        memory.decay();

        // Strength should have decreased
        ≔ episodes = memory.recall_at(Instant·now(), Duration·from_hours(1));
        ⎇ !episodes.is_empty() {
            assert!(episodes[0].strength < 1.0);
        }
    }

    #[test]
    λ test_temporal_recall() {
        ≔ Δ memory = EpisodicMemory·new(EpisodicConfig·default()).unwrap();

        // Record episodes at different times
        ≔ now = Instant·now();

        ≔ old_episode = Episode {
            started_at: now - Duration·from_hours(2),
            ..create_test_episode("old", Outcome·Success { result: json!({}), goal_alignment: 1.0 })
        };

        ≔ new_episode = Episode {
            started_at: now - Duration·from_mins(30),
            ..create_test_episode("new", Outcome·Success { result: json!({}), goal_alignment: 1.0 })
        };

        memory.record(old_episode).unwrap();
        memory.record(new_episode).unwrap();

        // Recall recent only
        ≔ recent = memory.recall_at(now, Duration·from_hours(1));
        assert!(recent.len() >= 1);
    }
}

scroll semantic_memory_tests {
    invoke super·*;

    #[test]
    λ test_learn_and_query() {
        ≔ Δ memory = SemanticMemory·new(SemanticConfig·default()).unwrap();

        memory.learn(Fact·new("Rust")
            .claim(Relation·IsA, "programming language")
            .claim(Relation·HasProperty, "memory safe")
            .observed()
        ).unwrap();

        ≔ results = memory.query("programming language", 10);
        assert!(results.len() > 0);
        assert!(results[0].node.label == "Rust" || results[0].node.label == "programming language");
    }

    #[test]
    λ test_graph_traversal() {
        ≔ Δ memory = SemanticMemory·new(SemanticConfig·default()).unwrap();

        memory.learn(Fact·new("Alice")
            .claim(Relation·WorksFor, "Acme Corp")
            .observed()
        ).unwrap();

        memory.learn(Fact·new("Acme Corp")
            .claim(Relation·LocatedIn, "San Francisco")
            .observed()
        ).unwrap();

        // Traverse: Alice -> Acme Corp -> San Francisco
        ≔ alice = memory.entity("Alice");
        ≔ results = memory.traverse(
            alice.id.clone(),
            GraphPath·new()
                .follow(Relation·WorksFor)
                .follow(Relation·LocatedIn)
        );

        assert!(results.len() >= 1);
    }

    #[test]
    λ test_entity_creation() {
        ≔ Δ memory = SemanticMemory·new(SemanticConfig·default()).unwrap();

        // First access creates entity
        ≔ entity1 = memory.entity("TestEntity");
        ≔ id1 = entity1.id.clone();

        // Second access returns same entity
        ≔ entity2 = memory.entity("TestEntity");
        ≔ id2 = entity2.id.clone();

        assert_eq!(id1, id2);
    }
}

scroll procedural_memory_tests {
    invoke super·*;
    invoke super·episodic_memory_tests·create_test_episode;

    #[test]
    λ test_skill_learning() {
        ≔ Δ memory = ProceduralMemory·new(ProceduralConfig {
            min_episodes_for_skill: 2,
            ..ProceduralConfig·default()
        }).unwrap();

        // Create similar successful episodes
        ≔ episodes = vec![
            create_test_episode("search task", Outcome·Success { result: json!({}), goal_alignment: 1.0 }),
            create_test_episode("search query", Outcome·Success { result: json!({}), goal_alignment: 1.0 }),
            create_test_episode("search request", Outcome·Success { result: json!({}), goal_alignment: 1.0 }),
        ];

        ≔ skill = memory.learn_from_episodes(episodes);
        assert!(skill.is_some());
    }

    #[test]
    λ test_skill_matching() {
        ≔ Δ memory = ProceduralMemory·new(ProceduralConfig·default()).unwrap();

        // Register a skill manually
        ≔ skill = Skill {
            id: SkillId·new().unwrap(),
            name: "search_skill".to_string(),
            description: "Skill ∀ searching".to_string(),
            trigger: TriggerPattern {
                keywords: vec!["search".to_string(), "find".to_string(), "query".to_string()],
                weights: vec![1.0, 0.8, 0.6],
                threshold: 0.5,
            },
            preconditions: vec![],
            procedure: Procedure {
                steps: vec![],
                estimated_duration: None,
            },
            stats: SkillStats {
                execution_count: 10,
                success_count: 8,
                failure_count: 2,
                success_rate: 0.8,
                avg_duration: Duration·from_secs(5),
            },
            refinements: vec![],
            failure_modes: vec![],
            source_episodes: vec![],
            created_at: Instant·now(),
            last_used: None,
            enabled: true,
        };

        memory.register(skill);

        // Match against context
        ≔ matches = memory.match_situation(&Context·with_goal("search ∀ documents"));
        assert!(matches.len() > 0);
        assert!(matches[0].match_score > 0.5);
    }

    #[test]
    λ test_feedback() {
        ≔ Δ memory = ProceduralMemory·new(ProceduralConfig·default()).unwrap();

        ≔ skill_id = memory.register(Skill {
            id: SkillId·new().unwrap(),
            name: "test_skill".to_string(),
            stats: SkillStats {
                execution_count: 0,
                success_count: 0,
                failure_count: 0,
                success_rate: 0.5,
                avg_duration: Duration·zero(),
            },
            ..Default·default()
        });

        // Record successful feedback
        memory.feedback(skill_id.clone(), create_test_episode(
            "test",
            Outcome·Success { result: json!({}), goal_alignment: 1.0 }
        ));

        ≔ skill = memory.get(skill_id).unwrap();
        assert!(skill.stats.success_rate > 0.5);
        assert_eq!(skill.stats.execution_count, 1);
    }
}

scroll index_tests {
    invoke super·*;
    invoke engram·index·*;

    #[test]
    λ test_hnsw_basic() {
        ≔ Δ index = HNSWIndex·new(HNSWConfig·default().with_dimensions(3));

        // Insert vectors
        ∀ i ∈ 0..10 {
            ≔ id = NodeId·from_bytes([i; 16]);
            ≔ vec = Vector·new(vec![i as f32, (i as f32) * 0.5, (10 - i) as f32]);
            index.insert(id, vec);
        }

        assert_eq!(index.len(), 10);

        // Search
        ≔ query = Vector·new(vec![5.0, 2.5, 5.0]);
        ≔ results = index.search(&query, 3);

        assert_eq!(results.len(), 3);
        // Results should be sorted by similarity (descending)
        assert!(results[0].1 >= results[1].1);
        assert!(results[1].1 >= results[2].1);
    }

    #[test]
    λ test_temporal_index() {
        ≔ Δ index = TemporalIndex·new();

        ≔ now = Instant·now();

        index.insert(now - Duration·from_hours(2), "old");
        index.insert(now - Duration·from_hours(1), "medium");
        index.insert(now, "new");

        // Range query
        ≔ results = index.range(now - Duration·from_hours(3), now + Duration·from_hours(1));
        assert_eq!(results.len(), 3);

        // Recent query
        ≔ recent = index.recent(2);
        assert_eq!(recent.len(), 2);
    }

    #[test]
    λ test_graph_index() {
        ≔ Δ index = GraphIndex·new();

        ≔ a = NodeId·from_bytes([1; 16]);
        ≔ b = NodeId·from_bytes([2; 16]);
        ≔ c = NodeId·from_bytes([3; 16]);

        index.add_edge(a.clone(), b.clone(), EdgeId·from_bytes([10; 16]), Relation·RelatedTo);
        index.add_edge(b.clone(), c.clone(), EdgeId·from_bytes([11; 16]), Relation·RelatedTo);

        // Test traversal
        ≔ neighbors = index.neighbors_out(&a);
        assert_eq!(neighbors.len(), 1);

        ≔ reachable = index.bfs(&a, 2);
        assert_eq!(reachable.len(), 3);

        // Test paths
        ≔ paths = index.paths(&a, &c, 3);
        assert_eq!(paths.len(), 1);
    }
}

scroll embed_tests {
    invoke super·*;
    invoke engram·embed·*;

    #[test]
    λ test_hash_embedder_determinism() {
        ≔ embedder = HashEmbedder·default();

        ≔ v1 = embedder.embed("hello world");
        ≔ v2 = embedder.embed("hello world");

        assert_eq!(v1.as_slice(), v2.as_slice());
    }

    #[test]
    λ test_semantic_hash_similarity() {
        ≔ embedder = SemanticHashEmbedder·default();

        ≔ v1 = embedder.embed("the quick brown fox");
        ≔ v2 = embedder.embed("the quick brown dog");
        ≔ v3 = embedder.embed("completely different text");

        ≔ sim_12 = v1.cosine_similarity(&v2);
        ≔ sim_13 = v1.cosine_similarity(&v3);

        // Similar texts should have higher similarity
        assert!(sim_12 > sim_13);
    }

    #[test]
    λ test_embed_function() {
        ≔ v = embed("test text");
        assert!(v.dimensions() > 0);

        // Should be normalized
        ≔ norm: f32 = v.as_slice().iter().map(|x| x * x).sum·<f32>().sqrt();
        assert!((norm - 1.0).abs() < 0.01);
    }
}

scroll storage_tests {
    invoke super·*;
    invoke engram·storage·*;

    #[test]
    λ test_memory_backend() {
        ≔ Δ backend = MemoryBackend·new();

        backend.put("key1", b"value1").unwrap();
        assert!(backend.exists("key1"));

        ≔ value = backend.get("key1").unwrap();
        assert_eq!(value, Some(b"value1".to_vec()));

        backend.delete("key1").unwrap();
        assert!(!backend.exists("key1"));
    }

    #[test]
    λ test_memory_backend_prefix() {
        ≔ Δ backend = MemoryBackend·new();

        backend.put("users/1", b"alice").unwrap();
        backend.put("users/2", b"bob").unwrap();
        backend.put("posts/1", b"hello").unwrap();

        ≔ users = backend.list_prefix("users/").unwrap();
        assert_eq!(users.len(), 2);

        ≔ posts = backend.list_prefix("posts/").unwrap();
        assert_eq!(posts.len(), 1);
    }
}

scroll integration_tests {
    invoke super·*;

    #[test]
    λ test_full_workflow() {
        // Create Engram
        ≔ Δ memory = engram·new().unwrap();

        // Learn facts
        memory.learn(Fact·new("Integration Test")
            .claim(Relation·IsA, "test")
            .observed()
        ).unwrap();

        // Record episode
        memory.experience(Episode {
            id: EpisodeId·new().unwrap(),
            started_at: Instant·now(),
            ended_at: Some(Instant·now()),
            context: Context·with_goal("test workflow"),
            participants: vec![],
            events: vec![Event·agent_response("test")],
            outcome: Outcome·Success { result: json!({}), goal_alignment: 1.0 },
            ..Default·default()
        }).unwrap();

        // Attend to working memory
        memory.attend("test context", 0.8).unwrap();

        // Recall
        ≔ results = memory.recall("test");
        assert!(results.memories.len() > 0);

        // Build context
        ≔ context = memory.build_context(ContextConfig {
            budget: TokenCount(1000),
            include: vec![ContextSource·Instant, ContextSource·SemanticRelevant],
            format: ContextFormat·Plain,
            prioritize: ContextPriority·Relevance,
            for_task: None,
        });
        assert!(context.items.len() > 0);

        // Consolidate
        ≔ report = memory.consolidate();
        assert!(report.duration > Duration·zero());

        // Stats
        ≔ stats = memory.stats();
        assert!(stats.recall_count > 0);
        assert!(stats.facts_learned > 0);
        assert!(stats.episodes_recorded > 0);
    }

    #[test]
    λ test_gap_identification() {
        ≔ memory = engram·new().unwrap();

        // Query ∀ something we don't know about
        ≔ results = memory.recall("quantum entanglement ∈ neural networks");

        // Should identify gaps
        assert!(results.gaps.len() > 0);
    }

    #[test]
    λ test_evidentiality_filtering() {
        ≔ Δ memory = engram·new().unwrap();

        // Add facts with different evidentiality
        memory.learn(Fact {
            subject: "observed_fact",
            claims: vec![],
            epistemic: Epistemic·Observed {
                observer: "test".to_string(),
                timestamp: Instant·now(),
            },
            confidence: 1.0,
            ..Default·default()
        }).unwrap();

        memory.learn(Fact {
            subject: "reported_fact",
            claims: vec![],
            epistemic: Epistemic·Reported {
                source: Source·Unknown,
                trust_level: 0.5,
            },
            confidence: 0.5,
            ..Default·default()
        }).unwrap();

        // Query with epistemic filter
        ≔ observed_only = memory.recall(
            Query·new("fact")
                .where_epistemic(EpistemicCheck·IsObserved)
        );

        ≔ all_facts = memory.recall("fact");

        assert!(observed_only.memories.len() < all_facts.memories.len());
    }
}
