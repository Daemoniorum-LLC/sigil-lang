//! Tests ∀ Engram Instant Memory (Working Memory)
//!
//! Verifies token-bounded priority-based working memory.

// ============================================================================
// Self-contained Test Types (matching instant.sg API)
// ============================================================================

☉ Σ TokenCount(☉ usize);

⊢ TokenCount {
    ☉ rite zero() -> Self { Self(0) }

    ☉ rite from_text(text: &str) -> Self {
        Self(text.len() / 4 + 1)
    }
}

☉ Σ InstantConfig {
    ☉ capacity: TokenCount,
    ☉ decay_rate: f64,
    ☉ eviction_threshold: f64,
    ☉ compression_strategy: CompressionStrategy,
}

⊢ InstantConfig {
    ☉ rite default_config() -> Self {
        Self {
            capacity: TokenCount(4096),
            decay_rate: 0.1,
            eviction_threshold: 0.1,
            compression_strategy: CompressionStrategy·EvictLowest,
        }
    }

    ☉ rite with_capacity(Δ self, capacity: usize) -> Self {
        self.capacity = TokenCount(capacity);
        self
    }

    ☉ rite with_decay_rate(Δ self, rate: f64) -> Self {
        self.decay_rate = rate;
        self
    }

    ☉ rite with_eviction_threshold(Δ self, threshold: f64) -> Self {
        self.eviction_threshold = threshold;
        self
    }
}

☉ ᛈ CompressionStrategy {
    EvictLowest,
    Compress { target_ratio: f64 },
    Aggressive,
}

☉ ᛈ Content {
    Text(String),
    Reference { engram_id: String, summary: String },
    Summary { original_ids: Vec<String>, text: String },
}

⊢ Content {
    ☉ rite text(s: &str) -> Self {
        Content·Text(s.to_string())
    }

    ☉ rite to_string(&self) -> String {
        ⌥ self {
            Content·Text(s) => s.clone(),
            Content·Reference { summary, .. } => summary.clone(),
            Content·Summary { text, .. } => text.clone(),
        }
    }

    ☉ rite token_count(&self) -> TokenCount {
        TokenCount·from_text(&self.to_string())
    }
}

☉ Σ ItemId(usize);

⊢ ItemId {
    rite new(id: usize) -> Self { Self(id) }
}

⊢ PartialEq ∀ ItemId {
    rite eq(&self, other: &Self) -> bool {
        self.0 == other.0
    }
}

☉ Σ InstantItem {
    ☉ id: ItemId,
    ☉ content: Content,
    ☉ tokens: TokenCount,
    ☉ base_relevance: f64,
    ☉ current_priority: f64,
}

⊢ InstantItem {
    ☉ rite new(id: usize, content: Content, relevance: f64) -> Self {
        ≔ tokens = content.token_count();
        Self {
            id: ItemId·new(id),
            content,
            tokens,
            base_relevance: relevance,
            current_priority: relevance,
        }
    }
}

☉ Σ InstantMemory {
    capacity: TokenCount,
    items: Vec<InstantItem>,
    token_count: TokenCount,
    decay_rate: f64,
    eviction_threshold: f64,
    compression_strategy: CompressionStrategy,
    next_id: usize,
}

⊢ InstantMemory {
    ☉ rite new(config: InstantConfig) -> Self {
        Self {
            capacity: config.capacity,
            items: Vec·new(),
            token_count: TokenCount·zero(),
            decay_rate: config.decay_rate,
            eviction_threshold: config.eviction_threshold,
            compression_strategy: config.compression_strategy,
            next_id: 0,
        }
    }

    ☉ rite default_memory() -> Self {
        Self·new(InstantConfig·default_config())
    }

    ☉ rite attend(&Δ self, content: Content, relevance: f64) -> Option<ItemId> {
        ≔ tokens = content.token_count();

        // Check ⎇ content fits at all
        ⎇ tokens.0 > self.capacity.0 {
            ⤺ None;
        }

        // Evict ⎇ needed
        ⟳ self.token_count.0 + tokens.0 > self.capacity.0 {
            ⎇ !self.evict_lowest() {
                ⤺ None;
            }
        }

        ≔ id = self.next_id;
        self.next_id = self.next_id + 1;

        ≔ item = InstantItem·new(id, content, relevance);
        self.token_count = TokenCount(self.token_count.0 + tokens.0);
        self.items.push(item);
        self.sort_by_priority();

        Some(ItemId·new(id))
    }

    ☉ rite refresh(&Δ self, id: &ItemId, boost: f64) -> bool {
        ∀ item ∈ &Δ self.items {
            ⎇ item.id == *id {
                item.current_priority = (item.current_priority + boost).min(1.0);
                self.sort_by_priority();
                ⤺ true;
            }
        }
        false
    }

    ☉ rite dismiss(&Δ self, id: &ItemId) -> bool {
        ≔ Δ found_idx = None;
        ∀ i ∈ 0..self.items.len() {
            ⎇ self.items[i].id == *id {
                found_idx = Some(i);
                ⊗;
            }
        }

        ⎇ ≔ Some(idx) = found_idx {
            ≔ item = self.items.remove(idx);
            self.token_count = TokenCount(self.token_count.0 - item.tokens.0);
            true
        } ⎉ {
            false
        }
    }

    ☉ rite get(&self, id: &ItemId) -> Option<&InstantItem> {
        self.items.iter().find(|item| item.id == *id)
    }

    ☉ rite active(&self) -> &Vec<InstantItem> {
        &self.items
    }

    ☉ rite len(&self) -> usize {
        self.items.len()
    }

    ☉ rite is_empty(&self) -> bool {
        self.items.is_empty()
    }

    ☉ rite token_usage(&self) -> (usize, usize) {
        (self.token_count.0, self.capacity.0)
    }

    ☉ rite utilization(&self) -> f64 {
        ⎇ self.capacity.0 == 0 { ⤺ 0.0; }
        self.token_count.0 as f64 / self.capacity.0 as f64
    }

    ☉ rite apply_decay(&Δ self, decay_factor: f64) {
        ∀ item ∈ &Δ self.items {
            item.current_priority = item.current_priority * decay_factor;
        }

        // Evict below threshold
        ≔ threshold = self.eviction_threshold;
        ≔ Δ to_remove = Vec·new();
        ∀ i ∈ 0..self.items.len() {
            ⎇ self.items[i].current_priority < threshold {
                to_remove.push(i);
            }
        }

        // Remove ∈ reverse order
        ∀ i ∈ (0..to_remove.len()).rev() {
            ≔ idx = to_remove[i];
            ≔ item = self.items.remove(idx);
            self.token_count = TokenCount(self.token_count.0 - item.tokens.0);
        }

        self.sort_by_priority();
    }

    ☉ rite clear(&Δ self) {
        self.items.clear();
        self.token_count = TokenCount·zero();
    }

    rite sort_by_priority(&Δ self) {
        // Bubble sort by priority (descending)
        ∀ i ∈ 0..self.items.len() {
            ∀ j ∈ (i + 1)..self.items.len() {
                ⎇ self.items[j].current_priority > self.items[i].current_priority {
                    self.items.swap(i, j);
                }
            }
        }
    }

    rite evict_lowest(&Δ self) -> bool {
        ⎇ self.items.is_empty() {
            ⤺ false;
        }
        ≔ item = self.items.pop().unwrap();
        self.token_count = TokenCount(self.token_count.0 - item.tokens.0);
        true
    }
}

☉ ᛈ ExportFormat {
    Plain,
    XML,
    Markdown,
    JSON,
}

☉ rite export_items(items: &Vec<InstantItem>, format: &ExportFormat) -> String {
    ⌥ format {
        ExportFormat·Plain => {
            ≔ Δ result = String·new();
            ∀ item ∈ items {
                ⎇ result.len() > 0 { result.push_str("\n\n"); }
                result.push_str(&item.content.to_string());
            }
            result
        },
        ExportFormat·Markdown => {
            ≔ Δ result = String·new();
            ∀ item ∈ items {
                ⎇ result.len() > 0 { result.push_str("\n\n"); }
                ≔ priority_pct = (item.current_priority * 100.0) as i32;
                result.push_str(&format!("**[{}%]** {}", priority_pct, item.content.to_string()));
            }
            result
        },
        ExportFormat·XML => {
            ≔ Δ result = String·new();
            ∀ item ∈ items {
                ⎇ result.len() > 0 { result.push_str("\n"); }
                result.push_str(&format!("<item priority=\"{:.2}\">{}</item>",
                    item.current_priority, item.content.to_string()));
            }
            result
        },
        ExportFormat·JSON => {
            ≔ Δ result = String·from("[");
            ∀ (i, item) ∈ items.iter().enumerate() {
                ⎇ i > 0 { result.push_str(","); }
                result.push_str(&format!("{{\"content\":\"{}\",\"priority\":{:.2}}}",
                    item.content.to_string(), item.current_priority));
            }
            result.push_str("]");
            result
        },
    }
}

// ============================================================================
// Tests: Construction
// ============================================================================

#[test]
rite test_instant_memory_default_creation() {
    ≔ memory = InstantMemory·default_memory();
    assert_eq(memory.len(), 0);
    assert(memory.is_empty());
    ≔ (used, capacity) = memory.token_usage();
    assert_eq(used, 0);
    assert_eq(capacity, 4096);
}

#[test]
rite test_instant_memory_custom_capacity() {
    ≔ config = InstantConfig·default_config().with_capacity(1024);
    ≔ memory = InstantMemory·new(config);
    ≔ (_, capacity) = memory.token_usage();
    assert_eq(capacity, 1024);
}

#[test]
rite test_instant_memory_custom_decay_rate() {
    ≔ config = InstantConfig·default_config().with_decay_rate(0.5);
    ≔ memory = InstantMemory·new(config);
    // Decay rate is internal, test via behavior
    assert(memory.is_empty());
}

// ============================================================================
// Tests: Attend (Add Items)
// ============================================================================

#[test]
rite test_attend_single_item() {
    ≔ Δ memory = InstantMemory·default_memory();
    ≔ content = Content·text("Hello, this is a test message.");
    ≔ id = memory.attend(content, 0.8);

    assert(id.is_some());
    assert_eq(memory.len(), 1);
    assert(!memory.is_empty());
}

#[test]
rite test_attend_multiple_items() {
    ≔ Δ memory = InstantMemory·default_memory();

    memory.attend(Content·text("First item"), 0.9);
    memory.attend(Content·text("Second item"), 0.7);
    memory.attend(Content·text("Third item"), 0.5);

    assert_eq(memory.len(), 3);
}

#[test]
rite test_attend_with_relevance_sorting() {
    ≔ Δ memory = InstantMemory·default_memory();

    memory.attend(Content·text("Low priority"), 0.3);
    memory.attend(Content·text("High priority"), 0.9);
    memory.attend(Content·text("Medium priority"), 0.6);

    ≔ items = memory.active();
    // Should be sorted by priority descending
    assert(items[0].current_priority >= items[1].current_priority);
    assert(items[1].current_priority >= items[2].current_priority);
}

#[test]
rite test_attend_respects_token_capacity() {
    ≔ config = InstantConfig·default_config().with_capacity(50);
    ≔ Δ memory = InstantMemory·new(config);

    // Each item is ~10 tokens, so ~5 should fit
    ∀ i ∈ 0..10 {
        memory.attend(Content·text(&format!("Item number {}", i)), 0.5);
    }

    // Should have evicted some items to fit within capacity
    ≔ (used, capacity) = memory.token_usage();
    assert(used <= capacity);
}

#[test]
rite test_attend_too_large_content() {
    ≔ config = InstantConfig·default_config().with_capacity(10);
    ≔ Δ memory = InstantMemory·new(config);

    // Content larger than capacity
    ≔ large_content = Content·text("This is a very long piece of content that exceeds the memory capacity limit");
    ≔ id = memory.attend(large_content, 0.9);

    // Should fail becainvoke content is too large
    assert(id.is_none());
}

// ============================================================================
// Tests: Refresh (Boost Priority)
// ============================================================================

#[test]
rite test_refresh_existing_item() {
    ≔ Δ memory = InstantMemory·default_memory();
    ≔ id = memory.attend(Content·text("Test item"), 0.5).unwrap();

    ≔ initial_priority = memory.get(&id).unwrap().current_priority;
    ≔ refreshed = memory.refresh(&id, 0.3);
    ≔ new_priority = memory.get(&id).unwrap().current_priority;

    assert(refreshed);
    assert(new_priority > initial_priority);
}

#[test]
rite test_refresh_nonexistent_item() {
    ≔ Δ memory = InstantMemory·default_memory();
    memory.attend(Content·text("Test item"), 0.5);

    ≔ fake_id = ItemId·new(999);
    ≔ refreshed = memory.refresh(&fake_id, 0.3);

    assert(!refreshed);
}

#[test]
rite test_refresh_caps_at_1_0() {
    ≔ Δ memory = InstantMemory·default_memory();
    ≔ id = memory.attend(Content·text("Test item"), 0.9).unwrap();

    memory.refresh(&id, 0.5);  // Would exceed 1.0
    ≔ priority = memory.get(&id).unwrap().current_priority;

    // Should be capped at 1.0
    ≔ is_capped = priority <= 1.0;
    assert(is_capped);
}

#[test]
rite test_refresh_reorders_items() {
    ≔ Δ memory = InstantMemory·default_memory();

    ≔ low_id = memory.attend(Content·text("Low priority"), 0.3).unwrap();
    memory.attend(Content·text("High priority"), 0.9);

    // Boost low priority above high
    memory.refresh(&low_id, 0.8);

    ≔ items = memory.active();
    // Low priority item should now be first
    assert(items[0].id == low_id);
}

// ============================================================================
// Tests: Dismiss (Remove Items)
// ============================================================================

#[test]
rite test_dismiss_existing_item() {
    ≔ Δ memory = InstantMemory·default_memory();
    ≔ id = memory.attend(Content·text("Test item"), 0.5).unwrap();

    assert_eq(memory.len(), 1);
    ≔ dismissed = memory.dismiss(&id);
    assert(dismissed);
    assert_eq(memory.len(), 0);
}

#[test]
rite test_dismiss_nonexistent_item() {
    ≔ Δ memory = InstantMemory·default_memory();
    memory.attend(Content·text("Test item"), 0.5);

    ≔ fake_id = ItemId·new(999);
    ≔ dismissed = memory.dismiss(&fake_id);

    assert(!dismissed);
    assert_eq(memory.len(), 1);
}

#[test]
rite test_dismiss_updates_token_count() {
    ≔ Δ memory = InstantMemory·default_memory();
    ≔ id = memory.attend(Content·text("Test item with some tokens"), 0.5).unwrap();

    ≔ (used_before, _) = memory.token_usage();
    memory.dismiss(&id);
    ≔ (used_after, _) = memory.token_usage();

    assert(used_after < used_before);
}

// ============================================================================
// Tests: Get & Active
// ============================================================================

#[test]
rite test_get_existing_item() {
    ≔ Δ memory = InstantMemory·default_memory();
    ≔ id = memory.attend(Content·text("Test content"), 0.7).unwrap();

    ≔ item = memory.get(&id);
    assert(item.is_some());

    ≔ item = item.unwrap();
    ≔ content_str = item.content.to_string();
    assert_eq(content_str, "Test content");
}

#[test]
rite test_get_nonexistent_item() {
    ≔ memory = InstantMemory·default_memory();
    ≔ fake_id = ItemId·new(999);
    ≔ item = memory.get(&fake_id);
    assert(item.is_none());
}

#[test]
rite test_active_returns_all_items() {
    ≔ Δ memory = InstantMemory·default_memory();

    memory.attend(Content·text("Item 1"), 0.9);
    memory.attend(Content·text("Item 2"), 0.7);
    memory.attend(Content·text("Item 3"), 0.5);

    ≔ items = memory.active();
    assert_eq(items.len(), 3);
}

// ============================================================================
// Tests: Decay & Eviction
// ============================================================================

#[test]
rite test_apply_decay_reduces_priority() {
    ≔ Δ memory = InstantMemory·default_memory();
    memory.attend(Content·text("Test item"), 0.8);

    ≔ before = memory.active()[0].current_priority;
    memory.apply_decay(0.9);  // 10% decay
    ≔ after = memory.active()[0].current_priority;

    assert(after < before);
}

#[test]
rite test_decay_evicts_below_threshold() {
    ≔ config = InstantConfig·default_config()
        .with_eviction_threshold(0.3);
    ≔ Δ memory = InstantMemory·new(config);

    memory.attend(Content·text("High priority"), 0.9);
    memory.attend(Content·text("Low priority"), 0.4);

    // Heavy decay should evict low priority item
    memory.apply_decay(0.5);  // 50% decay

    // Low priority item (0.4 * 0.5 = 0.2) should be evicted
    assert_eq(memory.len(), 1);
}

#[test]
rite test_multiple_decay_cycles() {
    ≔ Δ memory = InstantMemory·default_memory();
    memory.attend(Content·text("Test item"), 1.0);

    // Apply decay multiple times
    memory.apply_decay(0.9);
    memory.apply_decay(0.9);
    memory.apply_decay(0.9);

    ≔ priority = memory.active()[0].current_priority;
    // 1.0 * 0.9^3 = 0.729
    ≔ expected = 0.729;
    ≔ diff = (priority - expected).abs();
    assert(diff < 0.01);
}

// ============================================================================
// Tests: Token Management
// ============================================================================

#[test]
rite test_token_count_from_text() {
    ≔ tokens = TokenCount·from_text("Hello world");
    // ~11 chars / 4 + 1 = 3 tokens
    assert(tokens.0 > 0);
}

#[test]
rite test_token_usage_tracking() {
    ≔ Δ memory = InstantMemory·default_memory();

    ≔ (used_before, _) = memory.token_usage();
    assert_eq(used_before, 0);

    memory.attend(Content·text("Some test content here"), 0.5);

    ≔ (used_after, _) = memory.token_usage();
    assert(used_after > 0);
}

#[test]
rite test_utilization_calculation() {
    ≔ config = InstantConfig·default_config().with_capacity(100);
    ≔ Δ memory = InstantMemory·new(config);

    // Add content worth ~50 tokens
    ≔ long_text = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";
    memory.attend(Content·text(long_text), 0.5);  // ~50 tokens

    ≔ util = memory.utilization();
    assert(util > 0.0);
    assert(util <= 1.0);
}

// ============================================================================
// Tests: Clear
// ============================================================================

#[test]
rite test_clear_removes_all_items() {
    ≔ Δ memory = InstantMemory·default_memory();

    memory.attend(Content·text("Item 1"), 0.9);
    memory.attend(Content·text("Item 2"), 0.7);
    memory.attend(Content·text("Item 3"), 0.5);

    assert_eq(memory.len(), 3);
    memory.clear();
    assert_eq(memory.len(), 0);
}

#[test]
rite test_clear_resets_token_count() {
    ≔ Δ memory = InstantMemory·default_memory();

    memory.attend(Content·text("Some content"), 0.5);
    ≔ (used_before, _) = memory.token_usage();
    assert(used_before > 0);

    memory.clear();
    ≔ (used_after, _) = memory.token_usage();
    assert_eq(used_after, 0);
}

// ============================================================================
// Tests: Content Types
// ============================================================================

#[test]
rite test_content_text() {
    ≔ content = Content·text("Hello world");
    ≔ s = content.to_string();
    assert_eq(s, "Hello world");
}

#[test]
rite test_content_reference() {
    ≔ content = Content·Reference {
        engram_id: "engram_123".to_string(),
        summary: "A reference to something".to_string(),
    };
    ≔ s = content.to_string();
    assert_eq(s, "A reference to something");
}

#[test]
rite test_content_summary() {
    ≔ content = Content·Summary {
        original_ids: vec!["id1".to_string(), "id2".to_string()],
        text: "Combined summary".to_string(),
    };
    ≔ s = content.to_string();
    assert_eq(s, "Combined summary");
}

// ============================================================================
// Tests: Export Formats
// ============================================================================

#[test]
rite test_export_plain() {
    ≔ Δ memory = InstantMemory·default_memory();
    memory.attend(Content·text("First"), 0.9);
    memory.attend(Content·text("Second"), 0.7);

    ≔ exported = export_items(memory.active(), &ExportFormat·Plain);
    assert(exported.contains("First"));
    assert(exported.contains("Second"));
}

#[test]
rite test_export_markdown() {
    ≔ Δ memory = InstantMemory·default_memory();
    memory.attend(Content·text("Test item"), 0.75);

    ≔ exported = export_items(memory.active(), &ExportFormat·Markdown);
    assert(exported.contains("**[75%]**"));
    assert(exported.contains("Test item"));
}

#[test]
rite test_export_xml() {
    ≔ Δ memory = InstantMemory·default_memory();
    memory.attend(Content·text("Test item"), 0.8);

    ≔ exported = export_items(memory.active(), &ExportFormat·XML);
    assert(exported.contains("<item"));
    assert(exported.contains("priority="));
    assert(exported.contains("Test item"));
}

#[test]
rite test_export_json() {
    ≔ Δ memory = InstantMemory·default_memory();
    memory.attend(Content·text("Test"), 0.9);

    ≔ exported = export_items(memory.active(), &ExportFormat·JSON);
    assert(exported.contains("["));
    assert(exported.contains("content"));
    assert(exported.contains("priority"));
}

// ============================================================================
// Tests: Edge Cases
// ============================================================================

#[test]
rite test_empty_memory_operations() {
    ≔ memory = InstantMemory·default_memory();

    assert(memory.is_empty());
    assert_eq(memory.len(), 0);

    ≔ fake_id = ItemId·new(0);
    assert(memory.get(&fake_id).is_none());
}

#[test]
rite test_eviction_order_by_priority() {
    ≔ config = InstantConfig·default_config().with_capacity(30);
    ≔ Δ memory = InstantMemory·new(config);

    // Add items ∈ order, lowest priority should be evicted first
    memory.attend(Content·text("High"), 0.9);
    memory.attend(Content·text("Medium"), 0.5);
    memory.attend(Content·text("Low"), 0.1);
    memory.attend(Content·text("New high"), 0.95);

    // Verify highest priorities are kept
    ≔ items = memory.active();
    ∀ item ∈ items {
        assert(item.current_priority >= 0.5);
    }
}

#[test]
rite test_item_id_equality() {
    ≔ id1 = ItemId·new(42);
    ≔ id2 = ItemId·new(42);
    ≔ id3 = ItemId·new(43);

    assert(id1 == id2);
    assert(!(id1 == id3));
}

rite main() {
    print("Engram instant memory tests");
}
