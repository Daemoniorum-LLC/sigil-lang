//! Tests for Engram Procedural Memory (Skills)
//!
//! Verifies skill learning, pattern matching, and feedback tracking.

// ============================================================================
// Self-contained Test Types (matching procedural.sg API)
// ============================================================================

pub struct SkillId(usize);

impl SkillId {
    fn new(id: usize) -> Self { Self(id) }
}

impl PartialEq for SkillId {
    fn eq(&self, other: &Self) -> bool {
        self.0 == other.0
    }
}

impl Clone for SkillId {
    fn clone(&self) -> Self { SkillId(self.0) }
}

impl Hash for SkillId {
    fn hash(&self) -> usize { self.0 }
}

pub struct TriggerPattern {
    pub keywords: Vec<String>,
    pub weights: Vec<f64>,
    pub threshold: f64,
}

impl TriggerPattern {
    pub fn new(keywords: Vec<&str>, threshold: f64) -> Self {
        let len = keywords.len();
        Self {
            keywords: keywords.iter().map(|s| s.to_string()).collect(),
            weights: vec![1.0 / len as f64; len],
            threshold,
        }
    }

    pub fn with_weights(keywords: Vec<&str>, weights: Vec<f64>, threshold: f64) -> Self {
        Self {
            keywords: keywords.iter().map(|s| s.to_string()).collect(),
            weights,
            threshold,
        }
    }
}

impl Clone for TriggerPattern {
    fn clone(&self) -> Self {
        TriggerPattern {
            keywords: self.keywords.clone(),
            weights: self.weights.clone(),
            threshold: self.threshold,
        }
    }
}

pub enum Action {
    CallTool { tool: String, args: String },
    AskUser { question: String },
    Respond { template: String },
    Custom { name: String },
}

impl Clone for Action {
    fn clone(&self) -> Self {
        match self {
            Action::CallTool { tool, args } => Action::CallTool {
                tool: tool.clone(), args: args.clone()
            },
            Action::AskUser { question } => Action::AskUser { question: question.clone() },
            Action::Respond { template } => Action::Respond { template: template.clone() },
            Action::Custom { name } => Action::Custom { name: name.clone() },
        }
    }
}

pub struct ProcedureStep {
    pub description: String,
    pub action: Action,
}

impl ProcedureStep {
    pub fn tool_call(tool: &str, args: &str) -> Self {
        Self {
            description: format!("Call {}", tool),
            action: Action::CallTool {
                tool: tool.to_string(),
                args: args.to_string(),
            },
        }
    }

    pub fn respond(template: &str) -> Self {
        Self {
            description: "Respond to user".to_string(),
            action: Action::Respond { template: template.to_string() },
        }
    }

    pub fn ask(question: &str) -> Self {
        Self {
            description: "Ask user".to_string(),
            action: Action::AskUser { question: question.to_string() },
        }
    }
}

impl Clone for ProcedureStep {
    fn clone(&self) -> Self {
        ProcedureStep {
            description: self.description.clone(),
            action: self.action.clone(),
        }
    }
}

pub struct Procedure {
    pub steps: Vec<ProcedureStep>,
    pub estimated_duration_secs: Option<u64>,
}

impl Procedure {
    pub fn new() -> Self {
        Self {
            steps: Vec::new(),
            estimated_duration_secs: None,
        }
    }

    pub fn step(mut self, step: ProcedureStep) -> Self {
        self.steps.push(step);
        self
    }

    pub fn with_duration(mut self, secs: u64) -> Self {
        self.estimated_duration_secs = Some(secs);
        self
    }
}

impl Clone for Procedure {
    fn clone(&self) -> Self {
        Procedure {
            steps: self.steps.clone(),
            estimated_duration_secs: self.estimated_duration_secs,
        }
    }
}

pub struct SkillStats {
    pub execution_count: u32,
    pub success_count: u32,
    pub failure_count: u32,
    pub success_rate: f64,
    pub avg_duration_secs: f64,
}

impl SkillStats {
    pub fn new() -> Self {
        Self {
            execution_count: 0,
            success_count: 0,
            failure_count: 0,
            success_rate: 0.0,
            avg_duration_secs: 0.0,
        }
    }

    pub fn from_counts(successes: u32, failures: u32) -> Self {
        let total = successes + failures;
        let rate = if total == 0 { 0.0 } else { successes as f64 / total as f64 };
        Self {
            execution_count: total,
            success_count: successes,
            failure_count: failures,
            success_rate: rate,
            avg_duration_secs: 0.0,
        }
    }
}

impl Clone for SkillStats {
    fn clone(&self) -> Self {
        SkillStats {
            execution_count: self.execution_count,
            success_count: self.success_count,
            failure_count: self.failure_count,
            success_rate: self.success_rate,
            avg_duration_secs: self.avg_duration_secs,
        }
    }
}

pub struct FailureMode {
    pub trigger_context: String,
    pub failure_type: String,
    pub recovery: Option<String>,
    pub occurrences: u32,
}

impl FailureMode {
    pub fn new(context: &str, failure_type: &str) -> Self {
        Self {
            trigger_context: context.to_string(),
            failure_type: failure_type.to_string(),
            recovery: None,
            occurrences: 1,
        }
    }
}

pub struct Skill {
    pub id: SkillId,
    pub name: String,
    pub description: String,
    pub trigger: TriggerPattern,
    pub procedure: Procedure,
    pub stats: SkillStats,
    pub failure_modes: Vec<FailureMode>,
    pub enabled: bool,
}

impl Skill {
    pub fn new(id: usize, name: &str) -> Self {
        Self {
            id: SkillId::new(id),
            name: name.to_string(),
            description: String::new(),
            trigger: TriggerPattern::new(vec![], 0.5),
            procedure: Procedure::new(),
            stats: SkillStats::new(),
            failure_modes: Vec::new(),
            enabled: true,
        }
    }

    pub fn with_description(mut self, desc: &str) -> Self {
        self.description = desc.to_string();
        self
    }

    pub fn with_trigger(mut self, trigger: TriggerPattern) -> Self {
        self.trigger = trigger;
        self
    }

    pub fn with_procedure(mut self, procedure: Procedure) -> Self {
        self.procedure = procedure;
        self
    }

    pub fn with_stats(mut self, stats: SkillStats) -> Self {
        self.stats = stats;
        self
    }
}

impl Clone for Skill {
    fn clone(&self) -> Self {
        Skill {
            id: self.id.clone(),
            name: self.name.clone(),
            description: self.description.clone(),
            trigger: self.trigger.clone(),
            procedure: self.procedure.clone(),
            stats: self.stats.clone(),
            failure_modes: Vec::new(),
            enabled: self.enabled,
        }
    }
}

pub struct SkillMatch {
    pub skill: Skill,
    pub match_score: f64,
    pub preconditions_met: bool,
}

pub struct Context {
    pub text: String,
}

impl Context {
    pub fn new(text: &str) -> Self {
        Self { text: text.to_string() }
    }

    pub fn to_string(&self) -> String {
        self.text.clone()
    }
}

pub struct ProceduralConfig {
    pub min_episodes_for_skill: usize,
    pub pattern_match_threshold: f64,
    pub max_skills: Option<usize>,
}

impl ProceduralConfig {
    pub fn default_config() -> Self {
        Self {
            min_episodes_for_skill: 3,
            pattern_match_threshold: 0.5,
            max_skills: Some(1000),
        }
    }

    pub fn with_match_threshold(mut self, threshold: f64) -> Self {
        self.pattern_match_threshold = threshold;
        self
    }
}

pub struct ProceduralMemory {
    skills: Vec<Skill>,
    config: ProceduralConfig,
    next_id: usize,
}

impl ProceduralMemory {
    pub fn new(config: ProceduralConfig) -> Self {
        Self {
            skills: Vec::new(),
            config,
            next_id: 0,
        }
    }

    pub fn default_memory() -> Self {
        Self::new(ProceduralConfig::default_config())
    }

    pub fn skill_count(&self) -> usize {
        self.skills.len()
    }

    pub fn register(&mut self, skill: Skill) -> SkillId {
        let id = skill.id.clone();
        self.skills.push(skill);
        id
    }

    pub fn get(&self, id: &SkillId) -> Option<&Skill> {
        self.skills.iter().find(|s| s.id == *id)
    }

    pub fn get_mut(&mut self, id: &SkillId) -> Option<&mut Skill> {
        self.skills.iter_mut().find(|s| s.id == *id)
    }

    pub fn get_by_name(&self, name: &str) -> Option<&Skill> {
        self.skills.iter().find(|s| s.name == name)
    }

    pub fn match_situation(&self, context: &Context) -> Vec<SkillMatch> {
        let context_text = context.to_string().to_lowercase();

        let mut matches: Vec<SkillMatch> = Vec::new();

        for skill in &self.skills {
            if !skill.enabled {
                continue;
            }

            let score = self.match_pattern(&skill.trigger, &context_text);
            if score >= self.config.pattern_match_threshold {
                matches.push(SkillMatch {
                    skill: skill.clone(),
                    match_score: score,
                    preconditions_met: true,
                });
            }
        }

        // Sort by score * success_rate (bubble sort)
        for i in 0..matches.len() {
            for j in (i + 1)..matches.len() {
                let score_i = matches[i].match_score * matches[i].skill.stats.success_rate.max(0.1);
                let score_j = matches[j].match_score * matches[j].skill.stats.success_rate.max(0.1);
                if score_j > score_i {
                    let temp = SkillMatch {
                        skill: matches[i].skill.clone(),
                        match_score: matches[i].match_score,
                        preconditions_met: matches[i].preconditions_met,
                    };
                    matches[i] = SkillMatch {
                        skill: matches[j].skill.clone(),
                        match_score: matches[j].match_score,
                        preconditions_met: matches[j].preconditions_met,
                    };
                    matches[j] = temp;
                }
            }
        }

        matches
    }

    pub fn record_success(&mut self, id: &SkillId, duration_secs: f64) {
        if let Some(skill) = self.get_mut(id) {
            skill.stats.execution_count = skill.stats.execution_count + 1;
            skill.stats.success_count = skill.stats.success_count + 1;
            // EMA for success rate
            skill.stats.success_rate = skill.stats.success_rate * 0.9 + 0.1;
            // EMA for duration
            if skill.stats.avg_duration_secs == 0.0 {
                skill.stats.avg_duration_secs = duration_secs;
            } else {
                skill.stats.avg_duration_secs = skill.stats.avg_duration_secs * 0.9 + duration_secs * 0.1;
            }
        }
    }

    pub fn record_failure(&mut self, id: &SkillId, context: &str, failure_type: &str) {
        if let Some(skill) = self.get_mut(id) {
            skill.stats.execution_count = skill.stats.execution_count + 1;
            skill.stats.failure_count = skill.stats.failure_count + 1;
            // EMA decay on failure
            skill.stats.success_rate = skill.stats.success_rate * 0.9;

            // Record failure mode
            skill.failure_modes.push(FailureMode::new(context, failure_type));
        }
    }

    pub fn disable(&mut self, id: &SkillId) -> bool {
        if let Some(skill) = self.get_mut(id) {
            skill.enabled = false;
            true
        } else {
            false
        }
    }

    pub fn enable(&mut self, id: &SkillId) -> bool {
        if let Some(skill) = self.get_mut(id) {
            skill.enabled = true;
            true
        } else {
            false
        }
    }

    fn match_pattern(&self, pattern: &TriggerPattern, context: &str) -> f64 {
        let mut total_weight = 0.0;
        let mut matched_weight = 0.0;

        for i in 0..pattern.keywords.len() {
            let keyword = &pattern.keywords[i];
            let weight = if i < pattern.weights.len() { pattern.weights[i] } else { 1.0 };

            total_weight = total_weight + weight;
            if context.contains(keyword) {
                matched_weight = matched_weight + weight;
            }
        }

        if total_weight == 0.0 { 0.0 } else { matched_weight / total_weight }
    }
}

// ============================================================================
// Tests: Skill Construction
// ============================================================================

#[test]
fn test_skill_creation() {
    let skill = Skill::new(1, "test_skill");
    assert_eq(skill.name, "test_skill");
    assert(skill.enabled);
}

#[test]
fn test_skill_with_description() {
    let skill = Skill::new(1, "test")
        .with_description("A test skill");
    assert_eq(skill.description, "A test skill");
}

#[test]
fn test_skill_with_trigger() {
    let trigger = TriggerPattern::new(vec!["search", "find", "lookup"], 0.5);
    let skill = Skill::new(1, "search_skill").with_trigger(trigger);

    assert_eq(skill.trigger.keywords.len(), 3);
}

#[test]
fn test_skill_with_procedure() {
    let procedure = Procedure::new()
        .step(ProcedureStep::tool_call("search", "query"))
        .step(ProcedureStep::respond("Here are the results"));

    let skill = Skill::new(1, "search_skill").with_procedure(procedure);
    assert_eq(skill.procedure.steps.len(), 2);
}

#[test]
fn test_skill_with_stats() {
    let stats = SkillStats::from_counts(8, 2);
    let skill = Skill::new(1, "test").with_stats(stats);

    assert_eq(skill.stats.execution_count, 10);
    let diff = (skill.stats.success_rate - 0.8).abs();
    assert(diff < 0.001);
}

// ============================================================================
// Tests: TriggerPattern
// ============================================================================

#[test]
fn test_trigger_pattern_simple() {
    let pattern = TriggerPattern::new(vec!["hello", "world"], 0.5);
    assert_eq(pattern.keywords.len(), 2);
    assert_eq(pattern.threshold, 0.5);
}

#[test]
fn test_trigger_pattern_with_weights() {
    let pattern = TriggerPattern::with_weights(
        vec!["important", "less_important"],
        vec![0.8, 0.2],
        0.5
    );

    let diff = (pattern.weights[0] - 0.8).abs();
    assert(diff < 0.001);
}

// ============================================================================
// Tests: Procedure
// ============================================================================

#[test]
fn test_procedure_empty() {
    let proc = Procedure::new();
    assert_eq(proc.steps.len(), 0);
}

#[test]
fn test_procedure_with_steps() {
    let proc = Procedure::new()
        .step(ProcedureStep::tool_call("read_file", "path.txt"))
        .step(ProcedureStep::respond("File contents: ..."));

    assert_eq(proc.steps.len(), 2);
}

#[test]
fn test_procedure_with_duration() {
    let proc = Procedure::new().with_duration(30);
    assert_eq(proc.estimated_duration_secs.unwrap(), 30);
}

#[test]
fn test_procedure_step_types() {
    let tool_step = ProcedureStep::tool_call("search", "query");
    let respond_step = ProcedureStep::respond("Hello!");
    let ask_step = ProcedureStep::ask("What do you need?");

    assert(tool_step.description.contains("search"));
    assert_eq(respond_step.description, "Respond to user");
    assert_eq(ask_step.description, "Ask user");
}

// ============================================================================
// Tests: SkillStats
// ============================================================================

#[test]
fn test_skill_stats_new() {
    let stats = SkillStats::new();
    assert_eq(stats.execution_count, 0);
    assert_eq(stats.success_count, 0);
    assert_eq(stats.failure_count, 0);
}

#[test]
fn test_skill_stats_from_counts() {
    let stats = SkillStats::from_counts(7, 3);

    assert_eq(stats.execution_count, 10);
    assert_eq(stats.success_count, 7);
    assert_eq(stats.failure_count, 3);

    let diff = (stats.success_rate - 0.7).abs();
    assert(diff < 0.001);
}

#[test]
fn test_skill_stats_zero_executions() {
    let stats = SkillStats::from_counts(0, 0);
    assert_eq(stats.success_rate, 0.0);
}

// ============================================================================
// Tests: ProceduralMemory Operations
// ============================================================================

#[test]
fn test_procedural_memory_creation() {
    let memory = ProceduralMemory::default_memory();
    assert_eq(memory.skill_count(), 0);
}

#[test]
fn test_register_skill() {
    let mut memory = ProceduralMemory::default_memory();

    let skill = Skill::new(1, "search_skill")
        .with_trigger(TriggerPattern::new(vec!["search", "find"], 0.5));

    let id = memory.register(skill);
    assert_eq(memory.skill_count(), 1);
}

#[test]
fn test_get_skill_by_id() {
    let mut memory = ProceduralMemory::default_memory();

    let skill = Skill::new(42, "test_skill");
    let id = memory.register(skill);

    let retrieved = memory.get(&id);
    assert(retrieved.is_some());
    assert_eq(retrieved.unwrap().name, "test_skill");
}

#[test]
fn test_get_skill_by_name() {
    let mut memory = ProceduralMemory::default_memory();

    memory.register(Skill::new(1, "unique_skill"));

    let skill = memory.get_by_name("unique_skill");
    assert(skill.is_some());
}

#[test]
fn test_get_nonexistent_skill() {
    let memory = ProceduralMemory::default_memory();
    let fake_id = SkillId::new(999);
    let skill = memory.get(&fake_id);
    assert(skill.is_none());
}

// ============================================================================
// Tests: Pattern Matching
// ============================================================================

#[test]
fn test_match_situation_exact_keywords() {
    let mut memory = ProceduralMemory::default_memory();

    let skill = Skill::new(1, "search_skill")
        .with_trigger(TriggerPattern::new(vec!["search", "find"], 0.5))
        .with_stats(SkillStats::from_counts(9, 1));

    memory.register(skill);

    let context = Context::new("Can you search for information?");
    let matches = memory.match_situation(&context);

    assert(matches.len() > 0);
}

#[test]
fn test_match_situation_partial_match() {
    let mut memory = ProceduralMemory::default_memory();

    let skill = Skill::new(1, "search_skill")
        .with_trigger(TriggerPattern::new(vec!["search", "find", "lookup", "query"], 0.5))
        .with_stats(SkillStats::from_counts(9, 1));

    memory.register(skill);

    // Only matches one keyword - should still match if above threshold
    let context = Context::new("Please search for this");
    let matches = memory.match_situation(&context);

    // With default threshold 0.5, matching 1/4 keywords (0.25) won't pass
    // Let's adjust or test different scenario
}

#[test]
fn test_match_situation_no_match() {
    let mut memory = ProceduralMemory::default_memory();

    let skill = Skill::new(1, "search_skill")
        .with_trigger(TriggerPattern::new(vec!["search", "find"], 0.5));

    memory.register(skill);

    let context = Context::new("Hello, how are you?");
    let matches = memory.match_situation(&context);

    assert_eq(matches.len(), 0);
}

#[test]
fn test_match_situation_disabled_skills() {
    let mut memory = ProceduralMemory::default_memory();

    let mut skill = Skill::new(1, "search_skill")
        .with_trigger(TriggerPattern::new(vec!["search"], 0.5));
    skill.enabled = false;

    memory.register(skill);

    let context = Context::new("Please search for this");
    let matches = memory.match_situation(&context);

    assert_eq(matches.len(), 0);
}

#[test]
fn test_match_situation_ranked_by_success_rate() {
    let mut memory = ProceduralMemory::new(
        ProceduralConfig::default_config().with_match_threshold(0.3)
    );

    // High success rate skill
    let skill1 = Skill::new(1, "reliable_skill")
        .with_trigger(TriggerPattern::new(vec!["help"], 0.5))
        .with_stats(SkillStats::from_counts(9, 1));

    // Low success rate skill
    let skill2 = Skill::new(2, "unreliable_skill")
        .with_trigger(TriggerPattern::new(vec!["help"], 0.5))
        .with_stats(SkillStats::from_counts(3, 7));

    memory.register(skill1);
    memory.register(skill2);

    let context = Context::new("I need help");
    let matches = memory.match_situation(&context);

    // Both should match, but reliable skill should rank higher
    assert_eq(matches.len(), 2);
    assert_eq(matches[0].skill.name, "reliable_skill");
}

// ============================================================================
// Tests: Feedback Recording
// ============================================================================

#[test]
fn test_record_success() {
    let mut memory = ProceduralMemory::default_memory();

    let skill = Skill::new(1, "test_skill")
        .with_stats(SkillStats::from_counts(5, 0));
    let id = memory.register(skill);

    memory.record_success(&id, 2.5);

    let skill = memory.get(&id).unwrap();
    assert_eq(skill.stats.execution_count, 6);
    assert_eq(skill.stats.success_count, 6);
}

#[test]
fn test_record_success_updates_duration() {
    let mut memory = ProceduralMemory::default_memory();

    let skill = Skill::new(1, "test_skill");
    let id = memory.register(skill);

    memory.record_success(&id, 5.0);

    let skill = memory.get(&id).unwrap();
    let diff = (skill.stats.avg_duration_secs - 5.0).abs();
    assert(diff < 0.001);
}

#[test]
fn test_record_failure() {
    let mut memory = ProceduralMemory::default_memory();

    let skill = Skill::new(1, "test_skill")
        .with_stats(SkillStats::from_counts(5, 0));
    let id = memory.register(skill);

    memory.record_failure(&id, "search context", "TimeoutError");

    let skill = memory.get(&id).unwrap();
    assert_eq(skill.stats.failure_count, 1);
    assert_eq(skill.failure_modes.len(), 1);
}

#[test]
fn test_record_failure_tracks_failure_mode() {
    let mut memory = ProceduralMemory::default_memory();

    let skill = Skill::new(1, "test_skill");
    let id = memory.register(skill);

    memory.record_failure(&id, "API call context", "RateLimitError");

    let skill = memory.get(&id).unwrap();
    assert_eq(skill.failure_modes[0].failure_type, "RateLimitError");
}

#[test]
fn test_success_rate_ema_on_success() {
    let mut memory = ProceduralMemory::default_memory();

    let mut skill = Skill::new(1, "test_skill");
    skill.stats.success_rate = 0.5;
    let id = memory.register(skill);

    // EMA: 0.5 * 0.9 + 0.1 = 0.55
    memory.record_success(&id, 1.0);

    let skill = memory.get(&id).unwrap();
    let expected = 0.55;
    let diff = (skill.stats.success_rate - expected).abs();
    assert(diff < 0.01);
}

#[test]
fn test_success_rate_ema_on_failure() {
    let mut memory = ProceduralMemory::default_memory();

    let mut skill = Skill::new(1, "test_skill");
    skill.stats.success_rate = 0.8;
    let id = memory.register(skill);

    // EMA: 0.8 * 0.9 = 0.72
    memory.record_failure(&id, "ctx", "error");

    let skill = memory.get(&id).unwrap();
    let expected = 0.72;
    let diff = (skill.stats.success_rate - expected).abs();
    assert(diff < 0.01);
}

// ============================================================================
// Tests: Enable/Disable
// ============================================================================

#[test]
fn test_disable_skill() {
    let mut memory = ProceduralMemory::default_memory();

    let skill = Skill::new(1, "test_skill");
    let id = memory.register(skill);

    assert(memory.get(&id).unwrap().enabled);

    let result = memory.disable(&id);
    assert(result);
    assert(!memory.get(&id).unwrap().enabled);
}

#[test]
fn test_enable_skill() {
    let mut memory = ProceduralMemory::default_memory();

    let mut skill = Skill::new(1, "test_skill");
    skill.enabled = false;
    let id = memory.register(skill);

    let result = memory.enable(&id);
    assert(result);
    assert(memory.get(&id).unwrap().enabled);
}

#[test]
fn test_disable_nonexistent_skill() {
    let mut memory = ProceduralMemory::default_memory();
    let fake_id = SkillId::new(999);
    let result = memory.disable(&fake_id);
    assert(!result);
}

// ============================================================================
// Tests: Action Types
// ============================================================================

#[test]
fn test_action_call_tool() {
    let action = Action::CallTool {
        tool: "search".to_string(),
        args: "query=test".to_string(),
    };

    let is_tool = match action {
        Action::CallTool { .. } => true,
        _ => false,
    };
    assert(is_tool);
}

#[test]
fn test_action_ask_user() {
    let action = Action::AskUser {
        question: "What would you like?".to_string(),
    };

    let is_ask = match action {
        Action::AskUser { .. } => true,
        _ => false,
    };
    assert(is_ask);
}

#[test]
fn test_action_respond() {
    let action = Action::Respond {
        template: "Here are the results: {results}".to_string(),
    };

    let is_respond = match action {
        Action::Respond { .. } => true,
        _ => false,
    };
    assert(is_respond);
}

fn main() {
    print("Engram procedural memory tests");
}
