//! Tests for Engram Semantic Memory (Knowledge Graph)
//!
//! Verifies fact storage, graph traversal, and semantic search.

// ============================================================================
// Self-contained Test Types (matching semantic.sg API)
// ============================================================================

pub struct NodeId(usize);

impl NodeId {
    fn new(id: usize) -> Self { Self(id) }
}

impl PartialEq for NodeId {
    fn eq(&self, other: &Self) -> bool {
        self.0 == other.0
    }
}

impl Clone for NodeId {
    fn clone(&self) -> Self { NodeId(self.0) }
}

impl Hash for NodeId {
    fn hash(&self) -> usize { self.0 }
}

pub struct EdgeId(usize);

impl EdgeId {
    fn new(id: usize) -> Self { Self(id) }
}

impl PartialEq for EdgeId {
    fn eq(&self, other: &Self) -> bool {
        self.0 == other.0
    }
}

impl Clone for EdgeId {
    fn clone(&self) -> Self { EdgeId(self.0) }
}

pub enum NodeType {
    Concept,
    Entity,
    Attribute,
    Action,
    Event,
    Category,
}

impl Clone for NodeType {
    fn clone(&self) -> Self {
        match self {
            NodeType::Concept => NodeType::Concept,
            NodeType::Entity => NodeType::Entity,
            NodeType::Attribute => NodeType::Attribute,
            NodeType::Action => NodeType::Action,
            NodeType::Event => NodeType::Event,
            NodeType::Category => NodeType::Category,
        }
    }
}

impl PartialEq for NodeType {
    fn eq(&self, other: &Self) -> bool {
        match (self, other) {
            (NodeType::Concept, NodeType::Concept) => true,
            (NodeType::Entity, NodeType::Entity) => true,
            (NodeType::Attribute, NodeType::Attribute) => true,
            (NodeType::Action, NodeType::Action) => true,
            (NodeType::Event, NodeType::Event) => true,
            (NodeType::Category, NodeType::Category) => true,
            _ => false,
        }
    }
}

pub enum Relation {
    IsA,
    HasProperty,
    PartOf,
    RelatedTo,
    Causes,
    CreatedBy,
    LocatedIn,
    OccurredAt,
    Custom(String),
}

impl Clone for Relation {
    fn clone(&self) -> Self {
        match self {
            Relation::IsA => Relation::IsA,
            Relation::HasProperty => Relation::HasProperty,
            Relation::PartOf => Relation::PartOf,
            Relation::RelatedTo => Relation::RelatedTo,
            Relation::Causes => Relation::Causes,
            Relation::CreatedBy => Relation::CreatedBy,
            Relation::LocatedIn => Relation::LocatedIn,
            Relation::OccurredAt => Relation::OccurredAt,
            Relation::Custom(s) => Relation::Custom(s.clone()),
        }
    }
}

impl PartialEq for Relation {
    fn eq(&self, other: &Self) -> bool {
        match (self, other) {
            (Relation::IsA, Relation::IsA) => true,
            (Relation::HasProperty, Relation::HasProperty) => true,
            (Relation::PartOf, Relation::PartOf) => true,
            (Relation::RelatedTo, Relation::RelatedTo) => true,
            (Relation::Causes, Relation::Causes) => true,
            (Relation::CreatedBy, Relation::CreatedBy) => true,
            (Relation::LocatedIn, Relation::LocatedIn) => true,
            (Relation::OccurredAt, Relation::OccurredAt) => true,
            (Relation::Custom(a), Relation::Custom(b)) => a == b,
            _ => false,
        }
    }
}

pub enum Epistemic {
    Unknown,
    Axiomatic,
    Observed { observer: String },
    Reported { source: String },
    Inferred { basis: String },
}

impl Clone for Epistemic {
    fn clone(&self) -> Self {
        match self {
            Epistemic::Unknown => Epistemic::Unknown,
            Epistemic::Axiomatic => Epistemic::Axiomatic,
            Epistemic::Observed { observer } => Epistemic::Observed { observer: observer.clone() },
            Epistemic::Reported { source } => Epistemic::Reported { source: source.clone() },
            Epistemic::Inferred { basis } => Epistemic::Inferred { basis: basis.clone() },
        }
    }
}

impl Epistemic {
    pub fn strength(&self) -> f64 {
        match self {
            Epistemic::Unknown => 0.1,
            Epistemic::Axiomatic => 1.0,
            Epistemic::Observed { .. } => 0.9,
            Epistemic::Reported { .. } => 0.6,
            Epistemic::Inferred { .. } => 0.5,
        }
    }
}

pub struct Node {
    pub id: NodeId,
    pub node_type: NodeType,
    pub label: String,
    pub aliases: Vec<String>,
    pub confidence: f64,
    pub epistemic: Epistemic,
    pub access_count: u32,
}

impl Node {
    pub fn new(id: usize, label: &str, node_type: NodeType) -> Self {
        Self {
            id: NodeId::new(id),
            node_type,
            label: label.to_string(),
            aliases: Vec::new(),
            confidence: 0.5,
            epistemic: Epistemic::Unknown,
            access_count: 0,
        }
    }

    pub fn with_confidence(mut self, conf: f64) -> Self {
        self.confidence = conf;
        self
    }

    pub fn with_epistemic(mut self, ep: Epistemic) -> Self {
        self.epistemic = ep;
        self
    }

    pub fn add_alias(&mut self, alias: &str) {
        self.aliases.push(alias.to_string());
    }
}

impl Clone for Node {
    fn clone(&self) -> Self {
        Node {
            id: self.id.clone(),
            node_type: self.node_type.clone(),
            label: self.label.clone(),
            aliases: self.aliases.clone(),
            confidence: self.confidence,
            epistemic: self.epistemic.clone(),
            access_count: self.access_count,
        }
    }
}

pub struct Edge {
    pub id: EdgeId,
    pub source: NodeId,
    pub target: NodeId,
    pub relation: Relation,
    pub weight: f64,
    pub confidence: f64,
    pub epistemic: Epistemic,
}

impl Edge {
    pub fn new(id: usize, source: NodeId, target: NodeId, relation: Relation) -> Self {
        Self {
            id: EdgeId::new(id),
            source,
            target,
            relation,
            weight: 1.0,
            confidence: 0.5,
            epistemic: Epistemic::Unknown,
        }
    }
}

pub struct Claim {
    pub relation: Relation,
    pub object: String,
    pub object_type: Option<NodeType>,
}

impl Claim {
    pub fn new(relation: Relation, object: &str) -> Self {
        Self {
            relation,
            object: object.to_string(),
            object_type: None,
        }
    }

    pub fn with_type(mut self, node_type: NodeType) -> Self {
        self.object_type = Some(node_type);
        self
    }
}

pub struct Fact {
    pub subject: String,
    pub subject_type: Option<NodeType>,
    pub claims: Vec<Claim>,
    pub epistemic: Epistemic,
    pub confidence: f64,
}

impl Fact {
    pub fn new(subject: &str) -> Self {
        Self {
            subject: subject.to_string(),
            subject_type: None,
            claims: Vec::new(),
            epistemic: Epistemic::Unknown,
            confidence: 0.5,
        }
    }

    pub fn with_type(mut self, node_type: NodeType) -> Self {
        self.subject_type = Some(node_type);
        self
    }

    pub fn claim(mut self, relation: Relation, object: &str) -> Self {
        self.claims.push(Claim::new(relation, object));
        self
    }

    pub fn observed(mut self) -> Self {
        self.epistemic = Epistemic::Observed { observer: "self".to_string() };
        self.confidence = 0.95;
        self
    }

    pub fn reported(mut self, source: &str) -> Self {
        self.epistemic = Epistemic::Reported { source: source.to_string() };
        self.confidence = 0.6;
        self
    }

    pub fn significance(&self) -> f64 {
        self.confidence * self.epistemic.strength()
    }
}

pub struct QueryResult {
    pub node_id: NodeId,
    pub node: Node,
    pub relevance: f64,
    pub confidence: f64,
}

pub enum Direction {
    Outgoing,
    Incoming,
    Both,
}

pub struct PathStep {
    pub relation: Relation,
    pub direction: Direction,
}

pub struct GraphPath {
    pub steps: Vec<PathStep>,
}

impl GraphPath {
    pub fn new() -> Self {
        Self { steps: Vec::new() }
    }

    pub fn follow(mut self, relation: Relation) -> Self {
        self.steps.push(PathStep {
            relation,
            direction: Direction::Outgoing,
        });
        self
    }

    pub fn follow_incoming(mut self, relation: Relation) -> Self {
        self.steps.push(PathStep {
            relation,
            direction: Direction::Incoming,
        });
        self
    }
}

pub struct SemanticConfig {
    pub max_nodes: Option<usize>,
    pub default_confidence: f64,
}

impl SemanticConfig {
    pub fn default_config() -> Self {
        Self {
            max_nodes: Some(10000),
            default_confidence: 0.5,
        }
    }
}

pub struct SemanticMemory {
    nodes: Vec<Node>,
    edges: Vec<Edge>,
    next_node_id: usize,
    next_edge_id: usize,
    config: SemanticConfig,
}

impl SemanticMemory {
    pub fn new(config: SemanticConfig) -> Self {
        Self {
            nodes: Vec::new(),
            edges: Vec::new(),
            next_node_id: 0,
            next_edge_id: 0,
            config,
        }
    }

    pub fn default_memory() -> Self {
        Self::new(SemanticConfig::default_config())
    }

    pub fn node_count(&self) -> usize {
        self.nodes.len()
    }

    pub fn edge_count(&self) -> usize {
        self.edges.len()
    }

    pub fn get_node(&self, id: &NodeId) -> Option<&Node> {
        self.nodes.iter().find(|n| n.id == *id)
    }

    pub fn get_node_by_label(&self, label: &str) -> Option<&Node> {
        self.nodes.iter().find(|n| n.label == label)
    }

    pub fn get_edge(&self, id: &EdgeId) -> Option<&Edge> {
        self.edges.iter().find(|e| e.id == *id)
    }

    pub fn add_node(&mut self, label: &str, node_type: NodeType) -> NodeId {
        // Check if exists
        for node in &self.nodes {
            if node.label == label {
                return node.id.clone();
            }
        }

        let id = self.next_node_id;
        self.next_node_id = self.next_node_id + 1;

        let node = Node::new(id, label, node_type);
        self.nodes.push(node);
        NodeId::new(id)
    }

    pub fn add_edge(&mut self, source: NodeId, target: NodeId, relation: Relation) -> EdgeId {
        let id = self.next_edge_id;
        self.next_edge_id = self.next_edge_id + 1;

        let edge = Edge::new(id, source, target, relation);
        self.edges.push(edge);
        EdgeId::new(id)
    }

    pub fn learn(&mut self, fact: Fact) -> Vec<NodeId> {
        let mut created = Vec::new();

        // Get or create subject
        let subject_type = fact.subject_type.unwrap_or(NodeType::Concept);
        let subject_id = self.add_node(&fact.subject, subject_type);
        created.push(subject_id.clone());

        // Process claims
        for claim in &fact.claims {
            let object_type = claim.object_type.clone().unwrap_or(NodeType::Concept);
            let object_id = self.add_node(&claim.object, object_type);
            created.push(object_id.clone());

            self.add_edge(subject_id.clone(), object_id, claim.relation.clone());
        }

        // Update epistemic and confidence on subject
        for node in &mut self.nodes {
            if node.id == subject_id {
                node.epistemic = fact.epistemic.clone();
                node.confidence = fact.confidence;
                break;
            }
        }

        created
    }

    pub fn query(&self, text: &str, limit: usize) -> Vec<QueryResult> {
        let query_lower = text.to_lowercase();
        let query_words: Vec<&str> = query_lower.split_whitespace().collect();

        let mut scored: Vec<QueryResult> = Vec::new();

        for node in &self.nodes {
            let relevance = self.compute_relevance(&query_words, node);
            if relevance > 0.0 {
                scored.push(QueryResult {
                    node_id: node.id.clone(),
                    node: node.clone(),
                    relevance,
                    confidence: node.confidence,
                });
            }
        }

        // Sort by relevance * confidence (bubble sort)
        for i in 0..scored.len() {
            for j in (i + 1)..scored.len() {
                let score_i = scored[i].relevance * scored[i].confidence.max(0.1);
                let score_j = scored[j].relevance * scored[j].confidence.max(0.1);
                if score_j > score_i {
                    let temp = QueryResult {
                        node_id: scored[i].node_id.clone(),
                        node: scored[i].node.clone(),
                        relevance: scored[i].relevance,
                        confidence: scored[i].confidence,
                    };
                    scored[i] = QueryResult {
                        node_id: scored[j].node_id.clone(),
                        node: scored[j].node.clone(),
                        relevance: scored[j].relevance,
                        confidence: scored[j].confidence,
                    };
                    scored[j] = temp;
                }
            }
        }

        let mut result = Vec::new();
        for i in 0..limit.min(scored.len()) {
            result.push(QueryResult {
                node_id: scored[i].node_id.clone(),
                node: scored[i].node.clone(),
                relevance: scored[i].relevance,
                confidence: scored[i].confidence,
            });
        }
        result
    }

    pub fn neighbors(&self, node_id: &NodeId, relation: Option<Relation>) -> Vec<NodeId> {
        let mut result = Vec::new();
        for edge in &self.edges {
            if edge.source == *node_id {
                let matches = match &relation {
                    Some(r) => edge.relation == *r,
                    None => true,
                };
                if matches {
                    result.push(edge.target.clone());
                }
            }
        }
        result
    }

    pub fn incoming_neighbors(&self, node_id: &NodeId, relation: Option<Relation>) -> Vec<NodeId> {
        let mut result = Vec::new();
        for edge in &self.edges {
            if edge.target == *node_id {
                let matches = match &relation {
                    Some(r) => edge.relation == *r,
                    None => true,
                };
                if matches {
                    result.push(edge.source.clone());
                }
            }
        }
        result
    }

    pub fn traverse(&self, start: &NodeId, path: &GraphPath) -> Vec<NodeId> {
        let mut current = vec![start.clone()];

        for step in &path.steps {
            let mut next = Vec::new();

            for node_id in &current {
                let neighbors = match step.direction {
                    Direction::Outgoing => self.neighbors(node_id, Some(step.relation.clone())),
                    Direction::Incoming => self.incoming_neighbors(node_id, Some(step.relation.clone())),
                    Direction::Both => {
                        let mut both = self.neighbors(node_id, Some(step.relation.clone()));
                        both.extend(self.incoming_neighbors(node_id, Some(step.relation.clone())));
                        both
                    }
                };
                next.extend(neighbors);
            }

            current = next;
        }

        current
    }

    fn compute_relevance(&self, query_words: &Vec<&str>, node: &Node) -> f64 {
        let label_lower = node.label.to_lowercase();
        let label_words: Vec<&str> = label_lower.split_whitespace().collect();

        // Exact match
        for word in query_words {
            if *word == label_lower {
                return 1.0;
            }
        }

        // Word overlap
        let mut matches = 0;
        for qw in query_words {
            for lw in &label_words {
                if *qw == *lw {
                    matches = matches + 1;
                    break;
                }
            }
        }

        if matches > 0 {
            return matches as f64 / query_words.len().max(1) as f64;
        }

        // Substring match
        for word in query_words {
            if label_lower.contains(*word) {
                return 0.5;
            }
        }

        0.0
    }
}

// ============================================================================
// Tests: Node Construction
// ============================================================================

#[test]
fn test_node_creation() {
    let node = Node::new(1, "Test Node", NodeType::Concept);
    assert_eq(node.label, "Test Node");
    assert_eq(node.access_count, 0);
}

#[test]
fn test_node_with_confidence() {
    let node = Node::new(1, "Test", NodeType::Concept)
        .with_confidence(0.9);
    let diff = (node.confidence - 0.9).abs();
    assert(diff < 0.001);
}

#[test]
fn test_node_with_epistemic() {
    let node = Node::new(1, "Test", NodeType::Concept)
        .with_epistemic(Epistemic::Observed { observer: "agent".to_string() });

    let strength = node.epistemic.strength();
    assert(strength > 0.8);
}

#[test]
fn test_node_aliases() {
    let mut node = Node::new(1, "United States", NodeType::Entity);
    node.add_alias("USA");
    node.add_alias("America");

    assert_eq(node.aliases.len(), 2);
}

// ============================================================================
// Tests: Edge Construction
// ============================================================================

#[test]
fn test_edge_creation() {
    let source = NodeId::new(1);
    let target = NodeId::new(2);
    let edge = Edge::new(1, source, target, Relation::IsA);

    assert_eq(edge.source.0, 1);
    assert_eq(edge.target.0, 2);
}

#[test]
fn test_edge_relation() {
    let edge = Edge::new(1, NodeId::new(1), NodeId::new(2), Relation::HasProperty);
    assert(edge.relation == Relation::HasProperty);
}

#[test]
fn test_custom_relation() {
    let edge = Edge::new(1, NodeId::new(1), NodeId::new(2),
        Relation::Custom("worksAt".to_string()));

    let is_custom = match edge.relation {
        Relation::Custom(s) => s == "worksAt",
        _ => false,
    };
    assert(is_custom);
}

// ============================================================================
// Tests: Fact Construction
// ============================================================================

#[test]
fn test_fact_creation() {
    let fact = Fact::new("Python");
    assert_eq(fact.subject, "Python");
    assert_eq(fact.claims.len(), 0);
}

#[test]
fn test_fact_with_claim() {
    let fact = Fact::new("Python")
        .claim(Relation::IsA, "Programming Language");

    assert_eq(fact.claims.len(), 1);
    assert_eq(fact.claims[0].object, "Programming Language");
}

#[test]
fn test_fact_multiple_claims() {
    let fact = Fact::new("Python")
        .claim(Relation::IsA, "Programming Language")
        .claim(Relation::HasProperty, "Dynamic Typing")
        .claim(Relation::CreatedBy, "Guido van Rossum");

    assert_eq(fact.claims.len(), 3);
}

#[test]
fn test_fact_observed() {
    let fact = Fact::new("Test").observed();

    let is_observed = match fact.epistemic {
        Epistemic::Observed { .. } => true,
        _ => false,
    };
    assert(is_observed);
    assert(fact.confidence > 0.9);
}

#[test]
fn test_fact_reported() {
    let fact = Fact::new("Test").reported("Wikipedia");

    let source = match &fact.epistemic {
        Epistemic::Reported { source } => source.clone(),
        _ => "".to_string(),
    };
    assert_eq(source, "Wikipedia");
}

#[test]
fn test_fact_significance() {
    let fact = Fact::new("Test").observed();
    let sig = fact.significance();

    // Observed (0.9 strength) * high confidence (0.95) should be high
    assert(sig > 0.8);
}

// ============================================================================
// Tests: Semantic Memory Operations
// ============================================================================

#[test]
fn test_semantic_memory_creation() {
    let memory = SemanticMemory::default_memory();
    assert_eq(memory.node_count(), 0);
    assert_eq(memory.edge_count(), 0);
}

#[test]
fn test_add_node() {
    let mut memory = SemanticMemory::default_memory();
    let id = memory.add_node("Python", NodeType::Concept);

    assert_eq(memory.node_count(), 1);
}

#[test]
fn test_add_duplicate_node() {
    let mut memory = SemanticMemory::default_memory();

    let id1 = memory.add_node("Python", NodeType::Concept);
    let id2 = memory.add_node("Python", NodeType::Concept);

    // Should return same ID for duplicate
    assert(id1 == id2);
    assert_eq(memory.node_count(), 1);
}

#[test]
fn test_add_edge() {
    let mut memory = SemanticMemory::default_memory();

    let python = memory.add_node("Python", NodeType::Concept);
    let lang = memory.add_node("Programming Language", NodeType::Category);
    memory.add_edge(python, lang, Relation::IsA);

    assert_eq(memory.edge_count(), 1);
}

#[test]
fn test_get_node_by_id() {
    let mut memory = SemanticMemory::default_memory();
    let id = memory.add_node("Test", NodeType::Concept);

    let node = memory.get_node(&id);
    assert(node.is_some());
    assert_eq(node.unwrap().label, "Test");
}

#[test]
fn test_get_node_by_label() {
    let mut memory = SemanticMemory::default_memory();
    memory.add_node("Python", NodeType::Concept);

    let node = memory.get_node_by_label("Python");
    assert(node.is_some());
}

#[test]
fn test_get_nonexistent_node() {
    let memory = SemanticMemory::default_memory();
    let fake_id = NodeId::new(999);
    let node = memory.get_node(&fake_id);
    assert(node.is_none());
}

// ============================================================================
// Tests: Learning Facts
// ============================================================================

#[test]
fn test_learn_simple_fact() {
    let mut memory = SemanticMemory::default_memory();

    let fact = Fact::new("Python")
        .claim(Relation::IsA, "Language");

    let created = memory.learn(fact);

    // Should create 2 nodes (subject + object)
    assert_eq(created.len(), 2);
    assert_eq(memory.node_count(), 2);
    assert_eq(memory.edge_count(), 1);
}

#[test]
fn test_learn_fact_with_multiple_claims() {
    let mut memory = SemanticMemory::default_memory();

    let fact = Fact::new("Python")
        .claim(Relation::IsA, "Programming Language")
        .claim(Relation::HasProperty, "Dynamic Typing")
        .claim(Relation::HasProperty, "Interpreted");

    memory.learn(fact);

    // Python + 3 objects = 4 nodes
    assert_eq(memory.node_count(), 4);
    assert_eq(memory.edge_count(), 3);
}

#[test]
fn test_learn_updates_epistemic() {
    let mut memory = SemanticMemory::default_memory();

    let fact = Fact::new("Python")
        .claim(Relation::IsA, "Language")
        .observed();

    memory.learn(fact);

    let node = memory.get_node_by_label("Python").unwrap();
    assert(node.confidence > 0.9);
}

#[test]
fn test_learn_reuses_existing_nodes() {
    let mut memory = SemanticMemory::default_memory();

    // First fact
    memory.learn(Fact::new("Python")
        .claim(Relation::IsA, "Programming Language"));

    // Second fact with same object
    memory.learn(Fact::new("Rust")
        .claim(Relation::IsA, "Programming Language"));

    // Should reuse "Programming Language" node
    assert_eq(memory.node_count(), 3);  // Python, Rust, Programming Language
    assert_eq(memory.edge_count(), 2);
}

// ============================================================================
// Tests: Query
// ============================================================================

#[test]
fn test_query_exact_match() {
    let mut memory = SemanticMemory::default_memory();
    memory.add_node("Python", NodeType::Concept);
    memory.add_node("Java", NodeType::Concept);
    memory.add_node("Rust", NodeType::Concept);

    let results = memory.query("Python", 5);

    assert(results.len() > 0);
    assert_eq(results[0].node.label, "Python");
}

#[test]
fn test_query_partial_match() {
    let mut memory = SemanticMemory::default_memory();
    memory.add_node("Python Programming", NodeType::Concept);
    memory.add_node("Java Development", NodeType::Concept);

    let results = memory.query("Python", 5);

    assert(results.len() > 0);
}

#[test]
fn test_query_no_match() {
    let mut memory = SemanticMemory::default_memory();
    memory.add_node("Python", NodeType::Concept);
    memory.add_node("Java", NodeType::Concept);

    let results = memory.query("Haskell", 5);

    assert_eq(results.len(), 0);
}

#[test]
fn test_query_respects_limit() {
    let mut memory = SemanticMemory::default_memory();

    for i in 0..10 {
        memory.add_node(&format!("Concept {}", i), NodeType::Concept);
    }

    let results = memory.query("Concept", 3);
    assert_eq(results.len(), 3);
}

#[test]
fn test_query_ranks_by_relevance_and_confidence() {
    let mut memory = SemanticMemory::default_memory();

    // Low confidence exact match
    let id1 = memory.add_node("Python", NodeType::Concept);
    // High confidence partial match
    let id2 = memory.add_node("Python Programming", NodeType::Concept);

    // Update confidences
    for node in &mut memory.nodes {
        if node.id == id1 {
            node.confidence = 0.3;
        } else if node.id == id2 {
            node.confidence = 0.9;
        }
    }

    let results = memory.query("Python", 5);
    // Should have results
    assert(results.len() >= 2);
}

// ============================================================================
// Tests: Graph Traversal
// ============================================================================

#[test]
fn test_neighbors_outgoing() {
    let mut memory = SemanticMemory::default_memory();

    let python = memory.add_node("Python", NodeType::Concept);
    let lang = memory.add_node("Language", NodeType::Category);
    let dynamic = memory.add_node("Dynamic", NodeType::Attribute);

    memory.add_edge(python.clone(), lang.clone(), Relation::IsA);
    memory.add_edge(python.clone(), dynamic.clone(), Relation::HasProperty);

    let neighbors = memory.neighbors(&python, None);
    assert_eq(neighbors.len(), 2);
}

#[test]
fn test_neighbors_filtered_by_relation() {
    let mut memory = SemanticMemory::default_memory();

    let python = memory.add_node("Python", NodeType::Concept);
    let lang = memory.add_node("Language", NodeType::Category);
    let dynamic = memory.add_node("Dynamic", NodeType::Attribute);

    memory.add_edge(python.clone(), lang.clone(), Relation::IsA);
    memory.add_edge(python.clone(), dynamic.clone(), Relation::HasProperty);

    let neighbors = memory.neighbors(&python, Some(Relation::IsA));
    assert_eq(neighbors.len(), 1);
}

#[test]
fn test_incoming_neighbors() {
    let mut memory = SemanticMemory::default_memory();

    let python = memory.add_node("Python", NodeType::Concept);
    let rust = memory.add_node("Rust", NodeType::Concept);
    let lang = memory.add_node("Language", NodeType::Category);

    memory.add_edge(python.clone(), lang.clone(), Relation::IsA);
    memory.add_edge(rust.clone(), lang.clone(), Relation::IsA);

    let incoming = memory.incoming_neighbors(&lang, None);
    assert_eq(incoming.len(), 2);
}

#[test]
fn test_traverse_single_hop() {
    let mut memory = SemanticMemory::default_memory();

    let python = memory.add_node("Python", NodeType::Concept);
    let lang = memory.add_node("Language", NodeType::Category);
    memory.add_edge(python.clone(), lang.clone(), Relation::IsA);

    let path = GraphPath::new().follow(Relation::IsA);
    let results = memory.traverse(&python, &path);

    assert_eq(results.len(), 1);
    assert(results[0] == lang);
}

#[test]
fn test_traverse_multi_hop() {
    let mut memory = SemanticMemory::default_memory();

    let python = memory.add_node("Python", NodeType::Concept);
    let lang = memory.add_node("Language", NodeType::Category);
    let tool = memory.add_node("Tool", NodeType::Category);

    memory.add_edge(python.clone(), lang.clone(), Relation::IsA);
    memory.add_edge(lang.clone(), tool.clone(), Relation::IsA);

    let path = GraphPath::new()
        .follow(Relation::IsA)
        .follow(Relation::IsA);

    let results = memory.traverse(&python, &path);

    assert_eq(results.len(), 1);
    assert(results[0] == tool);
}

#[test]
fn test_traverse_no_path() {
    let mut memory = SemanticMemory::default_memory();

    let python = memory.add_node("Python", NodeType::Concept);
    let lang = memory.add_node("Language", NodeType::Category);
    memory.add_edge(python.clone(), lang.clone(), Relation::IsA);

    // Try to follow HasProperty, but we only have IsA
    let path = GraphPath::new().follow(Relation::HasProperty);
    let results = memory.traverse(&python, &path);

    assert_eq(results.len(), 0);
}

// ============================================================================
// Tests: Epistemic Types
// ============================================================================

#[test]
fn test_epistemic_strength_axiomatic() {
    let ep = Epistemic::Axiomatic;
    let strength = ep.strength();
    let diff = (strength - 1.0).abs();
    assert(diff < 0.001);
}

#[test]
fn test_epistemic_strength_observed() {
    let ep = Epistemic::Observed { observer: "self".to_string() };
    let strength = ep.strength();
    assert(strength > 0.8);
}

#[test]
fn test_epistemic_strength_reported() {
    let ep = Epistemic::Reported { source: "wiki".to_string() };
    let strength = ep.strength();
    assert(strength > 0.5);
    assert(strength < 0.8);
}

#[test]
fn test_epistemic_strength_inferred() {
    let ep = Epistemic::Inferred { basis: "reasoning".to_string() };
    let strength = ep.strength();
    assert(strength >= 0.5);
}

#[test]
fn test_epistemic_strength_unknown() {
    let ep = Epistemic::Unknown;
    let strength = ep.strength();
    assert(strength < 0.2);
}

// ============================================================================
// Tests: GraphPath
// ============================================================================

#[test]
fn test_graph_path_empty() {
    let path = GraphPath::new();
    assert_eq(path.steps.len(), 0);
}

#[test]
fn test_graph_path_single_step() {
    let path = GraphPath::new().follow(Relation::IsA);
    assert_eq(path.steps.len(), 1);
}

#[test]
fn test_graph_path_multiple_steps() {
    let path = GraphPath::new()
        .follow(Relation::IsA)
        .follow(Relation::PartOf)
        .follow_incoming(Relation::CreatedBy);

    assert_eq(path.steps.len(), 3);
}

fn main() {
    print("Engram semantic memory tests");
}
