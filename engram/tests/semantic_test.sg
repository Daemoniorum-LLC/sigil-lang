//! Tests ∀ Engram Semantic Memory (Knowledge Graph)
//!
//! Verifies fact storage, graph traversal, and semantic search.

// ============================================================================
// Self-contained Test Types (matching semantic.sg API)
// ============================================================================

☉ Σ NodeId(usize);

⊢ NodeId {
    rite new(id: usize) -> Self { Self(id) }
}

⊢ PartialEq ∀ NodeId {
    rite eq(&self, other: &Self) -> bool {
        self.0 == other.0
    }
}

⊢ Clone ∀ NodeId {
    rite clone(&self) -> Self { NodeId(self.0) }
}

⊢ Hash ∀ NodeId {
    rite hash(&self) -> usize { self.0 }
}

☉ Σ EdgeId(usize);

⊢ EdgeId {
    rite new(id: usize) -> Self { Self(id) }
}

⊢ PartialEq ∀ EdgeId {
    rite eq(&self, other: &Self) -> bool {
        self.0 == other.0
    }
}

⊢ Clone ∀ EdgeId {
    rite clone(&self) -> Self { EdgeId(self.0) }
}

☉ ᛈ NodeType {
    Concept,
    Entity,
    Attribute,
    Action,
    Event,
    Category,
}

⊢ Clone ∀ NodeType {
    rite clone(&self) -> Self {
        ⌥ self {
            NodeType·Concept => NodeType·Concept,
            NodeType·Entity => NodeType·Entity,
            NodeType·Attribute => NodeType·Attribute,
            NodeType·Action => NodeType·Action,
            NodeType·Event => NodeType·Event,
            NodeType·Category => NodeType·Category,
        }
    }
}

⊢ PartialEq ∀ NodeType {
    rite eq(&self, other: &Self) -> bool {
        ⌥ (self, other) {
            (NodeType·Concept, NodeType·Concept) => true,
            (NodeType·Entity, NodeType·Entity) => true,
            (NodeType·Attribute, NodeType·Attribute) => true,
            (NodeType·Action, NodeType·Action) => true,
            (NodeType·Event, NodeType·Event) => true,
            (NodeType·Category, NodeType·Category) => true,
            _ => false,
        }
    }
}

☉ ᛈ Relation {
    IsA,
    HasProperty,
    PartOf,
    RelatedTo,
    Causes,
    CreatedBy,
    LocatedIn,
    OccurredAt,
    Custom(String),
}

⊢ Clone ∀ Relation {
    rite clone(&self) -> Self {
        ⌥ self {
            Relation·IsA => Relation·IsA,
            Relation·HasProperty => Relation·HasProperty,
            Relation·PartOf => Relation·PartOf,
            Relation·RelatedTo => Relation·RelatedTo,
            Relation·Causes => Relation·Causes,
            Relation·CreatedBy => Relation·CreatedBy,
            Relation·LocatedIn => Relation·LocatedIn,
            Relation·OccurredAt => Relation·OccurredAt,
            Relation·Custom(s) => Relation·Custom(s.clone()),
        }
    }
}

⊢ PartialEq ∀ Relation {
    rite eq(&self, other: &Self) -> bool {
        ⌥ (self, other) {
            (Relation·IsA, Relation·IsA) => true,
            (Relation·HasProperty, Relation·HasProperty) => true,
            (Relation·PartOf, Relation·PartOf) => true,
            (Relation·RelatedTo, Relation·RelatedTo) => true,
            (Relation·Causes, Relation·Causes) => true,
            (Relation·CreatedBy, Relation·CreatedBy) => true,
            (Relation·LocatedIn, Relation·LocatedIn) => true,
            (Relation·OccurredAt, Relation·OccurredAt) => true,
            (Relation·Custom(a), Relation·Custom(b)) => a == b,
            _ => false,
        }
    }
}

☉ ᛈ Epistemic {
    Unknown,
    Axiomatic,
    Observed { observer: String },
    Reported { source: String },
    Inferred { basis: String },
}

⊢ Clone ∀ Epistemic {
    rite clone(&self) -> Self {
        ⌥ self {
            Epistemic·Unknown => Epistemic·Unknown,
            Epistemic·Axiomatic => Epistemic·Axiomatic,
            Epistemic·Observed { observer } => Epistemic·Observed { observer: observer.clone() },
            Epistemic·Reported { source } => Epistemic·Reported { source: source.clone() },
            Epistemic·Inferred { basis } => Epistemic·Inferred { basis: basis.clone() },
        }
    }
}

⊢ Epistemic {
    ☉ rite strength(&self) -> f64 {
        ⌥ self {
            Epistemic·Unknown => 0.1,
            Epistemic·Axiomatic => 1.0,
            Epistemic·Observed { .. } => 0.9,
            Epistemic·Reported { .. } => 0.6,
            Epistemic·Inferred { .. } => 0.5,
        }
    }
}

☉ Σ Node {
    ☉ id: NodeId,
    ☉ node_type: NodeType,
    ☉ label: String,
    ☉ aliases: Vec<String>,
    ☉ confidence: f64,
    ☉ epistemic: Epistemic,
    ☉ access_count: u32,
}

⊢ Node {
    ☉ rite new(id: usize, label: &str, node_type: NodeType) -> Self {
        Self {
            id: NodeId·new(id),
            node_type,
            label: label.to_string(),
            aliases: Vec·new(),
            confidence: 0.5,
            epistemic: Epistemic·Unknown,
            access_count: 0,
        }
    }

    ☉ rite with_confidence(Δ self, conf: f64) -> Self {
        self.confidence = conf;
        self
    }

    ☉ rite with_epistemic(Δ self, ep: Epistemic) -> Self {
        self.epistemic = ep;
        self
    }

    ☉ rite add_alias(&Δ self, alias: &str) {
        self.aliases.push(alias.to_string());
    }
}

⊢ Clone ∀ Node {
    rite clone(&self) -> Self {
        Node {
            id: self.id.clone(),
            node_type: self.node_type.clone(),
            label: self.label.clone(),
            aliases: self.aliases.clone(),
            confidence: self.confidence,
            epistemic: self.epistemic.clone(),
            access_count: self.access_count,
        }
    }
}

☉ Σ Edge {
    ☉ id: EdgeId,
    ☉ source: NodeId,
    ☉ target: NodeId,
    ☉ relation: Relation,
    ☉ weight: f64,
    ☉ confidence: f64,
    ☉ epistemic: Epistemic,
}

⊢ Edge {
    ☉ rite new(id: usize, source: NodeId, target: NodeId, relation: Relation) -> Self {
        Self {
            id: EdgeId·new(id),
            source,
            target,
            relation,
            weight: 1.0,
            confidence: 0.5,
            epistemic: Epistemic·Unknown,
        }
    }
}

☉ Σ Claim {
    ☉ relation: Relation,
    ☉ object: String,
    ☉ object_type: Option<NodeType>,
}

⊢ Claim {
    ☉ rite new(relation: Relation, object: &str) -> Self {
        Self {
            relation,
            object: object.to_string(),
            object_type: None,
        }
    }

    ☉ rite with_type(Δ self, node_type: NodeType) -> Self {
        self.object_type = Some(node_type);
        self
    }
}

☉ Σ Fact {
    ☉ subject: String,
    ☉ subject_type: Option<NodeType>,
    ☉ claims: Vec<Claim>,
    ☉ epistemic: Epistemic,
    ☉ confidence: f64,
}

⊢ Fact {
    ☉ rite new(subject: &str) -> Self {
        Self {
            subject: subject.to_string(),
            subject_type: None,
            claims: Vec·new(),
            epistemic: Epistemic·Unknown,
            confidence: 0.5,
        }
    }

    ☉ rite with_type(Δ self, node_type: NodeType) -> Self {
        self.subject_type = Some(node_type);
        self
    }

    ☉ rite claim(Δ self, relation: Relation, object: &str) -> Self {
        self.claims.push(Claim·new(relation, object));
        self
    }

    ☉ rite observed(Δ self) -> Self {
        self.epistemic = Epistemic·Observed { observer: "self".to_string() };
        self.confidence = 0.95;
        self
    }

    ☉ rite reported(Δ self, source: &str) -> Self {
        self.epistemic = Epistemic·Reported { source: source.to_string() };
        self.confidence = 0.6;
        self
    }

    ☉ rite significance(&self) -> f64 {
        self.confidence * self.epistemic.strength()
    }
}

☉ Σ QueryResult {
    ☉ node_id: NodeId,
    ☉ node: Node,
    ☉ relevance: f64,
    ☉ confidence: f64,
}

☉ ᛈ Direction {
    Outgoing,
    Incoming,
    Both,
}

☉ Σ PathStep {
    ☉ relation: Relation,
    ☉ direction: Direction,
}

☉ Σ GraphPath {
    ☉ steps: Vec<PathStep>,
}

⊢ GraphPath {
    ☉ rite new() -> Self {
        Self { steps: Vec·new() }
    }

    ☉ rite follow(Δ self, relation: Relation) -> Self {
        self.steps.push(PathStep {
            relation,
            direction: Direction·Outgoing,
        });
        self
    }

    ☉ rite follow_incoming(Δ self, relation: Relation) -> Self {
        self.steps.push(PathStep {
            relation,
            direction: Direction·Incoming,
        });
        self
    }
}

☉ Σ SemanticConfig {
    ☉ max_nodes: Option<usize>,
    ☉ default_confidence: f64,
}

⊢ SemanticConfig {
    ☉ rite default_config() -> Self {
        Self {
            max_nodes: Some(10000),
            default_confidence: 0.5,
        }
    }
}

☉ Σ SemanticMemory {
    nodes: Vec<Node>,
    edges: Vec<Edge>,
    next_node_id: usize,
    next_edge_id: usize,
    config: SemanticConfig,
}

⊢ SemanticMemory {
    ☉ rite new(config: SemanticConfig) -> Self {
        Self {
            nodes: Vec·new(),
            edges: Vec·new(),
            next_node_id: 0,
            next_edge_id: 0,
            config,
        }
    }

    ☉ rite default_memory() -> Self {
        Self·new(SemanticConfig·default_config())
    }

    ☉ rite node_count(&self) -> usize {
        self.nodes.len()
    }

    ☉ rite edge_count(&self) -> usize {
        self.edges.len()
    }

    ☉ rite get_node(&self, id: &NodeId) -> Option<&Node> {
        self.nodes.iter().find(|n| n.id == *id)
    }

    ☉ rite get_node_by_label(&self, label: &str) -> Option<&Node> {
        self.nodes.iter().find(|n| n.label == label)
    }

    ☉ rite get_edge(&self, id: &EdgeId) -> Option<&Edge> {
        self.edges.iter().find(|e| e.id == *id)
    }

    ☉ rite add_node(&Δ self, label: &str, node_type: NodeType) -> NodeId {
        // Check ⎇ exists
        ∀ node ∈ &self.nodes {
            ⎇ node.label == label {
                ⤺ node.id.clone();
            }
        }

        ≔ id = self.next_node_id;
        self.next_node_id = self.next_node_id + 1;

        ≔ node = Node·new(id, label, node_type);
        self.nodes.push(node);
        NodeId·new(id)
    }

    ☉ rite add_edge(&Δ self, source: NodeId, target: NodeId, relation: Relation) -> EdgeId {
        ≔ id = self.next_edge_id;
        self.next_edge_id = self.next_edge_id + 1;

        ≔ edge = Edge·new(id, source, target, relation);
        self.edges.push(edge);
        EdgeId·new(id)
    }

    ☉ rite learn(&Δ self, fact: Fact) -> Vec<NodeId> {
        ≔ Δ created = Vec·new();

        // Get or create subject
        ≔ subject_type = fact.subject_type.unwrap_or(NodeType·Concept);
        ≔ subject_id = self.add_node(&fact.subject, subject_type);
        created.push(subject_id.clone());

        // Process claims
        ∀ claim ∈ &fact.claims {
            ≔ object_type = claim.object_type.clone().unwrap_or(NodeType·Concept);
            ≔ object_id = self.add_node(&claim.object, object_type);
            created.push(object_id.clone());

            self.add_edge(subject_id.clone(), object_id, claim.relation.clone());
        }

        // Update epistemic and confidence on subject
        ∀ node ∈ &Δ self.nodes {
            ⎇ node.id == subject_id {
                node.epistemic = fact.epistemic.clone();
                node.confidence = fact.confidence;
                ⊗;
            }
        }

        created
    }

    ☉ rite query(&self, text: &str, limit: usize) -> Vec<QueryResult> {
        ≔ query_lower = text.to_lowercase();
        ≔ query_words: Vec<&str> = query_lower.split_whitespace().collect();

        ≔ Δ scored: Vec<QueryResult> = Vec·new();

        ∀ node ∈ &self.nodes {
            ≔ relevance = self.compute_relevance(&query_words, node);
            ⎇ relevance > 0.0 {
                scored.push(QueryResult {
                    node_id: node.id.clone(),
                    node: node.clone(),
                    relevance,
                    confidence: node.confidence,
                });
            }
        }

        // Sort by relevance * confidence (bubble sort)
        ∀ i ∈ 0..scored.len() {
            ∀ j ∈ (i + 1)..scored.len() {
                ≔ score_i = scored[i].relevance * scored[i].confidence.max(0.1);
                ≔ score_j = scored[j].relevance * scored[j].confidence.max(0.1);
                ⎇ score_j > score_i {
                    ≔ temp = QueryResult {
                        node_id: scored[i].node_id.clone(),
                        node: scored[i].node.clone(),
                        relevance: scored[i].relevance,
                        confidence: scored[i].confidence,
                    };
                    scored[i] = QueryResult {
                        node_id: scored[j].node_id.clone(),
                        node: scored[j].node.clone(),
                        relevance: scored[j].relevance,
                        confidence: scored[j].confidence,
                    };
                    scored[j] = temp;
                }
            }
        }

        ≔ Δ result = Vec·new();
        ∀ i ∈ 0..limit.min(scored.len()) {
            result.push(QueryResult {
                node_id: scored[i].node_id.clone(),
                node: scored[i].node.clone(),
                relevance: scored[i].relevance,
                confidence: scored[i].confidence,
            });
        }
        result
    }

    ☉ rite neighbors(&self, node_id: &NodeId, relation: Option<Relation>) -> Vec<NodeId> {
        ≔ Δ result = Vec·new();
        ∀ edge ∈ &self.edges {
            ⎇ edge.source == *node_id {
                ≔ matches = ⌥ &relation {
                    Some(r) => edge.relation == *r,
                    None => true,
                };
                ⎇ matches {
                    result.push(edge.target.clone());
                }
            }
        }
        result
    }

    ☉ rite incoming_neighbors(&self, node_id: &NodeId, relation: Option<Relation>) -> Vec<NodeId> {
        ≔ Δ result = Vec·new();
        ∀ edge ∈ &self.edges {
            ⎇ edge.target == *node_id {
                ≔ matches = ⌥ &relation {
                    Some(r) => edge.relation == *r,
                    None => true,
                };
                ⎇ matches {
                    result.push(edge.source.clone());
                }
            }
        }
        result
    }

    ☉ rite traverse(&self, start: &NodeId, path: &GraphPath) -> Vec<NodeId> {
        ≔ Δ current = vec![start.clone()];

        ∀ step ∈ &path.steps {
            ≔ Δ next = Vec·new();

            ∀ node_id ∈ &current {
                ≔ neighbors = ⌥ step.direction {
                    Direction·Outgoing => self.neighbors(node_id, Some(step.relation.clone())),
                    Direction·Incoming => self.incoming_neighbors(node_id, Some(step.relation.clone())),
                    Direction·Both => {
                        ≔ Δ both = self.neighbors(node_id, Some(step.relation.clone()));
                        both.extend(self.incoming_neighbors(node_id, Some(step.relation.clone())));
                        both
                    }
                };
                next.extend(neighbors);
            }

            current = next;
        }

        current
    }

    rite compute_relevance(&self, query_words: &Vec<&str>, node: &Node) -> f64 {
        ≔ label_lower = node.label.to_lowercase();
        ≔ label_words: Vec<&str> = label_lower.split_whitespace().collect();

        // Exact match
        ∀ word ∈ query_words {
            ⎇ *word == label_lower {
                ⤺ 1.0;
            }
        }

        // Word overlap
        ≔ Δ matches = 0;
        ∀ qw ∈ query_words {
            ∀ lw ∈ &label_words {
                ⎇ *qw == *lw {
                    matches = matches + 1;
                    ⊗;
                }
            }
        }

        ⎇ matches > 0 {
            ⤺ matches as f64 / query_words.len().max(1) as f64;
        }

        // Substring match
        ∀ word ∈ query_words {
            ⎇ label_lower.contains(*word) {
                ⤺ 0.5;
            }
        }

        0.0
    }
}

// ============================================================================
// Tests: Node Construction
// ============================================================================

#[test]
rite test_node_creation() {
    ≔ node = Node·new(1, "Test Node", NodeType·Concept);
    assert_eq(node.label, "Test Node");
    assert_eq(node.access_count, 0);
}

#[test]
rite test_node_with_confidence() {
    ≔ node = Node·new(1, "Test", NodeType·Concept)
        .with_confidence(0.9);
    ≔ diff = (node.confidence - 0.9).abs();
    assert(diff < 0.001);
}

#[test]
rite test_node_with_epistemic() {
    ≔ node = Node·new(1, "Test", NodeType·Concept)
        .with_epistemic(Epistemic·Observed { observer: "agent".to_string() });

    ≔ strength = node.epistemic.strength();
    assert(strength > 0.8);
}

#[test]
rite test_node_aliases() {
    ≔ Δ node = Node·new(1, "United States", NodeType·Entity);
    node.add_alias("USA");
    node.add_alias("America");

    assert_eq(node.aliases.len(), 2);
}

// ============================================================================
// Tests: Edge Construction
// ============================================================================

#[test]
rite test_edge_creation() {
    ≔ source = NodeId·new(1);
    ≔ target = NodeId·new(2);
    ≔ edge = Edge·new(1, source, target, Relation·IsA);

    assert_eq(edge.source.0, 1);
    assert_eq(edge.target.0, 2);
}

#[test]
rite test_edge_relation() {
    ≔ edge = Edge·new(1, NodeId·new(1), NodeId·new(2), Relation·HasProperty);
    assert(edge.relation == Relation·HasProperty);
}

#[test]
rite test_custom_relation() {
    ≔ edge = Edge·new(1, NodeId·new(1), NodeId·new(2),
        Relation·Custom("worksAt".to_string()));

    ≔ is_custom = ⌥ edge.relation {
        Relation·Custom(s) => s == "worksAt",
        _ => false,
    };
    assert(is_custom);
}

// ============================================================================
// Tests: Fact Construction
// ============================================================================

#[test]
rite test_fact_creation() {
    ≔ fact = Fact·new("Python");
    assert_eq(fact.subject, "Python");
    assert_eq(fact.claims.len(), 0);
}

#[test]
rite test_fact_with_claim() {
    ≔ fact = Fact·new("Python")
        .claim(Relation·IsA, "Programming Language");

    assert_eq(fact.claims.len(), 1);
    assert_eq(fact.claims[0].object, "Programming Language");
}

#[test]
rite test_fact_multiple_claims() {
    ≔ fact = Fact·new("Python")
        .claim(Relation·IsA, "Programming Language")
        .claim(Relation·HasProperty, "Dynamic Typing")
        .claim(Relation·CreatedBy, "Guido van Rossum");

    assert_eq(fact.claims.len(), 3);
}

#[test]
rite test_fact_observed() {
    ≔ fact = Fact·new("Test").observed();

    ≔ is_observed = ⌥ fact.epistemic {
        Epistemic·Observed { .. } => true,
        _ => false,
    };
    assert(is_observed);
    assert(fact.confidence > 0.9);
}

#[test]
rite test_fact_reported() {
    ≔ fact = Fact·new("Test").reported("Wikipedia");

    ≔ source = ⌥ &fact.epistemic {
        Epistemic·Reported { source } => source.clone(),
        _ => "".to_string(),
    };
    assert_eq(source, "Wikipedia");
}

#[test]
rite test_fact_significance() {
    ≔ fact = Fact·new("Test").observed();
    ≔ sig = fact.significance();

    // Observed (0.9 strength) * high confidence (0.95) should be high
    assert(sig > 0.8);
}

// ============================================================================
// Tests: Semantic Memory Operations
// ============================================================================

#[test]
rite test_semantic_memory_creation() {
    ≔ memory = SemanticMemory·default_memory();
    assert_eq(memory.node_count(), 0);
    assert_eq(memory.edge_count(), 0);
}

#[test]
rite test_add_node() {
    ≔ Δ memory = SemanticMemory·default_memory();
    ≔ id = memory.add_node("Python", NodeType·Concept);

    assert_eq(memory.node_count(), 1);
}

#[test]
rite test_add_duplicate_node() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ id1 = memory.add_node("Python", NodeType·Concept);
    ≔ id2 = memory.add_node("Python", NodeType·Concept);

    // Should ⤺ same ID ∀ duplicate
    assert(id1 == id2);
    assert_eq(memory.node_count(), 1);
}

#[test]
rite test_add_edge() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ python = memory.add_node("Python", NodeType·Concept);
    ≔ lang = memory.add_node("Programming Language", NodeType·Category);
    memory.add_edge(python, lang, Relation·IsA);

    assert_eq(memory.edge_count(), 1);
}

#[test]
rite test_get_node_by_id() {
    ≔ Δ memory = SemanticMemory·default_memory();
    ≔ id = memory.add_node("Test", NodeType·Concept);

    ≔ node = memory.get_node(&id);
    assert(node.is_some());
    assert_eq(node.unwrap().label, "Test");
}

#[test]
rite test_get_node_by_label() {
    ≔ Δ memory = SemanticMemory·default_memory();
    memory.add_node("Python", NodeType·Concept);

    ≔ node = memory.get_node_by_label("Python");
    assert(node.is_some());
}

#[test]
rite test_get_nonexistent_node() {
    ≔ memory = SemanticMemory·default_memory();
    ≔ fake_id = NodeId·new(999);
    ≔ node = memory.get_node(&fake_id);
    assert(node.is_none());
}

// ============================================================================
// Tests: Learning Facts
// ============================================================================

#[test]
rite test_learn_simple_fact() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ fact = Fact·new("Python")
        .claim(Relation·IsA, "Language");

    ≔ created = memory.learn(fact);

    // Should create 2 nodes (subject + object)
    assert_eq(created.len(), 2);
    assert_eq(memory.node_count(), 2);
    assert_eq(memory.edge_count(), 1);
}

#[test]
rite test_learn_fact_with_multiple_claims() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ fact = Fact·new("Python")
        .claim(Relation·IsA, "Programming Language")
        .claim(Relation·HasProperty, "Dynamic Typing")
        .claim(Relation·HasProperty, "Interpreted");

    memory.learn(fact);

    // Python + 3 objects = 4 nodes
    assert_eq(memory.node_count(), 4);
    assert_eq(memory.edge_count(), 3);
}

#[test]
rite test_learn_updates_epistemic() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ fact = Fact·new("Python")
        .claim(Relation·IsA, "Language")
        .observed();

    memory.learn(fact);

    ≔ node = memory.get_node_by_label("Python").unwrap();
    assert(node.confidence > 0.9);
}

#[test]
rite test_learn_reuses_existing_nodes() {
    ≔ Δ memory = SemanticMemory·default_memory();

    // First fact
    memory.learn(Fact·new("Python")
        .claim(Relation·IsA, "Programming Language"));

    // Second fact with same object
    memory.learn(Fact·new("Rust")
        .claim(Relation·IsA, "Programming Language"));

    // Should reinvoke "Programming Language" node
    assert_eq(memory.node_count(), 3);  // Python, Rust, Programming Language
    assert_eq(memory.edge_count(), 2);
}

// ============================================================================
// Tests: Query
// ============================================================================

#[test]
rite test_query_exact_match() {
    ≔ Δ memory = SemanticMemory·default_memory();
    memory.add_node("Python", NodeType·Concept);
    memory.add_node("Java", NodeType·Concept);
    memory.add_node("Rust", NodeType·Concept);

    ≔ results = memory.query("Python", 5);

    assert(results.len() > 0);
    assert_eq(results[0].node.label, "Python");
}

#[test]
rite test_query_partial_match() {
    ≔ Δ memory = SemanticMemory·default_memory();
    memory.add_node("Python Programming", NodeType·Concept);
    memory.add_node("Java Development", NodeType·Concept);

    ≔ results = memory.query("Python", 5);

    assert(results.len() > 0);
}

#[test]
rite test_query_no_match() {
    ≔ Δ memory = SemanticMemory·default_memory();
    memory.add_node("Python", NodeType·Concept);
    memory.add_node("Java", NodeType·Concept);

    ≔ results = memory.query("Haskell", 5);

    assert_eq(results.len(), 0);
}

#[test]
rite test_query_respects_limit() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ∀ i ∈ 0..10 {
        memory.add_node(&format!("Concept {}", i), NodeType·Concept);
    }

    ≔ results = memory.query("Concept", 3);
    assert_eq(results.len(), 3);
}

#[test]
rite test_query_ranks_by_relevance_and_confidence() {
    ≔ Δ memory = SemanticMemory·default_memory();

    // Low confidence exact match
    ≔ id1 = memory.add_node("Python", NodeType·Concept);
    // High confidence partial match
    ≔ id2 = memory.add_node("Python Programming", NodeType·Concept);

    // Update confidences
    ∀ node ∈ &Δ memory.nodes {
        ⎇ node.id == id1 {
            node.confidence = 0.3;
        } ⎉ ⎇ node.id == id2 {
            node.confidence = 0.9;
        }
    }

    ≔ results = memory.query("Python", 5);
    // Should have results
    assert(results.len() >= 2);
}

// ============================================================================
// Tests: Graph Traversal
// ============================================================================

#[test]
rite test_neighbors_outgoing() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ python = memory.add_node("Python", NodeType·Concept);
    ≔ lang = memory.add_node("Language", NodeType·Category);
    ≔ dynamic = memory.add_node("Dynamic", NodeType·Attribute);

    memory.add_edge(python.clone(), lang.clone(), Relation·IsA);
    memory.add_edge(python.clone(), dynamic.clone(), Relation·HasProperty);

    ≔ neighbors = memory.neighbors(&python, None);
    assert_eq(neighbors.len(), 2);
}

#[test]
rite test_neighbors_filtered_by_relation() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ python = memory.add_node("Python", NodeType·Concept);
    ≔ lang = memory.add_node("Language", NodeType·Category);
    ≔ dynamic = memory.add_node("Dynamic", NodeType·Attribute);

    memory.add_edge(python.clone(), lang.clone(), Relation·IsA);
    memory.add_edge(python.clone(), dynamic.clone(), Relation·HasProperty);

    ≔ neighbors = memory.neighbors(&python, Some(Relation·IsA));
    assert_eq(neighbors.len(), 1);
}

#[test]
rite test_incoming_neighbors() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ python = memory.add_node("Python", NodeType·Concept);
    ≔ rust = memory.add_node("Rust", NodeType·Concept);
    ≔ lang = memory.add_node("Language", NodeType·Category);

    memory.add_edge(python.clone(), lang.clone(), Relation·IsA);
    memory.add_edge(rust.clone(), lang.clone(), Relation·IsA);

    ≔ incoming = memory.incoming_neighbors(&lang, None);
    assert_eq(incoming.len(), 2);
}

#[test]
rite test_traverse_single_hop() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ python = memory.add_node("Python", NodeType·Concept);
    ≔ lang = memory.add_node("Language", NodeType·Category);
    memory.add_edge(python.clone(), lang.clone(), Relation·IsA);

    ≔ path = GraphPath·new().follow(Relation·IsA);
    ≔ results = memory.traverse(&python, &path);

    assert_eq(results.len(), 1);
    assert(results[0] == lang);
}

#[test]
rite test_traverse_multi_hop() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ python = memory.add_node("Python", NodeType·Concept);
    ≔ lang = memory.add_node("Language", NodeType·Category);
    ≔ tool = memory.add_node("Tool", NodeType·Category);

    memory.add_edge(python.clone(), lang.clone(), Relation·IsA);
    memory.add_edge(lang.clone(), tool.clone(), Relation·IsA);

    ≔ path = GraphPath·new()
        .follow(Relation·IsA)
        .follow(Relation·IsA);

    ≔ results = memory.traverse(&python, &path);

    assert_eq(results.len(), 1);
    assert(results[0] == tool);
}

#[test]
rite test_traverse_no_path() {
    ≔ Δ memory = SemanticMemory·default_memory();

    ≔ python = memory.add_node("Python", NodeType·Concept);
    ≔ lang = memory.add_node("Language", NodeType·Category);
    memory.add_edge(python.clone(), lang.clone(), Relation·IsA);

    // Try to follow HasProperty, but we only have IsA
    ≔ path = GraphPath·new().follow(Relation·HasProperty);
    ≔ results = memory.traverse(&python, &path);

    assert_eq(results.len(), 0);
}

// ============================================================================
// Tests: Epistemic Types
// ============================================================================

#[test]
rite test_epistemic_strength_axiomatic() {
    ≔ ep = Epistemic·Axiomatic;
    ≔ strength = ep.strength();
    ≔ diff = (strength - 1.0).abs();
    assert(diff < 0.001);
}

#[test]
rite test_epistemic_strength_observed() {
    ≔ ep = Epistemic·Observed { observer: "self".to_string() };
    ≔ strength = ep.strength();
    assert(strength > 0.8);
}

#[test]
rite test_epistemic_strength_reported() {
    ≔ ep = Epistemic·Reported { source: "wiki".to_string() };
    ≔ strength = ep.strength();
    assert(strength > 0.5);
    assert(strength < 0.8);
}

#[test]
rite test_epistemic_strength_inferred() {
    ≔ ep = Epistemic·Inferred { basis: "reasoning".to_string() };
    ≔ strength = ep.strength();
    assert(strength >= 0.5);
}

#[test]
rite test_epistemic_strength_unknown() {
    ≔ ep = Epistemic·Unknown;
    ≔ strength = ep.strength();
    assert(strength < 0.2);
}

// ============================================================================
// Tests: GraphPath
// ============================================================================

#[test]
rite test_graph_path_empty() {
    ≔ path = GraphPath·new();
    assert_eq(path.steps.len(), 0);
}

#[test]
rite test_graph_path_single_step() {
    ≔ path = GraphPath·new().follow(Relation·IsA);
    assert_eq(path.steps.len(), 1);
}

#[test]
rite test_graph_path_multiple_steps() {
    ≔ path = GraphPath·new()
        .follow(Relation·IsA)
        .follow(Relation·PartOf)
        .follow_incoming(Relation·CreatedBy);

    assert_eq(path.steps.len(), 3);
}

rite main() {
    print("Engram semantic memory tests");
}
