// ============================================================================

#[test]
λ test_vector_config_default() {
    ≔ config = VectorConfig·default_config();
    assert_eq(config.dimensions, 384);
    assert_eq(config.m, 16);
    assert_eq(config.ef_construction, 200);
}

#[test]
λ test_vector_config_with_dimensions() {
    ≔ config = VectorConfig·default_config().with_dimensions(768);
    assert_eq(config.dimensions, 768);
}

// ============================================================================
// Tests: StorageConfig
// ============================================================================

#[test]
λ test_storage_config_default() {
    ≔ config = StorageConfig·default_config();
    ≔ is_file = ⌥ config.backend {
        StorageBackend·File { .. } => true,
        _ => false,
    };
    assert(is_file);
}

#[test]
λ test_storage_config_ephemeral() {
    ≔ config = StorageConfig·ephemeral();
    ≔ is_memory = ⌥ config.backend {
        StorageBackend·Memory => true,
        _ => false,
    };
    assert(is_memory);
}

// ============================================================================
// Tests: EmbeddingConfig
// ============================================================================

#[test]
λ test_embedding_config_default() {
    ≔ config = EmbeddingConfig·default_config();
    assert_eq(config.dimensions, 384);
    assert(config.normalize);
    assert_eq(config.batch_size, 32);
}

// ============================================================================
// Tests: ConsolidationConfig
// ============================================================================

#[test]
λ test_consolidation_config_default() {
    ≔ config = ConsolidationConfig·default_config();
    assert(config.enabled);
    assert(config.on_idle);
}

// ============================================================================
// Tests: EngramConfig
// ============================================================================

#[test]
λ test_engram_config_default() {
    ≔ config = EngramConfig·default_config();
    assert(config.agent_id.is_none());
    assert_eq(config.instant.capacity.0, 8000);
}

#[test]
λ test_engram_config_high_memory() {
    ≔ config = EngramConfig·high_memory();
    assert_eq(config.instant.capacity.0, 128000);
}

#[test]
λ test_engram_config_low_memory() {
    ≔ config = EngramConfig·low_memory();
    assert_eq(config.instant.capacity.0, 2000);
    assert_eq(config.episodic.max_active_episodes, 1000);

    ≔ is_aggressive = ⌥ config.instant.compression_strategy {
        CompressionStrategy·Aggressive => true,
        _ => false,
    };
    assert(is_aggressive);
}

#[test]
λ test_engram_config_ephemeral() {
    ≔ config = EngramConfig·ephemeral();
    ≔ is_memory = ⌥ config.storage.backend {
        StorageBackend·Memory => true,
        _ => false,
    };
    assert(is_memory);
}

// ============================================================================
// Tests: HotStoreConfig
// ============================================================================

#[test]
λ test_hot_store_config_default() {
    ≔ config = HotStoreConfig·default_config();
    assert_eq(config.capacity.bytes(), 256 * 1024 * 1024);
}

λ main() {
    print("Engram configuration tests");
}
