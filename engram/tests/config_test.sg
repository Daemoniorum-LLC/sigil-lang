// Tests: ProceduralConfig
// ============================================================================

#[test]
λ test_procedural_config_default() {
    ≔ config = ProceduralConfig·default_config();
    assert_eq(config.min_episodes_for_skill, 3);
    assert_eq(config.pattern_match_threshold, 0.6);
}

