//! Tests ∀ Engram Configuration System
//!
//! Verifies configuration types and defaults.

// ============================================================================
// Self-contained Test Types
// ============================================================================

☉ Σ TokenCount(☉ usize);

⊢ TokenCount {
    ☉ λ new(n: usize) -> Self { Self(n) }
}

☉ Σ ByteSize(☉ usize);

⊢ ByteSize {
    ☉ λ kb(n: usize) -> Self { ByteSize(n * 1024) }
    ☉ λ mb(n: usize) -> Self { ByteSize(n * 1024 * 1024) }
    ☉ λ gb(n: usize) -> Self { ByteSize(n * 1024 * 1024 * 1024) }

    ☉ λ bytes(&self) -> usize { self.0 }
}

☉ ᛈ CompressionStrategy {
    EvictLowest,
    Compress { target_ratio: f64 },
    SummarizeBatch { batch_size: usize, target_tokens: TokenCount },
    Aggressive,
}

☉ ᛈ TokenCounterType {
    Approximate,
    Tiktoken { model: String },
}

☉ Σ InstantConfig {
    ☉ capacity: TokenCount,
    ☉ decay_rate: f64,
    ☉ eviction_threshold: f64,
    ☉ compression_strategy: CompressionStrategy,
    ☉ token_counter: TokenCounterType,
}

⊢ InstantConfig {
    ☉ λ default_config() -> Self {
        Self {
            capacity: TokenCount(8000),
            decay_rate: 0.05,
            eviction_threshold: 0.1,
            compression_strategy: CompressionStrategy·EvictLowest,
            token_counter: TokenCounterType·Approximate,
        }
    }

    ☉ λ with_capacity(Δ self, cap: usize) -> Self {
        self.capacity = TokenCount(cap);
        self
    }

    ☉ λ with_decay_rate(Δ self, rate: f64) -> Self {
        self.decay_rate = rate;
        self
    }
}

☉ ᛈ DecayFunction {
    Exponential { lambda: f64 },
    Linear { rate: f64 },
    PowerLaw { alpha: f64 },
    None,
}

⊢ DecayFunction {
    ☉ λ apply(&self, strength: f64, elapsed_hours: f64) -> f64 {
        ⌥ self {
            DecayFunction·Exponential { lambda } => {
                // Approximate exp(-lambda * t)
                ≔ x = -lambda * elapsed_hours;
                ≔ Δ result = 1.0;
                ≔ Δ term = 1.0;
                ∀ i ∈ 1..10 {
                    term = term * x / i as f64;
                    result = result + term;
                }
                strength * result.max(0.0)
            },
            DecayFunction·Linear { rate } => {
                (strength - rate * elapsed_hours).max(0.0)
            },
            DecayFunction·PowerLaw { alpha } => {
                // (1 + t)^(-alpha)
                ≔ base = 1.0 + elapsed_hours;
                ≔ Δ result = 1.0;
                ∀ _ ∈ 0..(*alpha as usize) {
                    result = result / base;
                }
                strength * result
            },
            DecayFunction·None => strength,
        }
    }
}

☉ Σ EpisodicConfig {
    ☉ decay_function: DecayFunction,
    ☉ consolidation_threshold: f64,
    ☉ consolidation_interval_hours: f64,
    ☉ max_active_episodes: usize,
    ☉ min_significance_to_keep: f64,
}

⊢ EpisodicConfig {
    ☉ λ default_config() -> Self {
        Self {
            decay_function: DecayFunction·Exponential { lambda: 0.1 },
            consolidation_threshold: 0.3,
            consolidation_interval_hours: 6.0,
            max_active_episodes: 10000,
            min_significance_to_keep: 0.1,
        }
    }

    ☉ λ with_decay(Δ self, decay: DecayFunction) -> Self {
        self.decay_function = decay;
        self
    }
}

☉ ᛈ ConflictStrategy {
    TakeNewest,
    TakeHighestConfidence,
    MarkContested,
    Merge,
}

☉ Σ SemanticConfig {
    ☉ max_nodes: Option<usize>,
    ☉ max_edges_per_node: usize,
    ☉ belief_conflict_strategy: ConflictStrategy,
    ☉ auto_link_threshold: f64,
}

⊢ SemanticConfig {
    ☉ λ default_config() -> Self {
        Self {
            max_nodes: None,
            max_edges_per_node: 100,
            belief_conflict_strategy: ConflictStrategy·MarkContested,
            auto_link_threshold: 0.8,
        }
    }

    ☉ λ with_max_nodes(Δ self, max: usize) -> Self {
        self.max_nodes = Some(max);
        self
    }
}

☉ Σ ProceduralConfig {
    ☉ min_episodes_for_skill: usize,
    ☉ skill_success_threshold: f64,
    ☉ pattern_match_threshold: f64,
    ☉ max_skills: Option<usize>,
}

⊢ ProceduralConfig {
    ☉ λ default_config() -> Self {
        Self {
            min_episodes_for_skill: 3,
            skill_success_threshold: 0.5,
            pattern_match_threshold: 0.6,
            max_skills: None,
        }
    }
}

☉ ᛈ DistanceMetric {
    Cosine,
    Euclidean,
    DotProduct,
}

☉ Σ VectorConfig {
    ☉ dimensions: usize,
    ☉ m: usize,
    ☉ ef_construction: usize,
    ☉ ef_search: usize,
    ☉ metric: DistanceMetric,
}

⊢ VectorConfig {
    ☉ λ default_config() -> Self {
        Self {
            dimensions: 384,
            m: 16,
            ef_construction: 200,
            ef_search: 50,
            metric: DistanceMetric·Cosine,
        }
    }

    ☉ λ with_dimensions(Δ self, dim: usize) -> Self {
        self.dimensions = dim;
        self
    }
}

☉ ᛈ StorageBackend {
    Memory,
    File { path: String },
    SQLite { path: String },
    Redis { url: String },
}

☉ ᛈ EvictionPolicy {
    LRU,
    LFU,
    FIFO,
}

☉ Σ HotStoreConfig {
    ☉ capacity: ByteSize,
    ☉ eviction_policy: EvictionPolicy,
}

⊢ HotStoreConfig {
    ☉ λ default_config() -> Self {
        Self {
            capacity: ByteSize·mb(256),
            eviction_policy: EvictionPolicy·LRU,
        }
    }
}

☉ Σ StorageConfig {
    ☉ backend: StorageBackend,
    ☉ hot: HotStoreConfig,
}

⊢ StorageConfig {
    ☉ λ default_config() -> Self {
        Self {
            backend: StorageBackend·File { path: "./engram_data".to_string() },
            hot: HotStoreConfig·default_config(),
        }
    }

    ☉ λ ephemeral() -> Self {
        Self {
            backend: StorageBackend·Memory,
            hot: HotStoreConfig·default_config(),
        }
    }
}

☉ ᛈ EmbeddingModel {
    MiniLM_L6,
    BGE_Small,
    OpenAI { model: String },
    External { url: String, model: String },
}

☉ Σ EmbeddingConfig {
    ☉ model: EmbeddingModel,
    ☉ dimensions: usize,
    ☉ normalize: bool,
    ☉ batch_size: usize,
}

⊢ EmbeddingConfig {
    ☉ λ default_config() -> Self {
        Self {
            model: EmbeddingModel·MiniLM_L6,
            dimensions: 384,
            normalize: true,
            batch_size: 32,
        }
    }
}

☉ Σ ConsolidationConfig {
    ☉ enabled: bool,
    ☉ interval_hours: f64,
    ☉ on_idle: bool,
    ☉ max_duration_secs: u64,
}

⊢ ConsolidationConfig {
    ☉ λ default_config() -> Self {
        Self {
            enabled: true,
            interval_hours: 6.0,
            on_idle: true,
            max_duration_secs: 60,
        }
    }
}

☉ Σ EngramConfig {
    ☉ agent_id: Option<String>,
    ☉ instant: InstantConfig,
    ☉ episodic: EpisodicConfig,
    ☉ semantic: SemanticConfig,
    ☉ procedural: ProceduralConfig,
    ☉ vector: VectorConfig,
    ☉ storage: StorageConfig,
    ☉ embedding: EmbeddingConfig,
    ☉ consolidation: ConsolidationConfig,
}

⊢ EngramConfig {
    ☉ λ default_config() -> Self {
        Self {
            agent_id: None,
            instant: InstantConfig·default_config(),
            episodic: EpisodicConfig·default_config(),
            semantic: SemanticConfig·default_config(),
            procedural: ProceduralConfig·default_config(),
            vector: VectorConfig·default_config(),
            storage: StorageConfig·default_config(),
            embedding: EmbeddingConfig·default_config(),
            consolidation: ConsolidationConfig·default_config(),
        }
    }

    ☉ λ high_memory() -> Self {
        Self {
            instant: InstantConfig·default_config().with_capacity(128000),
            ..Self·default_config()
        }
    }

    ☉ λ low_memory() -> Self {
        Self {
            instant: InstantConfig {
                capacity: TokenCount(2000),
                compression_strategy: CompressionStrategy·Aggressive,
                ..InstantConfig·default_config()
            },
            episodic: EpisodicConfig {
                max_active_episodes: 1000,
                ..EpisodicConfig·default_config()
            },
            ..Self·default_config()
        }
    }

    ☉ λ ephemeral() -> Self {
        Self {
            storage: StorageConfig·ephemeral(),
            ..Self·default_config()
        }
    }
}

// ============================================================================
// Tests: ByteSize
// ============================================================================

#[test]
λ test_byte_size_kb() {
    ≔ size = ByteSize·kb(10);
    assert_eq(size.bytes(), 10240);
}

#[test]
λ test_byte_size_mb() {
    ≔ size = ByteSize·mb(1);
    assert_eq(size.bytes(), 1048576);
}

#[test]
λ test_byte_size_gb() {
    ≔ size = ByteSize·gb(1);
    assert_eq(size.bytes(), 1073741824);
}

// ============================================================================
// Tests: InstantConfig
// ============================================================================

#[test]
λ test_instant_config_default() {
    ≔ config = InstantConfig·default_config();
    assert_eq(config.capacity.0, 8000);
    assert_eq(config.eviction_threshold, 0.1);
}

#[test]
λ test_instant_config_with_capacity() {
    ≔ config = InstantConfig·default_config().with_capacity(16000);
    assert_eq(config.capacity.0, 16000);
}

#[test]
λ test_instant_config_with_decay_rate() {
    ≔ config = InstantConfig·default_config().with_decay_rate(0.1);
    assert_eq(config.decay_rate, 0.1);
}

// ============================================================================
// Tests: DecayFunction
// ============================================================================

#[test]
λ test_decay_exponential() {
    ≔ decay = DecayFunction·Exponential { lambda: 0.1 };
    ≔ result = decay.apply(1.0, 0.0);
    ≔ diff = (result - 1.0).abs();
    assert(diff < 0.01);
}

#[test]
λ test_decay_linear() {
    ≔ decay = DecayFunction·Linear { rate: 0.1 };
    ≔ result = decay.apply(1.0, 5.0);
    // 1.0 - 0.1 * 5 = 0.5
    ≔ diff = (result - 0.5).abs();
    assert(diff < 0.01);
}

#[test]
λ test_decay_linear_clamps_at_zero() {
    ≔ decay = DecayFunction·Linear { rate: 0.5 };
    ≔ result = decay.apply(1.0, 10.0);
    // Would be -4.0, but should clamp to 0
    assert_eq(result, 0.0);
}

#[test]
λ test_decay_none() {
    ≔ decay = DecayFunction·None;
    ≔ result = decay.apply(0.8, 100.0);
    assert_eq(result, 0.8);
}

// ============================================================================
// Tests: EpisodicConfig
// ============================================================================

#[test]
λ test_episodic_config_default() {
    ≔ config = EpisodicConfig·default_config();
    assert_eq(config.consolidation_threshold, 0.3);
    assert_eq(config.max_active_episodes, 10000);
}

#[test]
λ test_episodic_config_with_decay() {
    ≔ config = EpisodicConfig·default_config()
        .with_decay(DecayFunction·Linear { rate: 0.05 });

    ≔ is_linear = ⌥ config.decay_function {
        DecayFunction·Linear { .. } => true,
        _ => false,
    };
    assert(is_linear);
}

// ============================================================================
// Tests: SemanticConfig
// ============================================================================

#[test]
λ test_semantic_config_default() {
    ≔ config = SemanticConfig·default_config();
    assert(config.max_nodes.is_none());
    assert_eq(config.max_edges_per_node, 100);
}

#[test]
λ test_semantic_config_with_max_nodes() {
    ≔ config = SemanticConfig·default_config().with_max_nodes(5000);
    assert_eq(config.max_nodes.unwrap(), 5000);
}

