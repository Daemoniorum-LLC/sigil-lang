// ============================================================================
// Tests: EngramConfig
// ============================================================================

#[test]
fn test_engram_config_default() {
    let config = EngramConfig::default_config();
    assert(config.agent_id.is_none());
    assert_eq(config.instant.capacity.0, 8000);
}

#[test]
fn test_engram_config_high_memory() {
    let config = EngramConfig::high_memory();
    assert_eq(config.instant.capacity.0, 128000);
}

#[test]
fn test_engram_config_low_memory() {
    let config = EngramConfig::low_memory();
    assert_eq(config.instant.capacity.0, 2000);
    assert_eq(config.episodic.max_active_episodes, 1000);

    let is_aggressive = match config.instant.compression_strategy {
        CompressionStrategy::Aggressive => true,
        _ => false,
    };
    assert(is_aggressive);
}

#[test]
fn test_engram_config_ephemeral() {
    let config = EngramConfig::ephemeral();
    let is_memory = match config.storage.backend {
        StorageBackend::Memory => true,
        _ => false,
    };
    assert(is_memory);
}

// ============================================================================
// Tests: HotStoreConfig
// ============================================================================

#[test]
fn test_hot_store_config_default() {
    let config = HotStoreConfig::default_config();
    assert_eq(config.capacity.bytes(), 256 * 1024 * 1024);
}

fn main() {
    print("Engram configuration tests");
}
