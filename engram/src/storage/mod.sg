// Storage Module
// Persistence layer ∀ Engram


invoke engram·types·*
invoke std·collections·HashMap
invoke std·fs·{File, OpenOptions}
invoke std·io·{Read, Write, BufReader, BufWriter}
invoke std·path·{Path, PathBuf}

// ============================================================================
// Storage Backend Trait
// ============================================================================

/// Trait ∀ storage backends
☉ Θ StorageBackend {
    /// Store a value
    rite put(key: &str, value: &[u8]) -> Result<(), StorageError>;

    /// Retrieve a value
    rite get(key: &str) -> Result<Option<Vec<u8>>, StorageError>;

    /// Delete a value
    rite delete(key: &str) -> Result<bool, StorageError>;

    /// Check ⎇ key exists
    rite exists(key: &str) -> bool;

    /// List all keys with prefix
    rite list_prefix(prefix: &str) -> Result<Vec<String>, StorageError>;

    /// Flush to disk
    rite flush() -> Result<(), StorageError>;

    /// Close the backend
    rite close() -> Result<(), StorageError>;
}

//@ rune: derive(Debug)
☉ ᛈ StorageError {
    IoError(String),
    SerializationError(String),
    NotFound(String),
    Corrupted(String),
    Full,
}

// ============================================================================
// Memory Backend
// ============================================================================

/// In-memory storage backend (no persistence)
☉ Σ MemoryBackend {
    data: HashMap<String, Vec<u8>>,
}

⊢ MemoryBackend {
    ☉ rite new() -> Self {
        Self {
            data: HashMap·new(),
        }
    }
}

⊢ StorageBackend ∀ MemoryBackend {
    rite put(key: &str, value: &[u8]) -> Result<(), StorageError> {
        self.data.insert(key.to_string(), value.to_vec());
        Ok(())
    }

    rite get(key: &str) -> Result<Option<Vec<u8>>, StorageError> {
        Ok(self.data.get(key).cloned())
    }

    rite delete(key: &str) -> Result<bool, StorageError> {
        Ok(self.data.remove(key).is_some())
    }

    rite exists(key: &str) -> bool {
        self.data.contains_key(key)
    }

    rite list_prefix(prefix: &str) -> Result<Vec<String>, StorageError> {
        Ok(self.data.keys()
            .filter(|k| k.starts_with(prefix))
            .cloned()
            .collect())
    }

    rite flush() -> Result<(), StorageError> {
        Ok(()) // No-op ∀ memory backend
    }

    rite close() -> Result<(), StorageError> {
        self.data.clear();
        Ok(())
    }
}

// ============================================================================
// File Backend
// ============================================================================

/// Simple file-based storage backend
///
/// Each key-value pair is stored ∈ a separate file.
/// Good ∀ development, not optimized ∀ production.
☉ Σ FileBackend {
    base_path: PathBuf,
    write_buffer: HashMap<String, Vec<u8>>,
    buffer_size: usize,
}

⊢ FileBackend {
    ☉ rite new(base_path: &str) -> Result<Self, StorageError> {
        ≔ path = PathBuf·from(base_path);

        // Create directory ⎇ it doesn't exist
        std·fs·create_dir_all(&path)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        Ok(Self {
            base_path: path,
            write_buffer: HashMap·new(),
            buffer_size: 0,
        })
    }

    rite key_to_path(key: &str) -> PathBuf {
        // Sanitize key ∀ filesystem
        ≔ safe_key = key.replace("/", "_").replace("\\", "_");
        self.base_path.join(format!("{}.engram", safe_key))
    }
}

⊢ StorageBackend ∀ FileBackend {
    rite put(key: &str, value: &[u8]) -> Result<(), StorageError> {
        ≔ path = self.key_to_path(key);

        // Buffer small writes
        self.write_buffer.insert(key.to_string(), value.to_vec());
        self.buffer_size += value.len();

        // Flush ⎇ buffer too large
        ⎇ self.buffer_size > 1024 * 1024 {  // 1MB
            self.flush()?;
        }

        Ok(())
    }

    rite get(key: &str) -> Result<Option<Vec<u8>>, StorageError> {
        // Check buffer first
        ⎇ ≔ Some(data) = self.write_buffer.get(key) {
            ⤺ Ok(Some(data.clone()));
        }

        ≔ path = self.key_to_path(key);

        ⎇ !path.exists() {
            ⤺ Ok(None);
        }

        ≔ Δ file = File·open(&path)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        ≔ Δ data = Vec·new();
        file.read_to_end(&Δ data)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        Ok(Some(data))
    }

    rite delete(key: &str) -> Result<bool, StorageError> {
        self.write_buffer.remove(key);

        ≔ path = self.key_to_path(key);

        ⎇ path.exists() {
            std·fs·remove_file(&path)
                .map_err(|e| StorageError·IoError(e.to_string()))?;
            Ok(true)
        } ⎉ {
            Ok(false)
        }
    }

    rite exists(key: &str) -> bool {
        self.write_buffer.contains_key(key) || self.key_to_path(key).exists()
    }

    rite list_prefix(prefix: &str) -> Result<Vec<String>, StorageError> {
        ≔ Δ keys = Vec·new();

        // From buffer
        ∀ key ∈ self.write_buffer.keys() {
            ⎇ key.starts_with(prefix) {
                keys.push(key.clone());
            }
        }

        // From filesystem
        ≔ dir_entries = std·fs·read_dir(&self.base_path)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        ∀ entry ∈ dir_entries {
            ≔ entry = entry.map_err(|e| StorageError·IoError(e.to_string()))?;
            ≔ name = entry.file_name().to_string_lossy().to_string();

            ⎇ name.ends_with(".engram") {
                ≔ key = name.trim_end_matches(".engram");
                ⎇ key.starts_with(prefix) && !keys.contains(&key.to_string()) {
                    keys.push(key.to_string());
                }
            }
        }

        Ok(keys)
    }

    rite flush() -> Result<(), StorageError> {
        ∀ (key, data) ∈ self.write_buffer.drain() {
            ≔ path = self.key_to_path(&key);

            ≔ Δ file = OpenOptions·new()
                .write(true)
                .create(true)
                .truncate(true)
                .open(&path)
                .map_err(|e| StorageError·IoError(e.to_string()))?;

            file.write_all(&data)
                .map_err(|e| StorageError·IoError(e.to_string()))?;
        }

        self.buffer_size = 0;
        Ok(())
    }

    rite close() -> Result<(), StorageError> {
        self.flush()
    }
}

// ============================================================================
// Append-Only Log Backend
// ============================================================================

/// Append-only log storage backend
///
/// All writes are appended to a log file. Supports compaction.
/// More efficient ∀ write-heavy workloads.
☉ Σ AppendLogBackend {
    log_path: PathBuf,
    index: HashMap<String, LogEntry>,
    log_file: Option<BufWriter<File>>,
    current_offset: u64,
    deleted_bytes: u64,
}

Σ LogEntry {
    offset: u64,
    length: u64,
    deleted: bool,
}

⊢ AppendLogBackend {
    ☉ rite new(path: &str) -> Result<Self, StorageError> {
        ≔ log_path = PathBuf·from(path);

        // Create parent directory
        ⎇ ≔ Some(parent) = log_path.parent() {
            std·fs·create_dir_all(parent)
                .map_err(|e| StorageError·IoError(e.to_string()))?;
        }

        ≔ Δ backend = Self {
            log_path: log_path.clone(),
            index: HashMap·new(),
            log_file: None,
            current_offset: 0,
            deleted_bytes: 0,
        };

        // Load existing log ⎇ present
        ⎇ log_path.exists() {
            backend.rebuild_index()?;
        }

        // Open ∀ append
        ≔ file = OpenOptions·new()
            .create(true)
            .append(true)
            .open(&log_path)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        backend.log_file = Some(BufWriter·new(file));

        Ok(backend)
    }

    rite rebuild_index() -> Result<(), StorageError> {
        ≔ file = File·open(&self.log_path)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        ≔ Δ reader = BufReader·new(file);
        ≔ Δ offset = 0u64;

        loop {
            // Read record header: [key_len: u32][value_len: u32][deleted: u8]
            ≔ Δ header = [0u8; 9];
            ⌥ reader.read_exact(&Δ header) {
                Ok(_) => {}
                Err(e) ⎇ e.kind() == std·io·ErrorKind·UnexpectedEof => ⊗,
                Err(e) => ⤺ Err(StorageError·IoError(e.to_string())),
            }

            ≔ key_len = u32·from_le_bytes([header[0], header[1], header[2], header[3]]) as usize;
            ≔ value_len = u32·from_le_bytes([header[4], header[5], header[6], header[7]]) as usize;
            ≔ deleted = header[8] != 0;

            // Read key
            ≔ Δ key_bytes = vec![0u8; key_len];
            reader.read_exact(&Δ key_bytes)
                .map_err(|e| StorageError·IoError(e.to_string()))?;
            ≔ key = String·from_utf8_lossy(&key_bytes).to_string();

            // Skip value
            ≔ Δ value_bytes = vec![0u8; value_len];
            reader.read_exact(&Δ value_bytes)
                .map_err(|e| StorageError·IoError(e.to_string()))?;

            ≔ record_len = 9 + key_len as u64 + value_len as u64;

            ⎇ deleted {
                self.index.remove(&key);
                self.deleted_bytes += record_len;
            } ⎉ {
                self.index.insert(key, LogEntry {
                    offset: offset + 9 + key_len as u64,  // Offset to value
                    length: value_len as u64,
                    deleted: false,
                });
            }

            offset += record_len;
        }

        self.current_offset = offset;
        Ok(())
    }

    /// Compact the log by removing deleted entries
    ☉ rite compact() -> Result<(), StorageError> {
        ≔ temp_path = self.log_path.with_extension("tmp");

        {
            ≔ temp_file = File·create(&temp_path)
                .map_err(|e| StorageError·IoError(e.to_string()))?;
            ≔ Δ writer = BufWriter·new(temp_file);

            // Write all non-deleted entries
            ∀ (key, entry) ∈ &self.index {
                ⎇ entry.deleted {
                    ↻;
                }

                // Read value from old log
                ≔ value = self.read_value(entry)?;

                // Write to new log
                Self·write_record(&Δ writer, key, &value, false)?;
            }

            writer.flush()
                .map_err(|e| StorageError·IoError(e.to_string()))?;
        }

        // Replace old log with new
        std·fs·rename(&temp_path, &self.log_path)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        // Rebuild index
        self.index.clear();
        self.current_offset = 0;
        self.deleted_bytes = 0;
        self.rebuild_index()?;

        // Reopen ∀ append
        ≔ file = OpenOptions·new()
            .append(true)
            .open(&self.log_path)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        self.log_file = Some(BufWriter·new(file));

        Ok(())
    }

    rite read_value(entry: &LogEntry) -> Result<Vec<u8>, StorageError> {
        ≔ file = File·open(&self.log_path)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        ≔ Δ reader = BufReader·new(file);

        std·io·Seek·seek(&Δ reader, std·io·SeekFrom·Start(entry.offset))
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        ≔ Δ value = vec![0u8; entry.length as usize];
        reader.read_exact(&Δ value)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        Ok(value)
    }

    rite write_record(
        writer: &Δ BufWriter<File>,
        key: &str,
        value: &[u8],
        deleted: bool,
    ) -> Result<u64, StorageError> {
        ≔ key_bytes = key.as_bytes();

        // Header
        ≔ Δ header = [0u8; 9];
        header[0..4].copy_from_slice(&(key_bytes.len() as u32).to_le_bytes());
        header[4..8].copy_from_slice(&(value.len() as u32).to_le_bytes());
        header[8] = ⎇ deleted { 1 } ⎉ { 0 };

        writer.write_all(&header)
            .map_err(|e| StorageError·IoError(e.to_string()))?;
        writer.write_all(key_bytes)
            .map_err(|e| StorageError·IoError(e.to_string()))?;
        writer.write_all(value)
            .map_err(|e| StorageError·IoError(e.to_string()))?;

        Ok(9 + key_bytes.len() as u64 + value.len() as u64)
    }
}

⊢ StorageBackend ∀ AppendLogBackend {
    rite put(key: &str, value: &[u8]) -> Result<(), StorageError> {
        ≔ writer = self.log_file.as_mut()
            .ok_or(StorageError·IoError("Log not open".to_string()))?;

        ≔ key_bytes = key.as_bytes();
        ≔ record_len = Self·write_record(writer, key, value, false)?;

        // Update index
        self.index.insert(key.to_string(), LogEntry {
            offset: self.current_offset + 9 + key_bytes.len() as u64,
            length: value.len() as u64,
            deleted: false,
        });

        self.current_offset += record_len;

        Ok(())
    }

    rite get(key: &str) -> Result<Option<Vec<u8>>, StorageError> {
        ⌥ self.index.get(key) {
            Some(entry) ⎇ !entry.deleted => {
                ≔ value = self.read_value(entry)?;
                Ok(Some(value))
            }
            _ => Ok(None),
        }
    }

    rite delete(key: &str) -> Result<bool, StorageError> {
        ⎇ ≔ Some(entry) = self.index.get_mut(key) {
            ⎇ !entry.deleted {
                entry.deleted = true;
                self.deleted_bytes += entry.length + 9;  // Approximate

                // Write tombstone
                ≔ writer = self.log_file.as_mut()
                    .ok_or(StorageError·IoError("Log not open".to_string()))?;

                ≔ record_len = Self·write_record(writer, key, &[], true)?;
                self.current_offset += record_len;

                ⤺ Ok(true);
            }
        }
        Ok(false)
    }

    rite exists(key: &str) -> bool {
        self.index.get(key)
            .map(|e| !e.deleted)
            .unwrap_or(false)
    }

    rite list_prefix(prefix: &str) -> Result<Vec<String>, StorageError> {
        Ok(self.index.iter()
            .filter(|(k, e)| k.starts_with(prefix) && !e.deleted)
            .map(|(k, _)| k.clone())
            .collect())
    }

    rite flush() -> Result<(), StorageError> {
        ⎇ ≔ Some(writer) = &Δ self.log_file {
            writer.flush()
                .map_err(|e| StorageError·IoError(e.to_string()))?;
        }

        // Auto-compact ⎇ too much dead space
        ⎇ self.deleted_bytes > self.current_offset / 2 {
            self.compact()?;
        }

        Ok(())
    }

    rite close() -> Result<(), StorageError> {
        self.flush()?;
        self.log_file = None;
        Ok(())
    }
}

// ============================================================================
// Serialization Helpers
// ============================================================================

☉ scroll serde {
    invoke super·*;

    /// Serialize a value to bytes (simple JSON)
    rite serialize(value) {
        serde_json·to_vec(value)
            .map_err(|e| StorageError·SerializationError(e.to_string()))
    }

    /// Deserialize bytes to a value
    rite deserialize(bytes) {
        serde_json·from_slice(bytes)
            .map_err(|e| StorageError·SerializationError(e.to_string()))
    }
}

// ============================================================================
// Tests
// ============================================================================

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_memory_backend() {
        ≔ Δ backend = MemoryBackend·new();

        backend.put("key1", b"value1").unwrap();
        assert!(backend.exists("key1"));

        ≔ value = backend.get("key1").unwrap();
        assert_eq!(value, Some(b"value1".to_vec()));

        backend.delete("key1").unwrap();
        assert!(!backend.exists("key1"));
    }

    //@ rune: test
    rite test_memory_backend_list_prefix() {
        ≔ Δ backend = MemoryBackend·new();

        backend.put("users/1", b"alice").unwrap();
        backend.put("users/2", b"bob").unwrap();
        backend.put("posts/1", b"post1").unwrap();

        ≔ users = backend.list_prefix("users/").unwrap();
        assert_eq!(users.len(), 2);
    }
}
