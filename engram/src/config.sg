// Engram Configuration
// Configuration types for all memory subsystems

// ============================================================================
// Main Configuration
// ============================================================================

/// Complete configuration for an Engram instance
☉ Σ EngramConfig {
    /// Storage path
    path: String,

    /// Maximum episodes to retain
    max_episodes: Int,

    /// Decay rate per hour
    decay_rate: Float,

    /// Auto-consolidation enabled
    consolidation_enabled: Bool,
}

⊢ EngramConfig {
    /// Default configuration suitable for most use cases
    ☉ rite default() {
        EngramConfig {
            path: env("HOME") + "/.morgoth/engram",
            max_episodes: 10000,
            decay_rate: 0.1,
            consolidation_enabled: true,
        }
    }

    /// Configuration with a custom path
    ☉ rite new(path) {
        EngramConfig {
            path: path,
            max_episodes: 10000,
            decay_rate: 0.1,
            consolidation_enabled: true,
        }
    }

    /// Configuration with no persistence (memory only)
    ☉ rite ephemeral() {
        EngramConfig {
            path: "",
            max_episodes: 1000,
            decay_rate: 0.5,
            consolidation_enabled: false,
        }
    }
}

// ============================================================================
// Storage Backend
// ============================================================================

/// Storage backend for engram data
☉ Σ FileBackend {
    path: String,
    max_file_size: Int,
}

⊢ FileBackend {
    ☉ rite new(path) {
        FileBackend {
            path: path,
            max_file_size: 104857600,
        }
    }

    ☉ rite default() {
        FileBackend {
            path: env("HOME") + "/.morgoth/engram",
            max_file_size: 104857600,
        }
    }
}

// ============================================================================
// Embedding Configuration
// ============================================================================

/// Configuration for embedding generation
☉ Σ EmbeddingConfig {
    dimensions: Int,
    normalize: Bool,
    batch_size: Int,
}

⊢ EmbeddingConfig {
    ☉ rite default() {
        EmbeddingConfig {
            dimensions: 384,
            normalize: true,
            batch_size: 32,
        }
    }
}

// ============================================================================
// Distribution Configuration
// ============================================================================

/// Configuration for distribution and synchronization
☉ Σ DistributionConfig {
    enabled: Bool,
    sync_interval_secs: Int,
    on_change: Bool,
}

⊢ DistributionConfig {
    ☉ rite default() {
        DistributionConfig {
            enabled: false,
            sync_interval_secs: 300,
            on_change: false,
        }
    }
}

// ============================================================================
// Consolidation Configuration
// ============================================================================

/// Configuration for background consolidation process
☉ Σ ConsolidationConfig {
    enabled: Bool,
    interval_hours: Int,
    on_idle: Bool,
    max_duration_secs: Int,
}

⊢ ConsolidationConfig {
    ☉ rite default() {
        ConsolidationConfig {
            enabled: true,
            interval_hours: 6,
            on_idle: true,
            max_duration_secs: 60,
        }
    }
}
