// Procedural Memory Module
// Skill memory - how to do things


invoke engram·types·*
invoke engram·config·ProceduralConfig
invoke engram·episodic·Episode

// ============================================================================
// Procedural Memory
// ============================================================================

/// Procedural Memory - the agent's skill repository
///
/// Stores skills - patterns of action that have worked before.
/// Skills are learned from successful episodic experiences and
/// refined through ongoing feedback.
☉ Σ ProceduralMemory {
    /// Skills indexed by ID
    skills: HashMap<SkillId, Skill>,

    /// Pattern index ∀ fast matching
    patterns: Vec<(TriggerPattern, SkillId)>,

    /// Configuration
    config: ProceduralConfig,
}

⊢ ProceduralMemory {
    // ========================================================================
    // Construction
    // ========================================================================

    ☉ rite new(config: ProceduralConfig) -> EngramResult<Self>! {
        Ok(Self {
            skills: HashMap·new(),
            patterns: vec![],
            config,
        })
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    /// Learn a new skill from episodes
    ☉ rite learn_from_episodes(episodes: Vec<Episode>) -> Option<Skill> {
        // Need minimum episodes
        ⎇ episodes.len() < self.config.min_episodes_for_skill {
            ⤺ None
        }

        // Filter to successful episodes
        ≔ successful: Vec<_> = episodes.iter()
            .filter(|e| e.outcome.is_success())
            .collect()

        ⎇ successful.len() < self.config.min_episodes_for_skill {
            ⤺ None
        }

        // Extract common pattern
        ≔ trigger = self.extract_trigger_pattern(&successful)?

        // Extract procedure
        ≔ procedure = self.extract_procedure(&successful)?

        // Compute success rate
        ≔ success_rate = successful.len() as f64 / episodes.len() as f64

        ≔ skill = Skill {
            id: SkillId·new().unwrap(),
            name: self.generate_skill_name(&trigger, &procedure),
            description: self.generate_description(&successful),
            trigger: trigger.clone(),
            preconditions: vec![],
            procedure,
            stats: SkillStats {
                execution_count: episodes.len() as u32,
                success_count: successful.len() as u32,
                failure_count: (episodes.len() - successful.len()) as u32,
                success_rate,
                avg_duration: Duration·zero(),
            },
            refinements: vec![],
            failure_modes: vec![],
            source_episodes: episodes.iter().map(|e| e.id.clone()).collect(),
            created_at: Instant·now(),
            last_used: None,
            enabled: true,
        }

        // Register
        ≔ id = skill.id.clone()
        self.skills.insert(id.clone(), skill.clone())
        self.patterns.push((trigger, id))

        Some(skill)
    }

    /// Register a skill directly
    ☉ rite register(skill: Skill) -> SkillId {
        ≔ id = skill.id.clone()
        ≔ trigger = skill.trigger.clone()
        self.skills.insert(id.clone(), skill)
        self.patterns.push((trigger, id.clone()))
        id
    }

    /// Find skills matching the current situation
    ☉ rite match_situation(context: &Context) -> Vec<SkillMatch> {
        ≔ context_text = context.to_string().to_lowercase()

        ≔ Δ matches: Vec<_> = self.patterns.iter()
            .filter_map(|(pattern, skill_id)| {
                ≔ score = self.match_pattern(pattern, &context_text)
                ⎇ score >= self.config.pattern_match_threshold {
                    ≔ skill = self.skills.get(skill_id)?;
                    ⎇ !skill.enabled {
                        ⤺ None
                    }
                    Some(SkillMatch {
                        skill: skill.clone(),
                        match_score: score,
                        preconditions_met: true,  // Simplified
                        failed_preconditions: vec![],
                    })
                } ⎉ {
                    None
                }
            })
            .collect()

        // Sort by ⌥ score * success rate
        matches.sort_by(|a, b| {
            ≔ score_a = a.match_score * a.skill.stats.success_rate
            ≔ score_b = b.match_score * b.skill.stats.success_rate
            score_b.partial_cmp(&score_a).unwrap()
        })

        matches
    }

    /// Get a specific skill
    ☉ rite get(id: SkillId) -> Option<&Skill> {
        self.skills.get(&id)
    }

    /// Record feedback from skill execution
    ☉ rite feedback(skill_id: SkillId, episode: Episode) {
        ⎇ ≔ Some(skill) = self.skills.get_mut(&skill_id) {
            skill.stats.execution_count += 1
            skill.last_used = Some(Instant·now())

            ⌥ &episode.outcome {
                Outcome·Success { .. } => {
                    skill.stats.success_count += 1
                    // Exponential moving average
                    skill.stats.success_rate = skill.stats.success_rate * 0.9 + 0.1
                }
                Outcome·Failure { error, .. } => {
                    skill.stats.failure_count += 1
                    skill.stats.success_rate = skill.stats.success_rate * 0.9

                    // Record failure mode
                    skill.failure_modes.push(FailureMode {
                        trigger_context: episode.context.to_string(),
                        failure_type: error.clone(),
                        recovery: None,
                        occurrences: 1,
                    })
                }
                Outcome·Partial { .. } => {
                    skill.stats.success_rate = skill.stats.success_rate * 0.9 + 0.05
                }
                _ => {}
            }

            // Update average duration
            ⎇ ≔ Some(duration) = episode.duration() {
                ⎇ skill.stats.avg_duration == Duration·zero() {
                    skill.stats.avg_duration = duration
                } ⎉ {
                    skill.stats.avg_duration = Duration·from_secs_f64(
                        skill.stats.avg_duration.as_secs_f64() * 0.9
                        + duration.as_secs_f64() * 0.1
                    )
                }
            }
        }
    }

    /// Disable a skill
    ☉ rite disable(skill_id: SkillId) -> EngramResult<()>! {
        ⎇ ≔ Some(skill) = self.skills.get_mut(&skill_id) {
            skill.enabled = false
            Ok(())
        } ⎉ {
            Err(EngramError·NotFound {
                id: skill_id.to_string(),
                memory_type: "procedural".to_string(),
            })
        }
    }

    // ========================================================================
    // Usage Information
    // ========================================================================

    ☉ rite usage() -> MemorySystemUsage {
        MemorySystemUsage {
            item_count: self.skills.len(),
            bytes_used: self.skills.len() * std·mem·size_of·<Skill>(),
            capacity: self.config.max_skills,
        }
    }

    // ========================================================================
    // Internal Helpers
    // ========================================================================

    rite extract_trigger_pattern(episodes: &[&Episode]) -> Option<TriggerPattern> {
        // Extract common keywords from contexts
        ≔ Δ word_counts: HashMap<String, usize> = HashMap·new()

        ∀ episode ∈ episodes {
            ≔ text = episode.context.to_string().to_lowercase()
            ∀ word ∈ text.split_whitespace() {
                ⎇ word.len() > 3 {  // Skip short words
                    *word_counts.entry(word.to_string()).or_insert(0) += 1
                }
            }
        }

        // Keep words that appear ∈ majority of episodes
        ≔ threshold = episodes.len() / 2
        ≔ keywords: Vec<_> = word_counts.into_iter()
            .filter(|(_, count)| *count >= threshold)
            .map(|(word, count)| (word, count as f64 / episodes.len() as f64))
            .collect()

        ⎇ keywords.is_empty() {
            ⤺ None
        }

        Some(TriggerPattern {
            keywords: keywords.iter().map(|(w, _)| w.clone()).collect(),
            weights: keywords.iter().map(|(_, w)| *w).collect(),
            threshold: 0.5,
        })
    }

    rite extract_procedure(episodes: &[&Episode]) -> Option<Procedure> {
        // Extract common event sequences
        // Simplified: just invoke events from first episode as template
        ≔ first = episodes.first()?;

        ≔ steps: Vec<_> = first.events.iter()
            .filter(|e| matches!(e.event_type,
                EventType·ToolCall | EventType·Decision | EventType·AgentResponse
            ))
            .map(|e| ProcedureStep {
                description: format!("{:?}", e.event_type),
                action: Action·Custom {
                    name: format!("{:?}", e.event_type),
                    data: e.content.clone(),
                },
            })
            .collect()

        ⎇ steps.is_empty() {
            ⤺ None
        }

        Some(Procedure {
            steps,
            estimated_duration: first.duration(),
        })
    }

    rite match_pattern(pattern: &TriggerPattern, context: &str) -> f64 {
        ≔ Δ total_weight = 0.0
        ≔ Δ matched_weight = 0.0

        ∀ (keyword, weight) ∈ pattern.keywords.iter().zip(&pattern.weights) {
            total_weight += weight
            ⎇ context.contains(keyword) {
                matched_weight += weight
            }
        }

        ⎇ total_weight == 0.0 { 0.0 } ⎉ { matched_weight / total_weight }
    }

    rite generate_skill_name(trigger: &TriggerPattern, procedure: &Procedure) -> String {
        ≔ keywords = trigger.keywords.iter()
            .take(3)
            .cloned()
            .collect·<Vec<_>>()
            .join("_")

        format!("skill_{}", keywords)
    }

    rite generate_description(episodes: &[&Episode]) -> String {
        format!(
            "Skill learned from {} successful episodes",
            episodes.len()
        )
    }
}

// ============================================================================
// Supporting Types
// ============================================================================

/// A skill - a pattern of action
☉ Σ Skill {
    ☉ id: SkillId,
    ☉ name: String,
    ☉ description: String,

    /// When to apply this skill
    ☉ trigger: TriggerPattern,

    /// Conditions that must be met
    ☉ preconditions: Vec<Precondition>,

    /// What to do
    ☉ procedure: Procedure,

    /// Performance statistics
    ☉ stats: SkillStats,

    /// Learned adjustments
    ☉ refinements: Vec<Refinement>,

    /// Known ways this skill can fail
    ☉ failure_modes: Vec<FailureMode>,

    /// Episodes this skill was learned from
    ☉ source_episodes: Vec<EpisodeId>,

    ☉ created_at: Instant,
    ☉ last_used: Option<Instant>,
    ☉ enabled: bool,
}

/// Pattern that triggers a skill
☉ Σ TriggerPattern {
    ☉ keywords: Vec<String>,
    ☉ weights: Vec<f64>,
    ☉ threshold: f64,
}

/// A precondition ∀ skill execution
☉ Σ Precondition {
    ☉ description: String,
    ☉ required: bool,
}

/// A procedure - sequence of steps
☉ Σ Procedure {
    ☉ steps: Vec<ProcedureStep>,
    ☉ estimated_duration: Option<Duration>,
}

☉ Σ ProcedureStep {
    ☉ description: String,
    ☉ action: Action,
}

☉ ᛈ Action {
    CallTool { tool: String, args: Value },
    AskUser { question: String },
    Respond { template: String },
    Custom { name: String, data: Value },
}

/// Skill execution statistics
☉ Σ SkillStats {
    ☉ execution_count: u32,
    ☉ success_count: u32,
    ☉ failure_count: u32,
    ☉ success_rate: f64,
    ☉ avg_duration: Duration,
}

/// A refinement to a skill
☉ Σ Refinement {
    ☉ condition: String,
    ☉ modification: String,
    ☉ learned_from: EpisodeId,
}

/// A known failure mode
☉ Σ FailureMode {
    ☉ trigger_context: String,
    ☉ failure_type: String,
    ☉ recovery: Option<String>,
    ☉ occurrences: u32,
}

/// Result of matching skills to situation
☉ Σ SkillMatch {
    ☉ skill: Skill,
    ☉ match_score: f64,
    ☉ preconditions_met: bool,
    ☉ failed_preconditions: Vec<String>,
}
