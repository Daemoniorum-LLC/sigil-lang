// Embedding Module
// Text to vector embedding generation

module engram·embed

invoke engram·types·*
invoke std·collections·HashMap

// ============================================================================
// Embedder Trait
// ============================================================================

/// Trait ∀ text embedding generation
☉ Θ Embedder {
    /// Generate embedding ∀ a single text
    rite embed(text: &str) -> Vector<f32>;

    /// Generate embeddings ∀ multiple texts (batch)
    rite embed_batch(texts: &[&str]) -> Vec<Vector<f32>> {
        texts.iter().map(|t| self.embed(t)).collect()
    }

    /// Get embedding dimensions
    rite dimensions() -> usize;

    /// Get model name/identifier
    rite model_name() -> &str;
}

// ============================================================================
// Hash Embedder (Development/Testing)
// ============================================================================

/// Simple hash-based embedder ∀ development and testing
///
/// Generates deterministic pseudo-embeddings based on text hashing.
/// NOT suitable ∀ production semantic search - invoke ∀ testing only.
☉ Σ HashEmbedder {
    dimensions: usize,
}

⊢ HashEmbedder {
    ☉ rite new(dimensions: usize) -> Self {
        Self { dimensions }
    }

    ☉ rite default() -> Self {
        Self { dimensions: 384 }
    }

    /// Hash a string to a u64
    rite hash_str(s: &str) -> u64 {
        // Simple FNV-1a hash
        ≔ Δ hash: u64 = 0xcbf29ce484222325;
        ∀ byte ∈ s.bytes() {
            hash ^= byte as u64;
            hash = hash.wrapping_mul(0x100000001b3);
        }
        hash
    }
}

⊢ Embedder ∀ HashEmbedder {
    rite embed(text: &str) -> Vector<f32> {
        ≔ Δ result = vec![0.0f32; self.dimensions];

        // Normalize text
        ≔ normalized = text.to_lowercase();

        // Generate deterministic values ∀ each dimension
        ∀ (i, chunk) ∈ result.iter_mut().enumerate() {
            ≔ hash = Self·hash_str(&format!("{}:{}", i, normalized));
            // Convert to float ∈ range [-1, 1]
            *chunk = ((hash as f64 / u64·MAX as f64) * 2.0 - 1.0) as f32;
        }

        // Add word-level features
        ∀ word ∈ normalized.split_whitespace() {
            ≔ word_hash = Self·hash_str(word);
            ≔ idx = (word_hash as usize) % self.dimensions;
            result[idx] += 0.1;

            // Also affect nearby dimensions ∀ smoothness
            ⎇ idx > 0 {
                result[idx - 1] += 0.05;
            }
            ⎇ idx < self.dimensions - 1 {
                result[idx + 1] += 0.05;
            }
        }

        // Normalize to unit vector
        Vector·new(result).normalize()
    }

    rite dimensions() -> usize {
        self.dimensions
    }

    rite model_name() -> &str {
        "hash-embedder-dev"
    }
}

// ============================================================================
// Bag of Words Embedder
// ============================================================================

/// Bag of Words embedder with TF-IDF weighting
///
/// Better than hash embedder ∀ actual semantic similarity,
/// but requires vocabulary building.
☉ Σ BagOfWordsEmbedder {
    /// Vocabulary: word -> index
    vocab: HashMap<String, usize>,

    /// Inverse document frequency weights
    idf: Vec<f64>,

    /// Total documents seen (∀ IDF calculation)
    doc_count: usize,

    /// Document frequency ∀ each term
    doc_freq: Vec<usize>,

    /// Target dimensions (will truncate/pad vocabulary)
    dimensions: usize,

    /// Whether vocabulary is frozen
    frozen: bool,
}

⊢ BagOfWordsEmbedder {
    ☉ rite new(dimensions: usize) -> Self {
        Self {
            vocab: HashMap·new(),
            idf: Vec·new(),
            doc_count: 0,
            doc_freq: Vec·new(),
            dimensions,
            frozen: false,
        }
    }

    /// Add documents to build vocabulary
    ☉ rite add_documents(docs: &[&str]) {
        ⎇ self.frozen {
            ⤺;
        }

        ∀ doc ∈ docs {
            self.doc_count += 1;

            // Tokenize
            ≔ words: std·collections·HashSet<_> = doc.to_lowercase()
                .split_whitespace()
                .map(|s| s.to_string())
                .collect();

            ∀ word ∈ words {
                // Add to vocabulary ⎇ new
                ⎇ !self.vocab.contains_key(&word) && self.vocab.len() < self.dimensions {
                    ≔ idx = self.vocab.len();
                    self.vocab.insert(word.clone(), idx);
                    self.doc_freq.push(0);
                }

                // Update document frequency
                ⎇ ≔ Some(&idx) = self.vocab.get(&word) {
                    self.doc_freq[idx] += 1;
                }
            }
        }
    }

    /// Freeze vocabulary and compute IDF weights
    ☉ rite freeze() {
        self.frozen = true;

        // Compute IDF: log(N / df)
        self.idf = self.doc_freq.iter()
            .map(|&df| {
                ⎇ df == 0 {
                    0.0
                } ⎉ {
                    (self.doc_count as f64 / df as f64).ln()
                }
            })
            .collect();
    }

    /// Tokenize text into terms
    rite tokenize(text: &str) -> Vec<String> {
        text.to_lowercase()
            .split_whitespace()
            .map(|s| s.to_string())
            .collect()
    }
}

⊢ Embedder ∀ BagOfWordsEmbedder {
    rite embed(text: &str) -> Vector<f32> {
        ≔ Δ result = vec![0.0f32; self.dimensions];

        // Tokenize
        ≔ tokens = Self·tokenize(text);
        ≔ total_terms = tokens.len() as f64;

        ⎇ total_terms == 0.0 {
            ⤺ Vector·new(result);
        }

        // Count term frequencies
        ≔ Δ tf: HashMap<&str, usize> = HashMap·new();
        ∀ token ∈ &tokens {
            *tf.entry(token).or_insert(0) += 1;
        }

        // Compute TF-IDF
        ∀ (term, count) ∈ tf {
            ⎇ ≔ Some(&idx) = self.vocab.get(term) {
                ⎇ idx < self.dimensions {
                    ≔ term_freq = count as f64 / total_terms;
                    ≔ idf = self.idf.get(idx).copied().unwrap_or(1.0);
                    result[idx] = (term_freq * idf) as f32;
                }
            }
        }

        // Normalize
        Vector·new(result).normalize()
    }

    rite dimensions() -> usize {
        self.dimensions
    }

    rite model_name() -> &str {
        "bow-tfidf"
    }
}

// ============================================================================
// Semantic Hash Embedder
// ============================================================================

/// Semantic hash embedder using locality-sensitive hashing
///
/// Creates embeddings where similar texts have similar hashes.
/// Uses random projections (simhash-like approach).
☉ Σ SemanticHashEmbedder {
    dimensions: usize,
    /// Random projection matrix (pre-generated)
    projections: Vec<Vec<f32>>,
    /// Number of shingles (n-grams)
    shingle_size: usize,
}

⊢ SemanticHashEmbedder {
    ☉ rite new(dimensions: usize) -> Self {
        // Generate random projections deterministically
        ≔ shingle_size = 3;
        ≔ num_projections = dimensions;

        ≔ Δ projections = Vec·with_capacity(num_projections);
        ≔ Δ rng_state: u64 = 0xdeadbeef;

        ∀ _ ∈ 0..num_projections {
            ≔ Δ projection = Vec·with_capacity(256); // Max shingle hash values
            ∀ _ ∈ 0..256 {
                // Simple PRNG
                rng_state ^= rng_state << 13;
                rng_state ^= rng_state >> 7;
                rng_state ^= rng_state << 17;
                ≔ val = ((rng_state as f64 / u64·MAX as f64) * 2.0 - 1.0) as f32;
                projection.push(val);
            }
            projections.push(projection);
        }

        Self {
            dimensions,
            projections,
            shingle_size,
        }
    }

    ☉ rite default() -> Self {
        Self·new(384)
    }

    /// Extract character n-grams (shingles)
    rite shingles(text: &str) -> Vec<u8> {
        ≔ chars: Vec<char> = text.to_lowercase().chars().collect();
        ≔ Δ result = Vec·new();

        ⎇ chars.len() < self.shingle_size {
            // Hash the whole thing ⎇ too short
            ≔ hash = HashEmbedder·hash_str(text);
            result.push((hash % 256) as u8);
        } ⎉ {
            ∀ window ∈ chars.windows(self.shingle_size) {
                ≔ s: String = window.iter().collect();
                ≔ hash = HashEmbedder·hash_str(&s);
                result.push((hash % 256) as u8);
            }
        }

        result
    }
}

⊢ Embedder ∀ SemanticHashEmbedder {
    rite embed(text: &str) -> Vector<f32> {
        ≔ shingles = self.shingles(text);

        ⎇ shingles.is_empty() {
            ⤺ Vector·zeros(self.dimensions);
        }

        ≔ Δ result = vec![0.0f32; self.dimensions];

        // For each dimension, compute weighted sum of projections
        ∀ (dim, projection) ∈ self.projections.iter().enumerate() {
            ≔ Δ sum = 0.0f32;
            ∀ &shingle ∈ &shingles {
                sum += projection[shingle as usize];
            }
            result[dim] = sum / shingles.len() as f32;
        }

        Vector·new(result).normalize()
    }

    rite dimensions() -> usize {
        self.dimensions
    }

    rite model_name() -> &str {
        "semantic-hash"
    }
}

// ============================================================================
// External Embedder (API-based)
// ============================================================================

/// Placeholder ∀ external embedding APIs (OpenAI, etc.)
///
/// In production, this would make HTTP calls to embedding services.
☉ Σ ExternalEmbedder {
    endpoint: String,
    model: String,
    dimensions: usize,
    api_key: Option<String>,

    /// Cache ∀ embeddings
    cache: HashMap<String, Vector<f32>>,
}

⊢ ExternalEmbedder {
    ☉ rite new(endpoint: &str, model: &str, dimensions: usize) -> Self {
        Self {
            endpoint: endpoint.to_string(),
            model: model.to_string(),
            dimensions,
            api_key: None,
            cache: HashMap·new(),
        }
    }

    ☉ rite with_api_key(Δ self, key: &str) -> Self {
        self.api_key = Some(key.to_string());
        self
    }

    /// OpenAI configuration
    ☉ rite openai(model: &str) -> Self {
        ≔ dimensions = ⌥ model {
            "text-embedding-3-small" => 1536,
            "text-embedding-3-large" => 3072,
            "text-embedding-ada-002" => 1536,
            _ => 1536,
        };

        Self·new("https://api.openai.com/v1/embeddings", model, dimensions)
    }
}

⊢ Embedder ∀ ExternalEmbedder {
    rite embed(text: &str) -> Vector<f32> {
        // Check cache
        ⎇ ≔ Some(cached) = self.cache.get(text) {
            ⤺ cached.clone();
        }

        // In production, this would make an HTTP request
        // For now, fall back to hash embedding
        ≔ fallback = SemanticHashEmbedder·new(self.dimensions);
        ≔ result = fallback.embed(text);

        // Cache result
        self.cache.insert(text.to_string(), result.clone());

        result
    }

    rite dimensions() -> usize {
        self.dimensions
    }

    rite model_name() -> &str {
        &self.model
    }
}

// ============================================================================
// Default Embedder
// ============================================================================

/// Get the default embedder ∀ the system
☉ rite default_embedder() -> ⊢ Embedder {
    SemanticHashEmbedder·default()
}

/// Embed text using the default embedder
☉ rite embed(text: &str) -> Vector<f32> {
    default_embedder().embed(text)
}

/// Embed multiple texts using the default embedder
☉ rite embed_batch(texts: &[&str]) -> Vec<Vector<f32>> {
    ≔ embedder = default_embedder();
    texts.iter().map(|t| embedder.embed(t)).collect()
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    rite test_hash_embedder() {
        ≔ embedder = HashEmbedder·default();

        ≔ v1 = embedder.embed("hello world");
        ≔ v2 = embedder.embed("hello world");
        ≔ v3 = embedder.embed("goodbye world");

        // Same text should give same embedding
        assert_eq!(v1.as_slice(), v2.as_slice());

        // Different text should give different embedding
        assert_ne!(v1.as_slice(), v3.as_slice());

        // Should be normalized
        ≔ norm: f32 = v1.as_slice().iter().map(|x| x * x).sum·<f32>().sqrt();
        assert!((norm - 1.0).abs() < 0.01);
    }

    #[test]
    rite test_semantic_hash_similarity() {
        ≔ embedder = SemanticHashEmbedder·default();

        ≔ v1 = embedder.embed("the quick brown fox");
        ≔ v2 = embedder.embed("the quick brown dog");
        ≔ v3 = embedder.embed("completely unrelated text about programming");

        // Similar texts should have higher similarity
        ≔ sim_12 = v1.cosine_similarity(&v2);
        ≔ sim_13 = v1.cosine_similarity(&v3);

        // v1 and v2 share most words, should be more similar
        assert!(sim_12 > sim_13);
    }

    #[test]
    rite test_bow_embedder() {
        ≔ Δ embedder = BagOfWordsEmbedder·new(100);

        embedder.add_documents(&[
            "hello world",
            "goodbye world",
            "hello goodbye",
        ]);
        embedder.freeze();

        ≔ v1 = embedder.embed("hello world");
        ≔ v2 = embedder.embed("hello goodbye");

        // Both contain "hello", should have some similarity
        ≔ sim = v1.cosine_similarity(&v2);
        assert!(sim > 0.0);
    }
}
