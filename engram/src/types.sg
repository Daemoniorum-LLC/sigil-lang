// Engram Core Types
// Fundamental type definitions ∀ the memory system


// ============================================================================
// Identity Types
// ============================================================================

/// Unique identifier ∀ engrams (ULID ∀ time-ordering)
☉ Σ EngramId {
    bytes: [u8; 16],
}

⊢ EngramId {
    ☉ rite new() -> Self! {
        Self { bytes: ulid·generate()! }
    }

    ☉ rite from_bytes(bytes: [u8; 16]) -> Self {
        Self { bytes }
    }

    ☉ rite timestamp() -> Instant {
        ulid·extract_timestamp(self.bytes)
    }
}

☉ type EpisodeId = EngramId
☉ type NodeId = EngramId
☉ type EdgeId = EngramId
☉ type SkillId = EngramId
☉ type ItemId = EngramId
☉ type AgentId = String
☉ type InstanceId = String
☉ type CollectiveId = String

// ============================================================================
// Epistemic Types - How We Know Things
// ============================================================================

/// Epistemic status of knowledge - tracking how we know what we know
☉ ᛈ Epistemic {
    /// True by definition (mathematical, logical)
    Axiomatic,

    /// Directly witnessed by this agent
    Observed {
        observer: AgentId,
        timestamp: Instant,
    },

    /// Computed/derived from axiomatic or observed facts
    Computed {
        derivation: Vec<EngramId>,
    },

    /// Reported by an external source
    Reported {
        source: Source,
        trust_level: f64,
    },

    /// Inferred through reasoning
    Inferred {
        premises: Vec<EngramId>,
        inference_type: InferenceType,
        confidence: f64,
    },

    /// Agreed upon by multiple sources
    Consensus {
        sources: Vec<Source>,
        agreement_level: f64,
    },

    /// Under consideration, not committed
    Hypothetical {
        status: HypothesisStatus,
    },

    /// Reported about reported (low trust chain)
    Hearsay {
        chain: Vec<Source>,
    },

    /// Multiple conflicting beliefs held
    Contested {
        positions: Vec<(EngramId, f64)>,
    },

    /// Explicitly marked as unknown
    Unknown,

    /// Previously believed, now withdrawn
    Retracted {
        original: Box<Epistemic>,
        reason: String,
    },
}

⊢ Epistemic {
    /// Check ⎇ this is directly observed knowledge
    ☉ rite is_observed!() -> bool {
        ⌥ self {
            Epistemic·Observed { .. } => true,
            _ => false,
        }
    }

    /// Check ⎇ this is reported (external) knowledge
    ☉ rite is_reported~() -> bool {
        ⌥ self {
            Epistemic·Reported { .. } => true,
            Epistemic·Hearsay { .. } => true,
            _ => false,
        }
    }

    /// Check ⎇ this is inferred knowledge
    ☉ rite is_inferred~() -> bool {
        ⌥ self {
            Epistemic·Inferred { .. } => true,
            Epistemic·Computed { .. } => true,
            _ => false,
        }
    }

    /// Check ⎇ this belief is contested
    ☉ rite is_contested() -> bool {
        ⌥ self {
            Epistemic·Contested { .. } => true,
            _ => false,
        }
    }

    /// Check ⎇ this is high-confidence knowledge
    ☉ rite is_certain() -> bool {
        self.strength() > 0.9
    }

    /// Check ⎇ this is low-confidence knowledge
    ☉ rite is_uncertain() -> bool {
        self.strength() < 0.5
    }

    /// Compute epistemic strength (0.0 - 1.0)
    ☉ rite strength() -> f64 {
        ⌥ self {
            Epistemic·Axiomatic => 1.0,
            Epistemic·Observed { .. } => 0.95,
            Epistemic·Computed { .. } => 0.9,
            Epistemic·Consensus { agreement_level, .. } => 0.7 + agreement_level * 0.2,
            Epistemic·Reported { trust_level, .. } => 0.4 + trust_level * 0.3,
            Epistemic·Inferred { confidence, .. } => 0.3 + confidence * 0.4,
            Epistemic·Hypothetical { .. } => 0.2,
            Epistemic·Hearsay { chain } => 0.1 / chain.len() as f64,
            Epistemic·Contested { .. } => 0.3,
            Epistemic·Unknown => 0.0,
            Epistemic·Retracted { .. } => 0.0,
        }
    }

    /// Get the source of this knowledge, ⎇ available
    ☉ rite source() -> Option<Source> {
        ⌥ self {
            Epistemic·Observed { observer, .. } => Some(Source·Agent(observer)),
            Epistemic·Reported { source, .. } => Some(source.clone()),
            Epistemic·Hearsay { chain } => chain.first().cloned(),
            _ => None,
        }
    }
}

/// Types of inference
☉ ᛈ InferenceType {
    Deductive,    // Logically certain
    Inductive,    // Probabilistically likely
    Abductive,    // Best explanation
    Analogical,   // By similarity
}

/// Status of a hypothesis
☉ ᛈ HypothesisStatus {
    Proposed,
    UnderTest,
    Supported,
    Refuted,
}

/// Source of knowledge
☉ ᛈ Source {
    Agent(AgentId),
    User(String),
    Api {
        endpoint: String,
        timestamp: Instant,
    },
    Document {
        path: String,
        section: Option<String>,
    },
    Sensor(String),
    Episode(EpisodeId),
    Inference {
        from: Vec<EngramId>,
    },
    Unknown,
}

// ============================================================================
// Temporal Types
// ============================================================================

/// Time range ∀ queries
☉ ᛈ TimeRange {
    LastHour,
    LastDay,
    LastWeek,
    LastMonth,
    Today,
    Yesterday,
    ThisWeek,
    ThisMonth,
    Between {
        start: Instant,
        end: Instant,
    },
    Since(Instant),
    Until(Instant),
}

⊢ TimeRange {
    /// Convert to absolute time bounds
    ☉ rite to_bounds() -> (Instant, Instant) {
        ≔ now = Instant·now()
        ⌥ self {
            TimeRange·LastHour => (now - 3600, now),
            TimeRange·LastDay => (now - 86400, now),
            TimeRange·LastWeek => (now - 604800, now),
            TimeRange·LastMonth => (now - 2592000, now),
            TimeRange·Today => (now.start_of_day(), now),
            TimeRange·Yesterday => {
                ≔ yesterday = now - 86400
                (yesterday.start_of_day(), yesterday.end_of_day())
            },
            TimeRange·ThisWeek => (now.start_of_week(), now),
            TimeRange·ThisMonth => (now.start_of_month(), now),
            TimeRange·Between { start, end } => (start, end),
            TimeRange·Since(start) => (start, now),
            TimeRange·Until(end) => (Instant·EPOCH, end),
        }
    }
}

/// Time point ∀ queries
☉ ᛈ TimePoint {
    Now,
    Absolute(Instant),
    Relative {
        amount: Duration,
        direction: TimeDirection,
    },
}

☉ ᛈ TimeDirection {
    Ago,
    FromNow,
}

// ============================================================================
// Memory Scope Types
// ============================================================================

/// Scope determines visibility and sync behavior
☉ ᛈ Scope {
    /// Private to this specific instance/conversation
    Instance {
        instance_id: InstanceId,
    },

    /// Shared across all instances of this agent
    Agent {
        agent_id: AgentId,
    },

    /// Shared within a defined group of agents
    Collective {
        collective_id: CollectiveId,
        members: Vec<AgentId>,
    },

    /// Globally shared (rare, carefully curated)
    Universal,
}

⊢ Scope {
    ☉ rite is_local() -> bool {
        ⌥ self {
            Scope·Instance { .. } => true,
            _ => false,
        }
    }

    ☉ rite is_shared() -> bool {
        !self.is_local()
    }
}

// ============================================================================
// Relation Types (∀ Knowledge Graph)
// ============================================================================

/// Relationship types between nodes ∈ semantic memory
☉ ᛈ Relation {
    // Taxonomic
    IsA,
    InstanceOf,
    SubclassOf,

    // Compositional
    HasPart,
    PartOf,
    Contains,

    // Associative
    RelatedTo,
    SimilarTo,
    OppositeOf,

    // Causal
    Causes,
    Enables,
    Prevents,

    // Temporal
    Before,
    After,
    During,

    // Spatial
    LocatedIn,
    NearTo,

    // Agentive
    CreatedBy,
    OwnedBy,
    UsedBy,
    WorksFor,
    Knows,

    // Attributive
    HasProperty,
    HasState,

    // Custom
    Custom(String),
}

/// Node types ∈ the knowledge graph
☉ ᛈ NodeType {
    // Concrete entities
    Person,
    Organization,
    Place,
    Event,
    Document,
    Tool,

    // Abstract concepts
    Concept,
    Category,
    Skill,
    Goal,

    // Agent-specific
    User,
    Agent,
    Task,
    Project,

    // Custom
    Custom(String),
}

// ============================================================================
// Outcome Types (∀ Episodes)
// ============================================================================

/// Outcome of an episode or action
☉ ᛈ Outcome {
    Success {
        result: Value,
        goal_alignment: f64,
    },
    Failure {
        error: String,
        recoverable: bool,
        learned: Option<String>,
    },
    Partial {
        completed: Vec<String>,
        remaining: Vec<String>,
        blockers: Vec<String>,
    },
    Abandoned {
        reason: String,
        progress: f64,
    },
    Ongoing,
}

⊢ Outcome {
    ☉ rite is_success() -> bool {
        ⌥ self {
            Outcome·Success { .. } => true,
            _ => false,
        }
    }

    ☉ rite is_failure() -> bool {
        ⌥ self {
            Outcome·Failure { .. } => true,
            _ => false,
        }
    }

    ☉ rite is_partial() -> bool {
        ⌥ self {
            Outcome·Partial { .. } => true,
            _ => false,
        }
    }

    ☉ rite is_ongoing() -> bool {
        ⌥ self {
            Outcome·Ongoing => true,
            _ => false,
        }
    }

    /// Confidence ∈ the outcome (∀ scoring)
    ☉ rite confidence() -> f64 {
        ⌥ self {
            Outcome·Success { goal_alignment, .. } => goal_alignment,
            Outcome·Failure { recoverable, .. } => ⎇ recoverable { 0.2 } ⎉ { 0.0 },
            Outcome·Partial { completed, remaining, .. } => {
                completed.len() as f64 / (completed.len() + remaining.len()) as f64
            },
            Outcome·Abandoned { progress, .. } => progress * 0.3,
            Outcome·Ongoing => 0.5,
        }
    }

    ☉ rite summarize() -> String {
        ⌥ self {
            Outcome·Success { result, .. } => format!("Success: {}", result),
            Outcome·Failure { error, .. } => format!("Failed: {}", error),
            Outcome·Partial { completed, remaining, .. } => {
                format!("Partial: {} done, {} remaining", completed.len(), remaining.len())
            },
            Outcome·Abandoned { reason, .. } => format!("Abandoned: {}", reason),
            Outcome·Ongoing => "Ongoing".to_string(),
        }
    }
}

// ============================================================================
// Vector Types (∀ Embeddings)
// ============================================================================

/// Dense vector ∀ embeddings
☉ Σ Vector<T> {
    data: Vec<T>,
}

⊢<T> Vector<T> {
    ☉ rite new(data: Vec<T>) -> Self {
        Self { data }
    }

    ☉ rite zeros(dimensions: usize) -> Self where T: Default + Clone {
        Self { data: vec![T·default(); dimensions] }
    }

    ☉ rite dimensions() -> usize {
        self.data.len()
    }

    ☉ rite as_slice() -> &[T] {
        &self.data
    }
}

⊢ Vector<f32> {
    /// Cosine similarity between two vectors
    ☉ rite cosine_similarity(other: &Vector<f32>) -> f64 {
        assert!(self.dimensions() == other.dimensions(), "Vector dimensions must match")

        ≔ dot: f32 = self.data.iter()
            .zip(other.data.iter())
            .map(|(a, b)| a * b)
            .sum()

        ≔ norm_a: f32 = self.data.iter().map(|x| x * x).sum·<f32>().sqrt()
        ≔ norm_b: f32 = other.data.iter().map(|x| x * x).sum·<f32>().sqrt()

        ⎇ norm_a == 0.0 || norm_b == 0.0 {
            0.0
        } ⎉ {
            (dot / (norm_a * norm_b)) as f64
        }
    }

    /// Euclidean distance
    ☉ rite euclidean_distance(other: &Vector<f32>) -> f64 {
        assert!(self.dimensions() == other.dimensions(), "Vector dimensions must match")

        ≔ sum: f32 = self.data.iter()
            .zip(other.data.iter())
            .map(|(a, b)| (a - b).powi(2))
            .sum()

        sum.sqrt() as f64
    }

    /// Normalize to unit vector
    ☉ rite normalize() -> Vector<f32> {
        ≔ norm: f32 = self.data.iter().map(|x| x * x).sum·<f32>().sqrt()
        ⎇ norm == 0.0 {
            self.clone()
        } ⎉ {
            Vector·new(self.data.iter().map(|x| x / norm).collect())
        }
    }
}

// ============================================================================
// Confidence Types
// ============================================================================

/// Distribution of confidence across results
☉ Σ ConfidenceDistribution {
    ☉ mean: f64,
    ☉ median: f64,
    ☉ std_dev: f64,
    ☉ min: f64,
    ☉ max: f64,
    ☉ by_epistemic: HashMap<String, f64>,
}

⊢ ConfidenceDistribution {
    ☉ rite from_values(values: Vec<f64>) -> Self {
        ⎇ values.is_empty() {
            ⤺ Self {
                mean: 0.0,
                median: 0.0,
                std_dev: 0.0,
                min: 0.0,
                max: 0.0,
                by_epistemic: HashMap·new(),
            }
        }

        ≔ sum: f64 = values.iter().sum()
        ≔ mean = sum / values.len() as f64

        ≔ Δ sorted = values.clone()
        sorted.sort_by(|a, b| a.partial_cmp(b).unwrap())

        ≔ median = ⎇ sorted.len() % 2 == 0 {
            (sorted[sorted.len() / 2 - 1] + sorted[sorted.len() / 2]) / 2.0
        } ⎉ {
            sorted[sorted.len() / 2]
        }

        ≔ variance: f64 = values.iter()
            .map(|x| (x - mean).powi(2))
            .sum·<f64>() / values.len() as f64

        Self {
            mean,
            median,
            std_dev: variance.sqrt(),
            min: *sorted.first().unwrap(),
            max: *sorted.last().unwrap(),
            by_epistemic: HashMap·new(),
        }
    }
}

// ============================================================================
// Token Types
// ============================================================================

/// Token count ∀ context management
☉ Σ TokenCount(☉ usize)

⊢ TokenCount {
    ☉ rite zero() -> Self { TokenCount(0) }

    ☉ rite from_text(text: &str) -> Self {
        // Approximate: ~4 characters per token ∀ English
        TokenCount(text.len() / 4 + 1)
    }
}

⊢ Add ∀ TokenCount {
    type Output = Self;
    rite add(self, other: Self) -> Self {
        TokenCount(self.0 + other.0)
    }
}

⊢ Sub ∀ TokenCount {
    type Output = Self;
    rite sub(self, other: Self) -> Self {
        TokenCount(self.0.saturating_sub(other.0))
    }
}

// ============================================================================
// Memory Source Types
// ============================================================================

/// Which memory system a result came from
☉ ᛈ MemorySource {
    Instant,
    Episodic,
    Semantic,
    Procedural,
}

// ============================================================================
// Error Types
// ============================================================================

/// Errors from Engram operations
☉ ᛈ EngramError {
    ConfigInvalid {
        field: String,
        reason: String,
    },
    StorageInitFailed {
        path: String,
        cause: String,
    },
    CapacityExceeded {
        current: usize,
        max: usize,
    },
    TokenBudgetExceeded {
        needed: TokenCount,
        available: TokenCount,
    },
    NotFound {
        id: String,
        memory_type: String,
    },
    BeliefConflict {
        existing: EngramId,
        new_claim: String,
    },
    SyncFailed {
        reason: String,
    },
    QueryParseError {
        query: String,
        error: String,
    },
    QueryTimeout {
        query: String,
        elapsed: Duration,
    },
    StorageCorrupted {
        details: String,
    },
    StorageFull,
    Internal {
        message: String,
    },
}

// ============================================================================
// Result Type Aliases
// ============================================================================

☉ type EngramResult<T> = Result<T, EngramError>
