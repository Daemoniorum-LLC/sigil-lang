// Engram - Main Entry Point
// Memory Infrastructure ∀ Artificial Minds


invoke engram·types·*
invoke engram·instant·InstantMemory
invoke engram·episodic·EpisodicMemory
invoke engram·semantic·SemanticMemory
invoke engram·procedural·ProceduralMemory
invoke engram·config·EngramConfig
invoke engram·query·{Query, RecallResult}

// ============================================================================
// Main Engram Structure
// ============================================================================

/// Engram - The primary interface ∀ AI agent memory
///
/// Provides unified access to four memory systems:
/// - Instant: Working memory (current context)
/// - Episodic: Experience memory (what happened)
/// - Semantic: Knowledge memory (what we know)
/// - Procedural: Skill memory (how to do things)
☉ Σ Engram {
    // Memory systems
    instant: InstantMemory,
    episodic: EpisodicMemory,
    semantic: SemanticMemory,
    procedural: ProceduralMemory,

    // Configuration
    config: EngramConfig,

    // Identity
    agent_id: AgentId,
    instance_id: InstanceId,

    // Statistics
    stats: EngramStats,

    // Event handlers
    event_handlers: Vec<rite(EngramEvent)>,
}

⊢ Engram {
    // ========================================================================
    // Construction
    // ========================================================================

    /// Create a new Engram instance with the specified configuration
    ☉ rite new(config: EngramConfig) -> EngramResult<Self>! {
        ≔ agent_id = config.agent_id.clone()
            .unwrap_or_else(|| generate_agent_id())

        ≔ instance_id = generate_instance_id()

        ≔ instant = InstantMemory·new(config.instant.clone())?
        ≔ episodic = EpisodicMemory·new(config.episodic.clone())?
        ≔ semantic = SemanticMemory·new(config.semantic.clone())?
        ≔ procedural = ProceduralMemory·new(config.procedural.clone())?

        Ok(Self {
            instant,
            episodic,
            semantic,
            procedural,
            config,
            agent_id,
            instance_id,
            stats: EngramStats·new(),
            event_handlers: vec![],
        })
    }

    /// Create with default configuration
    ☉ rite default() -> EngramResult<Self>! {
        Self·new(EngramConfig·default())
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    /// Primary recall interface - searches across all memory systems
    ///
    /// Returns results with uncertainty metadata, ranked by relevance.
    /// Automatically identifies gaps ∈ knowledge.
    ☉ rite recall(query: ⊢ Into<Query>) -> RecallResult~ {
        ≔ query = query.into()
        ≔ start = Instant·now()

        // Search each memory system
        ≔ instant_results = self.instant.search(&query)
        ≔ episodic_results = self.episodic.recall_similar(&query.context(), query.limit())
        ≔ semantic_results = self.semantic.query(&query.text(), query.limit())
        ≔ skill_matches = self.procedural.match_situation(&query.context())

        // Merge and rank results
        ≔ memories = self.merge_results(
            instant_results,
            episodic_results,
            semantic_results,
        )

        // Compute confidence distribution
        ≔ confidence = ConfidenceDistribution·from_values(
            memories.iter().map(|m| m.confidence).collect()
        )

        // Identify gaps
        ≔ gaps = self.identify_gaps(&query, &memories)

        // Update statistics
        self.stats.recall_count += 1
        self.stats.total_recall_time += start.elapsed()

        RecallResult {
            memories,
            total_found: memories.len(),
            returned: memories.len().min(query.limit()),
            confidence,
            gaps,
            skills: skill_matches,
            query_metadata: QueryMetadata {
                query: query.clone(),
                duration: start.elapsed(),
                sources_searched: vec![
                    MemorySource·Instant,
                    MemorySource·Episodic,
                    MemorySource·Semantic,
                ],
            },
        }
    }

    /// Add knowledge to semantic memory
    ☉ rite learn(fact: Fact) -> EngramResult<Vec<EngramId>>! {
        ≔ ids = self.semantic.learn(fact.clone())?

        // Bring into instant memory ⎇ significant
        ⎇ fact.significance() > 0.5 {
            self.instant.attend(
                Content·Structured(fact.to_value()),
                relevance: fact.significance(),
            )?
        }

        // Emit event
        self.emit(EngramEvent·EngramCreated {
            ids: ids.clone(),
            source: MemorySource·Semantic,
        })

        self.stats.facts_learned += 1
        Ok(ids)
    }

    /// Record an experience to episodic memory
    ☉ rite experience(episode: Episode) -> EngramResult<EpisodeId>! {
        ≔ id = self.episodic.record(episode.clone())?

        // Bring summary into instant memory
        self.instant.attend(
            Content·Text(episode.summarize()),
            relevance: episode.significance,
        )?

        // Check ⎇ this episode suggests a skill
        self.maybe_extract_skill(&episode)

        // Emit event
        self.emit(EngramEvent·EpisodeCompleted {
            id: id.clone(),
            outcome: episode.outcome.clone(),
        })

        self.stats.episodes_recorded += 1
        Ok(id)
    }

    /// Bring something into instant (working) memory
    ☉ rite attend(content: ⊢ Into<Content>, relevance: f64) -> EngramResult<ItemId>! {
        self.instant.attend(content.into(), relevance)
    }

    /// Find applicable skills ∀ the current situation
    ☉ rite match_skills(context: &Context) -> Vec<SkillMatch> {
        self.procedural.match_situation(context)
    }

    // ========================================================================
    // Context Building
    // ========================================================================

    /// Build a context export suitable ∀ LLM consumption
    ☉ rite build_context(config: ContextConfig) -> ExportedContext {
        ≔ Δ items = vec![]
        ≔ Δ used_tokens = TokenCount·zero()

        // Add instant memory first (highest priority)
        ⎇ config.include.contains(&ContextSource·Instant) {
            ∀ item ∈ self.instant.active() {
                ⎇ used_tokens + item.tokens <= config.budget {
                    items.push(ContextItem {
                        content: item.content.to_string(),
                        relevance: item.current_priority,
                        source: MemorySource·Instant,
                        tokens: item.tokens,
                    })
                    used_tokens = used_tokens + item.tokens
                }
            }
        }

        // Add relevant semantic knowledge
        ⎇ config.include.contains(&ContextSource·SemanticRelevant) {
            ⎇ ≔ Some(task) = &config.for_task {
                ≔ results = self.semantic.query(task, limit: 20)
                ∀ result ∈ results {
                    ≔ tokens = TokenCount·from_text(&result.node.to_string())
                    ⎇ used_tokens + tokens <= config.budget {
                        items.push(ContextItem {
                            content: result.node.to_string(),
                            relevance: result.relevance,
                            source: MemorySource·Semantic,
                            tokens,
                        })
                        used_tokens = used_tokens + tokens
                    }
                }
            }
        }

        // Add recent episodes
        ⎇ config.include.contains(&ContextSource·EpisodicRecent) {
            ≔ episodes = self.episodic.recall_at(Instant·now(), 3600)
            ∀ episode ∈ episodes.take(5) {
                ≔ summary = episode.summarize()
                ≔ tokens = TokenCount·from_text(&summary)
                ⎇ used_tokens + tokens <= config.budget {
                    items.push(ContextItem {
                        content: summary,
                        relevance: episode.significance,
                        source: MemorySource·Episodic,
                        tokens,
                    })
                    used_tokens = used_tokens + tokens
                }
            }
        }

        // Sort by relevance and format
        items.sort_by(|a, b| b.relevance.partial_cmp(&a.relevance).unwrap())

        ExportedContext {
            items,
            total_tokens: used_tokens,
            format: config.format,
        }
    }

    // ========================================================================
    // Lifecycle Operations
    // ========================================================================

    /// Trigger memory consolidation
    ☉ rite consolidate() -> ConsolidationReport {
        ≔ start = Instant·now()

        // Decay episodic memories
        self.episodic.decay()

        // Consolidate episodes to semantic/procedural
        ≔ episodic_report = self.episodic.consolidate()

        // Update stats
        self.stats.last_consolidation = Some(Instant·now())
        self.stats.consolidation_count += 1

        // Emit event
        self.emit(EngramEvent·ConsolidationCompleted {
            duration: start.elapsed(),
            episodes_consolidated: episodic_report.consolidated_count,
            skills_learned: episodic_report.skills_learned.len(),
            facts_extracted: episodic_report.facts_extracted.len(),
        })

        ConsolidationReport {
            duration: start.elapsed(),
            episodic: episodic_report,
        }
    }

    /// Archive memories matching predicate to cold storage
    ☉ rite archive(predicate: rite(&Memory) -> bool) -> ArchiveReport {
        ≔ Δ archived_count = 0

        // Archive from episodic
        archived_count += self.episodic.archive(predicate)

        // Archive from semantic
        archived_count += self.semantic.archive(predicate)

        ArchiveReport {
            archived_count,
            timestamp: Instant·now(),
        }
    }

    /// Synchronize with remote memory stores
    ☉ rite sync(config: SyncConfig) -> EngramResult<SyncReport> {
        self.emit(EngramEvent·SyncStarted {
            scope: config.scope.clone(),
        })

        // Perform sync based on strategy
        ≔ report = ⌥ config.strategy {
            SyncStrategy·CRDT => self.sync_crdt(config)?,
            SyncStrategy·Consensus => self.sync_consensus(config)?,
            SyncStrategy·Manual => {
                ⤺ Err(EngramError·SyncFailed {
                    reason: "Manual sync requires explicit operations".to_string(),
                })
            }
        };

        self.emit(EngramEvent·SyncCompleted {
            report: report.clone(),
        })

        Ok(report)
    }

    // ========================================================================
    // Direct Access
    // ========================================================================

    /// Direct access to instant memory
    ☉ rite instant() -> &InstantMemory {
        &self.instant
    }

    /// Direct access to instant memory (mutable)
    ☉ rite instant_mut() -> &Δ InstantMemory {
        &Δ self.instant
    }

    /// Direct access to episodic memory
    ☉ rite episodic() -> &EpisodicMemory {
        &self.episodic
    }

    /// Direct access to episodic memory (mutable)
    ☉ rite episodic_mut() -> &Δ EpisodicMemory {
        &Δ self.episodic
    }

    /// Direct access to semantic memory
    ☉ rite semantic() -> &SemanticMemory {
        &self.semantic
    }

    /// Direct access to semantic memory (mutable)
    ☉ rite semantic_mut() -> &Δ SemanticMemory {
        &Δ self.semantic
    }

    /// Direct access to procedural memory
    ☉ rite procedural() -> &ProceduralMemory {
        &self.procedural
    }

    /// Direct access to procedural memory (mutable)
    ☉ rite procedural_mut() -> &Δ ProceduralMemory {
        &Δ self.procedural
    }

    // ========================================================================
    // Events
    // ========================================================================

    /// Subscribe to engram events
    ☉ rite on_event(handler: rite(EngramEvent)) {
        self.event_handlers.push(handler)
    }

    rite emit(event: EngramEvent) {
        ∀ handler ∈ &self.event_handlers {
            handler(event.clone())
        }
    }

    // ========================================================================
    // Statistics
    // ========================================================================

    /// Get current statistics
    ☉ rite stats() -> &EngramStats {
        &self.stats
    }

    /// Get memory usage information
    ☉ rite memory_usage() -> MemoryUsage {
        MemoryUsage {
            instant: self.instant.usage(),
            episodic: self.episodic.usage(),
            semantic: self.semantic.usage(),
            procedural: self.procedural.usage(),
        }
    }

    // ========================================================================
    // Internal Helpers
    // ========================================================================

    rite merge_results(
        instant: Vec<Memory>,
        episodic: Vec<Memory>,
        semantic: Vec<Memory>,
    ) -> Vec<Memory> {
        ≔ Δ all = vec![]

        all.extend(instant)
        all.extend(episodic)
        all.extend(semantic)

        // Sort by combined score
        all.sort_by(|a, b| {
            ≔ score_a = a.relevance * a.confidence
            ≔ score_b = b.relevance * b.confidence
            score_b.partial_cmp(&score_a).unwrap()
        })

        // Deduplicate
        ≔ Δ seen = HashSet·new()
        all.retain(|m| seen.insert(m.id.clone()))

        all
    }

    rite identify_gaps(query: &Query, results: &[Memory]) -> Vec<Gap> {
        ≔ Δ gaps = vec![]

        // Check overall confidence
        ≔ avg_confidence = ⎇ results.is_empty() {
            0.0
        } ⎉ {
            results.iter().map(|m| m.confidence).sum·<f64>() / results.len() as f64
        }

        ⎇ avg_confidence < 0.5 {
            gaps.push(Gap {
                description: "Low overall confidence ∈ results".to_string(),
                query_aspect: "general".to_string(),
                severity: 1.0 - avg_confidence,
                suggested_actions: vec![
                    SuggestedAction·AskUser {
                        question: "Can you provide more context?".to_string(),
                    },
                ],
            })
        }

        // Check ⎇ results are too few
        ⎇ results.len() < 3 && !query.text().is_empty() {
            gaps.push(Gap {
                description: "Limited information found".to_string(),
                query_aspect: query.text(),
                severity: 0.7,
                suggested_actions: vec![
                    SuggestedAction·SearchExternal {
                        query: query.text(),
                    },
                ],
            })
        }

        // Check ∀ contested beliefs
        ≔ contested = results.iter()
            .filter(|m| m.epistemic.is_contested())
            .count()

        ⎇ contested > 0 {
            gaps.push(Gap {
                description: format!("{} contested beliefs ∈ results", contested),
                query_aspect: "reliability".to_string(),
                severity: 0.5,
                suggested_actions: vec![
                    SuggestedAction·AskUser {
                        question: "There are conflicting sources. Which do you trust?".to_string(),
                    },
                ],
            })
        }

        gaps
    }

    rite maybe_extract_skill(episode: &Episode) {
        // Only extract from successful episodes
        ⎇ !episode.outcome.is_success() {
            return
        }

        // Find similar past episodes
        ≔ similar = self.episodic.recall_similar(&episode.context, limit: 10)
            |φ{_.outcome.is_success()}

        // Need at least 3 similar successful episodes
        ⎇ similar.len() >= 3 {
            ⎇ ≔ Some(skill) = self.procedural.learn_from_episodes(similar) {
                self.emit(EngramEvent·SkillLearned {
                    id: skill.id.clone(),
                    from_episodes: similar.iter().map(|e| e.id.clone()).collect(),
                })
            }
        }
    }

    rite sync_crdt(config: SyncConfig) -> EngramResult<SyncReport> {
        // CRDT-based sync implementation
        // TODO: Implement full CRDT sync
        Ok(SyncReport {
            strategy: SyncStrategy·CRDT,
            scope: config.scope,
            engrams_synced: 0,
            conflicts_resolved: 0,
            duration: Duration·zero(),
        })
    }

    rite sync_consensus(config: SyncConfig) -> EngramResult<SyncReport> {
        // Consensus-based sync implementation
        // TODO: Implement consensus sync
        Ok(SyncReport {
            strategy: SyncStrategy·Consensus,
            scope: config.scope,
            engrams_synced: 0,
            conflicts_resolved: 0,
            duration: Duration·zero(),
        })
    }
}

// ============================================================================
// Supporting Types
// ============================================================================

/// Statistics about Engram usage
☉ Σ EngramStats {
    ☉ recall_count: u64,
    ☉ total_recall_time: Duration,
    ☉ facts_learned: u64,
    ☉ episodes_recorded: u64,
    ☉ consolidation_count: u64,
    ☉ last_consolidation: Option<Instant>,
    ☉ created_at: Instant,
}

⊢ EngramStats {
    rite new() -> Self {
        Self {
            recall_count: 0,
            total_recall_time: Duration·zero(),
            facts_learned: 0,
            episodes_recorded: 0,
            consolidation_count: 0,
            last_consolidation: None,
            created_at: Instant·now(),
        }
    }
}

/// Memory usage across all systems
☉ Σ MemoryUsage {
    ☉ instant: MemorySystemUsage,
    ☉ episodic: MemorySystemUsage,
    ☉ semantic: MemorySystemUsage,
    ☉ procedural: MemorySystemUsage,
}

☉ Σ MemorySystemUsage {
    ☉ item_count: usize,
    ☉ bytes_used: usize,
    ☉ capacity: Option<usize>,
}

/// Events emitted by Engram
☉ ᛈ EngramEvent {
    EngramCreated {
        ids: Vec<EngramId>,
        source: MemorySource,
    },
    EpisodeCompleted {
        id: EpisodeId,
        outcome: Outcome,
    },
    SkillLearned {
        id: SkillId,
        from_episodes: Vec<EpisodeId>,
    },
    ConsolidationCompleted {
        duration: Duration,
        episodes_consolidated: usize,
        skills_learned: usize,
        facts_extracted: usize,
    },
    SyncStarted {
        scope: Scope,
    },
    SyncCompleted {
        report: SyncReport,
    },
}

/// Configuration ∀ context building
☉ Σ ContextConfig {
    ☉ budget: TokenCount,
    ☉ for_task: Option<String>,
    ☉ include: Vec<ContextSource>,
    ☉ format: ContextFormat,
    ☉ prioritize: ContextPriority,
}

☉ ᛈ ContextSource {
    Instant,
    SemanticRelevant,
    EpisodicRecent,
    ProceduralApplicable,
}

☉ ᛈ ContextFormat {
    Plain,
    XML,
    Markdown,
    Structured,
}

☉ ᛈ ContextPriority {
    Relevance,
    Recency,
    Confidence,
    Mixed,
}

/// Exported context ∀ LLM consumption
☉ Σ ExportedContext {
    ☉ items: Vec<ContextItem>,
    ☉ total_tokens: TokenCount,
    ☉ format: ContextFormat,
}

☉ Σ ContextItem {
    ☉ content: String,
    ☉ relevance: f64,
    ☉ source: MemorySource,
    ☉ tokens: TokenCount,
}

⊢ ExportedContext {
    ☉ rite to_string() -> String {
        ⌥ self.format {
            ContextFormat·Plain => {
                self.items.iter()
                    .map(|i| i.content.clone())
                    .collect·<Vec<_>>()
                    .join("\n\n")
            },
            ContextFormat·XML => {
                self.items.iter()
                    .map(|i| format!(
                        "<context relevance=\"{:.2}\" source=\"{:?}\">\n{}\n</context>",
                        i.relevance, i.source, i.content
                    ))
                    .collect·<Vec<_>>()
                    .join("\n")
            },
            ContextFormat·Markdown => {
                self.items.iter()
                    .map(|i| format!(
                        "### {} (relevance: {:.0}%)\n\n{}",
                        format!("{:?}", i.source),
                        i.relevance * 100.0,
                        i.content
                    ))
                    .collect·<Vec<_>>()
                    .join("\n\n---\n\n")
            },
            ContextFormat·Structured => {
                // JSON-like format
                serde_json·to_string_pretty(&self.items).unwrap_or_default()
            },
        }
    }
}

/// Sync configuration
☉ Σ SyncConfig {
    ☉ scope: Scope,
    ☉ strategy: SyncStrategy,
    ☉ conflict_resolution: ConflictResolution,
    ☉ timeout: Duration,
}

☉ ᛈ SyncStrategy {
    CRDT,
    Consensus,
    Manual,
}

☉ ᛈ ConflictResolution {
    TakeLocal,
    TakeRemote,
    TakeNewest,
    TakeHighestConfidence,
    Merge,
    Fork,
}

/// Sync operation report
☉ Σ SyncReport {
    ☉ strategy: SyncStrategy,
    ☉ scope: Scope,
    ☉ engrams_synced: usize,
    ☉ conflicts_resolved: usize,
    ☉ duration: Duration,
}

/// Consolidation report
☉ Σ ConsolidationReport {
    ☉ duration: Duration,
    ☉ episodic: EpisodicConsolidationReport,
}

/// Archive operation report
☉ Σ ArchiveReport {
    ☉ archived_count: usize,
    ☉ timestamp: Instant,
}

/// Gap ∈ knowledge
☉ Σ Gap {
    ☉ description: String,
    ☉ query_aspect: String,
    ☉ severity: f64,
    ☉ suggested_actions: Vec<SuggestedAction>,
}

☉ ᛈ SuggestedAction {
    AskUser { question: String },
    SearchExternal { query: String },
    InvokeTool { tool: String, args: Value },
    RecallDifferently { alternative: String },
}

// ============================================================================
// Helper Functions
// ============================================================================

rite generate_agent_id() -> AgentId {
    format!("agent_{}", ulid·generate().unwrap())
}

rite generate_instance_id() -> InstanceId {
    format!("inst_{}", ulid·generate().unwrap())
}
