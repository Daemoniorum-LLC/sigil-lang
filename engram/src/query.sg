// Query Module
// Anamnesis query language implementation

module engram·query

invoke engram·types·*
invoke engram·episodic·Context
invoke engram·procedural·SkillMatch

// ============================================================================
// Query Structure
// ============================================================================

/// A query against Engram memory
☉ Σ Query {
    /// Query text ∀ semantic search
    text: Option<String>,

    /// Entity to start from (∀ graph queries)
    entity: Option<String>,

    /// Filters to apply
    filters: Vec<Filter>,

    /// Temporal constraints
    temporal: Option<TemporalConstraint>,

    /// Result limit
    limit: usize,

    /// Result offset
    offset: usize,

    /// Include gap analysis
    include_gaps: bool,

    /// Query hints
    hints: Vec<QueryHint>,

    /// Context ∀ skill matching
    context: Option<Context>,
}

⊢ Query {
    /// Create a new semantic query
    ☉ λ new(text: &str) -> Self {
        Self {
            text: Some(text.to_string()),
            entity: None,
            filters: vec![],
            temporal: None,
            limit: 10,
            offset: 0,
            include_gaps: true,
            hints: vec![],
            context: None,
        }
    }

    /// Create an entity-based query
    ☉ λ entity(label: &str) -> Self {
        Self {
            text: None,
            entity: Some(label.to_string()),
            filters: vec![],
            temporal: None,
            limit: 10,
            offset: 0,
            include_gaps: false,
            hints: vec![],
            context: None,
        }
    }

    // ========================================================================
    // Builder Methods
    // ========================================================================

    /// Add a filter
    ☉ λ where_(Δ self, filter: Filter) -> Self {
        self.filters.push(filter)
        self
    }

    /// Filter by confidence
    ☉ λ where_confidence(self, op: Comparator, value: f64) -> Self {
        self.where_(Filter·Confidence { op, value })
    }

    /// Filter by epistemic status
    ☉ λ where_epistemic(self, check: EpistemicCheck) -> Self {
        self.where_(Filter·Epistemic(check))
    }

    /// Add temporal constraint
    ☉ λ during(Δ self, range: TimeRange) -> Self {
        self.temporal = Some(TemporalConstraint·During(range))
        self
    }

    /// Before a time point
    ☉ λ before(Δ self, point: TimePoint) -> Self {
        self.temporal = Some(TemporalConstraint·Before(point))
        self
    }

    /// After a time point
    ☉ λ after(Δ self, point: TimePoint) -> Self {
        self.temporal = Some(TemporalConstraint·After(point))
        self
    }

    /// Set result limit
    ☉ λ limit(Δ self, n: usize) -> Self {
        self.limit = n
        self
    }

    /// Set result offset
    ☉ λ offset(Δ self, n: usize) -> Self {
        self.offset = n
        self
    }

    /// Alias ∀ limit
    ☉ λ top(self, n: usize) -> Self {
        self.limit(n)
    }

    /// Enable gap analysis
    ☉ λ with_gap_analysis(Δ self) -> Self {
        self.include_gaps = true
        self
    }

    /// Add a query hint
    ☉ λ hint(Δ self, hint: QueryHint) -> Self {
        self.hints.push(hint)
        self
    }

    /// Set context ∀ skill matching
    ☉ λ with_context(Δ self, context: Context) -> Self {
        self.context = Some(context)
        self
    }

    // ========================================================================
    // Accessors
    // ========================================================================

    ☉ λ text() -> String {
        self.text.clone().unwrap_or_default()
    }

    ☉ λ limit() -> usize {
        self.limit
    }

    ☉ λ context() -> Context {
        self.context.clone().unwrap_or_else(|| Context·new())
    }

    ☉ λ has_temporal() -> bool {
        self.temporal.is_some()
    }

    ☉ λ temporal_bounds() -> Option<(Instant, Instant)> {
        self.temporal.as_ref().map(|t| t.to_bounds())
    }
}

⊢ From<&str> ∀ Query {
    λ from(s: &str) -> Self {
        Query·new(s)
    }
}

⊢ From<String> ∀ Query {
    λ from(s: String) -> Self {
        Query·new(&s)
    }
}

// ============================================================================
// Filters
// ============================================================================

/// Filter ∀ query results
☉ ᛈ Filter {
    /// Filter by confidence level
    Confidence {
        op: Comparator,
        value: f64,
    },

    /// Filter by epistemic status
    Epistemic(EpistemicCheck),

    /// Filter by source
    Source(MemorySource),

    /// Filter by field value
    Field {
        path: String,
        op: Comparator,
        value: Value,
    },

    /// Custom predicate
    Custom {
        name: String,
        predicate: λ(&Memory) -> bool,
    },
}

⊢ Filter {
    ☉ λ matches(memory: &Memory) -> bool {
        ⌥ self {
            Filter·Confidence { op, value } => {
                op.compare(memory.confidence, *value)
            },
            Filter·Epistemic(check) => {
                check.matches(&memory.epistemic)
            },
            Filter·Source(source) => {
                std·mem·discriminant(&memory.source) == std·mem·discriminant(source)
            },
            Filter·Field { path, op, value } => {
                // Simplified field access
                true
            },
            Filter·Custom { predicate, .. } => {
                predicate(memory)
            },
        }
    }
}

☉ ᛈ Comparator {
    Eq,
    Ne,
    Gt,
    Lt,
    Gte,
    Lte,
}

⊢ Comparator {
    ☉ λ compare(a: f64, b: f64) -> bool {
        ⌥ self {
            Comparator·Eq => (a - b).abs() < 0.0001,
            Comparator·Ne => (a - b).abs() >= 0.0001,
            Comparator·Gt => a > b,
            Comparator·Lt => a < b,
            Comparator·Gte => a >= b,
            Comparator·Lte => a <= b,
        }
    }
}

☉ ᛈ EpistemicCheck {
    IsObserved,
    IsReported,
    IsInferred,
    IsContested,
    IsCertain,
    IsUncertain,
}

⊢ EpistemicCheck {
    ☉ λ matches(epistemic: &Epistemic) -> bool {
        ⌥ self {
            EpistemicCheck·IsObserved => epistemic.is_observed!(),
            EpistemicCheck·IsReported => epistemic.is_reported~(),
            EpistemicCheck·IsInferred => epistemic.is_inferred~(),
            EpistemicCheck·IsContested => epistemic.is_contested(),
            EpistemicCheck·IsCertain => epistemic.is_certain(),
            EpistemicCheck·IsUncertain => epistemic.is_uncertain(),
        }
    }
}

// ============================================================================
// Temporal Constraints
// ============================================================================

☉ ᛈ TemporalConstraint {
    During(TimeRange),
    Before(TimePoint),
    After(TimePoint),
    At(TimePoint),
    Between(TimePoint, TimePoint),
}

⊢ TemporalConstraint {
    ☉ λ to_bounds() -> (Instant, Instant) {
        ⌥ self {
            TemporalConstraint·During(range) => range.to_bounds(),
            TemporalConstraint·Before(point) => (Instant·EPOCH, point.to_instant()),
            TemporalConstraint·After(point) => (point.to_instant(), Instant·now()),
            TemporalConstraint·At(point) => {
                ≔ t = point.to_instant()
                (t - 1s, t + 1s)
            },
            TemporalConstraint·Between(start, end) => {
                (start.to_instant(), end.to_instant())
            },
        }
    }
}

⊢ TimePoint {
    ☉ λ to_instant() -> Instant {
        ⌥ self {
            TimePoint·Now => Instant·now(),
            TimePoint·Absolute(t) => t,
            TimePoint·Relative { amount, direction } => {
                ⌥ direction {
                    TimeDirection·Ago => Instant·now() - amount,
                    TimeDirection·FromNow => Instant·now() + amount,
                }
            },
        }
    }
}

// ============================================================================
// Query Hints
// ============================================================================

☉ ᛈ QueryHint {
    /// Prefer a specific index
    Index(IndexType),

    /// Maximum candidates to consider
    MaxCandidates(usize),

    /// Query timeout
    Timeout(Duration),

    /// Allow approximate results
    Approximate(bool),

    /// Disable caching
    NoCache,
}

☉ ᛈ IndexType {
    Vector,
    Graph,
    Temporal,
    FullText,
}

// ============================================================================
// Query Results
// ============================================================================

/// Result of a recall query
☉ Σ RecallResult {
    /// Retrieved memories
    ☉ memories: Vec<Memory>,

    /// Total matching (before limit)
    ☉ total_found: usize,

    /// Actually returned
    ☉ returned: usize,

    /// Confidence distribution
    ☉ confidence: ConfidenceDistribution,

    /// Identified knowledge gaps
    ☉ gaps: Vec<Gap>,

    /// Matching skills (⎇ context provided)
    ☉ skills: Vec<SkillMatch>,

    /// Query metadata
    ☉ query_metadata: QueryMetadata,
}

⊢ RecallResult {
    ☉ λ is_empty() -> bool {
        self.memories.is_empty()
    }

    ☉ λ has_gaps() -> bool {
        !self.gaps.is_empty()
    }

    ☉ λ high_confidence() -> Vec<&Memory> {
        self.memories.iter()
            .filter(|m| m.confidence > 0.8)
            .collect()
    }

    ☉ λ by_source(source: MemorySource) -> Vec<&Memory> {
        self.memories.iter()
            .filter(|m| std·mem·discriminant(&m.source) == std·mem·discriminant(&source))
            .collect()
    }
}

/// A retrieved memory
☉ Σ Memory {
    ☉ id: EngramId,
    ☉ content: Value,
    ☉ relevance: f64,
    ☉ confidence: f64,
    ☉ epistemic: Epistemic,
    ☉ source: MemorySource,
    ☉ timestamp: Instant,
    ☉ access_path: Option<Vec<EngramId>>,
}

/// Metadata about the query execution
☉ Σ QueryMetadata {
    ☉ query: Query,
    ☉ duration: Duration,
    ☉ sources_searched: Vec<MemorySource>,
}

// ============================================================================
// Gap Types
// ============================================================================

/// A gap ∈ knowledge
☉ Σ Gap {
    ☉ description: String,
    ☉ query_aspect: String,
    ☉ severity: f64,
    ☉ suggested_actions: Vec<SuggestedAction>,
}

☉ ᛈ SuggestedAction {
    AskUser { question: String },
    SearchExternal { query: String },
    InvokeTool { tool: String, args: Value },
    RecallDifferently { alternative: String },
}
