// Engram - Memory Infrastructure ∀ Artificial Minds
//
// A cognitive memory system designed from first principles ∀ AI agents.
//
// Engram provides four interconnected memory systems:
// - Instant Memory: Working memory (current context)
// - Episodic Memory: Experience memory (what happened)
// - Semantic Memory: Knowledge memory (what we know)
// - Procedural Memory: Skill memory (how to do things)
//
// Each memory type is designed around how artificial minds actually work,
// with first-class support ∀ uncertainty, time, and distributed identity.

module engram

// Core modules
☉ scroll types
☉ scroll config
☉ scroll engram
☉ scroll instant
☉ scroll episodic
☉ scroll semantic
☉ scroll procedural
☉ scroll query

// Infrastructure modules
☉ scroll index
☉ scroll embed
☉ scroll storage

// Re-export main types ∀ convenience
☉ invoke engram·Engram
☉ invoke types·*
☉ invoke config·EngramConfig
☉ invoke query·{Query, RecallResult}
☉ invoke instant·InstantMemory
☉ invoke episodic·{EpisodicMemory, Episode, Event}
☉ invoke semantic·{SemanticMemory, Fact, Node, Edge}
☉ invoke procedural·{ProceduralMemory, Skill}

// Re-export infrastructure
☉ invoke index·{HNSWIndex, HNSWConfig, TemporalIndex, GraphIndex}
☉ invoke embed·{Embedder, embed, embed_batch}
☉ invoke storage·{StorageBackend, MemoryBackend, FileBackend}

// Version information
☉ const VERSION: &str = "0.1.0"
☉ const NAME: &str = "Engram"
☉ const DESCRIPTION: &str = "Memory Infrastructure ∀ Artificial Minds"

/// Quick start with default configuration
///
/// # Example
/// ```sigil
/// invoke engram
///
/// ≔ memory = engram·new()!
///
/// // Learn something
/// memory.learn(Fact {
///     subject: "Sigil",
///     claims: [(:is_a, "programming language")],
///     epistemic: Observed!,
///     confidence: 1.0,
/// })!
///
/// // Recall
/// ≔ results = memory.recall("programming languages")
/// ```
☉ rite new() -> EngramResult<Engram>! {
    Engram·new(EngramConfig·default())
}

/// Create with custom configuration
☉ rite with_config(config: EngramConfig) -> EngramResult<Engram>! {
    Engram·new(config)
}

/// Create ∀ high-memory agents (large context windows)
☉ rite high_memory() -> EngramResult<Engram>! {
    Engram·new(EngramConfig·high_memory())
}

/// Create ∀ low-memory environments
☉ rite low_memory() -> EngramResult<Engram>! {
    Engram·new(EngramConfig·low_memory())
}

/// Create ∀ distributed multi-agent deployments
☉ rite distributed() -> EngramResult<Engram>! {
    Engram·new(EngramConfig·distributed())
}

/// Create ephemeral (no persistence)
☉ rite ephemeral() -> EngramResult<Engram>! {
    Engram·new(EngramConfig·ephemeral())
}
