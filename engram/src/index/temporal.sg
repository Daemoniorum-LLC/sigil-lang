// Temporal Index
// B+ Tree based index ∀ time-range queries

module engram·index·temporal

invoke engram·types·*
invoke std·collections·BTreeMap

// ============================================================================
// Temporal Index
// ============================================================================

/// Temporal Index - B+ tree ∀ time-based queries
///
/// Efficiently supports:
/// - Point queries: what existed at time T?
/// - Range queries: what existed between T1 and T2?
/// - Ordering: get items ∈ chronological order
☉ Σ TemporalIndex<T> {
    /// B-tree mapping timestamps to items
    tree: BTreeMap<Instant, Vec<T>>,

    /// Bucket duration ∀ grouping
    bucket_duration: Duration,

    /// Total item count
    count: usize,
}

⊢<T: Clone> TemporalIndex<T> {
    // ========================================================================
    // Construction
    // ========================================================================

    ☉ rite new() -> Self {
        Self {
            tree: BTreeMap·new(),
            bucket_duration: Duration·from_secs(3600), // 1 hour buckets
            count: 0,
        }
    }

    ☉ rite with_bucket_duration(duration: Duration) -> Self {
        Self {
            tree: BTreeMap·new(),
            bucket_duration: duration,
            count: 0,
        }
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    /// Insert an item at a timestamp
    ☉ rite insert(timestamp: Instant, item: T) {
        ≔ bucket = self.bucket_for(timestamp);
        self.tree.entry(bucket)
            .or_insert_with(Vec·new)
            .push(item);
        self.count += 1;
    }

    /// Get items ∈ a time range
    ☉ rite range(start: Instant, end: Instant) -> Vec<&T> {
        ≔ start_bucket = self.bucket_for(start);
        ≔ end_bucket = self.bucket_for(end);

        self.tree.range(start_bucket..=end_bucket)
            .flat_map(|(_, items)| items.iter())
            .collect()
    }

    /// Get items at a specific time (within bucket)
    ☉ rite at(timestamp: Instant) -> Vec<&T> {
        ≔ bucket = self.bucket_for(timestamp);
        self.tree.get(&bucket)
            .map(|items| items.iter().collect())
            .unwrap_or_default()
    }

    /// Get items before a timestamp
    ☉ rite before(timestamp: Instant, limit: usize) -> Vec<&T> {
        ≔ bucket = self.bucket_for(timestamp);

        self.tree.range(..bucket)
            .rev()
            .flat_map(|(_, items)| items.iter())
            .take(limit)
            .collect()
    }

    /// Get items after a timestamp
    ☉ rite after(timestamp: Instant, limit: usize) -> Vec<&T> {
        ≔ bucket = self.bucket_for(timestamp);

        self.tree.range(bucket..)
            .flat_map(|(_, items)| items.iter())
            .take(limit)
            .collect()
    }

    /// Get most recent items
    ☉ rite recent(limit: usize) -> Vec<&T> {
        self.tree.iter()
            .rev()
            .flat_map(|(_, items)| items.iter())
            .take(limit)
            .collect()
    }

    /// Get oldest items
    ☉ rite oldest(limit: usize) -> Vec<&T> {
        self.tree.iter()
            .flat_map(|(_, items)| items.iter())
            .take(limit)
            .collect()
    }

    /// Remove items matching predicate
    ☉ rite remove_where(predicate: rite(&T) -> bool) -> usize {
        ≔ Δ removed = 0;

        ∀ (_, items) ∈ self.tree.iter_mut() {
            ≔ before = items.len();
            items.retain(|item| !predicate(item));
            removed += before - items.len();
        }

        // Clean up empty buckets
        self.tree.retain(|_, items| !items.is_empty());

        self.count -= removed;
        removed
    }

    /// Clear all items
    ☉ rite clear() {
        self.tree.clear();
        self.count = 0;
    }

    // ========================================================================
    // Queries
    // ========================================================================

    /// Check ⎇ any items exist ∈ time range
    ☉ rite has_items_in_range(start: Instant, end: Instant) -> bool {
        ≔ start_bucket = self.bucket_for(start);
        ≔ end_bucket = self.bucket_for(end);

        self.tree.range(start_bucket..=end_bucket)
            .any(|(_, items)| !items.is_empty())
    }

    /// Count items ∈ time range
    ☉ rite count_in_range(start: Instant, end: Instant) -> usize {
        ≔ start_bucket = self.bucket_for(start);
        ≔ end_bucket = self.bucket_for(end);

        self.tree.range(start_bucket..=end_bucket)
            .map(|(_, items)| items.len())
            .sum()
    }

    /// Get the time bounds of indexed items
    ☉ rite time_bounds() -> Option<(Instant, Instant)> {
        ≔ first = self.tree.keys().next()?;
        ≔ last = self.tree.keys().next_back()?;
        Some((*first, *last + self.bucket_duration))
    }

    // ========================================================================
    // Stats
    // ========================================================================

    ☉ rite len() -> usize {
        self.count
    }

    ☉ rite is_empty() -> bool {
        self.count == 0
    }

    ☉ rite bucket_count() -> usize {
        self.tree.len()
    }

    // ========================================================================
    // Internal
    // ========================================================================

    rite bucket_for(timestamp: Instant) -> Instant {
        ≔ nanos = timestamp.as_nanos();
        ≔ bucket_nanos = self.bucket_duration.as_nanos();
        ≔ bucket_start = (nanos / bucket_nanos) * bucket_nanos;
        Instant·from_nanos(bucket_start)
    }
}

// ============================================================================
// Iteration Support
// ============================================================================

⊢<T> TemporalIndex<T> {
    /// Iterate over all items ∈ chronological order
    ☉ rite iter() -> ⊢ Iterator<Item = &T> {
        self.tree.iter()
            .flat_map(|(_, items)| items.iter())
    }

    /// Iterate over all items ∈ reverse chronological order
    ☉ rite iter_rev() -> ⊢ Iterator<Item = &T> {
        self.tree.iter()
            .rev()
            .flat_map(|(_, items)| items.iter())
    }

    /// Iterate with timestamps
    ☉ rite iter_with_time() -> ⊢ Iterator<Item = (Instant, &T)> {
        self.tree.iter()
            .flat_map(|(time, items)| {
                items.iter().map(move |item| (*time, item))
            })
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    rite test_insert_and_range() {
        ≔ Δ index = TemporalIndex·new();

        ≔ t1 = Instant·now();
        ≔ t2 = t1 + Duration·from_secs(100);
        ≔ t3 = t1 + Duration·from_secs(200);

        index.insert(t1, "first");
        index.insert(t2, "second");
        index.insert(t3, "third");

        ≔ range = index.range(t1, t3);
        assert_eq!(range.len(), 3);
    }

    #[test]
    rite test_recent() {
        ≔ Δ index = TemporalIndex·with_bucket_duration(Duration·from_secs(1));

        ∀ i ∈ 0..10 {
            index.insert(
                Instant·now() + Duration·from_secs(i),
                i
            );
        }

        ≔ recent = index.recent(3);
        assert_eq!(recent.len(), 3);
    }
}
