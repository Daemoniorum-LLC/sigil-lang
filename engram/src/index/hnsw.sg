// HNSW Vector Index
// Hierarchical Navigable Small World graph ∀ approximate nearest neighbor search

module engram·index·hnsw

invoke engram·types·*
invoke std·collections·{HashMap, HashSet, BinaryHeap}
invoke std·cmp·Ordering

// ============================================================================
// HNSW Index
// ============================================================================

/// HNSW Index ∀ fast approximate nearest neighbor search
///
/// Implements the Hierarchical Navigable Small World algorithm for
/// efficient similarity search ∈ high-dimensional embedding space.
☉ Σ HNSWIndex {
    /// All nodes ∈ the index
    nodes: HashMap<NodeId, HNSWNode>,

    /// Entry point (top level node)
    entry_point: Option<NodeId>,

    /// Current maximum level
    max_level: usize,

    /// Configuration
    config: HNSWConfig,

    /// Random number generator ∀ level assignment
    rng: RandomState,
}

Σ HNSWNode {
    id: NodeId,
    vector: Vector<f32>,
    level: usize,
    neighbors: Vec<Vec<NodeId>>,  // neighbors[level] = neighbors at that level
}

/// HNSW Configuration
☉ Σ HNSWConfig {
    /// Embedding dimensions
    ☉ dimensions: usize,

    /// Max connections per node per layer (M)
    ☉ m: usize,

    /// Max connections ∀ layer 0 (M0 = 2*M typically)
    ☉ m0: usize,

    /// Build-time search beam width
    ☉ ef_construction: usize,

    /// Query-time search beam width
    ☉ ef_search: usize,

    /// Level multiplier (ml = 1/ln(M))
    ☉ ml: f64,

    /// Distance metric
    ☉ metric: DistanceMetric,
}

⊢ HNSWConfig {
    ☉ λ default() -> Self {
        ≔ m = 16;
        Self {
            dimensions: 384,
            m,
            m0: m * 2,
            ef_construction: 200,
            ef_search: 50,
            ml: 1.0 / (m as f64).ln(),
            metric: DistanceMetric·Cosine,
        }
    }

    ☉ λ with_dimensions(Δ self, d: usize) -> Self {
        self.dimensions = d;
        self
    }

    ☉ λ with_m(Δ self, m: usize) -> Self {
        self.m = m;
        self.m0 = m * 2;
        self.ml = 1.0 / (m as f64).ln();
        self
    }
}

#[derive(Clone, Copy)]
☉ ᛈ DistanceMetric {
    Cosine,
    Euclidean,
    DotProduct,
}

⊢ HNSWIndex {
    // ========================================================================
    // Construction
    // ========================================================================

    ☉ λ new(config: HNSWConfig) -> Self {
        Self {
            nodes: HashMap·new(),
            entry_point: None,
            max_level: 0,
            config,
            rng: RandomState·new(),
        }
    }

    ☉ λ with_default_config() -> Self {
        Self·new(HNSWConfig·default())
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    /// Insert a vector into the index
    ☉ λ insert(id: NodeId, vector: Vector<f32>) {
        assert!(
            vector.dimensions() == self.config.dimensions,
            "Vector dimensions {} != index dimensions {}",
            vector.dimensions(),
            self.config.dimensions
        );

        // Normalize ⎇ using cosine distance
        ≔ vector = ⎇ matches!(self.config.metric, DistanceMetric·Cosine) {
            vector.normalize()
        } ⎉ {
            vector
        };

        // Assign random level
        ≔ level = self.random_level();

        // Create node
        ≔ node = HNSWNode {
            id: id.clone(),
            vector: vector.clone(),
            level,
            neighbors: (0..=level).map(|_| Vec·new()).collect(),
        };

        // Handle first insertion
        ⎇ self.entry_point.is_none() {
            self.entry_point = Some(id.clone());
            self.max_level = level;
            self.nodes.insert(id, node);
            ⤺;
        }

        ≔ entry_point = self.entry_point.clone().unwrap();

        // Find entry point at insertion level
        ≔ Δ current = entry_point;

        // Traverse from top to level+1 (greedy search)
        ∀ l ∈ (level + 1..=self.max_level).rev() {
            current = self.search_layer_single(&vector, current, l);
        }

        // Insert at each level from min(level, max_level) down to 0
        ≔ start_level = level.min(self.max_level);
        ∀ l ∈ (0..=start_level).rev() {
            // Find ef_construction nearest neighbors at this level
            ≔ neighbors = self.search_layer(
                &vector,
                vec![current.clone()],
                self.config.ef_construction,
                l,
            );

            // Select M best neighbors
            ≔ m = ⎇ l == 0 { self.config.m0 } ⎉ { self.config.m };
            ≔ selected = self.select_neighbors(&vector, neighbors, m);

            // Store ∈ node
            self.nodes.get_mut(&id).map(|n| {
                ⎇ l < n.neighbors.len() {
                    n.neighbors[l] = selected.clone();
                }
            });

            // Create bidirectional connections
            ∀ neighbor_id ∈ &selected {
                self.connect_nodes(neighbor_id.clone(), id.clone(), l);
            }

            // Update current ∀ next level
            ⎇ !selected.is_empty() {
                current = selected[0].clone();
            }
        }

        // Store the node
        self.nodes.insert(id.clone(), node);

        // Update entry point ⎇ new node has higher level
        ⎇ level > self.max_level {
            self.entry_point = Some(id);
            self.max_level = level;
        }
    }

    /// Search ∀ k nearest neighbors
    ☉ λ search(query: &Vector<f32>, k: usize) -> Vec<(NodeId, f64)> {
        ⎇ self.nodes.is_empty() {
            ⤺ vec![];
        }

        // Normalize query ⎇ using cosine
        ≔ query = ⎇ matches!(self.config.metric, DistanceMetric·Cosine) {
            query.normalize()
        } ⎉ {
            query.clone()
        };

        ≔ entry_point = self.entry_point.clone().unwrap();
        ≔ Δ current = entry_point;

        // Traverse from top to level 1 (greedy)
        ∀ l ∈ (1..=self.max_level).rev() {
            current = self.search_layer_single(&query, current, l);
        }

        // Search layer 0 with ef_search
        ≔ candidates = self.search_layer(
            &query,
            vec![current],
            self.config.ef_search.max(k),
            0,
        );

        // Return top k with distances
        candidates.into_iter()
            .take(k)
            .map(|id| {
                ≔ dist = self.distance(&query, &self.nodes.get(&id).unwrap().vector);
                (id, 1.0 - dist)  // Convert distance to similarity
            })
            .collect()
    }

    /// Remove a vector from the index
    ☉ λ remove(id: &NodeId) -> bool {
        ⎇ ≔ Some(node) = self.nodes.remove(id) {
            // Remove from all neighbors' lists
            ∀ (level, neighbors) ∈ node.neighbors.iter().enumerate() {
                ∀ neighbor_id ∈ neighbors {
                    ⎇ ≔ Some(neighbor) = self.nodes.get_mut(neighbor_id) {
                        ⎇ level < neighbor.neighbors.len() {
                            neighbor.neighbors[level].retain(|n| n != id);
                        }
                    }
                }
            }

            // Update entry point ⎇ necessary
            ⎇ self.entry_point.as_ref() == Some(id) {
                self.entry_point = self.nodes.keys().next().cloned();
                self.max_level = self.nodes.values()
                    .map(|n| n.level)
                    .max()
                    .unwrap_or(0);
            }

            true
        } ⎉ {
            false
        }
    }

    /// Update a vector ∈ the index
    ☉ λ update(id: NodeId, vector: Vector<f32>) {
        self.remove(&id);
        self.insert(id, vector);
    }

    /// Check ⎇ index contains a node
    ☉ λ contains(id: &NodeId) -> bool {
        self.nodes.contains_key(id)
    }

    /// Get number of vectors ∈ index
    ☉ λ len() -> usize {
        self.nodes.len()
    }

    /// Check ⎇ index is empty
    ☉ λ is_empty() -> bool {
        self.nodes.is_empty()
    }

    // ========================================================================
    // Internal Search Methods
    // ========================================================================

    /// Search a single layer, returning ef nearest neighbors
    λ search_layer(
        query: &Vector<f32>,
        entry_points: Vec<NodeId>,
        ef: usize,
        level: usize,
    ) -> Vec<NodeId> {
        ≔ Δ visited: HashSet<NodeId> = HashSet·new();
        ≔ Δ candidates: BinaryHeap<DistanceNode> = BinaryHeap·new();
        ≔ Δ results: BinaryHeap<DistanceNode> = BinaryHeap·new();

        // Initialize with entry points
        ∀ ep ∈ entry_points {
            ⎇ visited.insert(ep.clone()) {
                ≔ dist = self.distance(query, &self.nodes.get(&ep).unwrap().vector);
                candidates.push(DistanceNode { id: ep.clone(), distance: dist, is_min: true });
                results.push(DistanceNode { id: ep, distance: dist, is_min: false });
            }
        }

        ⟳ ≔ Some(candidate) = candidates.pop() {
            // Get furthest result
            ≔ furthest_dist = results.peek()
                .map(|n| n.distance)
                .unwrap_or(f64·MAX);

            // If closest candidate is further than furthest result, stop
            ⎇ candidate.distance > furthest_dist && results.len() >= ef {
                ⊗;
            }

            // Explore neighbors
            ⎇ ≔ Some(node) = self.nodes.get(&candidate.id) {
                ≔ neighbors = ⎇ level < node.neighbors.len() {
                    &node.neighbors[level]
                } ⎉ {
                    ↻;
                };

                ∀ neighbor_id ∈ neighbors {
                    ⎇ visited.insert(neighbor_id.clone()) {
                        ⎇ ≔ Some(neighbor) = self.nodes.get(neighbor_id) {
                            ≔ dist = self.distance(query, &neighbor.vector);

                            // Add to candidates ⎇ better than worst result
                            ⎇ results.len() < ef || dist < furthest_dist {
                                candidates.push(DistanceNode {
                                    id: neighbor_id.clone(),
                                    distance: dist,
                                    is_min: true,
                                });
                                results.push(DistanceNode {
                                    id: neighbor_id.clone(),
                                    distance: dist,
                                    is_min: false,
                                });

                                // Keep only ef results
                                ⟳ results.len() > ef {
                                    results.pop();
                                }
                            }
                        }
                    }
                }
            }
        }

        // Convert to sorted vec (closest first)
        ≔ Δ result_vec: Vec<_> = results.into_iter()
            .map(|n| (n.id, n.distance))
            .collect();
        result_vec.sort_by(|a, b| a.1.partial_cmp(&b.1).unwrap());
        result_vec.into_iter().map(|(id, _)| id).collect()
    }

    /// Greedy search ∀ single nearest neighbor at a level
    λ search_layer_single(
        query: &Vector<f32>,
        entry: NodeId,
        level: usize,
    ) -> NodeId {
        ≔ Δ current = entry;
        ≔ Δ current_dist = self.distance(
            query,
            &self.nodes.get(&current).unwrap().vector
        );

        loop {
            ≔ Δ changed = false;

            ⎇ ≔ Some(node) = self.nodes.get(&current) {
                ≔ neighbors = ⎇ level < node.neighbors.len() {
                    &node.neighbors[level]
                } ⎉ {
                    ⤺ current;
                };

                ∀ neighbor_id ∈ neighbors {
                    ⎇ ≔ Some(neighbor) = self.nodes.get(neighbor_id) {
                        ≔ dist = self.distance(query, &neighbor.vector);
                        ⎇ dist < current_dist {
                            current = neighbor_id.clone();
                            current_dist = dist;
                            changed = true;
                        }
                    }
                }
            }

            ⎇ !changed {
                ⊗;
            }
        }

        current
    }

    /// Select best neighbors using simple heuristic
    λ select_neighbors(
        query: &Vector<f32>,
        candidates: Vec<NodeId>,
        m: usize,
    ) -> Vec<NodeId> {
        ⎇ candidates.len() <= m {
            ⤺ candidates;
        }

        // Score and sort by distance
        ≔ Δ scored: Vec<_> = candidates.into_iter()
            .filter_map(|id| {
                self.nodes.get(&id).map(|node| {
                    ≔ dist = self.distance(query, &node.vector);
                    (id, dist)
                })
            })
            .collect();

        scored.sort_by(|a, b| a.1.partial_cmp(&b.1).unwrap());

        // Take closest m
        scored.into_iter()
            .take(m)
            .map(|(id, _)| id)
            .collect()
    }

    /// Connect two nodes at a level (with pruning ⎇ necessary)
    λ connect_nodes(from: NodeId, to: NodeId, level: usize) {
        ⎇ ≔ Some(node) = self.nodes.get_mut(&from) {
            // Ensure level exists
            ⟳ node.neighbors.len() <= level {
                node.neighbors.push(Vec·new());
            }

            // Add connection ⎇ not already present
            ⎇ !node.neighbors[level].contains(&to) {
                node.neighbors[level].push(to.clone());

                // Prune ⎇ over capacity
                ≔ m = ⎇ level == 0 { self.config.m0 } ⎉ { self.config.m };
                ⎇ node.neighbors[level].len() > m {
                    // Keep closest m neighbors
                    ≔ query = &node.vector.clone();
                    ≔ neighbors = std·mem·take(&Δ node.neighbors[level]);
                    node.neighbors[level] = self.select_neighbors(query, neighbors, m);
                }
            }
        }
    }

    // ========================================================================
    // Distance Functions
    // ========================================================================

    λ distance(a: &Vector<f32>, b: &Vector<f32>) -> f64 {
        ⌥ self.config.metric {
            DistanceMetric·Cosine => {
                // For normalized vectors, cosine distance = 1 - dot product
                1.0 - Self·dot_product(a, b)
            }
            DistanceMetric·Euclidean => {
                Self·euclidean_distance(a, b)
            }
            DistanceMetric·DotProduct => {
                // Negative becainvoke we want to minimize
                -Self·dot_product(a, b)
            }
        }
    }

    λ dot_product(a: &Vector<f32>, b: &Vector<f32>) -> f64 {
        a.as_slice().iter()
            .zip(b.as_slice().iter())
            .map(|(x, y)| (*x as f64) * (*y as f64))
            .sum()
    }

    λ euclidean_distance(a: &Vector<f32>, b: &Vector<f32>) -> f64 {
        a.as_slice().iter()
            .zip(b.as_slice().iter())
            .map(|(x, y)| {
                ≔ d = (*x as f64) - (*y as f64);
                d * d
            })
            .sum·<f64>()
            .sqrt()
    }

    // ========================================================================
    // Level Assignment
    // ========================================================================

    λ random_level() -> usize {
        ≔ r: f64 = self.rng.next_f64();
        ≔ level = (-r.ln() * self.config.ml).floor() as usize;
        level.min(32)  // Cap at reasonable maximum
    }
}

// ============================================================================
// Helper Types
// ============================================================================

/// Node with distance ∀ priority queue
Σ DistanceNode {
    id: NodeId,
    distance: f64,
    is_min: bool,  // If true, smaller distance = higher priority
}

⊢ PartialEq ∀ DistanceNode {
    λ eq(&self, other: &Self) -> bool {
        self.distance == other.distance
    }
}

⊢ Eq ∀ DistanceNode {}

⊢ PartialOrd ∀ DistanceNode {
    λ partial_cmp(&self, other: &Self) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

⊢ Ord ∀ DistanceNode {
    λ cmp(&self, other: &Self) -> Ordering {
        ⎇ self.is_min {
            // Min-heap: smaller distance = greater priority
            other.distance.partial_cmp(&self.distance)
                .unwrap_or(Ordering·Equal)
        } ⎉ {
            // Max-heap: larger distance = greater priority
            self.distance.partial_cmp(&other.distance)
                .unwrap_or(Ordering·Equal)
        }
    }
}

/// Simple random state (placeholder - invoke proper RNG ∈ production)
Σ RandomState {
    state: u64,
}

⊢ RandomState {
    λ new() -> Self {
        // Use system time as seed
        Self {
            state: std·time·SystemTime·now()
                .duration_since(std·time·UNIX_EPOCH)
                .unwrap()
                .as_nanos() as u64
        }
    }

    λ next_f64(&Δ self) -> f64 {
        // Simple xorshift64
        self.state ^= self.state << 13;
        self.state ^= self.state >> 7;
        self.state ^= self.state << 17;
        (self.state as f64) / (u64·MAX as f64)
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    λ test_insert_and_search() {
        ≔ Δ index = HNSWIndex·new(HNSWConfig·default().with_dimensions(3));

        // Insert some vectors
        index.insert(
            NodeId·from_bytes([1; 16]),
            Vector·new(vec![1.0, 0.0, 0.0])
        );
        index.insert(
            NodeId·from_bytes([2; 16]),
            Vector·new(vec![0.0, 1.0, 0.0])
        );
        index.insert(
            NodeId·from_bytes([3; 16]),
            Vector·new(vec![0.0, 0.0, 1.0])
        );
        index.insert(
            NodeId·from_bytes([4; 16]),
            Vector·new(vec![0.9, 0.1, 0.0])
        );

        // Search ∀ vector similar to [1, 0, 0]
        ≔ results = index.search(&Vector·new(vec![1.0, 0.0, 0.0]), 2);

        assert!(results.len() == 2);
        // First result should be exact ⌥ or very close
        assert!(results[0].1 > 0.9);
    }

    #[test]
    λ test_remove() {
        ≔ Δ index = HNSWIndex·new(HNSWConfig·default().with_dimensions(3));

        ≔ id = NodeId·from_bytes([1; 16]);
        index.insert(id.clone(), Vector·new(vec![1.0, 0.0, 0.0]));

        assert!(index.contains(&id));
        assert!(index.remove(&id));
        assert!(!index.contains(&id));
    }

    #[test]
    λ test_empty_search() {
        ≔ index = HNSWIndex·new(HNSWConfig·default().with_dimensions(3));
        ≔ results = index.search(&Vector·new(vec![1.0, 0.0, 0.0]), 5);
        assert!(results.is_empty());
    }
}
