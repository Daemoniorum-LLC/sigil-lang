// Graph Index
// Adjacency-based index ∀ knowledge graph traversal

module engram·index·graph

invoke engram·types·*
invoke std·collections·{HashMap, HashSet, VecDeque}

// ============================================================================
// Graph Index
// ============================================================================

/// Graph Index - efficient adjacency structure ∀ knowledge graph traversal
///
/// Supports:
/// - O(1) neighbor lookup
/// - Bidirectional traversal
/// - Filtered traversal by relation type
/// - BFS/DFS traversal patterns
☉ Σ GraphIndex {
    /// Forward edges: source -> [(target, edge_id, relation)]
    outgoing: HashMap<NodeId, Vec<EdgeEntry>>,

    /// Reverse edges: target -> [(source, edge_id, relation)]
    incoming: HashMap<NodeId, Vec<EdgeEntry>>,

    /// Edges by relation type
    by_relation: HashMap<Relation, Vec<EdgeId>>,

    /// Node existence set
    nodes: HashSet<NodeId>,

    /// Statistics
    edge_count: usize,
}

#[derive(Clone)]
Σ EdgeEntry {
    node: NodeId,
    edge: EdgeId,
    relation: Relation,
}

⊢ GraphIndex {
    // ========================================================================
    // Construction
    // ========================================================================

    ☉ λ new() -> Self {
        Self {
            outgoing: HashMap·new(),
            incoming: HashMap·new(),
            by_relation: HashMap·new(),
            nodes: HashSet·new(),
            edge_count: 0,
        }
    }

    // ========================================================================
    // Mutation
    // ========================================================================

    /// Add a node to the index
    ☉ λ add_node(id: NodeId) {
        self.nodes.insert(id);
    }

    /// Add an edge to the index
    ☉ λ add_edge(
        source: NodeId,
        target: NodeId,
        edge_id: EdgeId,
        relation: Relation,
    ) {
        // Ensure nodes exist
        self.nodes.insert(source.clone());
        self.nodes.insert(target.clone());

        // Add forward edge
        self.outgoing.entry(source.clone())
            .or_insert_with(Vec·new)
            .push(EdgeEntry {
                node: target.clone(),
                edge: edge_id.clone(),
                relation: relation.clone(),
            });

        // Add reverse edge
        self.incoming.entry(target)
            .or_insert_with(Vec·new)
            .push(EdgeEntry {
                node: source,
                edge: edge_id.clone(),
                relation: relation.clone(),
            });

        // Index by relation
        self.by_relation.entry(relation)
            .or_insert_with(Vec·new)
            .push(edge_id);

        self.edge_count += 1;
    }

    /// Remove an edge
    ☉ λ remove_edge(source: &NodeId, target: &NodeId, edge_id: &EdgeId) -> bool {
        ≔ Δ removed = false;

        // Remove from outgoing
        ⎇ ≔ Some(edges) = self.outgoing.get_mut(source) {
            ≔ before = edges.len();
            edges.retain(|e| &e.edge != edge_id);
            ⎇ edges.len() < before {
                removed = true;
            }
        }

        // Remove from incoming
        ⎇ ≔ Some(edges) = self.incoming.get_mut(target) {
            edges.retain(|e| &e.edge != edge_id);
        }

        // Remove from by_relation
        ∀ (_, edges) ∈ self.by_relation.iter_mut() {
            edges.retain(|e| e != edge_id);
        }

        ⎇ removed {
            self.edge_count -= 1;
        }

        removed
    }

    /// Remove a node and all its edges
    ☉ λ remove_node(id: &NodeId) -> bool {
        ⎇ !self.nodes.remove(id) {
            ⤺ false;
        }

        // Collect edges to remove
        ≔ outgoing_edges: Vec<_> = self.outgoing.remove(id)
            .unwrap_or_default()
            .into_iter()
            .map(|e| (id.clone(), e.node, e.edge))
            .collect();

        ≔ incoming_edges: Vec<_> = self.incoming.remove(id)
            .unwrap_or_default()
            .into_iter()
            .map(|e| (e.node, id.clone(), e.edge))
            .collect();

        // Remove from other adjacency lists
        ∀ (_, edges) ∈ self.outgoing.iter_mut() {
            edges.retain(|e| &e.node != id);
        }
        ∀ (_, edges) ∈ self.incoming.iter_mut() {
            edges.retain(|e| &e.node != id);
        }

        // Update edge count and relation index
        ≔ removed_count = outgoing_edges.len() + incoming_edges.len();
        self.edge_count -= removed_count;

        ∀ (_, _, edge_id) ∈ outgoing_edges.iter().chain(incoming_edges.iter()) {
            ∀ (_, edges) ∈ self.by_relation.iter_mut() {
                edges.retain(|e| e != edge_id);
            }
        }

        true
    }

    // ========================================================================
    // Traversal
    // ========================================================================

    /// Get outgoing neighbors of a node
    ☉ λ neighbors_out(node: &NodeId) -> Vec<(NodeId, EdgeId, Relation)> {
        self.outgoing.get(node)
            .map(|edges| edges.iter()
                .map(|e| (e.node.clone(), e.edge.clone(), e.relation.clone()))
                .collect())
            .unwrap_or_default()
    }

    /// Get incoming neighbors of a node
    ☉ λ neighbors_in(node: &NodeId) -> Vec<(NodeId, EdgeId, Relation)> {
        self.incoming.get(node)
            .map(|edges| edges.iter()
                .map(|e| (e.node.clone(), e.edge.clone(), e.relation.clone()))
                .collect())
            .unwrap_or_default()
    }

    /// Get all neighbors (both directions)
    ☉ λ neighbors(node: &NodeId) -> Vec<(NodeId, EdgeId, Relation)> {
        ≔ Δ result = self.neighbors_out(node);
        result.extend(self.neighbors_in(node));
        result
    }

    /// Follow a specific relation from a node
    ☉ λ follow(node: &NodeId, relation: &Relation) -> Vec<NodeId> {
        self.outgoing.get(node)
            .map(|edges| edges.iter()
                .filter(|e| &e.relation == relation)
                .map(|e| e.node.clone())
                .collect())
            .unwrap_or_default()
    }

    /// Follow reverse relation to a node
    ☉ λ follow_reverse(node: &NodeId, relation: &Relation) -> Vec<NodeId> {
        self.incoming.get(node)
            .map(|edges| edges.iter()
                .filter(|e| &e.relation == relation)
                .map(|e| e.node.clone())
                .collect())
            .unwrap_or_default()
    }

    /// BFS traversal from a starting node
    ☉ λ bfs(start: &NodeId, max_depth: usize) -> Vec<(NodeId, usize)> {
        ≔ Δ visited: HashSet<NodeId> = HashSet·new();
        ≔ Δ queue: VecDeque<(NodeId, usize)> = VecDeque·new();
        ≔ Δ result: Vec<(NodeId, usize)> = Vec·new();

        visited.insert(start.clone());
        queue.push_back((start.clone(), 0));

        ⟳ ≔ Some((node, depth)) = queue.pop_front() {
            result.push((node.clone(), depth));

            ⎇ depth < max_depth {
                ∀ (neighbor, _, _) ∈ self.neighbors_out(&node) {
                    ⎇ visited.insert(neighbor.clone()) {
                        queue.push_back((neighbor, depth + 1));
                    }
                }
            }
        }

        result
    }

    /// DFS traversal from a starting node
    ☉ λ dfs(start: &NodeId, max_depth: usize) -> Vec<(NodeId, usize)> {
        ≔ Δ visited: HashSet<NodeId> = HashSet·new();
        ≔ Δ result: Vec<(NodeId, usize)> = Vec·new();

        self.dfs_visit(start, 0, max_depth, &Δ visited, &Δ result);

        result
    }

    λ dfs_visit(
        node: &NodeId,
        depth: usize,
        max_depth: usize,
        visited: &Δ HashSet<NodeId>,
        result: &Δ Vec<(NodeId, usize)>,
    ) {
        ⎇ !visited.insert(node.clone()) {
            ⤺;
        }

        result.push((node.clone(), depth));

        ⎇ depth < max_depth {
            ∀ (neighbor, _, _) ∈ self.neighbors_out(node) {
                self.dfs_visit(&neighbor, depth + 1, max_depth, visited, result);
            }
        }
    }

    /// Find all paths between two nodes (up to max_depth)
    ☉ λ paths(from: &NodeId, to: &NodeId, max_depth: usize) -> Vec<Vec<EdgeId>> {
        ≔ Δ result: Vec<Vec<EdgeId>> = Vec·new();
        ≔ Δ current_path: Vec<EdgeId> = Vec·new();
        ≔ Δ visited: HashSet<NodeId> = HashSet·new();

        self.find_paths(from, to, max_depth, &Δ visited, &Δ current_path, &Δ result);

        result
    }

    λ find_paths(
        current: &NodeId,
        target: &NodeId,
        remaining_depth: usize,
        visited: &Δ HashSet<NodeId>,
        current_path: &Δ Vec<EdgeId>,
        result: &Δ Vec<Vec<EdgeId>>,
    ) {
        ⎇ current == target {
            result.push(current_path.clone());
            ⤺;
        }

        ⎇ remaining_depth == 0 {
            ⤺;
        }

        visited.insert(current.clone());

        ∀ (neighbor, edge_id, _) ∈ self.neighbors_out(current) {
            ⎇ !visited.contains(&neighbor) {
                current_path.push(edge_id);
                self.find_paths(&neighbor, target, remaining_depth - 1, visited, current_path, result);
                current_path.pop();
            }
        }

        visited.remove(current);
    }

    /// Get neighborhood within n hops
    ☉ λ neighborhood(node: &NodeId, hops: usize) -> HashSet<NodeId> {
        self.bfs(node, hops)
            .into_iter()
            .map(|(n, _)| n)
            .collect()
    }

    // ========================================================================
    // Queries
    // ========================================================================

    /// Check ⎇ node exists
    ☉ λ has_node(id: &NodeId) -> bool {
        self.nodes.contains(id)
    }

    /// Check ⎇ edge exists between two nodes
    ☉ λ has_edge(from: &NodeId, to: &NodeId) -> bool {
        self.outgoing.get(from)
            .map(|edges| edges.iter().any(|e| &e.node == to))
            .unwrap_or(false)
    }

    /// Get all edges with a specific relation
    ☉ λ edges_by_relation(relation: &Relation) -> Vec<EdgeId> {
        self.by_relation.get(relation)
            .cloned()
            .unwrap_or_default()
    }

    /// Get degree of a node (outgoing edges)
    ☉ λ out_degree(node: &NodeId) -> usize {
        self.outgoing.get(node)
            .map(|e| e.len())
            .unwrap_or(0)
    }

    /// Get degree of a node (incoming edges)
    ☉ λ in_degree(node: &NodeId) -> usize {
        self.incoming.get(node)
            .map(|e| e.len())
            .unwrap_or(0)
    }

    /// Get total degree of a node
    ☉ λ degree(node: &NodeId) -> usize {
        self.out_degree(node) + self.in_degree(node)
    }

    // ========================================================================
    // Stats
    // ========================================================================

    ☉ λ node_count() -> usize {
        self.nodes.len()
    }

    ☉ λ edge_count() -> usize {
        self.edge_count
    }

    ☉ λ is_empty() -> bool {
        self.nodes.is_empty()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    λ make_id(n: u8) -> NodeId {
        NodeId·from_bytes([n; 16])
    }

    #[test]
    λ test_add_and_traverse() {
        ≔ Δ index = GraphIndex·new();

        ≔ a = make_id(1);
        ≔ b = make_id(2);
        ≔ c = make_id(3);
        ≔ e1 = EdgeId·from_bytes([10; 16]);
        ≔ e2 = EdgeId·from_bytes([11; 16]);

        index.add_edge(a.clone(), b.clone(), e1, Relation·RelatedTo);
        index.add_edge(b.clone(), c.clone(), e2, Relation·RelatedTo);

        ≔ neighbors = index.neighbors_out(&a);
        assert_eq!(neighbors.len(), 1);
        assert_eq!(neighbors[0].0, b);

        ≔ reachable = index.bfs(&a, 2);
        assert_eq!(reachable.len(), 3);
    }

    #[test]
    λ test_paths() {
        ≔ Δ index = GraphIndex·new();

        ≔ a = make_id(1);
        ≔ b = make_id(2);
        ≔ c = make_id(3);

        index.add_edge(a.clone(), b.clone(), EdgeId·from_bytes([1; 16]), Relation·RelatedTo);
        index.add_edge(b.clone(), c.clone(), EdgeId·from_bytes([2; 16]), Relation·RelatedTo);
        index.add_edge(a.clone(), c.clone(), EdgeId·from_bytes([3; 16]), Relation·RelatedTo);

        ≔ paths = index.paths(&a, &c, 3);
        assert_eq!(paths.len(), 2); // Direct and via b
    }
}
