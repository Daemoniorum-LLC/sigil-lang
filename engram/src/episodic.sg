// Episodic Memory Module
// Experience memory - what happened over time

// ============================================================================
// Episodic Memory
// ============================================================================

/// Episodic Memory - the agent's autobiographical record
///
/// Stores experiences as episodes - time-bounded events with context,
/// participants, and outcomes. Episodes decay unless reinforced and
/// can consolidate into semantic facts or procedural skills.
☉ Σ EpisodicMemory {
    /// Episodes indexed by time
    episodes: Array,

    /// Configuration
    config: EpisodicConfig,

    /// Last decay application
    last_decay: Int,
}

⊢ EpisodicMemory {
    // ========================================================================
    // Construction
    // ========================================================================

    ☉ rite new(config) {
        EpisodicMemory {
            episodes: [],
            config: config,
            last_decay: Sys·clock_gettime(),
        }
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    /// Record a new episode
    ☉ rite record(self, episode) {
        push(self.episodes, episode);
        ↩ episode.id;
    }

    /// Recall all episodes
    ☉ rite recall(self) {
        ↩ self.episodes;
    }

    /// Recall episodes above a strength threshold
    ☉ rite recall_strong(self, threshold) {
        ≔ mut result = [];
        ≔ mut i = 0;
        ⟳ i < len(self.episodes) {
            ⎇ self.episodes[i].strength > threshold {
                push(result, self.episodes[i]);
            }
            i = i + 1;
        }
        ↩ result;
    }

    /// Get episode count
    ☉ rite count(self) {
        ↩ len(self.episodes);
    }
}

// ============================================================================
// Episode Structure
// ============================================================================

/// An episode - a bounded experience in time
☉ Σ Episode {
    id: String,

    // Temporal bounds
    started_at: Int,
    ended_at: Int,

    // Context
    context: String,

    // Outcome summary
    outcome: String,

    // Evaluation
    valence: Float,
    significance: Float,
    strength: Float,
    access_count: Int,
    last_accessed: Int,
    consolidated: Bool,
}

⊢ Episode {
    ☉ rite new(context) {
        Episode {
            id: uuid_v4(),
            started_at: Sys·clock_gettime(),
            ended_at: 0,
            context: context,
            outcome: "ongoing",
            valence: 0.0,
            significance: 0.0,
            strength: 1.0,
            access_count: 0,
            last_accessed: Sys·clock_gettime(),
            consolidated: false,
        }
    }

    ☉ rite end(self, outcome) {
        self.ended_at = Sys·clock_gettime();
        self.outcome = outcome;
    }

    ☉ rite is_ongoing(self) {
        ↩ self.ended_at == 0;
    }
}

// ============================================================================
// Episode Configuration
// ============================================================================

/// Configuration for episodic memory
☉ Σ EpisodicConfig {
    /// Decay rate per hour (0.0 - 1.0)
    decay_rate: Float,

    /// Strength threshold for consolidation eligibility
    consolidation_threshold: Float,

    /// Maximum number of active episodes
    max_active_episodes: Int,

    /// Minimum significance to prevent automatic archival
    min_significance_to_keep: Float,
}

⊢ EpisodicConfig {
    ☉ rite default() {
        EpisodicConfig {
            decay_rate: 0.1,
            consolidation_threshold: 0.3,
            max_active_episodes: 10000,
            min_significance_to_keep: 0.1,
        }
    }

    ☉ rite new(path) {
        EpisodicConfig {
            decay_rate: 0.1,
            consolidation_threshold: 0.3,
            max_active_episodes: 10000,
            min_significance_to_keep: 0.1,
        }
    }
}

// ============================================================================
// Consolidation Report
// ============================================================================

/// Consolidation report for episodic memory
☉ Σ EpisodicConsolidationReport {
    consolidated_count: Int,
    skills_learned: Array,
    facts_extracted: Array,
}
