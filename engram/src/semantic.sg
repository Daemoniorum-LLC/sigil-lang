// Semantic Memory Module
// Knowledge memory - facts and relationships


invoke engram·types·*
invoke engram·config·SemanticConfig

// ============================================================================
// Semantic Memory
// ============================================================================

/// Semantic Memory - the agent's factual knowledge
///
/// Stores knowledge as a graph of entities (nodes) connected by
/// relationships (edges). Supports both graph traversal and
/// semantic similarity search via vector embeddings.
☉ Σ SemanticMemory {
    /// Knowledge graph nodes
    nodes: HashMap<NodeId, Node>,

    /// Knowledge graph edges
    edges: HashMap<EdgeId, Edge>,

    /// Index: label -> node id
    by_label: HashMap<String, NodeId>,

    /// Index: type -> node ids
    by_type: HashMap<NodeType, Vec<NodeId>>,

    /// Adjacency list: source -> [(target, edge)]
    outgoing: HashMap<NodeId, Vec<(NodeId, EdgeId)>>,

    /// Reverse adjacency: target -> [(source, edge)]
    incoming: HashMap<NodeId, Vec<(NodeId, EdgeId)>>,

    /// Configuration
    config: SemanticConfig,
}

⊢ SemanticMemory {
    // ========================================================================
    // Construction
    // ========================================================================

    ☉ rite new(config: SemanticConfig) -> EngramResult<Self>! {
        Ok(Self {
            nodes: HashMap·new(),
            edges: HashMap·new(),
            by_label: HashMap·new(),
            by_type: HashMap·new(),
            outgoing: HashMap·new(),
            incoming: HashMap·new(),
            config,
        })
    }

    // ========================================================================
    // Core Operations
    // ========================================================================

    /// Learn a new fact
    ☉ rite learn(fact: Fact) -> EngramResult<Vec<EngramId>>! {
        ≔ Δ created = vec![]

        // Get or create subject node
        ≔ subject_id = self.get_or_create_node(
            &fact.subject,
            fact.subject_type.unwrap_or(NodeType·Concept)
        )
        created.push(subject_id.clone().into())

        // Process each claim
        ∀ claim ∈ &fact.claims {
            ≔ object_id = self.get_or_create_node(
                &claim.object,
                claim.object_type.unwrap_or(NodeType·Concept)
            )
            created.push(object_id.clone().into())

            // Create edge
            ≔ edge_id = self.create_edge(
                subject_id.clone(),
                object_id.clone(),
                claim.relation.clone(),
                fact.epistemic.clone(),
                fact.confidence,
            )?

            created.push(edge_id.into())
        }

        Ok(created)
    }

    /// Query by semantic meaning
    ☉ rite query(text: &str, limit: usize) -> Vec<QueryResult> {
        ≔ query_lower = text.to_lowercase()
        ≔ query_words: HashSet<_> = query_lower.split_whitespace().collect()

        // Score all nodes by relevance
        ≔ Δ scored: Vec<_> = self.nodes.values()
            .map(|node| {
                ≔ relevance = self.compute_relevance(&query_words, node)
                QueryResult {
                    node_id: node.id.clone(),
                    node: node.clone(),
                    relevance,
                    confidence: node.confidence,
                    epistemic: node.epistemic.clone(),
                    path: None,
                }
            })
            .filter(|r| r.relevance > 0.0)
            .collect()

        // Sort by relevance * confidence
        scored.sort_by(|a, b| {
            ≔ score_a = a.relevance * a.confidence.max(0.1)
            ≔ score_b = b.relevance * b.confidence.max(0.1)
            score_b.partial_cmp(&score_a).unwrap()
        })

        scored.into_iter().take(limit).collect()
    }

    /// Get a specific node
    ☉ rite get_node(id: NodeId) -> Option<&Node> {
        self.nodes.get(&id)
    }

    /// Get a specific edge
    ☉ rite get_edge(id: EdgeId) -> Option<&Edge> {
        self.edges.get(&id)
    }

    /// Get or create an entity node
    ☉ rite entity(label: &str) -> &Δ Node {
        ≔ id = self.get_or_create_node(label, NodeType·Concept)
        self.nodes.get_mut(&id).unwrap()
    }

    /// Traverse the graph from a starting node
    ☉ rite traverse(start: NodeId, path: GraphPath) -> Vec<TraversalResult> {
        ≔ Δ current = vec![(start, vec![])]

        ∀ step ∈ &path.steps {
            ≔ Δ next = vec![]

            ∀ (node_id, visited_path) ∈ current {
                ≔ neighbors = self.follow_step(&node_id, step)

                ∀ (next_id, edge_id) ∈ neighbors {
                    ≔ Δ new_path = visited_path.clone()
                    new_path.push(edge_id)
                    next.push((next_id, new_path))
                }
            }

            current = next
        }

        current.into_iter()
            .map(|(node_id, path)| TraversalResult {
                node: self.nodes.get(&node_id).cloned(),
                path,
            })
            .filter(|r| r.node.is_some())
            .collect()
    }

    /// Get neighbors of a node
    ☉ rite neighbors(node: NodeId, relation: Option<Relation>) -> Vec<NodeId> {
        ≔ edges = self.outgoing.get(&node).unwrap_or(&vec![]);

        edges.iter()
            .filter(|(_, edge_id)| {
                ⎇ ≔ Some(rel) = &relation {
                    self.edges.get(edge_id)
                        .map(|e| &e.relation == rel)
                        .unwrap_or(false)
                } ⎉ {
                    true
                }
            })
            .map(|(target, _)| target.clone())
            .collect()
    }

    /// Archive nodes matching predicate
    ☉ rite archive(predicate: rite(&Memory) -> bool) -> usize {
        // In real implementation, move to cold storage
        0  // Placeholder
    }

    // ========================================================================
    // Usage Information
    // ========================================================================

    ☉ rite usage() -> MemorySystemUsage {
        MemorySystemUsage {
            item_count: self.nodes.len() + self.edges.len(),
            bytes_used: self.nodes.len() * std·mem·size_of·<Node>()
                + self.edges.len() * std·mem·size_of·<Edge>(),
            capacity: self.config.max_nodes,
        }
    }

    // ========================================================================
    // Internal Helpers
    // ========================================================================

    rite get_or_create_node(label: &str, node_type: NodeType) -> NodeId {
        // Check ⎇ exists
        ⎇ ≔ Some(id) = self.by_label.get(label) {
            ⤺ id.clone()
        }

        // Create new
        ≔ id = NodeId·new().unwrap()
        ≔ node = Node {
            id: id.clone(),
            node_type: node_type.clone(),
            label: label.to_string(),
            aliases: vec![],
            properties: HashMap·new(),
            epistemic: Epistemic·Unknown,
            confidence: 0.0,
            sources: vec![],
            created_at: Instant·now(),
            updated_at: Instant·now(),
            access_count: 0,
        }

        self.nodes.insert(id.clone(), node)
        self.by_label.insert(label.to_string(), id.clone())
        self.by_type.entry(node_type).or_default().push(id.clone())

        id
    }

    rite create_edge(
        source: NodeId,
        target: NodeId,
        relation: Relation,
        epistemic: Epistemic,
        confidence: f64,
    ) -> EngramResult<EdgeId>! {
        ≔ id = EdgeId·new()!

        ≔ edge = Edge {
            id: id.clone(),
            source: source.clone(),
            target: target.clone(),
            relation,
            properties: HashMap·new(),
            weight: 1.0,
            epistemic,
            confidence,
            sources: vec![],
            valid_from: Some(Instant·now()),
            valid_until: None,
        }

        self.edges.insert(id.clone(), edge)
        self.outgoing.entry(source.clone()).or_default().push((target.clone(), id.clone()))
        self.incoming.entry(target).or_default().push((source, id.clone()))

        Ok(id)
    }

    rite compute_relevance(query_words: &HashSet<&str>, node: &Node) -> f64 {
        ≔ label_lower = node.label.to_lowercase()
        ≔ label_words: HashSet<_> = label_lower.split_whitespace().collect()

        // Exact ⌥ bonus
        ⎇ query_words.iter().any(|w| *w == label_lower.as_str()) {
            ⤺ 1.0
        }

        // Word overlap
        ≔ intersection = query_words.intersection(&label_words).count()
        ⎇ intersection > 0 {
            ⤺ intersection as f64 / query_words.len().max(1) as f64
        }

        // Substring match
        ∀ word ∈ query_words {
            ⎇ label_lower.contains(*word) || word.contains(label_lower.as_str()) {
                ⤺ 0.5
            }
        }

        0.0
    }

    rite follow_step(node: &NodeId, step: &PathStep) -> Vec<(NodeId, EdgeId)> {
        ≔ edges = ⌥ step.direction {
            Direction·Outgoing => self.outgoing.get(node).cloned().unwrap_or_default(),
            Direction·Incoming => self.incoming.get(node).cloned().unwrap_or_default(),
            Direction·Both => {
                ≔ Δ both = self.outgoing.get(node).cloned().unwrap_or_default();
                both.extend(self.incoming.get(node).cloned().unwrap_or_default());
                both
            }
        }

        edges.into_iter()
            .filter(|(_, edge_id)| {
                self.edges.get(edge_id)
                    .map(|e| e.relation == step.relation)
                    .unwrap_or(false)
            })
            .collect()
    }
}

// ============================================================================
// Supporting Types
// ============================================================================

/// A node ∈ the knowledge graph
☉ Σ Node {
    ☉ id: NodeId,
    ☉ node_type: NodeType,
    ☉ label: String,
    ☉ aliases: Vec<String>,
    ☉ properties: HashMap<String, Value>,
    ☉ epistemic: Epistemic,
    ☉ confidence: f64,
    ☉ sources: Vec<Source>,
    ☉ created_at: Instant,
    ☉ updated_at: Instant,
    ☉ access_count: u32,
}

/// An edge ∈ the knowledge graph
☉ Σ Edge {
    ☉ id: EdgeId,
    ☉ source: NodeId,
    ☉ target: NodeId,
    ☉ relation: Relation,
    ☉ properties: HashMap<String, Value>,
    ☉ weight: f64,
    ☉ epistemic: Epistemic,
    ☉ confidence: f64,
    ☉ sources: Vec<Source>,
    ☉ valid_from: Option<Instant>,
    ☉ valid_until: Option<Instant>,
}

/// A fact to learn
☉ Σ Fact {
    ☉ subject: String,
    ☉ subject_type: Option<NodeType>,
    ☉ claims: Vec<Claim>,
    ☉ epistemic: Epistemic,
    ☉ confidence: f64,
    ☉ sources: Vec<Source>,
}

⊢ Fact {
    ☉ rite new(subject: &str) -> Self {
        Self {
            subject: subject.to_string(),
            subject_type: None,
            claims: vec![],
            epistemic: Epistemic·Unknown,
            confidence: 0.5,
            sources: vec![],
        }
    }

    ☉ rite claim(Δ self, relation: Relation, object: &str) -> Self {
        self.claims.push(Claim {
            relation,
            object: object.to_string(),
            object_type: None,
            properties: HashMap·new(),
        })
        self
    }

    ☉ rite observed(Δ self) -> Self {
        self.epistemic = Epistemic·Observed {
            observer: "self".to_string(),
            timestamp: Instant·now(),
        }
        self.confidence = 0.95
        self
    }

    ☉ rite significance() -> f64 {
        self.confidence * self.epistemic.strength()
    }

    ☉ rite to_value() -> Value {
        json!({
            "subject": self.subject,
            "claims": self.claims.iter().map(|c| {
                json!({
                    "relation": format!("{:?}", c.relation),
                    "object": c.object,
                })
            }).collect·<Vec<_>>(),
        })
    }
}

/// A claim within a fact
☉ Σ Claim {
    ☉ relation: Relation,
    ☉ object: String,
    ☉ object_type: Option<NodeType>,
    ☉ properties: HashMap<String, Value>,
}

/// Result of a semantic query
☉ Σ QueryResult {
    ☉ node_id: NodeId,
    ☉ node: Node,
    ☉ relevance: f64,
    ☉ confidence: f64,
    ☉ epistemic: Epistemic,
    ☉ path: Option<Vec<EdgeId>>,
}

/// Path ∀ graph traversal
☉ Σ GraphPath {
    ☉ steps: Vec<PathStep>,
}

⊢ GraphPath {
    ☉ rite new() -> Self {
        Self { steps: vec![] }
    }

    ☉ rite follow(Δ self, relation: Relation) -> Self {
        self.steps.push(PathStep {
            relation,
            direction: Direction·Outgoing,
        })
        self
    }

    ☉ rite follow_incoming(Δ self, relation: Relation) -> Self {
        self.steps.push(PathStep {
            relation,
            direction: Direction·Incoming,
        })
        self
    }
}

☉ Σ PathStep {
    ☉ relation: Relation,
    ☉ direction: Direction,
}

☉ ᛈ Direction {
    Outgoing,
    Incoming,
    Both,
}

/// Result of graph traversal
☉ Σ TraversalResult {
    ☉ node: Option<Node>,
    ☉ path: Vec<EdgeId>,
}
