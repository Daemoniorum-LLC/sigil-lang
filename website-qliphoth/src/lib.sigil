//! Sigil Language Website
//!
//! The official website for the Sigil programming language, built entirely in Sigil
//! using the Qliphoth framework.
//!
//! ## Architecture
//!
//! - `pages.sigil` - Page components for each route
//! - `components.sigil` - Reusable site-specific components
//!
//! ## Qliphoth Framework
//!
//! Built with the React-inspired Qliphoth framework:
//! - Signal-based reactivity
//! - Component-based architecture
//! - Compiles to WebAssembly with zero JavaScript

// Core dependencies - Qliphoth framework
☉ use qliphoth::prelude::*

// Application modules
☉ mod pages;
☉ mod components;

use sigil_web::prelude::*
use qliphoth::routes::{Router, Route}
use qliphoth::theme::inject_styles

/// Custom theme overrides for sigil-lang.com
/// Extends Qliphoth's Corporate Goth with IBM Plex fonts
mod theme {
    use qliphoth::tokens::*

    /// Sigil-lang specific colors
    ☉ mod colors {
        /// Primary accent - Phthalo Green (matches Qliphoth)
        ☉ const ACCENT: &str = "#14A088";
        ☉ const ACCENT_LIGHT: &str = "#1AB89D";
        ☉ const ACCENT_DARK: &str = "#0E6B5C";
        ☉ const ACCENT_GLOW: &str = "rgba(20, 160, 136, 0.25)";

        /// Evidentiality markers - WCAG AA compliant
        ☉ const KNOWN: &str = "#14A088";        // ! green
        ☉ const UNCERTAIN: &str = "#D4A017";    // ? gold
        ☉ const REPORTED: &str = "#6B9BD1";     // ~ blue
        ☉ const PARADOX: &str = "#D47171";      // ‽ red

        /// Backgrounds - deep gothic blacks
        ☉ const BG_PRIMARY: &str = "#050507";
        ☉ const BG_SECONDARY: &str = "#0a0a0d";
        ☉ const BG_TERTIARY: &str = "#0f0f12";
        ☉ const BG_CARD: &str = "#0c0c0f";

        /// Text - readable on dark
        ☉ const TEXT_PRIMARY: &str = "#e8e8ec";
        ☉ const TEXT_SECONDARY: &str = "#a0a0aa";
        ☉ const TEXT_MUTED: &str = "#6c6c76";
    }

    /// Typography - IBM Plex family
    ☉ mod typography {
        ☉ const FONT_SANS: &str = "'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";
        ☉ const FONT_MONO: &str = "'IBM Plex Mono', 'JetBrains Mono', 'SF Mono', monospace";
    }

    /// Generate site-specific CSS
    ☉ rite generate_site_css() → !String {
        format!(r#"
/* Sigil Language Website - Custom Styles */

/* IBM Plex font overrides */
body {{
    font-family: {font_sans};
}}

code, pre, .code-block {{
    font-family: {font_mono};
}}

/* Evidentiality marker styles */
.ev {{
    font-weight: 600;
    padding: 0 0.25rem;
    border-radius: 0.125rem;
}}
.ev-known {{
    color: {known};
    background: rgba(20, 160, 136, 0.12);
}}
.ev-uncertain {{
    color: {uncertain};
    background: rgba(212, 160, 23, 0.12);
}}
.ev-reported {{
    color: {reported};
    background: rgba(107, 155, 209, 0.12);
}}
.ev-paradox {{
    color: {paradox};
    background: rgba(212, 113, 113, 0.12);
}}

/* Morpheme operator highlighting */
.morpheme {{
    color: {accent_light};
    font-weight: 500;
}}

/* Announcement banner */
.announcement-banner {{
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 110;
    background: linear-gradient(90deg, {accent_dark} 0%, {accent} 100%);
    padding: 0.5rem 1.5rem;
    text-align: center;
}}

.announcement-container {{
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
}}

.announcement-badge {{
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    background: rgba(0, 0, 0, 0.2);
    color: #ffffff;
    border-radius: 0.25rem;
    letter-spacing: 0.05em;
}}

.announcement-text {{
    font-size: 0.9375rem;
    color: #ffffff;
    margin: 0;
}}

.announcement-link {{
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-left: 0.5rem;
}}
"#,
            font_sans = typography::FONT_SANS,
            font_mono = typography::FONT_MONO,
            known = colors::KNOWN,
            uncertain = colors::UNCERTAIN,
            reported = colors::REPORTED,
            paradox = colors::PARADOX,
            accent = colors::ACCENT,
            accent_light = colors::ACCENT_LIGHT,
            accent_dark = colors::ACCENT_DARK,
        )
    }
}

/// Main application component
☉ sigil App { }

⊢ App {
    ☉ rite new() → This! {
        App { }
    }
}

⊢ Component for App {
    rite render(&this) → VNode! {
        // Initialize theme styles on first render
        use_effect(|| {
            inject_styles()
            inject_site_styles()
            || { }
        })

        // Router with page components
        fragment()
            ·child(components::AnnouncementBanner::new()·to_vnode())
            ·child(components::Nav::new()·to_vnode())
            ·child(
                main_elem()
                    ·id("main-content")
                    ·child(
                        Router::new()
                            ·route("/", pages::Home::new())
                            ·route("/pages/learn.html", pages::Learn::new())
                            ·route("/pages/docs.html", pages::Docs::new())
                            ·route("/pages/playground.html", pages::Playground::new())
                            ·route("/pages/agents.html", pages::Agents::new())
                            ·route("/pages/pattern.html", pages::Pattern::new())
                            ·route("/pages/examples.html", pages::Examples::new())
                            ·route("/pages/contributing.html", pages::Contributing::new())
                            ·route("*", pages::NotFound::new())
                            ·to_vnode()
                    )
                    ·to_vnode()
            )
            ·child(components::Footer::new()·to_vnode())
            ·to_vnode()
    }

    rite props_to_map(&this) → HashMap<String, PropValue>! {
        HashMap::new()
    }

    rite from_props(_props: HashMap<String, PropValue>) → This! {
        App::new()
    }
}

/// Inject site-specific styles into the DOM
rite inject_site_styles() {
    ≔ document! = web_sys·window()
        ·and_then(|w| w·document())
        ·expect("No document")

    ≔ style! = document·create_element("style")·unwrap()
    style·set_text_content(Some(&theme::generate_site_css()))
    style·set_attribute("data-sigil-lang", "theme")·ok()

    document·head()
        ·expect("No head")
        ·append_child(&style)
        ·ok()
}

/// WASM entry point
#[wasm_bindgen(start)]
☉ rite main() {
    // Set panic hook for better error messages
    console_error_panic_hook·set_once()

    // Mount the application
    sigil_web·mount::<App>(
        web_sys·window()
            ·unwrap()
            ·document()
            ·unwrap()
            ·get_element_by_id("app")
            ·unwrap()
    )
}
