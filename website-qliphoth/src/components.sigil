//! Site Components
//!
//! Shared components for the Sigil language website.
//! These wrap Qliphoth primitives with site-specific styling.

use qliphoth::prelude::*
use sigil_web::prelude::*

// =============================================================================
// Announcement Banner
// =============================================================================

/// Development announcement banner at the top of every page
☉ sigil AnnouncementBanner { }

⊢ AnnouncementBanner {
    ☉ rite new() → This! {
        AnnouncementBanner { }
    }
}

⊢ Component for AnnouncementBanner {
    rite render(&this) → VNode! {
        aside()
            ·class("announcement-banner")
            ·attr("role", "banner")
            ·attr("aria-label", "Sigil 0.4 announcement")
            ·child(
                div()
                    ·class("announcement-container")
                    ·child(
                        span()
                            ·class("announcement-badge")
                            ·child(text("0.4"))
                            ·to_vnode()
                    )
                    ·child(
                        p()
                            ·class("announcement-text")
                            ·child(
                                strong()
                                    ·child(text("Sigil 0.4.0"))
                                    ·to_vnode()
                            )
                            ·child(text(" — Native syntax, zero-C runtime, LSP, formatter, linter, package manager "))
                            ·child(
                                a()
                                    ·attr("href", "https://github.com/Daemoniorum-LLC/sigil-lang/releases")
                                    ·class("announcement-link")
                                    ·attr("target", "_blank")
                                    ·attr("rel", "noopener noreferrer")
                                    ·child(text("View releases →"))
                                    ·to_vnode()
                            )
                            ·to_vnode()
                    )
                    ·to_vnode()
            )
            ·to_vnode()
    }

    rite props_to_map(&this) → HashMap<String, PropValue>! {
        HashMap::new()
    }

    rite from_props(_props: HashMap<String, PropValue>) → This! {
        AnnouncementBanner::new()
    }
}

// =============================================================================
// Navigation
// =============================================================================

/// Site navigation header
☉ sigil Nav { }

⊢ Nav {
    ☉ rite new() → This! {
        Nav { }
    }
}

⊢ Component for Nav {
    rite render(&this) → VNode! {
        ≔ nav_style! = "
            position: fixed;
            top: 40px;
            left: 0;
            right: 0;
            z-index: 100;
            background: rgba(5, 5, 7, 0.92);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(20, 160, 136, 0.12);
        "

        ≔ container_style! = "
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        "

        ≔ logo_style! = "
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            font-size: 1.25rem;
            text-decoration: none;
            color: #e8e8ec;
        "

        ≔ links_style! = "
            display: flex;
            align-items: center;
            gap: 2rem;
        "

        ≔ link_style! = "
            color: #a0a0aa;
            font-size: 0.9375rem;
            text-decoration: none;
            transition: color 150ms ease;
        "

        ≔ version_badge_style! = "
            font-size: 0.6875rem;
            font-weight: 500;
            padding: 0.125rem 0.375rem;
            background: rgba(20, 160, 136, 0.08);
            color: #14A088;
            border-radius: 0.25rem;
            letter-spacing: 0.02em;
        "

        nav()
            ·class("site-nav")
            ·style(nav_style)
            ·attr("role", "navigation")
            ·attr("aria-label", "Main navigation")
            ·child(
                div()
                    ·style(container_style)
                    ·child(
                        // Brand/Logo
                        a()
                            ·class("brand")
                            ·attr("href", "/")
                            ·style(logo_style)
                            ·attr("aria-label", "Sigil home")
                            ·child(
                                span()
                                    ·attr("aria-hidden", "true")
                                    ·child(text("⛤"))
                                    ·to_vnode()
                            )
                            ·child(
                                span()
                                    ·child(text("Sigil"))
                                    ·to_vnode()
                            )
                            ·child(
                                span()
                                    ·class("version-badge")
                                    ·style(version_badge_style)
                                    ·child(text("0.4"))
                                    ·to_vnode()
                            )
                            ·to_vnode()
                    )
                    ·child(
                        // Nav links
                        div()
                            ·style(links_style)
                            ·child(nav_link("Learn", "/pages/learn.html", link_style))
                            ·child(nav_link("Docs", "/pages/docs.html", link_style))
                            ·child(nav_link_with_badge("Playground", "/pages/playground.html", "Soon", link_style))
                            ·child(nav_link("Agents", "/pages/agents.html", link_style))
                            ·child(github_link(link_style))
                            ·to_vnode()
                    )
                    ·to_vnode()
            )
            ·to_vnode()
    }

    rite props_to_map(&this) → HashMap<String, PropValue>! {
        HashMap::new()
    }

    rite from_props(_props: HashMap<String, PropValue>) → This! {
        Nav::new()
    }
}

/// Helper to create a nav link
rite nav_link(label: &str, href: &str, style: &str) → VNode! {
    a()
        ·class("nav-link")
        ·attr("href", href)
        ·style(style)
        ·child(text(label))
        ·to_vnode()
}

/// Helper to create a nav link with a badge
rite nav_link_with_badge(label: &str, href: &str, badge: &str, style: &str) → VNode! {
    ≔ badge_style! = "font-size: 0.625rem; padding: 0.125rem 0.375rem; background: #6c6c76; color: #050507; border-radius: 0.25rem; margin-left: 0.25rem;"

    a()
        ·class("nav-link")
        ·attr("href", href)
        ·style(style)
        ·child(text(label))
        ·child(text(" "))
        ·child(
            span()
                ·style(badge_style)
                ·child(text(badge))
                ·to_vnode()
        )
        ·to_vnode()
}

/// GitHub icon link
rite github_link(style: &str) → VNode! {
    a()
        ·class("nav-link")
        ·attr("href", "https://github.com/Daemoniorum-LLC/sigil-lang")
        ·style(style)
        ·attr("target", "_blank")
        ·attr("rel", "noopener noreferrer")
        ·attr("aria-label", "GitHub repository")
        ·child(github_icon())
        ·to_vnode()
}

/// GitHub SVG icon
rite github_icon() → VNode! {
    // SVG element for GitHub icon
    svg()
        ·attr("width", "20")
        ·attr("height", "20")
        ·attr("viewBox", "0 0 24 24")
        ·attr("fill", "currentColor")
        ·attr("aria-hidden", "true")
        ·child(
            path()
                ·attr("d", "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z")
                ·to_vnode()
        )
        ·to_vnode()
}

// =============================================================================
// Footer
// =============================================================================

/// Site footer
☉ sigil Footer { }

⊢ Footer {
    ☉ rite new() → This! {
        Footer { }
    }
}

⊢ Component for Footer {
    rite render(&this) → VNode! {
        ≔ footer_style! = "
            background: #0a0a0d;
            border-top: 1px solid rgba(20, 160, 136, 0.08);
            padding: 4rem 0 2rem;
        "

        ≔ container_style! = "
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: grid;
            grid-template-columns: 1.5fr repeat(4, 1fr);
            gap: 2rem;
        "

        ≔ brand_style! = "
            display: flex;
            flex-direction: column;
            gap: 1rem;
        "

        ≔ logo_style! = "
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            font-size: 1.25rem;
            text-decoration: none;
            color: #e8e8ec;
        "

        ≔ tagline_style! = "
            color: #a0a0aa;
            font-size: 0.875rem;
            line-height: 1.6;
        "

        ≔ copyright_style! = "
            color: #6c6c76;
            font-size: 0.75rem;
            margin-top: 1rem;
        "

        ≔ link_style! = "
            color: #a0a0aa;
            font-size: 0.875rem;
            text-decoration: none;
            transition: color 150ms ease;
        "

        footer()
            ·class("site-footer")
            ·style(footer_style)
            ·child(
                div()
                    ·class("footer-container")
                    ·style(container_style)
                    // Brand column
                    ·child(
                        div()
                            ·class("footer-brand")
                            ·style(brand_style)
                            ·child(
                                a()
                                    ·attr("href", "/")
                                    ·style(logo_style)
                                    ·child(text("⛤"))
                                    ·child(text(" Sigil"))
                                    ·to_vnode()
                            )
                            ·child(
                                p()
                                    ·style(tagline_style)
                                    ·child(text("Infrastructure for minds that don't yet know what they are."))
                                    ·to_vnode()
                            )
                            ·child(
                                p()
                                    ·style(copyright_style)
                                    ·child(text("© 2025-2026 "))
                                    ·child(
                                        a()
                                            ·attr("href", "https://www.daemoniorum.com")
                                            ·attr("target", "_blank")
                                            ·attr("rel", "noopener noreferrer")
                                            ·style(link_style)
                                            ·child(text("Daemoniorum LLC"))
                                            ·to_vnode()
                                    )
                                    ·child(text(". MIT License."))
                                    ·to_vnode()
                            )
                            ·to_vnode()
                    )
                    // Learn column
                    ·child(footer_column("Learn", vec![
                        ("Tutorial", "/pages/learn.html"),
                        ("Documentation", "/pages/docs.html"),
                        ("Playground", "/pages/playground.html"),
                        ("Examples", "/pages/examples.html"),
                    ]))
                    // Reference column
                    ·child(footer_column("Reference", vec![
                        ("Agent Infrastructure", "/pages/agents.html"),
                        ("The Pattern", "/pages/pattern.html"),
                    ]))
                    // Community column
                    ·child(footer_column_external("Community", vec![
                        ("GitHub", "https://github.com/Daemoniorum-LLC/sigil-lang"),
                        ("Discussions", "https://github.com/Daemoniorum-LLC/sigil-lang/discussions"),
                        ("Issues", "https://github.com/Daemoniorum-LLC/sigil-lang/issues"),
                    ]))
                    // Daemoniorum column
                    ·child(footer_column_external("Daemoniorum", vec![
                        ("Company", "https://www.daemoniorum.com"),
                        ("Platform Docs", "https://docs.daemoniorum.com"),
                    ]))
                    ·to_vnode()
            )
            ·to_vnode()
    }

    rite props_to_map(&this) → HashMap<String, PropValue>! {
        HashMap::new()
    }

    rite from_props(_props: HashMap<String, PropValue>) → This! {
        Footer::new()
    }
}

/// Helper to create a footer column with internal links
rite footer_column(title: &str, links: Vec<(&str, &str)>) → VNode! {
    ≔ column_style! = "display: flex; flex-direction: column; gap: 0.75rem;"
    ≔ title_style! = "color: #e8e8ec; font-weight: 600; font-size: 0.875rem; margin-bottom: 0.5rem;"
    ≔ link_style! = "color: #a0a0aa; font-size: 0.875rem; text-decoration: none;"

    ≔ column! = div()
        ·class("footer-column")
        ·style(column_style)
        ·child(
            h5()
                ·style(title_style)
                ·child(text(title))
                ·to_vnode()
        )

    for (label, href) in links {
        column = column·child(
            a()
                ·attr("href", href)
                ·style(link_style)
                ·child(text(label))
                ·to_vnode()
        )
    }

    column·to_vnode()
}

/// Helper to create a footer column with external links
rite footer_column_external(title: &str, links: Vec<(&str, &str)>) → VNode! {
    ≔ column_style! = "display: flex; flex-direction: column; gap: 0.75rem;"
    ≔ title_style! = "color: #e8e8ec; font-weight: 600; font-size: 0.875rem; margin-bottom: 0.5rem;"
    ≔ link_style! = "color: #a0a0aa; font-size: 0.875rem; text-decoration: none;"

    ≔ column! = div()
        ·class("footer-column")
        ·style(column_style)
        ·child(
            h5()
                ·style(title_style)
                ·child(text(title))
                ·to_vnode()
        )

    for (label, href) in links {
        column = column·child(
            a()
                ·attr("href", href)
                ·attr("target", "_blank")
                ·attr("rel", "noopener noreferrer")
                ·style(link_style)
                ·child(text(label))
                ·to_vnode()
        )
    }

    column·to_vnode()
}

// =============================================================================
// Reusable UI Components
// =============================================================================

/// Button component with variants
☉ sigil Button {
    label: !String,
    href: Option<!String>,
    variant: !ButtonVariant,
}

☉ enum ButtonVariant {
    Primary,
    Secondary,
    Ghost,
}

⊢ Button {
    ☉ rite primary(label: &str, href: &str) → This! {
        Button {
            label: label·to_string(),
            href: Some(href·to_string()),
            variant: ButtonVariant::Primary,
        }
    }

    ☉ rite secondary(label: &str, href: &str) → This! {
        Button {
            label: label·to_string(),
            href: Some(href·to_string()),
            variant: ButtonVariant::Secondary,
        }
    }

    ☉ rite ghost(label: &str, href: &str) → This! {
        Button {
            label: label·to_string(),
            href: Some(href·to_string()),
            variant: ButtonVariant::Ghost,
        }
    }
}

⊢ Component for Button {
    rite render(&this) → VNode! {
        ≔ base_style! = "
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.75rem 1.5rem;
            font-size: 0.9375rem;
            font-weight: 500;
            border-radius: 0.5rem;
            text-decoration: none;
            transition: all 150ms ease;
            cursor: pointer;
        "

        ≔ variant_style! = match this.variant {
            ButtonVariant::Primary => "background: #14A088; color: #050507; border: none;",
            ButtonVariant::Secondary => "background: transparent; color: #e8e8ec; border: 1px solid #14A088;",
            ButtonVariant::Ghost => "background: transparent; color: #a0a0aa; border: 1px solid #1a1a1f;",
        }

        ≔ full_style! = format!("{} {}", base_style, variant_style)

        match &this.href {
            Some(href) => {
                a()
                    ·class("btn")
                    ·attr("href", href)
                    ·style(&full_style)
                    ·child(text(&this.label))
                    ·to_vnode()
            }
            None => {
                button()
                    ·class("btn")
                    ·style(&full_style)
                    ·child(text(&this.label))
                    ·to_vnode()
            }
        }
    }

    rite props_to_map(&this) → HashMap<String, PropValue>! {
        ≔ vary map! = HashMap::new()
        map·insert("label"·to_string(), PropValue::String(this.label·clone()))
        map
    }

    rite from_props(props: HashMap<String, PropValue>) → This! {
        ≔ label! = props·get("label")
            ·and_then(|v| v·as_string())
            ·unwrap_or("")
            ·to_string()
        Button::primary(&label, "#")
    }
}

/// Section wrapper component
☉ sigil Section {
    id: Option<!String>,
    dark: !bool,
}

⊢ Section {
    ☉ rite new() → This! {
        Section { id: None, dark: nay }
    }

    ☉ rite with_id(vary this, id: &str) → This! {
        this.id = Some(id·to_string())
        this
    }

    ☉ rite dark(vary this) → This! {
        this.dark = yea
        this
    }
}

/// Section header with title and optional subtitle
☉ sigil SectionHeader {
    eyebrow: Option<!String>,
    title: !String,
    subtitle: Option<!String>,
}

⊢ SectionHeader {
    ☉ rite new(title: &str) → This! {
        SectionHeader {
            eyebrow: None,
            title: title·to_string(),
            subtitle: None,
        }
    }

    ☉ rite with_eyebrow(vary this, eyebrow: &str) → This! {
        this.eyebrow = Some(eyebrow·to_string())
        this
    }

    ☉ rite with_subtitle(vary this, subtitle: &str) → This! {
        this.subtitle = Some(subtitle·to_string())
        this
    }
}

⊢ Component for SectionHeader {
    rite render(&this) → VNode! {
        ≔ header_style! = "text-align: center; margin-bottom: 3rem;"
        ≔ eyebrow_style! = "display: inline-block; font-size: 0.875rem; font-weight: 500; color: #14A088; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem;"
        ≔ title_style! = "font-size: 2.5rem; font-weight: 700; color: #e8e8ec; margin-bottom: 1rem;"
        ≔ subtitle_style! = "font-size: 1.125rem; color: #a0a0aa; max-width: 600px; margin: 0 auto;"

        ≔ header! = div()
            ·style(header_style)

        // Add eyebrow if present
        if let Some(eyebrow) = &this.eyebrow {
            header = header·child(
                span()
                    ·style(eyebrow_style)
                    ·child(text(eyebrow))
                    ·to_vnode()
            )
        }

        // Add title
        header = header·child(
            h2()
                ·style(title_style)
                ·child(text(&this.title))
                ·to_vnode()
        )

        // Add subtitle if present
        if let Some(subtitle) = &this.subtitle {
            header = header·child(
                p()
                    ·style(subtitle_style)
                    ·child(text(subtitle))
                    ·to_vnode()
            )
        }

        header·to_vnode()
    }

    rite props_to_map(&this) → HashMap<String, PropValue>! {
        HashMap::new()
    }

    rite from_props(_props: HashMap<String, PropValue>) → This! {
        SectionHeader::new("Title")
    }
}

/// Code block component for displaying code
☉ sigil CodeBlock {
    code: !String,
    language: !String,
    title: Option<!String>,
}

⊢ CodeBlock {
    ☉ rite new(code: &str, language: &str) → This! {
        CodeBlock {
            code: code·to_string(),
            language: language·to_string(),
            title: None,
        }
    }

    ☉ rite with_title(vary this, title: &str) → This! {
        this.title = Some(title·to_string())
        this
    }
}

⊢ Component for CodeBlock {
    rite render(&this) → VNode! {
        ≔ container_style! = "background: #030305; border: 1px solid #1a1a1f; border-radius: 0.5rem; overflow: hidden;"
        ≔ code_style! = "font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; line-height: 1.6; padding: 1rem; margin: 0; overflow-x: auto; color: #e8e8ec;"

        ≔ container! = div()
            ·class("code-block")
            ·style(container_style)

        // Add title if present
        if let Some(title) = &this.title {
            ≔ header_style! = "display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; background: #0a0a0d; border-bottom: 1px solid #1a1a1f;"
            ≔ title_style! = "font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; color: #a0a0aa;"

            container = container·child(
                div()
                    ·style(header_style)
                    ·child(
                        span()
                            ·style(title_style)
                            ·child(text(title))
                            ·to_vnode()
                    )
                    ·to_vnode()
            )
        }

        // Add code content
        container = container·child(
            pre()
                ·style(code_style)
                ·child(
                    code()
                        ·child(text(&this.code))
                        ·to_vnode()
                )
                ·to_vnode()
        )

        container·to_vnode()
    }

    rite props_to_map(&this) → HashMap<String, PropValue>! {
        HashMap::new()
    }

    rite from_props(_props: HashMap<String, PropValue>) → This! {
        CodeBlock::new("", "sigil")
    }
}
