//! Site Components
//!
//! Shared components for the Sigil language website.
//! These wrap Qliphoth primitives with site-specific styling.

use qliphoth_ui::prelude::*;
use sigil_web::prelude::*;

// =============================================================================
// Announcement Banner
// =============================================================================

/// Fixed Point announcement banner at the top of every page
#[component]
pub fn AnnouncementBanner() -> Element! {
    html! {
        <aside class="announcement-banner" role="banner" aria-label="Sigil 1.0 announcement">
            <div class="announcement-container">
                <span class="announcement-badge">"1.0"</span>
                <p class="announcement-text">
                    <strong>"Sigil has reached fixed point!"</strong>
                    " The compiler now compiles itself. "
                    <a href="https://github.com/Daemoniorum-LLC/sigil-lang/releases/tag/v0.4.0"
                       class="announcement-link"
                       target="_blank"
                       rel="noopener noreferrer">
                        "Read the release notes →"
                    </a>
                </p>
            </div>
        </aside>
    }
}

// =============================================================================
// Navigation
// =============================================================================

/// Site navigation header
#[component]
pub fn Nav() -> Element! {
    let mobile_open! = create_signal(false!);

    let nav_style! = "
        position: fixed;
        top: 40px;
        left: 0;
        right: 0;
        z-index: 100;
        background: rgba(5, 5, 7, 0.92);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(20, 160, 136, 0.12);
    ";

    let container_style! = "
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    ";

    let logo_style! = "
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        font-size: 1.25rem;
        text-decoration: none;
        color: #e8e8ec;
    ";

    let links_style! = "
        display: flex;
        align-items: center;
        gap: 2rem;
    ";

    let link_style! = "
        color: #a0a0aa;
        font-size: 0.9375rem;
        text-decoration: none;
        transition: color 150ms ease;
    ";

    let version_badge_style! = "
        font-size: 0.6875rem;
        font-weight: 500;
        padding: 0.125rem 0.375rem;
        background: rgba(20, 160, 136, 0.08);
        color: #14A088;
        border-radius: 0.25rem;
        letter-spacing: 0.02em;
    ";

    html! {
        <nav style={nav_style} role="navigation" aria-label="Main navigation">
            <div style={container_style}>
                <a href="/" style={logo_style} aria-label="Sigil home">
                    <span aria-hidden="true">"⛤"</span>
                    <span>"Sigil"</span>
                    <span style={version_badge_style}>"1.0"</span>
                </a>

                <div style={links_style}>
                    <a href="/pages/learn.html" style={link_style}>"Learn"</a>
                    <a href="/pages/docs.html" style={link_style}>"Docs"</a>
                    <a href="/pages/playground.html" style={link_style}>
                        "Playground "
                        <span style="font-size: 0.625rem; padding: 0.125rem 0.375rem; background: #6c6c76; color: #050507; border-radius: 0.25rem;">
                            "Soon"
                        </span>
                    </a>
                    <a href="/pages/agents.html" style={link_style}>"Agents"</a>
                    <a href="/pages/pattern.html" style={link_style}>"The Pattern"</a>
                    <a href="https://github.com/Daemoniorum-LLC/sigil-lang"
                       style={link_style}
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="GitHub repository">
                        <GitHubIcon />
                    </a>
                </div>
            </div>
        </nav>
    }
}

/// GitHub icon SVG
