rite learn_progress_bar() → i32! {
    ≔ bar! = create_element("div");
    set_class(bar, "progress-bar");

    // Unrolled loop - 5 progress steps
    ≔ step1! = create_element("div");
    set_class(step1, "progress-step");
    append_child(bar, step1);

    ≔ step2! = create_element("div");
    set_class(step2, "progress-step");
    append_child(bar, step2);

    ≔ step3! = create_element("div");
    set_class(step3, "progress-step");
    append_child(bar, step3);

    ≔ step4! = create_element("div");
    set_class(step4, "progress-step");
    append_child(bar, step4);

    ≔ step5! = create_element("div");
    set_class(step5, "progress-step");
    append_child(bar, step5);

    bar
}

rite learn_chapter(num: str!, title: str!, content: i32!) → i32! {
    ≔ chapter! = create_element("article");
    set_class(chapter, "chapter");

    ≔ header! = create_element("header");
    set_class(header, "chapter-header");

    ≔ number! = create_element("span");
    set_class(number, "chapter-number");
    append_child(number, create_text("Chapter " ++ num));
    append_child(header, number);

    ≔ h2! = create_element("h2");
    append_child(h2, create_text(title));
    append_child(header, h2);

    append_child(chapter, header);
    append_child(chapter, content);

    chapter
}

rite learn_code_block(code: str!, lang: str!) → i32! {
    ≔ block! = create_element("div");
    set_class(block, "code-block");

    ≔ pre! = create_element("pre");
    ≔ code_el! = create_element("code");
    append_child(code_el, create_text(code));
    append_child(pre, code_el);
    append_child(block, pre);

    block
}

rite learn_chapter_1() → i32! {
    ≔ content! = create_element("div");

    ≔ p1! = create_element("p");
    set_class(p1, "prose");
    append_child(p1, create_text("Welcome to Sigil! This tutorial will guide you through the fundamentals of the language."));
    append_child(content, p1);

    append_child(content, learn_code_block(
        "# Clone and build\ngit clone https://github.com/Daemoniorum-LLC/sigil-lang\ncd sigil-lang/parser && cargo build --release",
        "bash"
    ));

    append_child(content, learn_code_block(
        "// hello.sigil\nrite main() {\n    println(\"Hello, Sigil!\")\n}",
        "sigil"
    ));

    content
}

rite learn_chapter_2() → i32! {
    ≔ content! = create_element("div");

    ≔ p1! = create_element("p");
    set_class(p1, "prose");
    append_child(p1, create_text("Sigil's type system tracks where data comes from."));
    append_child(content, p1);

    append_child(content, learn_code_block(
        "≔ computed!  = 2 + 2         // ! Known\n≔ maybe?     = find_user(id) // ? Uncertain\n≔ external~  = api·fetch()   // ~ Reported",
        "sigil"
    ));

    content
}

rite learn_chapter_3() → i32! {
    ≔ content! = create_element("div");

    ≔ p1! = create_element("p");
    set_class(p1, "prose");
    append_child(p1, create_text("Greek letters for expressive data pipelines."));
    append_child(content, p1);

    append_child(content, learn_code_block(
        "items |φ{.active}       // φ filter\nitems |τ{.transform()}  // τ transform\nitems |σ·by{.date}      // σ sort",
        "sigil"
    ));

    content
}

rite learn_chapter_4() → i32! {
    ≔ content! = create_element("div");

    ≔ p1! = create_element("p");
    set_class(p1, "prose");
    append_child(p1, create_text("Structs and enums with evidentiality."));
    append_child(content, p1);

    append_child(content, learn_code_block(
        "☉ sigil User {\n    id: !i64,\n    name: !String,\n}",
        "sigil"
    ));

    content
}

rite learn_chapter_5() → i32! {
    ≔ content! = create_element("div");

    ≔ p1! = create_element("p");
    set_class(p1, "prose");
    append_child(p1, create_text("Multiple compilation targets: interpreter, JIT, native, and WASM."));
    append_child(content, p1);

    append_child(content, learn_code_block(
        "sigil run app.sigil      # Interpreter\nsigil compile app.sigil  # Native binary\nsigil wasm app.sigil     # WebAssembly",
        "bash"
    ));

    ≔ actions! = create_element("div");
    set_class(actions, "chapter-actions");
    ≔ btn! = create_element("a");
    set_class(btn, "button button-primary");
    set_attr(btn, "href", "/pages/docs.html");
    append_child(btn, create_text("Read Documentation"));
    append_child(actions, btn);
    append_child(content, actions);

    content
}

rite learn_app() → i32! {
    ≔ root! = create_element("div");
    set_class(root, "app");

    append_child(root, announcement());
    append_child(root, header());

    ≔ content! = create_element("div");
    set_class(content, "learn-content");

    append_child(content, learn_progress_bar());
    append_child(content, learn_chapter("1", "Getting Started", learn_chapter_1()));
    append_child(content, learn_chapter("2", "Evidentiality", learn_chapter_2()));
    append_child(content, learn_chapter("3", "Morpheme Operators", learn_chapter_3()));
    append_child(content, learn_chapter("4", "Data Structures", learn_chapter_4()));
    append_child(content, learn_chapter("5", "Building Applications", learn_chapter_5()));

    append_child(root, content);
    append_child(root, footer());

    root
}

☉ rite main_learn() {
    ≔ root_element! = learn_app();
    mount(root_element, "#app");
}

