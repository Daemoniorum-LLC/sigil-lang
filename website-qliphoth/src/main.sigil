    ≔ section1! = create_element("section");
    set_class(section1, "pattern-section");

    ≔ h2_1! = create_element("h2");
    append_child(h2_1, create_text("Data Has History"));
    append_child(section1, h2_1);

    ≔ p1! = create_element("p");
    append_child(p1, create_text("Every value in Sigil carries information about where it came from. This isn't just metadata—it's enforced by the type system."));
    append_child(section1, p1);

    append_child(content, section1);

    ≔ section2! = create_element("section");
    set_class(section2, "pattern-section");

    ≔ h2_2! = create_element("h2");
    append_child(h2_2, create_text("Trust is Explicit"));
    append_child(section2, h2_2);

    ≔ p2! = create_element("p");
    append_child(p2, create_text("External data (~) cannot silently become trusted data (!). The boundary must be explicitly crossed through validation."));
    append_child(section2, p2);

    append_child(content, section2);

    ≔ section3! = create_element("section");
    set_class(section3, "pattern-section");

    ≔ h2_3! = create_element("h2");
    append_child(h2_3, create_text("Pipelines Over Loops"));
    append_child(section3, h2_3);

    ≔ p3! = create_element("p");
    append_child(p3, create_text("Morpheme operators (φ, τ, σ, ρ) express data transformations declaratively, making code more readable and reasoning about data flow easier."));
    append_child(section3, p3);

    append_child(content, section3);

    append_child(root, content);
    append_child(root, footer());

    root
}

☉ rite main_pattern() {
    ≔ root_element! = pattern_app();
    mount(root_element, "#app");
}
