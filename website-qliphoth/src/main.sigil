rite code_density_section() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "code-density-section");

    ≔ h2! = create_element("h2");
    append_child(h2, create_text("Code Density"));
    append_child(section, h2);

    ≔ desc! = create_element("p");
    set_class(desc, "section-desc");
    append_child(desc, create_text("Sigil's syntax reduces boilerplate while maintaining full type safety."));
    append_child(section, desc);

    // Metrics row
    ≔ metrics! = create_element("div");
    set_class(metrics, "code-stats");

    ≔ stat1! = create_element("div");
    set_class(stat1, "stat");
    ≔ stat1_num! = create_element("span");
    set_class(stat1_num, "stat-number");
    append_child(stat1_num, create_text("38%"));
    append_child(stat1, stat1_num);
    ≔ stat1_label! = create_element("span");
    set_class(stat1_label, "stat-label");
    append_child(stat1_label, create_text("fewer lines"));
    append_child(stat1, stat1_label);
    append_child(metrics, stat1);

    ≔ stat2! = create_element("div");
    set_class(stat2, "stat");
    ≔ stat2_num! = create_element("span");
    set_class(stat2_num, "stat-number");
    append_child(stat2_num, create_text("47%"));
    append_child(stat2, stat2_num);
    ≔ stat2_label! = create_element("span");
    set_class(stat2_label, "stat-label");
    append_child(stat2_label, create_text("less code"));
    append_child(stat2, stat2_label);
    append_child(metrics, stat2);

    ≔ stat3! = create_element("div");
    set_class(stat3, "stat");
    ≔ stat3_num! = create_element("span");
    set_class(stat3_num, "stat-number");
    append_child(stat3_num, create_text("100%"));
    append_child(stat3, stat3_num);
    ≔ stat3_label! = create_element("span");
    set_class(stat3_label, "stat-label");
    append_child(stat3_label, create_text("type safe"));
    append_child(stat3, stat3_label);
    append_child(metrics, stat3);

    append_child(section, metrics);

    // Code comparison
    ≔ comparison! = create_element("div");
    set_class(comparison, "code-comparison");

    // TypeScript panel
    ≔ ts_panel! = create_element("div");
    set_class(ts_panel, "code-panel ts-panel");
    ≔ ts_header! = create_element("div");
    set_class(ts_header, "code-header");
    append_child(ts_header, create_text("TypeScript — 21 lines"));
    append_child(ts_panel, ts_header);
    ≔ ts_pre! = create_element("pre");
    set_class(ts_pre, "code-block");
    ≔ ts_code! = create_text(
        "interface Todo {\n" ++
        "  id: number;\n" ++
        "  title: string;\n" ++
        "  done: boolean;\n" ++
        "}\n\n" ++
        "const todos: Todo[] = [];\n" ++
        "let nextId = 1;\n\n" ++
        "function add(title: string): Todo {\n" ++
        "  const t: Todo = {\n" ++
        "    id: nextId++,\n" ++
        "    title,\n" ++
        "    done: false\n" ++
        "  };\n" ++
        "  todos.push(t);\n" ++
        "  return t;\n" ++
        "}\n\n" ++
        "function toggle(id: number): void {\n" ++
        "  const t = todos.find(x => x.id === id);\n" ++
        "  if (t) t.done = !t.done;\n" ++
        "}"
    );
    append_child(ts_pre, ts_code);
    append_child(ts_panel, ts_pre);
    append_child(comparison, ts_panel);

    // Sigil panel
    ≔ sg_panel! = create_element("div");
    set_class(sg_panel, "code-panel sigil-panel");
    ≔ sg_header! = create_element("div");
    set_class(sg_header, "code-header");
    append_child(sg_header, create_text("Sigil — 13 lines"));
    append_child(sg_panel, sg_header);
    ≔ sg_pre! = create_element("pre");
    set_class(sg_pre, "code-block");
    ≔ sg_code! = create_text(
        "sigil Todo { id: i32!, title: Str!, done: bool! }\n\n" ++
        "≔ todos: Vec<Todo>! = vec![];\n" ++
        "≔ next: i32! = 1;\n\n" ++
        "rite add(title: Str!) → Todo! {\n" ++
        "    ≔ t! = Todo { id: next, title, done: false };\n" ++
        "    next += 1; todos.push(t); t\n" ++
        "}\n\n" ++
        "rite toggle(id: i32!) {\n" ++
        "    todos.find(|x| x.id == id)?.done ^= true;\n" ++
        "}"
    );
    append_child(sg_pre, sg_code);
    append_child(sg_panel, sg_pre);
    append_child(comparison, sg_panel);

    append_child(section, comparison);
    section
}

rite code_example() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "code-section");

    ≔ h2! = create_element("h2");
    ≔ heading! = create_text("Evidentiality in Action");
    append_child(h2, heading);
    append_child(section, h2);

    ≔ desc! = create_element("p");
    set_class(desc, "code-desc");
    ≔ desc_text! = create_text("Sigil tracks where data comes from at the type level:");
    append_child(desc, desc_text);
    append_child(section, desc);

    ≔ pre! = create_element("pre");
    set_class(pre, "code-block");

    ≔ code! = create_text(
        "// Evidentiality markers track data provenance\n" ++
        "rite fetch_user(id: i64?) → User~ {\n" ++
        "    // id is uncertain (?) - from user input\n" ++
        "    // return is reported (~) - from external API\n" ++
        "    ≔ response~ = http·get(url);\n" ++
        "    parse_user(response)\n" ++
        "}\n\n" ++
        "// Morpheme operators for data pipelines\n" ++
        "≔ result = users~                  // ~ reported data from external source\n" ++
        "    |φ{.active}                    // φ filter: keep only active users\n" ++
        "    |φ{.age >= 18}                 // φ filter: keep adults only\n" ++
        "    |τ{.normalize()}               // τ transform: normalize each record\n" ++
        "    |σ·by{.created_at}             // σ sort: order by creation date\n" ++
        "    |validate?                     // ? uncertain: validation may fail\n" ++
        "    |τ{.to_public_profile()}       // τ transform: strip private fields\n" ++
        "    |validate!                     // ! known: final validation must pass\n"
    );
    append_child(pre, code);
    append_child(section, pre);

    section
}

