}

rite docs_table_row(marker: str!, meaning: str!) → i32! {
    ≔ row! = create_element("tr");

    ≔ td1! = create_element("td");
    set_class(td1, "marker-cell");
    append_child(td1, create_text(marker));
    append_child(row, td1);

    ≔ td2! = create_element("td");
    append_child(td2, create_text(meaning));
    append_child(row, td2);

    row
}

rite docs_agent_layer(name: str!, components: str!) → i32! {
    ≔ layer! = create_element("div");
    set_class(layer, "agent-layer");

    ≔ h4! = create_element("h4");
    append_child(h4, create_text(name));
    append_child(layer, h4);

    ≔ p! = create_element("p");
    append_child(p, create_text(components));
    append_child(layer, p);

    layer
}

rite docs_content() → i32! {
    ≔ article! = create_element("article");
    set_class(article, "docs-content");

    ≔ h1! = create_element("h1");
    set_attr(h1, "id", "introduction");
    append_child(h1, create_text("Sigil Documentation"));
    append_child(article, h1);

    ≔ lead! = create_element("p");
    set_class(lead, "lead");
    append_child(lead, create_text("The complete reference for the Sigil programming language."));
    append_child(article, lead);

    // Feature highlights
    ≔ highlights! = create_element("div");
    set_class(highlights, "feature-highlight");
    append_child(highlights, docs_highlight_item("Evidentiality", "Track data provenance"));
    append_child(highlights, docs_highlight_item("Morphemes", "Data pipelines"));
    append_child(highlights, docs_highlight_item("Agents", "AI infrastructure"));
    append_child(article, highlights);

    // Marker table
    ≔ table! = create_element("table");
    set_class(table, "docs-table");

    ≔ thead! = create_element("thead");
    ≔ header_row! = create_element("tr");
    ≔ th1! = create_element("th");
    append_child(th1, create_text("Marker"));
    append_child(header_row, th1);
    ≔ th2! = create_element("th");
    append_child(th2, create_text("Meaning"));
    append_child(header_row, th2);
    append_child(thead, header_row);
    append_child(table, thead);

    ≔ tbody! = create_element("tbody");
    append_child(tbody, docs_table_row("!", "Known"));
    append_child(tbody, docs_table_row("?", "Uncertain"));
    append_child(tbody, docs_table_row("~", "Reported"));
    append_child(table, tbody);

    append_child(article, table);

    // Agent grid
    ≔ agent_grid! = create_element("div");
    set_class(agent_grid, "agent-overview-grid");
    append_child(agent_grid, docs_agent_layer("Cognition", "Engram, Omen, Gnosis"));
    append_child(article, agent_grid);

    article
}

rite docs_app() → i32! {
    ≔ root! = create_element("div");
    set_class(root, "app");

    append_child(root, announcement());
    append_child(root, header());

    ≔ layout! = create_element("div");
