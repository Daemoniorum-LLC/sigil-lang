// Sigil-lang.com - Single-file WASM version
// Proof that Sigil compiles to WebAssembly
//
// This demonstrates:
// - Sigil syntax (evidentiality markers, morpheme operators)
// - WASM compilation (Sigil → WebAssembly)
// - Web integration (DOM manipulation via vdom imports)

// === DOM Helpers ===
// These call the pre-registered WASM imports

rite create_element(tag: &str!) → i32! {
    vdom_create_vnode(tag)
}

rite create_text(content: &str!) → i32! {
    vdom_create_text_vnode(content)
}

rite set_class(element: i32!, class_name: &str!) {
    vdom_set_vnode_str_prop(element, "class", class_name)
}

rite set_attr(element: i32!, attr: &str!, value: &str!) {
    vdom_set_vnode_str_prop(element, attr, value)
}

rite append_child(parent: i32!, child: i32!) {
    vdom_append_vnode_child(parent, child)
}

rite mount(element: i32!, selector: &str!) {
    vdom_mount_vnode(element, selector);
}

// === Components ===

rite header() → i32! {
    ≔ nav! = create_element("nav");
    set_class(nav, "site-nav");

    ≔ brand! = create_element("a");
    set_class(brand, "brand");
    set_attr(brand, "href", "/");
    ≔ title! = create_text("Sigil");
    append_child(brand, title);
    append_child(nav, brand);

    ≔ links! = create_element("div");
    set_class(links, "nav-links");

    ≔ learn! = create_element("a");
    set_class(learn, "nav-link");
    set_attr(learn, "href", "/pages/learn.html");
    ≔ learn_text! = create_text("Learn");
    append_child(learn, learn_text);
    append_child(links, learn);

    ≔ docs! = create_element("a");
    set_class(docs, "nav-link");
    set_attr(docs, "href", "/pages/docs.html");
    ≔ docs_text! = create_text("Docs");
    append_child(docs, docs_text);
    append_child(links, docs);

    ≔ examples! = create_element("a");
    set_class(examples, "nav-link");
    set_attr(examples, "href", "/pages/examples.html");
    ≔ examples_text! = create_text("Examples");
    append_child(examples, examples_text);
    append_child(links, examples);

    ≔ playground! = create_element("a");
    set_class(playground, "nav-link");
    set_attr(playground, "href", "/pages/playground.html");
    ≔ playground_text! = create_text("Playground");
    append_child(playground, playground_text);
    append_child(links, playground);

    ≔ github! = create_element("a");
    set_class(github, "nav-link");
    set_attr(github, "href", "https://github.com/Daemoniorum-LLC/sigil-lang");
    set_attr(github, "target", "_blank");
    ≔ gh_text! = create_text("GitHub");
    append_child(github, gh_text);
    append_child(links, github);

    ≔ version! = create_element("span");
    set_class(version, "version-badge");
    ≔ ver_text! = create_text("v1.0");
    append_child(version, ver_text);
    append_child(links, version);

    append_child(nav, links);
    nav
}

rite hero() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "hero");

    ≔ h1! = create_element("h1");
    ≔ heading! = create_text("Sigil");
    append_child(h1, heading);
    append_child(section, h1);

    ≔ tagline! = create_element("p");
    set_class(tagline, "tagline");
    ≔ text! = create_text("Type-safe data provenance through evidentiality markers");
    append_child(tagline, text);
    append_child(section, tagline);

    ≔ sub! = create_element("p");
    set_class(sub, "subtitle");
    ≔ sub_text! = create_text("A systems language designed for AI agents");
    append_child(sub, sub_text);
    append_child(section, sub);

    // Evidentiality markers display
    ≔ markers! = create_element("div");
    set_class(markers, "ev-display");

    ≔ known! = create_element("span");
    set_class(known, "ev ev-known");
    ≔ known_text! = create_text("! known");
    append_child(known, known_text);
    append_child(markers, known);

    ≔ uncertain! = create_element("span");
    set_class(uncertain, "ev ev-uncertain");
    ≔ uncertain_text! = create_text("? uncertain");
    append_child(uncertain, uncertain_text);
    append_child(markers, uncertain);

    ≔ reported! = create_element("span");
    set_class(reported, "ev ev-reported");
    ≔ reported_text! = create_text("~ reported");
    append_child(reported, reported_text);
    append_child(markers, reported);

    append_child(section, markers);
    section
}

rite announcement() → i32! {
    ≔ banner! = create_element("div");
    set_class(banner, "announcement-banner");

    ≔ badge! = create_element("span");
    set_class(badge, "badge");
    ≔ badge_text! = create_text("FIXED POINT");
    append_child(badge, badge_text);
    append_child(banner, badge);

    ≔ msg! = create_element("p");
    ≔ msg_text! = create_text("The Sigil compiler now compiles itself. This page was compiled from Sigil to WebAssembly.");
    append_child(msg, msg_text);
    append_child(banner, msg);

    banner
}

rite features_section() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "features-section");

    ≔ h2! = create_element("h2");
    ≔ heading! = create_text("Language Features");
    append_child(h2, heading);
    append_child(section, h2);

    ≔ grid! = create_element("div");
    set_class(grid, "features-grid");

    // Feature 1: Evidentiality
    ≔ f1! = create_element("div");
    set_class(f1, "feature-card");
    ≔ f1_title! = create_element("h3");
    ≔ f1_title_text! = create_text("Evidentiality Markers");
    append_child(f1_title, f1_title_text);
    append_child(f1, f1_title);
    ≔ f1_desc! = create_element("p");
    ≔ f1_desc_text! = create_text("Track data provenance at the type level with !, ?, ~, and markers.");
    append_child(f1_desc, f1_desc_text);
    append_child(f1, f1_desc);
    append_child(grid, f1);

    // Feature 2: Morpheme Operators
    ≔ f2! = create_element("div");
    set_class(f2, "feature-card");
    ≔ f2_title! = create_element("h3");
    ≔ f2_title_text! = create_text("Morpheme Operators");
    append_child(f2_title, f2_title_text);
    append_child(f2, f2_title);
    ≔ f2_desc! = create_element("p");
    ≔ f2_desc_text! = create_text("Parallel pipelines, async composition, and functional transforms built into syntax.");
    append_child(f2_desc, f2_desc_text);
    append_child(f2, f2_desc);
    append_child(grid, f2);

    // Feature 3: WASM Target
    ≔ f3! = create_element("div");
    set_class(f3, "feature-card");
    ≔ f3_title! = create_element("h3");
    ≔ f3_title_text! = create_text("WebAssembly Native");
    append_child(f3_title, f3_title_text);
    append_child(f3, f3_title);
    ≔ f3_desc! = create_element("p");
    ≔ f3_desc_text! = create_text("Compile directly to WASM for web, edge, and embedded deployments.");
    append_child(f3_desc, f3_desc_text);
    append_child(f3, f3_desc);
    append_child(grid, f3);

    // Feature 4: Self-Hosting
    ≔ f4! = create_element("div");
    set_class(f4, "feature-card");
    ≔ f4_title! = create_element("h3");
    ≔ f4_title_text! = create_text("Self-Hosting Compiler");
    append_child(f4_title, f4_title_text);
    append_child(f4, f4_title);
    ≔ f4_desc! = create_element("p");
    ≔ f4_desc_text! = create_text("The Sigil compiler is written in Sigil - fixed point achieved January 2026.");
    append_child(f4_desc, f4_desc_text);
    append_child(f4, f4_desc);
    append_child(grid, f4);

    append_child(section, grid);
    section
}

rite code_example() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "code-section");

    ≔ h2! = create_element("h2");
    ≔ heading! = create_text("Evidentiality in Action");
    append_child(h2, heading);
    append_child(section, h2);

    ≔ desc! = create_element("p");
    set_class(desc, "code-desc");
    ≔ desc_text! = create_text("Sigil tracks where data comes from at the type level:");
    append_child(desc, desc_text);
    append_child(section, desc);

    ≔ pre! = create_element("pre");
    set_class(pre, "code-block");

    ≔ code! = create_text(
        "// Evidentiality markers track data provenance\n" ++
        "rite fetch_user(id: i64?) → User~ {\n" ++
        "    // id is uncertain (?) - from user input\n" ++
        "    // return is reported (~) - from external API\n" ++
        "    ≔ response~ = http·get(url);\n" ++
        "    parse_user(response)\n" ++
        "}\n\n" ++
        "// Morpheme operators for data pipelines\n" ++
        "≔ results! = data\n" ++
        "    |τ validate?\n" ++
        "    |τ transform!\n" ++
        "    |∥ process_parallel;\n"
    );
    append_child(pre, code);
    append_child(section, pre);

    section
}

rite footer() → i32! {
    ≔ ft! = create_element("footer");
    set_class(ft, "site-footer");

    ≔ text! = create_text("2025-2026 Daemoniorum LLC - Built with Sigil + Qliphoth");
    append_child(ft, text);

    ft
}

// === Main App ===

rite app() → i32! {
    ≔ root! = create_element("div");
    set_class(root, "app");

    append_child(root, announcement());
    append_child(root, header());
    append_child(root, hero());
    append_child(root, features_section());
    append_child(root, code_example());
    append_child(root, footer());

    root
}

☉ rite main() {
    console_log_i64(42);
    ≔ root_element! = app();
    mount(root_element, "#app");
}
