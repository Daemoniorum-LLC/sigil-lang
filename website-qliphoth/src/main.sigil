rite examples_content() → i32! {
    ≔ article! = create_element("article");
    set_class(article, "docs-content");

    ≔ h1! = create_element("h1");
    append_child(h1, create_text("Code Examples"));
    append_child(article, h1);

    ≔ lead! = create_element("p");
    set_class(lead, "lead");
    append_child(lead, create_text("Learn Sigil through practical code examples."));
    append_child(article, lead);

    // Example 1
    ≔ h3_1! = create_element("h3");
    append_child(h3_1, create_text("Hello World"));
    append_child(article, h3_1);
    append_child(article, learn_code_block("rite main() {\n    println(\"Hello, Sigil!\")\n}", "sigil"));

    // Example 2
    ≔ h3_2! = create_element("h3");
    append_child(h3_2, create_text("Variables with Evidentiality"));
    append_child(article, h3_2);
    append_child(article, learn_code_block("≔ computed!  = 2 + 2        // Known\n≔ maybe?     = find_user(1) // Uncertain\n≔ external~  = api·fetch()  // Reported", "sigil"));

    // Example 3
    ≔ h3_3! = create_element("h3");
    append_child(h3_3, create_text("Data Pipeline"));
    append_child(article, h3_3);
    append_child(article, learn_code_block("users\n    |φ{.active}\n    |τ{.normalize()}\n    |σ·by{.created_at}\n    |validate!", "sigil"));

    // Example 4
    ≔ h3_4! = create_element("h3");
    append_child(h3_4, create_text("Struct Definition"));
    append_child(article, h3_4);
    append_child(article, learn_code_block("☉ sigil User {\n    id: !i64,\n    name: !String,\n}", "sigil"));

    // Example 5
    ≔ h3_5! = create_element("h3");
    append_child(h3_5, create_text("HTTP Server"));
    append_child(article, h3_5);
    append_child(article, learn_code_block("async rite handle_user(req: Request~) → Response! {\n    ≔ id~ = req·param(\"id\")\n    ≔ user? = db·find_user(id).await\n    match user {\n        Some(u) => Response·json(u),\n        None => Response·not_found()\n    }\n}", "sigil"));

    article
}

