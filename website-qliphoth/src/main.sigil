// Sigil-lang.com - Single-file WASM version
// Proof that Sigil compiles to WebAssembly
//
// This demonstrates:
// - Sigil syntax (evidentiality markers, morpheme operators)
// - WASM compilation (Sigil → WebAssembly)
// - Web integration (DOM manipulation via vdom imports)

// === WASM Imports ===
// These functions are provided by the JavaScript runtime (sigil_runtime.js)

extern "wasm" {
    rite vdom_create_vnode(tag: str!) → i32!;
    rite vdom_create_text_vnode(content: str!) → i32!;
    rite vdom_set_vnode_str_prop(element: i32!, prop: str!, value: str!);
    rite vdom_append_vnode_child(parent: i32!, child: i32!);
    rite vdom_mount_vnode(element: i32!, selector: str!);
    rite console_log_i64(value: i64!);
}

// === DOM Helpers ===
// These call the pre-registered WASM imports

rite create_element(tag: str!) → i32! {
    vdom_create_vnode(tag)
}

rite create_text(content: str!) → i32! {
    vdom_create_text_vnode(content)
}

rite set_class(element: i32!, class_name: str!) {
    vdom_set_vnode_str_prop(element, "class", class_name)
}

rite set_attr(element: i32!, attr: str!, value: str!) {
    vdom_set_vnode_str_prop(element, attr, value)
}

rite append_child(parent: i32!, child: i32!) {
    vdom_append_vnode_child(parent, child)
}

rite mount(element: i32!, selector: str!) {
    vdom_mount_vnode(element, selector);
}

// === Components ===

