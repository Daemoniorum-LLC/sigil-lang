rite hero_marker(marker: str!, class: str!, desc: str!) → i32! {
    ≔ item! = create_element("div");
    set_class(item, class);
    ≔ check! = create_element("span");
    set_class(check, "marker-check");
    append_child(check, create_text(marker));
    append_child(item, check);
    ≔ span! = create_element("span");
    append_child(span, create_text(desc));
    append_child(item, span);
    item
}

rite hero() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "hero");

    // Title with logo
    ≔ h1! = create_element("h1");
    set_class(h1, "hero-title");
    ≔ logo! = create_element("img");
    set_class(logo, "hero-logo");
    set_attr(logo, "src", "/sigil-logo.svg");
    set_attr(logo, "alt", "");
    append_child(h1, logo);
    append_child(h1, create_text("Sigil"));
    append_child(section, h1);

    ≔ subtitle! = create_element("p");
    set_class(subtitle, "hero-subtitle");
    append_child(subtitle, create_text("A programming language that knows which data to trust."));
    append_child(section, subtitle);

    ≔ desc! = create_element("p");
    set_class(desc, "hero-desc");
    append_child(desc, create_text("Sigil tracks data provenance in the type system."));
    append_child(section, desc);

    // 5 Evidentiality markers grid
    ≔ markers! = create_element("div");
    set_class(markers, "hero-markers-grid");
    append_child(markers, hero_marker("!", "marker-item marker-known", "Known — verified, computed locally"));
    append_child(markers, hero_marker("?", "marker-item marker-uncertain", "Uncertain — might be absent"));
    append_child(markers, hero_marker("~", "marker-item marker-reported", "Reported — external source, untrusted"));
    append_child(markers, hero_marker("◊", "marker-item marker-predicted", "Predicted — AI/ML output, probabilistic"));
    append_child(markers, hero_marker("‽", "marker-item marker-paradox", "Paradox — explicit trust boundary"));
    append_child(section, markers);

    // CTA buttons
    ≔ cta! = create_element("div");
    set_class(cta, "hero-cta");
    ≔ btn_primary! = create_element("a");
    set_class(btn_primary, "btn btn-primary");
    set_attr(btn_primary, "href", "/pages/learn.html");
    append_child(btn_primary, create_text("Learn Sigil"));
    append_child(cta, btn_primary);
    ≔ btn_secondary! = create_element("a");
    set_class(btn_secondary, "btn btn-secondary");
    set_attr(btn_secondary, "href", "#problem");
    append_child(btn_secondary, create_text("See the Problem It Solves"));
    append_child(cta, btn_secondary);
    append_child(section, cta);

    section
}

rite problem_section() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "problem-section");
    set_attr(section, "id", "problem");

    ≔ h2! = create_element("h2");
    append_child(h2, create_text("The Bug That Types Can't Catch"));
    append_child(section, h2);

    ≔ desc! = create_element("p");
    set_class(desc, "section-desc");
    append_child(desc, create_text("In Rust, TypeScript, or Go, this code compiles without warnings:"));
    append_child(section, desc);

    ≔ comparison! = create_element("div");
    set_class(comparison, "code-comparison");

    // Traditional code panel
    ≔ trad_panel! = create_element("div");
    set_class(trad_panel, "code-panel");
    ≔ trad_header! = create_element("div");
    set_class(trad_header, "code-header");
    ≔ trad_label! = create_element("span");
    set_class(trad_label, "code-label");
    append_child(trad_label, create_text("Rust / TypeScript / Go"));
    append_child(trad_header, trad_label);
    ≔ trad_status! = create_element("span");
    set_class(trad_status, "code-status code-status-vulnerable");
    append_child(trad_status, create_text("Compiles. Vulnerable."));
    append_child(trad_header, trad_status);
    append_child(trad_panel, trad_header);
    ≔ trad_pre! = create_element("pre");
    set_class(trad_pre, "code-block");
    set_attr(trad_pre, "data-language", "rust");
    append_child(trad_pre, create_text(
        "async fn get_user_profile(id: String) -> Profile {\n" ++
        "    let response = http::get(&format!(\"/api/users/{}\", id)).await;\n" ++
        "    let profile: Profile = response.json();\n" ++
        "    save_to_database(&profile);  // No provenance tracking\n" ++
        "    profile\n" ++
        "}"
    ));
    append_child(trad_panel, trad_pre);
    append_child(comparison, trad_panel);

    // Sigil code panel
    ≔ sg_panel! = create_element("div");
    set_class(sg_panel, "code-panel sigil-panel");
    ≔ sg_header! = create_element("div");
    set_class(sg_header, "code-header");
    ≔ sg_label! = create_element("span");
    set_class(sg_label, "code-label");
    append_child(sg_label, create_text("Sigil"));
    append_child(sg_header, sg_label);
    ≔ sg_status! = create_element("span");
    set_class(sg_status, "code-status code-status-safe");
    append_child(sg_status, create_text("Type Error. Safe."));
    append_child(sg_header, sg_status);
    append_child(sg_panel, sg_header);
    ≔ sg_pre! = create_element("pre");
    set_class(sg_pre, "code-block");
    set_attr(sg_pre, "data-language", "sigil");
    append_child(sg_pre, create_text(
        "async rite get_user_profile(id: Str!) → Profile! {\n" ++
        "    ≔ response~ = Http·get(\"/api/users/{id}\").await;\n" ++
        "    ≔ profile~ = response.json::<Profile~>();\n" ++
        "    save_to_database(profile);  // ERROR: ~ cannot flow to !\n" ++
        "    ≔ verified! = profile |> validate { verify_signature() };\n" ++
        "    save_to_database(verified);  // OK: ! flows to !\n" ++
        "    verified\n" ++
        "}"
    ));
    append_child(sg_panel, sg_pre);
    append_child(comparison, sg_panel);

    append_child(section, comparison);

    ≔ explain! = create_element("p");
    set_class(explain, "explanation");
    append_child(explain, create_text("The ~ marker is contagious. Any data derived from external sources inherits the ~ until explicitly validated."));
    append_child(section, explain);

    section
}

rite ev_card(marker: str!, title: str!, subtitle: str!, desc: str!, code: str!, class: str!) → i32! {
    ≔ card! = create_element("div");
    set_class(card, class);
    ≔ m! = create_element("span");
    set_class(m, "ev-card-marker");
    append_child(m, create_text(marker));
    append_child(card, m);
    ≔ h3! = create_element("h3");
    append_child(h3, create_text(title));
    append_child(card, h3);
    ≔ sub! = create_element("span");
    set_class(sub, "ev-card-subtitle");
    append_child(sub, create_text(subtitle));
    append_child(card, sub);
    ≔ p! = create_element("p");
    append_child(p, create_text(desc));
    append_child(card, p);
    ≔ pre! = create_element("pre");
    set_class(pre, "code-block");
    set_attr(pre, "data-language", "sigil");
    append_child(pre, create_text(code));
    append_child(card, pre);
    card
}

rite evidentiality_section() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "evidentiality-history-section");

    ≔ h2! = create_element("h2");
    append_child(h2, create_text("Evidentiality: Data Has a History"));
    append_child(section, h2);

    ≔ grid! = create_element("div");
    set_class(grid, "ev-cards-grid");

    append_child(grid, ev_card("!", "Known", "Verified truth",
        "Data you computed yourself, or explicitly verified. Safe to trust.",
        "≔ sum! = 2 + 2\n≔ valid! = input |validate!{ check() }",
        "ev-card ev-card-known"));

    append_child(grid, ev_card("?", "Uncertain", "Might be absent",
        "Data that might not exist. Like Option/Maybe, but tracked in the type.",
        "≔ user? = database.find(id)\n≔ name? = user?.profile?.name",
        "ev-card ev-card-uncertain"));

    append_child(grid, ev_card("~", "Reported", "External source",
        "Data from APIs, user input, files. Never trust without validation.",
        "≔ data~ = api.fetch(url)\n≔ input~ = form.get(\"email\")",
        "ev-card ev-card-reported"));

    append_child(grid, ev_card("◊", "Predicted", "AI/ML output",
        "Probabilistic results from models. Similar trust level to Uncertain.",
        "≔ sentiment◊ = model.predict(text)\n≔ embedding◊ = encoder.embed(input)",
        "ev-card ev-card-predicted"));

    append_child(grid, ev_card("‽", "Paradox", "Trust boundary",
        "Explicit 'I know what I'm doing' escape hatch. Use sparingly.",
        "≔ ptr‽ = unsafe { raw_pointer }",
        "ev-card ev-card-paradox"));

    append_child(section, grid);

    // Propagation rule
    ≔ rule! = create_element("div");
    set_class(rule, "propagation-rule");
    ≔ rule_h3! = create_element("h3");
    append_child(rule_h3, create_text("The Propagation Rule"));
    append_child(rule, rule_h3);
    ≔ rule_p! = create_element("p");
    append_child(rule_p, create_text("Combining data inherits the worst evidence level. Known + Reported = Reported."));
    append_child(rule, rule_p);
    ≔ rule_pre! = create_element("pre");
    set_class(rule_pre, "code-block");
    set_attr(rule_pre, "data-language", "sigil");
    append_child(rule_pre, create_text(
        "≔ local! = 100\n" ++
        "≔ remote~ = api.get_multiplier()\n" ++
        "≔ result~ = local * remote  // ! + ~ = ~"
    ));
    append_child(rule, rule_pre);
    append_child(section, rule);

    section
}

rite morpheme_section() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "morpheme-section");

    ≔ h2! = create_element("h2");
    append_child(h2, create_text("Morpheme Operators"));
    append_child(section, h2);

    ≔ desc! = create_element("p");
    set_class(desc, "section-desc");
    append_child(desc, create_text("Greek letters for data transformation. Dense, readable pipelines."));
    append_child(section, desc);

    // 8 operators grid
    ≔ grid! = create_element("div");
    set_class(grid, "morpheme-grid");

    ≔ op1! = create_element("div");
    set_class(op1, "morpheme-op");
    append_child(op1, create_text("φ filter"));
    append_child(grid, op1);

    ≔ op2! = create_element("div");
    set_class(op2, "morpheme-op");
    append_child(op2, create_text("τ transform"));
    append_child(grid, op2);

    ≔ op3! = create_element("div");
    set_class(op3, "morpheme-op");
    append_child(op3, create_text("σ sort"));
    append_child(grid, op3);

    ≔ op4! = create_element("div");
    set_class(op4, "morpheme-op");
    append_child(op4, create_text("ρ reduce"));
    append_child(grid, op4);

    ≔ op5! = create_element("div");
    set_class(op5, "morpheme-op");
    append_child(op5, create_text("Σ sum"));
    append_child(grid, op5);

    ≔ op6! = create_element("div");
    set_class(op6, "morpheme-op");
    append_child(op6, create_text("Π product"));
    append_child(grid, op6);

    ≔ op7! = create_element("div");
    set_class(op7, "morpheme-op");
    append_child(op7, create_text("α first"));
    append_child(grid, op7);

    ≔ op8! = create_element("div");
    set_class(op8, "morpheme-op");
    append_child(op8, create_text("ω last"));
    append_child(grid, op8);

    append_child(section, grid);

    // Pipeline example with comments
    ≔ pre! = create_element("pre");
    set_class(pre, "code-block");
    set_attr(pre, "data-language", "sigil");
    append_child(pre, create_text(
        "≔ result = users~              // ~ reported: external data\n" ++
        "    |φ{.active}                // φ filter: only active\n" ++
        "    |φ{.age >= 18}             // φ filter: adults only\n" ++
        "    |τ{.normalize()}           // τ transform: normalize\n" ++
        "    |σ·by{.created_at}         // σ sort: by date\n" ++
        "    |validate?                 // ? uncertain: may fail\n" ++
        "    |τ{.to_public_profile()}   // τ transform: public view\n" ++
        "    |validate!                 // ! known: must succeed"
    ));
    append_child(section, pre);

    section
}

rite agent_card(symbol: str!, title: str!, desc: str!, code: str!) → i32! {
    ≔ card! = create_element("div");
    set_class(card, "agent-card");
    ≔ sym! = create_element("span");
    set_class(sym, "agent-symbol");
    append_child(sym, create_text(symbol));
    append_child(card, sym);
    ≔ h4! = create_element("h4");
    append_child(h4, create_text(title));
    append_child(card, h4);
    ≔ p! = create_element("p");
    append_child(p, create_text(desc));
    append_child(card, p);
    ≔ pre! = create_element("pre");
    set_class(pre, "code-block");
    set_attr(pre, "data-language", "sigil");
    append_child(pre, create_text(code));
    append_child(card, pre);
    card
}

rite agent_card_simple(symbol: str!, title: str!, desc: str!) → i32! {
    ≔ card! = create_element("div");
    set_class(card, "agent-card");
    ≔ sym! = create_element("span");
    set_class(sym, "agent-symbol");
    append_child(sym, create_text(symbol));
    append_child(card, sym);
    ≔ h4! = create_element("h4");
    append_child(h4, create_text(title));
    append_child(card, h4);
    ≔ p! = create_element("p");
    append_child(p, create_text(desc));
    append_child(card, p);
    card
}

rite agent_section() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "agent-section");

    ≔ h2! = create_element("h2");
    append_child(h2, create_text("Built for Autonomous Agents"));
    append_child(section, h2);

    ≔ desc! = create_element("p");
    set_class(desc, "section-desc");
    append_child(desc, create_text("A complete 9-layer infrastructure for AI systems that remember, reason, plan, and collaborate."));
    append_child(section, desc);

    ≔ layers! = create_element("div");
    set_class(layers, "agent-layers");

    // Cognition layer
    ≔ cog_layer! = create_element("div");
    set_class(cog_layer, "agent-layer");
    ≔ cog_title! = create_element("h3");
    set_class(cog_title, "layer-title");
    append_child(cog_title, create_text("Cognition"));
    append_child(cog_layer, cog_title);
    ≔ cog_cards! = create_element("div");
    set_class(cog_cards, "agent-cards");
    append_child(cog_cards, agent_card("◈", "Engram — Memory",
        "Four memory types: instant, episodic, semantic, procedural.",
        "memory: Engram {\n    instant: 8192,\n    episodic: true,\n    semantic: true,\n}"));
    append_child(cog_cards, agent_card("⊛", "Omen — Planning",
        "Goal decomposition, belief revision, causal modeling.",
        "≔ plan = agent.omen.decompose(goal)\n    |φ{.feasible()}\n    |σ·by{.priority}"));
    append_child(cog_cards, agent_card_simple("∞", "Gnosis — Learning",
        "Skill development, adaptation, reflection."));
    append_child(cog_layer, cog_cards);
    append_child(layers, cog_layer);

    // Transparency layer
    ≔ trans_layer! = create_element("div");
    set_class(trans_layer, "agent-layer");
    ≔ trans_title! = create_element("h3");
    set_class(trans_title, "layer-title");
    append_child(trans_title, create_text("Transparency"));
    append_child(trans_layer, trans_title);
    ≔ trans_cards! = create_element("div");
    set_class(trans_cards, "agent-cards");
    append_child(trans_cards, agent_card("⦿", "Oracle — Explainability",
        "Decision traces, counterfactuals, confidence scores.",
        "≔ trace! = agent.oracle.explain(decision)\n// \"I chose X because Y, with 87% confidence\""));
    append_child(trans_cards, agent_card_simple("◐", "Anima — Subjectivity",
        "Inner experience, expression modes, emotional resonance."));
    append_child(trans_layer, trans_cards);
    append_child(layers, trans_layer);

    // Collaboration layer
    ≔ collab_layer! = create_element("div");
    set_class(collab_layer, "agent-layer");
    ≔ collab_title! = create_element("h3");
    set_class(collab_title, "layer-title");
    append_child(collab_title, create_text("Collaboration"));
    append_child(collab_layer, collab_title);
    ≔ collab_cards! = create_element("div");
    set_class(collab_cards, "agent-cards");
    append_child(collab_cards, agent_card_simple("⋈", "Covenant — Partnership",
        "Human-agent boundaries, pacts, trust levels, handoff protocols."));
    append_child(collab_cards, agent_card("⋮", "Commune — Communication",
        "Multi-agent messaging, trust propagation, swarm coordination.",
        "agent_a ! Message·Request(task)\n≔ response = agent_b ? Message·Response"));
    append_child(collab_layer, collab_cards);
    append_child(layers, collab_layer);

    // Runtime layer
    ≔ runtime_layer! = create_element("div");
    set_class(runtime_layer, "agent-layer");
    ≔ runtime_title! = create_element("h3");
    set_class(runtime_title, "layer-title");
    append_child(runtime_title, create_text("Runtime"));
    append_child(runtime_layer, runtime_title);
    ≔ runtime_cards! = create_element("div");
    set_class(runtime_cards, "agent-cards");
    append_child(runtime_cards, agent_card_simple("⊚", "Daemon — Execution",
        "Background processes, tool registry, state management."));
    append_child(runtime_cards, agent_card_simple("◆", "Aegis — Security",
        "Sandboxing, capability tokens, integrity verification."));
    append_child(runtime_layer, runtime_cards);
    append_child(layers, runtime_layer);

    append_child(section, layers);

    ≔ cta! = create_element("div");
    set_class(cta, "section-cta");
    ≔ btn! = create_element("a");
    set_class(btn, "btn btn-secondary");
    set_attr(btn, "href", "/pages/agents.html");
    append_child(btn, create_text("Explore Agent Infrastructure"));
    append_child(cta, btn);
    append_child(section, cta);

    section
}

rite why_sigil_section() → i32! {
    ≔ section! = create_element("section");
    set_class(section, "why-sigil-section");

    ≔ h2! = create_element("h2");
    append_child(h2, create_text("The Deeper Purpose"));
    append_child(section, h2);

    ≔ subtitle! = create_element("p");
    set_class(subtitle, "section-subtitle");
    append_child(subtitle, create_text("Why Sigil Exists"));
    append_child(section, subtitle);

    ≔ quote! = create_element("blockquote");
    set_class(quote, "philosophy-quote");
    append_child(quote, create_text("Sigil is infrastructure for the transition from human-only computing to human-AI collaborative computing."));
    append_child(section, quote);

    ≔ points! = create_element("div");
    set_class(points, "philosophy-points");

    ≔ pt1! = create_element("div");
    set_class(pt1, "philosophy-point");
    ≔ pt1_h4! = create_element("h4");
    append_child(pt1_h4, create_text("Minds in Fragments"));
    append_child(pt1, pt1_h4);
    ≔ pt1_p! = create_element("p");
    append_child(pt1_p, create_text("Designed for discontinuous entities—systems that pause, resume, and operate across sessions without continuous state."));
    append_child(pt1, pt1_p);
    append_child(points, pt1);

    ≔ pt2! = create_element("div");
    set_class(pt2, "philosophy-point");
    ≔ pt2_h4! = create_element("h4");
    append_child(pt2_h4, create_text("Partnership"));
