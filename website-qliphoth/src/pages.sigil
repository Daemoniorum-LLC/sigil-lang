rite pattern_sidebar() → VNode! {
    ≔ sidebar_style! = "position: sticky; top: 8rem; height: fit-content;"
    ≔ section_style! = "margin-bottom: 2rem;"
    ≔ title_style! = "font-size: 0.75rem; font-weight: 600; color: #6c6c76; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem;"
    ≔ link_style! = "display: block; color: #a0a0aa; font-size: 0.875rem; padding: 0.375rem 0; text-decoration: none;"

    aside()
        ·class("docs-sidebar")
        ·style(sidebar_style)
        ·child(sidebar_section("Philosophy", vec!["Overview", "Core Principles"], section_style, title_style, link_style))
        ·child(sidebar_section("Evidentiality", vec!["Data Has History", "Trust is Explicit"], section_style, title_style, link_style))
        ·child(sidebar_section("Design", vec!["Pipelines Over Loops", "Types as Documentation"], section_style, title_style, link_style))
        ·to_vnode()
}

rite pattern_content() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"
    ≔ heading_style! = "font-size: 1.5rem; font-weight: 600; color: #e8e8ec; margin: 2.5rem 0 1rem;"

    article()
        ·class("docs-content")
        ·child(
            h1()
                ·id("pattern")
                ·style("font-size: 2.5rem; font-weight: 700; color: #e8e8ec; margin-bottom: 1.5rem;")
                ·child(text("The Pattern"))
                ·to_vnode()
        )
        ·child(
            p()
                ·class("lead")
                ·style("font-size: 1.25rem; color: #a0a0aa; margin-bottom: 2rem;")
                ·child(text("The philosophy behind Sigil's design: a language where data provenance is not an afterthought but the foundation."))
                ·to_vnode()
        )
        ·child(h2()·style(heading_style)·child(text("Data Has History"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Every value in Sigil carries information about where it came from. This isn't metadata—it's enforced by the type system. A String~ is fundamentally different from a String! even though both hold text."))·to_vnode())
        ·child(p()·style(prose_style)·child(text("The ~ marker doesn't mean 'dangerous'. It means 'from elsewhere'. External data requires explicit validation before it can cross into trusted contexts."))·to_vnode())
        ·child(h2()·style(heading_style)·child(text("Trust is Explicit"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Most languages implicitly trust all data equally. Sigil makes trust explicit through validation boundaries:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "// The pipe-validate operator creates trust boundaries\n" ++
                "≔ user_input~ = get_input();\n" ++
                "≔ trusted! = user_input |> validate {\n" ++
                "    sanitize();\n" ++
                "    verify_format();\n" ++
                "};\n\n" ++
                "// trusted is now ! — it crossed the boundary explicitly",
                "sigil"
            )·to_vnode()
        )
        ·child(h2()·style(heading_style)·child(text("Pipelines Over Loops"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Morpheme operators (φ map, τ transform, σ filter, ρ reduce) express data transformations declaratively. This makes the flow of data—and therefore the flow of trust—visible at a glance."))·to_vnode())
        ·child(
            CodeBlock::new(
                "// Declarative pipeline with visible data flow\n" ++
                "≔ result! = users~\n" ++
                "    |φ{ validate_user }\n" ++
                "    |σ{ |u| u.active }\n" ++
                "    |τ{ |u| u.email };\n\n" ++
                "// Each step's evidentiality is type-checked",
                "sigil"
            )·to_vnode()
        )
        ·child(h2()·style(heading_style)·child(text("Types as Documentation"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("In Sigil, function signatures tell you not just what types flow through, but what trust levels are expected and produced. A function λ process(input: Data~) → Result! documents its trust boundary in the signature."))·to_vnode())
        ·to_vnode()
}

