//! Page Components
//!
//! Each page component corresponds to a route in the application.

use qliphoth_ui::prelude::*;
use sigil_web::prelude::*;
use crate::components::*;

// =============================================================================
// Home Page
// =============================================================================

/// The main landing page for sigil-lang.com
#[component]
pub fn Home() -> Element! {
    html! {
        <>
            <Hero />
            <ProblemSection />
            <EvidentialitySection />
            <MorphemeSection />
            <AgentInfraSection />
            <PatternSection />
            <CodeDensitySection />
            <EcosystemSection />
            <GetStartedSection />
            <TechnicalSummarySection />
        </>
    }
}

// =============================================================================
// Home Page Sections
// =============================================================================

/// The problem comparison: Before/After
#[component]
fn ProblemSection() -> Element! {
    let comparison_style! = "
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    ";

    let rust_code! = r#"// This compiles in every mainstream language
async fn get_user_profile(id: String) -> Profile {
    let response = http::get("/api/users/{id}").await;
    let profile: Profile = response.json();

    // profile is type Profile
    // But it came from an external API!
    // What if the API was compromised?
    // What if the data was tampered?

    save_to_database(profile);  // Trusting blindly
    profile
}"#;

    let sigil_code! = r#"async fn get_user_profile(id: Str) -> Profile! {
    let response~ = http::get("/api/users/{id}").await;
    let profile~: Profile~ = response.json();

    // profile~ is type Profile~ (Reported)
    // The ~ marker propagates automatically

    save_to_database(profile);  // ERROR: expected Profile!, got Profile~

    // Must validate first:
    let verified! = profile |validate!{ verify_signature() };
    save_to_database(verified);  // OK: Profile!
    verified
}"#;

    html! {
        <Section id="the-problem" dark={true!}>
            <SectionHeader
                title="The Bug That Types Can't Catch"
                subtitle="In every other language, this code compiles. In Sigil, it's a type error."
            />

            <div style={comparison_style}>
                <SigilCodeBlock
                    code={rust_code.to_string()}
                    language="rust"
                    title="Rust / TypeScript / Go"
                    badge="Compiles. Vulnerable."
                    badge_variant="danger"
                />

                <SigilCodeBlock
                    code={sigil_code.to_string()}
                    language="sigil"
                    title="Sigil"
                    badge="Type Error. Safe."
                    badge_variant="success"
                />
            </div>

            <p style="text-align: center; color: #a0a0aa; margin-top: 2rem; max-width: 700px; margin-left: auto; margin-right: auto;">
                "The "
                <code style="color: #6B9BD1;">"~"</code>
                " marker is "
                <em>"contagious"</em>
                ". Any data derived from external sources inherits the "
                <code style="color: #6B9BD1;">"~"</code>
                " until explicitly validated. You can't accidentally trust untrusted data."
            </p>
        </Section>
    }
}

/// Evidentiality markers deep dive
#[component]
fn EvidentialitySection() -> Element! {
    let grid_style! = "
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 3rem;
    ";

    let card_style! = "
        background: #0c0c0f;
        border: 1px solid #1a1a1f;
        border-radius: 0.75rem;
        padding: 1.5rem;
    ";

    let header_style! = "
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    ";

    let marker_style_known! = "font-size: 2rem; color: #14A088;";
    let marker_style_uncertain! = "font-size: 2rem; color: #D4A017;";
    let marker_style_reported! = "font-size: 2rem; color: #6B9BD1;";
    let marker_style_paradox! = "font-size: 2rem; color: #D47171;";

    let title_style! = "font-weight: 600; color: #e8e8ec;";
    let subtitle_style! = "font-size: 0.875rem; color: #a0a0aa;";
    let desc_style! = "color: #a0a0aa; font-size: 0.9375rem; margin-bottom: 1rem;";

    let code_style! = "
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.8125rem;
        background: #030305;
        padding: 0.75rem;
        border-radius: 0.375rem;
        color: #e8e8ec;
    ";

    let rule_style! = "
        background: #0c0c0f;
        border: 1px solid #1a1a1f;
        border-radius: 0.75rem;
        padding: 1.5rem;
    ";

    html! {
        <Section>
            <SectionHeader
                title="Evidentiality: Data Has a History"
                subtitle="Every value carries proof of where it came from."
            />

            <div style={grid_style}>
                // Known card
                <article style={card_style}>
                    <div style={header_style}>
                        <span style={marker_style_known}>"!"</span>
                        <div>
                            <h3 style={title_style}>"Known"</h3>
                            <p style={subtitle_style}>"Verified truth"</p>
                        </div>
                    </div>
                    <p style={desc_style}>"Data you computed yourself, or explicitly verified. Safe to trust."</p>
                    <pre style={code_style}><code>"let sum! = 2 + 2\nlet valid! = input |validate!{ check() }"</code></pre>
                </article>

                // Uncertain card
                <article style={card_style}>
                    <div style={header_style}>
                        <span style={marker_style_uncertain}>"?"</span>
                        <div>
                            <h3 style={title_style}>"Uncertain"</h3>
                            <p style={subtitle_style}>"Might be absent"</p>
                        </div>
                    </div>
                    <p style={desc_style}>"Data that might not exist. Like Option/Maybe, but tracked in the type."</p>
                    <pre style={code_style}><code>"let user? = database.find(id)\nlet name? = user?.profile?.name"</code></pre>
                </article>

                // Reported card
                <article style={card_style}>
                    <div style={header_style}>
                        <span style={marker_style_reported}>"~"</span>
                        <div>
                            <h3 style={title_style}>"Reported"</h3>
                            <p style={subtitle_style}>"External source"</p>
                        </div>
                    </div>
                    <p style={desc_style}>"Data from APIs, user input, files. "<strong>"Never trust without validation."</strong></p>
                    <pre style={code_style}><code>"let data~ = api.fetch(url)\nlet input~ = form.get(\"email\")"</code></pre>
                </article>

                // Paradox card
                <article style={card_style}>
                    <div style={header_style}>
                        <span style={marker_style_paradox}>"‽"</span>
                        <div>
                            <h3 style={title_style}>"Paradox"</h3>
                            <p style={subtitle_style}>"Trust boundary"</p>
                        </div>
                    </div>
                    <p style={desc_style}>"Explicit \"I know what I'm doing\" escape hatch. Use sparingly."</p>
                    <pre style={code_style}><code>"let ptr‽ = unsafe { raw_pointer }\n// You're taking responsibility"</code></pre>
                </article>
            </div>

            // Propagation rule
            <div style={rule_style}>
                <h4 style="color: #e8e8ec; font-weight: 600; margin-bottom: 1rem;">"The Propagation Rule"</h4>
                <p style="color: #a0a0aa; margin-bottom: 1rem;">
                    "When you combine data, the result inherits the "
                    <em>"worst"</em>
                    " evidence level:"
                </p>
                <pre style={code_style}><code>{r#"let local! = 100                    // Known
let remote~ = api.get_multiplier()   // Reported
let result~ = local * remote          // Known + Reported = Reported
//       ^ automatically inferred as ~ because remote is untrusted"#}</code></pre>
            </div>
        </Section>
    }
}

/// Morpheme operators section
#[component]
fn MorphemeSection() -> Element! {
    let demo_style! = "
        background: #030305;
        border: 1px solid #1a1a1f;
        border-radius: 0.5rem;
        padding: 1.5rem;
        margin-bottom: 2rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.9375rem;
        line-height: 1.7;
    ";

    let grid_style! = "
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    ";

    let morpheme_code! = r#"let result = users~
    |φ{.active}              // φ filter: keep active users
    |φ{.age >= 18}           // φ filter: adults only
    |τ{.normalize()}         // τ transform: normalize each
    |σ·by{.created_at}       // σ sort: by creation date
    |validate?               // promote to uncertain after checks
    |τ{.to_public_profile()} // τ transform: strip private data
    |validate!               // promote to known after verification"#;

    html! {
        <Section dark={true!}>
            <SectionHeader
                title="Morpheme Operators"
                subtitle="Greek letters for data transformation. Dense, readable pipelines."
            />

            <pre style={demo_style}><code>{morpheme_code}</code></pre>

            <div style={grid_style}>
                <MorphemeCard symbol="φ" name="phi" description="Filter elements" />
                <MorphemeCard symbol="τ" name="tau" description="Transform each" />
                <MorphemeCard symbol="σ" name="sigma" description="Sort" />
                <MorphemeCard symbol="ρ" name="rho" description="Reduce/fold" />
                <MorphemeCard symbol="Σ" name="sum" description="Sum all" />
                <MorphemeCard symbol="Π" name="product" description="Multiply all" />
                <MorphemeCard symbol="α" name="alpha" description="First element" />
                <MorphemeCard symbol="ω" name="omega" description="Last element" />
            </div>
        </Section>
    }
}

/// Agent infrastructure section
#[component]
fn AgentInfraSection() -> Element! {
    let layer_group_style! = "
        margin-bottom: 2rem;
    ";

    let group_title_style! = "
        font-size: 0.875rem;
        font-weight: 600;
        color: #14A088;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
    ";

    let layers_style! = "
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    ";

    let layer_style! = "
        background: #0c0c0f;
        border: 1px solid #1a1a1f;
        border-radius: 0.5rem;
        padding: 1.25rem;
    ";

    let layer_icon_style! = "
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    ";

    let layer_name_style! = "
        font-weight: 600;
