//! Page Components
//!
//! Each page component corresponds to a route in the application.

use qliphoth::prelude::*
use sigil_web::prelude::*
use crate::components::*

// =============================================================================
// Home Page
// =============================================================================

/// The main landing page for sigil-lang.com
☉ sigil Home { }

⊢ Home {
    ☉ rite new() → This! {
        Home { }
    }
}

⊢ Component for Home {
    rite render(&this) → VNode! {
        fragment()
            ·child(hero_section())
            ·child(features_section())
            ·child(problem_section())
            ·child(evidentiality_section())
            ·child(morpheme_section())
            ·child(getting_started_section())
            ·to_vnode()
    }

    rite props_to_map(&this) → HashMap<String, PropValue>! {
        HashMap::new()
    }

    rite from_props(_props: HashMap<String, PropValue>) → This! {
        Home::new()
    }
}

/// Hero section with title and CTA
rite hero_section() → VNode! {
    ≔ section_style! = "
        min-height: 80vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 8rem 1.5rem 4rem;
        background: linear-gradient(180deg, #050507 0%, #0a0a0d 100%);
    "

    ≔ title_style! = "
        font-size: 4rem;
        font-weight: 700;
        color: #e8e8ec;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    "

    ≔ subtitle_style! = "
        font-size: 1.5rem;
        color: #a0a0aa;
        max-width: 600px;
        line-height: 1.6;
        margin-bottom: 2rem;
    "

    ≔ cta_style! = "
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
    "

    section()
        ·class("hero")
        ·style(section_style)
        ·child(
            h1()
                ·style(title_style)
                ·child(text("⛤ Sigil"))
                ·to_vnode()
        )
        ·child(
            p()
                ·class("hero-subtitle")
                ·style(subtitle_style)
                ·child(text("A programming language that knows which data to trust."))
                ·to_vnode()
        )
        ·child(
            div()
                ·style(cta_style)
                ·child(Button::primary("Learn Sigil", "/pages/learn.html")·to_vnode())
                ·child(Button::secondary("View on GitHub", "https://github.com/Daemoniorum-LLC/sigil-lang")·to_vnode())
                ·to_vnode()
        )
        ·to_vnode()
}

/// Features grid
rite features_section() → VNode! {
    ≔ section_style! = "padding: 6rem 1.5rem; max-width: 1200px; margin: 0 auto;"
    ≔ grid_style! = "display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;"
    ≔ card_style! = "background: #0c0c0f; border: 1px solid #1a1a1f; border-radius: 0.75rem; padding: 2rem;"
    ≔ title_style! = "font-size: 1.25rem; font-weight: 600; color: #e8e8ec; margin-bottom: 0.75rem;"
    ≔ desc_style! = "font-size: 0.9375rem; color: #a0a0aa; line-height: 1.6;"

    section()
        ·class("features-section")
        ·style(section_style)
        ·child(
            SectionHeader::new("Language Features")
                ·with_subtitle("Built for AI agents with data provenance tracking")
                ·to_vnode()
        )
        ·child(
            div()
                ·style(grid_style)
                ·child(feature_card("Evidentiality Markers", "Track data provenance at the type level with !, ?, ~, and ◊ markers.", card_style, title_style, desc_style))
                ·child(feature_card("Morpheme Operators", "Parallel pipelines, async composition, and functional transforms built into syntax.", card_style, title_style, desc_style))
                ·child(feature_card("WebAssembly Native", "Compile directly to WASM for web, edge, and embedded deployments.", card_style, title_style, desc_style))
                ·child(feature_card("Agent Infrastructure", "9-layer architecture for building autonomous AI systems.", card_style, title_style, desc_style))
                ·to_vnode()
        )
        ·to_vnode()
}

rite feature_card(title: &str, desc: &str, card_style: &str, title_style: &str, desc_style: &str) → VNode! {
    div()
        ·class("feature-card")
        ·style(card_style)
        ·child(
            h3()
                ·style(title_style)
                ·child(text(title))
                ·to_vnode()
        )
        ·child(
            p()
                ·style(desc_style)
                ·child(text(desc))
                ·to_vnode()
        )
        ·to_vnode()
}

/// Problem/solution comparison section
rite problem_section() → VNode! {
    ≔ section_style! = "padding: 6rem 1.5rem; background: #0a0a0d;"
    ≔ container_style! = "max-width: 1000px; margin: 0 auto;"

    section()
        ·class("problem-section")
        ·id("problem")
        ·style(section_style)
        ·child(
            div()
                ·style(container_style)
                ·child(
                    SectionHeader::new("The Bug That Types Can't Catch")
                        ·with_subtitle("Traditional type systems don't track where data comes from")
                        ·to_vnode()
                )
                ·child(
                    CodeBlock::new(
                        "// In Rust, TypeScript, or Go - this compiles without warnings:\n" ++
                        "async fn get_user(id: String) -> Profile {\n" ++
                        "    let response = http::get(&format!(\"/api/users/{}\", id)).await;\n" ++
                        "    let profile: Profile = response.json();  // External data\n" ++
                        "    save_to_database(&profile);  // No validation!\n" ++
                        "    profile\n" ++
                        "}",
                        "rust"
                    )·with_title("Traditional Languages")·to_vnode()
                )
                ·child(
                    CodeBlock::new(
                        "// In Sigil - the compiler catches this:\n" ++
                        "async rite get_user(id: !String) → !Profile {\n" ++
                        "    ≔ response~ = Http·get(\"/api/users/{id}\").await  // ~ = external\n" ++
                        "    ≔ profile~ = response·json::<~Profile>()           // ~ propagates\n" ++
                        "    save_to_database(profile)  // ERROR: ~ cannot flow to !\n" ++
                        "    \n" ++
                        "    ≔ validated! = profile |validate!{ verify() }      // Explicit validation\n" ++
                        "    save_to_database(validated)  // OK: ! flows to !\n" ++
                        "    validated\n" ++
                        "}",
                        "sigil"
                    )·with_title("Sigil")·to_vnode()
                )
                ·to_vnode()
        )
        ·to_vnode()
}

/// Evidentiality markers explanation
rite evidentiality_section() → VNode! {
    ≔ section_style! = "padding: 6rem 1.5rem; max-width: 1200px; margin: 0 auto;"
    ≔ grid_style! = "display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-top: 2rem;"

    section()
        ·style(section_style)
        ·child(
            SectionHeader::new("Evidentiality: Data Has History")
                ·with_eyebrow("Type System")
                ·with_subtitle("Every value carries information about its origin")
                ·to_vnode()
        )
        ·child(
            div()
                ·style(grid_style)
                ·child(ev_card("!", "Known", "Verified truth", "#14A088"))
                ·child(ev_card("?", "Uncertain", "Might be absent", "#D4A017"))
                ·child(ev_card("~", "Reported", "External source", "#6B9BD1"))
                ·child(ev_card("◊", "Predicted", "AI/ML output", "#9B6BD1"))
                ·child(ev_card("‽", "Paradox", "Trust boundary", "#D47171"))
                ·to_vnode()
        )
        ·to_vnode()
}

rite ev_card(marker: &str, name: &str, desc: &str, color: &str) → VNode! {
    ≔ card_style! = format!("
        background: #0c0c0f;
        border: 1px solid {};
        border-radius: 0.75rem;
        padding: 1.5rem;
        text-align: center;
    ", color)

    ≔ marker_style! = format!("
        font-size: 2.5rem;
        font-weight: 700;
        color: {};
        display: block;
        margin-bottom: 0.75rem;
    ", color)

    div()
        ·style(&card_style)
        ·child(
            span()
                ·style(&marker_style)
                ·child(text(marker))
                ·to_vnode()
        )
        ·child(
            h4()
                ·style("font-size: 1.125rem; font-weight: 600; color: #e8e8ec; margin-bottom: 0.5rem;")
                ·child(text(name))
                ·to_vnode()
        )
        ·child(
            p()
                ·style("font-size: 0.875rem; color: #a0a0aa;")
                ·child(text(desc))
                ·to_vnode()
        )
        ·to_vnode()
}

/// Morpheme operators section
rite morpheme_section() → VNode! {
    ≔ section_style! = "padding: 6rem 1.5rem; background: #0a0a0d;"
    ≔ container_style! = "max-width: 900px; margin: 0 auto;"
    ≔ grid_style! = "display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem;"
    ≔ op_style! = "background: #0c0c0f; border: 1px solid #1a1a1f; border-radius: 0.5rem; padding: 1rem; text-align: center; font-family: 'IBM Plex Mono', monospace;"

    section()
        ·style(section_style)
        ·child(
            div()
                ·style(container_style)
                ·child(
                    SectionHeader::new("Morpheme Operators")
                        ·with_subtitle("Greek letters for data transformation. Dense, readable pipelines.")
                        ·to_vnode()
                )
                ·child(
                    div()
                        ·class("morpheme-grid")
                        ·style(grid_style)
                        ·child(morpheme_op("φ", "filter", op_style))
                        ·child(morpheme_op("τ", "transform", op_style))
                        ·child(morpheme_op("σ", "sort", op_style))
                        ·child(morpheme_op("ρ", "reduce", op_style))
                        ·child(morpheme_op("Σ", "sum", op_style))
                        ·child(morpheme_op("Π", "product", op_style))
                        ·child(morpheme_op("α", "first", op_style))
                        ·child(morpheme_op("ω", "last", op_style))
                        ·to_vnode()
                )
                ·child(
                    CodeBlock::new(
                        "≔ result = users~              // ~ reported: external data\n" ++
                        "    |φ{.active}                // φ filter: only active\n" ++
                        "    |φ{.age >= 18}             // φ filter: adults only\n" ++
                        "    |τ{.normalize()}           // τ transform: normalize\n" ++
                        "    |σ·by{.created_at}         // σ sort: by date\n" ++
                        "    |validate?                 // ? uncertain: may fail\n" ++
                        "    |τ{.to_public_profile()}   // τ transform: public view\n" ++
                        "    |validate!                 // ! known: must succeed",
                        "sigil"
                    )·with_title("Pipeline Example")·to_vnode()
                )
                ·to_vnode()
        )
        ·to_vnode()
}

rite morpheme_op(symbol: &str, name: &str, style: &str) → VNode! {
    div()
        ·class("morpheme-op")
        ·style(style)
        ·child(
            span()
                ·style("font-size: 1.5rem; color: #14A088; display: block;")
                ·child(text(symbol))
                ·to_vnode()
        )
        ·child(
            span()
                ·style("font-size: 0.75rem; color: #a0a0aa;")
                ·child(text(name))
                ·to_vnode()
        )
        ·to_vnode()
}

/// Getting started section
rite getting_started_section() → VNode! {
    ≔ section_style! = "padding: 6rem 1.5rem; max-width: 800px; margin: 0 auto;"

    section()
        ·style(section_style)
        ·child(
            SectionHeader::new("Get Started")
                ·with_subtitle("Install Sigil and write your first program")
                ·to_vnode()
        )
        ·child(
            CodeBlock::new(
                "# Clone and build\n" ++
                "git clone https://github.com/Daemoniorum-LLC/sigil-lang\n" ++
                "cd sigil-lang/parser && cargo build --release\n\n" ++
                "# Run your first program\n" ++
                "./target/release/sigil run hello.sigil",
                "bash"
            )·with_title("Installation")·to_vnode()
        )
        ·child(
            CodeBlock::new(
                "// hello.sigil\n" ++
                "rite main() {\n" ++
                "    ≔ name! = \"World\"\n" ++
                "    println(\"Hello, {name}!\")\n" ++
                "}",
                "sigil"
            )·with_title("hello.sigil")·to_vnode()
        )
        ·child(
            div()
                ·style("display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;")
                ·child(Button::primary("Start Tutorial", "/pages/learn.html")·to_vnode())
                ·child(Button::secondary("Read Docs", "/pages/docs.html")·to_vnode())
                ·to_vnode()
        )
        ·to_vnode()
}

// =============================================================================
// Learn Page - Tutorial with 5 Chapters
// =============================================================================

/// Learn page with 5-chapter tutorial
☉ sigil Learn { }

⊢ Learn {
    ☉ rite new() → This! {
        Learn { }
    }
}

⊢ Component for Learn {
    rite render(&this) → VNode! {
        ≔ content_style! = "padding: 8rem 1.5rem 4rem; max-width: 900px; margin: 0 auto;"

        div()
            ·class("learn-content")
            ·style(content_style)
            ·child(progress_bar(5, 1))
            ·child(chapter_1())
            ·child(chapter_2())
            ·child(chapter_3())
            ·child(chapter_4())
            ·child(chapter_5())
            ·to_vnode()
    }

    rite props_to_map(&this) → HashMap<String, PropValue>! {
        HashMap::new()
    }

    rite from_props(_props: HashMap<String, PropValue>) → This! {
        Learn::new()
    }
}

/// Progress bar showing tutorial steps
rite progress_bar(total: !i32, current: !i32) → VNode! {
    ≔ bar_style! = "
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 4rem;
        padding: 1rem;
    "

    ≔ steps! = div()
        ·class("progress-bar")
        ·style(bar_style)

    for i in 1..=total {
        ≔ active! = i <= current
        ≔ step_style! = if active {
            "width: 3rem; height: 0.25rem; background: #14A088; border-radius: 0.125rem;"
        } else {
            "width: 3rem; height: 0.25rem; background: #1a1a1f; border-radius: 0.125rem;"
        }

        steps = steps·child(
            div()
                ·class("progress-step")
                ·style(step_style)
                ·to_vnode()
        )
    }

    steps·to_vnode()
}

/// Chapter wrapper component
rite chapter(number: !i32, title: &str, content: VNode!) → VNode! {
    ≔ chapter_style! = "margin-bottom: 4rem; padding-bottom: 4rem; border-bottom: 1px solid #1a1a1f;"
    ≔ header_style! = "display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2rem;"
    ≔ number_style! = "font-size: 0.875rem; font-weight: 600; color: #14A088; text-transform: uppercase; letter-spacing: 0.1em;"
    ≔ title_style! = "font-size: 2rem; font-weight: 700; color: #e8e8ec;"

    article()
        ·class("chapter")
        ·style(chapter_style)
        ·child(
            header()
                ·class("chapter-header")
                ·style(header_style)
                ·child(
                    span()
                        ·class("chapter-number")
                        ·style(number_style)
                        ·child(text(&format!("Chapter {}", number)))
                        ·to_vnode()
                )
                ·child(
                    h2()
                        ·style(title_style)
                        ·child(text(title))
                        ·to_vnode()
                )
                ·to_vnode()
        )
        ·child(content)
        ·to_vnode()
}

/// Chapter 1: Getting Started
rite chapter_1() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"

    chapter(1, "Getting Started",
        fragment()
            ·child(
                p()
                    ·style(prose_style)
                    ·child(text("Welcome to Sigil! This tutorial will guide you through the fundamentals of the language."))
                    ·to_vnode()
            )
            ·child(
                CodeBlock::new(
                    "# Clone and build\n" ++
                    "git clone https://github.com/Daemoniorum-LLC/sigil-lang\n" ++
                    "cd sigil-lang/parser && cargo build --release",
                    "bash"
                )·to_vnode()
            )
            ·child(
                CodeBlock::new(
                    "// hello.sigil\n" ++
                    "rite main() {\n" ++
                    "    println(\"Hello, Sigil!\")\n" ++
                    "}",
                    "sigil"
                )·to_vnode()
            )
            ·to_vnode()
    )
}

/// Chapter 2: Evidentiality
rite chapter_2() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"

    chapter(2, "Evidentiality",
        fragment()
            ·child(
                p()
                    ·style(prose_style)
                    ·child(text("Sigil's type system tracks where data comes from."))
                    ·to_vnode()
            )
            ·child(
                CodeBlock::new(
                    "≔ computed!  = 2 + 2         // ! Known\n" ++
                    "≔ maybe?     = find_user(id) // ? Uncertain\n" ++
                    "≔ external~  = api·fetch()   // ~ Reported",
                    "sigil"
                )·to_vnode()
            )
            ·to_vnode()
    )
}

/// Chapter 3: Morphemes
rite chapter_3() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"

    chapter(3, "Morpheme Operators",
        fragment()
            ·child(
                p()
                    ·style(prose_style)
                    ·child(text("Greek letters for expressive data pipelines."))
                    ·to_vnode()
            )
            ·child(
                CodeBlock::new(
                    "items |φ{.active}       // φ filter\n" ++
                    "items |τ{.transform()}  // τ transform\n" ++
                    "items |σ·by{.date}      // σ sort",
                    "sigil"
                )·to_vnode()
            )
            ·to_vnode()
    )
}

/// Chapter 4: Data Structures
rite chapter_4() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"

    chapter(4, "Data Structures",
        fragment()
            ·child(
                p()
                    ·style(prose_style)
                    ·child(text("Structs and enums with evidentiality."))
                    ·to_vnode()
            )
            ·child(
                CodeBlock::new(
                    "☉ sigil User {\n" ++
                    "    id: !i64,\n" ++
                    "    name: !String,\n" ++
                    "}",
                    "sigil"
                )·to_vnode()
            )
            ·to_vnode()
    )
}

/// Chapter 5: Building Applications
rite chapter_5() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"

    chapter(5, "Building Applications",
        fragment()
            ·child(
                p()
                    ·style(prose_style)
                    ·child(text("Multiple compilation targets: interpreter, JIT, native, and WASM."))
                    ·to_vnode()
            )
            ·child(
                CodeBlock::new(
                    "sigil run app.sigil      # Interpreter\n" ++
                    "sigil compile app.sigil  # Native binary\n" ++
                    "sigil wasm app.sigil     # WebAssembly",
                    "bash"
                )·to_vnode()
            )
            ·child(
                div()
                    ·style("display: flex; gap: 1rem; margin-top: 2rem;")
                    ·child(Button::primary("Read Documentation", "/pages/docs.html")·to_vnode())
                    ·to_vnode()
            )
            ·to_vnode()
    )
}

// =============================================================================
// Docs Page
// =============================================================================

☉ sigil Docs { }

⊢ Docs {
    ☉ rite new() → This! { Docs { } }
}

⊢ Component for Docs {
    rite render(&this) → VNode! {
        ≔ layout_style! = "display: grid; grid-template-columns: 250px 1fr; gap: 2rem; padding: 8rem 1.5rem 4rem; max-width: 1400px; margin: 0 auto;"

        div()
            ·class("docs-layout")
            ·style(layout_style)
            ·child(docs_sidebar())
            ·child(docs_content())
            ·to_vnode()
    }

    rite props_to_map(&this) → HashMap<String, PropValue>! { HashMap::new() }
    rite from_props(_props: HashMap<String, PropValue>) → This! { Docs::new() }
}

rite docs_sidebar() → VNode! {
    ≔ sidebar_style! = "position: sticky; top: 8rem; height: fit-content;"
    ≔ section_style! = "margin-bottom: 2rem;"
    ≔ title_style! = "font-size: 0.75rem; font-weight: 600; color: #6c6c76; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem;"
    ≔ link_style! = "display: block; color: #a0a0aa; font-size: 0.875rem; padding: 0.375rem 0; text-decoration: none;"

    aside()
        ·class("docs-sidebar")
        ·style(sidebar_style)
        ·child(sidebar_section("Getting Started", vec!["Introduction", "Installation", "Hello World"], section_style, title_style, link_style))
        ·child(sidebar_section("Language", vec!["Types", "Functions", "Structs", "Enums"], section_style, title_style, link_style))
        ·child(sidebar_section("Evidentiality", vec!["Markers", "Propagation", "Validation"], section_style, title_style, link_style))
        ·child(sidebar_section("Morphemes", vec!["Filter", "Transform", "Sort", "Reduce"], section_style, title_style, link_style))
        ·child(sidebar_section("Standard Library", vec!["Collections", "IO", "Async"], section_style, title_style, link_style))
        ·child(sidebar_section("Agent Infrastructure", vec!["Overview", "Engram", "Omen"], section_style, title_style, link_style))
        ·to_vnode()
}

rite sidebar_section(title: &str, links: Vec<&str>, section_style: &str, title_style: &str, link_style: &str) → VNode! {
    ≔ section! = div()
        ·class("sidebar-section")
        ·style(section_style)
        ·child(h4()·style(title_style)·child(text(title))·to_vnode())

    for link in links {
        section = section·child(
            a()·attr("href", "#")·style(link_style)·child(text(link))·to_vnode()
        )
    }
    section·to_vnode()
}

rite docs_content() → VNode! {
    article()
        ·class("docs-content")
        ·child(
            h1()
                ·id("introduction")
                ·style("font-size: 2.5rem; font-weight: 700; color: #e8e8ec; margin-bottom: 1.5rem;")
                ·child(text("Sigil Documentation"))
                ·to_vnode()
        )
        ·child(
            p()
                ·class("lead")
                ·style("font-size: 1.25rem; color: #a0a0aa; margin-bottom: 2rem;")
                ·child(text("The complete reference for the Sigil programming language."))
                ·to_vnode()
        )
        ·child(
            div()
                ·class("feature-highlight")
                ·style("display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 3rem;")
                ·child(highlight_item("Evidentiality", "Track data provenance"))
                ·child(highlight_item("Morphemes", "Data pipelines"))
                ·child(highlight_item("Agents", "AI infrastructure"))
                ·to_vnode()
        )
        ·child(
            table()
                ·class("docs-table")
                ·style("width: 100%; border-collapse: collapse;")
                ·child(
                    thead()·child(
                        tr()
                            ·child(th()·style("text-align: left; padding: 0.75rem; border-bottom: 1px solid #1a1a1f; color: #e8e8ec;")·child(text("Marker"))·to_vnode())
                            ·child(th()·style("text-align: left; padding: 0.75rem; border-bottom: 1px solid #1a1a1f; color: #e8e8ec;")·child(text("Meaning"))·to_vnode())
                            ·to_vnode()
                    )·to_vnode()
                )
                ·child(
                    tbody()
                        ·child(tr()·child(td()·style("padding: 0.75rem; color: #14A088;")·child(text("!"))·to_vnode())·child(td()·style("padding: 0.75rem; color: #a0a0aa;")·child(text("Known"))·to_vnode())·to_vnode())
                        ·child(tr()·child(td()·style("padding: 0.75rem; color: #D4A017;")·child(text("?"))·to_vnode())·child(td()·style("padding: 0.75rem; color: #a0a0aa;")·child(text("Uncertain"))·to_vnode())·to_vnode())
                        ·child(tr()·child(td()·style("padding: 0.75rem; color: #6B9BD1;")·child(text("~"))·to_vnode())·child(td()·style("padding: 0.75rem; color: #a0a0aa;")·child(text("Reported"))·to_vnode())·to_vnode())
                        ·to_vnode()
                )
                ·to_vnode()
        )
        ·child(
            div()
                ·class("agent-overview-grid")
                ·style("display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem;")
                ·child(agent_layer("Cognition", "Engram, Omen, Gnosis"))
                ·to_vnode()
        )
        ·to_vnode()
}

rite highlight_item(title: &str, desc: &str) → VNode! {
    div()
        ·class("highlight-item")
        ·style("background: #0c0c0f; border: 1px solid #1a1a1f; border-radius: 0.5rem; padding: 1rem;")
        ·child(h4()·style("font-size: 0.9375rem; font-weight: 600; color: #e8e8ec;")·child(text(title))·to_vnode())
        ·child(p()·style("font-size: 0.8125rem; color: #a0a0aa;")·child(text(desc))·to_vnode())
        ·to_vnode()
}

rite agent_layer(name: &str, components: &str) → VNode! {
    div()
        ·class("agent-layer")
        ·style("background: #0c0c0f; border: 1px solid #1a1a1f; border-radius: 0.5rem; padding: 1rem;")
        ·child(h4()·style("font-size: 0.9375rem; font-weight: 600; color: #14A088;")·child(text(name))·to_vnode())
        ·child(p()·style("font-size: 0.8125rem; color: #a0a0aa;")·child(text(components))·to_vnode())
        ·to_vnode()
}

