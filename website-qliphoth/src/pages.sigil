                ·child(tr()·child(td()·style(layer_style)·child(text("2. Memory"))·to_vnode())·child(td()·style(cell_style)·child(text("Store and retrieve context"))·to_vnode())·child(td()·style(cell_style)·child(text("~ | !"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(layer_style)·child(text("3. Attention"))·to_vnode())·child(td()·style(cell_style)·child(text("Focus on relevant context"))·to_vnode())·child(td()·style(cell_style)·child(text("◊"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(layer_style)·child(text("4. Reasoning"))·to_vnode())·child(td()·style(cell_style)·child(text("Logical inference"))·to_vnode())·child(td()·style(cell_style)·child(text("! | ◊"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(layer_style)·child(text("5. Planning"))·to_vnode())·child(td()·style(cell_style)·child(text("Multi-step strategy"))·to_vnode())·child(td()·style(cell_style)·child(text("◊"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(layer_style)·child(text("6. Decision"))·to_vnode())·child(td()·style(cell_style)·child(text("Action selection"))·to_vnode())·child(td()·style(cell_style)·child(text("!"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(layer_style)·child(text("7. Execution"))·to_vnode())·child(td()·style(cell_style)·child(text("Tool invocation"))·to_vnode())·child(td()·style(cell_style)·child(text("~ | !"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(layer_style)·child(text("8. Reflection"))·to_vnode())·child(td()·style(cell_style)·child(text("Evaluate outcomes"))·to_vnode())·child(td()·style(cell_style)·child(text("◊"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(layer_style)·child(text("9. Meta"))·to_vnode())·child(td()·style(cell_style)·child(text("Self-monitoring"))·to_vnode())·child(td()·style(cell_style)·child(text("!"))·to_vnode())·to_vnode())
                ·to_vnode()
        )
        ·to_vnode()
}

