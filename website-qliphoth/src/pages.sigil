        font-size: 0.75rem;
        color: #14A088;
        margin-bottom: 0.5rem;
    ";

    let layer_desc_style! = "
        font-size: 0.875rem;
        color: #a0a0aa;
        line-height: 1.5;
    ";

    html! {
        <Section id="agents">
            <SectionHeader
                eyebrow="What Makes Sigil Different"
