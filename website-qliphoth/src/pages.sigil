            ·to_vnode()
    }
    rite props_to_map(&this) → HashMap<String, PropValue>! { HashMap::new() }
    rite from_props(_props: HashMap<String, PropValue>) → This! { NotFound::new() }
}

/// Helper for placeholder pages
rite placeholder_page(title: &str, desc: &str) → VNode! {
    div()
        ·style("min-height: 60vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 8rem 1.5rem;")
        ·child(h1()·style("font-size: 2.5rem; font-weight: 700; color: #e8e8ec;")·child(text(title))·to_vnode())
        ·child(p()·style("font-size: 1.125rem; color: #a0a0aa;")·child(text(desc))·to_vnode())
        ·child(Button::secondary("Back to Home", "/")·to_vnode())
        ·to_vnode()
}
