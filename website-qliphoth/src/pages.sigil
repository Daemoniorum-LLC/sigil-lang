rite examples_sidebar() → VNode! {
    ≔ sidebar_style! = "position: sticky; top: 8rem; height: fit-content;"
    ≔ section_style! = "margin-bottom: 2rem;"
    ≔ title_style! = "font-size: 0.75rem; font-weight: 600; color: #6c6c76; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem;"
    ≔ link_style! = "display: block; color: #a0a0aa; font-size: 0.875rem; padding: 0.375rem 0; text-decoration: none;"

    aside()
        ·class("docs-sidebar")
        ·style(sidebar_style)
        ·child(sidebar_section("Basics", vec!["Hello World", "Variables", "Functions"], section_style, title_style, link_style))
        ·child(sidebar_section("Evidentiality", vec!["Markers", "Pipelines", "Validation"], section_style, title_style, link_style))
        ·child(sidebar_section("Applications", vec!["CLI Tool", "Web Server", "WASM App"], section_style, title_style, link_style))
        ·to_vnode()
}

rite examples_content() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"
    ≔ heading_style! = "font-size: 1.5rem; font-weight: 600; color: #e8e8ec; margin: 2.5rem 0 1rem;"

    article()
        ·class("docs-content")
        ·child(
            h1()
                ·style("font-size: 2.5rem; font-weight: 700; color: #e8e8ec; margin-bottom: 1.5rem;")
                ·child(text("Code Examples"))
                ·to_vnode()
        )
        ·child(
            p()
                ·class("lead")
                ·style("font-size: 1.25rem; color: #a0a0aa; margin-bottom: 2rem;")
                ·child(text("Learn Sigil through practical code examples."))
                ·to_vnode()
        )
        // Example 1: Hello World
        ·child(h3()·style(heading_style)·child(text("Hello World"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("The classic first program in Sigil."))·to_vnode())
        ·child(
            CodeBlock::new(
                "λ main() {\n" ++
                "    println(\"Hello, Sigil!\")\n" ++
                "}",
                "sigil"
            )·to_vnode()
        )
        // Example 2: Variables with Evidentiality
        ·child(h3()·style(heading_style)·child(text("Variables with Evidentiality"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Every value carries provenance information."))·to_vnode())
        ·child(
            CodeBlock::new(
                "λ main() {\n" ++
                "    ≔ computed!  = 2 + 2        // Known: verified locally\n" ++
                "    ≔ maybe?     = find_user(1) // Uncertain: might be absent\n" ++
                "    ≔ external~  = api·fetch()  // Reported: external source\n" ++
                "    ≔ predicted◊ = model·infer() // Predicted: AI output\n" ++
                "}",
                "sigil"
            )·to_vnode()
        )
        // Example 3: Data Pipeline
        ·child(h3()·style(heading_style)·child(text("Data Pipeline"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Morpheme operators create readable data transformations."))·to_vnode())
        ·child(
            CodeBlock::new(
                "λ process_users(users: Vec<User>~) → Vec<PublicProfile>! {\n" ++
                "    users\n" ++
                "        |φ{.active}              // filter active\n" ++
                "        |φ{.age >= 18}           // filter adults\n" ++
                "        |τ{.normalize()}         // transform\n" ++
                "        |σ·by{.created_at}       // sort\n" ++
                "        |validate!               // convert ~ to !\n" ++
                "        |τ{.to_public()}         // final transform\n" ++
                "}",
                "sigil"
            )·to_vnode()
        )
        // Example 4: Struct Definition
        ·child(h3()·style(heading_style)·child(text("Struct Definition"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Define data structures with the Σ keyword."))·to_vnode())
        ·child(
            CodeBlock::new(
                "☉ Σ User {\n" ++
                "    id: !i64,\n" ++
                "    name: !String,\n" ++
                "    email: ?String,\n" ++
                "}\n" ++
                "\n" ++
                "⊢ User {\n" ++
                "    ☉ λ new(id: !i64, name: !String) → This! {\n" ++
                "        User { id, name, email: None }\n" ++
                "    }\n" ++
                "}",
                "sigil"
            )·to_vnode()
        )
        // Example 5: HTTP Server
        ·child(h3()·style(heading_style)·child(text("HTTP Server"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Build a simple HTTP server with async handlers."))·to_vnode())
        ·child(
            CodeBlock::new(
                "use sigil_http::*\n" ++
                "\n" ++
                "async λ handle_user(req: Request~) → Response! {\n" ++
                "    ≔ id~ = req·param(\"id\")\n" ++
                "    ≔ user? = db·find_user(id).await\n" ++
                "\n" ++
                "    match user {\n" ++
                "        Some(u) => Response·json(u),\n" ++
                "        None => Response·not_found()\n" ++
                "    }\n" ++
                "}\n" ++
                "\n" ++
                "λ main() {\n" ++
                "    Server::new()\n" ++
                "        ·get(\"/users/:id\", handle_user)\n" ++
                "        ·listen(8080)\n" ++
                "}",
                "sigil"
            )·to_vnode()
        )
        ·to_vnode()
}

