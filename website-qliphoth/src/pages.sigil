rite tooling_content() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"
    ≔ heading_style! = "font-size: 1.5rem; font-weight: 600; color: #e8e8ec; margin: 2.5rem 0 1rem;"
    ≔ subheading_style! = "font-size: 1.125rem; font-weight: 600; color: #e8e8ec; margin: 1.5rem 0 0.75rem;"

    article()
        ·class("docs-content")
        // Title and intro
        ·child(
            h1()
                ·id("tooling")
                ·style("font-size: 2.5rem; font-weight: 700; color: #e8e8ec; margin-bottom: 1.5rem;")
                ·child(text("Tooling Suite"))
                ·to_vnode()
        )
        ·child(
            p()
                ·class("lead")
                ·style("font-size: 1.25rem; color: #a0a0aa; margin-bottom: 2rem;")
                ·child(text("Sigil v0.4.0 includes a complete development toolchain: LSP server, code formatter, evidentiality-aware linter, and documentation generator."))
                ·to_vnode()
        )
        // LSP Section
        ·child(h2()·style(heading_style)·child(text("Language Server (LSP)"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("The Sigil LSP provides intelligent code assistance in any editor:"))·to_vnode())
        ·child(
            ul()
                ·style("color: #a0a0aa; margin-bottom: 1.5rem; padding-left: 1.5rem;")
                ·child(li()·child(text("Go to definition and find references"))·to_vnode())
                ·child(li()·child(text("Hover documentation with evidentiality markers"))·to_vnode())
                ·child(li()·child(text("Real-time diagnostics and error highlighting"))·to_vnode())
                ·child(li()·child(text("Code completion with type inference"))·to_vnode())
                ·child(li()·child(text("Automatic symbol input (type 'fn' → get 'λ')"))·to_vnode())
                ·to_vnode()
        )
        ·child(
            CodeBlock::new(
                "# Start the LSP server\n" ++
                "sigil lsp\n\n" ++
                "# VS Code: Install 'Sigil' extension from marketplace\n" ++
                "# Vim/Neovim: Add to your LSP config\n" ++
                "# Emacs: Use lsp-mode or eglot",
                "bash"
            )·to_vnode()
        )
        // Formatter Section
        ·child(h2()·style(heading_style)·child(text("Code Formatter"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Consistent code style across your project:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "# Format a single file\n" ++
                "sigil fmt src/main.sigil\n\n" ++
                "# Format entire project\n" ++
                "sigil fmt --recursive src/\n\n" ++
                "# Check formatting without modifying\n" ++
                "sigil fmt --check src/\n\n" ++
                "# Configuration in .sigil.toml\n" ++
                "[format]\n" ++
                "indent = 4\n" ++
                "max_width = 100\n" ++
                "native_symbols = true  # Convert keywords to symbols",
                "bash"
            )·to_vnode()
        )
        // Linter Section
        ·child(h2()·style(heading_style)·child(text("Evidentiality Linter"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("The linter enforces evidentiality rules and detects trust boundary violations:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "# Run linter\n" ++
                "sigil lint src/\n\n" ++
                "# Lint with specific rules\n" ++
                "sigil lint --rules=trust-boundaries,unused-markers src/\n\n" ++
                "# Example output:\n" ++
                "src/api.sigil:42:12 warning[trust-boundary]\n" ++
                "  Reported (~) data flows to known (!) without validation\n" ++
                "  \n" ++
                "  42 │     save_to_db(response~)  // response needs validation\n" ++
                "     │                ~~~~~~~~",
                "bash"
            )·to_vnode()
        )
        // SGDOC Section
        ·child(h2()·style(heading_style)·child(text("Documentation (SGDOC)"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Generate documentation from Sigil doc comments:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "/// Validates user input and returns trusted data.\n" ++
                "/// \n" ++
                "/// # Arguments\n" ++
                "/// * `input` - Reported data from external source\n" ++
                "/// \n" ++
                "/// # Returns\n" ++
                "/// Known (!) data after validation\n" ++
                "☉ λ validate(input: String~) → String! {\n" ++
                "    // ...\n" ++
                "}",
                "sigil"
            )·to_vnode()
        )
        ·child(
            CodeBlock::new(
                "# Generate HTML documentation\n" ++
                "sigil doc src/ --output docs/\n\n" ++
                "# Generate with private items\n" ++
                "sigil doc src/ --output docs/ --private\n\n" ++
                "# JSON output for custom tooling\n" ++
                "sigil doc src/ --format json > api.json",
                "bash"
            )·to_vnode()
        )
        ·to_vnode()
}

