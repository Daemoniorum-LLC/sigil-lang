☉ sigil Syntax { }
⊢ Syntax { ☉ rite new() → This! { Syntax { } } }
⊢ Component for Syntax {
    rite render(&this) → VNode! {
        ≔ layout_style! = "display: grid; grid-template-columns: 250px 1fr; gap: 2rem; padding: 8rem 1.5rem 4rem; max-width: 1400px; margin: 0 auto;"

        div()
            ·class("docs-layout")
            ·style(layout_style)
            ·child(syntax_sidebar())
            ·child(syntax_content())
            ·to_vnode()
    }
    rite props_to_map(&this) → HashMap<String, PropValue>! { HashMap::new() }
    rite from_props(_props: HashMap<String, PropValue>) → This! { Syntax::new() }
}

rite syntax_sidebar() → VNode! {
    ≔ sidebar_style! = "position: sticky; top: 8rem; height: fit-content;"
    ≔ section_style! = "margin-bottom: 2rem;"
    ≔ title_style! = "font-size: 0.75rem; font-weight: 600; color: #6c6c76; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem;"
    ≔ link_style! = "display: block; color: #a0a0aa; font-size: 0.875rem; padding: 0.375rem 0; text-decoration: none;"

    aside()
        ·class("docs-sidebar")
        ·style(sidebar_style)
        ·child(sidebar_section("Native Syntax", vec!["Overview", "Symbol Reference", "Why Symbols?"], section_style, title_style, link_style))
        ·child(sidebar_section("Keywords", vec!["Functions", "Structures", "Variables", "Control Flow"], section_style, title_style, link_style))
        ·child(sidebar_section("Migration", vec!["From English", "sigil migrate", "Editor Setup"], section_style, title_style, link_style))
        ·to_vnode()
}

rite syntax_content() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"
    ≔ heading_style! = "font-size: 1.5rem; font-weight: 600; color: #e8e8ec; margin: 2.5rem 0 1rem;"
    ≔ subheading_style! = "font-size: 1.125rem; font-weight: 600; color: #e8e8ec; margin: 1.5rem 0 0.75rem;"

    article()
        ·class("docs-content")
        // Title and intro
        ·child(
            h1()
                ·id("syntax")
                ·style("font-size: 2.5rem; font-weight: 700; color: #e8e8ec; margin-bottom: 1.5rem;")
                ·child(text("Native Syntax"))
                ·to_vnode()
        )
        ·child(
            p()
                ·class("lead")
                ·style("font-size: 1.25rem; color: #a0a0aa; margin-bottom: 2rem;")
                ·child(text("Sigil v0.4.0 introduces native syntax — mathematical symbols that express programming concepts more directly than English keywords."))
                ·to_vnode()
        )
        // Symbol Reference Table
        ·child(h2()·style(heading_style)·child(text("Symbol Reference"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Every native symbol has an English equivalent. Use whichever feels natural."))·to_vnode())
        ·child(syntax_reference_table())
        // Why Symbols section
        ·child(h2()·style(heading_style)·child(text("Why Symbols?"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Native symbols aren't about being clever — they're about density and clarity:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "// English keywords (32 chars)\n" ++
                "pub fn sum(a: &mut i32) { }\n\n" ++
                "// Native symbols (23 chars, same meaning)\n" ++
                "☉ λ sum(a: &Δ i32!) { }",
                "sigil"
            )·to_vnode()
        )
        ·child(p()·style(prose_style)·child(text("Symbols work because they're already familiar from mathematics. λ is lambda calculus. ∀ is 'for all'. Σ is summation/aggregation."))·to_vnode())
        // Migration section
        ·child(h2()·style(heading_style)·child(text("Migration"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Convert existing Sigil code to native syntax with one command:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "# Convert a single file\n" ++
                "sigil migrate src/main.sigil\n\n" ++
                "# Convert entire project\n" ++
                "sigil migrate --recursive src/\n\n" ++
                "# Preview changes without writing\n" ++
                "sigil migrate --dry-run src/main.sigil",
                "bash"
            )·to_vnode()
        )
        ·child(h3()·style(subheading_style)·child(text("Editor Support"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("All major editors support Unicode symbol input:"))·to_vnode())
        ·child(
            ul()
                ·style("color: #a0a0aa; margin-bottom: 1.5rem; padding-left: 1.5rem;")
                ·child(li()·child(text("VS Code: Use the Sigil extension with symbol snippets"))·to_vnode())
                ·child(li()·child(text("Vim/Neovim: Enable digraphs or use the Sigil LSP"))·to_vnode())
                ·child(li()·child(text("Emacs: Configure input method or use abbrev-mode"))·to_vnode())
                ·to_vnode()
        )
        ·to_vnode()
}

rite syntax_reference_table() → VNode! {
    ≔ table_style! = "width: 100%; border-collapse: collapse; margin: 1.5rem 0 2rem;"
    ≔ header_style! = "padding: 0.75rem 1rem; text-align: left; border-bottom: 2px solid #14A088; color: #e8e8ec; font-weight: 600;"
    ≔ cell_style! = "padding: 0.75rem 1rem; border-bottom: 1px solid #1a1a1f; color: #a0a0aa;"
    ≔ symbol_style! = "padding: 0.75rem 1rem; border-bottom: 1px solid #1a1a1f; font-family: 'IBM Plex Mono', monospace; font-size: 1.25rem; color: #14A088;"

    table()
        ·style(table_style)
        ·child(
            thead()
                ·child(
                    tr()
                        ·child(th()·style(header_style)·child(text("Symbol"))·to_vnode())
                        ·child(th()·style(header_style)·child(text("English"))·to_vnode())
                        ·child(th()·style(header_style)·child(text("Usage"))·to_vnode())
                        ·to_vnode()
                )
                ·to_vnode()
        )
        ·child(
            tbody()
                ·child(tr()·child(td()·style(symbol_style)·child(text("λ"))·to_vnode())·child(td()·style(cell_style)·child(text("fn / rite"))·to_vnode())·child(td()·style(cell_style)·child(text("Function definition"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(symbol_style)·child(text("Σ"))·to_vnode())·child(td()·style(cell_style)·child(text("struct / sigil"))·to_vnode())·child(td()·style(cell_style)·child(text("Structure definition"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(symbol_style)·child(text("≔"))·to_vnode())·child(td()·style(cell_style)·child(text("let"))·to_vnode())·child(td()·style(cell_style)·child(text("Variable binding"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(symbol_style)·child(text("☉"))·to_vnode())·child(td()·style(cell_style)·child(text("pub"))·to_vnode())·child(td()·style(cell_style)·child(text("Public visibility"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(symbol_style)·child(text("·"))·to_vnode())·child(td()·style(cell_style)·child(text("::"))·to_vnode())·child(td()·style(cell_style)·child(text("Path separator"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(symbol_style)·child(text("&Δ"))·to_vnode())·child(td()·style(cell_style)·child(text("&mut"))·to_vnode())·child(td()·style(cell_style)·child(text("Mutable reference"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(symbol_style)·child(text("∀"))·to_vnode())·child(td()·style(cell_style)·child(text("for"))·to_vnode())·child(td()·style(cell_style)·child(text("For loop"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(symbol_style)·child(text("∈"))·to_vnode())·child(td()·style(cell_style)·child(text("in"))·to_vnode())·child(td()·style(cell_style)·child(text("Iterator binding"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(symbol_style)·child(text("∞"))·to_vnode())·child(td()·style(cell_style)·child(text("loop"))·to_vnode())·child(td()·style(cell_style)·child(text("Infinite loop"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(symbol_style)·child(text("⊢"))·to_vnode())·child(td()·style(cell_style)·child(text("impl"))·to_vnode())·child(td()·style(cell_style)·child(text("Implementation block"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(symbol_style)·child(text("→"))·to_vnode())·child(td()·style(cell_style)·child(text("->"))·to_vnode())·child(td()·style(cell_style)·child(text("Return type"))·to_vnode())·to_vnode())
                ·to_vnode()
        )
        ·to_vnode()
}

