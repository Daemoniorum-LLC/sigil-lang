        ·child(
            thead()
                ·child(
                    tr()
                        ·child(th()·style(header_style)·child(text("Platform"))·to_vnode())
                        ·child(th()·style(header_style)·child(text("Interpreter"))·to_vnode())
                        ·child(th()·style(header_style)·child(text("JIT"))·to_vnode())
                        ·child(th()·style(header_style)·child(text("AOT"))·to_vnode())
                        ·child(th()·style(header_style)·child(text("Zero-C"))·to_vnode())
                        ·to_vnode()
                )
                ·to_vnode()
        )
        ·child(
            tbody()
                ·child(tr()·child(td()·style(cell_style)·child(text("Linux x86_64"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cell_style)·child(text("Linux aarch64"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cell_style)·child(text("macOS x86_64"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(cell_style)·child(text("libc"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cell_style)·child(text("macOS aarch64"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(cell_style)·child(text("libc"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cell_style)·child(text("Windows x86_64"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(cell_style)·child(text("CRT"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cell_style)·child(text("WebAssembly"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(cell_style)·child(text("—"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·child(td()·style(check_style)·child(text("✓"))·to_vnode())·to_vnode())
