        ·child(p()·style(prose_style)·child(text("Agent architectures must track data provenance. External inputs (user messages, API responses) are marked ~. Internal computations produce ! data. The agent runtime enforces these boundaries."))·to_vnode())
        ·child(
            CodeBlock::new(
