        ·style("width: 100%; border-collapse: collapse; margin: 1.5rem 0;")
        ·child(
            thead()·child(
                tr()
                    ·child(th()·style("text-align: left; padding: 0.75rem; border-bottom: 1px solid #1a1a1f; color: #e8e8ec;")·child(text("Command"))·to_vnode())
                    ·child(th()·style("text-align: left; padding: 0.75rem; border-bottom: 1px solid #1a1a1f; color: #e8e8ec;")·child(text("Description"))·to_vnode())
                    ·to_vnode()
            )·to_vnode()
        )
        ·child(
            tbody()
                ·child(tr()·child(td()·style(cmd_style)·child(text("sigil conjure <name>"))·to_vnode())·child(td()·style(cell_style)·child(text("Create a new tome"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cmd_style)·child(text("sigil inscribe"))·to_vnode())·child(td()·style(cell_style)·child(text("Initialize existing directory as tome"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cmd_style)·child(text("sigil summon <tome>"))·to_vnode())·child(td()·style(cell_style)·child(text("Add a dependency"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cmd_style)·child(text("sigil banish <tome>"))·to_vnode())·child(td()·style(cell_style)·child(text("Remove a dependency"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cmd_style)·child(text("sigil attune"))·to_vnode())·child(td()·style(cell_style)·child(text("Resolve and download dependencies"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cmd_style)·child(text("sigil forge"))·to_vnode())·child(td()·style(cell_style)·child(text("Build the tome"))·to_vnode())·to_vnode())
                ·child(tr()·child(td()·style(cmd_style)·child(text("sigil consecrate"))·to_vnode())·child(td()·style(cell_style)·child(text("Publish to registry"))·to_vnode())·to_vnode())
                ·to_vnode()
        )
        ·to_vnode()
