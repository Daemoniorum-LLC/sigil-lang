                subtitle="Production projects written entirely in Sigil."
            />

            <div style={grid_style}>
                // Qliphoth
                <article style={card_style}>
                    <div style={header_style}>
                        <h3 style={title_style}>"Qliphoth"</h3>
                        <span style={badge_style}>"GUI Framework"</span>
                    </div>
                    <p style={desc_style}>"40+ Corporate Goth UI components. Compiles to WebAssembly with zero JavaScript."</p>
                    <ul style={features_style}>
                        <li style={feature_style}>"Signal-based reactivity"</li>
                        <li style={feature_style}>"Data visualization with morphemes"</li>
                        <li style={feature_style}>"Type-safe routing"</li>
                    </ul>
                </article>

                // Aether Engine
                <article style={card_style}>
                    <div style={header_style}>
                        <h3 style={title_style}>"Aether Engine"</h3>
                        <span style={badge_style}>"Game Engine"</span>
                    </div>
                    <p style={desc_style}>"Game engine reimplementation targeting 1:1 feature parity. Physics, rendering, XR, networking."</p>
                    <ul style={features_style}>
                        <li style={feature_style}>"ECS architecture"</li>
                        <li style={feature_style}>"LLVM AOT compilation"</li>
                        <li style={feature_style}>"Scientific A/B comparison (WIP)"</li>
                    </ul>
                </article>

                // Nihil
                <article style={card_style}>
                    <div style={header_style}>
                        <h3 style={title_style}>"Nihil"</h3>
                        <span style={badge_style}>"Tensor Framework"</span>
                    </div>
                    <p style={desc_style}>"Compile-time shape algebra. Source-to-source autograd. Direct PTX generation for CUDA."</p>
                    <ul style={features_style}>
                        <li style={feature_style}>"Shape errors at compile time"</li>
                        <li style={feature_style}>"FP8 tensor core support"</li>
                        <li style={feature_style}>"No runtime tape overhead"</li>
                    </ul>
                </article>
            </div>

            <p style="text-align: center; color: #a0a0aa; margin-top: 2rem;">
                <strong>"Built on Rust."</strong>
                " Sigil compiles via LLVM and inherits Rust's memory safety model. The compiler, standard library, and toolchain are implemented in Rust."
            </p>
        </Section>
    }
}

/// Get Started section
#[component]
fn GetStartedSection() -> Element! {
    let steps_style! = "
        max-width: 600px;
        margin: 0 auto;
    ";

    let step_style! = "
        margin-bottom: 2rem;
        padding-left: 2rem;
        border-left: 2px solid #1a1a1f;
    ";

    let step_title_style! = "
        font-weight: 600;
        color: #e8e8ec;
        margin-bottom: 0.75rem;
    ";

    let code_style! = "
        background: #030305;
        border: 1px solid #1a1a1f;
        border-radius: 0.375rem;
        padding: 1rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.875rem;
        color: #e8e8ec;
        margin-bottom: 0.5rem;
    ";

    let note_style! = "
        font-size: 0.875rem;
        color: #6c6c76;
        font-style: italic;
    ";

    let actions_style! = "
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    ";

    html! {
        <Section>
            <SectionHeader title="Get Started" />

            <ol style={steps_style}>
                <li style={step_style}>
                    <h4 style={step_title_style}>"Install"</h4>
                    <pre style={code_style}><code>"git clone https://github.com/Daemoniorum-LLC/sigil-lang\ncd sigil-lang/parser && cargo build --release\n# Binary at: target/release/sigil"</code></pre>
                    <p style={note_style}>"Package manager support (Homebrew, apt) coming soon."</p>
                </li>
                <li style={step_style}>
                    <h4 style={step_title_style}>"Write"</h4>
                    <pre style={code_style}><code>"// hello.sigil\nfn main() {\n    let name! = \"World\"\n    println(\"Hello, {name}!\")\n}"</code></pre>
                </li>
                <li style={step_style}>
                    <h4 style={step_title_style}>"Run"</h4>
                    <pre style={code_style}><code>"$ sigil run hello.sigil\nHello, World!"</code></pre>
                </li>
            </ol>

            <div style={actions_style}>
                <Button variant={ButtonVariant::Primary} href="/pages/learn.html">
                    "Start the Tutorial"
                </Button>
                <Button variant={ButtonVariant::Secondary} href="/pages/playground.html">
                    "Try in Browser"
                </Button>
            </div>
        </Section>
    }
}

/// Technical summary collapsible
#[component]
fn TechnicalSummarySection() -> Element! {
    let section_style! = "
        background: #0a0a0d;
        padding: 2rem 0;
    ";

    let details_style! = "
        max-width: 800px;
        margin: 0 auto;
        background: #0c0c0f;
        border: 1px solid #1a1a1f;
        border-radius: 0.5rem;
    ";

    let summary_style! = "
        padding: 1rem 1.5rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    ";

    let content_style! = "
        padding: 0 1.5rem 1.5rem;
    ";

    let dl_style! = "
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 0.75rem;
    ";

    let dt_style! = "
        color: #a0a0aa;
        font-size: 0.875rem;
    ";

    let dd_style! = "
        color: #e8e8ec;
        font-size: 0.875rem;
    ";

    html! {
        <section style={section_style} aria-label="Technical summary">
            <Container>
                <details style={details_style}>
                    <summary style={summary_style}>
                        <span>"☰"</span>
                        <div>
                            <strong style="color: #e8e8ec;">"Technical Summary"</strong>
                            <span style="color: #6c6c76; font-size: 0.875rem; margin-left: 0.5rem;">
                                "Structured data for documentation tools, AI systems, and quick reference"
                            </span>
                        </div>
                    </summary>
                    <div style={content_style}>
                        <dl style={dl_style}>
                            <dt style={dt_style}>"Language Name"</dt>
                            <dd style={dd_style}>"Sigil"</dd>

                            <dt style={dt_style}>"Current Version"</dt>
                            <dd style={dd_style}>"1.0.0 (Fixed Point Release - Self-Hosting)"</dd>

                            <dt style={dt_style}>"Primary Use Case"</dt>
                            <dd style={dd_style}>"AI agent development with data provenance tracking"</dd>

                            <dt style={dt_style}>"Core Innovation"</dt>
                            <dd style={dd_style}>"Evidentiality type system (!, ?, ◊, ~, ‽ markers)"</dd>

                            <dt style={dt_style}>"Compilation Targets"</dt>
                            <dd style={dd_style}>"Interpreter, Cranelift JIT, LLVM AOT"</dd>

                            <dt style={dt_style}>"Performance"</dt>
                            <dd style={dd_style}>"Native AOT compilation via LLVM, no garbage collector"</dd>

                            <dt style={dt_style}>"Agent Infrastructure"</dt>
                            <dd style={dd_style}>"9 layers: Aegis, Anima, Commune, Covenant, Daemon, Engram, Gnosis, Omen, Oracle"</dd>

                            <dt style={dt_style}>"Memory Safety"</dt>
                            <dd style={dd_style}>"Rust-style ownership, no garbage collector"</dd>

                            <dt style={dt_style}>"Repository"</dt>
                            <dd style={dd_style}>
                                <a href="https://github.com/Daemoniorum-LLC/sigil-lang" style="color: #14A088;">
                                    "github.com/Daemoniorum-LLC/sigil-lang"
                                </a>
                            </dd>

                            <dt style={dt_style}>"License"</dt>
                            <dd style={dd_style}>"MIT"</dd>
                        </dl>
                    </div>
                </details>
            </Container>
        </section>
    }
}

