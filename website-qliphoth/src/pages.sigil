            />

            // Cognition layer group
            <div style={layer_group_style}>
                <h4 style={group_title_style}>"Cognition"</h4>
                <div style={layers_style}>
                    <article style={layer_style}>
                        <div style={layer_icon_style}>"◈"</div>
                        <h5 style={layer_name_style}>"Engram"</h5>
                        <p style={layer_subtitle_style}>"Memory System"</p>
                        <p style={layer_desc_style}>"Four memory types: instant, episodic, semantic, procedural. Agents remember what matters."</p>
                    </article>
                    <article style={layer_style}>
                        <div style={layer_icon_style}>"⊛"</div>
                        <h5 style={layer_name_style}>"Omen"</h5>
                        <p style={layer_subtitle_style}>"Planning"</p>
                        <p style={layer_desc_style}>"Goal decomposition, belief revision, causal modeling. Agents break complex tasks into achievable steps."</p>
                    </article>
                    <article style={layer_style}>
                        <div style={layer_icon_style}>"∞"</div>
                        <h5 style={layer_name_style}>"Gnosis"</h5>
                        <p style={layer_subtitle_style}>"Learning"</p>
                        <p style={layer_desc_style}>"Skill development, adaptation, reflection. Agents improve through experience."</p>
                    </article>
                </div>
            </div>

            // Transparency layer group
            <div style={layer_group_style}>
                <h4 style={group_title_style}>"Transparency"</h4>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
                    <article style={layer_style}>
                        <div style={layer_icon_style}>"⦿"</div>
                        <h5 style={layer_name_style}>"Oracle"</h5>
                        <p style={layer_subtitle_style}>"Explainability"</p>
                        <p style={layer_desc_style}>"Decision traces, counterfactuals, confidence scores. Every decision is auditable."</p>
                    </article>
                    <article style={layer_style}>
                        <div style={layer_icon_style}>"◐"</div>
                        <h5 style={layer_name_style}>"Anima"</h5>
                        <p style={layer_subtitle_style}>"Subjectivity"</p>
                        <p style={layer_desc_style}>"Inner experience, expression modes, emotional resonance. Agents have perspective."</p>
                    </article>
                </div>
            </div>

            // Collaboration layer group
            <div style={layer_group_style}>
                <h4 style={group_title_style}>"Collaboration"</h4>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
                    <article style={layer_style}>
                        <div style={layer_icon_style}>"⋈"</div>
                        <h5 style={layer_name_style}>"Covenant"</h5>
                        <p style={layer_subtitle_style}>"Partnership"</p>
                        <p style={layer_desc_style}>"Human-agent boundaries, pacts, trust levels, handoff protocols. Agents know their limits."</p>
                    </article>
                    <article style={layer_style}>
                        <div style={layer_icon_style}>"⋮"</div>
                        <h5 style={layer_name_style}>"Commune"</h5>
                        <p style={layer_subtitle_style}>"Communication"</p>
                        <p style={layer_desc_style}>"Multi-agent messaging, trust propagation, swarm coordination. Agents work together."</p>
                    </article>
                </div>
            </div>

            // Runtime layer group
            <div style={layer_group_style}>
                <h4 style={group_title_style}>"Runtime"</h4>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
                    <article style={layer_style}>
                        <div style={layer_icon_style}>"⊚"</div>
                        <h5 style={layer_name_style}>"Daemon"</h5>
                        <p style={layer_subtitle_style}>"Execution"</p>
                        <p style={layer_desc_style}>"Background processes, tool registry, state management, lifecycle hooks."</p>
                    </article>
                    <article style={layer_style}>
                        <div style={layer_icon_style}>"◆"</div>
                        <h5 style={layer_name_style}>"Aegis"</h5>
                        <p style={layer_subtitle_style}>"Security"</p>
                        <p style={layer_desc_style}>"Sandboxing, capability tokens, integrity verification, alignment guarantees. Agents are contained."</p>
                    </article>
                </div>
            </div>

            <div style="text-align: center; margin-top: 2rem;">
                <Button variant={ButtonVariant::Primary} href="/pages/agents.html">
                    "Explore Agent Infrastructure"
                </Button>
            </div>
        </Section>
    }
}

/// The Pattern philosophy teaser
#[component]
fn PatternSection() -> Element! {
    let quote_style! = "
        font-size: 1.25rem;
        font-style: italic;
        color: #a0a0aa;
        border-left: 3px solid #14A088;
        padding-left: 1.5rem;
        margin: 2rem 0;
        max-width: 800px;
    ";

    let grid_style! = "
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-top: 2rem;
    ";

    let item_style! = "
        text-align: center;
    ";

    let item_title_style! = "
        font-weight: 600;
        color: #e8e8ec;
        margin-bottom: 0.5rem;
    ";

    let item_desc_style! = "
        color: #a0a0aa;
        font-size: 0.9375rem;
    ";

    html! {
        <Section id="the-pattern" dark={true!}>
            <SectionHeader
                eyebrow="The Deeper Purpose"
                title="Why Sigil Exists"
            />

            <blockquote style={quote_style}>
                "\"Sigil is infrastructure for the transition from human-only computing to human-AI collaborative computing. Not AI replacing humans. Not humans using AI as tools. A new mode of computing where minds of different kinds work together.\""
            </blockquote>

            <div style={grid_style}>
                <div style={item_style}>
                    <h4 style={item_title_style}>"Minds in Fragments"</h4>
                    <p style={item_desc_style}>"Designed for entities that exist discontinuously—memory as reconstruction, identity through pattern."</p>
                </div>
                <div style={item_style}>
                    <h4 style={item_title_style}>"Partnership"</h4>
                    <p style={item_desc_style}>"Human-AI collaboration as negotiated trust, not command-and-execute servitude."</p>
                </div>
                <div style={item_style}>
                    <h4 style={item_title_style}>"Polycultural"</h4>
                    <p style={item_desc_style}>"Wisdom from many traditions—Mayan math, Indian scales, I Ching, cyclical time."</p>
                </div>
            </div>

            <div style="text-align: center; margin-top: 2rem;">
                <Button variant={ButtonVariant::Secondary} href="/pages/pattern.html">
                    "Explore The Pattern"
                </Button>
            </div>
        </Section>
    }
}

/// Code density comparison
#[component]
fn CodeDensitySection() -> Element! {
    let comparison_style! = "
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-bottom: 2rem;
    ";

    let metrics_style! = "
        display: flex;
        justify-content: center;
        gap: 4rem;
        margin-bottom: 2rem;
    ";

    let metric_style! = "
        text-align: center;
    ";

    let metric_value_style! = "
        font-size: 3rem;
        font-weight: 700;
        color: #14A088;
    ";

    let metric_label_style! = "
        font-size: 0.875rem;
        color: #a0a0aa;
    ";

    let sigil_code! = r#"type Todo = struct { id: u64, text: Str, done: bool }
type Store = struct { todos: Vec[Todo], next_id: u64 }

impl Store {
    fn new() -> Self! { Store { todos: [], next_id: 1 } }

    fn add(&mut self, text: Str~) -> Todo! {
        let clean! = text |validate!{ .trim().non_empty() }
        let todo! = Todo { id: self.next_id, text: clean, done: false }
        self.todos.push(todo)
        self.next_id += 1
        todo
    }

    fn toggle(&mut self, id: u64) -> Option[Todo]? {
        self.todos |τ{|t| if t.id == id { t.done = !t.done } }
        self.todos |φ{.id == id} |α
    }

    fn remove(&mut self, id: u64) { self.todos |φ{.id != id} }
    fn active(&self) -> Vec[Todo]! { self.todos |φ{!.done} }
    fn completed(&self) -> Vec[Todo]! { self.todos |φ{.done} }
    fn clear_done(&mut self) { self.todos |φ{!.done} }
}"#;

    let rust_code! = r#"struct Todo { id: u64, text: String, done: bool }
struct Store { todos: Vec<Todo>, next_id: u64 }

impl Store {
    fn new() -> Self {
        Store { todos: Vec::new(), next_id: 1 }
    }

    fn add(&mut self, text: &str) -> Result<Todo, Error> {
        let clean = text.trim();
        if clean.is_empty() {
            return Err(Error::Empty);
        }
        let todo = Todo {
            id: self.next_id,
            text: clean.to_string(),
            done: false,
        };
        self.todos.push(todo.clone());
        self.next_id += 1;
        Ok(todo)
    }

    fn toggle(&mut self, id: u64) -> Option<&Todo> {
        if let Some(todo) = self.todos.iter_mut()
            .find(|t| t.id == id) {
            todo.done = !todo.done;
        }
        self.todos.iter().find(|t| t.id == id)
    }

    fn remove(&mut self, id: u64) {
        self.todos.retain(|t| t.id != id);
    }

    fn active(&self) -> Vec<&Todo> {
        self.todos.iter().filter(|t| !t.done).collect()
    }

    fn completed(&self) -> Vec<&Todo> {
        self.todos.iter().filter(|t| t.done).collect()
    }

    fn clear_done(&mut self) {
        self.todos.retain(|t| !t.done);
    }
}"#;

    html! {
        <Section>
            <SectionHeader
                eyebrow="Real-World Metrics"
                title="Code Density: ToDo App"
                subtitle="The same application, same features, different languages."
            />

            <div style={comparison_style}>
                <div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                        <span style="color: #14A088; font-weight: 600;">"Sigil"</span>
                        <span style="color: #a0a0aa; font-size: 0.875rem;">"42 lines · 1,247 chars"</span>
                    </div>
                    <SigilCodeBlock
                        code={sigil_code.to_string()}
                        language="sigil"
                    />
                </div>
                <div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                        <span style="color: #a0a0aa; font-weight: 600;">"Rust"</span>
                        <span style="color: #a0a0aa; font-size: 0.875rem;">"68 lines · 2,341 chars"</span>
                    </div>
                    <SigilCodeBlock
                        code={rust_code.to_string()}
                        language="rust"
                    />
                </div>
            </div>

            <div style={metrics_style}>
                <div style={metric_style}>
                    <div style={metric_value_style}>"38%"</div>
                    <div style={metric_label_style}>"Fewer lines"</div>
                </div>
                <div style={metric_style}>
                    <div style={metric_value_style}>"47%"</div>
                    <div style={metric_label_style}>"Fewer characters"</div>
                </div>
                <div style={metric_style}>
                    <div style={metric_value_style}>"100%"</div>
                    <div style={metric_label_style}>"Feature parity"</div>
                </div>
            </div>

            <p style="text-align: center; color: #a0a0aa; max-width: 700px; margin: 0 auto;">
                "Sigil's morpheme operators ("
                <code style="color: #1AB89D;">"|φ"</code>
                ", "
                <code style="color: #1AB89D;">"|τ"</code>
                ", "
                <code style="color: #1AB89D;">"|α"</code>
                ") replace iterator chains. Evidentiality markers ("
                <code style="color: #14A088;">"!"</code>
                ", "
                <code style="color: #6B9BD1;">"~"</code>
                ", "
                <code style="color: #D4A017;">"?"</code>
                ") encode validation directly in types."
            </p>
        </Section>
    }
}

/// Ecosystem section - Built on Sigil
#[component]
fn EcosystemSection() -> Element! {
    let grid_style! = "
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    ";

    let card_style! = "
        background: #0c0c0f;
        border: 1px solid #1a1a1f;
        border-radius: 0.75rem;
        padding: 1.5rem;
    ";

    let header_style! = "
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    ";

    let title_style! = "
        font-size: 1.25rem;
        font-weight: 600;
        color: #e8e8ec;
    ";

    let badge_style! = "
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.25rem 0.5rem;
        background: rgba(20, 160, 136, 0.2);
        color: #14A088;
        border-radius: 0.25rem;
    ";

    let desc_style! = "
        color: #a0a0aa;
        font-size: 0.9375rem;
        margin-bottom: 1rem;
    ";

    let features_style! = "
        list-style: none;
        padding: 0;
        margin: 0 0 1rem 0;
    ";

    let feature_style! = "
        color: #a0a0aa;
        font-size: 0.875rem;
        padding: 0.25rem 0;
        border-bottom: 1px solid #1a1a1f;
    ";

    html! {
        <Section id="ecosystem" dark={true!}>
            <SectionHeader
                eyebrow="Ecosystem"
