rite runtime_content() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"
    ≔ heading_style! = "font-size: 1.5rem; font-weight: 600; color: #e8e8ec; margin: 2.5rem 0 1rem;"
    ≔ subheading_style! = "font-size: 1.125rem; font-weight: 600; color: #e8e8ec; margin: 1.5rem 0 0.75rem;"

    article()
        ·class("docs-content")
        // Title and intro
        ·child(
            h1()
                ·id("runtime")
                ·style("font-size: 2.5rem; font-weight: 700; color: #e8e8ec; margin-bottom: 1.5rem;")
                ·child(text("Sigil Runtime"))
                ·to_vnode()
        )
        ·child(
            p()
                ·class("lead")
                ·style("font-size: 1.25rem; color: #a0a0aa; margin-bottom: 2rem;")
                ·child(text("Sigil v0.4.0 introduces the Zero-C runtime — a pure Sigil/assembly runtime with no C standard library dependency."))
                ·to_vnode()
        )
        // Zero-C section
        ·child(h2()·style(heading_style)·child(text("Zero-C Architecture"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("The Zero-C runtime bypasses libc entirely, providing:"))·to_vnode())
        ·child(
            ul()
                ·style("color: #a0a0aa; margin-bottom: 1.5rem; padding-left: 1.5rem;")
                ·child(li()·child(text("Minimal binary size (~50KB for hello world)"))·to_vnode())
                ·child(li()·child(text("Direct syscalls on Linux (no libc wrapper overhead)"))·to_vnode())
                ·child(li()·child(text("Predictable memory layout for security analysis"))·to_vnode())
                ·child(li()·child(text("No hidden global state from C runtime"))·to_vnode())
                ·to_vnode()
        )
        ·child(
            CodeBlock::new(
                "# Build with Zero-C runtime (default in v0.4.0)\n" ++
                "sigil compile main.sigil -o main\n\n" ++
                "# Explicit Zero-C flag\n" ++
                "sigil compile main.sigil -o main --runtime=zero-c\n\n" ++
                "# Use standard C runtime (compatibility mode)\n" ++
                "sigil compile main.sigil -o main --runtime=libc",
                "bash"
            )·to_vnode()
        )
        // Execution Modes section
        ·child(h2()·style(heading_style)·child(text("Execution Modes"))·to_vnode())
        ·child(h3()·style(subheading_style)·child(text("Interpreter"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Fast startup for scripting and development:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "sigil run script.sigil      # Interpret directly\n" ++
                "sigil run -w script.sigil   # Watch mode, re-run on change",
                "bash"
            )·to_vnode()
        )
        ·child(h3()·style(subheading_style)·child(text("Cranelift JIT"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Fast compilation, reasonable performance:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "sigil jit program.sigil     # JIT compile and run",
                "bash"
            )·to_vnode()
        )
        ·child(h3()·style(subheading_style)·child(text("LLVM AOT"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Full optimization for production:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "sigil compile program.sigil -o program           # Default (O2)\n" ++
                "sigil compile program.sigil -o program --lto     # Link-time optimization\n" ++
                "sigil compile program.sigil -o program --cuda    # GPU compute support",
                "bash"
            )·to_vnode()
        )
        // Platform Support
        ·child(h2()·style(heading_style)·child(text("Platform Support"))·to_vnode())
        ·child(platform_support_table())
        ·to_vnode()
}

rite platform_support_table() → VNode! {
    ≔ table_style! = "width: 100%; border-collapse: collapse; margin: 1.5rem 0 2rem;"
    ≔ header_style! = "padding: 0.75rem 1rem; text-align: left; border-bottom: 2px solid #14A088; color: #e8e8ec; font-weight: 600;"
    ≔ cell_style! = "padding: 0.75rem 1rem; border-bottom: 1px solid #1a1a1f; color: #a0a0aa;"
