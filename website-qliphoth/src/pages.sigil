rite grimoire_content() → VNode! {
    ≔ prose_style! = "font-size: 1.0625rem; line-height: 1.8; color: #a0a0aa; margin-bottom: 1.5rem;"
    ≔ heading_style! = "font-size: 1.5rem; font-weight: 600; color: #e8e8ec; margin: 2.5rem 0 1rem;"
    ≔ subheading_style! = "font-size: 1.125rem; font-weight: 600; color: #e8e8ec; margin: 1.5rem 0 0.75rem;"

    article()
        ·class("docs-content")
        // Title and intro
        ·child(
            h1()
                ·id("grimoire")
                ·style("font-size: 2.5rem; font-weight: 700; color: #e8e8ec; margin-bottom: 1.5rem;")
                ·child(text("The Grimoire"))
                ·to_vnode()
        )
        ·child(
            p()
                ·class("lead")
                ·style("font-size: 1.25rem; color: #a0a0aa; margin-bottom: 2rem;")
                ·child(text("Sigil's package registry and dependency manager. Discover, share, and manage reusable tomes (packages) of Sigil code."))
                ·to_vnode()
        )
        // Feature highlights
        ·child(
            div()
                ·class("feature-highlight")
                ·style("display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 3rem;")
                ·child(highlight_item("Ritual Commands", "conjure, summon, forge"))
                ·child(highlight_item("Simple Bindings", "version, path, git"))
                ·child(highlight_item("Reproducible", "Grimoire.lock"))
                ·to_vnode()
        )
        // Quick Start
        ·child(h2()·id("quick-start")·style(heading_style)·child(text("Quick Start"))·to_vnode())
        ·child(h3()·style(subheading_style)·child(text("Create a New Tome"))·to_vnode())
        ·child(
            CodeBlock::new(
                "# Conjure a new tome into existence\n" ++
                "$ sigil conjure my-tome\n" ++
                "    Created tome 'my-tome' at ./my-tome\n" ++
                "\n" ++
                "$ cd my-tome && tree\n" ++
                ".\n" ++
                "├── Grimoire.toml\n" ++
                "├── .gitignore\n" ++
                "└── src\n" ++
                "    └── main.sg",
                "bash"
            )·to_vnode()
        )
        ·child(h3()·style(subheading_style)·child(text("Add a Dependency"))·to_vnode())
        ·child(
            CodeBlock::new(
                "# Summon the aegis security library\n" ++
                "$ sigil summon aegis\n" ++
                "    Added aegis = \"0.2\" to [bindings]\n" ++
                "\n" ++
                "# Or with a specific version\n" ++
                "$ sigil summon chorus \"^0.1\"\n" ++
                "    Added chorus = \"^0.1\" to [bindings]",
                "bash"
            )·to_vnode()
        )
        ·child(h3()·style(subheading_style)·child(text("Build Your Project"))·to_vnode())
        ·child(
            CodeBlock::new(
                "# Forge shapes your tome into being\n" ++
                "$ sigil forge\n" ++
                "    Attuning bindings...\n" ++
                "    Resolved aegis 0.2.1\n" ++
                "    Resolved chorus 0.1.3\n" ++
                "    Forged my-tome v0.1.0",
                "bash"
            )·to_vnode()
        )
        // Grimoire.toml
        ·child(h2()·id("grimoire-toml")·style(heading_style)·child(text("Grimoire.toml"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Every Sigil tome has a Grimoire.toml manifest file:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "# Tome metadata\n" ++
                "[tome]\n" ++
                "name = \"my-tome\"\n" ++
                "version = \"0.1.0\"\n" ++
                "authors = [\"Your Name <you@example.com>\"]\n" ++
                "edition = \"2026\"\n" ++
                "description = \"A brief description of your tome\"\n" ++
                "license = \"MIT\"\n" ++
                "\n" ++
                "# Dependencies (bindings)\n" ++
                "[bindings]\n" ++
                "aegis = \"0.2\"                      # Registry binding\n" ++
                "chorus = { version = \"^0.1\" }      # Detailed version\n" ++
                "local-lib = { path = \"../lib\" }    # Local path\n" ++
                "utils = { git = \"https://github.com/org/utils\" }\n" ++
                "\n" ++
                "# Dev-only dependencies\n" ++
                "[dev_bindings]\n" ++
                "test-utils = \"0.1\"\n" ++
                "\n" ++
                "# Custom scripts (rites)\n" ++
                "[rites]\n" ++
                "test = \"sigil run tests/all.sg\"\n" ++
                "bench = \"sigil run benchmarks/main.sg\"",
                "toml"
            )·to_vnode()
        )
        // Commands
        ·child(h2()·id("commands")·style(heading_style)·child(text("Commands"))·to_vnode())
        ·child(grimoire_command_table())
        // Version Bindings
        ·child(h2()·id("bindings")·style(heading_style)·child(text("Version Bindings"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("Specify dependencies from the Grimoire registry using version requirements:"))·to_vnode())
        ·child(grimoire_version_table())
        // Git Bindings
        ·child(h3()·style(subheading_style)·child(text("Git Bindings"))·to_vnode())
        ·child(
            CodeBlock::new(
                "[bindings]\n" ++
                "# Basic git binding (uses default branch)\n" ++
                "utils = { git = \"https://github.com/org/utils\" }\n" ++
                "\n" ++
                "# Specific branch\n" ++
                "utils = { git = \"...\", branch = \"develop\" }\n" ++
                "\n" ++
                "# Specific tag or commit\n" ++
                "utils = { git = \"...\", tag = \"v1.0.0\" }\n" ++
                "utils = { git = \"...\", rev = \"a1b2c3d\" }",
                "toml"
            )·to_vnode()
        )
        // Registry API
        ·child(h2()·id("registry")·style(heading_style)·child(text("Registry API"))·to_vnode())
        ·child(p()·style(prose_style)·child(text("The Grimoire registry is a simple static file server:"))·to_vnode())
        ·child(
            CodeBlock::new(
                "https://sigil-lang.com/grimoire/\n" ++
                "├── index.json           # Registry index\n" ++
                "└── tomes/\n" ++
                "    └── aegis/\n" ++
                "        ├── 0.1.0.tar.gz\n" ++
                "        └── 0.2.1.tar.gz",
                "text"
            )·to_vnode()
        )
        // CTA
        ·child(
            div()
                ·style("display: flex; gap: 1rem; margin-top: 3rem;")
                ·child(Button::primary("Start Tutorial", "/pages/learn.html")·to_vnode())
                ·child(Button::secondary("Read Docs", "/pages/docs.html")·to_vnode())
                ·to_vnode()
        )
        ·to_vnode()
}

rite grimoire_command_table() → VNode! {
    ≔ cell_style! = "padding: 0.75rem; border-bottom: 1px solid #1a1a1f; color: #a0a0aa;"
    ≔ cmd_style! = "padding: 0.75rem; border-bottom: 1px solid #1a1a1f; color: #14A088; font-family: 'IBM Plex Mono', monospace;"

