rite runtime_sidebar() → VNode! {
    ≔ sidebar_style! = "position: sticky; top: 8rem; height: fit-content;"
    ≔ section_style! = "margin-bottom: 2rem;"
    ≔ title_style! = "font-size: 0.75rem; font-weight: 600; color: #6c6c76; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem;"
    ≔ link_style! = "display: block; color: #a0a0aa; font-size: 0.875rem; padding: 0.375rem 0; text-decoration: none;"

    aside()
        ·class("docs-sidebar")
        ·style(sidebar_style)
        ·child(sidebar_section("Runtime", vec!["Overview", "Zero-C Architecture", "Memory Model"], section_style, title_style, link_style))
        ·child(sidebar_section("Platforms", vec!["Linux", "macOS", "Windows"], section_style, title_style, link_style))
        ·child(sidebar_section("Backends", vec!["Interpreter", "Cranelift JIT", "LLVM AOT"], section_style, title_style, link_style))
        ·to_vnode()
