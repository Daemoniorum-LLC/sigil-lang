            ·child(pattern_sidebar())
            ·child(pattern_content())
            ·to_vnode()
    }
    rite props_to_map(&this) → HashMap<String, PropValue>! { HashMap::new() }
    rite from_props(_props: HashMap<String, PropValue>) → This! { Pattern::new() }
