    div()
        ·class("downloads-grid")
        ·child(download_card("Linux", "x86_64", "sigil-linux-x86_64.tar.gz", base_url, false))
        ·child(download_card("Linux", "aarch64", "sigil-linux-aarch64.tar.gz", base_url, false))
        ·child(download_card("macOS", "Apple Silicon", "sigil-macos-aarch64.tar.gz", base_url, false))
        ·child(download_card("macOS", "Intel", "sigil-macos-x86_64.tar.gz", base_url, false))
        ·child(download_card("Windows", "x86_64", "sigil-windows-x86_64.zip", base_url, false))
        ·to_vnode()
}

rite download_card(platform: &str, arch: &str, filename: &str, base_url: &str, recommended: bool) → VNode! {
    ≔ icon! = match platform {
        "Linux" => "🐧",
        "macOS" => "🍎",
        "Windows" => "🪟",
        _ => "📦"
    }

    ≔ card_class! = if recommended { "download-card recommended" } else { "download-card" }

    div()
        ·class(card_class)
        ·child(div()·class("download-card-icon")·child(text(icon))·to_vnode())
        ·child(h3()·child(text(platform))·to_vnode())
        ·child(p()·child(text(arch))·to_vnode())
        ·child(
            a()
                ·class("btn btn-primary")
                ·attr("href", base_url ++ filename)
                ·child(text("Download"))
                ·to_vnode()
        )
        ·to_vnode()
}

