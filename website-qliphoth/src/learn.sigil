    ft
}

// === Main App ===

rite app() → i64 {
    ≔ root = create_element("div");
    set_class(root, "app");

    append_child(root, header());
    append_child(root, page_hero());

    // Main content
    ≔ main = create_element("main");
    set_class(main, "learn-content");

    // Progress bar
    append_child(main, progress_bar(1));

    // Chapter 1: The Basics
    append_child(main, chapter("1", "The Basics", chapter1_content()));

    // Chapter 2: Evidentiality
    append_child(main, chapter("2", "Evidentiality", chapter2_content()));

    // Chapter 3: Morpheme Operators (with morpheme grid)
    ≔ ch3 = chapter("3", "Morpheme Operators", chapter3_content());
    // Add morpheme grid to chapter 3
    ≔ ch3_grid_container = create_element("div");
    append_child(ch3_grid_container, build_morpheme_grid());
    append_child(ch3, ch3_grid_container);
    append_child(main, ch3);

    // Chapter 4: Structs & Pattern Matching
    append_child(main, chapter("4", "Structs & Pattern Matching", chapter4_content()));

    // Chapter 5: Building an Agent
    append_child(main, chapter("5", "Building an Agent", chapter5_content()));

    // Next navigation
    append_child(main, next_nav());

    append_child(root, main);
    append_child(root, footer());

    root
}

☉ rite main() → i64 {
    ≔ root = app();
    mount(root, "#app")
}
