// Sigil Homepage - Full Landing Page
// Compiled from Sigil to WebAssembly via Qliphoth
// Matches content from sigil-lang.com

// === DOM Helpers ===

rite create_element(tag: &str) → i64 {
    vdom_create_vnode(tag)
}

rite create_text(content: &str) → i64 {
    vdom_create_text_vnode(content)
}

rite set_class(element: i64, class_name: &str) {
    vdom_set_vnode_str_prop(element, "class", class_name)
}

rite set_attr(element: i64, name: &str, value: &str) {
    vdom_set_vnode_str_prop(element, name, value)
}

rite append_child(parent: i64, child: i64) {
    vdom_append_vnode_child(parent, child)
}

rite set_inner_html(element: i64, html: &str) {
    // Use innerHTML as a property via vdom
    vdom_set_vnode_str_prop(element, "innerHTML", html)
}

rite mount(element: i64, selector: &str) → i64 {
    vdom_mount_vnode(element, selector)
}

// === Component Helpers ===

rite link(href: &str, text: &str, class: &str) → i64 {
    ≔ a = create_element("a");
    set_class(a, class);
    set_attr(a, "href", href);
    ≔ t = create_text(text);
    append_child(a, t);
    a
}

rite link_external(href: &str, text: &str, class: &str) → i64 {
    ≔ a = create_element("a");
    set_class(a, class);
    set_attr(a, "href", href);
    set_attr(a, "target", "_blank");
    set_attr(a, "rel", "noopener noreferrer");
    ≔ t = create_text(text);
    append_child(a, t);
    a
}

rite heading(level: &str, text: &str, class: &str) → i64 {
    ≔ h = create_element(level);
    set_class(h, class);
    ≔ t = create_text(text);
    append_child(h, t);
    h
}

rite para(text: &str, class: &str) → i64 {
    ≔ p = create_element("p");
    set_class(p, class);
    ≔ t = create_text(text);
    append_child(p, t);
    p
}

rite span(text: &str, class: &str) → i64 {
    ≔ s = create_element("span");
    set_class(s, class);
    ≔ t = create_text(text);
    append_child(s, t);
    s
}

rite code_block(code: &str) → i64 {
    ≔ pre = create_element("pre");
    set_class(pre, "code-block");
    ≔ c = create_text(code);
    append_child(pre, c);
    pre
}

rite code_inline(text: &str) → i64 {
    ≔ c = create_element("code");
    set_class(c, "inline-code");
    ≔ t = create_text(text);
    append_child(c, t);
    c
}

// =============================================================================
// QLIPHOTH COMPONENTS - Semantic, reusable building blocks
// =============================================================================

// --- Layout Components ---

// Section wrapper with container
rite Section(id: &str, extra_class: &str) → i64 {
    ≔ section = create_element("section");
    set_class(section, "section " ++ extra_class);
    set_attr(section, "id", id);
    ≔ container = create_element("div");
    set_class(container, "container");
    append_child(section, container);
    container  // Return container for appending children
}

// Section header with title and subtitle
rite SectionHeader(title: &str, subtitle: &str) → i64 {
    ≔ header = create_element("div");
    set_class(header, "section-header");
    append_child(header, heading("h2", title, ""));
    append_child(header, para(subtitle, ""));
    header
}

// --- Code Comparison Components ---

// Code panel with header, badge, and syntax-highlighted code
rite CodePanel(
    lang: &str,
    badge_text: &str,
    badge_class: &str,
    header_class: &str,
    code_html: &str
) → i64 {
    ≔ panel = create_element("div");
    set_class(panel, "comparison-panel");

    // Header with language and badge
    ≔ hdr = create_element("div");
    set_class(hdr, "panel-header " ++ header_class);
    append_child(hdr, span(lang, "panel-icon"));
    append_child(hdr, span(badge_text, "panel-badge " ++ badge_class));
    append_child(panel, hdr);

    // Code block with innerHTML for syntax highlighting
    ≔ pre = create_element("pre");
    set_class(pre, "code-block");
    ≔ code = create_element("code");
    set_inner_html(code, code_html);
    append_child(pre, code);
    append_child(panel, pre);

    panel
}

// Side-by-side comparison container
rite Comparison(left: i64, right: i64) → i64 {
    ≔ comp = create_element("div");
    set_class(comp, "comparison");
    append_child(comp, left);
    append_child(comp, right);
    comp
}

// --- Evidence Card Component ---

rite EvidenceCard(
    marker: &str,
    marker_class: &str,
    title: &str,
    subtitle: &str,
    description: &str,
    code_html: &str
) → i64 {
    ≔ card = create_element("article");
    set_class(card, "evidence-card");

    // Header with large marker and title
    ≔ hdr = create_element("div");
    set_class(hdr, "evidence-header");
    append_child(hdr, span(marker, "ev " ++ marker_class ++ " ev-large"));

    ≔ title_block = create_element("div");
    append_child(title_block, heading("h3", title, ""));
    append_child(title_block, para(subtitle, "evidence-subtitle"));
    append_child(hdr, title_block);
    append_child(card, hdr);

    // Description
    append_child(card, para(description, ""));

    // Code example
    ≔ pre = create_element("pre");
    set_class(pre, "code-block code-sm");
    ≔ code = create_element("code");
    set_inner_html(code, code_html);
    append_child(pre, code);
    append_child(card, pre);

    card
}

// Evidence grid container
rite EvidenceGrid() → i64 {
    ≔ grid = create_element("div");
    set_class(grid, "evidence-grid");
    grid
}

// --- Agent Layer Components (matching original HTML) ---

// Single agent layer with icon, name, subtitle, description
rite AgentLayerSimple(icon: &str, name: &str, subtitle: &str, desc: &str) → i64 {
    ≔ article = create_element("article");
    set_class(article, "agent-layer");

    ≔ icon_div = create_element("div");
    set_class(icon_div, "layer-icon");
    append_child(icon_div, create_text(icon));
    append_child(article, icon_div);

    ≔ content = create_element("div");
    set_class(content, "layer-content");
    append_child(content, heading("h5", name, ""));
    append_child(content, para(subtitle, "layer-subtitle"));
    append_child(content, para(desc, ""));
    append_child(article, content);

    article
}

// Agent layer with code example
rite AgentLayerWithCode(icon: &str, name: &str, subtitle: &str, desc: &str, code_html: &str) → i64 {
    ≔ article = create_element("article");
    set_class(article, "agent-layer");

    ≔ icon_div = create_element("div");
    set_class(icon_div, "layer-icon");
    append_child(icon_div, create_text(icon));
    append_child(article, icon_div);

    ≔ content = create_element("div");
    set_class(content, "layer-content");
    append_child(content, heading("h5", name, ""));
    append_child(content, para(subtitle, "layer-subtitle"));
    append_child(content, para(desc, ""));

    ≔ pre = create_element("pre");
    set_class(pre, "code-block code-sm");
    ≔ code = create_element("code");
    set_inner_html(code, code_html);
    append_child(pre, code);
    append_child(content, pre);

    append_child(article, content);
    article
}

// Agent layer group (Cognition, Transparency, etc.)
rite AgentLayerGroup(title: &str) → i64 {
    ≔ group = create_element("div");
    set_class(group, "agent-layer-group");
    append_child(group, heading("h4", title, "layer-group-title"));
    ≔ layers = create_element("div");
    set_class(layers, "agent-layers");
    append_child(group, layers);
    layers  // Return the layers container to append layers to
}

// --- Feature/Ecosystem Card Component ---

rite FeatureCard(title: &str, description: &str) → i64 {
    ≔ card = create_element("div");
    set_class(card, "feature-card");
    append_child(card, heading("h3", title, ""));
    append_child(card, para(description, ""));
    card
}

rite FeatureCardWithLink(title: &str, description: &str, link_href: &str, link_text: &str) → i64 {
    ≔ card = create_element("div");
    set_class(card, "feature-card");
    append_child(card, heading("h3", title, ""));
    append_child(card, para(description, ""));
    append_child(card, link(link_href, link_text, "feature-link"));
    card
}

// --- Morpheme Operator Component ---

rite MorphemeOp(symbol: &str, name: &str, example: &str) → i64 {
    ≔ item = create_element("div");
    set_class(item, "morpheme-item");

    ≔ sym = create_element("span");
    set_class(sym, "morpheme-symbol");
    append_child(sym, create_text(symbol));
    append_child(item, sym);

    ≔ info = create_element("div");
    set_class(info, "morpheme-info");
    append_child(info, heading("h4", name, "morpheme-name"));

    ≔ ex = create_element("code");
    set_class(ex, "morpheme-example");
    append_child(ex, create_text(example));
    append_child(info, ex);
    append_child(item, info);

    item
}

// =============================================================================

rite image(src: &str, alt: &str, class: &str) → i64 {
    ≔ img = create_element("img");
    set_class(img, class);
    set_attr(img, "src", src);
    set_attr(img, "alt", alt);
    img
}

// === Navigation ===

rite github_link() → i64 {
    ≔ a = create_element("a");
    set_attr(a, "href", "https://github.com/Daemoniorum-LLC/sigil-lang");
    set_class(a, "nav-github");
    set_attr(a, "aria-label", "GitHub repository");
    set_attr(a, "rel", "noopener noreferrer");
    set_attr(a, "target", "_blank");
    ≔ svg = create_element("svg");
    set_attr(svg, "width", "20");
    set_attr(svg, "height", "20");
    set_attr(svg, "viewBox", "0 0 24 24");
    set_attr(svg, "fill", "currentColor");
    set_attr(svg, "aria-hidden", "true");
    ≔ path = create_element("path");
    set_attr(path, "d", "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z");
    append_child(svg, path);
    append_child(a, svg);
    a
}

rite header() → i64 {
    ≔ nav_el = create_element("nav");
    set_class(nav_el, "nav");
    set_attr(nav_el, "role", "navigation");
    set_attr(nav_el, "aria-label", "Main navigation");

    ≔ container = create_element("div");
    set_class(container, "nav-container");

    // Logo/brand
    ≔ brand = create_element("a");
    set_class(brand, "nav-logo");
    set_attr(brand, "href", "/");
    set_attr(brand, "aria-label", "Sigil home");
    ≔ logo_img = create_element("img");
    set_attr(logo_img, "src", "/images/sigil-icon.svg");
    set_attr(logo_img, "alt", "");
    set_class(logo_img, "logo-icon");
    set_attr(logo_img, "aria-hidden", "true");
    set_attr(logo_img, "width", "24");
    set_attr(logo_img, "height", "24");
    append_child(brand, logo_img);
    ≔ logo_text = create_element("span");
    set_class(logo_text, "logo-text");
    ≔ lt = create_text("Sigil");
    append_child(logo_text, lt);
    append_child(brand, logo_text);
    ≔ version = create_element("span");
    set_class(version, "version-badge");
    ≔ vt = create_text("0.4");
    append_child(version, vt);
    append_child(brand, version);
    append_child(container, brand);

    // Navigation links
    ≔ nav_links = create_element("div");
    set_class(nav_links, "nav-links");
    set_attr(nav_links, "id", "nav-links");
    append_child(nav_links, link("/learn.html", "Learn", ""));
    append_child(nav_links, link("/docs.html", "Docs", ""));
    append_child(nav_links, link("/playground/", "Playground", ""));
    append_child(nav_links, link("/agents.html", "Agents", ""));
    append_child(nav_links, link("/pattern.html", "The Pattern", ""));
    append_child(nav_links, link("/qliphoth.html", "Qliphoth", ""));
    append_child(nav_links, github_link());
    append_child(container, nav_links);

    append_child(nav_el, container);
    nav_el
}

// === Announcement Banner ===

rite announcement_banner() → i64 {
    ≔ banner = create_element("aside");
    set_class(banner, "announcement-banner");
    set_attr(banner, "role", "banner");
    set_attr(banner, "aria-label", "Sigil 0.4.0 announcement");

    ≔ container = create_element("div");
    set_class(container, "announcement-container");

    ≔ badge = span("0.4.0", "announcement-badge");
    append_child(container, badge);

    ≔ text_el = create_element("p");
    set_class(text_el, "announcement-text");

    ≔ strong = create_element("strong");
    ≔ st = create_text("Sigil 0.4.0 Released!");
    append_child(strong, st);
    append_child(text_el, strong);

    ≔ desc = create_text(" Native syntax, SGDOC documentation, native runtime, SIMD/CUDA. ");
    append_child(text_el, desc);

    ≔ link_el = link_external("https://github.com/Daemoniorum-LLC/sigil-lang/releases/tag/v0.4.0", "Read the release notes →", "announcement-link");
    append_child(text_el, link_el);

    append_child(container, text_el);
    append_child(banner, container);
    banner
}

// === Hero Section ===

rite hero_section() → i64 {
    ≔ section = create_element("header");
    set_class(section, "hero");

    ≔ container = create_element("div");
    set_class(container, "hero-container");

    // Large evidentiality diamond logo (full lattice with all markers)
    ≔ logo = create_element("img");
    set_attr(logo, "src", "/images/sigil-logo.svg");
    set_attr(logo, "alt", "Sigil evidentiality lattice: Known (!), Uncertain (?), Predicted (◊), Reported (~), Paradox (‽)");
    set_class(logo, "hero-logo");
    set_attr(logo, "width", "280");
    set_attr(logo, "height", "280");
    append_child(container, logo);

    // Large "Sigil" title
    append_child(container, heading("h1", "Sigil", "hero-title"));

    // Reading time indicator
    ≔ reading_time = create_element("span");
    set_class(reading_time, "reading-time");
    ≔ rt_icon = create_element("span");
    set_class(rt_icon, "reading-time-icon");
    ≔ rt_icon_text = create_text("📄");
    append_child(rt_icon, rt_icon_text);
    append_child(reading_time, rt_icon);
    ≔ rt_text = create_text(" 8 min read");
    append_child(reading_time, rt_text);
    append_child(container, reading_time);

    // Tagline
    append_child(container, para("A programming language that knows which data to trust.", "hero-tagline"));

    // Hero solution box with evidence list
    ≔ solution = create_element("div");
    set_class(solution, "hero-solution");

    ≔ intro = create_element("p");
    ≔ intro_text1 = create_text("Sigil tracks ");
    append_child(intro, intro_text1);
    ≔ em = create_element("em");
    ≔ em_text = create_text("data provenance");
    append_child(em, em_text);
    append_child(intro, em);
    ≔ intro_text2 = create_text(" in the type system:");
    append_child(intro, intro_text2);
    append_child(solution, intro);

    // Evidence list (vertical)
    ≔ list = create_element("ul");
    set_class(list, "evidence-list");
    append_child(list, evidence_item("!", "ev-known", "Known", "verified, computed locally"));
    append_child(list, evidence_item("?", "ev-uncertain", "Uncertain", "might be absent"));
    append_child(list, evidence_item("◊", "ev-predicted", "Predicted", "AI/ML output, probabilistic"));
    append_child(list, evidence_item("~", "ev-reported", "Reported", "external source, untrusted"));
    append_child(list, evidence_item("‽", "ev-paradox", "Paradox", "explicit trust boundary"));
    append_child(solution, list);

    append_child(container, solution);

    // CTA buttons
    ≔ actions = create_element("div");
    set_class(actions, "hero-actions");
    append_child(actions, link("/learn.html", "Learn Sigil", "btn btn-primary"));
    append_child(actions, link("#the-problem", "See the problem it solves", "btn btn-ghost"));
    append_child(container, actions);

    append_child(section, container);
    section
}

rite evidence_item(symbol: &str, ev_class: &str, name: &str, desc: &str) → i64 {
    ≔ li = create_element("li");
    ≔ marker = create_element("span");
    set_class(marker, "ev " ++ ev_class);
    ≔ mt = create_text(symbol);
    append_child(marker, mt);
    append_child(li, marker);
    ≔ t1 = create_text(" ");
    append_child(li, t1);
    ≔ strong = create_element("strong");
    ≔ st = create_text(name);
    append_child(strong, st);
    append_child(li, strong);
    ≔ t2 = create_text(" — " ++ desc);
    append_child(li, t2);
    li
}

// === The Bug That Types Can't Catch ===

rite problem_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "section section-dark");
    set_attr(section, "id", "the-problem");

    ≔ container = create_element("div");
    set_class(container, "container");

    // Section header
    ≔ header = create_element("div");
    set_class(header, "section-header");
    append_child(header, heading("h2", "The Bug That Types Can't Catch", ""));
    append_child(header, para("In every other language, this code compiles. In Sigil, it's a type error.", ""));
    append_child(container, header);

    // Side-by-side comparison panels
    ≔ comparison = create_element("div");
    set_class(comparison, "comparison");

    // Left panel: Vulnerable code (Rust/TypeScript/Go)
    ≔ left_panel = create_element("div");
    set_class(left_panel, "comparison-panel");

    ≔ left_header = create_element("div");
    set_class(left_header, "panel-header panel-header-bad");
    ≔ left_icon = create_element("span");
    set_class(left_icon, "panel-icon");
    append_child(left_icon, create_text("Rust / TypeScript / Go"));
    append_child(left_header, left_icon);
    ≔ left_badge = create_element("span");
    set_class(left_badge, "panel-badge badge-danger");
    append_child(left_badge, create_text("Compiles. Vulnerable."));
    append_child(left_header, left_badge);
    append_child(left_panel, left_header);

    ≔ left_code = create_element("pre");
    set_class(left_code, "code-block");
    ≔ left_code_inner = create_element("code");
    set_inner_html(left_code_inner,
        "<span class=\"comment\">// This compiles in every mainstream language</span>\n" ++
        "<span class=\"keyword\">async fn</span> <span class=\"function\">get_user_profile</span>(id: <span class=\"type\">String</span>) → <span class=\"type\">Profile</span> {\n" ++
        "    <span class=\"keyword\">let</span> response = http·get(<span class=\"string\">\"/api/users/{id}\"</span>).<span class=\"keyword\">await</span>;\n" ++
        "    <span class=\"keyword\">let</span> profile: <span class=\"type\">Profile</span> = response.json();\n\n" ++
        "    <span class=\"comment\">// profile is type Profile</span>\n" ++
        "    <span class=\"comment\">// But it came from an external API!</span>\n" ++
        "    <span class=\"comment\">// What if the API was compromised?</span>\n" ++
        "    <span class=\"comment\">// What if the data was tampered?</span>\n\n" ++
        "    save_to_database(profile);  <span class=\"comment\">// Trusting blindly</span>\n" ++
        "    profile\n" ++
        "}"
    );
    append_child(left_code, left_code_inner);
    append_child(left_panel, left_code);
    append_child(comparison, left_panel);

    // Right panel: Safe code (Sigil)
    ≔ right_panel = create_element("div");
    set_class(right_panel, "comparison-panel");

    ≔ right_header = create_element("div");
    set_class(right_header, "panel-header panel-header-good");
    ≔ right_icon = create_element("span");
    set_class(right_icon, "panel-icon");
    append_child(right_icon, create_text("Sigil"));
    append_child(right_header, right_icon);
    ≔ right_badge = create_element("span");
    set_class(right_badge, "panel-badge badge-success");
    append_child(right_badge, create_text("Type Error. Safe."));
    append_child(right_header, right_badge);
    append_child(right_panel, right_header);

    ≔ right_code = create_element("pre");
    set_class(right_code, "code-block");
    ≔ right_code_inner = create_element("code");
    set_inner_html(right_code_inner,
        "<span class=\"keyword\">async rite</span> <span class=\"function\">get_user_profile</span>(id: <span class=\"type\">!Str</span>) → <span class=\"type\">Profile</span><span class=\"ev-known\">!</span> {\n" ++
        "    <span class=\"keyword\">≔</span> response<span class=\"ev-reported\">~</span> = http·get(<span class=\"string\">\"/api/users/{id}\"</span>).<span class=\"keyword\">await</span>;\n" ++
        "    <span class=\"keyword\">≔</span> profile<span class=\"ev-reported\">~</span>: <span class=\"type\">Profile</span><span class=\"ev-reported\">~</span> = response.json();\n\n" ++
        "    <span class=\"comment\">// profile~ is type Profile~ (Reported)</span>\n" ++
        "    <span class=\"comment\">// The ~ marker propagates automatically</span>\n\n" ++
        "    save_to_database(profile);  <span class=\"error\">// ERROR: expected Profile!, got Profile~</span>\n\n" ++
        "    <span class=\"comment\">// Must validate first:</span>\n" ++
        "    <span class=\"keyword\">≔</span> verified<span class=\"ev-known\">!</span> = profile |<span class=\"keyword\">validate</span><span class=\"ev-known\">!</span>{ verify_signature() };\n" ++
        "    save_to_database(verified);  <span class=\"comment\">// OK: Profile!</span>\n" ++
        "    verified\n" ++
        "}"
    );
    append_child(right_code, right_code_inner);
    append_child(right_panel, right_code);
    append_child(comparison, right_panel);

    append_child(container, comparison);

    // Comparison note
    ≔ note = create_element("p");
    set_class(note, "comparison-note");
    ≔ note_text1 = create_text("The ");
    append_child(note, note_text1);
    ≔ code1 = create_element("code");
    append_child(code1, create_text("~"));
    append_child(note, code1);
    ≔ note_text2 = create_text(" marker is ");
    append_child(note, note_text2);
    ≔ em = create_element("em");
    append_child(em, create_text("contagious"));
    append_child(note, em);
    ≔ note_text3 = create_text(". Any data derived from external sources inherits the ");
    append_child(note, note_text3);
    ≔ code2 = create_element("code");
    append_child(code2, create_text("~"));
    append_child(note, code2);
    ≔ note_text4 = create_text(" until explicitly validated. You can't accidentally trust untrusted data.");
    append_child(note, note_text4);
    append_child(container, note);

    append_child(section, container);
    section
}

// === Evidentiality Section ===
// Using Qliphoth components for cleaner, declarative code

rite evidentiality_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "section");
    set_attr(section, "id", "evidentiality");

    ≔ container = create_element("div");
    set_class(container, "container");

    // Section header (matches original)
    append_child(container, SectionHeader(
        "Evidentiality: Data Has a History",
        "Every value carries proof of where it came from."
    ));

    // Evidence cards grid - using EvidenceCard component
    ≔ grid = EvidenceGrid();

    // Known (!)
    append_child(grid, EvidenceCard(
        "!", "ev-known",
        "Known", "Verified truth",
        "Data you computed yourself, or explicitly verified. Safe to trust.",
        "<span class=\"keyword\">≔</span> sum<span class=\"ev-known\">!</span> = <span class=\"number\">2</span> + <span class=\"number\">2</span>           <span class=\"comment\">// Computed locally</span>\n<span class=\"keyword\">≔</span> valid<span class=\"ev-known\">!</span> = input |<span class=\"keyword\">validate</span><span class=\"ev-known\">!</span>{ check() }"
    ));

    // Uncertain (?)
    append_child(grid, EvidenceCard(
        "?", "ev-uncertain",
        "Uncertain", "Might be absent",
        "Data that might not exist. Like Option/Maybe, but tracked in the type.",
        "<span class=\"keyword\">≔</span> user<span class=\"ev-uncertain\">?</span> = database.find(id)  <span class=\"comment\">// Might not exist</span>\n<span class=\"keyword\">≔</span> name<span class=\"ev-uncertain\">?</span> = user?.profile?.name   <span class=\"comment\">// Propagates</span>"
    ));

    // Reported (~)
    append_child(grid, EvidenceCard(
        "~", "ev-reported",
        "Reported", "External source",
        "Data from APIs, user input, files. Never trust without validation.",
        "<span class=\"keyword\">≔</span> data<span class=\"ev-reported\">~</span> = api.fetch(url)     <span class=\"comment\">// External</span>\n<span class=\"keyword\">≔</span> input<span class=\"ev-reported\">~</span> = form.get(<span class=\"string\">\"email\"</span>)   <span class=\"comment\">// User input</span>"
    ));

    // Paradox (‽)
    append_child(grid, EvidenceCard(
        "‽", "ev-paradox",
        "Paradox", "Trust boundary",
        "Explicit \"I know what I'm doing\" escape hatch. Use sparingly.",
        "<span class=\"keyword\">≔</span> ptr<span class=\"ev-paradox\">‽</span> = <span class=\"keyword\">unsafe</span> { raw_pointer }\n<span class=\"comment\">// You're taking responsibility</span>"
    ));

    append_child(container, grid);

    // Propagation rule
    ≔ rule = create_element("div");
    set_class(rule, "evidence-rule");
    append_child(rule, heading("h4", "The Propagation Rule", ""));
    append_child(container, rule);

    append_child(section, container);
    section
}

// === Morpheme Operators Section ===
