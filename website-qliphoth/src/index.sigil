}

// === Main App ===

rite app() → i64 {
    ≔ root = create_element("div");
    set_class(root, "app");

    append_child(root, announcement_banner());
    append_child(root, header());
    append_child(root, hero_section());
    append_child(root, problem_section());
    append_child(root, evidentiality_section());
    append_child(root, morpheme_section());
    append_child(root, agents_section());
    append_child(root, purpose_section());
    append_child(root, comparison_section());
    append_child(root, ecosystem_section());
    append_child(root, compute_section());
    append_child(root, get_started_section());
    append_child(root, footer());

    root
}

☉ rite main() → i64 {
    ≔ root = app();
    mount(root, "#app")
}
