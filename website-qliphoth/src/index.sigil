// === Code Density Comparison ===

rite comparison_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "section section-dark");
    set_attr(section, "id", "code-density");

    ≔ container = create_element("div");
    set_class(container, "container");

    // Section header with eyebrow
    ≔ header = create_element("div");
    set_class(header, "section-header");
    append_child(header, span("Real-World Metrics", "section-eyebrow"));
    append_child(header, heading("h2", "Code Density: ToDo App", ""));
    append_child(header, para(
        "The same application, same features, different languages. Measured in lines of code and characters.",
        ""
    ));
    append_child(container, header);

    // Side-by-side comparison
    ≔ comparison = create_element("div");
    set_class(comparison, "density-comparison");

    // Sigil panel
    ≔ sigil_panel = create_element("div");
    set_class(sigil_panel, "density-panel density-panel-sigil");

    ≔ sigil_header = create_element("div");
    set_class(sigil_header, "density-header");
    append_child(sigil_header, span("Sigil", "density-lang"));
    ≔ sigil_stats = create_element("div");
    set_class(sigil_stats, "density-stats");
    append_child(sigil_stats, density_stat("42", "lines"));
    append_child(sigil_stats, density_stat("1,247", "chars"));
    append_child(sigil_header, sigil_stats);
    append_child(sigil_panel, sigil_header);

    ≔ sigil_code = create_element("pre");
    set_class(sigil_code, "code-block code-density");
    ≔ sigil_code_el = create_element("code");
    set_inner_html(sigil_code_el, "<span class=\"keyword\">sigil</span> <span class=\"type\">Todo</span> { id: <span class=\"type\">!u64</span>, text: <span class=\"type\">!Str</span>, done: <span class=\"type\">!bool</span> }\n<span class=\"keyword\">sigil</span> <span class=\"type\">Store</span> { todos: <span class=\"type\">!Vec</span>[<span class=\"type\">Todo</span>], next_id: <span class=\"type\">!u64</span> }\n\n<span class=\"keyword\">⊢</span> <span class=\"type\">Store</span> {\n    <span class=\"keyword\">rite</span> <span class=\"function\">new</span>() → <span class=\"type\">This</span><span class=\"ev-known\">!</span> { <span class=\"type\">Store</span> { todos: [], next_id: <span class=\"number\">1</span> } }\n\n    <span class=\"keyword\">rite</span> <span class=\"function\">add</span>(<span class=\"keyword\">vary</span> this, text: <span class=\"type\">Str</span><span class=\"ev-reported\">~</span>) → <span class=\"type\">Todo</span><span class=\"ev-known\">!</span> {\n        <span class=\"keyword\">≔</span> clean<span class=\"ev-known\">!</span> = text |<span class=\"keyword\">validate</span><span class=\"ev-known\">!</span>{ .trim().non_empty() }\n        <span class=\"keyword\">≔</span> todo<span class=\"ev-known\">!</span> = <span class=\"type\">Todo</span> { id: this.next_id, text: clean, done: <span class=\"keyword\">nay</span> }\n        this.todos.push(todo)\n        this.next_id += <span class=\"number\">1</span>\n        todo\n    }\n\n    <span class=\"keyword\">rite</span> <span class=\"function\">toggle</span>(<span class=\"keyword\">vary</span> this, id: <span class=\"type\">!u64</span>) → <span class=\"type\">?Todo</span> {\n        this.todos |<span class=\"morpheme\">τ</span>{|t| <span class=\"keyword\">⎇</span> t.id == id { t.done = !t.done } }\n        this.todos |<span class=\"morpheme\">φ</span>{.id == id} |<span class=\"morpheme\">α</span>\n    }\n\n    <span class=\"keyword\">rite</span> <span class=\"function\">remove</span>(<span class=\"keyword\">vary</span> this, id: <span class=\"type\">!u64</span>) { this.todos |<span class=\"morpheme\">φ</span>{.id != id} }\n\n    <span class=\"keyword\">rite</span> <span class=\"function\">active</span>(this) → <span class=\"type\">!Vec</span>[<span class=\"type\">Todo</span>] { this.todos |<span class=\"morpheme\">φ</span>{!.done} }\n    <span class=\"keyword\">rite</span> <span class=\"function\">completed</span>(this) → <span class=\"type\">!Vec</span>[<span class=\"type\">Todo</span>] { this.todos |<span class=\"morpheme\">φ</span>{.done} }\n    <span class=\"keyword\">rite</span> <span class=\"function\">clear_done</span>(<span class=\"keyword\">vary</span> this) { this.todos |<span class=\"morpheme\">φ</span>{!.done} }\n}");
    append_child(sigil_code, sigil_code_el);
    append_child(sigil_panel, sigil_code);
    append_child(comparison, sigil_panel);

    // Rust panel
    ≔ rust_panel = create_element("div");
    set_class(rust_panel, "density-panel density-panel-rust");

    ≔ rust_header = create_element("div");
    set_class(rust_header, "density-header");
    append_child(rust_header, span("Rust", "density-lang"));
    ≔ rust_stats = create_element("div");
    set_class(rust_stats, "density-stats");
    append_child(rust_stats, density_stat("68", "lines"));
    append_child(rust_stats, density_stat("2,341", "chars"));
    append_child(rust_header, rust_stats);
    append_child(rust_panel, rust_header);

    ≔ rust_code = create_element("pre");
    set_class(rust_code, "code-block code-density");
    ≔ rust_code_el = create_element("code");
    set_inner_html(rust_code_el, "<span class=\"keyword\">struct</span> <span class=\"type\">Todo</span> { id: <span class=\"type\">u64</span>, text: <span class=\"type\">String</span>, done: <span class=\"type\">bool</span> }\n<span class=\"keyword\">struct</span> <span class=\"type\">Store</span> { todos: <span class=\"type\">Vec</span>&lt;<span class=\"type\">Todo</span>&gt;, next_id: <span class=\"type\">u64</span> }\n\n<span class=\"keyword\">impl</span> <span class=\"type\">Store</span> {\n    <span class=\"keyword\">fn</span> <span class=\"function\">new</span>() -&gt; <span class=\"type\">Self</span> {\n        <span class=\"type\">Store</span> { todos: <span class=\"type\">Vec</span>::new(), next_id: <span class=\"number\">1</span> }\n    }\n\n    <span class=\"keyword\">fn</span> <span class=\"function\">add</span>(&amp;<span class=\"keyword\">mut</span> self, text: &amp;<span class=\"type\">str</span>) -&gt; <span class=\"type\">Result</span>&lt;<span class=\"type\">Todo</span>, <span class=\"type\">Error</span>&gt; {\n        <span class=\"keyword\">let</span> clean = text.trim();\n        <span class=\"keyword\">if</span> clean.is_empty() {\n            <span class=\"keyword\">return</span> <span class=\"type\">Err</span>(<span class=\"type\">Error</span>::Empty);\n        }\n        <span class=\"keyword\">let</span> todo = <span class=\"type\">Todo</span> {\n            id: self.next_id,\n            text: clean.to_string(),\n            done: <span class=\"keyword\">false</span>,\n        };\n        self.todos.push(todo.clone());\n        self.next_id += <span class=\"number\">1</span>;\n        <span class=\"type\">Ok</span>(todo)\n    }\n\n    <span class=\"keyword\">fn</span> <span class=\"function\">toggle</span>(&amp;<span class=\"keyword\">mut</span> self, id: <span class=\"type\">u64</span>) -&gt; <span class=\"type\">Option</span>&lt;&amp;<span class=\"type\">Todo</span>&gt; {\n        <span class=\"keyword\">if let</span> <span class=\"type\">Some</span>(todo) = self.todos.iter_mut()\n            .find(|t| t.id == id) {\n            todo.done = !todo.done;\n        }\n        self.todos.iter().find(|t| t.id == id)\n    }\n\n    <span class=\"keyword\">fn</span> <span class=\"function\">remove</span>(&amp;<span class=\"keyword\">mut</span> self, id: <span class=\"type\">u64</span>) {\n        self.todos.retain(|t| t.id != id);\n    }\n\n    <span class=\"keyword\">fn</span> <span class=\"function\">active</span>(&amp;self) -&gt; <span class=\"type\">Vec</span>&lt;&amp;<span class=\"type\">Todo</span>&gt; {\n        self.todos.iter().filter(|t| !t.done).collect()\n    }\n\n    <span class=\"keyword\">fn</span> <span class=\"function\">completed</span>(&amp;self) -&gt; <span class=\"type\">Vec</span>&lt;&amp;<span class=\"type\">Todo</span>&gt; {\n        self.todos.iter().filter(|t| t.done).collect()\n    }\n\n    <span class=\"keyword\">fn</span> <span class=\"function\">clear_done</span>(&amp;<span class=\"keyword\">mut</span> self) {\n        self.todos.retain(|t| !t.done);\n    }\n}");
    append_child(rust_code, rust_code_el);
    append_child(rust_panel, rust_code);
    append_child(comparison, rust_panel);

    append_child(container, comparison);

    // Summary metrics
    ≔ summary = create_element("div");
    set_class(summary, "density-summary");
    append_child(summary, density_metric("38%", "Fewer lines"));
    append_child(summary, density_metric("47%", "Fewer characters"));
    append_child(summary, density_metric("100%", "Feature parity"));
    append_child(container, summary);

    // Note
    ≔ note = create_element("div");
    set_class(note, "density-note");
    ≔ note_p = create_element("p");
    set_inner_html(note_p, "These metrics come from equivalent implementations. Sigil's morpheme operators (<code>|φ</code>, <code>|τ</code>, <code>|α</code>) replace iterator chains. Evidentiality markers (<code>!</code>, <code>~</code>, <code>?</code>) encode validation directly in types.");
    append_child(note, note_p);
    append_child(container, note);

    append_child(section, container);
    section
}

rite density_stat(value: &str, label: &str) → i64 {
    ≔ stat = create_element("span");
    set_class(stat, "stat");
    ≔ strong = create_element("strong");
    append_child(strong, create_text(value));
    append_child(stat, strong);
    append_child(stat, create_text(" " ++ label));
    stat
}

rite density_metric(value: &str, label: &str) → i64 {
    ≔ metric = create_element("div");
    set_class(metric, "density-metric");
    append_child(metric, span(value, "metric-value"));
    append_child(metric, span(label, "metric-label"));
    metric
}

// === Ecosystem Section ===

rite ecosystem_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "section section-dark");
    set_attr(section, "id", "ecosystem");

    ≔ container = create_element("div");
    set_class(container, "container");

    append_child(container, heading("h2", "Built on Sigil", "section-title"));
    append_child(container, para(
        "A growing ecosystem of frameworks and tools:",
        "section-lead"
    ));

    ≔ grid = create_element("div");
    set_class(grid, "ecosystem-grid");

    // Qliphoth
    ≔ qliphoth = ecosystem_card("Qliphoth", "GUI Framework",
        "40+ Corporate Goth UI components. Compiles to WebAssembly with zero JavaScript. Signal-based reactivity.",
        "#[component]\n" ++
        "fn Dashboard() → Element! {\n" ++
        "    ≔ data~ = use_fetch(\"/api/stats\")\n" ++
        "    html! {\n" ++
        "        <Card>\n" ++
        "            <BarChart data={data |${.to_points()}} />\n" ++
        "        </Card>\n" ++
        "    }\n" ++
        "}"
    );
    append_child(grid, qliphoth);

    // Aether Engine
    ≔ aether = ecosystem_card("Aether Engine", "Game Engine",
        "1:1 feature parity reimplementation. ECS architecture, LLVM AOT compilation, scientific A/B testing.",
        "fn update(world: &mut World) {\n" ++
        "    world.query::<Transform, Velocity>()\n" ++
        "        |${|(t, v)| t.pos += v.dir * dt!}\n" ++
        "}"
    );
    append_child(grid, aether);

    // Nihil
    ≔ nihil = ecosystem_card("Nihil", "Tensor Framework",
        "Compile-time shape algebra. Source-to-source autograd. Direct PTX generation for CUDA.",
        "≔ a: Tensor<[3, 4]> = randn()\n" ++
        "≔ b: Tensor<[4, 5]> = randn()\n" ++
        "≔ c: Tensor<[3, 5]> = a @ b  // Shape checked at compile time"
    );
    append_child(grid, nihil);

    append_child(container, grid);

    append_child(section, container);
    section
}

rite ecosystem_card(name: &str, subtitle: &str, desc: &str, code: &str) → i64 {
    ≔ card = create_element("div");
    set_class(card, "ecosystem-card");
    ≔ header = create_element("div");
    set_class(header, "ecosystem-header");
    append_child(header, heading("h3", name, "ecosystem-name"));
    append_child(header, span(subtitle, "ecosystem-subtitle"));
    append_child(card, header);
    append_child(card, para(desc, "ecosystem-desc"));
    append_child(card, code_block(code));
    card
}

// === Compute Backends Section ===

rite compute_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "section section-dark");
    set_attr(section, "id", "compute");

    ≔ container = create_element("div");
    set_class(container, "container");

    ≔ header = create_element("div");
    set_class(header, "section-header");
    ≔ eyebrow = span("New in 0.4.0", "section-eyebrow");
    append_child(header, eyebrow);
    append_child(header, heading("h2", "Compute Backends", ""));
    append_child(header, para("Native SIMD and CUDA support for numerical workloads.", ""));
    append_child(container, header);

    ≔ comparison = create_element("div");
    set_class(comparison, "comparison");

    // SIMD panel
    ≔ simd_panel = create_element("div");
    set_class(simd_panel, "comparison-panel");
    ≔ simd_header = create_element("div");
    set_class(simd_header, "panel-header panel-header-good");
    append_child(simd_header, span("SIMD (AVX-512)", "panel-icon"));
    append_child(simd_header, span("16-lane vectors", "panel-badge badge-success"));
    append_child(simd_panel, simd_header);
    append_child(simd_panel, code_block(
        "// F32x16: 16-lane packed f32 vector\n" ++
        "≔ a = F32x16·alloc(16);\n" ++
        "≔ b = F32x16·alloc(16);\n" ++
        "≔ result = F32x16·alloc(16);\n\n" ++
        "F32x16·splat(a, 2.0);\n" ++
        "F32x16·splat(b, 3.0);\n\n" ++
        "// Vector operations\n" ++
        "F32x16·add(result, a, b);      // result = a + b\n" ++
        "F32x16·fmadd(result, a, b, c); // result = a * b + c\n\n" ++
        "// Reductions\n" ++
        "≔ sum! = F32x16·reduce_add(a);\n" ++
        "≔ dot! = F32x16·dot(a, b);"
    ));
    append_child(comparison, simd_panel);

    // CUDA panel
    ≔ cuda_panel = create_element("div");
    set_class(cuda_panel, "comparison-panel");
    ≔ cuda_header = create_element("div");
    set_class(cuda_header, "panel-header panel-header-good");
    append_child(cuda_header, span("CUDA", "panel-icon"));
    append_child(cuda_header, span("GPU compute", "panel-badge badge-success"));
    append_child(cuda_panel, cuda_header);
    append_child(cuda_panel, code_block(
        "// Compile with: sigil compile program.sg --cuda\n" ++
        "≔ ok! = Cuda·init();\n" ++
        "≔ devices! = Cuda·device_count();\n\n" ++
        "// Device memory\n" ++
        "≔ d_ptr = Cuda·malloc(1024);\n" ++
        "Cuda·memcpy_h2d(d_ptr, h_ptr, size);\n\n" ++
        "// Compile and launch kernels\n" ++
        "≔ kernel = Cuda·compile_kernel(src, \"add\");\n" ++
        "≔ result = Cuda·launch_1d(kernel, grid, block, args, n);\n\n" ++
        "Cuda·sync();\n" ++
        "Cuda·cleanup();"
    ));
    append_child(comparison, cuda_panel);

    append_child(container, comparison);

    ≔ note = create_element("div");
    set_class(note, "compute-note");
    append_child(note, para("SIMD uses AVX-512 intrinsics with scalar fallback. CUDA uses the Driver API and links -lcuda -lnvrtc.", ""));
    append_child(container, note);

    append_child(section, container);
    section
}

// === Get Started Section ===

rite get_started_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "section");

    ≔ container = create_element("div");
    set_class(container, "container");

    append_child(container, heading("h2", "Get Started", "section-title"));

    ≔ steps = create_element("div");
    set_class(steps, "get-started-steps");

    // Install
    ≔ step1 = get_started_step("1", "Install",
        "git clone https://github.com/Daemoniorum-LLC/sigil-lang\n" ++
        "cd sigil-lang/parser && cargo build --release\n" ++
        "# Binary at: target/release/sigil"
    );
    append_child(steps, step1);

    // Write
    ≔ step2 = get_started_step("2", "Write",
        "fn main() {\n" ++
        "    ≔ name! = \"World\"\n" ++
        "    println(\"Hello, {name}!\")\n" ++
        "}"
    );
    append_child(steps, step2);

    // Run
    ≔ step3 = get_started_step("3", "Run",
        "$ sigil run hello.sigil\n" ++
        "Hello, World!"
    );
    append_child(steps, step3);

    append_child(container, steps);

    ≔ note = para("Package manager support (Homebrew, apt) coming soon", "get-started-note");
    append_child(container, note);

    ≔ cta = create_element("div");
    set_class(cta, "get-started-cta");
    append_child(cta, link("learn.html", "Start the Tutorial", "btn btn-primary"));
    append_child(cta, link("playground/", "Try in Browser", "btn btn-secondary"));
    append_child(container, cta);

    append_child(section, container);
    section
}

rite get_started_step(num: &str, title: &str, code: &str) → i64 {
    ≔ step = create_element("div");
    set_class(step, "get-started-step");
    ≔ number = create_element("div");
    set_class(number, "step-number");
    ≔ nt = create_text(num);
    append_child(number, nt);
    append_child(step, number);
    ≔ content = create_element("div");
    set_class(content, "step-content");
    append_child(content, heading("h3", title, "step-title"));
    append_child(content, code_block(code));
    append_child(step, content);
    step
}

// === Footer ===

rite footer_column(title: &str, links: i64) → i64 {
    ≔ col = create_element("div");
    set_class(col, "footer-column");
    append_child(col, heading("h5", title, ""));
    append_child(col, links);
    col
}

rite footer() → i64 {
    ≔ ft = create_element("footer");
    set_class(ft, "footer");

    ≔ container = create_element("div");
