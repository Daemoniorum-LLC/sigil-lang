rite morpheme_section() → i64 {
    ≔ section = create_element("section");
    set_class(section, "section section-dark");
    set_attr(section, "id", "morphemes");

    ≔ container = create_element("div");
    set_class(container, "container");

    // Section header
    append_child(container, SectionHeader(
        "Morpheme Operators",
        "Greek letters for data transformation. Dense, readable pipelines."
    ));

    // Code demo - shown FIRST (like original)
    ≔ demo = create_element("div");
    set_class(demo, "morpheme-demo");
    ≔ pre = create_element("pre");
    set_class(pre, "code-block code-lg");
    ≔ code = create_element("code");
    set_inner_html(code,
        "<span class=\"keyword\">≔</span> result = users<span class=\"ev-reported\">~</span>\n" ++
        "    |<span class=\"morpheme\">φ</span>{.active}              <span class=\"comment\">// φ filter: keep active users</span>\n" ++
        "    |<span class=\"morpheme\">φ</span>{.age >= <span class=\"number\">18</span>}           <span class=\"comment\">// φ filter: adults only</span>\n" ++
        "    |<span class=\"morpheme\">τ</span>{.normalize()}         <span class=\"comment\">// τ transform: normalize each</span>\n" ++
        "    |<span class=\"morpheme\">σ</span>·by{.created_at}       <span class=\"comment\">// σ sort: by creation date</span>\n" ++
        "    |<span class=\"keyword\">validate</span><span class=\"ev-uncertain\">?</span>               <span class=\"comment\">// promote to uncertain after checks</span>\n" ++
        "    |<span class=\"morpheme\">τ</span>{.to_public_profile()} <span class=\"comment\">// τ transform: strip private data</span>\n" ++
        "    |<span class=\"keyword\">validate</span><span class=\"ev-known\">!</span>               <span class=\"comment\">// promote to known after verification</span>"
    );
    append_child(pre, code);
    append_child(demo, pre);
    append_child(container, demo);

    // Morpheme card grid
    ≔ grid = create_element("div");
    set_class(grid, "morpheme-grid");

    append_child(grid, MorphemeCard("φ", "phi", "Filter elements"));
    append_child(grid, MorphemeCard("τ", "tau", "Transform each"));
    append_child(grid, MorphemeCard("σ", "sigma", "Sort"));
    append_child(grid, MorphemeCard("ρ", "rho", "Reduce/fold"));
    append_child(grid, MorphemeCard("Σ", "sum", "Sum all"));
    append_child(grid, MorphemeCard("Π", "product", "Multiply all"));
    append_child(grid, MorphemeCard("α", "alpha", "First element"));
    append_child(grid, MorphemeCard("ω", "omega", "Last element"));

    append_child(container, grid);
    append_child(section, container);
    section
}

