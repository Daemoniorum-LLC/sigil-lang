    append_child(ref_links, r1);
    ≔ r2 = create_element("li");
    append_child(r2, link("pattern.html", "The Pattern", ""));
    append_child(ref_links, r2);
    ≔ r3 = create_element("li");
    append_child(r3, link("#ecosystem", "Built on Sigil", ""));
    append_child(ref_links, r3);
    ≔ r4 = create_element("li");
    append_child(r4, link_external("https://github.com/Daemoniorum-LLC/sigil-lang/releases", "Releases", ""));
    append_child(ref_links, r4);
    append_child(nav, footer_column("Reference", ref_links));

    // Community column
    ≔ comm_links = create_element("ul");
    ≔ c1 = create_element("li");
    append_child(c1, link_external("https://github.com/Daemoniorum-LLC/sigil-lang", "GitHub", ""));
    append_child(comm_links, c1);
    ≔ c2 = create_element("li");
    append_child(c2, link_external("https://github.com/Daemoniorum-LLC/sigil-lang/discussions", "Discussions", ""));
    append_child(comm_links, c2);
    ≔ c3 = create_element("li");
    append_child(c3, link_external("https://github.com/Daemoniorum-LLC/sigil-lang/issues", "Issues", ""));
    append_child(comm_links, c3);
    ≔ c4 = create_element("li");
    append_child(c4, link_external("https://github.com/Daemoniorum-LLC/sigil-lang/blob/main/CONTRIBUTING.md", "Contributing", ""));
    append_child(comm_links, c4);
    append_child(nav, footer_column("Community", comm_links));

    // Daemoniorum column
    ≔ daem_links = create_element("ul");
    ≔ d1 = create_element("li");
    append_child(d1, link_external("https://www.daemoniorum.com", "Company", ""));
    append_child(daem_links, d1);
    ≔ d2 = create_element("li");
    append_child(d2, link_external("https://docs.daemoniorum.com", "Platform Docs", ""));
    append_child(daem_links, d2);
    append_child(nav, footer_column("Daemoniorum", daem_links));

    append_child(container, nav);
    append_child(ft, container);
