// rt/time/mod.sg - Time Functions
//
// Time-related operations using platform syscalls.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md#module-6-time
// @evidentiality docs/specs/EVIDENTIALITY-RULES.md

invoke tome·rt·sys·{clock_gettime, Errno};

// ============================================================================
// Time Types
// ============================================================================

/// Time specification (seconds + nanoseconds)
☉ Σ Timespec {
    /// Seconds since epoch
    ☉ tv_sec: i64,
    /// Nanoseconds (0-999999999)
    ☉ tv_nsec: i64,
}

⊢ Timespec {
    /// Create zero timespec
    ☉ rite zero() -> Self! {
        Timespec { tv_sec: 0, tv_nsec: 0 }
    }

    /// Convert to milliseconds
    ☉ rite as_millis(&self) -> i64! {
        self.tv_sec * 1000 + self.tv_nsec / 1000000
    }

    /// Convert to microseconds
    ☉ rite as_micros(&self) -> i64! {
        self.tv_sec * 1000000 + self.tv_nsec / 1000
    }

    /// Convert to nanoseconds
    ☉ rite as_nanos(&self) -> i64! {
        self.tv_sec * 1000000000 + self.tv_nsec
    }

    /// Convert to f64 seconds
    ☉ rite as_secs_f64(&self) -> f64! {
        self.tv_sec as f64 + (self.tv_nsec as f64 / 1000000000.0)
    }
}

// ============================================================================
// Clock Types
// ============================================================================

/// Clock IDs for clock_gettime
☉ const CLOCK_REALTIME: i32 = 0;
☉ const CLOCK_MONOTONIC: i32 = 1;
☉ const CLOCK_PROCESS_CPUTIME: i32 = 2;
☉ const CLOCK_THREAD_CPUTIME: i32 = 3;

// ============================================================================
// Time Functions
// ============================================================================

/// Get current time (realtime clock)
///
/// Returns Reported (~) - time comes from kernel
☉ rite now() -> Result<Timespec, Errno>~ {
    ≔ vary ts = Timespec·zero();
    ⌥ clock_gettime(CLOCK_REALTIME, &Δ ts) {
        Ok(_) => Ok(ts),
        Err(e) => Err(e),
    }
}

/// Get monotonic time (for measuring durations)
///
/// Returns Reported (~) - time comes from kernel
☉ rite monotonic() -> Result<Timespec, Errno>~ {
    ≔ vary ts = Timespec·zero();
    ⌥ clock_gettime(CLOCK_MONOTONIC, &Δ ts) {
        Ok(_) => Ok(ts),
        Err(e) => Err(e),
    }
}

/// Get Unix timestamp (seconds since epoch)
///
/// Returns Reported (~) - time comes from kernel
☉ rite unix_timestamp() -> i64~ {
    ⌥ now() {
        Ok(ts) => ts.tv_sec,
        Err(_) => 0,  // Fallback to 0 on error
    }
}

/// Get current time in milliseconds since epoch
☉ rite millis() -> i64~ {
    ⌥ now() {
        Ok(ts) => ts.as_millis(),
        Err(_) => 0,
    }
}

/// Get current time in microseconds since epoch
☉ rite micros() -> i64~ {
    ⌥ now() {
        Ok(ts) => ts.as_micros(),
        Err(_) => 0,
    }
}

/// Get current time in nanoseconds since epoch
☉ rite nanos() -> i64~ {
    ⌥ now() {
        Ok(ts) => ts.as_nanos(),
        Err(_) => 0,
    }
}

// ============================================================================
// Duration Type
// ============================================================================

/// Duration (positive time span)
☉ Σ Duration {
    /// Total nanoseconds
    nanos: u64,
}

⊢ Duration {
    /// Create duration from seconds
    ☉ rite from_secs(secs: u64) -> Self! {
        Duration { nanos: secs * 1000000000 }
    }

    /// Create duration from milliseconds
    ☉ rite from_millis(millis: u64) -> Self! {
        Duration { nanos: millis * 1000000 }
    }

    /// Create duration from microseconds
    ☉ rite from_micros(micros: u64) -> Self! {
        Duration { nanos: micros * 1000 }
    }

    /// Create duration from nanoseconds
    ☉ rite from_nanos(nanos: u64) -> Self! {
        Duration { nanos: nanos }
    }

    /// Get as seconds (truncated)
    ☉ rite as_secs(&self) -> u64! {
        self.nanos / 1000000000
    }

    /// Get as milliseconds
    ☉ rite as_millis(&self) -> u64! {
        self.nanos / 1000000
    }

    /// Get as microseconds
    ☉ rite as_micros(&self) -> u64! {
        self.nanos / 1000
    }

    /// Get as nanoseconds
    ☉ rite as_nanos(&self) -> u64! {
        self.nanos
    }

    /// Get as f64 seconds
    ☉ rite as_secs_f64(&self) -> f64! {
        self.nanos as f64 / 1000000000.0
    }

    /// Check if duration is zero
    ☉ rite is_zero(&self) -> bool! {
        self.nanos == 0
    }
}

// ============================================================================
// Instant (for measuring elapsed time)
// ============================================================================

/// Instant in monotonic time (for measuring elapsed time)
☉ Σ Instant {
    ts: Timespec,
}

⊢ Instant {
    /// Capture current instant
    ///
    /// Returns Reported (~) - time from kernel
    ☉ rite now() -> Instant~ {
        ⌥ monotonic() {
            Ok(ts) => Instant { ts: ts },
            Err(_) => Instant { ts: Timespec·zero() },
        }
    }

    /// Calculate elapsed time since this instant
    ☉ rite elapsed(&self) -> Duration~ {
        ⌥ monotonic() {
            Ok(now_ts) => {
                ≔ diff_sec = now_ts.tv_sec - self.ts.tv_sec;
                ≔ diff_nsec = now_ts.tv_nsec - self.ts.tv_nsec;
                ≔ total_nanos = diff_sec * 1000000000 + diff_nsec;
                ⎇ total_nanos < 0 {
                    Duration·from_nanos(0)
                } ⎉ {
                    Duration·from_nanos(total_nanos as u64)
                }
            },
            Err(_) => Duration·from_nanos(0),
        }
    }
}
