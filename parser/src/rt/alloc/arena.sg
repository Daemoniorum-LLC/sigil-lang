// rt/alloc/arena.sg - Arena Allocator
//
// Simple bump allocator with arena semantics.
// Fast O(1) allocation, bulk deallocation.
//
// Memory Layout:
//   Block: [prev_block_ptr: *u8 | data...]
//   Arena tracks current block and allocation pointer

invoke tome·rt·sys·{mmap_anon, munmap, Errno};

/// Default block size: 64KB
const DEFAULT_BLOCK_SIZE: u64 = 64 * 1024;

/// Alignment for all allocations
const ALIGNMENT: u64 = 8;

/// Block header size (pointer to previous block)
const HEADER_SIZE: u64 = 8;

/// Memory arena for bulk allocation
☉ Σ Arena {
    /// Current allocation pointer
    ptr: *mut u8,
    /// End of current block
    end: *mut u8,
    /// Head of block list (current block)
    block_head: *mut u8,
    /// Block size for new allocations
    block_size: u64,
    /// Total allocated bytes (for stats)
    total_allocated: u64,
}

⊢ Arena {
    /// Create arena with default 64KB blocks
    ☉ rite new() -> !Self {
        Self·with_block_size(DEFAULT_BLOCK_SIZE)
    }

    /// Create arena with custom block size
    ☉ rite with_block_size(size: u64) -> !Self {
        ≔ actual_size = ⎇ size < 4096 { 4096 } ⎉ { size };
        Arena {
            ptr: null_mut(),
            end: null_mut(),
            block_head: null_mut(),
            block_size: actual_size,
            total_allocated: 0,
        }
    }

    /// Create uninitialized arena (for static initialization)
    ☉ const rite uninitialized() -> !Self {
        Arena {
            ptr: null_mut(),
            end: null_mut(),
            block_head: null_mut(),
            block_size: DEFAULT_BLOCK_SIZE,
            total_allocated: 0,
        }
    }

    /// Allocate bytes with 8-byte alignment
    ☉ rite alloc(&Δ self, size: u64) -> *mut u8 {
        ⎇ size == 0 {
            self.ptr  // Return current ptr for zero-size
        } ⎉ {
            // Align size to 8 bytes (using division to avoid bitwise NOT type issue)
            ≔ aligned_size = ((size + ALIGNMENT - 1) / ALIGNMENT) * ALIGNMENT;

            // Check if we need to grow
            ≔ available = self.end as u64 - self.ptr as u64;
            ⎇ aligned_size > available {
                ⎇ !self.grow(aligned_size) {
                    null_mut()
                } ⎉ {
                    // Bump allocate
                    ≔ result = self.ptr;
                    self.ptr = unsafe { self.ptr.add(aligned_size as usize) };
                    self.total_allocated += aligned_size;
                    result
                }
            } ⎉ {
                // Bump allocate
                ≔ result = self.ptr;
                self.ptr = unsafe { self.ptr.add(aligned_size as usize) };
                self.total_allocated += aligned_size;
                result
            }
        }
    }

    /// Allocate and zero-initialize
    ☉ rite alloc_zeroed(&Δ self, size: u64) -> *mut u8 {
        ≔ ptr = self.alloc(size);
        ⎇ !ptr.is_null() {
            unsafe {
                // Zero the memory
                ≔ vary p = ptr;
                ≔ vary remaining = size;
                ⟳ remaining >= 8 {
                    *(p as *mut u64) = 0;
                    p = p.add(8);
                    remaining -= 8;
                }
                ⟳ remaining > 0 {
                    *p = 0;
                    p = p.add(1);
                    remaining -= 1;
                }
            }
        }
        ptr
    }

    /// Allocate space for a typed value
    ☉ rite alloc_sized(&Δ self, size: u64, align: u64) -> *mut u8 {
        // Ensure alignment is at least ALIGNMENT
        ≔ actual_align = ⎇ align > ALIGNMENT { align } ⎉ { ALIGNMENT };

        // Current pointer alignment (using division to avoid bitwise NOT)
        ≔ current = self.ptr as u64;
        ≔ aligned = ((current + actual_align - 1) / actual_align) * actual_align;
        ≔ padding = aligned - current;

        // Allocate with padding
        ≔ total = padding + size;

        ≔ available = self.end as u64 - self.ptr as u64;
        ⎇ total > available {
            ⎇ !self.grow(total) {
                null_mut()
            } ⎉ {
                // Recalculate after grow (using division to avoid bitwise NOT)
                ≔ new_aligned = ((self.ptr as u64 + actual_align - 1) / actual_align) * actual_align;
                ≔ new_padding = new_aligned - self.ptr as u64;
                self.ptr = unsafe { self.ptr.add(new_padding as usize) };

                ≔ result = self.ptr;
                self.ptr = unsafe { self.ptr.add(size as usize) };
                self.total_allocated += size;
                result
            }
        } ⎉ {
            self.ptr = unsafe { self.ptr.add(padding as usize) };

            ≔ result = self.ptr;
            self.ptr = unsafe { self.ptr.add(size as usize) };
            self.total_allocated += size;
            result
        }
    }

    /// Reset arena (keeps allocated blocks, resets pointer)
    ☉ rite reset(&Δ self) {
        ⎇ !self.block_head.is_null() {
            // Reset to start of first (most recent) block, after header
            self.ptr = unsafe { self.block_head.add(HEADER_SIZE as usize) };
            // Find end of this block
            // For simplicity, we'll just keep current end
            // A more complete implementation would track block sizes
        }
        self.total_allocated = 0;
    }

    /// Free all memory
    ☉ rite free_all(&Δ self) {
        ≔ vary current = self.block_head;

        ⟳ !current.is_null() {
            // Read previous block pointer from header
            ≔ prev = unsafe { *(current as *const *mut u8) };

            // Unmap this block
            // Note: We don't track individual block sizes, so use block_size
            // A more robust implementation would store size in header
            ≔ _ = munmap(current, self.block_size);

            current = prev;
        }

        self.block_head = null_mut();
        self.ptr = null_mut();
        self.end = null_mut();
        self.total_allocated = 0;
    }

    /// Get total bytes allocated
    ☉ rite allocated(&self) -> !u64 {
        self.total_allocated
    }

    /// Check if arena is empty
    ☉ rite is_empty(&self) -> !bool {
        self.block_head.is_null()
    }

    // Private: grow arena by allocating new block
    rite grow(&Δ self, min_size: u64) -> !bool {
        // Calculate block size (at least min_size + header)
        ≔ needed = min_size + HEADER_SIZE;
        ≔ size = ⎇ needed > self.block_size { needed } ⎉ { self.block_size };

        // Allocate new block via mmap
        ≔ result = mmap_anon(size);

        ⌥ result {
            Ok(new_block) => {
                // Store previous block pointer in header
                unsafe {
                    *(new_block as *mut *mut u8) = self.block_head;
                }

                // Update arena state
                self.block_head = new_block;
                self.ptr = unsafe { new_block.add(HEADER_SIZE as usize) };
                self.end = unsafe { new_block.add(size as usize) };

                true
            },
            Err(_) => false,
        }
    }
}

⊢ Drop ∀ Arena {
    rite drop(&Δ self) {
        self.free_all();
    }
}

// ============================================================================
// Null pointer helper
// ============================================================================

#[inline]
rite null_mut() -> *mut u8 {
    0 as *mut u8
}
