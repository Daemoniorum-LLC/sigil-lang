// rt/io/mod.sg - I/O Module
//
// Standard I/O operations: stdout, stderr, file operations.
// Built directly on platform syscalls.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md#module-4-io
// @evidentiality docs/specs/EVIDENTIALITY-RULES.md

invoke tome·rt·sys·{write, read, open, close, Errno};
invoke tome·rt·types·String;

// ============================================================================
// File Descriptors
// ============================================================================

/// Standard file descriptor constants
☉ const STDIN: i32 = 0;
☉ const STDOUT: i32 = 1;
☉ const STDERR: i32 = 2;

// ============================================================================
// Print Functions
// ============================================================================

/// Print string to stdout (no newline)
///
/// Evidentiality: Returns ~ because syscall may fail
☉ rite print(s: &str) {
    ≔ _ = write(STDOUT, s.as_bytes());
}

/// Print string to stdout with newline
☉ rite println(s: &str) {
    ≔ _ = write(STDOUT, s.as_bytes());
    ≔ _ = write(STDOUT, "\n".as_bytes());
}

/// Print to stderr (no newline)
☉ rite eprint(s: &str) {
    ≔ _ = write(STDERR, s.as_bytes());
}

/// Print to stderr with newline
☉ rite eprintln(s: &str) {
    ≔ _ = write(STDERR, s.as_bytes());
    ≔ _ = write(STDERR, "\n".as_bytes());
}

// ============================================================================
// Integer/Float Printing
// ============================================================================

/// Print i64 to stdout
☉ rite print_int(val: i64) {
    ≔ vary buf: [u8; 21] = [0; 21];  // Max i64 is 20 digits + sign
    ≔ s = i64_to_str(val, &Δ buf);
    print(s);
}

/// Print i64 to stdout with newline
☉ rite println_int(val: i64) {
    ≔ vary buf: [u8; 21] = [0; 21];
    ≔ s = i64_to_str(val, &Δ buf);
    println(s);
}

/// Convert i64 to string in buffer, returns &str
rite i64_to_str(val: i64, buf: &Δ [u8]) -> &str! {
    // Handle zero case
    ⎇ val == 0 {
        buf[0] = 48;  // '0'
        ⤺ unsafe { str_from_raw(buf.as_ptr(), 1) };
    }

    ≔ vary n = val;
    ≔ negative = n < 0;
    ⎇ negative {
        n = 0 - n;  // Make positive
    }

    // Fill buffer from end
    ≔ vary i: u64 = 20;
    ⟳ n > 0 {
        ≔ digit = (n % 10) as u8;
        buf[i] = 48 + digit;  // '0' + digit
        n = n / 10;
        i = i - 1;
    }

    // Add negative sign
    ⎇ negative {
        buf[i] = 45;  // '-'
        i = i - 1;
    }

    // Return slice from i+1 to end
    ≔ start = i + 1;
    ≔ len = 21 - start;
    unsafe { str_from_raw(buf.as_ptr().add(start as usize), len) }
}

// ============================================================================
// File Mode
// ============================================================================

/// File open modes
☉ ᛈ FileMode {
    /// Read only
    Read,
    /// Write only (create if not exists, truncate if exists)
    Write,
    /// Append (create if not exists)
    Append,
    /// Read and write
    ReadWrite,
}

⊢ FileMode {
    /// Convert to POSIX open flags
    ☉ rite to_flags(&self) -> i32! {
        ⌥ self {
            FileMode·Read => 0,           // O_RDONLY
            FileMode·Write => 577,        // O_WRONLY | O_CREAT | O_TRUNC
            FileMode·Append => 1089,      // O_WRONLY | O_CREAT | O_APPEND
            FileMode·ReadWrite => 2,      // O_RDWR
        }
    }
}

// ============================================================================
// File Type
// ============================================================================

/// File handle wrapper
☉ Σ File {
    /// File descriptor
    fd: i32,
    /// Whether file is open
    is_open: bool,
}

⊢ File {
    /// Create new file (write mode, truncate if exists)
    ///
    /// Returns Reported (~) - syscall may fail
    ☉ rite create(path: &str) -> Result<File, Errno>~ {
        ≔ flags = 577;  // O_WRONLY | O_CREAT | O_TRUNC
        ≔ mode = 420;   // 0644 in octal

        ⌥ open(path.as_ptr() as *const u8, flags, mode) {
            Ok(fd) => Ok(File { fd: fd as i32, is_open: true }),
            Err(e) => Err(e),
        }
    }

    /// Open existing file with mode
    ///
    /// Returns Reported (~) - file contents are external
    ☉ rite open(path: &str, mode: FileMode) -> Result<File, Errno>~ {
        ≔ flags = mode.to_flags();
        ≔ file_mode = ⎇ flags & 64 != 0 { 420 } ⎉ { 0 };  // O_CREAT check

        ⌥ open(path.as_ptr() as *const u8, flags, file_mode) {
            Ok(fd) => Ok(File { fd: fd as i32, is_open: true }),
            Err(e) => Err(e),
        }
    }

    /// Write bytes to file
    ///
    /// Returns number of bytes written
    ☉ rite write(&Δ self, data: &str) -> Result<u64, Errno>~ {
        ⎇ !self.is_open {
            ⤺ Err(Errno·EBADF);
        }
        write(self.fd, data.as_bytes())
    }

    /// Write byte slice to file
    ☉ rite write_bytes(&Δ self, data: &[u8]) -> Result<u64, Errno>~ {
        ⎇ !self.is_open {
            ⤺ Err(Errno·EBADF);
        }
        write(self.fd, data)
    }

    /// Read bytes from file into buffer
    ///
    /// Returns number of bytes read
    /// Data is Reported (~) - comes from file
    ☉ rite read(&Δ self, buf: &Δ [u8]) -> Result<u64, Errno>~ {
        ⎇ !self.is_open {
            ⤺ Err(Errno·EBADF);
        }
        read(self.fd, buf)
    }

    /// Close file
    ☉ rite close(&Δ self) {
        ⎇ self.is_open {
            ≔ _ = close(self.fd);
            self.is_open = false;
        }
    }

    /// Get file descriptor
    ☉ rite fd(&self) -> i32! {
        self.fd
    }

    /// Check if file is open
    ☉ rite is_open(&self) -> bool! {
        self.is_open
    }
}

⊢ Drop ∀ File {
    rite drop(&Δ self) {
        self.close();
    }
}

// ============================================================================
// Stdin
// ============================================================================

/// Read line from stdin
///
/// Returns Reported (~) - user input is external
☉ rite read_line() -> String~ {
    ≔ vary result = String·new();
    ≔ vary buf: [u8; 1] = [0; 1];

    loop {
        ⌥ read(STDIN, &Δ buf) {
            Ok(n) => {
                ⎇ n == 0 {
                    break;  // EOF
                }
                ⎇ buf[0] == 10 {  // '\n'
                    break;
                }
                result.push(buf[0] as char);
            },
            Err(_) => break,
        }
    }

    result
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Create &str from raw pointer and length (unsafe)
#[inline]
unsafe rite str_from_raw(ptr: *const u8, len: u64) -> &str! {
    __builtin_str_from_raw_parts(ptr, len)
}
