// rt/types/mod.sg - Core Types Module
//
// Pure Sigil implementations of Vec, String, and collection types.
// These replace the C runtime equivalents for AOT compilation.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md#module-3-core-types

/// Growable array type
☉ scroll vec;

/// UTF-8 string type
☉ scroll string;

// Re-exports for convenience
☉ invoke vec·Vec;
☉ invoke string·String;
