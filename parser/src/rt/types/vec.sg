// rt/types/vec.sg - Growable Array Type
//
// Pure Sigil Vec<T> implementation using the native allocator.
// Provides O(1) amortized push via geometric growth.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md#31-vect
// @evidentiality docs/specs/EVIDENTIALITY-RULES.md

invoke tome·rt·alloc·{sigil_alloc, sigil_free, sigil_realloc};

/// Growable array type
///
/// Evidentiality:
/// - ptr: Known (!) - computed locally from allocator
/// - len/cap: Known (!) - tracked internally
/// - Elements: inherit evidentiality from insertion
☉ Σ Vec<T> {
    /// Pointer to heap-allocated buffer
    ptr: *mut T,
    /// Number of elements currently stored
    len: u64,
    /// Total capacity of buffer
    cap: u64,
    /// Size of each element in bytes (set at construction)
    elem_size: u64,
}

⊢<T> Vec<T> {
    // ========================================================================
    // Construction
    // ========================================================================

    /// Create empty Vec with no allocation
    ///
    /// The elem_size parameter is the size of T in bytes.
    /// In practice, this would be computed by the compiler.
    ///
    /// Returns Known (!) - fresh allocation state is certain
    ☉ rite new(elem_size: u64) -> Self! {
        Vec {
            ptr: 0 as *mut T,
            len: 0,
            cap: 0,
            elem_size: elem_size,
        }
    }

    /// Create Vec with pre-allocated capacity
    ///
    /// Returns Known (!) - we control the allocation
    ☉ rite with_capacity(cap: u64, elem_size: u64) -> Self! {
        ⎇ cap == 0 {
            Vec {
                ptr: 0 as *mut T,
                len: 0,
                cap: 0,
                elem_size: elem_size,
            }
        } ⎉ {
            ≔ size = cap * elem_size;
            ≔ ptr = sigil_alloc(size as i64) as *mut T;
            Vec {
                ptr: ptr,
                len: 0,
                cap: cap,
                elem_size: elem_size,
            }
        }
    }

    // ========================================================================
    // Push / Pop
    // ========================================================================

    /// Push element onto end of Vec
    ///
    /// Grows capacity if needed (doubles each time for O(1) amortized)
    ☉ rite push(&Δ self, val: T) {
        ⎇ self.len == self.cap {
            self.grow();
        }
        unsafe {
            ≔ dest = self.ptr.add(self.len as u64);
            dest.write(val);
        }
        self.len = self.len + 1;
    }

    /// Pop element from end of Vec
    ///
    /// Returns Uncertain (?) - may be empty
    ☉ rite pop(&Δ self) -> Option<T>? {
        ⎇ self.len == 0 {
            None
        } ⎉ {
            self.len = self.len - 1;
            unsafe {
                ≔ src = self.ptr.add(self.len as u64);
                Some(src.read())
            }
        }
    }

    // ========================================================================
    // Indexing / Access
    // ========================================================================

    /// Get reference to element at index
    ///
    /// Returns Uncertain (?) - index may be out of bounds
    ☉ rite get(&self, idx: u64) -> Option<&T>? {
        ⎇ idx >= self.len {
            None
        } ⎉ {
            unsafe {
                Some(&*self.ptr.add(idx))
            }
        }
    }

    /// Get mutable reference to element at index
    ///
    /// Returns Uncertain (?) - index may be out of bounds
    ☉ rite get_mut(&Δ self, idx: u64) -> Option<&Δ T>? {
        ⎇ idx >= self.len {
            None
        } ⎉ {
            unsafe {
                Some(&Δ *self.ptr.add(idx))
            }
        }
    }

    /// Get reference by index without bounds check
    ///
    /// Returns Known (!) - caller asserts index is valid
    ☉ rite get_unchecked(&self, idx: u64) -> &T! {
        unsafe { &*self.ptr.add(idx) }
    }

    /// Get mutable reference by index without bounds check
    ☉ rite get_unchecked_mut(&Δ self, idx: u64) -> &Δ T! {
        unsafe { &Δ *self.ptr.add(idx) }
    }

    // ========================================================================
    // Length / Capacity
    // ========================================================================

    /// Current number of elements
    ///
    /// Returns Known (!) - internal counter is trusted
    ☉ rite len(&self) -> u64! {
        self.len
    }

    /// Current buffer capacity
    ///
    /// Returns Known (!) - internal counter is trusted
    ☉ rite capacity(&self) -> u64! {
        self.cap
    }

    /// Check if Vec is empty
    ///
    /// Returns Known (!) - derived from trusted len
    ☉ rite is_empty(&self) -> bool! {
        self.len == 0
    }

    // ========================================================================
    // Modification
    // ========================================================================

    /// Clear all elements (keeps capacity)
    ☉ rite clear(&Δ self) {
        // Note: In a full implementation, we would call drop on each element
        // For now, just reset length
        self.len = 0;
    }

    /// Reserve capacity for at least `additional` more elements
    ☉ rite reserve(&Δ self, additional: u64) {
        ≔ required = self.len + additional;
        ⎇ required > self.cap {
            self.grow_to(required);
        }
    }

    // ========================================================================
    // Slice Views
    // ========================================================================

    /// Get raw pointer to buffer
    ☉ rite as_ptr(&self) -> *const T! {
        self.ptr as *const T
    }

    /// Get mutable raw pointer to buffer
    ☉ rite as_mut_ptr(&Δ self) -> *mut T! {
        self.ptr
    }

    // ========================================================================
    // Private: Growth
    // ========================================================================

    /// Grow capacity (double or minimum 4)
    rite grow(&Δ self) {
        ≔ new_cap = ⎇ self.cap == 0 { 4 } ⎉ { self.cap * 2 };
        self.grow_to(new_cap);
    }

    /// Grow to specific capacity
    rite grow_to(&Δ self, new_cap: u64) {
        ≔ new_size = new_cap * self.elem_size;
        ≔ old_size = self.cap * self.elem_size;

        ≔ new_ptr = ⎇ self.ptr as u64 == 0 {
            sigil_alloc(new_size as i64) as *mut T
        } ⎉ {
            sigil_realloc(
                self.ptr as *mut u8,
                old_size as i64,
                new_size as i64
            ) as *mut T
        };

        self.ptr = new_ptr;
        self.cap = new_cap;
    }
}

// ============================================================================
// Trait Implementations
// ============================================================================

⊢<T> Drop ∀ Vec<T> {
    /// Free all memory when Vec goes out of scope
    rite drop(&Δ self) {
        // First clear elements
        self.clear();

        // Then free the buffer
        ⎇ self.ptr as u64 != 0 {
            sigil_free(self.ptr as *mut u8);
        }
    }
}

⊢<T> Index<u64> ∀ Vec<T> {
    type Output = T;

    /// Index operator - panics if out of bounds
    rite index(&self, idx: u64) -> &T! {
        ⎇ idx >= self.len {
            // In real implementation: panic("Vec index out of bounds")
            // For now, return first element (unsafe but allows parsing)
            self.get_unchecked(0)
        } ⎉ {
            self.get_unchecked(idx)
        }
    }
}

⊢<T> IndexMut<u64> ∀ Vec<T> {
    /// Mutable index operator
    rite index_mut(&Δ self, idx: u64) -> &Δ T! {
        ⎇ idx >= self.len {
            self.get_unchecked_mut(0)
        } ⎉ {
            self.get_unchecked_mut(idx)
        }
    }
}
