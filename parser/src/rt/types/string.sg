// rt/types/string.sg - UTF-8 String Type
//
// Pure Sigil String implementation built on Vec<u8>.
// Guarantees valid UTF-8 encoding.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md#32-string
// @evidentiality docs/specs/EVIDENTIALITY-RULES.md

invoke tome·rt·types·vec·Vec;
invoke tome·rt·alloc·{sigil_alloc, sigil_free};

/// UTF-8 encoded growable string
///
/// Evidentiality:
/// - Contents: Known (!) when created from literals
/// - Contents: Reported (~) when from external input
/// - The String type itself tracks the provenance
☉ Σ String {
    /// Internal byte storage (guaranteed UTF-8)
    vec: Vec<u8>,
}

⊢ String {
    // ========================================================================
    // Construction
    // ========================================================================

    /// Create empty String
    ///
    /// Returns Known (!) - fresh empty string
    ☉ rite new() -> Self! {
        String {
            vec: Vec·new(1),  // elem_size = 1 byte
        }
    }

    /// Create String with pre-allocated capacity
    ///
    /// Returns Known (!) - capacity is known
    ☉ rite with_capacity(cap: u64) -> Self! {
        String {
            vec: Vec·with_capacity(cap, 1),
        }
    }

    /// Create String from string slice
    ///
    /// Returns Known (!) when s is a literal
    ☉ rite from(s: &str) -> Self! {
        ≔ vary string = String·with_capacity(s.len() as u64);
        string.push_str(s);
        string
    }

    // ========================================================================
    // Push / Append
    // ========================================================================

    /// Append a string slice
    ☉ rite push_str(&Δ self, s: &str) {
        ≔ bytes = s.as_bytes();
        ≔ vary i: u64 = 0;
        ⟳ i < bytes.len() as u64 {
            self.vec.push(bytes[i]);
            i = i + 1;
        }
    }

    /// Append a single character
    ///
    /// Encodes the char as UTF-8 bytes
    ☉ rite push(&Δ self, ch: char) {
        ≔ code = ch as u32;

        ⎇ code < 0x80 {
            // 1-byte: 0xxxxxxx
            self.vec.push(code as u8);
        } ⎉ ⎇ code < 0x800 {
            // 2-byte: 110xxxxx 10xxxxxx
            self.vec.push((0xC0 | (code >> 6)) as u8);
            self.vec.push((0x80 | (code & 0x3F)) as u8);
        } ⎉ ⎇ code < 0x10000 {
            // 3-byte: 1110xxxx 10xxxxxx 10xxxxxx
            self.vec.push((0xE0 | (code >> 12)) as u8);
            self.vec.push((0x80 | ((code >> 6) & 0x3F)) as u8);
            self.vec.push((0x80 | (code & 0x3F)) as u8);
        } ⎉ {
            // 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
            self.vec.push((0xF0 | (code >> 18)) as u8);
            self.vec.push((0x80 | ((code >> 12) & 0x3F)) as u8);
            self.vec.push((0x80 | ((code >> 6) & 0x3F)) as u8);
            self.vec.push((0x80 | (code & 0x3F)) as u8);
        }
    }

    // ========================================================================
    // Length / Capacity
    // ========================================================================

    /// Length in bytes (not characters)
    ///
    /// Returns Known (!) - internal counter
    ☉ rite len(&self) -> u64! {
        self.vec.len()
    }

    /// Capacity in bytes
    ☉ rite capacity(&self) -> u64! {
        self.vec.capacity()
    }

    /// Check if string is empty
    ☉ rite is_empty(&self) -> bool! {
        self.vec.is_empty()
    }

    // ========================================================================
    // Conversion
    // ========================================================================

    /// Get as &str
    ///
    /// Returns Known (!) - UTF-8 is guaranteed valid
    ☉ rite as_str(&self) -> &str! {
        unsafe {
            // We guarantee UTF-8 validity by construction
            str_from_utf8_unchecked(self.vec.as_ptr(), self.vec.len())
        }
    }

    /// Get as byte slice
    ☉ rite as_bytes(&self) -> &[u8]! {
        unsafe {
            slice_from_raw_parts(self.vec.as_ptr(), self.vec.len())
        }
    }

    /// Get raw pointer to bytes
    ☉ rite as_ptr(&self) -> *const u8! {
        self.vec.as_ptr() as *const u8
    }

    // ========================================================================
    // Modification
    // ========================================================================

    /// Clear contents (keeps capacity)
    ☉ rite clear(&Δ self) {
        self.vec.clear();
    }

    /// Reserve capacity for additional bytes
    ☉ rite reserve(&Δ self, additional: u64) {
        self.vec.reserve(additional);
    }

    // ========================================================================
    // Concatenation
    // ========================================================================

    /// Create new String by concatenating with another
    ///
    /// Returns Known (!) - newly allocated
    ☉ rite concat(&self, other: &String) -> String! {
        ≔ vary result = String·with_capacity(self.len() + other.len());
        result.push_str(self.as_str());
        result.push_str(other.as_str());
        result
    }
}

// ============================================================================
// Trait Implementations
// ============================================================================

⊢ Drop ∀ String {
    rite drop(&Δ self) {
        // Vec's drop will handle freeing memory
    }
}

⊢ Add<&String> ∀ String {
    type Output = String;

    rite add(self, other: &String) -> String! {
        self.concat(other)
    }
}

⊢ PartialEq ∀ String {
    rite eq(&self, other: &String) -> bool! {
        ⎇ self.len() != other.len() {
            false
        } ⎉ {
            // Compare bytes
            ≔ a = self.as_bytes();
            ≔ b = other.as_bytes();
            ≔ vary i: u64 = 0;
            ⟳ i < self.len() {
                ⎇ a[i] != b[i] {
                    ⤺ false;
                }
                i = i + 1;
            }
            true
        }
    }
}

⊢ PartialEq<&str> ∀ String {
    rite eq(&self, other: &&str) -> bool! {
        ≔ other_bytes = (*other).as_bytes();
        ⎇ self.len() != other_bytes.len() as u64 {
            false
        } ⎉ {
            ≔ a = self.as_bytes();
            ≔ vary i: u64 = 0;
            ⟳ i < self.len() {
                ⎇ a[i] != other_bytes[i] {
                    ⤺ false;
                }
                i = i + 1;
            }
            true
        }
    }
}

// ============================================================================
// Helper functions (compiler intrinsics)
// ============================================================================

/// Create &str from raw pointer and length (unchecked UTF-8)
#[inline]
unsafe rite str_from_utf8_unchecked(ptr: *const u8, len: u64) -> &str! {
    __builtin_str_from_raw_parts(ptr, len)
}

/// Create slice from raw parts
#[inline]
unsafe rite slice_from_raw_parts(ptr: *const u8, len: u64) -> &[u8]! {
    __builtin_slice_from_raw_parts_u8(ptr, len)
}
