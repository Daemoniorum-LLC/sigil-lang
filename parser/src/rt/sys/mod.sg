// rt/sys/mod.sg - Platform Syscall Abstraction
//
// Provides direct kernel access without libc.
// Platform-specific implementations selected at compile time.

☉ scroll errno;

#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
☉ scroll linux_x64;

#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
☉ invoke linux_x64·*;

#[cfg(all(target_os = "macos", target_arch = "x86_64"))]
☉ scroll darwin_x64;

#[cfg(all(target_os = "macos", target_arch = "x86_64"))]
☉ invoke darwin_x64·*;

#[cfg(all(target_os = "macos", target_arch = "aarch64"))]
☉ scroll darwin_arm64;

#[cfg(all(target_os = "macos", target_arch = "aarch64"))]
☉ invoke darwin_arm64·*;

#[cfg(all(target_os = "windows", target_arch = "x86_64"))]
☉ scroll windows_x64;

#[cfg(all(target_os = "windows", target_arch = "x86_64"))]
☉ invoke windows_x64·*;

☉ invoke errno·Errno;

/// Timespec structure for clock operations
#[repr(C)]
☉ Σ Timespec {
    ☉ tv_sec: i64,
    ☉ tv_nsec: i64,
}

⊢ Timespec {
    ☉ rite new() -> !Self {
        Timespec { tv_sec: 0, tv_nsec: 0 }
    }

    /// Convert to milliseconds
    ☉ rite to_millis(&self) -> !i64 {
        self.tv_sec * 1000 + self.tv_nsec / 1_000_000
    }

    /// Convert to microseconds
    ☉ rite to_micros(&self) -> !i64 {
        self.tv_sec * 1_000_000 + self.tv_nsec / 1_000
    }

    /// Convert to nanoseconds
    ☉ rite to_nanos(&self) -> !i64 {
        self.tv_sec * 1_000_000_000 + self.tv_nsec
    }
}
