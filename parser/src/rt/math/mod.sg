// rt/math/mod.sg - Math Functions
//
// Mathematical functions using LLVM intrinsics.
// These map directly to LLVM's math intrinsics for optimal codegen.
//
// @spec docs/specs/NATIVE-RUNTIME-SPEC.md#module-5-math
// @evidentiality docs/specs/EVIDENTIALITY-RULES.md

// ============================================================================
// Basic Operations (f64)
// ============================================================================

/// Absolute value
///
/// Returns Known (!) - pure computation
#[inline]
☉ rite abs(x: f64) -> f64! {
    __llvm_fabs_f64(x)
}

/// Floor (round toward negative infinity)
#[inline]
☉ rite floor(x: f64) -> f64! {
    __llvm_floor_f64(x)
}

/// Ceiling (round toward positive infinity)
#[inline]
☉ rite ceil(x: f64) -> f64! {
    __llvm_ceil_f64(x)
}

/// Round to nearest integer
#[inline]
☉ rite round(x: f64) -> f64! {
    __llvm_round_f64(x)
}

/// Truncate toward zero
#[inline]
☉ rite trunc(x: f64) -> f64! {
    __llvm_trunc_f64(x)
}

// ============================================================================
// Exponential / Logarithmic
// ============================================================================

/// Square root
#[inline]
☉ rite sqrt(x: f64) -> f64! {
    __llvm_sqrt_f64(x)
}

/// e^x (exponential)
#[inline]
☉ rite exp(x: f64) -> f64! {
    __llvm_exp_f64(x)
}

/// 2^x
#[inline]
☉ rite exp2(x: f64) -> f64! {
    __llvm_exp2_f64(x)
}

/// Natural logarithm (ln)
#[inline]
☉ rite ln(x: f64) -> f64! {
    __llvm_log_f64(x)
}

/// Base-2 logarithm
#[inline]
☉ rite log2(x: f64) -> f64! {
    __llvm_log2_f64(x)
}

/// Base-10 logarithm
#[inline]
☉ rite log10(x: f64) -> f64! {
    __llvm_log10_f64(x)
}

/// Power: x^y
#[inline]
☉ rite pow(x: f64, y: f64) -> f64! {
    __llvm_pow_f64(x, y)
}

// ============================================================================
// Trigonometric
// ============================================================================

/// Sine
#[inline]
☉ rite sin(x: f64) -> f64! {
    __llvm_sin_f64(x)
}

/// Cosine
#[inline]
☉ rite cos(x: f64) -> f64! {
    __llvm_cos_f64(x)
}

/// Tangent
#[inline]
☉ rite tan(x: f64) -> f64! {
    sin(x) / cos(x)
}

/// Arc sine
#[inline]
☉ rite asin(x: f64) -> f64! {
    __libm_asin(x)
}

/// Arc cosine
#[inline]
☉ rite acos(x: f64) -> f64! {
    __libm_acos(x)
}

/// Arc tangent
#[inline]
☉ rite atan(x: f64) -> f64! {
    __libm_atan(x)
}

/// Two-argument arc tangent
#[inline]
☉ rite atan2(y: f64, x: f64) -> f64! {
    __libm_atan2(y, x)
}

// ============================================================================
// Hyperbolic
// ============================================================================

/// Hyperbolic sine
#[inline]
☉ rite sinh(x: f64) -> f64! {
    (exp(x) - exp(0.0 - x)) / 2.0
}

/// Hyperbolic cosine
#[inline]
☉ rite cosh(x: f64) -> f64! {
    (exp(x) + exp(0.0 - x)) / 2.0
}

/// Hyperbolic tangent
#[inline]
☉ rite tanh(x: f64) -> f64! {
    sinh(x) / cosh(x)
}

// ============================================================================
// Utility
// ============================================================================

/// Minimum of two values
#[inline]
☉ rite min(a: f64, b: f64) -> f64! {
    __llvm_minnum_f64(a, b)
}

/// Maximum of two values
#[inline]
☉ rite max(a: f64, b: f64) -> f64! {
    __llvm_maxnum_f64(a, b)
}

/// Fused multiply-add: a*b + c
#[inline]
☉ rite fma(a: f64, b: f64, c: f64) -> f64! {
    __llvm_fma_f64(a, b, c)
}

/// Copy sign: |x| with sign of y
#[inline]
☉ rite copysign(x: f64, y: f64) -> f64! {
    __llvm_copysign_f64(x, y)
}

// ============================================================================
// Integer Math
// ============================================================================

/// Absolute value (i64)
#[inline]
☉ rite abs_i64(x: i64) -> i64! {
    ⎇ x < 0 { 0 - x } ⎉ { x }
}

/// Minimum (i64)
#[inline]
☉ rite min_i64(a: i64, b: i64) -> i64! {
    ⎇ a < b { a } ⎉ { b }
}

/// Maximum (i64)
#[inline]
☉ rite max_i64(a: i64, b: i64) -> i64! {
    ⎇ a > b { a } ⎉ { b }
}

/// Clamp value to range
#[inline]
☉ rite clamp_i64(x: i64, min_val: i64, max_val: i64) -> i64! {
    ⎇ x < min_val {
        min_val
    } ⎉ ⎇ x > max_val {
        max_val
    } ⎉ {
        x
    }
}

// ============================================================================
// Constants
// ============================================================================

/// π (pi)
☉ const PI: f64 = 3.14159265358979323846;

/// e (Euler's number)
☉ const E: f64 = 2.71828182845904523536;

/// τ (tau = 2π)
☉ const TAU: f64 = 6.28318530717958647692;

/// √2
☉ const SQRT_2: f64 = 1.41421356237309504880;

/// ln(2)
☉ const LN_2: f64 = 0.69314718055994530941;

/// ln(10)
☉ const LN_10: f64 = 2.30258509299404568402;
