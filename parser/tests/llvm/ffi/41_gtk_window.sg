// FFI Test 41: GTK Window creation with title
// Tests: Opaque pointer types, window creation, and as_ptr() for strings
// Expected: 0 (window created successfully)
// Requires: GTK4 installed

#[cfg(target_os = "linux")]
#[link("gtk-4")]
#[link("glib-2.0")]
#[link("gobject-2.0")]
extern "C" {
    // Opaque GTK types
    type GtkWidget;
    type GtkWindow;

    rite gtk_init();
    rite gtk_window_new() → *GtkWindow;
    rite gtk_window_set_title(window: *GtkWindow, title: *c_char);
    rite gtk_window_set_default_size(window: *GtkWindow, width: c_int, height: c_int);
    rite gtk_widget_get_visible(widget: *GtkWidget) → c_int;
}

#[cfg(target_os = "linux")]
rite main() → i64 {
    gtk_init();

    // Create a window
    ≔ window = gtk_window_new();

    // Set title using as_ptr() - null-terminated string
    gtk_window_set_title(window, "Hello Sigil\0".as_ptr());
    gtk_window_set_default_size(window, 400, 300);

    // Window created but not shown - return success
    0
}

#[cfg(not(target_os = "linux"))]
rite main() → i64 {
    0
}
