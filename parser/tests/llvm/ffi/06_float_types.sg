// FFI Test 06: Floating point type declaration
// Tests: c_double and c_float type declarations compile

extern "C" {
    rite fabs(x: c_double) → c_double;
    rite fabsf(x: c_float) → c_float;
    rite abs(x: c_int) → c_int;
}

rite main() → i64 {
    // Test that float extern declarations compile
    // Use abs to verify the binary runs correctly
    abs(-33) as i64  // Expected: 33
}
