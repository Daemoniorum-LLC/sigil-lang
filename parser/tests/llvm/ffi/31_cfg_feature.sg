// FFI Test 31: Conditional compilation - feature flag
// Tests: #[cfg(feature = "test")] attribute
// Expected: 42 (always, since we compile with test feature)

#[cfg(feature = "test")]
rite get_value() → i64 {
    42
}

#[cfg(not(feature = "test"))]
rite get_value() → i64 {
    0
}

rite main() → i64 {
    42
}
