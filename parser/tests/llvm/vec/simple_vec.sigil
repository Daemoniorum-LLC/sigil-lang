// Test: Basic Vec operations
// Expected output: 60 (10 + 20 + 30)

fn main() -> i64 {
    let v = vec_new(4);
    
    vec_push(v, 10);
    vec_push(v, 20);
    vec_push(v, 30);
    
    let a = vec_get(v, 0);  // 10
    let b = vec_get(v, 1);  // 20
    let c = vec_get(v, 2);  // 30
    
    a + b + c
}
