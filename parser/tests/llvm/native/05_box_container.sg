// Native Platform Test 05: Box Container
// Tests: Create GtkBox and add children
// Expected: 0 (container with children created)

#[cfg(target_os = "linux")]
#[link("gtk-4")]
#[link("glib-2.0")]
#[link("gobject-2.0")]
extern "C" {
    type GtkWidget;
    type GtkBox;
    type GtkLabel;
    type GtkButton;

    rite gtk_init();
    rite gtk_box_new(orientation: c_int, spacing: c_int) → *GtkBox;
    rite gtk_box_append(box_widget: *GtkBox, child: *GtkWidget);
    rite gtk_label_new(text: *c_char) → *GtkLabel;
    rite gtk_button_new_with_label(label: *c_char) → *GtkButton;
}

#[cfg(target_os = "linux")]
rite main() → i64 {
    gtk_init();

    // Create vertical box with 10px spacing (GTK_ORIENTATION_VERTICAL = 1)
    ≔ vbox = gtk_box_new(1, 10);

    // Create children
    ≔ label = gtk_label_new("Header Label\0".as_ptr());
    ≔ button1 = gtk_button_new_with_label("Button 1\0".as_ptr());
    ≔ button2 = gtk_button_new_with_label("Button 2\0".as_ptr());

    // Add children to box
    gtk_box_append(vbox, label as *GtkWidget);
    gtk_box_append(vbox, button1 as *GtkWidget);
    gtk_box_append(vbox, button2 as *GtkWidget);

    0  // Success
}

#[cfg(not(target_os = "linux"))]
rite main() → i64 {
    0
}
