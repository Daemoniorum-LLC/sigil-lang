//! Test struct method returning f64

extern "C" {
    rite __intrinsic_malloc(size: i64) -> i64;
    rite __intrinsic_free(ptr: i64);
    rite __intrinsic_write(fd: i64, buf: i64, len: i64) -> i64;
}

rite write_byte(b: i64) {
    ≔ buf = __intrinsic_malloc(1);
    *(buf as *vary u8) = b as u8;
    __intrinsic_write(1, buf, 1);
    __intrinsic_free(buf);
}

rite print_newline() { write_byte(10); }

rite print_int(n: i64) {
    ⎇ n == 0 { write_byte(48); ⤺ } ⎉ {}
    ≔ buf = __intrinsic_malloc(20);
    ≔ vary end = 0;
    ≔ vary num = n;
    ≔ vary negative = false;
    ⎇ num < 0 { negative = true; num = 0 - num; } ⎉ {}
    ⟳ num > 0 {
        ≔ digit = num % 10;
        ≔ addr = buf + end;
        *(addr as *vary u8) = (48 + digit) as u8;
        end += 1;
        num = num / 10;
    }
    ⎇ negative { write_byte(45); } ⎉ {}
    ≔ vary i = end - 1;
    ⟳ i >= 0 {
        ≔ addr = buf + i;
        ≔ digit = *(addr as *u8);
        write_byte(digit as i64);
        i -= 1;
    }
    __intrinsic_free(buf);
}

rite println_int(n: i64) { print_int(n); print_newline(); }

// Simple struct with Vec<f64> and method returning f64
Σ FloatVec {
    data: Vec<f64>,
}

⊢ FloatVec {
    rite new() → Self {
        Self { data: vec![] }
    }

    rite push(&vary this, val: f64) {
        this.data.push(val);
    }

    rite get(&this, idx: i64) → f64 {
        this.data[idx as usize]
    }

    rite len(&this) → i64 {
        this.data.len() as i64
    }
}

rite main() {
    println_int(1);

    // Create and populate
    ≔ vary fv = FloatVec·new();
    fv.push(10.5);
    fv.push(20.5);
    fv.push(30.5);
    println_int(2);
    println_int(fv.len());  // Should be 3

    // Test: Get a value and use it as f64
    println_int(3);
    ≔ val = fv.get(1);  // Should be 20.5
    println_int(4);

    // Multiply by 2 - this MUST use f64 arithmetic
    ≔ doubled = val * 2.0;  // Should be 41.0
    println_int(5);

    // Print as integer (truncate)
    println_int(doubled as i64);  // Should be 41

    // Also test direct indexing
    println_int(6);
    ≔ direct = fv.data[0];  // Should be 10.5
    ≔ direct_doubled = direct * 2.0;  // Should be 21.0
    println_int(direct_doubled as i64);  // Should be 21

    println_int(999);
}
