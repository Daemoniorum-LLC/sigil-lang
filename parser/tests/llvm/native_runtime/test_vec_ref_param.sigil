//! Test &Vec<T> parameters (not slices)

extern "C" {
    rite __intrinsic_malloc(size: i64) -> i64;
    rite __intrinsic_free(ptr: i64);
    rite __intrinsic_write(fd: i64, buf: i64, len: i64) -> i64;
}

rite write_byte(b: i64) {
    ≔ buf = __intrinsic_malloc(1);
    *(buf as *vary u8) = b as u8;
    __intrinsic_write(1, buf, 1);
    __intrinsic_free(buf);
}

rite print_newline() { write_byte(10); }

rite print_int(n: i64) {
    ⎇ n == 0 { write_byte(48); ⤺ } ⎉ {}
    ≔ buf = __intrinsic_malloc(20);
    ≔ vary end = 0;
    ≔ vary num = n;
    ≔ vary negative = false;
    ⎇ num < 0 { negative = true; num = 0 - num; } ⎉ {}
    ⟳ num > 0 {
        ≔ digit = num % 10;
        ≔ addr = buf + end;
        *(addr as *vary u8) = (48 + digit) as u8;
        end += 1;
        num = num / 10;
    }
    ⎇ negative { write_byte(45); } ⎉ {}
    ≔ vary i = end - 1;
    ⟳ i >= 0 {
        ≔ addr = buf + i;
        ≔ digit = *(addr as *u8);
        write_byte(digit as i64);
        i -= 1;
    }
    __intrinsic_free(buf);
}

rite println_int(n: i64) { print_int(n); print_newline(); }

// Test reading from &Vec<T> (not slice)
rite sum_i64_vec(arr: &Vec<i64>) → i64 {
    ≔ vary total = 0;
    println_int(100);
    println_int(arr.len() as i64);
    ∀ i ∈ 0..arr.len() {
        println_int(200 + i as i64);
        total += arr[i];
    }
    println_int(300);
    total
}

Σ PairCount { left: i64, right: i64, count: i64 }

rite best_pair(pairs: &Vec<PairCount>) → (i64, i64, i64) {
    println_int(400);
    ⎇ pairs.len() == 0 { ⤺ (-1, -1, 0); } ⎉ {}
    println_int(401);
    ≔ vary best_idx = 0;
    ≔ vary best_count = pairs[0].count;
    println_int(402);
    ∀ i ∈ 1..pairs.len() {
        println_int(500 + i as i64);
        ⎇ pairs[i].count > best_count {
            best_idx = i;
            best_count = pairs[i].count;
        } ⎉ {}
    }
    println_int(403);
    (pairs[best_idx].left, pairs[best_idx].right, pairs[best_idx].count)
}

rite main() {
    // Test 1: &Vec<i64>
    println_int(1);
    ≔ vary v: Vec<i64> = vec![1, 2, 3, 4, 5];
    ≔ s = sum_i64_vec(&v);
    println_int(2);
    println_int(s);  // Should be 15

    // Test 2: &Vec<PairCount>
    println_int(3);
    ≔ vary pairs: Vec<PairCount> = vec![];
    pairs.push(PairCount { left: 65, right: 66, count: 5 });
    pairs.push(PairCount { left: 66, right: 67, count: 10 });
    pairs.push(PairCount { left: 67, right: 68, count: 3 });

    ≔ (bl, br, bc) = best_pair(&pairs);
    println_int(4);
    println_int(bl);   // Should be 66
    println_int(br);   // Should be 67
    println_int(bc);   // Should be 10
}
