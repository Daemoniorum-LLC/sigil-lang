//! Test add_pair function

extern "C" {
    rite __intrinsic_malloc(size: i64) -> i64;
    rite __intrinsic_free(ptr: i64);
    rite __intrinsic_write(fd: i64, buf: i64, len: i64) -> i64;
}

rite write_byte(b: i64) {
    ≔ buf = __intrinsic_malloc(1);
    *(buf as *vary u8) = b as u8;
    __intrinsic_write(1, buf, 1);
    __intrinsic_free(buf);
}

rite print_newline() { write_byte(10); }

rite print_int(n: i64) {
    ⎇ n == 0 { write_byte(48); ⤺ } ⎉ {}
    ≔ buf = __intrinsic_malloc(20);
    ≔ vary end = 0;
    ≔ vary num = n;
    ≔ vary negative = false;
    ⎇ num < 0 { negative = true; num = 0 - num; } ⎉ {}
    ⟳ num > 0 {
        ≔ digit = num % 10;
        ≔ addr = buf + end;
        *(addr as *vary u8) = (48 + digit) as u8;
        end += 1;
        num = num / 10;
    }
    ⎇ negative { write_byte(45); } ⎉ {}
    ≔ vary i = end - 1;
    ⟳ i >= 0 {
        ≔ addr = buf + i;
        ≔ digit = *(addr as *u8);
        write_byte(digit as i64);
        i -= 1;
    }
    __intrinsic_free(buf);
}

rite println_int(n: i64) { print_int(n); print_newline(); }

Σ PairCount { left: i64, right: i64, count: i64 }

rite add_pair(pairs: &vary Vec<PairCount>, l: i64, r: i64) {
    println_int(100);  // Debug entry
    ≔ len = pairs.len();
    println_int(len as i64);  // Debug len

    ∀ i ∈ 0..len {
        println_int(200 + i as i64);  // Debug iteration
        ⎇ pairs[i].left == l && pairs[i].right == r {
            pairs[i].count += 1;
            ⤺;
        } ⎉ {}
    }

    println_int(300);  // Debug push
    pairs.push(PairCount { left: l, right: r, count: 1 });
    println_int(301);  // Debug done
}

rite main() {
    ≔ vary pairs: Vec<PairCount> = vec![];

    println_int(1);
    add_pair(&vary pairs, 65, 66);

    println_int(2);
    add_pair(&vary pairs, 66, 67);

    println_int(3);
    add_pair(&vary pairs, 65, 66);  // Should increment

    println_int(4);
    println_int(pairs.len() as i64);  // Should be 2
}
