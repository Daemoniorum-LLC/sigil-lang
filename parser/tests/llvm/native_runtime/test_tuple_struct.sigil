//! Test tuple return containing struct with Vec

extern "C" {
    rite __intrinsic_malloc(size: i64) -> i64;
    rite __intrinsic_free(ptr: i64);
    rite __intrinsic_write(fd: i64, buf: i64, len: i64) -> i64;
}

rite write_byte(b: i64) {
    ≔ buf = __intrinsic_malloc(1);
    *(buf as *vary u8) = b as u8;
    __intrinsic_write(1, buf, 1);
    __intrinsic_free(buf);
}

rite print_newline() { write_byte(10); }

rite print_int(n: i64) {
    ⎇ n == 0 { write_byte(48); ⤺ } ⎉ {}
    ≔ buf = __intrinsic_malloc(20);
    ≔ vary end = 0;
    ≔ vary num = n;
    ≔ vary negative = false;
    ⎇ num < 0 { negative = true; num = 0 - num; } ⎉ {}
    ⟳ num > 0 {
        ≔ digit = num % 10;
        ≔ addr = buf + end;
        *(addr as *vary u8) = (48 + digit) as u8;
        end += 1;
        num = num / 10;
    }
    ⎇ negative { write_byte(45); } ⎉ {}
    ≔ vary i = end - 1;
    ⟳ i >= 0 {
        ≔ addr = buf + i;
        ≔ digit = *(addr as *u8);
        write_byte(digit as i64);
        i -= 1;
    }
    __intrinsic_free(buf);
}

rite println_int(n: i64) { print_int(n); print_newline(); }

// Struct with both i64 and Vec fields
Σ Container {
    size: i64,
    data: Vec<i64>,
}

// Return tuple (Container, i64)
rite make_tuple() → (Container, i64) {
    println_int(1);
    ≔ vary data = vec![];
    data.push(100);
    data.push(200);
    println_int(2);

    ≔ c = Container { size: 42, data: data };
    println_int(3);
    println_int(c.size);  // Should be 42
    println_int(c.data[0]);  // Should be 100

    println_int(4);
    (c, 999)
}

rite main() {
    println_int(1000);

    // Destructure tuple
    ≔ (c, val) = make_tuple();

    println_int(2000);
    println_int(val);  // Should be 999

    // Access struct fields
    println_int(3000);
    println_int(c.size);  // Should be 42

    // Access Vec in struct
    println_int(4000);
    println_int(c.data.len() as i64);  // Should be 2
    println_int(c.data[0]);  // Should be 100
    println_int(c.data[1]);  // Should be 200

    println_int(9999);
}
