//! Test f64 printing in println!

extern "C" {
    rite __intrinsic_malloc(size: i64) -> i64;
    rite __intrinsic_free(ptr: i64);
    rite __intrinsic_write(fd: i64, buf: i64, len: i64) -> i64;
}

rite write_byte(b: i64) {
    ≔ buf = __intrinsic_malloc(1);
    *(buf as *vary u8) = b as u8;
    __intrinsic_write(1, buf, 1);
    __intrinsic_free(buf);
}

rite print_newline() { write_byte(10); }

rite print_int(n: i64) {
    ⎇ n == 0 { write_byte(48); ⤺ } ⎉ {}
    ≔ buf = __intrinsic_malloc(20);
    ≔ vary end = 0;
    ≔ vary num = n;
    ≔ vary negative = false;
    ⎇ num < 0 { negative = true; num = 0 - num; } ⎉ {}
    ⟳ num > 0 {
        ≔ digit = num % 10;
        ≔ addr = buf + end;
        *(addr as *vary u8) = (48 + digit) as u8;
        end += 1;
        num = num / 10;
    }
    ⎇ negative { write_byte(45); } ⎉ {}
    ≔ vary i = end - 1;
    ⟳ i >= 0 {
        ≔ addr = buf + i;
        ≔ digit = *(addr as *u8);
        write_byte(digit as i64);
        i -= 1;
    }
    __intrinsic_free(buf);
}

rite println_int(n: i64) { print_int(n); print_newline(); }

// Test f64 division and println!
rite test_division() → f64 {
    ≔ base = 0.001;
    ≔ step = 0.0;
    ≔ warmup = 5.0;
    ≔ result = base * (step + 1.0) / warmup;
    println!("Division result: {}", result);  // Should be 0.0002
    result
}

rite main() {
    println_int(1);

    // Test basic f64 println
    ≔ x = 3.14;
    println!("x = {}", x);  // Should print x = 3.14

    // Test f64 from function
    println_int(2);
    ≔ result = test_division();
    println!("Result from function: {}", result);

    // Test truncation
    println_int(3);
    println_int((result * 10000.0) as i64);  // Should be 2 (0.0002 * 10000 = 2)

    println_int(999);
}
