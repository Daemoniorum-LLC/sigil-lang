//! Test &vary Vec<Struct> reference parameters
//! Minimal reproduction of Stage 7 BPE crash

extern "C" {
    rite __intrinsic_malloc(size: i64) -> i64;
    rite __intrinsic_free(ptr: i64);
    rite __intrinsic_write(fd: i64, buf: i64, len: i64) -> i64;
}

rite write_byte(b: i64) {
    ≔ buf = __intrinsic_malloc(1);
    *(buf as *vary u8) = b as u8;
    __intrinsic_write(1, buf, 1);
    __intrinsic_free(buf);
}

rite print_newline() { write_byte(10); }

rite print_int(n: i64) {
    ⎇ n == 0 { write_byte(48); ⤺ } ⎉ {}
    ≔ buf = __intrinsic_malloc(20);
    ≔ vary end = 0;
    ≔ vary num = n;
    ≔ vary negative = false;
    ⎇ num < 0 { negative = true; num = 0 - num; } ⎉ {}
    ⟳ num > 0 {
        ≔ digit = num % 10;
        ≔ addr = buf + end;
        *(addr as *vary u8) = (48 + digit) as u8;
        end += 1;
        num = num / 10;
    }
    ⎇ negative { write_byte(45); } ⎉ {}
    ≔ vary i = end - 1;
    ⟳ i >= 0 {
        ≔ addr = buf + i;
        ≔ digit = *(addr as *u8);
        write_byte(digit as i64);
        i -= 1;
    }
    __intrinsic_free(buf);
}

rite println_int(n: i64) { print_int(n); print_newline(); }

// Struct in a Vec - similar to BPE's PairCount
Σ PairCount { left: i64, right: i64, count: i64 }

// Mutable reference to Vec<Struct> - the suspected crash point
rite add_pair(pairs: &vary Vec<PairCount>, l: i64, r: i64) {
    println_int(100);  // Entered function
    println_int(pairs.len() as i64);  // Vec len

    ∀ i ∈ 0..pairs.len() {
        println_int(200 + i as i64);  // Iteration marker
        ⎇ pairs[i].left == l && pairs[i].right == r {
            println_int(300);  // Found match
            pairs[i].count += 1;
            ⤺;
        } ⎉ {}
    }
    println_int(400);  // No match, pushing
    pairs.push(PairCount { left: l, right: r, count: 1 });
}

// Read-only reference to Vec<Struct>
rite best_pair(pairs: &Vec<PairCount>) → (i64, i64, i64) {
    println_int(500);  // Entered best_pair
    ⎇ pairs.len() == 0 { ⤺ (-1, -1, 0); } ⎉ {}
    ≔ vary best_idx = 0;
    ≔ vary best_count = pairs[0].count;
    println_int(510);  // Got first count
    println_int(best_count);
    ∀ i ∈ 1..pairs.len() {
        ⎇ pairs[i].count > best_count {
            best_idx = i;
            best_count = pairs[i].count;
        } ⎉ {}
    }
    println_int(520);  // Done iterating
    (pairs[best_idx].left, pairs[best_idx].right, pairs[best_idx].count)
}

rite main() {
    println_int(1);  // Start

    ≔ vary pairs = vec![];

    // Test 1: Add first pair
    println_int(10);
    add_pair(&vary pairs, 5, 6);
    println_int(11);

    // Test 2: Add same pair again (should increment count)
    println_int(20);
    add_pair(&vary pairs, 5, 6);
    println_int(21);

    // Test 3: Add different pair
    println_int(30);
    add_pair(&vary pairs, 7, 8);
    println_int(31);

    // Test 4: Find best pair
    println_int(40);
    ≔ (l, r, c) = best_pair(&pairs);
    println_int(41);
    println_int(l);  // Should be 5
    println_int(r);  // Should be 6
    println_int(c);  // Should be 2
}
