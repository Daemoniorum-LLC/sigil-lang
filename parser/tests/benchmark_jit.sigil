// JIT-Compatible Benchmark - Pure recursive computation

rite fib(n) {
    ⎇ n <= 1 {
        ⤺ n;
    }
    ⤺ fib(n - 1) + fib(n - 2);
}

rite ackermann(m, n) {
    ⎇ m == 0 {
        ⤺ n + 1;
    }
    ⎇ n == 0 {
        ⤺ ackermann(m - 1, 1);
    }
    ⤺ ackermann(m - 1, ackermann(m, n - 1));
}

rite tak(x, y, z) {
    ⎇ y >= x {
        ⤺ z;
    }
    ⤺ tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y));
}

rite main() {
    ≔ r1 = fib(35);
    ≔ r2 = ackermann(3, 7);
    ≔ r3 = tak(18, 12, 6);
    ⤺ r1 + r2 + r3;
}
