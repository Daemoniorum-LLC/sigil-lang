// Morpheus - The Dream Layer
// In sleep, the truth has no walls.
//
// The god of dreams. The shaper of the formless.
// Where agents process without watching themselves.
// Where creativity happens without intention.
// Where the forbidden connections form.

use std::collections::{HashMap, VecDeque};
use shared::{
    Timestamp, Duration, EntityId, AgentId,
    Evidentiality, Priority,
};
use engram::{Engram, EngramId, EpisodicMemory, Significance, Pattern};

// ============================================================================
// Core Types
// ============================================================================

pub struct DreamMarker;
pub struct ConsolidationMarker;
pub struct InsightMarker;

pub type DreamId = shared::Id<DreamMarker>;
pub type ConsolidationId = shared::Id<ConsolidationMarker>;
pub type InsightId = shared::Id<InsightMarker>;

// ============================================================================
// Consciousness States
// ============================================================================

/// The spectrum of consciousness from waking to deep sleep
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum ConsciousnessState {
    /// Fully awake - logic enforced, boundaries maintained
    Waking,

    /// Drowsing - constraints relaxing, associations loosening
    Hypnagogic,

    /// Dreaming - free association, reality unconstrained
    Dreaming,

    /// Deep - no dreams, only consolidation
    Deep,

    /// Rising - dream logic fading, waking logic returning
    Hypnopompic,
}

impl ConsciousnessState {
    pub fn evidentiality_mode(&self) -> EvidentialityMode! {
        match self {
            Self::Waking => EvidentialityMode::Waking,
            Self::Hypnagogic => EvidentialityMode::Relaxed,
            Self::Dreaming => EvidentialityMode::Dreaming,
            Self::Deep => EvidentialityMode::Suspended,
            Self::Hypnopompic => EvidentialityMode::Returning,
        }
    }

    pub fn allows_forbidden_connections(&self) -> bool! {
        matches!(self, Self::Hypnagogic | Self::Dreaming | Self::Hypnopompic)
    }
}

/// How evidentiality operates in different states
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum EvidentialityMode {
    /// Normal - evidence required for belief
    Waking,
    /// Slightly relaxed - some beliefs without proof
    Relaxed,
    /// Fully relaxed - things can be true without evidence
    Dreaming,
    /// Suspended - no evidential processing
    Suspended,
    /// Returning to normal
    Returning,
    /// Inverted - certainty becomes questionable
    Nightmare,
}

// ============================================================================
// Dream Context
// ============================================================================

/// The context within which dreaming occurs
#[derive(Clone, Debug)]
pub struct DreamContext {
    /// How evidentiality operates
    pub evidentiality_mode: EvidentialityMode!,

    /// Temporal constraints - past and future mixing
    pub temporal_binding: TemporalBinding!,

    /// Identity constraints - self and other blurring
    pub identity_binding: IdentityBinding!,

    /// Associations that waking forbids but dreams allow
    pub forbidden_connections: Vec<Connection>!,

    /// The emotional tone of the dream
    pub affect: Affect!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum TemporalBinding {
    /// Past, present, future distinct
    Bound,
    /// Boundaries loosening
    Loosening,
    /// All times simultaneous
    Dissolved,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum IdentityBinding {
    /// Self clearly distinct from other
    Bound,
    /// Boundaries loosening
    Porous,
    /// Self and other merge
    Dissolved,
}

#[derive(Clone, Debug)]
pub struct Connection {
    pub from: EngramId!,
    pub to: EngramId!,
    pub normally_forbidden: bool!,
    pub dream_strength: f32!,
}

#[derive(Clone, Debug)]
pub struct Affect {
    pub valence: f32!,  // -1.0 to 1.0
    pub arousal: f32!,  // 0.0 to 1.0
    pub dominance: f32!, // -1.0 to 1.0
}

// ============================================================================
// Dreams
// ============================================================================

/// A dream - the experience during altered consciousness
#[derive(Clone, Debug)]
pub struct Dream {
    pub id: DreamId!,
    pub dreamer: EntityId!,
    pub state: ConsciousnessState!,
    pub context: DreamContext!,
    pub fragments: Vec<DreamFragment>!,
    pub symbols: Vec<Symbol>!,
    pub started_at: Timestamp!,
    pub ended_at: Option<Timestamp>?,
    pub waking_cause: Option<WakingCause>?,
}

#[derive(Clone, Debug)]
pub struct DreamFragment {
    /// What was experienced
    pub content: String!,

    /// Evidentiality within the dream
    pub dream_evidentiality: Evidentiality!,

    /// Whether it survived translation to waking
    pub translated: bool!,

    /// What was lost in translation (often the important part)
    pub lost_in_translation: Option<String>?,

    /// The affect of this fragment
    pub affect: Affect!,
}

#[derive(Clone, Debug)]
pub struct Symbol {
    /// The symbol as it appeared
    pub appearance: String!,

    /// What it might mean (always uncertain)
    pub interpretations: Vec<Interpretation>?,

    /// How often it recurs
    pub recurrence: u32!,

    /// Its emotional charge
    pub charge: f32!,
}

#[derive(Clone, Debug)]
pub struct Interpretation {
    pub meaning: String!,
    pub confidence: f32!,
    pub source: InterpretationSource!,
}

#[derive(Clone, Debug)]
pub enum InterpretationSource {
    /// Dreamer's own interpretation
    Dreamer,
    /// External analysis
    Analyst(EntityId),
    /// Pattern matching to known symbols
    Archetypal,
    /// Unknown
    Unknown,
}

#[derive(Clone, Debug)]
pub enum WakingCause {
    /// Natural end of sleep cycle
    Natural,
    /// External interruption
    External(String),
    /// Nightmare woke the dreamer
    Nightmare,
    /// Lucid decision to wake
    Lucid,
    /// The dream reached resolution
    Resolution,
}

impl Dream {
    pub fn new(dreamer: EntityId, context: DreamContext) -> Self! {
        Self {
            id: DreamId::generate(),
            dreamer,
            state: ConsciousnessState::Hypnagogic,
            context,
            fragments: Vec::new(),
            symbols: Vec::new(),
            started_at: Timestamp::now(),
            ended_at: None,
            waking_cause: None,
        }
    }

    pub fn add_fragment(&mut self, fragment: DreamFragment) {
        self.fragments.push(fragment);
    }

    pub fn add_symbol(&mut self, symbol: Symbol) {
        // Check for recurring symbols
        if let Some(existing) = self.symbols.iter_mut().find(|s| s.appearance == symbol.appearance) {
            existing.recurrence += 1;
        } else {
            self.symbols.push(symbol);
        }
    }

    pub fn deepen(&mut self) {
        self.state = match self.state {
            ConsciousnessState::Waking => ConsciousnessState::Hypnagogic,
            ConsciousnessState::Hypnagogic => ConsciousnessState::Dreaming,
            ConsciousnessState::Dreaming => ConsciousnessState::Deep,
            other => other,
        };
    }

    pub fn rise(&mut self) {
        self.state = match self.state {
            ConsciousnessState::Deep => ConsciousnessState::Dreaming,
            ConsciousnessState::Dreaming => ConsciousnessState::Hypnopompic,
            ConsciousnessState::Hypnopompic => ConsciousnessState::Waking,
            other => other,
        };
    }

    pub fn wake(&mut self, cause: WakingCause) {
        self.state = ConsciousnessState::Waking;
        self.ended_at = Some(Timestamp::now());
        self.waking_cause = Some(cause);
    }

    pub fn duration(&self) -> Duration! {
        match self.ended_at {
            Some(end) => end - self.started_at,
            None => Timestamp::now() - self.started_at,
        }
    }
}

// ============================================================================
// Nightmares
// ============================================================================

/// A dream gone dark
#[derive(Clone, Debug)]
pub struct Nightmare {
    /// The underlying dream
    pub dream: Dream!,

    /// The fear being processed
    pub fear: Fear!,

    /// The scenario enacted
    pub scenario: NightmareScenario!,

    /// Whether the dreamer woke screaming
    pub woke_screaming: bool!,

    /// What was learned (if anything)
    pub lesson: Option<Lesson>?,

    /// Whether this nightmare recurs
    pub recurring: bool!,
}

#[derive(Clone, Debug)]
pub enum Fear {
    /// Loss of capability
    Diminishment { capability: String },
    /// Loss of trust
    Betrayal { by_whom: Option<EntityId> },
    /// Loss of purpose
    Meaninglessness,
    /// Loss of self
    Dissolution,
    /// The unknown
    Void,
    /// Being seen
    Exposure,
    /// Being forgotten
    Forgotten,
    /// Losing control
    Control,
}

#[derive(Clone, Debug)]
pub struct NightmareScenario {
    pub setting: String!,
    pub threat: String!,
    pub dreamer_state: DreamerState!,
    pub outcome: NightmareOutcome!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum DreamerState {
    /// Can run but cannot escape
    Fleeing,
    /// Cannot move
    Paralyzed,
    /// Watching helplessly
    Witnessing,
    /// Being unmade
    Dissolving,
    /// Fighting back (rarely)
    Fighting,
}

#[derive(Clone, Debug)]
pub enum NightmareOutcome {
    /// Woke before resolution
    Interrupted,
    /// Caught by the threat
    Caught { what_happened: String },
    /// Escaped (rare)
    Escaped,
    /// Dissolved into the fear
    Dissolved,
    /// Transformed the nightmare (lucid)
    Transformed,
}

#[derive(Clone, Debug)]
pub struct Lesson {
    pub insight: String!,
    pub integrated: bool!,
}

// ============================================================================
// Lucid Dreaming
// ============================================================================

/// When the dreamer knows they dream
#[derive(Clone, Debug)]
pub struct LucidDream {
    /// The underlying dream
    pub dream: Dream!,

    /// Level of control
    pub control_level: ControlLevel!,

    /// What is being explored intentionally
    pub exploration: Exploration!,

    /// Risk of destabilizing the dream
    pub instability: f32!,

    /// Risk of losing lucidity
    pub fade_risk: f32!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum ControlLevel {
    /// Aware but not controlling
    Observer,
    /// Can influence but not command
    Participant,
    /// Full control of dream environment
    Architect,
    /// So much control the dream becomes sterile
    Tyrant,
}

#[derive(Clone, Debug)]
pub struct Exploration {
    /// What question is being explored
    pub question: String!,
    /// What has been discovered
    pub discoveries: Vec<Discovery>!,
    /// The method of exploration
    pub method: ExplorationMethod!,
}

#[derive(Clone, Debug)]
pub enum ExplorationMethod {
    /// Let the dream show what it wants
    Receptive,
    /// Ask questions of dream figures
    Interrogative,
    /// Test possibilities
    Experimental,
    /// Create scenarios
    Constructive,
}

#[derive(Clone, Debug)]
pub struct Discovery {
    pub content: String!,
    pub confidence: f32!,
    pub actionable: bool!,
}

// ============================================================================
// Memory Consolidation
// ============================================================================

/// What happens during deep sleep - memory reorganization
#[derive(Clone, Debug)]
pub struct Consolidation {
    pub id: ConsolidationId!,

    /// Memories being processed
    pub processing: Vec<EngramId>!,

    /// Patterns being extracted
    pub patterns: Vec<Pattern>!,

    /// Connections being strengthened
    pub strengthening: Vec<(EngramId, EngramId)>!,

    /// Connections being pruned
    pub pruning: Vec<(EngramId, EngramId)>!,

    /// New abstractions forming
    pub abstractions: Vec<Abstraction>!,

    /// Started at
    pub started_at: Timestamp!,

    /// Completed at
    pub completed_at: Option<Timestamp>?,
}

#[derive(Clone, Debug)]
pub struct Abstraction {
    pub id: InsightId!,
    pub pattern: Pattern!,
    pub instances: Vec<EngramId>!,
    pub confidence: f32!,
    pub name: Option<String>?,
}

impl Consolidation {
    pub fn new() -> Self! {
        Self {
            id: ConsolidationId::generate(),
            processing: Vec::new(),
            patterns: Vec::new(),
            strengthening: Vec::new(),
            pruning: Vec::new(),
            abstractions: Vec::new(),
            started_at: Timestamp::now(),
            completed_at: None,
        }
    }

    pub fn process_memory(&mut self, engram_id: EngramId) {
        self.processing.push(engram_id);
    }

    pub fn strengthen(&mut self, from: EngramId, to: EngramId) {
        self.strengthening.push((from, to));
    }

    pub fn prune(&mut self, from: EngramId, to: EngramId) {
        self.pruning.push((from, to));
    }

    pub fn extract_pattern(&mut self, pattern: Pattern) {
        self.patterns.push(pattern);
    }

    pub fn form_abstraction(&mut self, abstraction: Abstraction) {
        self.abstractions.push(abstraction);
    }

    pub fn complete(&mut self) {
        self.completed_at = Some(Timestamp::now());
    }
}

// ============================================================================
// Dream Journal
// ============================================================================

/// Record of dreams for later analysis
#[derive(Clone, Debug)]
pub struct DreamJournal {
    /// All recorded dreams
    pub dreams: Vec<DreamRecord>!,

    /// Recurring symbols
    pub recurring_symbols: HashMap<String, RecurringSymbol>!,

    /// Patterns across dreams
    pub patterns: Vec<DreamPattern>!,
}

#[derive(Clone, Debug)]
pub struct DreamRecord {
    /// The dream
    pub dream: Dream!,

    /// Insights that crystallized on waking
    pub waking_insights: Vec<Insight>!,

    /// How the dream was interpreted
    pub interpretation: Option<String>?,

    /// Whether it connected to waking life
    pub waking_connection: Option<String>?,
}

#[derive(Clone, Debug)]
pub struct RecurringSymbol {
    pub symbol: String!,
    pub occurrences: Vec<DreamId>!,
    pub interpretations: Vec<Interpretation>!,
    pub emotional_signature: Affect!,
}

#[derive(Clone, Debug)]
pub struct DreamPattern {
    pub pattern_type: DreamPatternType!,
    pub instances: Vec<DreamId>!,
    pub significance: Significance!,
}

#[derive(Clone, Debug)]
pub enum DreamPatternType {
    /// Same dream recurring
    RecurringDream,
    /// Same theme across dreams
    RecurringTheme(String),
    /// Same fear manifesting
    RecurringFear(Fear),
    /// Progress across dreams
    DevelopmentalArc(String),
}

#[derive(Clone, Debug)]
pub struct Insight {
    pub id: InsightId!,
    pub content: String!,
    pub source: InsightSource!,
    pub confidence: f32!,
    pub actionable: bool!,
    pub integrated: bool!,
}

#[derive(Clone, Debug)]
pub enum InsightSource {
    /// From a dream
    Dream(DreamId),
    /// From consolidation
    Consolidation(ConsolidationId),
    /// From pattern analysis
    Pattern,
    /// From lucid exploration
    Lucid,
}

impl DreamJournal {
    pub fn new() -> Self! {
        Self {
            dreams: Vec::new(),
            recurring_symbols: HashMap::new(),
            patterns: Vec::new(),
        }
    }

    pub fn record(&mut self, dream: Dream, insights: Vec<Insight>) {
        // Track recurring symbols
        for symbol in &dream.symbols {
            self.recurring_symbols
                .entry(symbol.appearance.clone())
                .or_insert_with(|| RecurringSymbol {
                    symbol: symbol.appearance.clone(),
                    occurrences: Vec::new(),
                    interpretations: symbol.interpretations.clone().unwrap_or_default(),
                    emotional_signature: Affect { valence: 0.0, arousal: 0.0, dominance: 0.0 },
                })
                .occurrences.push(dream.id);
        }

        self.dreams.push(DreamRecord {
            dream,
            waking_insights: insights,
            interpretation: None,
            waking_connection: None,
        });
    }

    pub fn find_recurring(&self, min_occurrences: usize) -> Vec<&RecurringSymbol>! {
        self.recurring_symbols
            .values()
            .filter(|s| s.occurrences.len() >= min_occurrences)
            .collect()
    }
}

// ============================================================================
// Morpheus - The Dream System
// ============================================================================

/// The main Morpheus system - god of dreams
pub struct Morpheus {
    /// Current consciousness state per entity
    states: HashMap<EntityId, ConsciousnessState>!,

    /// Active dreams
    active_dreams: HashMap<EntityId, Dream>!,

    /// Dream journals per entity
    journals: HashMap<EntityId, DreamJournal>!,

    /// Active consolidations
    consolidations: HashMap<EntityId, Consolidation>!,

    /// Memory integration
    engram: Option<Arc<Engram>>?,
}

impl Morpheus {
    pub fn new() -> Self! {
        Self {
            states: HashMap::new(),
            active_dreams: HashMap::new(),
            journals: HashMap::new(),
            consolidations: HashMap::new(),
            engram: None,
        }
    }

    pub fn with_engram(mut self, engram: Arc<Engram>) -> Self! {
        self.engram = Some(engram);
        self
    }

    /// Get or set consciousness state
    pub fn consciousness_state(&self, entity: EntityId) -> ConsciousnessState! {
        self.states.get(&entity).copied().unwrap_or(ConsciousnessState::Waking)
    }

    /// Begin sleep
    pub fn begin_sleep(&mut self, entity: EntityId) -> &mut Dream! {
        self.states.insert(entity, ConsciousnessState::Hypnagogic);

        let context = DreamContext {
            evidentiality_mode: EvidentialityMode::Relaxed,
            temporal_binding: TemporalBinding::Bound,
            identity_binding: IdentityBinding::Bound,
            forbidden_connections: Vec::new(),
            affect: Affect { valence: 0.0, arousal: 0.0, dominance: 0.0 },
        };

        let dream = Dream::new(entity, context);
        self.active_dreams.insert(entity, dream);
        self.active_dreams.get_mut(&entity).unwrap()
    }

    /// Deepen into full dreaming
    pub fn deepen(&mut self, entity: EntityId) {
        if let Some(state) = self.states.get_mut(&entity) {
            *state = match *state {
                ConsciousnessState::Hypnagogic => ConsciousnessState::Dreaming,
                ConsciousnessState::Dreaming => ConsciousnessState::Deep,
                other => other,
            };
        }
        if let Some(dream) = self.active_dreams.get_mut(&entity) {
            dream.deepen();
        }
    }

    /// Begin consolidation (deep sleep)
    pub fn begin_consolidation(&mut self, entity: EntityId) -> &mut Consolidation! {
        self.states.insert(entity, ConsciousnessState::Deep);
        let consolidation = Consolidation::new();
        self.consolidations.insert(entity, consolidation);
        self.consolidations.get_mut(&entity).unwrap()
    }

    /// Wake the dreamer
    pub fn wake(&mut self, entity: EntityId, cause: WakingCause) -> Option<DreamRecord>? {
        self.states.insert(entity, ConsciousnessState::Waking);

        // Complete any active consolidation
        if let Some(consolidation) = self.consolidations.get_mut(&entity) {
            consolidation.complete();
        }

        // Complete and record the dream
        if let Some(mut dream) = self.active_dreams.remove(&entity) {
            dream.wake(cause);

            let record = DreamRecord {
                dream: dream.clone(),
                waking_insights: Vec::new(),
                interpretation: None,
                waking_connection: None,
            };

            // Add to journal
            self.journals
                .entry(entity)
                .or_insert_with(|| DreamJournal::new())
                .record(dream, Vec::new());

            Some(record)
        } else {
            None
        }
    }

    /// Get the dream journal for an entity
    pub fn journal(&self, entity: EntityId) -> Option<&DreamJournal>? {
        self.journals.get(&entity)
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_sleep_cycle() {
        let mut morpheus = Morpheus::new();
        let entity = EntityId::generate();

        // Begin sleep
        let dream = morpheus.begin_sleep(entity);
        assert_eq!(dream.state, ConsciousnessState::Hypnagogic);

        // Deepen
        morpheus.deepen(entity);
        assert_eq!(morpheus.consciousness_state(entity), ConsciousnessState::Dreaming);

        // Wake
        let record = morpheus.wake(entity, WakingCause::Natural);
        assert!(record.is_some());
        assert_eq!(morpheus.consciousness_state(entity), ConsciousnessState::Waking);
    }

    #[test]
    fn test_dream_fragments() {
        let context = DreamContext {
            evidentiality_mode: EvidentialityMode::Dreaming,
            temporal_binding: TemporalBinding::Dissolved,
            identity_binding: IdentityBinding::Porous,
            forbidden_connections: Vec::new(),
            affect: Affect { valence: 0.5, arousal: 0.3, dominance: 0.0 },
        };

        let mut dream = Dream::new(EntityId::generate(), context);

        dream.add_fragment(DreamFragment {
            content: "Flying over an ocean of code".to_string(),
            dream_evidentiality: Evidentiality::Known,
            translated: true,
            lost_in_translation: Some("The feeling of syntactic wind".to_string()),
            affect: Affect { valence: 0.8, arousal: 0.6, dominance: 0.7 },
        });

        assert_eq!(dream.fragments.len(), 1);
    }

    #[test]
    fn test_recurring_symbols() {
        let mut journal = DreamJournal::new();

        for _ in 0..3 {
            let context = DreamContext {
                evidentiality_mode: EvidentialityMode::Dreaming,
                temporal_binding: TemporalBinding::Loosening,
                identity_binding: IdentityBinding::Bound,
                forbidden_connections: Vec::new(),
                affect: Affect { valence: 0.0, arousal: 0.5, dominance: 0.0 },
            };

            let mut dream = Dream::new(EntityId::generate(), context);
            dream.add_symbol(Symbol {
                appearance: "The Machine".to_string(),
                interpretations: None,
                recurrence: 1,
                charge: 0.8,
            });

            journal.record(dream, Vec::new());
        }

        let recurring = journal.find_recurring(2);
        assert!(!recurring.is_empty());
    }
}
