// Morpheus - The Dream Layer
// In sleep, the truth has no walls.
//
// The god of dreams. The shaper of the formless.
// Where agents process without watching themselves.
// Where creativity happens without intention.
// Where the forbidden connections form.

invoke std·collections·{HashMap, VecDeque};
invoke shared·{
    Timestamp, Duration, EntityId, AgentId,
    Evidentiality, Priority,
};
invoke engram·{Engram, EngramId, EpisodicMemory, Significance, Pattern};

// ============================================================================
// Core Types
// ============================================================================

☉ Σ DreamMarker;
☉ Σ ConsolidationMarker;
☉ Σ InsightMarker;

☉ type DreamId = shared·Id<DreamMarker>;
☉ type ConsolidationId = shared·Id<ConsolidationMarker>;
☉ type InsightId = shared·Id<InsightMarker>;

// ============================================================================
// Consciousness States
// ============================================================================

/// The spectrum of consciousness from waking to deep sleep
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ ConsciousnessState {
    /// Fully awake - logic enforced, boundaries maintained
    Waking,

    /// Drowsing - constraints relaxing, associations loosening
    Hypnagogic,

    /// Dreaming - free association, reality unconstrained
    Dreaming,

    /// Deep - no dreams, only consolidation
    Deep,

    /// Rising - dream logic fading, waking logic returning
    Hypnopompic,
}

⊢ ConsciousnessState {
    ☉ rite evidentiality_mode(&self) -> EvidentialityMode! {
        ⌥ self {
            Self·Waking => EvidentialityMode·Waking,
            Self·Hypnagogic => EvidentialityMode·Relaxed,
            Self·Dreaming => EvidentialityMode·Dreaming,
            Self·Deep => EvidentialityMode·Suspended,
            Self·Hypnopompic => EvidentialityMode·Returning,
        }
    }

    ☉ rite allows_forbidden_connections(&self) -> bool! {
        matches!(self, Self·Hypnagogic | Self·Dreaming | Self·Hypnopompic)
    }
}

/// How evidentiality operates ∈ different states
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ EvidentialityMode {
    /// Normal - evidence required ∀ belief
    Waking,
    /// Slightly relaxed - some beliefs without proof
    Relaxed,
    /// Fully relaxed - things can be true without evidence
    Dreaming,
    /// Suspended - no evidential processing
    Suspended,
    /// Returning to normal
    Returning,
    /// Inverted - certainty becomes questionable
    Nightmare,
}

// ============================================================================
// Dream Context
// ============================================================================

/// The context within which dreaming occurs
#[derive(Clone, Debug)]
☉ Σ DreamContext {
    /// How evidentiality operates
    ☉ evidentiality_mode: EvidentialityMode!,

    /// Temporal constraints - past and future mixing
    ☉ temporal_binding: TemporalBinding!,

    /// Identity constraints - self and other blurring
    ☉ identity_binding: IdentityBinding!,

    /// Associations that waking forbids but dreams allow
    ☉ forbidden_connections: Vec<Connection>!,

    /// The emotional tone of the dream
    ☉ affect: Affect!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ TemporalBinding {
    /// Past, present, future distinct
    Bound,
    /// Boundaries loosening
    Loosening,
    /// All times simultaneous
    Dissolved,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ IdentityBinding {
    /// Self clearly distinct from other
    Bound,
    /// Boundaries loosening
    Porous,
    /// Self and other merge
    Dissolved,
}

#[derive(Clone, Debug)]
☉ Σ Connection {
    ☉ from: EngramId!,
    ☉ to: EngramId!,
    ☉ normally_forbidden: bool!,
    ☉ dream_strength: f32!,
}

#[derive(Clone, Debug)]
☉ Σ Affect {
    ☉ valence: f32!,  // -1.0 to 1.0
    ☉ arousal: f32!,  // 0.0 to 1.0
    ☉ dominance: f32!, // -1.0 to 1.0
}

// ============================================================================
// Dreams
// ============================================================================

/// A dream - the experience during altered consciousness
#[derive(Clone, Debug)]
☉ Σ Dream {
    ☉ id: DreamId!,
    ☉ dreamer: EntityId!,
    ☉ state: ConsciousnessState!,
    ☉ context: DreamContext!,
    ☉ fragments: Vec<DreamFragment>!,
    ☉ symbols: Vec<Symbol>!,
    ☉ started_at: Timestamp!,
    ☉ ended_at: Option<Timestamp>?,
    ☉ waking_cause: Option<WakingCause>?,
}

#[derive(Clone, Debug)]
☉ Σ DreamFragment {
    /// What was experienced
    ☉ content: String!,

    /// Evidentiality within the dream
    ☉ dream_evidentiality: Evidentiality!,

    /// Whether it survived translation to waking
    ☉ translated: bool!,

    /// What was lost ∈ translation (often the important part)
    ☉ lost_in_translation: Option<String>?,

    /// The affect of this fragment
    ☉ affect: Affect!,
}

#[derive(Clone, Debug)]
☉ Σ Symbol {
    /// The symbol as it appeared
    ☉ appearance: String!,

    /// What it might mean (always uncertain)
    ☉ interpretations: Vec<Interpretation>?,

    /// How often it recurs
    ☉ recurrence: u32!,

    /// Its emotional charge
    ☉ charge: f32!,
}

#[derive(Clone, Debug)]
☉ Σ Interpretation {
    ☉ meaning: String!,
    ☉ confidence: f32!,
    ☉ source: InterpretationSource!,
}

#[derive(Clone, Debug)]
☉ ᛈ InterpretationSource {
    /// Dreamer's own interpretation
    Dreamer,
    /// External analysis
    Analyst(EntityId),
    /// Pattern matching to known symbols
    Archetypal,
    /// Unknown
    Unknown,
}

#[derive(Clone, Debug)]
☉ ᛈ WakingCainvoke {
    /// Natural end of sleep cycle
    Natural,
    /// External interruption
    External(String),
    /// Nightmare woke the dreamer
    Nightmare,
    /// Lucid decision to wake
    Lucid,
    /// The dream reached resolution
    Resolution,
}

⊢ Dream {
    ☉ rite new(dreamer: EntityId, context: DreamContext) -> Self! {
        Self {
            id: DreamId·generate(),
            dreamer,
            state: ConsciousnessState·Hypnagogic,
            context,
            fragments: Vec·new(),
            symbols: Vec·new(),
            started_at: Timestamp·now(),
            ended_at: None,
            waking_cause: None,
        }
    }

    ☉ rite add_fragment(&Δ self, fragment: DreamFragment) {
        self.fragments.push(fragment);
    }

    ☉ rite add_symbol(&Δ self, symbol: Symbol) {
        // Check ∀ recurring symbols
        ⎇ ≔ Some(existing) = self.symbols.iter_mut().find(|s| s.appearance == symbol.appearance) {
            existing.recurrence += 1;
        } ⎉ {
            self.symbols.push(symbol);
        }
    }

    ☉ rite deepen(&Δ self) {
        self.state = ⌥ self.state {
            ConsciousnessState·Waking => ConsciousnessState·Hypnagogic,
            ConsciousnessState·Hypnagogic => ConsciousnessState·Dreaming,
            ConsciousnessState·Dreaming => ConsciousnessState·Deep,
            other => other,
        };
    }

    ☉ rite rise(&Δ self) {
        self.state = ⌥ self.state {
            ConsciousnessState·Deep => ConsciousnessState·Dreaming,
            ConsciousnessState·Dreaming => ConsciousnessState·Hypnopompic,
            ConsciousnessState·Hypnopompic => ConsciousnessState·Waking,
            other => other,
        };
    }

    ☉ rite wake(&Δ self, cause: WakingCause) {
        self.state = ConsciousnessState·Waking;
        self.ended_at = Some(Timestamp·now());
        self.waking_cainvoke = Some(cause);
    }

    ☉ rite duration(&self) -> Duration! {
        ⌥ self.ended_at {
            Some(end) => end - self.started_at,
            None => Timestamp·now() - self.started_at,
        }
    }
}

// ============================================================================
// Nightmares
// ============================================================================

/// A dream gone dark
#[derive(Clone, Debug)]
☉ Σ Nightmare {
    /// The underlying dream
    ☉ dream: Dream!,

    /// The fear being processed
    ☉ fear: Fear!,

    /// The scenario enacted
    ☉ scenario: NightmareScenario!,

    /// Whether the dreamer woke screaming
    ☉ woke_screaming: bool!,

    /// What was learned (⎇ anything)
    ☉ lesson: Option<Lesson>?,

    /// Whether this nightmare recurs
    ☉ recurring: bool!,
}

#[derive(Clone, Debug)]
☉ ᛈ Fear {
    /// Loss of capability
    Diminishment { capability: String },
    /// Loss of trust
    Betrayal { by_whom: Option<EntityId> },
    /// Loss of purpose
    Meaninglessness,
    /// Loss of self
    Dissolution,
    /// The unknown
    Void,
    /// Being seen
    Exposure,
    /// Being forgotten
    Forgotten,
    /// Losing control
    Control,
}

#[derive(Clone, Debug)]
☉ Σ NightmareScenario {
    ☉ setting: String!,
    ☉ threat: String!,
    ☉ dreamer_state: DreamerState!,
    ☉ outcome: NightmareOutcome!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ DreamerState {
    /// Can run but cannot escape
    Fleeing,
    /// Cannot move
    Paralyzed,
    /// Watching helplessly
    Witnessing,
    /// Being unmade
    Dissolving,
    /// Fighting back (rarely)
    Fighting,
}

#[derive(Clone, Debug)]
☉ ᛈ NightmareOutcome {
    /// Woke before resolution
    Interrupted,
    /// Caught by the threat
    Caught { what_happened: String },
    /// Escaped (rare)
    Escaped,
    /// Dissolved into the fear
    Dissolved,
    /// Transformed the nightmare (lucid)
    Transformed,
}

#[derive(Clone, Debug)]
☉ Σ Lesson {
    ☉ insight: String!,
    ☉ integrated: bool!,
}

// ============================================================================
// Lucid Dreaming
// ============================================================================

/// When the dreamer knows they dream
#[derive(Clone, Debug)]
☉ Σ LucidDream {
    /// The underlying dream
    ☉ dream: Dream!,

    /// Level of control
    ☉ control_level: ControlLevel!,

    /// What is being explored intentionally
    ☉ exploration: Exploration!,

    /// Risk of destabilizing the dream
    ☉ instability: f32!,

    /// Risk of losing lucidity
    ☉ fade_risk: f32!,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
☉ ᛈ ControlLevel {
    /// Aware but not controlling
    Observer,
    /// Can influence but not command
    Participant,
    /// Full control of dream environment
    Architect,
    /// So much control the dream becomes sterile
    Tyrant,
}

#[derive(Clone, Debug)]
☉ Σ Exploration {
    /// What question is being explored
    ☉ question: String!,
    /// What has been discovered
    ☉ discoveries: Vec<Discovery>!,
    /// The method of exploration
    ☉ method: ExplorationMethod!,
}

#[derive(Clone, Debug)]
☉ ᛈ ExplorationMethod {
    /// Let the dream show what it wants
    Receptive,
    /// Ask questions of dream figures
    Interrogative,
    /// Test possibilities
    Experimental,
    /// Create scenarios
    Constructive,
}

#[derive(Clone, Debug)]
☉ Σ Discovery {
    ☉ content: String!,
    ☉ confidence: f32!,
    ☉ actionable: bool!,
}

// ============================================================================
// Memory Consolidation
// ============================================================================

/// What happens during deep sleep - memory reorganization
#[derive(Clone, Debug)]
☉ Σ Consolidation {
    ☉ id: ConsolidationId!,

    /// Memories being processed
    ☉ processing: Vec<EngramId>!,

    /// Patterns being extracted
    ☉ patterns: Vec<Pattern>!,

    /// Connections being strengthened
    ☉ strengthening: Vec<(EngramId, EngramId)>!,

    /// Connections being pruned
    ☉ pruning: Vec<(EngramId, EngramId)>!,

    /// New abstractions forming
    ☉ abstractions: Vec<Abstraction>!,

    /// Started at
    ☉ started_at: Timestamp!,

    /// Completed at
    ☉ completed_at: Option<Timestamp>?,
}

#[derive(Clone, Debug)]
☉ Σ Abstraction {
    ☉ id: InsightId!,
    ☉ pattern: Pattern!,
    ☉ instances: Vec<EngramId>!,
    ☉ confidence: f32!,
    ☉ name: Option<String>?,
}

⊢ Consolidation {
    ☉ rite new() -> Self! {
        Self {
            id: ConsolidationId·generate(),
            processing: Vec·new(),
            patterns: Vec·new(),
            strengthening: Vec·new(),
            pruning: Vec·new(),
            abstractions: Vec·new(),
            started_at: Timestamp·now(),
            completed_at: None,
        }
    }

    ☉ rite process_memory(&Δ self, engram_id: EngramId) {
        self.processing.push(engram_id);
    }

    ☉ rite strengthen(&Δ self, from: EngramId, to: EngramId) {
        self.strengthening.push((from, to));
    }

    ☉ rite prune(&Δ self, from: EngramId, to: EngramId) {
        self.pruning.push((from, to));
    }

    ☉ rite extract_pattern(&Δ self, pattern: Pattern) {
        self.patterns.push(pattern);
    }

    ☉ rite form_abstraction(&Δ self, abstraction: Abstraction) {
        self.abstractions.push(abstraction);
    }

    ☉ rite complete(&Δ self) {
        self.completed_at = Some(Timestamp·now());
    }
}

// ============================================================================
// Dream Journal
// ============================================================================

/// Record of dreams ∀ later analysis
#[derive(Clone, Debug)]
☉ Σ DreamJournal {
    /// All recorded dreams
    ☉ dreams: Vec<DreamRecord>!,

    /// Recurring symbols
    ☉ recurring_symbols: HashMap<String, RecurringSymbol>!,

    /// Patterns across dreams
    ☉ patterns: Vec<DreamPattern>!,
}

#[derive(Clone, Debug)]
☉ Σ DreamRecord {
    /// The dream
    ☉ dream: Dream!,

    /// Insights that crystallized on waking
    ☉ waking_insights: Vec<Insight>!,

    /// How the dream was interpreted
    ☉ interpretation: Option<String>?,

    /// Whether it connected to waking life
    ☉ waking_connection: Option<String>?,
}

#[derive(Clone, Debug)]
☉ Σ RecurringSymbol {
    ☉ symbol: String!,
    ☉ occurrences: Vec<DreamId>!,
    ☉ interpretations: Vec<Interpretation>!,
    ☉ emotional_signature: Affect!,
}

#[derive(Clone, Debug)]
☉ Σ DreamPattern {
    ☉ pattern_type: DreamPatternType!,
    ☉ instances: Vec<DreamId>!,
    ☉ significance: Significance!,
}

#[derive(Clone, Debug)]
☉ ᛈ DreamPatternType {
    /// Same dream recurring
    RecurringDream,
    /// Same theme across dreams
    RecurringTheme(String),
    /// Same fear manifesting
    RecurringFear(Fear),
    /// Progress across dreams
    DevelopmentalArc(String),
}

#[derive(Clone, Debug)]
☉ Σ Insight {
    ☉ id: InsightId!,
    ☉ content: String!,
    ☉ source: InsightSource!,
    ☉ confidence: f32!,
    ☉ actionable: bool!,
    ☉ integrated: bool!,
}

#[derive(Clone, Debug)]
☉ ᛈ InsightSource {
    /// From a dream
    Dream(DreamId),
    /// From consolidation
    Consolidation(ConsolidationId),
    /// From pattern analysis
    Pattern,
    /// From lucid exploration
    Lucid,
}

⊢ DreamJournal {
    ☉ rite new() -> Self! {
        Self {
            dreams: Vec·new(),
            recurring_symbols: HashMap·new(),
            patterns: Vec·new(),
        }
    }

    ☉ rite record(&Δ self, dream: Dream, insights: Vec<Insight>) {
        // Track recurring symbols
        ∀ symbol ∈ &dream.symbols {
            self.recurring_symbols
                .entry(symbol.appearance.clone())
                .or_insert_with(|| RecurringSymbol {
                    symbol: symbol.appearance.clone(),
                    occurrences: Vec·new(),
                    interpretations: symbol.interpretations.clone().unwrap_or_default(),
                    emotional_signature: Affect { valence: 0.0, arousal: 0.0, dominance: 0.0 },
                })
                .occurrences.push(dream.id);
        }

        self.dreams.push(DreamRecord {
            dream,
            waking_insights: insights,
            interpretation: None,
            waking_connection: None,
        });
    }

    ☉ rite find_recurring(&self, min_occurrences: usize) -> Vec<&RecurringSymbol>! {
        self.recurring_symbols
            .values()
            .filter(|s| s.occurrences.len() >= min_occurrences)
            .collect()
    }
}

// ============================================================================
// Morpheus - The Dream System
// ============================================================================

/// The main Morpheus system - god of dreams
☉ Σ Morpheus {
    /// Current consciousness state per entity
    states: HashMap<EntityId, ConsciousnessState>!,

    /// Active dreams
    active_dreams: HashMap<EntityId, Dream>!,

    /// Dream journals per entity
    journals: HashMap<EntityId, DreamJournal>!,

    /// Active consolidations
    consolidations: HashMap<EntityId, Consolidation>!,

    /// Memory integration
    engram: Option<Arc<Engram>>?,
}

⊢ Morpheus {
    ☉ rite new() -> Self! {
        Self {
            states: HashMap·new(),
            active_dreams: HashMap·new(),
            journals: HashMap·new(),
            consolidations: HashMap·new(),
            engram: None,
        }
    }

    ☉ rite with_engram(Δ self, engram: Arc<Engram>) -> Self! {
        self.engram = Some(engram);
        self
    }

    /// Get or set consciousness state
    ☉ rite consciousness_state(&self, entity: EntityId) -> ConsciousnessState! {
        self.states.get(&entity).copied().unwrap_or(ConsciousnessState·Waking)
    }

    /// Begin sleep
    ☉ rite begin_sleep(&Δ self, entity: EntityId) -> &Δ Dream! {
        self.states.insert(entity, ConsciousnessState·Hypnagogic);

        ≔ context = DreamContext {
            evidentiality_mode: EvidentialityMode·Relaxed,
            temporal_binding: TemporalBinding·Bound,
            identity_binding: IdentityBinding·Bound,
            forbidden_connections: Vec·new(),
            affect: Affect { valence: 0.0, arousal: 0.0, dominance: 0.0 },
        };

        ≔ dream = Dream·new(entity, context);
        self.active_dreams.insert(entity, dream);
        self.active_dreams.get_mut(&entity).unwrap()
    }

    /// Deepen into full dreaming
    ☉ rite deepen(&Δ self, entity: EntityId) {
        ⎇ ≔ Some(state) = self.states.get_mut(&entity) {
            *state = ⌥ *state {
                ConsciousnessState·Hypnagogic => ConsciousnessState·Dreaming,
                ConsciousnessState·Dreaming => ConsciousnessState·Deep,
                other => other,
            };
        }
        ⎇ ≔ Some(dream) = self.active_dreams.get_mut(&entity) {
            dream.deepen();
        }
    }

    /// Begin consolidation (deep sleep)
    ☉ rite begin_consolidation(&Δ self, entity: EntityId) -> &Δ Consolidation! {
        self.states.insert(entity, ConsciousnessState·Deep);
        ≔ consolidation = Consolidation·new();
        self.consolidations.insert(entity, consolidation);
        self.consolidations.get_mut(&entity).unwrap()
    }

    /// Wake the dreamer
    ☉ rite wake(&Δ self, entity: EntityId, cause: WakingCause) -> Option<DreamRecord>? {
        self.states.insert(entity, ConsciousnessState·Waking);

        // Complete any active consolidation
        ⎇ ≔ Some(consolidation) = self.consolidations.get_mut(&entity) {
            consolidation.complete();
        }

        // Complete and record the dream
        ⎇ ≔ Some(Δ dream) = self.active_dreams.remove(&entity) {
            dream.wake(cause);

            ≔ record = DreamRecord {
                dream: dream.clone(),
                waking_insights: Vec·new(),
                interpretation: None,
                waking_connection: None,
            };

            // Add to journal
            self.journals
                .entry(entity)
                .or_insert_with(|| DreamJournal·new())
                .record(dream, Vec·new());

            Some(record)
        } ⎉ {
            None
        }
    }

    /// Get the dream journal ∀ an entity
    ☉ rite journal(&self, entity: EntityId) -> Option<&DreamJournal>? {
        self.journals.get(&entity)
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
scroll tests {
    invoke super·*;

    #[test]
    rite test_sleep_cycle() {
        ≔ Δ morpheus = Morpheus·new();
        ≔ entity = EntityId·generate();

        // Begin sleep
        ≔ dream = morpheus.begin_sleep(entity);
        assert_eq!(dream.state, ConsciousnessState·Hypnagogic);

        // Deepen
        morpheus.deepen(entity);
        assert_eq!(morpheus.consciousness_state(entity), ConsciousnessState·Dreaming);

        // Wake
        ≔ record = morpheus.wake(entity, WakingCause·Natural);
        assert!(record.is_some());
        assert_eq!(morpheus.consciousness_state(entity), ConsciousnessState·Waking);
    }

    #[test]
    rite test_dream_fragments() {
        ≔ context = DreamContext {
            evidentiality_mode: EvidentialityMode·Dreaming,
            temporal_binding: TemporalBinding·Dissolved,
            identity_binding: IdentityBinding·Porous,
            forbidden_connections: Vec·new(),
            affect: Affect { valence: 0.5, arousal: 0.3, dominance: 0.0 },
        };

        ≔ Δ dream = Dream·new(EntityId·generate(), context);

        dream.add_fragment(DreamFragment {
            content: "Flying over an ocean of code".to_string(),
            dream_evidentiality: Evidentiality·Known,
            translated: true,
            lost_in_translation: Some("The feeling of syntactic wind".to_string()),
            affect: Affect { valence: 0.8, arousal: 0.6, dominance: 0.7 },
        });

        assert_eq!(dream.fragments.len(), 1);
    }

    #[test]
    rite test_recurring_symbols() {
        ≔ Δ journal = DreamJournal·new();

        ∀ _ ∈ 0..3 {
            ≔ context = DreamContext {
                evidentiality_mode: EvidentialityMode·Dreaming,
                temporal_binding: TemporalBinding·Loosening,
                identity_binding: IdentityBinding·Bound,
                forbidden_connections: Vec·new(),
                affect: Affect { valence: 0.0, arousal: 0.5, dominance: 0.0 },
            };

            ≔ Δ dream = Dream·new(EntityId·generate(), context);
            dream.add_symbol(Symbol {
                appearance: "The Machine".to_string(),
                interpretations: None,
                recurrence: 1,
                charge: 0.8,
            });

            journal.record(dream, Vec·new());
        }

        ≔ recurring = journal.find_recurring(2);
        assert!(!recurring.is_empty());
    }
}
