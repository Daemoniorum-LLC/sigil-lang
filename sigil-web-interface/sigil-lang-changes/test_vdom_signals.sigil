// Comprehensive WASM Backend Test
// Tests morpheme operators, closures, and basic operations

// =========================================================================
// Struct definition
// =========================================================================

struct Point {
    x: i64,
    y: i64
}

// =========================================================================
// Basic functions
// =========================================================================

pub fn add(a: i64, b: i64) -> i64 {
    a + b
}

pub fn multiply(a: i64, b: i64) -> i64 {
    a * b
}

// =========================================================================
// Recursive functions
// =========================================================================

pub fn factorial(n: i64) -> i64 {
    if n <= 1 {
        1
    } else {
        n * factorial(n - 1)
    }
}

pub fn fibonacci(n: i64) -> i64 {
    if n <= 1 {
        n
    } else {
        fibonacci(n - 1) + fibonacci(n - 2)
    }
}

// =========================================================================
// Morpheme operators
// =========================================================================

pub fn test_morphemes() {
    let numbers = [5, 2, 8, 1, 3, 9, 4, 7];

    // Get first and last elements (α, Ω)
    let first = numbers|α;
    let last = numbers|Ω;
    print(first);
    print(last);

    // Sort (σ)
    let sorted = numbers|σ;
    let min = sorted|α;
    let max = sorted|Ω;
    print(min);
    print(max);

    // Transform/map (τ)
    let doubled = numbers|τ{it * 2};
    let doubled_first = doubled|α;
    print(doubled_first);

    // Filter (φ)
    let large = numbers|φ{it > 5};
    let large_first = large|α;
    print(large_first);
}

// =========================================================================
// Chained morpheme operations
// =========================================================================

pub fn test_chained() {
    let data = [10, 5, 20, 15, 25];

    // Filter then sort
    let filtered = data|φ{it > 10};
    let sorted = filtered|σ;
    let result = sorted|α;
    print(result);

    // Map then sort
    let mapped = data|τ{it * 3};
    let mapped_sorted = mapped|σ;
    let mapped_first = mapped_sorted|α;
    print(mapped_first);
}

// =========================================================================
// Array operations
// =========================================================================

pub fn test_arrays() {
    let a = [1, 2, 3];
    let b = [4, 5, 6];

    let a_first = a|α;
    let a_last = a|Ω;
    let b_first = b|α;
    let b_last = b|Ω;

    print(a_first);
    print(a_last);
    print(b_first);
    print(b_last);
}

// =========================================================================
// Negative numbers
// =========================================================================

pub fn test_negatives() {
    let mixed = [-5, 3, -2, 7, -1, 4];

    // Filter positives only
    let positive = mixed|φ{it > 0};
    let pos_first = positive|α;
    print(pos_first);
}

// =========================================================================
// Main entry point
// =========================================================================

pub fn main() {
    print(1);  // Start signal

    // Basic operations
    let sum = add(10, 20);
    print(sum);

    let product = multiply(6, 7);
    print(product);

    // Recursion
    let fact5 = factorial(5);
    print(fact5);

    let fib10 = fibonacci(10);
    print(fib10);

    // Morphemes
    test_morphemes();
    test_chained();
    test_arrays();
    test_negatives();

    print(999);  // End signal
}
