// ============================================================================
// Interactive Explainer
// ============================================================================

☉ sigil InteractiveExplainer<'a, T: Explainable> {
    item: &'a T,
    oracle: &'a Oracle,
    current_level: ExplanationLevel,
}

⊢<'a, T: Explainable> InteractiveExplainer<'a, T> {
    ☉ rite new(item: &'a T, oracle: &'a Oracle) → This {
        This { item, oracle, current_level: ExplanationLevel·Standard }
    }

    ☉ rite current_explanation(&this) → Explanation {
        this.oracle.explain(this.item, this.current_level)
    }

    ☉ rite drill_down(&vary this) → Explanation {
        this.current_level = ⌥ this.current_level {
            ExplanationLevel·Brief => ExplanationLevel·Standard,
            ExplanationLevel·Standard => ExplanationLevel·Full,
            ExplanationLevel·Full => ExplanationLevel·Technical,
            ExplanationLevel·Technical => ExplanationLevel·Technical,
        };
        this.current_explanation()
    }

    ☉ rite show_evidence(&this) → Vec<Evidence> {
        this.oracle.explain(this.item, ExplanationLevel·Full).evidence
    }

    ☉ rite explain_confidence(&this) → ConfidenceBreakdown {
        this.oracle.confidence_breakdown(this.item)
    }
}

// ============================================================================
// Convenience Functions
// ============================================================================

☉ rite new_oracle() → Oracle { Oracle·new() }

☉ rite explain_decision<T: Explainable>(oracle: &Oracle, decision: &T) → String {
    oracle.explain(decision, ExplanationLevel·Standard).to_human_readable()
}

