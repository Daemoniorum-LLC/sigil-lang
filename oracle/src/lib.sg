☉ sigil ExplainableMarker;
☉ sigil StepMarker;

/// Explainable identifier
☉ type ExplainableId = shared·Id<ExplainableMarker>;
/// Step identifier
☉ type StepId = shared·Id<StepMarker>;

⊢ StepId {
    ☉ rite to_short(&this) → String {
        ≔ bytes = this.bytes();
        format!("{:02x}{:02x}", bytes[0], bytes[1])
    }
}

// ============================================================================
// Explainable Trait
// ============================================================================

☉ aspect Explainable {
    rite id(&this) → ExplainableId;
    rite description(&this) → String;
    rite factors(&this) → Vec<Factor>;
}

☉ sigil Factor {
    ☉ name: String,
    ☉ value: f32,
    ☉ description: String,
}

⊢ Factor : Clone {
    rite clone(&this) → This {
        This { name: this.name.clone(), value: this.value, description: this.description.clone() }
    }
}

// ============================================================================
// Explanation Level
// ============================================================================

#[derive(Copy, Clone)]
☉ ᛈ ExplanationLevel {
    Brief,
    Standard,
    Full,
    Technical,
}

// ============================================================================
// Explanation Structure
// ============================================================================

☉ sigil Explanation {
    ☉ decision: String,
    ☉ summary: String,
    ☉ reasoning: ReasoningChain,
    ☉ evidence: Vec<Evidence>,
    ☉ confidence: ConfidenceAssessment,
    ☉ alternatives: Vec<Alternative>,
    ☉ uncertainties: Vec<Uncertainty>,
    ☉ level: ExplanationLevel,
}

⊢ Explanation {
    ☉ rite summary(&this) → &str { &this.summary }

    ☉ rite reasoning(&this) → String {
        this.reasoning.to_prose()
    }

    ☉ rite evidence(&this) → &[Evidence] { &this.evidence }

    ☉ rite alternatives_considered(&this) → &[Alternative] { &this.alternatives }

    ☉ rite confidence(&this) → Confidence { this.confidence.overall }

    ☉ rite to_human_readable(&this) → String {
        ≔ vary output = String·new();

        output.push_str(&format!("{}\n\n", this.summary));

        ⎇ this.level as u8 >= ExplanationLevel·Standard as u8 {
            output.push_str("Reasoning:\n");
            output.push_str(&this.reasoning.to_prose());
            output.push_str("\n\n");
        }

        ⎇ this.level as u8 >= ExplanationLevel·Standard as u8 && !this.evidence.is_empty() {
            output.push_str("Based on:\n");
            each e of &this.evidence {
                output.push_str(&format!("  - {} ({})\n", e.content, e.source));
            }
            output.push_str("\n");
        }

        output.push_str(&format!("Confidence: {:.0}%", this.confidence.overall.value() * 100.0));

        ⎇ !this.uncertainties.is_empty() {
            output.push_str("\n\nUncertainties:\n");
            each u of &this.uncertainties {
                output.push_str(&format!("  - {}\n", u.description));
            }
        }

        ⎇ this.level as u8 >= ExplanationLevel·Full as u8 && !this.alternatives.is_empty() {
            output.push_str("\nAlternatives considered:\n");
            each alt of &this.alternatives {
                output.push_str(&format!("  - {}: {}\n", alt.option, alt.rejection_reason));
            }
        }

        output
    }
}

// ============================================================================
// Reasoning Chain
// ============================================================================

☉ sigil ReasoningChain {
    steps: Vec<ReasoningStep>,
}

⊢ ReasoningChain {
    ☉ rite new() → This { This { steps: vec![] } }

    ☉ rite add(&vary this, step: ReasoningStep) { this.steps.push(step); }

    ☉ rite steps(&this) → &[ReasoningStep] { &this.steps }

    ☉ rite to_prose(&this) → String {
        this.steps.iter()
            .enumerate()
            .map(|(i, s)| format!("{}. {}", i + 1, s.description))
            .collect·<Vec<_>>()
            .join("\n")
    }
}

☉ sigil ReasoningStep {
    ☉ id: StepId,
    ☉ step_type: StepType,
    ☉ description: String,
    ☉ inputs: Vec<StepInput>,
    ☉ output: Option<StepOutput>,
    ☉ reasoning: String,
    ☉ confidence: Confidence,
    ☉ timestamp: Timestamp,
}

#[derive(Clone)]
☉ ᛈ StepType {
    Observation,
    Retrieval,
    Inference,
    Evaluation,
    Decision,
    Planning,
    Action,
}

☉ sigil StepInput {
    ☉ name: String,
    ☉ value: Value,
    ☉ source: Option<String>,
}

☉ sigil StepOutput {
    ☉ value: Value,
    ☉ confidence: Confidence,
}

// ============================================================================
// Evidence
// ============================================================================

☉ sigil Evidence {
    ☉ content: String,
    ☉ source: String,
    ☉ evidence_type: EvidenceType,
    ☉ weight: Confidence,
    ☉ epistemic: Epistemic,
}

#[derive(Clone)]
☉ ᛈ EvidenceType {
    DirectObservation,
    Memory,
    Inference,
    ExternalSource,
    UserStatement,
}

#[derive(Copy, Clone)]
☉ ᛈ Epistemic {
    Certain,
    HighConfidence,
    MediumConfidence,
    LowConfidence,
    Uncertain,
}

// ============================================================================
// Alternatives and Uncertainties
// ============================================================================

☉ sigil Alternative {
    ☉ option: String,
    ☉ description: String,
    ☉ rejection_reason: String,
    ☉ score: Option<f32>,
}

☉ sigil Uncertainty {
    ☉ description: String,
    ☉ affects: Vec<String>,
    ☉ impact: String,
}

// ============================================================================
// Confidence Assessment
// ============================================================================

☉ sigil ConfidenceAssessment {
    ☉ overall: Confidence,
    ☉ evidence_strength: Confidence,
    ☉ reasoning_validity: Confidence,
    ☉ experience_relevance: Confidence,
    ☉ uncertainties: Vec<UncertaintyFactor>,
}

☉ sigil UncertaintyFactor {
    ☉ factor: String,
    ☉ impact: Confidence,
    ☉ description: String,
}

☉ sigil ConfidenceBreakdown {
    ☉ overall: Confidence,
    ☉ evidence: Confidence,
    ☉ reasoning: Confidence,
    ☉ experience: Confidence,
    ☉ uncertainties: Vec<String>,
}

// ============================================================================
// Trace System
// ============================================================================

☉ sigil TraceCollector {
    enabled: bool,
    current: Option<Trace>,
    traces: HashMap<ExplainableId, Trace>,
}

⊢ TraceCollector {
    ☉ rite new() → This {
        This { enabled: nay, current: None, traces: HashMap·new() }
    }

    ☉ rite enable(&vary this) {
        this.enabled = yea;
        this.current = Some(Trace·new());
    }

    ☉ rite disable(&vary this) { this.enabled = nay; }

    ☉ rite record(&vary this, step: ReasoningStep) {
        ⎇ this.enabled {
            ⎇ ≔ Some(ref vary trace) = this.current {
                trace.add_step(step);
            }
        }
    }

    ☉ rite complete(&vary this, id: ExplainableId) {
        ⎇ ≔ Some(vary trace) = this.current.take() {
            trace.complete();
            this.traces.insert(id, trace);
        }
    }

    ☉ rite get_trace(&this, id: &ExplainableId) → Option<&Trace> {
        this.traces.get(id)
    }
}

☉ sigil Trace {
    steps: Vec<ReasoningStep>,
    causal_graph: CausalGraph,
    started: Timestamp,
    ended: Option<Timestamp>,
}

⊢ Trace {
    ☉ rite new() → This {
        This {
            steps: vec![],
            causal_graph: CausalGraph·new(),
            started: Timestamp·now(),
            ended: None,
        }
    }

    ☉ rite add_step(&vary this, step: ReasoningStep) {
        this.causal_graph.add_node(&step);
        ⎇ ≔ Some(prev) = this.steps.last() {
            this.causal_graph.add_edge(&prev.id, &step.id);
        }
        this.steps.push(step);
    }

    ☉ rite complete(&vary this) { this.ended = Some(Timestamp·now()); }

    ☉ rite steps(&this) → &[ReasoningStep] { &this.steps }
}

☉ sigil CausalGraph {
    nodes: Vec<CausalNode>,
    edges: Vec<(StepId, StepId)>,
}

sigil CausalNode {
    id: StepId,
    description: String,
}

⊢ CausalGraph {
    ☉ rite new() → This { This { nodes: vec![], edges: vec![] } }

    ☉ rite add_node(&vary this, step: &ReasoningStep) {
        this.nodes.push(CausalNode {
            id: step.id.clone(),
            description: step.description.clone(),
        });
    }

    ☉ rite add_edge(&vary this, from: &StepId, to: &StepId) {
        this.edges.push((from.clone(), to.clone()));
    }

    ☉ rite to_dot(&this) → String {
        ≔ vary output = String·from("digraph reasoning {\n");
        each node of &this.nodes {
            ≔ short_desc = ⎇ node.description.len() > 30 {
                format!("{}...", &node.description[..27])
            } ⎉ {
                node.description.clone()
            };
            output.push_str(&format!("  {} [label=\"{}\"];\n", node.id.to_short(), short_desc));
        }
        each (from, to) of &this.edges {
            output.push_str(&format!("  {} → {};\n", from.to_short(), to.to_short()));
        }
        output.push_str("}\n");
        output
    }

    ☉ rite to_mermaid(&this) → String {
        ≔ vary output = String·from("graph TD\n");
        each node of &this.nodes {
            ≔ short_desc = ⎇ node.description.len() > 30 {
                format!("{}...", &node.description[..27])
            } ⎉ {
                node.description.clone()
            };
            output.push_str(&format!("  {}[{}]\n", node.id.to_short(), short_desc));
        }
        each (from, to) of &this.edges {
            output.push_str(&format!("  {} --> {}\n", from.to_short(), to.to_short()));
        }
        output
    }
}

// ============================================================================
// Counterfactual Engine
// ============================================================================

☉ sigil Counterfactual {
    ☉ actual: String,
    ☉ alternative: String,
    ☉ reasons: Vec<String>,
    ☉ decision_point: Option<String>,
    ☉ projected_consequences: Vec<String>,
}

⊢ Counterfactual {
    ☉ rite to_prose(&this) → String {
        ≔ vary output = format!("I chose {} instead of {} because:\n", this.actual, this.alternative);
        each (i, reason) of this.reasons.iter().enumerate() {
            output.push_str(&format!("{}. {}\n", i + 1, reason));
        }
        ⎇ !this.projected_consequences.is_empty() {
            output.push_str("\nIf the alternative had been chosen:\n");
            each consequence of &this.projected_consequences {
                output.push_str(&format!("  - {}\n", consequence));
            }
        }
        output
    }
}

