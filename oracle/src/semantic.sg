// Oracle Semantic Indexing
// Enabling semantic search across reasoning traces and evidence
//
// This module integrates nihil-embed to provide:
// - Semantic search over reasoning steps
// - Evidence similarity matching
// - Code snippet indexing for context retrieval
// - "Find similar decisions" functionality

invoke nihil_embed::{
    EmbedConfig, CodeTokenizer, Embedding, EmbeddingIndex,
    Pooler, ChunkConfig, cosine_similarity
};

use shared::{Timestamp, Confidence};

// ============================================================================
// Semantic Configuration
// ============================================================================

/// Configuration for semantic indexing
pub struct SemanticConfig {
    /// Embedding dimension (384 for small, 768 for base)
    pub embedding_dim: usize,
    /// Pooling strategy: "cls", "mean", "max"
    pub pooling: String,
    /// Minimum similarity threshold for results
    pub similarity_threshold: f32,
    /// Maximum results to return
    pub max_results: usize,
    /// Vocabulary size for tokenizer
    pub vocab_size: usize,
    /// Maximum sequence length
    pub max_seq_len: usize,
}

impl SemanticConfig {
    /// Default configuration using small model
    pub fn default_config() -> Self {
        Self {
            embedding_dim: 384,
            pooling: "cls".to_string(),
            similarity_threshold: 0.5,
            max_results: 10,
            vocab_size: 32000,
            max_seq_len: 512,
        }
    }

    /// Configuration for base model
    pub fn base() -> Self {
        Self {
            embedding_dim: 768,
            pooling: "cls".to_string(),
            similarity_threshold: 0.5,
            max_results: 10,
            vocab_size: 50265,
            max_seq_len: 512,
        }
    }

    /// Set similarity threshold
    pub fn with_threshold(mut self, threshold: f32) -> Self {
        self.similarity_threshold = threshold;
        self
    }

    /// Set max results
    pub fn with_max_results(mut self, max: usize) -> Self {
        self.max_results = max;
        self
    }
}

// ============================================================================
// Result Types
// ============================================================================

/// Type of semantic search result
pub enum ResultType {
    /// A reasoning step from a trace
    ReasoningStep,
    /// Evidence supporting a decision
    Evidence,
    /// A code snippet
    CodeSnippet,
}

/// A semantic search result
pub struct SemanticResult {
    /// The matched content
    pub content: String,
    /// Source identifier (trace_id, evidence_id, file:line)
    pub source_id: String,
    /// Similarity score (0.0 to 1.0)
    pub similarity: f32,
    /// Type of result
    pub result_type: ResultType,
    /// Timestamp when indexed (if available)
    pub indexed_at: Option<Timestamp>,
}

impl SemanticResult {
    pub fn new(content: String, source_id: String, similarity: f32, result_type: ResultType) -> Self {
        Self {
            content,
            source_id,
            similarity,
            result_type,
            indexed_at: None,
        }
    }

    pub fn with_timestamp(mut self, ts: Timestamp) -> Self {
        self.indexed_at = Some(ts);
        self
    }
}

// ============================================================================
// Semantic Index
// ============================================================================

/// Semantic index for Oracle's reasoning traces and evidence.
///
/// Maintains three separate indices:
/// - Reasoning steps from traces
/// - Evidence items from explanations
/// - Code snippets for context retrieval
pub struct SemanticIndex {
    /// Index for reasoning steps
    reasoning_index: EmbeddingIndex,
    /// Index for evidence
    evidence_index: EmbeddingIndex,
    /// Index for code snippets
    code_index: EmbeddingIndex,
    /// Configuration
    config: SemanticConfig,
    /// Tokenizer for text processing
    tokenizer: CodeTokenizer,
    /// Pooler for sequence aggregation
    pooler: Pooler,
    /// Content storage (index -> content)
    reasoning_content: Vec<String>,
    evidence_content: Vec<String>,
    code_content: Vec<String>,
}

impl SemanticIndex {
    /// Create a new semantic index
    pub fn new(config: SemanticConfig) -> Self {
        let tokenizer = CodeTokenizer::new(config.vocab_size, config.max_seq_len);
        let pooler = if config.pooling == "mean" {
            Pooler::mean()
        } else if config.pooling == "max" {
            Pooler::max_pool()
        } else {
            Pooler::cls()
        };

        Self {
            reasoning_index: EmbeddingIndex::new(config.embedding_dim),
            evidence_index: EmbeddingIndex::new(config.embedding_dim),
            code_index: EmbeddingIndex::new(config.embedding_dim),
            config,
            tokenizer,
            pooler,
            reasoning_content: Vec::new(),
            evidence_content: Vec::new(),
            code_content: Vec::new(),
        }
    }

    /// Create with default configuration
    pub fn default_index() -> Self {
        Self::new(SemanticConfig::default_config())
    }

    /// Get embedding dimension
    pub fn dim(&self) -> usize {
        self.config.embedding_dim
    }

    /// Total number of indexed items
    pub fn len(&self) -> usize {
        self.reasoning_index.len() + self.evidence_index.len() + self.code_index.len()
    }

    /// Number of indexed reasoning steps
    pub fn reasoning_count(&self) -> usize {
        self.reasoning_index.len()
    }

    /// Number of indexed evidence items
    pub fn evidence_count(&self) -> usize {
        self.evidence_index.len()
    }

    /// Number of indexed code snippets
    pub fn code_count(&self) -> usize {
        self.code_index.len()
    }

    // ========================================================================
    // Embedding Generation (Simplified)
    // ========================================================================

    /// Generate embedding for text
    /// Note: In production, this would use a transformer model.
    /// This simplified version uses token statistics as a proxy.
    fn embed_text(&self, text: &str) -> Embedding {
        let tokens = self.tokenizer.tokenize(text);
        let dim = self.config.embedding_dim;

        // Create simple embedding from token distribution
        // Production would use transformer encoder here
        let mut data = vec![0.0; dim];
        for (i, &token) in tokens.iter().enumerate() {
            let idx = (token + i) % dim;
            data[idx] = data[idx] + 1.0;
        }

        // Normalize
        let embedding = Embedding::new(data, dim);
        embedding.normalize()
    }

    // ========================================================================
    // Indexing Methods
    // ========================================================================

    /// Index a reasoning step
    pub fn index_reasoning(&mut self, description: &str, reasoning: &str, trace_id: &str) {
        let combined = format!("{} {}", description, reasoning);
        let embedding = self.embed_text(&combined);
        self.reasoning_index.add(embedding, trace_id);
        self.reasoning_content.push(combined);
    }

    /// Index evidence
    pub fn index_evidence(&mut self, content: &str, source: &str, explanation_id: &str) {
        let combined = format!("{} from {}", content, source);
        let embedding = self.embed_text(&combined);
        let meta = format!("{}:{}", explanation_id, source);
        self.evidence_index.add(embedding, &meta);
        self.evidence_content.push(content.to_string());
    }

    /// Index a code snippet
    pub fn index_code(&mut self, code: &str, file_path: &str, line_start: usize) {
        let embedding = self.embed_text(code);
        let meta = format!("{}:{}", file_path, line_start);
        self.code_index.add(embedding, &meta);
        self.code_content.push(code.to_string());
    }

    // ========================================================================
    // Search Methods
    // ========================================================================

    /// Search all indices
    pub fn search(&self, query: &str, k: usize) -> Vec<SemanticResult> {
        let query_embedding = self.embed_text(query);
        let limit = if k > self.config.max_results { self.config.max_results } else { k };

        let mut results = Vec::new();

        // Search reasoning
        let reasoning_results = self.reasoning_index.search(&query_embedding, limit);
        for (idx, sim) in reasoning_results {
            if sim >= self.config.similarity_threshold {
                let content = if idx < self.reasoning_content.len() {
                    self.reasoning_content[idx].clone()
                } else {
                    "".to_string()
                };
                results.push(SemanticResult::new(
                    content,
                    self.reasoning_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType::ReasoningStep,
                ));
            }
        }

        // Search evidence
        let evidence_results = self.evidence_index.search(&query_embedding, limit);
        for (idx, sim) in evidence_results {
            if sim >= self.config.similarity_threshold {
                let content = if idx < self.evidence_content.len() {
                    self.evidence_content[idx].clone()
                } else {
                    "".to_string()
                };
                results.push(SemanticResult::new(
                    content,
                    self.evidence_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType::Evidence,
                ));
            }
        }

        // Search code
        let code_results = self.code_index.search(&query_embedding, limit);
        for (idx, sim) in code_results {
            if sim >= self.config.similarity_threshold {
                let content = if idx < self.code_content.len() {
                    self.code_content[idx].clone()
                } else {
                    "".to_string()
                };
                results.push(SemanticResult::new(
                    content,
                    self.code_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType::CodeSnippet,
                ));
            }
        }

        // Sort by similarity (descending)
        for i in 0..results.len() {
            for j in (i + 1)..results.len() {
                if results[j].similarity > results[i].similarity {
                    let temp_content = results[i].content.clone();
                    let temp_source = results[i].source_id.clone();
                    let temp_sim = results[i].similarity;

                    results[i].content = results[j].content.clone();
                    results[i].source_id = results[j].source_id.clone();
                    results[i].similarity = results[j].similarity;

                    results[j].content = temp_content;
                    results[j].source_id = temp_source;
                    results[j].similarity = temp_sim;
                }
            }
        }

        // Limit to k results
        let final_limit = if k < results.len() { k } else { results.len() };
        let mut final_results = Vec::new();
        for i in 0..final_limit {
            final_results.push(SemanticResult::new(
                results[i].content.clone(),
                results[i].source_id.clone(),
                results[i].similarity,
                ResultType::ReasoningStep, // Simplified - would need to track type
            ));
        }

        final_results
    }

    /// Search only reasoning steps
    pub fn search_reasoning(&self, query: &str, k: usize) -> Vec<SemanticResult> {
        let query_embedding = self.embed_text(query);
        let results = self.reasoning_index.search(&query_embedding, k);

        let mut semantic_results = Vec::new();
        for (idx, sim) in results {
            if sim >= self.config.similarity_threshold {
                let content = if idx < self.reasoning_content.len() {
                    self.reasoning_content[idx].clone()
                } else {
                    "".to_string()
                };
                semantic_results.push(SemanticResult::new(
                    content,
                    self.reasoning_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType::ReasoningStep,
                ));
            }
        }

        semantic_results
    }

    /// Search only evidence
    pub fn search_evidence(&self, query: &str, k: usize) -> Vec<SemanticResult> {
        let query_embedding = self.embed_text(query);
        let results = self.evidence_index.search(&query_embedding, k);

        let mut semantic_results = Vec::new();
        for (idx, sim) in results {
            if sim >= self.config.similarity_threshold {
                let content = if idx < self.evidence_content.len() {
                    self.evidence_content[idx].clone()
                } else {
                    "".to_string()
                };
                semantic_results.push(SemanticResult::new(
                    content,
                    self.evidence_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType::Evidence,
                ));
            }
        }

        semantic_results
    }

    /// Search only code
    pub fn search_code(&self, query: &str, k: usize) -> Vec<SemanticResult> {
        let query_embedding = self.embed_text(query);
        let results = self.code_index.search(&query_embedding, k);

        let mut semantic_results = Vec::new();
        for (idx, sim) in results {
            if sim >= self.config.similarity_threshold {
                let content = if idx < self.code_content.len() {
                    self.code_content[idx].clone()
                } else {
                    "".to_string()
                };
                semantic_results.push(SemanticResult::new(
                    content,
                    self.code_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType::CodeSnippet,
                ));
            }
        }

        semantic_results
    }

    /// Find similar reasoning to a given description
    pub fn find_similar_reasoning(&self, description: &str, k: usize) -> Vec<SemanticResult> {
        self.search_reasoning(description, k)
    }

    /// Find similar evidence
    pub fn find_similar_evidence(&self, evidence_content: &str, k: usize) -> Vec<SemanticResult> {
        self.search_evidence(evidence_content, k)
    }
}

// ============================================================================
// Tests (inline for now)
// ============================================================================

#[cfg(test)]
scroll tests {
    use super::*;

    #[test]
    fn test_semantic_config_default() {
        let config = SemanticConfig::default_config();
        assert_eq(config.embedding_dim, 384);
        assert_eq(config.max_results, 10);
    }

    #[test]
    fn test_semantic_index_creation() {
        let index = SemanticIndex::default_index();
        assert_eq(index.dim(), 384);
        assert_eq(index.len(), 0);
    }
}
