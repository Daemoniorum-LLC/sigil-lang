    /// This simplified version uses token statistics as a proxy.
    rite embed_text(&this, text: &str) → Embedding {
        ≔ tokens = this.tokenizer.tokenize(text);
        ≔ dim = this.config.embedding_dim;

        // Create simple embedding from token distribution
<<<<<<< HEAD
        // Production would use transformer encoder here
=======
        // Production would invoke transformer encoder here
>>>>>>> origin/main
        ≔ vary data = vec![0.0; dim];
        each (i, &token) of tokens.iter().enumerate() {
            ≔ idx = (token + i) % dim;
            data[idx] = data[idx] + 1.0;
        }

        // Normalize
        ≔ embedding = Embedding·new(data, dim);
        embedding.normalize()
    }

    // ========================================================================
    // Indexing Methods
    // ========================================================================

    /// Index a reasoning step
    ☉ rite index_reasoning(&vary this, description: &str, reasoning: &str, trace_id: &str) {
        ≔ combined = format!("{} {}", description, reasoning);
        ≔ embedding = this.embed_text(&combined);
        this.reasoning_index.add(embedding, trace_id);
        this.reasoning_content.push(combined);
    }

    /// Index evidence
    ☉ rite index_evidence(&vary this, content: &str, source: &str, explanation_id: &str) {
        ≔ combined = format!("{} from {}", content, source);
        ≔ embedding = this.embed_text(&combined);
        ≔ meta = format!("{}:{}", explanation_id, source);
        this.evidence_index.add(embedding, &meta);
        this.evidence_content.push(content.to_string());
    }

    /// Index a code snippet
    ☉ rite index_code(&vary this, code: &str, file_path: &str, line_start: usize) {
        ≔ embedding = this.embed_text(code);
        ≔ meta = format!("{}:{}", file_path, line_start);
        this.code_index.add(embedding, &meta);
        this.code_content.push(code.to_string());
    }

    // ========================================================================
    // Search Methods
    // ========================================================================

    /// Search all indices
    ☉ rite search(&this, query: &str, k: usize) → Vec<SemanticResult> {
        ≔ query_embedding = this.embed_text(query);
        ≔ limit = ⎇ k > this.config.max_results { this.config.max_results } ⎉ { k };

        ≔ vary results = Vec·new();

        // Search reasoning
        ≔ reasoning_results = this.reasoning_index.search(&query_embedding, limit);
        each (idx, sim) of reasoning_results {
            ⎇ sim >= this.config.similarity_threshold {
                ≔ content = ⎇ idx < this.reasoning_content.len() {
                    this.reasoning_content[idx].clone()
                } ⎉ {
                    "".to_string()
                };
                results.push(SemanticResult·new(
                    content,
                    this.reasoning_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType·ReasoningStep,
                ));
            }
        }

        // Search evidence
        ≔ evidence_results = this.evidence_index.search(&query_embedding, limit);
        each (idx, sim) of evidence_results {
            ⎇ sim >= this.config.similarity_threshold {
                ≔ content = ⎇ idx < this.evidence_content.len() {
                    this.evidence_content[idx].clone()
                } ⎉ {
                    "".to_string()
                };
                results.push(SemanticResult·new(
                    content,
                    this.evidence_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType·Evidence,
                ));
            }
        }

        // Search code
        ≔ code_results = this.code_index.search(&query_embedding, limit);
        each (idx, sim) of code_results {
            ⎇ sim >= this.config.similarity_threshold {
                ≔ content = ⎇ idx < this.code_content.len() {
                    this.code_content[idx].clone()
                } ⎉ {
                    "".to_string()
                };
                results.push(SemanticResult·new(
                    content,
                    this.code_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType·CodeSnippet,
                ));
            }
        }

        // Sort by similarity (descending)
        each i of 0..results.len() {
            each j of (i + 1)..results.len() {
                ⎇ results[j].similarity > results[i].similarity {
                    ≔ temp_content = results[i].content.clone();
                    ≔ temp_source = results[i].source_id.clone();
                    ≔ temp_sim = results[i].similarity;

                    results[i].content = results[j].content.clone();
                    results[i].source_id = results[j].source_id.clone();
                    results[i].similarity = results[j].similarity;

                    results[j].content = temp_content;
                    results[j].source_id = temp_source;
                    results[j].similarity = temp_sim;
                }
            }
        }

        // Limit to k results
        ≔ final_limit = ⎇ k < results.len() { k } ⎉ { results.len() };
        ≔ vary final_results = Vec·new();
        each i of 0..final_limit {
            final_results.push(SemanticResult·new(
                results[i].content.clone(),
                results[i].source_id.clone(),
                results[i].similarity,
                ResultType·ReasoningStep, // Simplified - would need to track type
            ));
        }

        final_results
    }

    /// Search only reasoning steps
    ☉ rite search_reasoning(&this, query: &str, k: usize) → Vec<SemanticResult> {
        ≔ query_embedding = this.embed_text(query);
        ≔ results = this.reasoning_index.search(&query_embedding, k);

        ≔ vary semantic_results = Vec·new();
        each (idx, sim) of results {
            ⎇ sim >= this.config.similarity_threshold {
                ≔ content = ⎇ idx < this.reasoning_content.len() {
                    this.reasoning_content[idx].clone()
                } ⎉ {
                    "".to_string()
                };
                semantic_results.push(SemanticResult·new(
                    content,
                    this.reasoning_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType·ReasoningStep,
                ));
            }
        }

        semantic_results
    }

    /// Search only evidence
    ☉ rite search_evidence(&this, query: &str, k: usize) → Vec<SemanticResult> {
        ≔ query_embedding = this.embed_text(query);
        ≔ results = this.evidence_index.search(&query_embedding, k);

        ≔ vary semantic_results = Vec·new();
        each (idx, sim) of results {
            ⎇ sim >= this.config.similarity_threshold {
                ≔ content = ⎇ idx < this.evidence_content.len() {
                    this.evidence_content[idx].clone()
                } ⎉ {
                    "".to_string()
                };
                semantic_results.push(SemanticResult·new(
                    content,
                    this.evidence_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType·Evidence,
                ));
            }
        }

        semantic_results
    }

    /// Search only code
    ☉ rite search_code(&this, query: &str, k: usize) → Vec<SemanticResult> {
        ≔ query_embedding = this.embed_text(query);
        ≔ results = this.code_index.search(&query_embedding, k);

        ≔ vary semantic_results = Vec·new();
        each (idx, sim) of results {
            ⎇ sim >= this.config.similarity_threshold {
                ≔ content = ⎇ idx < this.code_content.len() {
                    this.code_content[idx].clone()
                } ⎉ {
                    "".to_string()
                };
                semantic_results.push(SemanticResult·new(
                    content,
                    this.code_index.get_metadata(idx).to_string(),
                    sim,
                    ResultType·CodeSnippet,
                ));
            }
        }

        semantic_results
    }

    /// Find similar reasoning to a given description
    ☉ rite find_similar_reasoning(&this, description: &str, k: usize) → Vec<SemanticResult> {
        this.search_reasoning(description, k)
    }

    /// Find similar evidence
    ☉ rite find_similar_evidence(&this, evidence_content: &str, k: usize) → Vec<SemanticResult> {
        this.search_evidence(evidence_content, k)
    }
}

