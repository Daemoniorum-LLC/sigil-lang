impl SemanticIndex {
    pub fn new(config: SemanticConfig) -> Self {
        let tokenizer = CodeTokenizer::new(config.vocab_size, config.max_seq_len);
        Self {
            reasoning_index: EmbeddingIndex::new(config.embedding_dim),
            evidence_index: EmbeddingIndex::new(config.embedding_dim),
            code_index: EmbeddingIndex::new(config.embedding_dim),
            config,
            tokenizer,
            reasoning_content: Vec::new(),
            evidence_content: Vec::new(),
            code_content: Vec::new(),
        }
    }

    pub fn default_index() -> Self {
        Self::new(SemanticConfig::default_config())
    }

    pub fn dim(&self) -> usize {
        self.config.embedding_dim
    }

    pub fn len(&self) -> usize {
        self.reasoning_index.len() + self.evidence_index.len() + self.code_index.len()
    }

    pub fn reasoning_count(&self) -> usize {
        self.reasoning_index.len()
    }

    pub fn evidence_count(&self) -> usize {
        self.evidence_index.len()
    }

    pub fn code_count(&self) -> usize {
        self.code_index.len()
    }

    fn embed_text(&self, text: &str) -> Embedding {
        let tokens = self.tokenizer.tokenize(text);
        let dim = self.config.embedding_dim;

        let mut data = vec![0.0; dim];
        for (i, &token) in tokens.iter().enumerate() {
            let idx = (token + i) % dim;
            data[idx] = data[idx] + 1.0;
        }

        let embedding = Embedding::new(data, dim);
        embedding.normalize()
    }

    pub fn index_reasoning(&mut self, description: &str, reasoning: &str, trace_id: &str) {
        let combined = format!("{} {}", description, reasoning);
        let embedding = self.embed_text(&combined);
