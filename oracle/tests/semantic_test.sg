fn test_similarity_threshold() {
    let config = SemanticConfig::default_config().with_threshold(0.9);
    let mut index = SemanticIndex::new(config);

    index.index_reasoning("Hello world", "A greeting", "trace_001");

    // Search for something completely different
    let results = index.search_reasoning("quantum physics equations", 5);

    // With high threshold, dissimilar content should be filtered
    // (may or may not return results depending on embedding)
    // Just verify it doesn't crash
    let _count = results.len();
}

#[test]
fn test_empty_index_search() {
    let index = SemanticIndex::default_index();

    let results = index.search_reasoning("anything", 5);
    assert_eq(results.len(), 0);

    let results = index.search_evidence("anything", 5);
    assert_eq(results.len(), 0);

    let results = index.search_code("anything", 5);
