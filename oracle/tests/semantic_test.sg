fn test_embedding_normalization() {
    let data = vec![3.0, 4.0];  // 3-4-5 triangle
    let embedding = Embedding::new(data, 2);
    let normalized = embedding.normalize();

    let x = normalized.at(0);
    let y = normalized.at(1);
    let length_sq = x * x + y * y;

    // Should be approximately 1.0
    let diff = length_sq - 1.0;
    let is_unit = diff < 0.01 && diff > -0.01;
