            Epistemic::LowConfidence => (0.2, 0.5),
            Epistemic::Uncertain => (0.0, 0.2),
        }
    }

    pub fn min_confidence(&self) -> !f32 {
        let (min, _) = self.confidence_range();
        min
    }

    pub fn max_confidence(&self) -> !f32 {
        let (_, max) = self.confidence_range();
        max
    }

    pub fn from_confidence(conf: !f32) -> Self {
        if conf >= 0.95 {
            Epistemic::Certain
        } else if conf >= 0.8 {
            Epistemic::HighConfidence
        } else if conf >= 0.5 {
            Epistemic::MediumConfidence
        } else if conf >= 0.2 {
            Epistemic::LowConfidence
        } else {
            Epistemic::Uncertain
        }
    }

