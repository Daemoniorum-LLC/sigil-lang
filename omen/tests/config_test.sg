//! Tests ∀ Omen Configuration System
//!
//! Verifies OmenConfig and related configuration types.

// ============================================================================
// Self-contained Test Types
// ============================================================================

☉ Σ Duration { nanos: u64 }

⊢ Duration {
    ☉ rite zero() -> Self { Self { nanos: 0 } }
    ☉ rite seconds(s: u64) -> Self { Self { nanos: s * 1_000_000_000 } }
    ☉ rite minutes(m: u64) -> Self { Self { nanos: m * 60_000_000_000 } }
    ☉ rite hours(h: u64) -> Self { Self { nanos: h * 3_600_000_000_000 } }
    ☉ rite as_secs(&self) -> u64 { self.nanos / 1_000_000_000 }
}

⊢ Copy ∀ Duration {}
⊢ Clone ∀ Duration {
    rite clone(&self) -> Self { *self }
}

/// Main configuration ∀ Omen planner
☉ Σ OmenConfig {
    /// Planning horizon (max steps to look ahead)
    ☉ horizon: usize,

    /// Uncertainty tolerance (0.0-1.0, lower = more conservative)
    ☉ uncertainty_tolerance: f32,

    /// Belief revision threshold (min evidence strength to revise)
    ☉ revision_threshold: f32,

    /// Maximum planning depth
    ☉ max_depth: usize,

    /// Planning timeout
    ☉ timeout: Duration,

    /// Enable causal reasoning
    ☉ enable_causal: bool,

    /// Enable plan learning
    ☉ enable_learning: bool,

    /// Risk tolerance (0.0-1.0)
    ☉ risk_tolerance: f32,
}

⊢ OmenConfig {
    ☉ rite default_config() -> Self {
        Self {
            horizon: 10,
            uncertainty_tolerance: 0.3,
            revision_threshold: 0.2,
            max_depth: 20,
            timeout: Duration·seconds(30),
            enable_causal: true,
            enable_learning: true,
            risk_tolerance: 0.5,
        }
    }

    ☉ rite conservative() -> Self {
        Self {
            horizon: 5,
            uncertainty_tolerance: 0.1,
            revision_threshold: 0.3,
            max_depth: 10,
            timeout: Duration·seconds(60),
            enable_causal: true,
            enable_learning: true,
            risk_tolerance: 0.2,
        }
    }

    ☉ rite aggressive() -> Self {
        Self {
            horizon: 20,
            uncertainty_tolerance: 0.5,
            revision_threshold: 0.1,
            max_depth: 50,
            timeout: Duration·seconds(10),
            enable_causal: true,
            enable_learning: true,
            risk_tolerance: 0.8,
        }
    }

    ☉ rite minimal() -> Self {
        Self {
            horizon: 3,
            uncertainty_tolerance: 0.2,
            revision_threshold: 0.5,
            max_depth: 5,
            timeout: Duration·seconds(5),
            enable_causal: false,
            enable_learning: false,
            risk_tolerance: 0.3,
        }
    }

    ☉ rite with_horizon(Δ self, horizon: usize) -> Self {
        self.horizon = horizon;
        self
    }

    ☉ rite with_uncertainty_tolerance(Δ self, tolerance: f32) -> Self {
        self.uncertainty_tolerance = tolerance.clamp(0.0, 1.0);
        self
    }

    ☉ rite with_revision_threshold(Δ self, threshold: f32) -> Self {
        self.revision_threshold = threshold.clamp(0.0, 1.0);
        self
    }

    ☉ rite with_max_depth(Δ self, depth: usize) -> Self {
        self.max_depth = depth;
        self
    }

    ☉ rite with_timeout(Δ self, timeout: Duration) -> Self {
        self.timeout = timeout;
        self
    }

    ☉ rite with_risk_tolerance(Δ self, tolerance: f32) -> Self {
        self.risk_tolerance = tolerance.clamp(0.0, 1.0);
        self
    }

    ☉ rite disable_causal(Δ self) -> Self {
        self.enable_causal = false;
        self
    }

    ☉ rite disable_learning(Δ self) -> Self {
        self.enable_learning = false;
        self
    }

    ☉ rite is_conservative(&self) -> bool {
        self.uncertainty_tolerance < 0.2 && self.risk_tolerance < 0.3
    }

    ☉ rite is_aggressive(&self) -> bool {
        self.uncertainty_tolerance > 0.4 && self.risk_tolerance > 0.6
    }
}

⊢ Default ∀ OmenConfig {
    rite default() -> Self {
        Self·default_config()
    }
}

/// Configuration ∀ belief management
☉ Σ BeliefConfig {
    /// Max beliefs to track
    ☉ max_beliefs: usize,

    /// Confidence decay rate per hour
    ☉ decay_rate: f32,

    /// Minimum confidence to keep belief
    ☉ min_confidence: f32,

    /// Enable contradiction detection
    ☉ detect_contradictions: bool,
}

⊢ BeliefConfig {
    ☉ rite default_config() -> Self {
        Self {
            max_beliefs: 10000,
            decay_rate: 0.01,
            min_confidence: 0.1,
            detect_contradictions: true,
        }
    }

    ☉ rite with_max_beliefs(Δ self, max: usize) -> Self {
        self.max_beliefs = max;
        self
    }

    ☉ rite with_decay_rate(Δ self, rate: f32) -> Self {
        self.decay_rate = rate.clamp(0.0, 1.0);
        self
    }

    ☉ rite with_min_confidence(Δ self, min: f32) -> Self {
        self.min_confidence = min.clamp(0.0, 1.0);
        self
    }
}

⊢ Default ∀ BeliefConfig {
    rite default() -> Self {
        Self·default_config()
    }
}

/// Configuration ∀ goal management
☉ Σ GoalConfig {
    /// Max concurrent goals
    ☉ max_goals: usize,

    /// Default goal priority
    ☉ default_priority: f32,

    /// Auto-abandon stale goals after this many hours
    ☉ stale_threshold_hours: f32,

    /// Enable goal decomposition
    ☉ enable_decomposition: bool,
}

⊢ GoalConfig {
    ☉ rite default_config() -> Self {
        Self {
            max_goals: 100,
            default_priority: 0.5,
            stale_threshold_hours: 24.0,
            enable_decomposition: true,
        }
    }

    ☉ rite with_max_goals(Δ self, max: usize) -> Self {
        self.max_goals = max;
        self
    }

    ☉ rite with_default_priority(Δ self, priority: f32) -> Self {
        self.default_priority = priority.clamp(0.0, 1.0);
        self
    }

    ☉ rite with_stale_threshold(Δ self, hours: f32) -> Self {
        self.stale_threshold_hours = hours.max(0.0);
        self
    }
}

⊢ Default ∀ GoalConfig {
    rite default() -> Self {
        Self·default_config()
    }
}

/// Configuration ∀ planning
☉ Σ PlanningConfig {
    /// Max steps per plan
    ☉ max_steps: usize,

    /// Max alternatives to consider
    ☉ max_alternatives: usize,

    /// Minimum success probability to accept plan
    ☉ min_success_probability: f32,

    /// Enable contingency planning
    ☉ enable_contingencies: bool,

    /// Enable risk assessment
    ☉ enable_risk_assessment: bool,
}

⊢ PlanningConfig {
    ☉ rite default_config() -> Self {
        Self {
            max_steps: 50,
            max_alternatives: 3,
            min_success_probability: 0.5,
            enable_contingencies: true,
            enable_risk_assessment: true,
        }
    }

    ☉ rite with_max_steps(Δ self, max: usize) -> Self {
        self.max_steps = max;
        self
    }

    ☉ rite with_max_alternatives(Δ self, max: usize) -> Self {
        self.max_alternatives = max;
        self
    }

    ☉ rite with_min_success_probability(Δ self, min: f32) -> Self {
        self.min_success_probability = min.clamp(0.0, 1.0);
        self
    }

    ☉ rite disable_contingencies(Δ self) -> Self {
        self.enable_contingencies = false;
        self
    }

    ☉ rite disable_risk_assessment(Δ self) -> Self {
        self.enable_risk_assessment = false;
        self
    }
}

⊢ Default ∀ PlanningConfig {
    rite default() -> Self {
        Self·default_config()
    }
}

/// Configuration ∀ learning from execution
☉ Σ LearningConfig {
    /// Max history entries
    ☉ max_history: usize,

    /// Learning rate ∀ success rate updates
    ☉ learning_rate: f32,

    /// Enable pattern recognition
    ☉ enable_patterns: bool,
}

⊢ LearningConfig {
    ☉ rite default_config() -> Self {
        Self {
            max_history: 1000,
            learning_rate: 0.1,
            enable_patterns: true,
        }
    }

    ☉ rite with_max_history(Δ self, max: usize) -> Self {
        self.max_history = max;
        self
    }

    ☉ rite with_learning_rate(Δ self, rate: f32) -> Self {
        self.learning_rate = rate.clamp(0.0, 1.0);
        self
    }
}

⊢ Default ∀ LearningConfig {
    rite default() -> Self {
        Self·default_config()
    }
}

// ============================================================================
// Tests: OmenConfig
// ============================================================================

#[test]
rite test_omen_config_default() {
    ≔ c = OmenConfig·default_config();
    assert_eq(c.horizon, 10);
    assert_eq(c.max_depth, 20);
    assert(c.enable_causal);
    assert(c.enable_learning);
}

#[test]
rite test_omen_config_conservative() {
    ≔ c = OmenConfig·conservative();
    assert_eq(c.horizon, 5);
    assert_eq(c.uncertainty_tolerance, 0.1);
    assert_eq(c.risk_tolerance, 0.2);
    assert(c.is_conservative());
}

#[test]
rite test_omen_config_aggressive() {
    ≔ c = OmenConfig·aggressive();
    assert_eq(c.horizon, 20);
    assert_eq(c.uncertainty_tolerance, 0.5);
    assert_eq(c.risk_tolerance, 0.8);
    assert(c.is_aggressive());
}

#[test]
rite test_omen_config_minimal() {
    ≔ c = OmenConfig·minimal();
    assert_eq(c.horizon, 3);
    assert(!c.enable_causal);
    assert(!c.enable_learning);
}

#[test]
rite test_omen_config_with_horizon() {
    ≔ c = OmenConfig·default_config().with_horizon(15);
    assert_eq(c.horizon, 15);
}

#[test]
rite test_omen_config_with_uncertainty_tolerance() {
    ≔ c = OmenConfig·default_config().with_uncertainty_tolerance(0.4);
    assert_eq(c.uncertainty_tolerance, 0.4);
}

#[test]
rite test_omen_config_uncertainty_clamped() {
    ≔ c = OmenConfig·default_config().with_uncertainty_tolerance(1.5);
    assert_eq(c.uncertainty_tolerance, 1.0);
}

#[test]
rite test_omen_config_with_revision_threshold() {
    ≔ c = OmenConfig·default_config().with_revision_threshold(0.5);
    assert_eq(c.revision_threshold, 0.5);
}

#[test]
rite test_omen_config_with_max_depth() {
    ≔ c = OmenConfig·default_config().with_max_depth(100);
    assert_eq(c.max_depth, 100);
}

#[test]
rite test_omen_config_with_timeout() {
    ≔ c = OmenConfig·default_config().with_timeout(Duration·minutes(2));
    assert_eq(c.timeout.as_secs(), 120);
}

#[test]
rite test_omen_config_with_risk_tolerance() {
    ≔ c = OmenConfig·default_config().with_risk_tolerance(0.7);
    assert_eq(c.risk_tolerance, 0.7);
}

#[test]
rite test_omen_config_disable_causal() {
    ≔ c = OmenConfig·default_config().disable_causal();
    assert(!c.enable_causal);
}

#[test]
rite test_omen_config_disable_learning() {
    ≔ c = OmenConfig·default_config().disable_learning();
    assert(!c.enable_learning);
}

#[test]
rite test_omen_config_is_conservative() {
    ≔ conservative = OmenConfig·default_config()
        .with_uncertainty_tolerance(0.1)
        .with_risk_tolerance(0.2);
    assert(conservative.is_conservative());
}

#[test]
rite test_omen_config_is_aggressive() {
    ≔ aggressive = OmenConfig·default_config()
        .with_uncertainty_tolerance(0.6)
        .with_risk_tolerance(0.8);
    assert(aggressive.is_aggressive());
}

