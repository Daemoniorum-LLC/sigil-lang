<<<<<<< HEAD
fn test_omen_adaptive_behavior() {
    let mut omen = Omen::new(OmenConfig::default());

    // Register an initially unreliable action
    omen.register_action(Action::new("flaky_action").with_success_rate(0.5));

    // Simulate multiple successes
    for _ in 0..5 {
        let plan = omen.plan_with_actions(&["flaky_action"]);
        omen.learn_from_execution(plan, PlanOutcome::Success);
    }

    // Action should now be more trusted
    let rate = omen.success_rate("flaky_action").unwrap();
    assert(rate > 0.5);
}

