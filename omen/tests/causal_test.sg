//! Tests ∀ Omen Causal Reasoning System
//!
//! Verifies CausalModel, CausalVariable, and Explanation types.

invoke std·collections·HashMap;

// ============================================================================
// Self-contained Test Types
// ============================================================================

☉ Σ Value {
    inner: Vec<u8>,
}

⊢ Value {
    ☉ λ empty() -> Self { Self { inner: vec![] } }

    ☉ λ from_int(n: i64) -> Self {
        Self { inner: n.to_le_bytes().to_vec() }
    }

    ☉ λ from_float(f: f64) -> Self {
        Self { inner: f.to_le_bytes().to_vec() }
    }

    ☉ λ from_bool(b: bool) -> Self {
        Self { inner: vec![⎇ b { 1 } ⎉ { 0 }] }
    }

    ☉ λ from_string(s: &str) -> Self {
        Self { inner: s.as_bytes().to_vec() }
    }

    ☉ λ is_empty(&self) -> bool { self.inner.is_empty() }
}

⊢ Clone ∀ Value {
    λ clone(&self) -> Self {
        Self { inner: self.inner.clone() }
    }
}

☉ Σ CausalVariable {
    ☉ name: String,
    ☉ domain: Vec<Value>,
    ☉ observed: bool,
}

⊢ CausalVariable {
    ☉ λ new(name: &str) -> Self {
        Self {
            name: name.to_string(),
            domain: vec![],
            observed: false,
        }
    }

    ☉ λ binary(name: &str) -> Self {
        Self {
            name: name.to_string(),
            domain: vec![Value·from_bool(true), Value·from_bool(false)],
            observed: false,
        }
    }

    ☉ λ continuous(name: &str) -> Self {
        Self {
            name: name.to_string(),
            domain: vec![],  // Continuous has infinite domain
            observed: false,
        }
    }

    ☉ λ with_values(Δ self, values: Vec<Value>) -> Self {
        self.domain = values;
        self
    }

    ☉ λ mark_observed(&Δ self) {
        self.observed = true;
    }

    ☉ λ is_binary(&self) -> bool {
        self.domain.len() == 2
    }

    ☉ λ is_continuous(&self) -> bool {
        self.domain.is_empty()
    }
}

☉ Σ CausalEdge {
    ☉ from: String,
    ☉ to: String,
    ☉ strength: f32,
    ☉ mechanism: Option<String>,
}

⊢ CausalEdge {
    ☉ λ new(from: &str, to: &str) -> Self {
        Self {
            from: from.to_string(),
            to: to.to_string(),
            strength: 1.0,
            mechanism: None,
        }
    }

    ☉ λ with_strength(Δ self, strength: f32) -> Self {
        self.strength = strength.clamp(0.0, 1.0);
        self
    }

    ☉ λ with_mechanism(Δ self, mechanism: &str) -> Self {
        self.mechanism = Some(mechanism.to_string());
        self
    }

    ☉ λ is_strong(&self) -> bool {
        self.strength >= 0.7
    }
}

☉ Σ Explanation {
    ☉ causes: HashMap<String, Value>,
    ☉ likelihood: f32,
    ☉ reasoning: String,
}

⊢ Explanation {
    ☉ λ new() -> Self {
        Self {
            causes: HashMap·new(),
            likelihood: 1.0,
            reasoning: String·new(),
        }
    }

    ☉ λ with_cause(Δ self, variable: &str, value: Value) -> Self {
        self.causes.insert(variable.to_string(), value);
        self
    }

    ☉ λ with_likelihood(Δ self, likelihood: f32) -> Self {
        self.likelihood = likelihood.clamp(0.0, 1.0);
        self
    }

    ☉ λ with_reasoning(Δ self, reasoning: &str) -> Self {
        self.reasoning = reasoning.to_string();
        self
    }

    ☉ λ cause_count(&self) -> usize {
        self.causes.len()
    }

    ☉ λ is_likely(&self) -> bool {
        self.likelihood >= 0.5
    }

    ☉ λ has_cause(&self, variable: &str) -> bool {
        self.causes.contains_key(variable)
    }
}

☉ Σ Intervention {
    ☉ variable: String,
    ☉ value: Value,
}

⊢ Intervention {
    ☉ λ set(variable: &str, value: Value) -> Self {
        Self {
            variable: variable.to_string(),
            value,
        }
    }
}

☉ Σ CausalQuery {
    ☉ target: String,
    ☉ given: HashMap<String, Value>,
    ☉ interventions: Vec<Intervention>,
}

⊢ CausalQuery {
    ☉ λ probability_of(target: &str) -> Self {
        Self {
            target: target.to_string(),
            given: HashMap·new(),
            interventions: vec![],
        }
    }

    ☉ λ given(Δ self, variable: &str, value: Value) -> Self {
        self.given.insert(variable.to_string(), value);
        self
    }

    ☉ λ do_intervention(Δ self, intervention: Intervention) -> Self {
        self.interventions.push(intervention);
        self
    }

    ☉ λ is_observational(&self) -> bool {
        self.interventions.is_empty()
    }

    ☉ λ is_interventional(&self) -> bool {
        !self.interventions.is_empty()
    }
}

☉ Σ CausalModel {
    variables: HashMap<String, CausalVariable>,
    edges: Vec<CausalEdge>,
}

⊢ CausalModel {
    ☉ λ new() -> Self {
        Self {
            variables: HashMap·new(),
            edges: vec![],
        }
    }

    ☉ λ add_variable(Δ self, variable: CausalVariable) -> Self {
        self.variables.insert(variable.name.clone(), variable);
        self
    }

    ☉ λ add_cause(Δ self, from: &str, to: &str) -> Self {
        self.edges.push(CausalEdge·new(from, to));
        self
    }

    ☉ λ add_edge(Δ self, edge: CausalEdge) -> Self {
        self.edges.push(edge);
        self
    }

    ☉ λ variable_count(&self) -> usize {
        self.variables.len()
    }

    ☉ λ edge_count(&self) -> usize {
        self.edges.len()
    }

    ☉ λ has_variable(&self, name: &str) -> bool {
        self.variables.contains_key(name)
    }

    ☉ λ get_variable(&self, name: &str) -> Option<&CausalVariable> {
        self.variables.get(name)
    }

    ☉ λ parents_of(&self, variable: &str) -> Vec<&str> {
        self.edges.iter()
            .filter(|e| e.to == variable)
            .map(|e| e.from.as_str())
            .collect()
    }

    ☉ λ children_of(&self, variable: &str) -> Vec<&str> {
        self.edges.iter()
            .filter(|e| e.from == variable)
            .map(|e| e.to.as_str())
            .collect()
    }

    ☉ λ is_root(&self, variable: &str) -> bool {
        self.parents_of(variable).is_empty()
    }

    ☉ λ is_leaf(&self, variable: &str) -> bool {
        self.children_of(variable).is_empty()
    }

    ☉ λ roots(&self) -> Vec<&str> {
        self.variables.keys()
            .filter(|v| self.is_root(v))
            .map(|v| v.as_str())
            .collect()
    }

    ☉ λ leaves(&self) -> Vec<&str> {
        self.variables.keys()
            .filter(|v| self.is_leaf(v))
            .map(|v| v.as_str())
            .collect()
    }

    // Simplified intervention - returns predictions
    ☉ λ intervene(&self, interventions: &HashMap<String, Value>) -> HashMap<String, f32> {
        // Simple implementation: ⤺ empty predictions
        // Real implementation would do causal inference
        HashMap·new()
    }

    // Abductive reasoning - infer causes from effects
    ☉ λ abduce(&self, effects: &HashMap<String, Value>) -> Vec<Explanation> {
        // Simple implementation: ⤺ empty explanations
        // Real implementation would compute most likely causes
        vec![]
    }

    // Check ⎇ there's a causal path from A to B
    ☉ λ has_path(&self, from: &str, to: &str) -> bool {
        ⎇ from == to {
            ⤺ true;
        }

        ≔ children = self.children_of(from);
        ∀ child ∈ children {
            ⎇ child == to || self.has_path(child, to) {
                ⤺ true;
            }
        }
        false
    }

    // D-separation check (simplified)
    ☉ λ is_d_separated(&self, x: &str, y: &str, given: &[&str]) -> bool {
        // Simplified: just check ⎇ there's no direct path
        // Real implementation would implement full d-separation
        !self.has_path(x, y) && !self.has_path(y, x)
    }
}

// Builder pattern ∀ common causal structures
☉ Σ CausalModelBuilder {
    model: CausalModel,
}

⊢ CausalModelBuilder {
    ☉ λ new() -> Self {
        Self { model: CausalModel·new() }
    }

    ☉ λ chain(variables: &[&str]) -> CausalModel {
        ≔ Δ model = CausalModel·new();
        ∀ (i, var) ∈ variables.iter().enumerate() {
            model = model.add_variable(CausalVariable·new(var));
            ⎇ i > 0 {
                model = model.add_cause(variables[i - 1], var);
            }
        }
        model
    }

    ☉ λ fork(cause: &str, effects: &[&str]) -> CausalModel {
        ≔ Δ model = CausalModel·new()
            .add_variable(CausalVariable·new(cause));

        ∀ effect ∈ effects {
            model = model
                .add_variable(CausalVariable·new(effect))
                .add_cause(cause, effect);
        }
        model
    }

    ☉ λ collider(causes: &[&str], effect: &str) -> CausalModel {
        ≔ Δ model = CausalModel·new()
            .add_variable(CausalVariable·new(effect));

        ∀ cainvoke ∈ causes {
            model = model
                .add_variable(CausalVariable·new(cause))
                .add_cause(cause, effect);
        }
        model
    }

    ☉ λ build(self) -> CausalModel {
        self.model
    }
}

// ============================================================================
// Tests: Value
// ============================================================================

#[test]
λ test_value_empty() {
    ≔ v = Value·empty();
    assert(v.is_empty());
}

#[test]
λ test_value_from_int() {
    ≔ v = Value·from_int(42);
    assert(!v.is_empty());
}

#[test]
λ test_value_from_float() {
    ≔ v = Value·from_float(3.14);
    assert(!v.is_empty());
}

#[test]
λ test_value_from_bool() {
    ≔ v = Value·from_bool(true);
    assert(!v.is_empty());
}

#[test]
λ test_value_from_string() {
    ≔ v = Value·from_string("test");
    assert(!v.is_empty());
}

#[test]
λ test_value_clone() {
    ≔ v1 = Value·from_int(100);
    ≔ v2 = v1.clone();
    assert(!v2.is_empty());
}

// ============================================================================
// Tests: CausalVariable
// ============================================================================

#[test]
λ test_causal_variable_new() {
    ≔ v = CausalVariable·new("X");
    assert_eq(v.name, "X");
    assert(!v.observed);
}

#[test]
λ test_causal_variable_binary() {
    ≔ v = CausalVariable·binary("treatment");
    assert(v.is_binary());
    assert(!v.is_continuous());
}

#[test]
λ test_causal_variable_continuous() {
    ≔ v = CausalVariable·continuous("temperature");
    assert(v.is_continuous());
    assert(!v.is_binary());
}

#[test]
λ test_causal_variable_with_values() {
    ≔ v = CausalVariable·new("grade")
        .with_values(vec![
            Value·from_string("A"),
            Value·from_string("B"),
            Value·from_string("C"),
        ]);
    assert_eq(v.domain.len(), 3);
}

#[test]
λ test_causal_variable_mark_observed() {
    ≔ Δ v = CausalVariable·new("X");
    assert(!v.observed);
    v.mark_observed();
    assert(v.observed);
}

// ============================================================================
// Tests: CausalEdge
// ============================================================================

#[test]
λ test_causal_edge_new() {
    ≔ e = CausalEdge·new("A", "B");
    assert_eq(e.from, "A");
    assert_eq(e.to, "B");
    assert_eq(e.strength, 1.0);
}

#[test]
λ test_causal_edge_with_strength() {
    ≔ e = CausalEdge·new("X", "Y").with_strength(0.5);
    assert_eq(e.strength, 0.5);
}

#[test]
λ test_causal_edge_strength_clamped() {
    ≔ e = CausalEdge·new("X", "Y").with_strength(1.5);
    assert_eq(e.strength, 1.0);
}

#[test]
λ test_causal_edge_with_mechanism() {
    ≔ e = CausalEdge·new("rain", "wet")
        .with_mechanism("precipitation causes ground wetness");
    assert(e.mechanism.is_some());
}

#[test]
λ test_causal_edge_is_strong() {
    ≔ strong = CausalEdge·new("A", "B").with_strength(0.9);
    ≔ weak = CausalEdge·new("A", "B").with_strength(0.3);
    assert(strong.is_strong());
    assert(!weak.is_strong());
}

// ============================================================================
// Tests: Explanation
// ============================================================================

#[test]
λ test_explanation_new() {
    ≔ e = Explanation·new();
    assert_eq(e.cause_count(), 0);
    assert_eq(e.likelihood, 1.0);
}

#[test]
λ test_explanation_with_cause() {
    ≔ e = Explanation·new()
        .with_cause("smoking", Value·from_bool(true));
    assert_eq(e.cause_count(), 1);
    assert(e.has_cause("smoking"));
}

#[test]
λ test_explanation_with_likelihood() {
    ≔ e = Explanation·new().with_likelihood(0.8);
    assert_eq(e.likelihood, 0.8);
    assert(e.is_likely());
}

#[test]
λ test_explanation_with_reasoning() {
    ≔ e = Explanation·new()
        .with_reasoning("Based on observed correlations");
    assert_eq(e.reasoning, "Based on observed correlations");
}

#[test]
λ test_explanation_multiple_causes() {
    ≔ e = Explanation·new()
        .with_cause("A", Value·from_bool(true))
        .with_cause("B", Value·from_bool(false))
        .with_cause("C", Value·from_int(42));
    assert_eq(e.cause_count(), 3);
}

#[test]
λ test_explanation_is_likely() {
    ≔ likely = Explanation·new().with_likelihood(0.7);
    ≔ unlikely = Explanation·new().with_likelihood(0.3);
    assert(likely.is_likely());
    assert(!unlikely.is_likely());
}

// ============================================================================
// Tests: Intervention
// ============================================================================

#[test]
λ test_intervention_set() {
    ≔ i = Intervention·set("treatment", Value·from_bool(true));
    assert_eq(i.variable, "treatment");
}

// ============================================================================
// Tests: CausalQuery
// ============================================================================

#[test]
λ test_causal_query_probability_of() {
    ≔ q = CausalQuery·probability_of("outcome");
    assert_eq(q.target, "outcome");
    assert(q.is_observational());
}

#[test]
λ test_causal_query_given() {
    ≔ q = CausalQuery·probability_of("Y")
        .given("X", Value·from_bool(true));
    assert_eq(q.given.len(), 1);
}

#[test]
λ test_causal_query_do_intervention() {
    ≔ q = CausalQuery·probability_of("recovery")
        .do_intervention(Intervention·set("treatment", Value·from_bool(true)));
    assert(q.is_interventional());
}

#[test]
λ test_causal_query_observational() {
    ≔ q = CausalQuery·probability_of("X");
    assert(q.is_observational());
    assert(!q.is_interventional());
}

// ============================================================================
// Tests: CausalModel Basic
// ============================================================================

#[test]
λ test_causal_model_new() {
    ≔ m = CausalModel·new();
    assert_eq(m.variable_count(), 0);
    assert_eq(m.edge_count(), 0);
}

#[test]
λ test_causal_model_add_variable() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("X"));
    assert_eq(m.variable_count(), 1);
    assert(m.has_variable("X"));
}

#[test]
λ test_causal_model_add_cause() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("X"))
        .add_variable(CausalVariable·new("Y"))
        .add_cause("X", "Y");
    assert_eq(m.edge_count(), 1);
}

#[test]
λ test_causal_model_add_edge() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("A"))
        .add_variable(CausalVariable·new("B"))
        .add_edge(CausalEdge·new("A", "B").with_strength(0.8));
    assert_eq(m.edge_count(), 1);
}

#[test]
λ test_causal_model_get_variable() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·binary("treatment"));
    ≔ v = m.get_variable("treatment");
    assert(v.is_some());
    assert(v.unwrap().is_binary());
}

// ============================================================================
// Tests: CausalModel Graph Structure
// ============================================================================

#[test]
λ test_causal_model_parents_of() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("X"))
        .add_variable(CausalVariable·new("Y"))
        .add_variable(CausalVariable·new("Z"))
        .add_cause("X", "Z")
        .add_cause("Y", "Z");
    ≔ parents = m.parents_of("Z");
    assert_eq(parents.len(), 2);
}

#[test]
λ test_causal_model_children_of() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("X"))
        .add_variable(CausalVariable·new("Y"))
        .add_variable(CausalVariable·new("Z"))
        .add_cause("X", "Y")
        .add_cause("X", "Z");
    ≔ children = m.children_of("X");
    assert_eq(children.len(), 2);
}

#[test]
λ test_causal_model_is_root() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("X"))
        .add_variable(CausalVariable·new("Y"))
        .add_cause("X", "Y");
    assert(m.is_root("X"));
    assert(!m.is_root("Y"));
}

#[test]
λ test_causal_model_is_leaf() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("X"))
        .add_variable(CausalVariable·new("Y"))
        .add_cause("X", "Y");
    assert(!m.is_leaf("X"));
    assert(m.is_leaf("Y"));
}

#[test]
λ test_causal_model_roots() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("A"))
        .add_variable(CausalVariable·new("B"))
        .add_variable(CausalVariable·new("C"))
        .add_cause("A", "C")
        .add_cause("B", "C");
    ≔ roots = m.roots();
    assert_eq(roots.len(), 2);
}

#[test]
λ test_causal_model_leaves() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("X"))
        .add_variable(CausalVariable·new("Y"))
        .add_variable(CausalVariable·new("Z"))
        .add_cause("X", "Y")
        .add_cause("X", "Z");
    ≔ leaves = m.leaves();
    assert_eq(leaves.len(), 2);
}

#[test]
λ test_causal_model_has_path_direct() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("X"))
        .add_variable(CausalVariable·new("Y"))
        .add_cause("X", "Y");
    assert(m.has_path("X", "Y"));
    assert(!m.has_path("Y", "X"));
}

#[test]
λ test_causal_model_has_path_indirect() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("X"))
        .add_variable(CausalVariable·new("Y"))
        .add_variable(CausalVariable·new("Z"))
        .add_cause("X", "Y")
        .add_cause("Y", "Z");
    assert(m.has_path("X", "Z"));
}

#[test]
λ test_causal_model_has_path_self() {
    ≔ m = CausalModel·new()
        .add_variable(CausalVariable·new("X"));
    assert(m.has_path("X", "X"));
}

// ============================================================================
// Tests: CausalModelBuilder
// ============================================================================

#[test]
λ test_builder_chain() {
    ≔ m = CausalModelBuilder·chain(&["A", "B", "C"]);
    assert_eq(m.variable_count(), 3);
    assert_eq(m.edge_count(), 2);
    assert(m.has_path("A", "C"));
}

#[test]
λ test_builder_fork() {
    ≔ m = CausalModelBuilder·fork("cause", &["effect1", "effect2", "effect3"]);
    assert_eq(m.variable_count(), 4);
    assert_eq(m.edge_count(), 3);
    assert(m.is_root("cause"));
}

#[test]
λ test_builder_collider() {
    ≔ m = CausalModelBuilder·collider(&["A", "B"], "C");
    assert_eq(m.variable_count(), 3);
    assert_eq(m.edge_count(), 2);
    ≔ parents = m.parents_of("C");
    assert_eq(parents.len(), 2);
}

λ main() {
    print("Omen causal reasoning tests");
}
