//! Tests for Omen Causal Reasoning System
//!
//! Verifies CausalModel, CausalVariable, and Explanation types.

use std::collections::HashMap;

// ============================================================================
// Self-contained Test Types
// ============================================================================

pub struct Value {
    inner: Vec<u8>,
}

impl Value {
    pub fn empty() -> Self { Self { inner: vec![] } }

    pub fn from_int(n: i64) -> Self {
        Self { inner: n.to_le_bytes().to_vec() }
    }

    pub fn from_float(f: f64) -> Self {
        Self { inner: f.to_le_bytes().to_vec() }
    }

    pub fn from_bool(b: bool) -> Self {
        Self { inner: vec![if b { 1 } else { 0 }] }
    }

    pub fn from_string(s: &str) -> Self {
        Self { inner: s.as_bytes().to_vec() }
    }

    pub fn is_empty(&self) -> bool { self.inner.is_empty() }
}

impl Clone for Value {
    fn clone(&self) -> Self {
        Self { inner: self.inner.clone() }
    }
}

pub struct CausalVariable {
    pub name: String,
    pub domain: Vec<Value>,
    pub observed: bool,
}

impl CausalVariable {
    pub fn new(name: &str) -> Self {
        Self {
            name: name.to_string(),
            domain: vec![],
            observed: false,
        }
    }

    pub fn binary(name: &str) -> Self {
        Self {
            name: name.to_string(),
            domain: vec![Value::from_bool(true), Value::from_bool(false)],
            observed: false,
        }
    }

    pub fn continuous(name: &str) -> Self {
        Self {
            name: name.to_string(),
            domain: vec![],  // Continuous has infinite domain
            observed: false,
        }
    }

    pub fn with_values(mut self, values: Vec<Value>) -> Self {
        self.domain = values;
        self
    }

    pub fn mark_observed(&mut self) {
        self.observed = true;
    }

    pub fn is_binary(&self) -> bool {
        self.domain.len() == 2
    }

    pub fn is_continuous(&self) -> bool {
        self.domain.is_empty()
    }
}

pub struct CausalEdge {
    pub from: String,
    pub to: String,
    pub strength: f32,
    pub mechanism: Option<String>,
}

impl CausalEdge {
    pub fn new(from: &str, to: &str) -> Self {
        Self {
            from: from.to_string(),
            to: to.to_string(),
            strength: 1.0,
            mechanism: None,
        }
    }

    pub fn with_strength(mut self, strength: f32) -> Self {
        self.strength = strength.clamp(0.0, 1.0);
        self
    }

    pub fn with_mechanism(mut self, mechanism: &str) -> Self {
        self.mechanism = Some(mechanism.to_string());
        self
    }

    pub fn is_strong(&self) -> bool {
        self.strength >= 0.7
    }
}

pub struct Explanation {
    pub causes: HashMap<String, Value>,
    pub likelihood: f32,
    pub reasoning: String,
}

impl Explanation {
    pub fn new() -> Self {
        Self {
            causes: HashMap::new(),
            likelihood: 1.0,
            reasoning: String::new(),
        }
    }

    pub fn with_cause(mut self, variable: &str, value: Value) -> Self {
        self.causes.insert(variable.to_string(), value);
        self
    }

    pub fn with_likelihood(mut self, likelihood: f32) -> Self {
        self.likelihood = likelihood.clamp(0.0, 1.0);
        self
    }

    pub fn with_reasoning(mut self, reasoning: &str) -> Self {
        self.reasoning = reasoning.to_string();
        self
    }

    pub fn cause_count(&self) -> usize {
        self.causes.len()
    }

    pub fn is_likely(&self) -> bool {
        self.likelihood >= 0.5
    }

    pub fn has_cause(&self, variable: &str) -> bool {
        self.causes.contains_key(variable)
    }
}

pub struct Intervention {
    pub variable: String,
    pub value: Value,
}

impl Intervention {
    pub fn set(variable: &str, value: Value) -> Self {
        Self {
            variable: variable.to_string(),
            value,
        }
    }
}

pub struct CausalQuery {
    pub target: String,
    pub given: HashMap<String, Value>,
    pub interventions: Vec<Intervention>,
}

impl CausalQuery {
    pub fn probability_of(target: &str) -> Self {
        Self {
            target: target.to_string(),
            given: HashMap::new(),
            interventions: vec![],
        }
    }

    pub fn given(mut self, variable: &str, value: Value) -> Self {
        self.given.insert(variable.to_string(), value);
        self
    }

    pub fn do_intervention(mut self, intervention: Intervention) -> Self {
        self.interventions.push(intervention);
        self
    }

    pub fn is_observational(&self) -> bool {
        self.interventions.is_empty()
    }

    pub fn is_interventional(&self) -> bool {
        !self.interventions.is_empty()
    }
}

pub struct CausalModel {
    variables: HashMap<String, CausalVariable>,
    edges: Vec<CausalEdge>,
}

impl CausalModel {
    pub fn new() -> Self {
        Self {
            variables: HashMap::new(),
            edges: vec![],
        }
    }

    pub fn add_variable(mut self, variable: CausalVariable) -> Self {
        self.variables.insert(variable.name.clone(), variable);
        self
    }

    pub fn add_cause(mut self, from: &str, to: &str) -> Self {
        self.edges.push(CausalEdge::new(from, to));
        self
    }

    pub fn add_edge(mut self, edge: CausalEdge) -> Self {
        self.edges.push(edge);
        self
    }

    pub fn variable_count(&self) -> usize {
        self.variables.len()
    }

    pub fn edge_count(&self) -> usize {
        self.edges.len()
    }

    pub fn has_variable(&self, name: &str) -> bool {
        self.variables.contains_key(name)
    }

    pub fn get_variable(&self, name: &str) -> Option<&CausalVariable> {
        self.variables.get(name)
    }

    pub fn parents_of(&self, variable: &str) -> Vec<&str> {
        self.edges.iter()
            .filter(|e| e.to == variable)
            .map(|e| e.from.as_str())
            .collect()
    }

    pub fn children_of(&self, variable: &str) -> Vec<&str> {
        self.edges.iter()
            .filter(|e| e.from == variable)
            .map(|e| e.to.as_str())
            .collect()
    }

    pub fn is_root(&self, variable: &str) -> bool {
        self.parents_of(variable).is_empty()
    }

    pub fn is_leaf(&self, variable: &str) -> bool {
        self.children_of(variable).is_empty()
    }

    pub fn roots(&self) -> Vec<&str> {
        self.variables.keys()
            .filter(|v| self.is_root(v))
            .map(|v| v.as_str())
            .collect()
    }

    pub fn leaves(&self) -> Vec<&str> {
        self.variables.keys()
            .filter(|v| self.is_leaf(v))
            .map(|v| v.as_str())
            .collect()
    }

    // Simplified intervention - returns predictions
    pub fn intervene(&self, interventions: &HashMap<String, Value>) -> HashMap<String, f32> {
        // Simple implementation: return empty predictions
        // Real implementation would do causal inference
        HashMap::new()
    }

    // Abductive reasoning - infer causes from effects
    pub fn abduce(&self, effects: &HashMap<String, Value>) -> Vec<Explanation> {
        // Simple implementation: return empty explanations
        // Real implementation would compute most likely causes
        vec![]
    }

    // Check if there's a causal path from A to B
    pub fn has_path(&self, from: &str, to: &str) -> bool {
        if from == to {
            return true;
        }

        let children = self.children_of(from);
        for child in children {
            if child == to || self.has_path(child, to) {
                return true;
            }
        }
        false
    }

    // D-separation check (simplified)
    pub fn is_d_separated(&self, x: &str, y: &str, given: &[&str]) -> bool {
        // Simplified: just check if there's no direct path
        // Real implementation would implement full d-separation
        !self.has_path(x, y) && !self.has_path(y, x)
    }
}

// Builder pattern for common causal structures
pub struct CausalModelBuilder {
    model: CausalModel,
}

impl CausalModelBuilder {
    pub fn new() -> Self {
        Self { model: CausalModel::new() }
    }

    pub fn chain(variables: &[&str]) -> CausalModel {
        let mut model = CausalModel::new();
        for (i, var) in variables.iter().enumerate() {
            model = model.add_variable(CausalVariable::new(var));
            if i > 0 {
                model = model.add_cause(variables[i - 1], var);
            }
        }
        model
    }

    pub fn fork(cause: &str, effects: &[&str]) -> CausalModel {
        let mut model = CausalModel::new()
            .add_variable(CausalVariable::new(cause));

        for effect in effects {
            model = model
                .add_variable(CausalVariable::new(effect))
                .add_cause(cause, effect);
        }
        model
    }

    pub fn collider(causes: &[&str], effect: &str) -> CausalModel {
        let mut model = CausalModel::new()
            .add_variable(CausalVariable::new(effect));

        for cause in causes {
            model = model
                .add_variable(CausalVariable::new(cause))
                .add_cause(cause, effect);
        }
        model
    }

    pub fn build(self) -> CausalModel {
        self.model
    }
}

// ============================================================================
// Tests: Value
// ============================================================================

#[test]
fn test_value_empty() {
    let v = Value::empty();
    assert(v.is_empty());
}

#[test]
fn test_value_from_int() {
    let v = Value::from_int(42);
    assert(!v.is_empty());
}

#[test]
fn test_value_from_float() {
    let v = Value::from_float(3.14);
    assert(!v.is_empty());
}

#[test]
fn test_value_from_bool() {
    let v = Value::from_bool(true);
    assert(!v.is_empty());
}

#[test]
fn test_value_from_string() {
    let v = Value::from_string("test");
    assert(!v.is_empty());
}

#[test]
fn test_value_clone() {
    let v1 = Value::from_int(100);
    let v2 = v1.clone();
    assert(!v2.is_empty());
}

// ============================================================================
// Tests: CausalVariable
// ============================================================================

#[test]
fn test_causal_variable_new() {
    let v = CausalVariable::new("X");
    assert_eq(v.name, "X");
    assert(!v.observed);
}

#[test]
fn test_causal_variable_binary() {
    let v = CausalVariable::binary("treatment");
    assert(v.is_binary());
    assert(!v.is_continuous());
}

#[test]
fn test_causal_variable_continuous() {
    let v = CausalVariable::continuous("temperature");
    assert(v.is_continuous());
    assert(!v.is_binary());
}

#[test]
fn test_causal_variable_with_values() {
    let v = CausalVariable::new("grade")
        .with_values(vec![
            Value::from_string("A"),
            Value::from_string("B"),
            Value::from_string("C"),
        ]);
    assert_eq(v.domain.len(), 3);
}

#[test]
fn test_causal_variable_mark_observed() {
    let mut v = CausalVariable::new("X");
    assert(!v.observed);
    v.mark_observed();
    assert(v.observed);
}

// ============================================================================
// Tests: CausalEdge
// ============================================================================

#[test]
fn test_causal_edge_new() {
    let e = CausalEdge::new("A", "B");
    assert_eq(e.from, "A");
    assert_eq(e.to, "B");
    assert_eq(e.strength, 1.0);
}

#[test]
fn test_causal_edge_with_strength() {
    let e = CausalEdge::new("X", "Y").with_strength(0.5);
    assert_eq(e.strength, 0.5);
}

#[test]
fn test_causal_edge_strength_clamped() {
    let e = CausalEdge::new("X", "Y").with_strength(1.5);
    assert_eq(e.strength, 1.0);
}

#[test]
fn test_causal_edge_with_mechanism() {
    let e = CausalEdge::new("rain", "wet")
        .with_mechanism("precipitation causes ground wetness");
    assert(e.mechanism.is_some());
}

#[test]
fn test_causal_edge_is_strong() {
    let strong = CausalEdge::new("A", "B").with_strength(0.9);
    let weak = CausalEdge::new("A", "B").with_strength(0.3);
    assert(strong.is_strong());
    assert(!weak.is_strong());
}

// ============================================================================
// Tests: Explanation
// ============================================================================

#[test]
fn test_explanation_new() {
    let e = Explanation::new();
    assert_eq(e.cause_count(), 0);
    assert_eq(e.likelihood, 1.0);
}

#[test]
fn test_explanation_with_cause() {
    let e = Explanation::new()
        .with_cause("smoking", Value::from_bool(true));
    assert_eq(e.cause_count(), 1);
    assert(e.has_cause("smoking"));
}

#[test]
fn test_explanation_with_likelihood() {
    let e = Explanation::new().with_likelihood(0.8);
    assert_eq(e.likelihood, 0.8);
    assert(e.is_likely());
}

#[test]
fn test_explanation_with_reasoning() {
    let e = Explanation::new()
        .with_reasoning("Based on observed correlations");
    assert_eq(e.reasoning, "Based on observed correlations");
}

#[test]
fn test_explanation_multiple_causes() {
    let e = Explanation::new()
        .with_cause("A", Value::from_bool(true))
        .with_cause("B", Value::from_bool(false))
        .with_cause("C", Value::from_int(42));
    assert_eq(e.cause_count(), 3);
}

#[test]
fn test_explanation_is_likely() {
    let likely = Explanation::new().with_likelihood(0.7);
    let unlikely = Explanation::new().with_likelihood(0.3);
    assert(likely.is_likely());
    assert(!unlikely.is_likely());
}

// ============================================================================
// Tests: Intervention
// ============================================================================

#[test]
fn test_intervention_set() {
    let i = Intervention::set("treatment", Value::from_bool(true));
    assert_eq(i.variable, "treatment");
}

// ============================================================================
// Tests: CausalQuery
// ============================================================================

#[test]
fn test_causal_query_probability_of() {
    let q = CausalQuery::probability_of("outcome");
    assert_eq(q.target, "outcome");
    assert(q.is_observational());
}

#[test]
fn test_causal_query_given() {
    let q = CausalQuery::probability_of("Y")
        .given("X", Value::from_bool(true));
    assert_eq(q.given.len(), 1);
}

#[test]
fn test_causal_query_do_intervention() {
    let q = CausalQuery::probability_of("recovery")
        .do_intervention(Intervention::set("treatment", Value::from_bool(true)));
    assert(q.is_interventional());
}

#[test]
fn test_causal_query_observational() {
    let q = CausalQuery::probability_of("X");
    assert(q.is_observational());
    assert(!q.is_interventional());
}

// ============================================================================
// Tests: CausalModel Basic
// ============================================================================

#[test]
fn test_causal_model_new() {
    let m = CausalModel::new();
    assert_eq(m.variable_count(), 0);
    assert_eq(m.edge_count(), 0);
}

#[test]
fn test_causal_model_add_variable() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("X"));
    assert_eq(m.variable_count(), 1);
    assert(m.has_variable("X"));
}

#[test]
fn test_causal_model_add_cause() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("X"))
        .add_variable(CausalVariable::new("Y"))
        .add_cause("X", "Y");
    assert_eq(m.edge_count(), 1);
}

#[test]
fn test_causal_model_add_edge() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("A"))
        .add_variable(CausalVariable::new("B"))
        .add_edge(CausalEdge::new("A", "B").with_strength(0.8));
    assert_eq(m.edge_count(), 1);
}

#[test]
fn test_causal_model_get_variable() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::binary("treatment"));
    let v = m.get_variable("treatment");
    assert(v.is_some());
    assert(v.unwrap().is_binary());
}

// ============================================================================
// Tests: CausalModel Graph Structure
// ============================================================================

#[test]
fn test_causal_model_parents_of() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("X"))
        .add_variable(CausalVariable::new("Y"))
        .add_variable(CausalVariable::new("Z"))
        .add_cause("X", "Z")
        .add_cause("Y", "Z");
    let parents = m.parents_of("Z");
    assert_eq(parents.len(), 2);
}

#[test]
fn test_causal_model_children_of() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("X"))
        .add_variable(CausalVariable::new("Y"))
        .add_variable(CausalVariable::new("Z"))
        .add_cause("X", "Y")
        .add_cause("X", "Z");
    let children = m.children_of("X");
    assert_eq(children.len(), 2);
}

#[test]
fn test_causal_model_is_root() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("X"))
        .add_variable(CausalVariable::new("Y"))
        .add_cause("X", "Y");
    assert(m.is_root("X"));
    assert(!m.is_root("Y"));
}

#[test]
fn test_causal_model_is_leaf() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("X"))
        .add_variable(CausalVariable::new("Y"))
        .add_cause("X", "Y");
    assert(!m.is_leaf("X"));
    assert(m.is_leaf("Y"));
}

#[test]
fn test_causal_model_roots() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("A"))
        .add_variable(CausalVariable::new("B"))
        .add_variable(CausalVariable::new("C"))
        .add_cause("A", "C")
        .add_cause("B", "C");
    let roots = m.roots();
    assert_eq(roots.len(), 2);
}

#[test]
fn test_causal_model_leaves() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("X"))
        .add_variable(CausalVariable::new("Y"))
        .add_variable(CausalVariable::new("Z"))
        .add_cause("X", "Y")
        .add_cause("X", "Z");
    let leaves = m.leaves();
    assert_eq(leaves.len(), 2);
}

#[test]
fn test_causal_model_has_path_direct() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("X"))
        .add_variable(CausalVariable::new("Y"))
        .add_cause("X", "Y");
    assert(m.has_path("X", "Y"));
    assert(!m.has_path("Y", "X"));
}

#[test]
fn test_causal_model_has_path_indirect() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("X"))
        .add_variable(CausalVariable::new("Y"))
        .add_variable(CausalVariable::new("Z"))
        .add_cause("X", "Y")
        .add_cause("Y", "Z");
    assert(m.has_path("X", "Z"));
}

#[test]
fn test_causal_model_has_path_self() {
    let m = CausalModel::new()
        .add_variable(CausalVariable::new("X"));
    assert(m.has_path("X", "X"));
}

// ============================================================================
// Tests: CausalModelBuilder
// ============================================================================

#[test]
fn test_builder_chain() {
    let m = CausalModelBuilder::chain(&["A", "B", "C"]);
    assert_eq(m.variable_count(), 3);
    assert_eq(m.edge_count(), 2);
    assert(m.has_path("A", "C"));
}

#[test]
fn test_builder_fork() {
    let m = CausalModelBuilder::fork("cause", &["effect1", "effect2", "effect3"]);
    assert_eq(m.variable_count(), 4);
    assert_eq(m.edge_count(), 3);
    assert(m.is_root("cause"));
}

#[test]
fn test_builder_collider() {
    let m = CausalModelBuilder::collider(&["A", "B"], "C");
    assert_eq(m.variable_count(), 3);
    assert_eq(m.edge_count(), 2);
    let parents = m.parents_of("C");
    assert_eq(parents.len(), 2);
}

fn main() {
    print("Omen causal reasoning tests");
}
