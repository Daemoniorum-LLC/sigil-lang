impl Predicate {
    pub fn always_true() -> Self {
        Self { kind: PredicateKind::AlwaysTrue }
    }

    pub fn always_false() -> Self {
        Self { kind: PredicateKind::AlwaysFalse }
    }

    pub fn has_variable(name: &str) -> Self {
        Self { kind: PredicateKind::HasVariable { name: name.to_string() } }
    }

    pub fn custom(description: &str) -> Self {
        Self { kind: PredicateKind::Custom { description: description.to_string() } }
    }

    pub fn evaluate(&self, state: &State) -> bool {
        match &self.kind {
            PredicateKind::AlwaysTrue => true,
            PredicateKind::AlwaysFalse => false,
            PredicateKind::HasVariable { name } => state.has(name),
            PredicateKind::Custom { .. } => true,
        }
    }

    pub fn description(&self) -> String {
        match &self.kind {
            PredicateKind::AlwaysTrue => "always_true".to_string(),
            PredicateKind::AlwaysFalse => "always_false".to_string(),
            PredicateKind::HasVariable { name } => format!("has_{}", name),
            PredicateKind::Custom { description } => description.clone(),
