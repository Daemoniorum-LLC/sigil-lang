//! Tests for Omen Goal System
//!
//! Verifies Goal, GoalStatus, Predicate, Constraint, and GoalManager.

use std::collections::HashMap;

// ============================================================================
// Self-contained Test Types
// ============================================================================

pub struct GoalId { bytes: [u8; 16] }
fn uuid_v7() -> [u8; 16] { [0u8; 16] }

impl GoalId {
    pub fn new() -> Self { Self { bytes: uuid_v7() } }
}

impl Clone for GoalId {
    fn clone(&self) -> Self { Self { bytes: self.bytes } }
}

impl PartialEq for GoalId {
    fn eq(&self, other: &Self) -> bool {
        self.bytes == other.bytes
    }
}

pub struct Duration { nanos: u64 }

impl Duration {
    pub fn zero() -> Self { Self { nanos: 0 } }
    pub fn seconds(s: u64) -> Self { Self { nanos: s * 1_000_000_000 } }
    pub fn minutes(m: u64) -> Self { Self { nanos: m * 60_000_000_000 } }
    pub fn hours(h: u64) -> Self { Self { nanos: h * 3_600_000_000_000 } }
    pub fn days(d: u64) -> Self { Self { nanos: d * 86_400_000_000_000 } }
}

impl Copy for Duration {}
impl Clone for Duration {
    fn clone(&self) -> Self { *self }
}

pub struct Timestamp { nanos: u64 }

impl Timestamp {
    pub fn now() -> Self { Self { nanos: 1000 } }
}

impl std::ops::Add<Duration> for Timestamp {
    type Output = Self;
    fn add(self, d: Duration) -> Self {
        Self { nanos: self.nanos + d.nanos }
    }
}

pub enum GoalStatus {
    Pending,
    Active,
    Blocked { reason: String },
    Achieved,
    Failed { reason: String },
    Abandoned { reason: String },
}

impl GoalStatus {
    pub fn is_terminal(&self) -> bool {
        match self {
            GoalStatus::Achieved |
            GoalStatus::Failed { .. } |
            GoalStatus::Abandoned { .. } => true,
            _ => false,
        }
    }

    pub fn is_actionable(&self) -> bool {
        match self {
            GoalStatus::Pending | GoalStatus::Active => true,
            _ => false,
        }
    }
}

pub struct Value { inner: Vec<u8> }

impl Value {
    pub fn empty() -> Self { Self { inner: vec![] } }
}

impl Clone for Value {
    fn clone(&self) -> Self { Self { inner: self.inner.clone() } }
}

pub struct State {
    pub variables: HashMap<String, Value>,
}

impl State {
    pub fn new() -> Self { Self { variables: HashMap::new() } }

    pub fn with_var(mut self, name: &str, value: Value) -> Self {
        self.variables.insert(name.to_string(), value);
        self
    }

    pub fn has(&self, name: &str) -> bool {
        self.variables.contains_key(name)
    }
}

// Simplified Predicate without closures for testing
pub struct Predicate {
    kind: PredicateKind,
}

pub enum PredicateKind {
    AlwaysTrue,
    AlwaysFalse,
    HasVariable { name: String },
    Custom { description: String },
}

impl Predicate {
    pub fn always_true() -> Self {
        Self { kind: PredicateKind::AlwaysTrue }
    }

    pub fn always_false() -> Self {
        Self { kind: PredicateKind::AlwaysFalse }
    }

    pub fn has_variable(name: &str) -> Self {
        Self { kind: PredicateKind::HasVariable { name: name.to_string() } }
    }

    pub fn custom(description: &str) -> Self {
        Self { kind: PredicateKind::Custom { description: description.to_string() } }
    }

    pub fn evaluate(&self, state: &State) -> bool {
        match &self.kind {
            PredicateKind::AlwaysTrue => true,
            PredicateKind::AlwaysFalse => false,
            PredicateKind::HasVariable { name } => state.has(name),
            PredicateKind::Custom { .. } => true,
        }
    }

    pub fn description(&self) -> String {
        match &self.kind {
            PredicateKind::AlwaysTrue => "always_true".to_string(),
            PredicateKind::AlwaysFalse => "always_false".to_string(),
            PredicateKind::HasVariable { name } => format!("has_{}", name),
            PredicateKind::Custom { description } => description.clone(),
        }
    }
}

// Simplified Constraint
pub struct Constraint {
    pub name: String,
    pub kind: ConstraintKind,
}

pub enum ConstraintKind {
    Deadline { duration: Duration },
    ResourceLimit { resource: String, max: f32 },
    NoSideEffects,
    RequiresCapability { capability: String },
    Custom { description: String },
}

impl Constraint {
    pub fn deadline(duration: Duration) -> Self {
        Self {
            name: "deadline".to_string(),
            kind: ConstraintKind::Deadline { duration },
        }
    }

    pub fn resource_limit(resource: &str, max: f32) -> Self {
        Self {
            name: format!("resource_{}", resource),
            kind: ConstraintKind::ResourceLimit {
                resource: resource.to_string(),
                max,
            },
        }
    }

    pub fn no_side_effects() -> Self {
        Self {
            name: "no_side_effects".to_string(),
            kind: ConstraintKind::NoSideEffects,
        }
    }

    pub fn requires_capability(capability: &str) -> Self {
        Self {
            name: format!("requires_{}", capability),
            kind: ConstraintKind::RequiresCapability {
                capability: capability.to_string(),
            },
        }
    }

    pub fn custom(name: &str, description: &str) -> Self {
        Self {
            name: name.to_string(),
            kind: ConstraintKind::Custom { description: description.to_string() },
        }
    }

    pub fn is_deadline(&self) -> bool {
        match self.kind {
            ConstraintKind::Deadline { .. } => true,
            _ => false,
        }
    }
}

pub struct Goal {
    pub id: GoalId,
    pub description: String,
    pub success: Predicate,
    pub priority: f32,
    pub constraints: Vec<Constraint>,
    pub deadline: Option<Timestamp>,
    pub parent: Option<GoalId>,
    pub status: GoalStatus,
}

impl Goal {
    pub fn new(description: &str) -> Self {
        Self {
            id: GoalId::new(),
            description: description.to_string(),
            success: Predicate::always_false(),
            priority: 0.5,
            constraints: vec![],
            deadline: None,
            parent: None,
            status: GoalStatus::Pending,
        }
    }

    pub fn with_priority(mut self, priority: f32) -> Self {
        self.priority = priority.clamp(0.0, 1.0);
        self
    }

    pub fn with_deadline(mut self, duration: Duration) -> Self {
        self.deadline = Some(Timestamp::now() + duration);
        self
    }

    pub fn with_constraint(mut self, constraint: Constraint) -> Self {
        self.constraints.push(constraint);
        self
    }

    pub fn with_success(mut self, predicate: Predicate) -> Self {
        self.success = predicate;
        self
    }

    pub fn with_parent(mut self, parent: GoalId) -> Self {
        self.parent = Some(parent);
        self
    }

    pub fn activate(&mut self) {
        self.status = GoalStatus::Active;
    }

    pub fn block(&mut self, reason: &str) {
        self.status = GoalStatus::Blocked { reason: reason.to_string() };
    }

    pub fn achieve(&mut self) {
        self.status = GoalStatus::Achieved;
    }

    pub fn fail(&mut self, reason: &str) {
        self.status = GoalStatus::Failed { reason: reason.to_string() };
    }

    pub fn abandon(&mut self, reason: &str) {
        self.status = GoalStatus::Abandoned { reason: reason.to_string() };
    }

    pub fn is_achieved(&self) -> bool {
        match self.status {
            GoalStatus::Achieved => true,
            _ => false,
        }
    }

    pub fn is_active(&self) -> bool {
        match self.status {
            GoalStatus::Active => true,
            _ => false,
        }
    }

    pub fn has_deadline(&self) -> bool {
        self.deadline.is_some()
    }

    pub fn is_subgoal(&self) -> bool {
        self.parent.is_some()
    }
}

pub struct GoalManager {
    goals: HashMap<String, Goal>,
    id_counter: usize,
}

impl GoalManager {
    pub fn new() -> Self {
        Self {
            goals: HashMap::new(),
            id_counter: 0,
        }
    }

    pub fn add(&mut self, goal: Goal) -> String {
        let key = format!("goal_{}", self.id_counter);
        self.id_counter += 1;
        self.goals.insert(key.clone(), goal);
        key
    }

    pub fn get(&self, key: &str) -> Option<&Goal> {
        self.goals.get(key)
    }

    pub fn get_mut(&mut self, key: &str) -> Option<&mut Goal> {
        self.goals.get_mut(key)
    }

    pub fn current(&self) -> Option<&Goal> {
        self.goals.values()
            .filter(|g| matches!(g.status, GoalStatus::Active))
            .max_by(|a, b| a.priority.partial_cmp(&b.priority).unwrap())
    }

    pub fn pending(&self) -> Vec<&Goal> {
        self.goals.values()
            .filter(|g| matches!(g.status, GoalStatus::Pending))
            .collect()
    }

    pub fn active(&self) -> Vec<&Goal> {
        self.goals.values()
            .filter(|g| matches!(g.status, GoalStatus::Active))
            .collect()
    }

    pub fn count(&self) -> usize {
        self.goals.len()
    }

    pub fn count_active(&self) -> usize {
        self.active().len()
    }

    pub fn count_pending(&self) -> usize {
        self.pending().len()
    }

    pub fn highest_priority(&self) -> Option<&Goal> {
        self.goals.values()
            .filter(|g| g.status.is_actionable())
            .max_by(|a, b| a.priority.partial_cmp(&b.priority).unwrap())
    }
}

// ============================================================================
// Tests: GoalStatus
// ============================================================================

#[test]
fn test_goal_status_pending() {
    let status = GoalStatus::Pending;
    assert(!status.is_terminal());
    assert(status.is_actionable());
}

#[test]
fn test_goal_status_active() {
    let status = GoalStatus::Active;
    assert(!status.is_terminal());
    assert(status.is_actionable());
}

#[test]
fn test_goal_status_blocked() {
    let status = GoalStatus::Blocked { reason: "waiting".to_string() };
    assert(!status.is_terminal());
    assert(!status.is_actionable());
}

#[test]
fn test_goal_status_achieved() {
    let status = GoalStatus::Achieved;
    assert(status.is_terminal());
    assert(!status.is_actionable());
}

#[test]
fn test_goal_status_failed() {
    let status = GoalStatus::Failed { reason: "error".to_string() };
    assert(status.is_terminal());
    assert(!status.is_actionable());
}

#[test]
fn test_goal_status_abandoned() {
    let status = GoalStatus::Abandoned { reason: "deprioritized".to_string() };
    assert(status.is_terminal());
    assert(!status.is_actionable());
}

// ============================================================================
// Tests: Predicate
// ============================================================================

#[test]
fn test_predicate_always_true() {
    let p = Predicate::always_true();
    let state = State::new();
    assert(p.evaluate(&state));
}

#[test]
fn test_predicate_always_false() {
    let p = Predicate::always_false();
    let state = State::new();
    assert(!p.evaluate(&state));
}

#[test]
fn test_predicate_has_variable_present() {
    let p = Predicate::has_variable("x");
    let state = State::new().with_var("x", Value::empty());
    assert(p.evaluate(&state));
}

#[test]
fn test_predicate_has_variable_missing() {
    let p = Predicate::has_variable("x");
    let state = State::new();
    assert(!p.evaluate(&state));
}

#[test]
fn test_predicate_custom() {
    let p = Predicate::custom("user is authenticated");
    assert_eq(p.description(), "user is authenticated");
}

#[test]
fn test_predicate_description_always_true() {
    let p = Predicate::always_true();
    assert_eq(p.description(), "always_true");
}

// ============================================================================
// Tests: Constraint
// ============================================================================

#[test]
fn test_constraint_deadline() {
    let c = Constraint::deadline(Duration::hours(2));
    assert_eq(c.name, "deadline");
    assert(c.is_deadline());
}

#[test]
fn test_constraint_resource_limit() {
    let c = Constraint::resource_limit("memory", 1024.0);
    assert_eq(c.name, "resource_memory");
    assert(!c.is_deadline());
}

#[test]
fn test_constraint_no_side_effects() {
    let c = Constraint::no_side_effects();
    assert_eq(c.name, "no_side_effects");
}

#[test]
fn test_constraint_requires_capability() {
    let c = Constraint::requires_capability("network_access");
    assert_eq(c.name, "requires_network_access");
}

#[test]
fn test_constraint_custom() {
    let c = Constraint::custom("budget", "stay under $100");
    assert_eq(c.name, "budget");
}

// ============================================================================
// Tests: Goal
// ============================================================================

#[test]
fn test_goal_new() {
    let g = Goal::new("complete the task");
    assert_eq(g.description, "complete the task");
    assert_eq(g.priority, 0.5);
}

#[test]
fn test_goal_with_priority() {
    let g = Goal::new("urgent").with_priority(0.9);
    assert_eq(g.priority, 0.9);
}

#[test]
fn test_goal_priority_clamped_high() {
    let g = Goal::new("test").with_priority(1.5);
    assert_eq(g.priority, 1.0);
}

#[test]
fn test_goal_priority_clamped_low() {
    let g = Goal::new("test").with_priority(-0.5);
    assert_eq(g.priority, 0.0);
}

#[test]
fn test_goal_with_deadline() {
    let g = Goal::new("timed task").with_deadline(Duration::hours(1));
    assert(g.has_deadline());
}

#[test]
fn test_goal_without_deadline() {
    let g = Goal::new("open ended");
    assert(!g.has_deadline());
}

#[test]
fn test_goal_with_constraint() {
    let g = Goal::new("constrained")
        .with_constraint(Constraint::no_side_effects());
    assert_eq(g.constraints.len(), 1);
}

#[test]
fn test_goal_multiple_constraints() {
    let g = Goal::new("multi-constrained")
        .with_constraint(Constraint::deadline(Duration::hours(1)))
        .with_constraint(Constraint::resource_limit("cpu", 80.0))
        .with_constraint(Constraint::no_side_effects());
    assert_eq(g.constraints.len(), 3);
}

#[test]
fn test_goal_with_success_predicate() {
    let g = Goal::new("checkable")
        .with_success(Predicate::has_variable("result"));
    let state = State::new().with_var("result", Value::empty());
    assert(g.success.evaluate(&state));
}

#[test]
fn test_goal_with_parent() {
    let parent = GoalId::new();
    let g = Goal::new("subgoal").with_parent(parent);
    assert(g.is_subgoal());
}

#[test]
fn test_goal_not_subgoal() {
    let g = Goal::new("top level");
    assert(!g.is_subgoal());
}

#[test]
fn test_goal_activate() {
    let mut g = Goal::new("task");
    g.activate();
    assert(g.is_active());
}

#[test]
fn test_goal_block() {
    let mut g = Goal::new("task");
    g.activate();
    g.block("waiting for input");
    let is_blocked = match g.status {
        GoalStatus::Blocked { .. } => true,
        _ => false,
    };
    assert(is_blocked);
}

#[test]
fn test_goal_achieve() {
    let mut g = Goal::new("task");
    g.activate();
    g.achieve();
    assert(g.is_achieved());
}

#[test]
fn test_goal_fail() {
    let mut g = Goal::new("task");
    g.activate();
    g.fail("ran out of time");
    let is_failed = match g.status {
        GoalStatus::Failed { .. } => true,
        _ => false,
    };
    assert(is_failed);
}

#[test]
fn test_goal_abandon() {
    let mut g = Goal::new("task");
    g.abandon("no longer needed");
    let is_abandoned = match g.status {
        GoalStatus::Abandoned { .. } => true,
        _ => false,
    };
    assert(is_abandoned);
}

// ============================================================================
// Tests: GoalManager
// ============================================================================

#[test]
fn test_goal_manager_new() {
    let mgr = GoalManager::new();
    assert_eq(mgr.count(), 0);
}

#[test]
fn test_goal_manager_add() {
    let mut mgr = GoalManager::new();
    mgr.add(Goal::new("first goal"));
    assert_eq(mgr.count(), 1);
}

#[test]
fn test_goal_manager_get() {
    let mut mgr = GoalManager::new();
    let key = mgr.add(Goal::new("retrievable"));
    let g = mgr.get(&key);
    assert(g.is_some());
    assert_eq(g.unwrap().description, "retrievable");
}

#[test]
fn test_goal_manager_get_mut() {
    let mut mgr = GoalManager::new();
    let key = mgr.add(Goal::new("mutable"));
    if let Some(g) = mgr.get_mut(&key) {
        g.activate();
    }
    assert(mgr.get(&key).unwrap().is_active());
}

#[test]
fn test_goal_manager_current_none() {
    let mgr = GoalManager::new();
    assert(mgr.current().is_none());
}

#[test]
fn test_goal_manager_current_active() {
    let mut mgr = GoalManager::new();
    let key = mgr.add(Goal::new("active goal").with_priority(0.8));
    mgr.get_mut(&key).unwrap().activate();
    let current = mgr.current();
    assert(current.is_some());
    assert_eq(current.unwrap().description, "active goal");
}

#[test]
fn test_goal_manager_current_highest_priority() {
    let mut mgr = GoalManager::new();
    let k1 = mgr.add(Goal::new("low priority").with_priority(0.3));
    let k2 = mgr.add(Goal::new("high priority").with_priority(0.9));
    mgr.get_mut(&k1).unwrap().activate();
    mgr.get_mut(&k2).unwrap().activate();
    let current = mgr.current();
    assert_eq(current.unwrap().description, "high priority");
}

#[test]
fn test_goal_manager_pending() {
    let mut mgr = GoalManager::new();
    mgr.add(Goal::new("pending 1"));
    mgr.add(Goal::new("pending 2"));
    let key = mgr.add(Goal::new("active"));
    mgr.get_mut(&key).unwrap().activate();
    assert_eq(mgr.pending().len(), 2);
}

#[test]
fn test_goal_manager_active() {
    let mut mgr = GoalManager::new();
    let k1 = mgr.add(Goal::new("active 1"));
    let k2 = mgr.add(Goal::new("active 2"));
    mgr.add(Goal::new("pending"));
    mgr.get_mut(&k1).unwrap().activate();
    mgr.get_mut(&k2).unwrap().activate();
    assert_eq(mgr.active().len(), 2);
}

#[test]
fn test_goal_manager_count_active() {
    let mut mgr = GoalManager::new();
    let key = mgr.add(Goal::new("the one"));
    mgr.get_mut(&key).unwrap().activate();
    mgr.add(Goal::new("pending"));
    assert_eq(mgr.count_active(), 1);
}

#[test]
fn test_goal_manager_count_pending() {
    let mut mgr = GoalManager::new();
    mgr.add(Goal::new("p1"));
    mgr.add(Goal::new("p2"));
    let key = mgr.add(Goal::new("active"));
    mgr.get_mut(&key).unwrap().activate();
    assert_eq(mgr.count_pending(), 2);
}

#[test]
fn test_goal_manager_highest_priority() {
    let mut mgr = GoalManager::new();
    mgr.add(Goal::new("low").with_priority(0.2));
    mgr.add(Goal::new("medium").with_priority(0.5));
    mgr.add(Goal::new("high").with_priority(0.8));
    let highest = mgr.highest_priority();
    assert(highest.is_some());
    assert_eq(highest.unwrap().description, "high");
}

#[test]
fn test_goal_manager_highest_priority_excludes_terminal() {
    let mut mgr = GoalManager::new();
    let k1 = mgr.add(Goal::new("achieved").with_priority(0.9));
    mgr.add(Goal::new("pending").with_priority(0.5));
    mgr.get_mut(&k1).unwrap().achieve();
    let highest = mgr.highest_priority();
    assert_eq(highest.unwrap().description, "pending");
}

fn main() {
    print("Omen goals tests");
}
