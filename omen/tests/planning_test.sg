//! Tests for Omen Planning System
//!
//! Verifies Plan, PlanStep, Action, Effect, ResourceCost, Risk, and strategies.

use std::collections::HashMap;

// ============================================================================
// Self-contained Test Types
// ============================================================================

pub struct PlanId { bytes: [u8; 16] }
pub struct StepId { bytes: [u8; 16] }
pub struct GoalId { bytes: [u8; 16] }
pub struct RiskId { bytes: [u8; 16] }

fn uuid_v7() -> [u8; 16] { [0u8; 16] }

impl PlanId {
    pub fn new() -> Self { Self { bytes: uuid_v7() } }
}

impl StepId {
    pub fn new() -> Self { Self { bytes: uuid_v7() } }
}

impl GoalId {
    pub fn new() -> Self { Self { bytes: uuid_v7() } }
}

impl RiskId {
    pub fn new() -> Self { Self { bytes: uuid_v7() } }
}

impl Clone for PlanId {
    fn clone(&self) -> Self { Self { bytes: self.bytes } }
}

impl Clone for StepId {
    fn clone(&self) -> Self { Self { bytes: self.bytes } }
}

impl Clone for GoalId {
    fn clone(&self) -> Self { Self { bytes: self.bytes } }
}

impl Clone for RiskId {
    fn clone(&self) -> Self { Self { bytes: self.bytes } }
}

pub struct Duration { nanos: u64 }

impl Duration {
    pub fn zero() -> Self { Self { nanos: 0 } }
    pub fn seconds(s: u64) -> Self { Self { nanos: s * 1_000_000_000 } }
    pub fn minutes(m: u64) -> Self { Self { nanos: m * 60_000_000_000 } }
    pub fn hours(h: u64) -> Self { Self { nanos: h * 3_600_000_000_000 } }
    pub fn as_secs(&self) -> u64 { self.nanos / 1_000_000_000 }
}

impl Copy for Duration {}
impl Clone for Duration {
    fn clone(&self) -> Self { *self }
}

impl std::ops::Add for Duration {
    type Output = Self;
    fn add(self, other: Self) -> Self {
        Self { nanos: self.nanos + other.nanos }
    }
}

pub struct Effect {
    pub description: String,
    pub probability: f32,
}

impl Effect {
    pub fn certain(description: &str) -> Self {
        Self {
            description: description.to_string(),
            probability: 1.0,
        }
    }

    pub fn probable(description: &str, probability: f32) -> Self {
        Self {
            description: description.to_string(),
            probability: probability.clamp(0.0, 1.0),
        }
    }

    pub fn unlikely(description: &str) -> Self {
        Self::probable(description, 0.2)
    }

    pub fn is_likely(&self) -> bool {
        self.probability >= 0.5
    }
}

impl Clone for Effect {
    fn clone(&self) -> Self {
        Self {
            description: self.description.clone(),
            probability: self.probability,
        }
    }
}

pub struct ResourceCost {
    pub time: Duration,
    pub compute: f32,
    pub api_calls: u32,
    pub custom: HashMap<String, f32>,
}

impl ResourceCost {
    pub fn zero() -> Self {
        Self {
            time: Duration::zero(),
            compute: 0.0,
            api_calls: 0,
            custom: HashMap::new(),
        }
    }

    pub fn time_only(duration: Duration) -> Self {
        Self {
            time: duration,
            compute: 0.0,
            api_calls: 0,
            custom: HashMap::new(),
        }
    }

    pub fn with_compute(mut self, compute: f32) -> Self {
        self.compute = compute;
        self
    }

    pub fn with_api_calls(mut self, calls: u32) -> Self {
        self.api_calls = calls;
        self
    }

    pub fn with_custom(mut self, name: &str, value: f32) -> Self {
        self.custom.insert(name.to_string(), value);
        self
    }

    pub fn total_time_secs(&self) -> u64 {
        self.time.as_secs()
    }

    pub fn is_free(&self) -> bool {
        self.time.nanos == 0 && self.compute == 0.0 && self.api_calls == 0
    }

    pub fn add(&self, other: &ResourceCost) -> Self {
        let mut custom = self.custom.clone();
        for (k, v) in &other.custom {
            *custom.entry(k.clone()).or_insert(0.0) += v;
        }
        Self {
            time: self.time + other.time,
            compute: self.compute + other.compute,
            api_calls: self.api_calls + other.api_calls,
            custom,
        }
    }
}

impl Default for ResourceCost {
    fn default() -> Self { Self::zero() }
}

impl Clone for ResourceCost {
    fn clone(&self) -> Self {
        Self {
            time: self.time,
            compute: self.compute,
            api_calls: self.api_calls,
            custom: self.custom.clone(),
        }
    }
}

pub struct Action {
    pub name: String,
    pub params: HashMap<String, String>,
    pub effects: Vec<Effect>,
    pub success_rate: f32,
    pub expected_duration: Duration,
    pub expected_cost: ResourceCost,
}

impl Action {
    pub fn new(name: &str) -> Self {
        Self {
            name: name.to_string(),
            params: HashMap::new(),
            effects: vec![],
            success_rate: 0.9,
            expected_duration: Duration::seconds(1),
            expected_cost: ResourceCost::default(),
        }
    }

    pub fn with_param(mut self, key: &str, value: &str) -> Self {
        self.params.insert(key.to_string(), value.to_string());
        self
    }

    pub fn with_effect(mut self, effect: Effect) -> Self {
        self.effects.push(effect);
        self
    }

    pub fn with_success_rate(mut self, rate: f32) -> Self {
        self.success_rate = rate.clamp(0.0, 1.0);
        self
    }

    pub fn with_duration(mut self, duration: Duration) -> Self {
        self.expected_duration = duration;
        self
    }

    pub fn with_cost(mut self, cost: ResourceCost) -> Self {
        self.expected_cost = cost;
        self
    }

    pub fn name(&self) -> &str {
        &self.name
    }

    pub fn is_reliable(&self) -> bool {
        self.success_rate >= 0.8
    }

    pub fn expected_effects(&self) -> Vec<&Effect> {
        self.effects.iter().filter(|e| e.is_likely()).collect()
    }
}

impl Clone for Action {
    fn clone(&self) -> Self {
        Self {
            name: self.name.clone(),
            params: self.params.clone(),
            effects: self.effects.clone(),
            success_rate: self.success_rate,
            expected_duration: self.expected_duration,
            expected_cost: self.expected_cost.clone(),
        }
    }
}

pub struct PlanStep {
    pub id: StepId,
    pub action: Action,
    pub confidence: f32,
    pub duration: Duration,
    pub cost: ResourceCost,
    pub contingency: Option<PlanId>,
}

impl PlanStep {
    pub fn from_action(action: Action) -> Self {
        Self {
            id: StepId::new(),
            confidence: action.success_rate,
            duration: action.expected_duration,
            cost: action.expected_cost.clone(),
            action,
            contingency: None,
        }
    }

    pub fn with_confidence(mut self, confidence: f32) -> Self {
        self.confidence = confidence.clamp(0.0, 1.0);
        self
    }

    pub fn with_contingency(mut self, plan: PlanId) -> Self {
        self.contingency = Some(plan);
        self
    }

    pub fn is_risky(&self) -> bool {
        self.confidence < 0.7
    }

    pub fn has_contingency(&self) -> bool {
        self.contingency.is_some()
    }
}

pub enum Impact {
    PlanFailure,
    PartialSuccess { degree: f32 },
    IncreasedCost { factor: f32 },
    Delay { duration: Duration },
}

impl Impact {
    pub fn is_catastrophic(&self) -> bool {
        match self {
            Impact::PlanFailure => true,
            _ => false,
        }
    }

    pub fn severity(&self) -> f32 {
        match self {
            Impact::PlanFailure => 1.0,
            Impact::PartialSuccess { degree } => 1.0 - degree,
            Impact::IncreasedCost { factor } => (*factor - 1.0).min(1.0),
            Impact::Delay { duration } => (duration.as_secs() as f32 / 3600.0).min(1.0),
        }
    }
}

pub struct Mitigation {
    pub description: String,
    pub effectiveness: f32,
    pub cost: ResourceCost,
}

impl Mitigation {
    pub fn new(description: &str, effectiveness: f32) -> Self {
        Self {
            description: description.to_string(),
            effectiveness: effectiveness.clamp(0.0, 1.0),
            cost: ResourceCost::zero(),
        }
    }

    pub fn with_cost(mut self, cost: ResourceCost) -> Self {
        self.cost = cost;
        self
    }

    pub fn is_effective(&self) -> bool {
        self.effectiveness >= 0.5
    }
}

pub struct Risk {
    pub id: RiskId,
    pub description: String,
    pub probability: f32,
    pub impact: Impact,
    pub affected_steps: Vec<StepId>,
    pub mitigations: Vec<Mitigation>,
}

impl Risk {
    pub fn new(description: &str, probability: f32, impact: Impact) -> Self {
        Self {
            id: RiskId::new(),
            description: description.to_string(),
            probability: probability.clamp(0.0, 1.0),
            impact,
            affected_steps: vec![],
            mitigations: vec![],
        }
    }

    pub fn with_affected_step(mut self, step: StepId) -> Self {
        self.affected_steps.push(step);
        self
    }

    pub fn with_mitigation(mut self, mitigation: Mitigation) -> Self {
        self.mitigations.push(mitigation);
        self
    }

    pub fn expected_impact(&self) -> f32 {
        self.probability * self.impact.severity()
    }

    pub fn is_high_risk(&self) -> bool {
        self.expected_impact() >= 0.5
    }

    pub fn is_mitigated(&self) -> bool {
        self.mitigations.iter().any(|m| m.is_effective())
    }

    pub fn residual_risk(&self) -> f32 {
        if let Some(best) = self.mitigations.iter()
            .max_by(|a, b| a.effectiveness.partial_cmp(&b.effectiveness).unwrap())
        {
            self.expected_impact() * (1.0 - best.effectiveness)
        } else {
            self.expected_impact()
        }
    }
}

pub struct Plan {
    pub id: PlanId,
    pub goal: GoalId,
    pub steps: Vec<PlanStep>,
    pub success_probability: f32,
    pub expected_cost: ResourceCost,
    pub risks: Vec<Risk>,
    pub strategy: String,
}

impl Plan {
    pub fn new(goal: GoalId) -> Self {
        Self {
            id: PlanId::new(),
            goal,
            steps: vec![],
            success_probability: 1.0,
            expected_cost: ResourceCost::zero(),
            risks: vec![],
            strategy: "manual".to_string(),
        }
    }

    pub fn with_step(mut self, step: PlanStep) -> Self {
        self.expected_cost = self.expected_cost.add(&step.cost);
        self.success_probability *= step.confidence;
        self.steps.push(step);
        self
    }

    pub fn with_strategy(mut self, strategy: &str) -> Self {
        self.strategy = strategy.to_string();
        self
    }

    pub fn with_risk(mut self, risk: Risk) -> Self {
        self.risks.push(risk);
        self
    }

    pub fn step_count(&self) -> usize {
        self.steps.len()
    }

    pub fn is_empty(&self) -> bool {
        self.steps.is_empty()
    }

    pub fn total_duration(&self) -> Duration {
        let mut total = Duration::zero();
        for step in &self.steps {
            total = total + step.duration;
        }
        total
    }

    pub fn risky_steps(&self) -> Vec<&PlanStep> {
        self.steps.iter().filter(|s| s.is_risky()).collect()
    }

    pub fn is_viable(&self) -> bool {
        self.success_probability >= 0.5
    }

    pub fn high_risks(&self) -> Vec<&Risk> {
        self.risks.iter().filter(|r| r.is_high_risk()).collect()
    }

    pub fn recalculate_probability(&mut self) {
        self.success_probability = 1.0;
        for step in &self.steps {
            self.success_probability *= step.confidence;
        }
    }
}

pub struct ActionLibrary {
    actions: HashMap<String, Action>,
    success_counts: HashMap<String, (u32, u32)>,
}

impl ActionLibrary {
    pub fn new() -> Self {
        Self {
            actions: HashMap::new(),
            success_counts: HashMap::new(),
        }
    }

    pub fn register(&mut self, action: Action) {
        self.actions.insert(action.name.clone(), action);
    }

    pub fn get(&self, name: &str) -> Option<&Action> {
        self.actions.get(name)
    }

    pub fn count(&self) -> usize {
        self.actions.len()
    }

    pub fn update_success_rate(&mut self, name: &str, succeeded: bool) {
        let counts = self.success_counts.entry(name.to_string())
            .or_insert((0, 0));

        if succeeded {
            counts.0 += 1;
        }
        counts.1 += 1;

        if let Some(action) = self.actions.get_mut(name) {
            action.success_rate = counts.0 as f32 / counts.1 as f32;
        }
    }

    pub fn success_rate(&self, name: &str) -> Option<f32> {
        self.success_counts.get(name).map(|(s, t)| *s as f32 / *t as f32)
    }
}

// ============================================================================
// Tests: Effect
// ============================================================================

#[test]
fn test_effect_certain() {
    let e = Effect::certain("file created");
    assert_eq(e.probability, 1.0);
    assert(e.is_likely());
}

#[test]
fn test_effect_probable() {
    let e = Effect::probable("might succeed", 0.7);
    assert_eq(e.probability, 0.7);
    assert(e.is_likely());
}

#[test]
fn test_effect_unlikely() {
    let e = Effect::unlikely("rare event");
    assert_eq(e.probability, 0.2);
    assert(!e.is_likely());
}

#[test]
fn test_effect_probability_clamped() {
    let e = Effect::probable("test", 1.5);
    assert_eq(e.probability, 1.0);
}

#[test]
fn test_effect_clone() {
    let e1 = Effect::certain("test");
    let e2 = e1.clone();
    assert_eq(e1.probability, e2.probability);
}

// ============================================================================
// Tests: ResourceCost
// ============================================================================

#[test]
fn test_resource_cost_zero() {
    let c = ResourceCost::zero();
    assert(c.is_free());
}

#[test]
fn test_resource_cost_time_only() {
    let c = ResourceCost::time_only(Duration::minutes(5));
    assert(!c.is_free());
    assert_eq(c.total_time_secs(), 300);
}

#[test]
fn test_resource_cost_with_compute() {
    let c = ResourceCost::zero().with_compute(50.0);
    assert_eq(c.compute, 50.0);
}

#[test]
fn test_resource_cost_with_api_calls() {
    let c = ResourceCost::zero().with_api_calls(10);
    assert_eq(c.api_calls, 10);
}

#[test]
fn test_resource_cost_with_custom() {
    let c = ResourceCost::zero().with_custom("tokens", 1000.0);
    assert_eq(*c.custom.get("tokens").unwrap(), 1000.0);
}

#[test]
fn test_resource_cost_add() {
    let c1 = ResourceCost::time_only(Duration::seconds(60))
        .with_api_calls(5);
    let c2 = ResourceCost::time_only(Duration::seconds(30))
        .with_api_calls(3);
    let total = c1.add(&c2);
    assert_eq(total.total_time_secs(), 90);
    assert_eq(total.api_calls, 8);
}

#[test]
fn test_resource_cost_clone() {
    let c1 = ResourceCost::time_only(Duration::minutes(1));
    let c2 = c1.clone();
    assert_eq(c1.total_time_secs(), c2.total_time_secs());
}

// ============================================================================
// Tests: Action
// ============================================================================

#[test]
fn test_action_new() {
    let a = Action::new("fetch_data");
    assert_eq(a.name(), "fetch_data");
    assert_eq(a.success_rate, 0.9);
}

#[test]
fn test_action_with_param() {
    let a = Action::new("query")
        .with_param("table", "users");
    assert_eq(*a.params.get("table").unwrap(), "users");
}

#[test]
fn test_action_with_effect() {
    let a = Action::new("write")
        .with_effect(Effect::certain("file written"));
    assert_eq(a.effects.len(), 1);
}

#[test]
fn test_action_with_success_rate() {
    let a = Action::new("risky").with_success_rate(0.5);
    assert_eq(a.success_rate, 0.5);
}

#[test]
fn test_action_success_rate_clamped() {
    let a = Action::new("test").with_success_rate(1.5);
    assert_eq(a.success_rate, 1.0);
}

#[test]
fn test_action_with_duration() {
    let a = Action::new("slow").with_duration(Duration::hours(1));
    assert_eq(a.expected_duration.as_secs(), 3600);
}

#[test]
fn test_action_with_cost() {
    let a = Action::new("expensive")
        .with_cost(ResourceCost::time_only(Duration::minutes(5)));
    assert_eq(a.expected_cost.total_time_secs(), 300);
}

#[test]
fn test_action_is_reliable() {
    let reliable = Action::new("solid").with_success_rate(0.9);
    let unreliable = Action::new("flaky").with_success_rate(0.5);
    assert(reliable.is_reliable());
    assert(!unreliable.is_reliable());
}

#[test]
fn test_action_expected_effects() {
    let a = Action::new("mixed")
        .with_effect(Effect::certain("main effect"))
        .with_effect(Effect::unlikely("side effect"));
    let expected = a.expected_effects();
    assert_eq(expected.len(), 1);
}

#[test]
fn test_action_clone() {
    let a1 = Action::new("test");
    let a2 = a1.clone();
    assert_eq(a1.name, a2.name);
}

// ============================================================================
// Tests: PlanStep
// ============================================================================

#[test]
fn test_plan_step_from_action() {
    let action = Action::new("do_thing").with_success_rate(0.8);
    let step = PlanStep::from_action(action);
    assert_eq(step.confidence, 0.8);
}

#[test]
fn test_plan_step_with_confidence() {
    let step = PlanStep::from_action(Action::new("test"))
        .with_confidence(0.6);
    assert_eq(step.confidence, 0.6);
}

#[test]
fn test_plan_step_with_contingency() {
    let contingency = PlanId::new();
    let step = PlanStep::from_action(Action::new("risky"))
        .with_contingency(contingency);
    assert(step.has_contingency());
}

#[test]
fn test_plan_step_is_risky() {
    let risky = PlanStep::from_action(Action::new("test"))
        .with_confidence(0.5);
    let safe = PlanStep::from_action(Action::new("test"))
        .with_confidence(0.9);
    assert(risky.is_risky());
    assert(!safe.is_risky());
}

#[test]
fn test_plan_step_no_contingency() {
    let step = PlanStep::from_action(Action::new("test"));
    assert(!step.has_contingency());
}

// ============================================================================
// Tests: Impact
// ============================================================================

#[test]
fn test_impact_plan_failure_catastrophic() {
    let impact = Impact::PlanFailure;
    assert(impact.is_catastrophic());
    assert_eq(impact.severity(), 1.0);
}

#[test]
fn test_impact_partial_success() {
    let impact = Impact::PartialSuccess { degree: 0.7 };
    assert(!impact.is_catastrophic());
    assert_eq(impact.severity(), 0.3);
}

#[test]
fn test_impact_increased_cost() {
    let impact = Impact::IncreasedCost { factor: 1.5 };
    assert(!impact.is_catastrophic());
    assert_eq(impact.severity(), 0.5);
}

#[test]
fn test_impact_delay() {
    let impact = Impact::Delay { duration: Duration::hours(1) };
    assert(!impact.is_catastrophic());
}

