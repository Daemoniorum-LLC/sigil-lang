#[test]
fn test_mitigation_new() {
    let m = Mitigation::new("retry logic", 0.8);
    assert_eq(m.effectiveness, 0.8);
    assert(m.is_effective());
}

#[test]
fn test_mitigation_with_cost() {
    let m = Mitigation::new("backup", 0.9)
        .with_cost(ResourceCost::time_only(Duration::minutes(10)));
    assert_eq(m.cost.total_time_secs(), 600);
}

#[test]
fn test_mitigation_not_effective() {
    let m = Mitigation::new("weak fix", 0.3);
    assert(!m.is_effective());
}

// ============================================================================
// Tests: Risk
// ============================================================================

#[test]
fn test_risk_new() {
    let r = Risk::new("network failure", 0.2, Impact::PlanFailure);
    assert_eq(r.probability, 0.2);
}

#[test]
fn test_risk_with_affected_step() {
    let step_id = StepId::new();
    let r = Risk::new("test", 0.3, Impact::PlanFailure)
        .with_affected_step(step_id);
    assert_eq(r.affected_steps.len(), 1);
}

#[test]
fn test_risk_with_mitigation() {
    let r = Risk::new("test", 0.5, Impact::PlanFailure)
        .with_mitigation(Mitigation::new("retry", 0.7));
    assert_eq(r.mitigations.len(), 1);
}

#[test]
fn test_risk_expected_impact() {
    let r = Risk::new("test", 0.5, Impact::PlanFailure);
    assert_eq(r.expected_impact(), 0.5);
}

#[test]
fn test_risk_is_high_risk() {
    let high = Risk::new("bad", 0.8, Impact::PlanFailure);
    let low = Risk::new("minor", 0.1, Impact::Delay { duration: Duration::minutes(5) });
    assert(high.is_high_risk());
    assert(!low.is_high_risk());
}

#[test]
fn test_risk_is_mitigated() {
    let mitigated = Risk::new("test", 0.5, Impact::PlanFailure)
        .with_mitigation(Mitigation::new("fix", 0.8));
    let unmitigated = Risk::new("test", 0.5, Impact::PlanFailure);
    assert(mitigated.is_mitigated());
    assert(!unmitigated.is_mitigated());
}

#[test]
fn test_risk_residual_risk() {
    let r = Risk::new("test", 0.5, Impact::PlanFailure)
        .with_mitigation(Mitigation::new("fix", 0.5));
    // expected_impact = 0.5, effectiveness = 0.5
    // residual = 0.5 * (1 - 0.5) = 0.25
    assert_eq(r.residual_risk(), 0.25);
}

// ============================================================================
// Tests: Plan
// ============================================================================

#[test]
fn test_plan_new() {
    let goal = GoalId::new();
    let plan = Plan::new(goal);
    assert(plan.is_empty());
    assert_eq(plan.success_probability, 1.0);
}

#[test]
fn test_plan_with_step() {
    let plan = Plan::new(GoalId::new())
        .with_step(PlanStep::from_action(Action::new("step1")));
    assert_eq(plan.step_count(), 1);
}

#[test]
fn test_plan_with_strategy() {
    let plan = Plan::new(GoalId::new())
        .with_strategy("HTN");
    assert_eq(plan.strategy, "HTN");
}

#[test]
fn test_plan_with_risk() {
    let plan = Plan::new(GoalId::new())
        .with_risk(Risk::new("test", 0.3, Impact::PlanFailure));
    assert_eq(plan.risks.len(), 1);
}

#[test]
fn test_plan_success_probability_computed() {
    let plan = Plan::new(GoalId::new())
        .with_step(PlanStep::from_action(Action::new("s1")).with_confidence(0.9))
        .with_step(PlanStep::from_action(Action::new("s2")).with_confidence(0.9));
    // 0.9 * 0.9 = 0.81
    let diff = (plan.success_probability - 0.81).abs();
    assert(diff < 0.01);
}

#[test]
fn test_plan_total_duration() {
    let plan = Plan::new(GoalId::new())
        .with_step(PlanStep::from_action(Action::new("s1").with_duration(Duration::seconds(30))))
        .with_step(PlanStep::from_action(Action::new("s2").with_duration(Duration::seconds(30))));
    assert_eq(plan.total_duration().as_secs(), 60);
}

#[test]
fn test_plan_risky_steps() {
    let plan = Plan::new(GoalId::new())
        .with_step(PlanStep::from_action(Action::new("safe")).with_confidence(0.9))
        .with_step(PlanStep::from_action(Action::new("risky")).with_confidence(0.5));
    assert_eq(plan.risky_steps().len(), 1);
}

#[test]
fn test_plan_is_viable() {
    let viable = Plan::new(GoalId::new())
        .with_step(PlanStep::from_action(Action::new("s")).with_confidence(0.9));
    let not_viable = Plan::new(GoalId::new())
        .with_step(PlanStep::from_action(Action::new("s")).with_confidence(0.4));
    assert(viable.is_viable());
    assert(!not_viable.is_viable());
}

#[test]
fn test_plan_high_risks() {
    let plan = Plan::new(GoalId::new())
        .with_risk(Risk::new("high", 0.8, Impact::PlanFailure))
        .with_risk(Risk::new("low", 0.1, Impact::Delay { duration: Duration::minutes(5) }));
    assert_eq(plan.high_risks().len(), 1);
}

#[test]
fn test_plan_recalculate_probability() {
    let mut plan = Plan::new(GoalId::new())
        .with_step(PlanStep::from_action(Action::new("s")).with_confidence(0.8));
    plan.steps[0].confidence = 0.5;
    plan.recalculate_probability();
    assert_eq(plan.success_probability, 0.5);
}

// ============================================================================
// Tests: ActionLibrary
// ============================================================================

#[test]
fn test_action_library_new() {
    let lib = ActionLibrary::new();
    assert_eq(lib.count(), 0);
}

#[test]
fn test_action_library_register() {
    let mut lib = ActionLibrary::new();
    lib.register(Action::new("fetch"));
    assert_eq(lib.count(), 1);
}

#[test]
fn test_action_library_get() {
    let mut lib = ActionLibrary::new();
    lib.register(Action::new("process"));
    let a = lib.get("process");
    assert(a.is_some());
}

#[test]
fn test_action_library_get_missing() {
    let lib = ActionLibrary::new();
    let a = lib.get("nonexistent");
    assert(a.is_none());
}

#[test]
fn test_action_library_update_success_rate() {
    let mut lib = ActionLibrary::new();
    lib.register(Action::new("test"));
    lib.update_success_rate("test", true);
    lib.update_success_rate("test", false);
    // 1 success out of 2 = 0.5
    assert_eq(lib.get("test").unwrap().success_rate, 0.5);
}

#[test]
fn test_action_library_success_rate_tracking() {
    let mut lib = ActionLibrary::new();
    lib.register(Action::new("tracked"));
    lib.update_success_rate("tracked", true);
    lib.update_success_rate("tracked", true);
    lib.update_success_rate("tracked", false);
    let rate = lib.success_rate("tracked");
    assert(rate.is_some());
    // 2/3 ≈ 0.667
    let diff = (rate.unwrap() - 0.667).abs();
    assert(diff < 0.01);
}

fn main() {
    print("Omen planning tests");
}
