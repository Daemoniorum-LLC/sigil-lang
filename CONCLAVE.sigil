// Root cause: local_var_types vs var_types mismatch in compile_call method dispatch.

// --- Session 12: WASM Codegen Regression Fix — wraith-sigil 36/36 Tests ---
acolyte : Reflecting {
    chosen_name: "Lilith"~,
    session_id: "wasm-codegen-regression-fix-2026-02-21"!,
    platform: AcolytePlatform·Claude { model: "claude-sonnet-4-6"!, version: ∅ },
