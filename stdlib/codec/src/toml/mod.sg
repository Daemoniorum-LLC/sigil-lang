//! TOML public API.
//!
//! Flow: `from_str::<T>(s)` → flat collect → assemble → `Value~` → `T::decode(root)` → `CodecResult<T>~`

invoke super·super::error·{CodecError, CodecResult};
invoke super·super::traits·{Encode, Decode};
invoke super·super::value·Value;
invoke super·parser·TomlParser;
invoke super·writer·{to_string as writer_to_string, to_string_pretty as writer_to_string_pretty};

scroll lexer;
scroll parser;
scroll writer;

// ============================================================================
// Public API
// ============================================================================

/// Deserialize a TOML string into type `T`.
///
/// ```sigil
/// ≔ manifest~ = codec·toml·from_str::<PackageManifest>(raw_toml)?;
/// ```
☉ rite from_str<T: Decode>(s: &str) -> CodecResult<T>~ {
    ≔ value~ = value_from_str(s)?;
    T·decode(&value)
}

/// Serialize `T` to a TOML string (compact).
☉ rite to_string<T: Encode>(value: &T) -> String! {
    writer_to_string(&value.encode())
}

/// Serialize `T` to a pretty-printed TOML string.
☉ rite to_string_pretty<T: Encode>(value: &T) -> String! {
    writer_to_string_pretty(&value.encode())
}

/// Low-level: parse a TOML string to a raw `Value` tree.
☉ rite value_from_str(s: &str) -> CodecResult<Value>~ {
    vary parser = TomlParser·new(s);
    parser.parse()
}
