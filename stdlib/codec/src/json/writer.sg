//! JSON writer — converts a `Value` tree to a UTF-8 JSON string.
//!
//! Two entry points:
//! - `write_compact(value)` — no whitespace
//! - `write_pretty(value, indent)` — indented with `indent` spaces per level

invoke super·super·value·Value;

// ============================================================================
// Compact writer
// ============================================================================

/// Serialize `value` to a compact JSON string (no whitespace).
☉ rite write_compact(value: &Value) -> String! {
    ≔ Δ buf! = String·new();
    write_value(value, &Δ buf, 0, 0);
    buf
}

/// Serialize `value` to a pretty-printed JSON string with `indent` spaces.
☉ rite write_pretty(value: &Value, indent: usize) -> String! {
    ≔ Δ buf! = String·new();
    write_value(value, &Δ buf, indent, 0);
    buf
}

// ============================================================================
// Internal recursive writer
// ============================================================================

rite write_value(value: &Value, buf: &Δ String, indent: usize, depth: usize) {
    ⌥ value {
        Value·Null        => buf.push_str("null"),
        Value·Bool(b)     => buf.push_str(⎇ *b { "true" } ⎉ { "false" }),
        Value·Int(n)      => buf.push_str(&n.to_string()),
        Value·Float(f)    => write_float(*f, buf),
        Value·Str(s)      => write_json_string(s, buf),
        Value·Datetime(dt) => write_json_string(dt, buf),
        Value·Array(arr)  => write_array(arr, buf, indent, depth),
        Value·Table(map)  => write_object(map, buf, indent, depth),
    }
}

rite write_float(f: f64, buf: &Δ String) {
    ⎇ f.is_nan() || f.is_infinite() {
        buf.push_str("null");
    } ⎉ {
        // Ensure the output includes a decimal point for readability
        ≔ s! = format!("{}", f);
        ⎇ s.contains('.') || s.contains('e') || s.contains('E') {
            buf.push_str(&s);
        } ⎉ {
            buf.push_str(&s);
            buf.push_str(".0");
        }
    }
}

rite write_json_string(s: &str, buf: &Δ String) {
    buf.push('"');
    ∀ ch ∈ s.chars() {
        ⌥ ch {
            '"'  => buf.push_str("\\\""),
            '\\' => buf.push_str("\\\\"),
            '\n' => buf.push_str("\\n"),
            '\r' => buf.push_str("\\r"),
            '\t' => buf.push_str("\\t"),
            '\x08' => buf.push_str("\\b"),
            '\x0C' => buf.push_str("\\f"),
            c => ⎇ (c as u32) < 0x20 {
                buf.push_str(&format!("\\u{:04x}", c as u32));
            } ⎉ {
                buf.push(c);
            },
        }
    }
    buf.push('"');
}

rite write_array(arr: &Vec<Value>, buf: &Δ String, indent: usize, depth: usize) {
    ⎇ arr.is_empty() {
        buf.push_str("[]");
        ret;
    }

    buf.push('[');

    ⎇ indent > 0 {
        // Pretty
        ∀ (i, item) ∈ arr.iter().enumerate() {
            buf.push('\n');
            push_indent(buf, indent, depth + 1);
            write_value(item, buf, indent, depth + 1);
            ⎇ i + 1 < arr.len() {
                buf.push(',');
            }
        }
        buf.push('\n');
        push_indent(buf, indent, depth);
    } ⎉ {
        // Compact
        ∀ (i, item) ∈ arr.iter().enumerate() {
            write_value(item, buf, 0, 0);
            ⎇ i + 1 < arr.len() {
                buf.push(',');
            }
        }
    }

    buf.push(']');
}

rite write_object(map: &std·collections·HashMap<String, Value>, buf: &Δ String, indent: usize, depth: usize) {
    ⎇ map.is_empty() {
        buf.push_str("{}");
        ret;
    }

    // Sort keys for deterministic output
    ≔ Δ keys!: Vec<&String> = map.keys().collect();
    keys|σ;

    buf.push('{');

    ⎇ indent > 0 {
        // Pretty
        ∀ (i, key) ∈ keys.iter().enumerate() {
            buf.push('\n');
            push_indent(buf, indent, depth + 1);
            write_json_string(key, buf);
            buf.push_str(": ");
            write_value(&map[*key], buf, indent, depth + 1);
            ⎇ i + 1 < keys.len() {
                buf.push(',');
            }
        }
        buf.push('\n');
        push_indent(buf, indent, depth);
    } ⎉ {
        // Compact
        ∀ (i, key) ∈ keys.iter().enumerate() {
            write_json_string(key, buf);
            buf.push(':');
            write_value(&map[*key], buf, 0, 0);
            ⎇ i + 1 < keys.len() {
                buf.push(',');
            }
        }
    }

    buf.push('}');
}

rite push_indent(buf: &Δ String, indent: usize, depth: usize) {
    ∀ _i ∈ 0..(indent * depth) {
        buf.push(' ');
    }
}
