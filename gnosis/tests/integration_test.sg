pub struct Duration { nanos: u64 }
impl Duration {
    pub fn zero() -> Self { Self { nanos: 0 } }
    pub fn hours(h: u64) -> Self { Self { nanos: h * 3_600_000_000_000 } }
    pub fn as_nanos(&self) -> u64 { self.nanos }
}
impl Copy for Duration {}
impl Clone for Duration { fn clone(&self) -> Self { *self } }

pub struct Timestamp { pub nanos: u64 }
impl Timestamp {
    pub fn now() -> Self { Self { nanos: 10_000_000_000 } }
    pub fn from_nanos(n: u64) -> Self { Self { nanos: n } }
}
impl PartialOrd for Timestamp {
    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
        self.nanos.partial_cmp(&other.nanos)
    }
}
impl PartialEq for Timestamp {
    fn eq(&self, other: &Self) -> bool { self.nanos == other.nanos }
}

pub struct ExperienceId { id: String }
impl ExperienceId { pub fn generate() -> Self { Self { id: "exp".to_string() } } }
impl Clone for ExperienceId { fn clone(&self) -> Self { Self { id: self.id.clone() } } }

pub struct HumanId { id: String }
impl HumanId { pub fn new(id: &str) -> Self { Self { id: id.to_string() } } }
impl Clone for HumanId { fn clone(&self) -> Self { Self { id: self.id.clone() } } }
impl PartialEq for HumanId { fn eq(&self, other: &Self) -> bool { self.id == other.id } }
impl Eq for HumanId {}
impl std::hash::Hash for HumanId {
    fn hash<H: std::hash::Hasher>(&self, state: &mut H) { self.id.hash(state); }
}

pub struct Confidence { value: f64 }
impl Confidence {
    pub fn new(v: f64) -> Self { Self { value: v.clamp(0.0, 1.0) } }
    pub fn zero() -> Self { Self { value: 0.0 } }
    pub fn value(&self) -> f64 { self.value }
}

