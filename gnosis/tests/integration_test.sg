//! Integration Tests for Gnosis
//!
//! Verifies the full Gnosis learning and growth system working together.

use std::collections::HashMap;

// ============================================================================
// Self-contained Test Types (Minimal Gnosis Recreation)
// ============================================================================

pub struct Duration { nanos: u64 }
impl Duration {
    pub fn zero() -> Self { Self { nanos: 0 } }
    pub fn hours(h: u64) -> Self { Self { nanos: h * 3_600_000_000_000 } }
    pub fn as_nanos(&self) -> u64 { self.nanos }
}
impl Copy for Duration {}
impl Clone for Duration { fn clone(&self) -> Self { *self } }

pub struct Timestamp { pub nanos: u64 }
impl Timestamp {
    pub fn now() -> Self { Self { nanos: 10_000_000_000 } }
    pub fn from_nanos(n: u64) -> Self { Self { nanos: n } }
}
impl PartialOrd for Timestamp {
    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
        self.nanos.partial_cmp(&other.nanos)
    }
}
impl PartialEq for Timestamp {
    fn eq(&self, other: &Self) -> bool { self.nanos == other.nanos }
}

pub struct ExperienceId { id: String }
impl ExperienceId { pub fn generate() -> Self { Self { id: "exp".to_string() } } }
impl Clone for ExperienceId { fn clone(&self) -> Self { Self { id: self.id.clone() } } }

pub struct HumanId { id: String }
impl HumanId { pub fn new(id: &str) -> Self { Self { id: id.to_string() } } }
impl Clone for HumanId { fn clone(&self) -> Self { Self { id: self.id.clone() } } }
impl PartialEq for HumanId { fn eq(&self, other: &Self) -> bool { self.id == other.id } }
impl Eq for HumanId {}
impl std::hash::Hash for HumanId {
    fn hash<H: std::hash::Hasher>(&self, state: &mut H) { self.id.hash(state); }
}

pub struct Confidence { value: f64 }
impl Confidence {
    pub fn new(v: f64) -> Self { Self { value: v.clamp(0.0, 1.0) } }
    pub fn zero() -> Self { Self { value: 0.0 } }
    pub fn value(&self) -> f64 { self.value }
}

#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]
pub enum SkillLevel {
    Novice,
    AdvancedBeginner,
    Competent,
    Proficient,
    Expert,
}

impl SkillLevel {
    pub fn from_proficiency(p: f32) -> Self {
        if p >= 0.9 { SkillLevel::Expert }
        else if p >= 0.7 { SkillLevel::Proficient }
        else if p >= 0.5 { SkillLevel::Competent }
        else if p >= 0.3 { SkillLevel::AdvancedBeginner }
        else { SkillLevel::Novice }
    }
}

#[derive(Clone)]
pub struct Context {
    pub task_type: String,
    pub domain: Option<String>,
    pub human_id: Option<HumanId>,
}

impl Context {
    pub fn new(task_type: &str) -> Self {
        Self { task_type: task_type.to_string(), domain: None, human_id: None }
    }

    pub fn with_domain(mut self, domain: &str) -> Self {
        self.domain = Some(domain.to_string());
        self
    }

    pub fn with_human(mut self, human: HumanId) -> Self {
        self.human_id = Some(human);
        self
    }

    pub fn similar_to(&self, other: &Context) -> bool {
        self.task_type == other.task_type
    }
}

#[derive(Clone)]
pub struct Action {
    pub approach: String,
    pub skills: Vec<String>,
}

impl Action {
    pub fn new(approach: &str) -> Self {
        Self { approach: approach.to_string(), skills: vec![] }
    }

    pub fn with_skill(mut self, skill: &str) -> Self {
        self.skills.push(skill.to_string());
        self
    }
}

#[derive(Clone)]
pub struct ExperienceOutcome {
    pub success: bool,
    pub quality: f32,
    pub unexpected: bool,
}

impl ExperienceOutcome {
    pub fn success(quality: f32) -> Self {
        Self { success: true, quality: quality.clamp(0.0, 1.0), unexpected: false }
    }

    pub fn failure() -> Self {
        Self { success: false, quality: 0.0, unexpected: false }
    }
}

#[derive(Clone)]
pub struct Experience {
    pub id: ExperienceId,
    pub context: Context,
    pub action: Action,
    pub outcome: ExperienceOutcome,
    pub timestamp: Timestamp,
}

impl Experience {
    pub fn new(context: Context, action: Action, outcome: ExperienceOutcome) -> Self {
        Self {
            id: ExperienceId::generate(),
            context,
            action,
            outcome,
            timestamp: Timestamp::now(),
        }
    }

    pub fn skills_exercised(&self) -> Option<Vec<String>> {
        if self.action.skills.is_empty() { None }
        else { Some(self.action.skills.clone()) }
    }
}

#[derive(Clone)]
pub struct CommunicationStyle {
    pub verbosity: f32,
    pub formality: f32,
}

impl CommunicationStyle {
    pub fn default_style() -> Self { Self { verbosity: 0.0, formality: 0.0 } }
    pub fn is_concise(&self) -> bool { self.verbosity < -0.3 }
    pub fn is_verbose(&self) -> bool { self.verbosity > 0.3 }
    pub fn is_formal(&self) -> bool { self.formality > 0.3 }
}

#[derive(Clone)]
pub enum FeedbackType {
    TooVerbose,
    NeedMoreDetail,
    TooFormal,
    TooInformal,
    GoodApproach,
}

#[derive(Clone)]
pub struct Feedback {
    pub human_id: Option<HumanId>,
    pub context: Context,
    pub feedback_type: FeedbackType,
}

impl Feedback {
    pub fn from_human(human: HumanId, ctx: Context, feedback_type: FeedbackType) -> Self {
        Self { human_id: Some(human), context: ctx, feedback_type }
    }
}

pub struct SkillProfile {
    pub name: String,
    pub level: SkillLevel,
    pub proficiency: f32,
    pub experience_count: u32,
}

impl SkillProfile {
    pub fn new(name: &str) -> Self {
        Self {
            name: name.to_string(),
            level: SkillLevel::Novice,
            proficiency: 0.0,
            experience_count: 0,
        }
    }

    pub fn record_exercise(&mut self, quality: f32) {
        self.experience_count += 1;
        let alpha = 0.1;
        self.proficiency = self.proficiency * (1.0 - alpha) + quality * alpha;
        self.level = SkillLevel::from_proficiency(self.proficiency);
    }
}

pub struct GnosisConfig {
    pub max_experiences: usize,
    pub pattern_threshold: usize,
    pub preference_learning_rate: f32,
}

impl GnosisConfig {
    pub fn default_config() -> Self {
        Self {
            max_experiences: 1000,
            pattern_threshold: 3,
            preference_learning_rate: 0.1,
        }
    }
}

/// The main Gnosis system (simplified for testing)
pub struct Gnosis {
    config: GnosisConfig,
    experiences: Vec<Experience>,
    skills: HashMap<String, SkillProfile>,
    human_styles: HashMap<HumanId, CommunicationStyle>,
    patterns: Vec<(Context, String, f32)>,  // (context, approach, success_rate)
}

impl Gnosis {
    pub fn new() -> Self {
        Self {
            config: GnosisConfig::default_config(),
            experiences: vec![],
            skills: HashMap::new(),
            human_styles: HashMap::new(),
            patterns: vec![],
        }
    }

    pub fn with_config(config: GnosisConfig) -> Self {
        Self {
            config,
            experiences: vec![],
            skills: HashMap::new(),
            human_styles: HashMap::new(),
            patterns: vec![],
        }
    }

    // Experience recording
    pub fn experience(&mut self, exp: Experience) {
        // Update skills
        if let Some(skills) = exp.skills_exercised() {
            for skill_name in skills {
                let skill = self.skills.entry(skill_name.clone())
                    .or_insert_with(|| SkillProfile::new(&skill_name));
                skill.record_exercise(exp.outcome.quality);
            }
        }

        // Check for patterns
        let similar: Vec<_> = self.experiences.iter()
            .filter(|e| e.context.similar_to(&exp.context) && e.action.approach == exp.action.approach)
            .collect();

        if similar.len() >= self.config.pattern_threshold - 1 {
            let total = similar.len() + 1;
            let successes = similar.iter().filter(|e| e.outcome.success).count()
                + if exp.outcome.success { 1 } else { 0 };
            let success_rate = successes as f32 / total as f32;
            self.patterns.push((exp.context.clone(), exp.action.approach.clone(), success_rate));
        }

        self.experiences.push(exp);

        // Trim if over capacity
        while self.experiences.len() > self.config.max_experiences {
            self.experiences.remove(0);
        }
    }

    // Feedback processing
    pub fn learn_from_feedback(&mut self, feedback: Feedback) {
        if let Some(human_id) = feedback.human_id {
            let style = self.human_styles.entry(human_id)
                .or_insert_with(CommunicationStyle::default_style);

            match feedback.feedback_type {
                FeedbackType::TooVerbose => style.verbosity -= 0.1,
                FeedbackType::NeedMoreDetail => style.verbosity += 0.1,
                FeedbackType::TooFormal => style.formality -= 0.1,
                FeedbackType::TooInformal => style.formality += 0.1,
                FeedbackType::GoodApproach => {
                    style.verbosity *= 1.05;
                    style.formality *= 1.05;
                }
            }
            style.verbosity = style.verbosity.clamp(-1.0, 1.0);
            style.formality = style.formality.clamp(-1.0, 1.0);
        }
    }

    // Skill queries
    pub fn skill(&self, name: &str) -> Option<&SkillProfile> {
        self.skills.get(name)
    }

    pub fn define_skill(&mut self, name: &str) {
        self.skills.entry(name.to_string())
            .or_insert_with(|| SkillProfile::new(name));
    }

    pub fn skill_count(&self) -> usize {
        self.skills.len()
    }

    // Adaptation queries
    pub fn adapted_style(&self, human_id: &HumanId) -> CommunicationStyle {
        self.human_styles.get(human_id)
            .cloned()
            .unwrap_or_else(CommunicationStyle::default_style)
    }

    // Pattern queries
    pub fn suggest_approach(&self, context: &Context) -> Option<(String, f32)> {
        self.patterns.iter()
            .filter(|(ctx, _, _)| ctx.similar_to(context))
            .max_by(|a, b| a.2.partial_cmp(&b.2).unwrap())
            .map(|(_, approach, rate)| (approach.clone(), *rate))
    }

    pub fn experience_count(&self) -> usize {
        self.experiences.len()
    }

    pub fn pattern_count(&self) -> usize {
        self.patterns.len()
    }

    pub fn human_profile_count(&self) -> usize {
        self.human_styles.len()
    }
}

// ============================================================================
// Tests: Experience Recording
// ============================================================================

#[test]
fn test_gnosis_record_experience() {
    let mut gnosis = Gnosis::new();
    gnosis.experience(Experience::new(
        Context::new("coding"),
        Action::new("tdd"),
        ExperienceOutcome::success(0.9)
    ));
    assert_eq(gnosis.experience_count(), 1);
}

#[test]
fn test_gnosis_skill_from_experience() {
    let mut gnosis = Gnosis::new();
    gnosis.experience(Experience::new(
        Context::new("coding"),
        Action::new("write_tests").with_skill("testing"),
        ExperienceOutcome::success(0.9)
    ));
    let skill = gnosis.skill("testing");
    assert(skill.is_some());
    assert_eq(skill.unwrap().experience_count, 1);
}

#[test]
fn test_gnosis_multiple_skills() {
    let mut gnosis = Gnosis::new();
    gnosis.experience(Experience::new(
        Context::new("refactoring"),
        Action::new("improve")
            .with_skill("rust")
            .with_skill("design_patterns"),
        ExperienceOutcome::success(0.8)
    ));
    assert_eq(gnosis.skill_count(), 2);
}

#[test]
fn test_gnosis_skill_progression() {
    let mut gnosis = Gnosis::new();
    gnosis.define_skill("python");

    // Many high-quality exercises
    for _ in 0..50 {
        gnosis.experience(Experience::new(
            Context::new("coding"),
            Action::new("write").with_skill("python"),
            ExperienceOutcome::success(0.95)
        ));
    }

    let skill = gnosis.skill("python").unwrap();
    assert(skill.level >= SkillLevel::Proficient);
}

// ============================================================================
// Tests: Feedback Learning
// ============================================================================

#[test]
fn test_gnosis_learn_from_feedback_verbosity() {
    let mut gnosis = Gnosis::new();
    let human = HumanId::new("alice");

    gnosis.learn_from_feedback(Feedback::from_human(
        human.clone(),
        Context::new("chat"),
        FeedbackType::TooVerbose
    ));

    let style = gnosis.adapted_style(&human);
    assert(style.is_concise() || style.verbosity < 0.0);
}

#[test]
fn test_gnosis_learn_from_feedback_detail() {
    let mut gnosis = Gnosis::new();
    let human = HumanId::new("bob");

    gnosis.learn_from_feedback(Feedback::from_human(
        human.clone(),
        Context::new("explanation"),
        FeedbackType::NeedMoreDetail
    ));

    let style = gnosis.adapted_style(&human);
    assert(style.verbosity > 0.0);
}

#[test]
fn test_gnosis_learn_from_feedback_formality() {
    let mut gnosis = Gnosis::new();
    let human = HumanId::new("charlie");

    gnosis.learn_from_feedback(Feedback::from_human(
        human.clone(),
        Context::new("email"),
        FeedbackType::TooInformal
    ));

    let style = gnosis.adapted_style(&human);
    assert(style.formality > 0.0);
}

#[test]
fn test_gnosis_accumulated_feedback() {
    let mut gnosis = Gnosis::new();
    let human = HumanId::new("dave");

    for _ in 0..5 {
        gnosis.learn_from_feedback(Feedback::from_human(
            human.clone(),
            Context::new("chat"),
            FeedbackType::TooVerbose
        ));
    }

    let style = gnosis.adapted_style(&human);
    assert(style.verbosity < -0.3);
}

// ============================================================================
// Tests: Pattern Detection
// ============================================================================

#[test]
fn test_gnosis_pattern_detection() {
    let mut gnosis = Gnosis::with_config(GnosisConfig {
        max_experiences: 100,
        pattern_threshold: 2,
        preference_learning_rate: 0.1,
    });

    gnosis.experience(Experience::new(
        Context::new("debugging"),
        Action::new("print_logs"),
        ExperienceOutcome::success(0.7)
    ));
    gnosis.experience(Experience::new(
        Context::new("debugging"),
        Action::new("print_logs"),
        ExperienceOutcome::success(0.8)
    ));

    assert(gnosis.pattern_count() > 0);
}

#[test]
fn test_gnosis_suggest_approach() {
    let mut gnosis = Gnosis::with_config(GnosisConfig {
        max_experiences: 100,
        pattern_threshold: 2,
        preference_learning_rate: 0.1,
    });

    gnosis.experience(Experience::new(
        Context::new("testing"),
        Action::new("unit_tests"),
        ExperienceOutcome::success(0.9)
    ));
    gnosis.experience(Experience::new(
        Context::new("testing"),
        Action::new("unit_tests"),
        ExperienceOutcome::success(0.85)
    ));

    let suggestion = gnosis.suggest_approach(&Context::new("testing"));
    assert(suggestion.is_some());
    let (approach, rate) = suggestion.unwrap();
    assert_eq(approach, "unit_tests");
    assert(rate > 0.8);
}

#[test]
fn test_gnosis_no_pattern_insufficient_data() {
    let mut gnosis = Gnosis::new();  // default threshold is 3

    gnosis.experience(Experience::new(
        Context::new("rare_task"),
        Action::new("approach"),
        ExperienceOutcome::success(0.9)
    ));

    let suggestion = gnosis.suggest_approach(&Context::new("rare_task"));
    assert(suggestion.is_none());
}

// ============================================================================
// Tests: Experience Capacity
// ============================================================================

#[test]
fn test_gnosis_experience_capacity() {
    let mut gnosis = Gnosis::with_config(GnosisConfig {
        max_experiences: 5,
        pattern_threshold: 3,
        preference_learning_rate: 0.1,
    });

    for i in 0..10 {
        gnosis.experience(Experience::new(
            Context::new(&format!("task_{}", i)),
            Action::new("approach"),
            ExperienceOutcome::success(0.8)
        ));
    }

    assert_eq(gnosis.experience_count(), 5);
}

// ============================================================================
// Tests: Full Integration
// ============================================================================

#[test]
fn test_gnosis_complete_workflow() {
    let mut gnosis = Gnosis::with_config(GnosisConfig {
        max_experiences: 1000,
        pattern_threshold: 2,
        preference_learning_rate: 0.1,
    });

    let human = HumanId::new("eve");

    // 1. Record experiences with skills
    gnosis.experience(Experience::new(
        Context::new("coding").with_human(human.clone()),
        Action::new("tdd").with_skill("testing").with_skill("rust"),
        ExperienceOutcome::success(0.9)
    ));

    gnosis.experience(Experience::new(
        Context::new("coding").with_human(human.clone()),
        Action::new("tdd").with_skill("testing"),
        ExperienceOutcome::success(0.85)
    ));

    // 2. Process feedback
    gnosis.learn_from_feedback(Feedback::from_human(
        human.clone(),
        Context::new("coding"),
        FeedbackType::GoodApproach
    ));

    // 3. Verify state
    assert_eq(gnosis.experience_count(), 2);
    assert_eq(gnosis.skill_count(), 2);  // testing, rust
    assert(gnosis.pattern_count() > 0);
    assert_eq(gnosis.human_profile_count(), 1);

    // 4. Query suggestions
    let suggestion = gnosis.suggest_approach(&Context::new("coding"));
    assert(suggestion.is_some());

    // 5. Query adapted style
    let style = gnosis.adapted_style(&human);
    assert(style.verbosity != 0.0 || style.formality != 0.0);  // Was modified

    // 6. Query skill
    let testing_skill = gnosis.skill("testing").unwrap();
    assert_eq(testing_skill.experience_count, 2);
}

#[test]
fn test_gnosis_multi_human_adaptation() {
    let mut gnosis = Gnosis::new();

    let alice = HumanId::new("alice");
    let bob = HumanId::new("bob");

    // Alice prefers concise
    gnosis.learn_from_feedback(Feedback::from_human(
        alice.clone(),
        Context::new("chat"),
        FeedbackType::TooVerbose
    ));

    // Bob prefers detailed
    gnosis.learn_from_feedback(Feedback::from_human(
        bob.clone(),
        Context::new("chat"),
        FeedbackType::NeedMoreDetail
    ));

    let alice_style = gnosis.adapted_style(&alice);
    let bob_style = gnosis.adapted_style(&bob);

    assert(alice_style.verbosity < bob_style.verbosity);
}

#[test]
fn test_gnosis_skill_transfer() {
    let mut gnosis = Gnosis::new();

    // Practice rust a lot
    for _ in 0..30 {
        gnosis.experience(Experience::new(
            Context::new("coding"),
            Action::new("write").with_skill("rust"),
            ExperienceOutcome::success(0.9)
        ));
    }

    // Rust skill should be high
    let rust = gnosis.skill("rust").unwrap();
    assert(rust.level >= SkillLevel::Competent);
}

#[test]
fn test_gnosis_failure_learning() {
    let mut gnosis = Gnosis::with_config(GnosisConfig {
        max_experiences: 100,
        pattern_threshold: 2,
        preference_learning_rate: 0.1,
    });

    // Record failures
    gnosis.experience(Experience::new(
        Context::new("risky_task"),
        Action::new("bad_approach"),
        ExperienceOutcome::failure()
    ));
    gnosis.experience(Experience::new(
        Context::new("risky_task"),
        Action::new("bad_approach"),
        ExperienceOutcome::failure()
    ));

    let suggestion = gnosis.suggest_approach(&Context::new("risky_task"));
    if let Some((_, rate)) = suggestion {
        assert_eq(rate, 0.0);  // Success rate should be 0
    }
}

fn main() {
    print("Gnosis integration tests");
}
