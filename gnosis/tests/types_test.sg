//! Tests for Gnosis Core Types
//!
//! Verifies Context, Action, ExperienceOutcome, and utility types.

use std::collections::HashMap;

// ============================================================================
// Self-contained Test Types
// ============================================================================

pub struct Duration { nanos: u64 }

impl Duration {
    pub fn zero() -> Self { Self { nanos: 0 } }
    pub fn seconds(s: u64) -> Self { Self { nanos: s * 1_000_000_000 } }
    pub fn minutes(m: u64) -> Self { Self { nanos: m * 60_000_000_000 } }
    pub fn hours(h: u64) -> Self { Self { nanos: h * 3_600_000_000_000 } }
    pub fn as_secs(&self) -> u64 { self.nanos / 1_000_000_000 }
    pub fn as_nanos(&self) -> u64 { self.nanos }
}

impl Copy for Duration {}
impl Clone for Duration { fn clone(&self) -> Self { *self } }

pub struct Timestamp { nanos: u64 }

impl Timestamp {
    pub fn now() -> Self { Self { nanos: 1_000_000_000 } }
    pub fn from_nanos(nanos: u64) -> Self { Self { nanos } }
}

impl PartialOrd for Timestamp {
    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
        self.nanos.partial_cmp(&other.nanos)
    }
}

impl PartialEq for Timestamp {
    fn eq(&self, other: &Self) -> bool { self.nanos == other.nanos }
}

pub struct HumanId { id: String }

impl HumanId {
    pub fn new(id: &str) -> Self { Self { id: id.to_string() } }
}

impl Clone for HumanId {
    fn clone(&self) -> Self { Self { id: self.id.clone() } }
}

impl PartialEq for HumanId {
    fn eq(&self, other: &Self) -> bool { self.id == other.id }
}

impl std::hash::Hash for HumanId {
    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
        self.id.hash(state);
    }
}

impl Eq for HumanId {}

pub struct ExperienceId { id: String }

impl ExperienceId {
    pub fn generate() -> Self { Self { id: "exp_001".to_string() } }
}

impl Clone for ExperienceId {
    fn clone(&self) -> Self { Self { id: self.id.clone() } }
}

#[derive(Clone)]
pub struct Context {
    pub task_type: String,
    pub constraints: Vec<String>,
    pub domain: Option<String>,
    pub human_id: Option<HumanId>,
    pub features: HashMap<String, String>,
}

impl Context {
    pub fn new(task_type: &str) -> Self {
        Self {
            task_type: task_type.to_string(),
            constraints: vec![],
            domain: None,
            human_id: None,
            features: HashMap::new(),
        }
    }

    pub fn with_domain(mut self, domain: &str) -> Self {
        self.domain = Some(domain.to_string());
        self
    }

    pub fn with_human(mut self, human_id: HumanId) -> Self {
        self.human_id = Some(human_id);
        self
    }

    pub fn with_constraint(mut self, constraint: &str) -> Self {
        self.constraints.push(constraint.to_string());
        self
    }

    pub fn with_feature(mut self, key: &str, value: &str) -> Self {
        self.features.insert(key.to_string(), value.to_string());
        self
    }

    pub fn similar_to(&self, other: &Context) -> bool {
        self.task_type == other.task_type
    }

    pub fn matches(&self, other: &Context) -> bool {
        self.task_type == other.task_type && self.domain == other.domain
    }

    pub fn has_constraint(&self, constraint: &str) -> bool {
        self.constraints.contains(&constraint.to_string())
    }

    pub fn has_feature(&self, key: &str) -> bool {
        self.features.contains_key(key)
    }
}

#[derive(Clone)]
pub struct Action {
    pub approach: String,
    pub skills: Vec<String>,
    pub details: Option<String>,
}

impl Action {
    pub fn new(approach: &str) -> Self {
        Self {
            approach: approach.to_string(),
            skills: vec![],
            details: None,
        }
    }

    pub fn with_skill(mut self, skill: &str) -> Self {
        self.skills.push(skill.to_string());
        self
    }

    pub fn with_details(mut self, details: &str) -> Self {
        self.details = Some(details.to_string());
        self
    }

    pub fn skill_count(&self) -> usize {
        self.skills.len()
    }

    pub fn has_skill(&self, skill: &str) -> bool {
        self.skills.contains(&skill.to_string())
    }
}

#[derive(Clone)]
pub struct ExperienceOutcome {
    pub success: bool,
    pub quality: f32,
    pub unexpected: bool,
    pub details: Option<String>,
}

impl ExperienceOutcome {
    pub fn success(quality: f32) -> Self {
        Self {
            success: true,
            quality: quality.clamp(0.0, 1.0),
            unexpected: false,
            details: None,
        }
    }

    pub fn failure(details: &str) -> Self {
        Self {
            success: false,
            quality: 0.0,
            unexpected: false,
            details: Some(details.to_string()),
        }
    }

    pub fn unexpected(quality: f32) -> Self {
        Self {
            success: true,
            quality: quality.clamp(0.0, 1.0),
            unexpected: true,
            details: None,
        }
    }

    pub fn with_details(mut self, details: &str) -> Self {
        self.details = Some(details.to_string());
        self
    }

    pub fn is_high_quality(&self) -> bool {
        self.success && self.quality >= 0.8
    }

    pub fn is_low_quality(&self) -> bool {
        !self.success || self.quality < 0.5
    }
}

#[derive(Clone)]
pub struct Experience {
    pub id: ExperienceId,
    pub context: Context,
    pub action: Action,
    pub outcome: ExperienceOutcome,
    pub timestamp: Timestamp,
}

impl Experience {
    pub fn new(context: Context, action: Action, outcome: ExperienceOutcome) -> Self {
        Self {
            id: ExperienceId::generate(),
            context,
            action,
            outcome,
            timestamp: Timestamp::now(),
        }
    }

    pub fn skills_exercised(&self) -> Option<Vec<String>> {
        if self.action.skills.is_empty() {
            None
        } else {
            Some(self.action.skills.clone())
        }
    }

    pub fn was_successful(&self) -> bool {
        self.outcome.success
    }

    pub fn quality(&self) -> f32 {
        self.outcome.quality
    }
}

pub struct Confidence { value: f64 }

impl Confidence {
    pub fn new(value: f64) -> Self {
        Self { value: value.clamp(0.0, 1.0) }
    }

    pub fn zero() -> Self { Self { value: 0.0 } }
    pub fn full() -> Self { Self { value: 1.0 } }

    pub fn value(&self) -> f64 { self.value }

    pub fn is_high(&self) -> bool { self.value >= 0.7 }
    pub fn is_low(&self) -> bool { self.value < 0.3 }
}

#[derive(Copy, Clone, PartialEq, Eq)]
pub enum Priority {
    Critical,
    High,
    Normal,
    Low,
}

impl Priority {
    pub fn as_int(&self) -> u8 {
        match self {
            Priority::Critical => 4,
            Priority::High => 3,
            Priority::Normal => 2,
            Priority::Low => 1,
        }
    }
}

// ============================================================================
// Tests: Duration
// ============================================================================

#[test]
fn test_duration_zero() {
    let d = Duration::zero();
    assert_eq(d.as_secs(), 0);
}

#[test]
fn test_duration_seconds() {
    let d = Duration::seconds(30);
    assert_eq(d.as_secs(), 30);
}

#[test]
fn test_duration_minutes() {
    let d = Duration::minutes(5);
    assert_eq(d.as_secs(), 300);
}

#[test]
fn test_duration_hours() {
    let d = Duration::hours(2);
    assert_eq(d.as_secs(), 7200);
}

// ============================================================================
// Tests: Timestamp
// ============================================================================

#[test]
fn test_timestamp_now() {
    let t = Timestamp::now();
    assert(t.nanos > 0);
}

#[test]
fn test_timestamp_from_nanos() {
    let t = Timestamp::from_nanos(5000);
    assert_eq(t.nanos, 5000);
}

#[test]
fn test_timestamp_comparison() {
    let t1 = Timestamp::from_nanos(100);
    let t2 = Timestamp::from_nanos(200);
    assert(t1 < t2);
}

// ============================================================================
// Tests: HumanId
// ============================================================================

#[test]
fn test_human_id_new() {
    let id = HumanId::new("user_123");
    assert_eq(id.id, "user_123");
}

#[test]
fn test_human_id_equality() {
    let id1 = HumanId::new("user_1");
    let id2 = HumanId::new("user_1");
    assert(id1 == id2);
}

#[test]
fn test_human_id_inequality() {
    let id1 = HumanId::new("user_1");
    let id2 = HumanId::new("user_2");
    assert(id1 != id2);
}

#[test]
fn test_human_id_clone() {
    let id1 = HumanId::new("test");
    let id2 = id1.clone();
    assert(id1 == id2);
}

// ============================================================================
// Tests: ExperienceId
// ============================================================================

#[test]
fn test_experience_id_generate() {
    let id = ExperienceId::generate();
    assert(!id.id.is_empty());
}

#[test]
fn test_experience_id_clone() {
    let id1 = ExperienceId::generate();
    let id2 = id1.clone();
    assert_eq(id1.id, id2.id);
}

// ============================================================================
// Tests: Context
// ============================================================================

#[test]
fn test_context_new() {
    let ctx = Context::new("code_review");
    assert_eq(ctx.task_type, "code_review");
    assert(ctx.domain.is_none());
}

#[test]
fn test_context_with_domain() {
    let ctx = Context::new("analysis").with_domain("security");
    assert_eq(ctx.domain.unwrap(), "security");
}

#[test]
fn test_context_with_human() {
    let ctx = Context::new("chat").with_human(HumanId::new("alice"));
    assert(ctx.human_id.is_some());
}

#[test]
fn test_context_with_constraint() {
    let ctx = Context::new("task")
        .with_constraint("time_limit")
        .with_constraint("memory_limit");
    assert_eq(ctx.constraints.len(), 2);
    assert(ctx.has_constraint("time_limit"));
}

#[test]
fn test_context_with_feature() {
    let ctx = Context::new("task")
        .with_feature("language", "rust");
    assert(ctx.has_feature("language"));
}

#[test]
fn test_context_similar_to() {
    let ctx1 = Context::new("debugging");
    let ctx2 = Context::new("debugging").with_domain("frontend");
    assert(ctx1.similar_to(&ctx2));
}

#[test]
fn test_context_not_similar() {
    let ctx1 = Context::new("debugging");
    let ctx2 = Context::new("testing");
    assert(!ctx1.similar_to(&ctx2));
}

#[test]
fn test_context_matches() {
    let ctx1 = Context::new("analysis").with_domain("security");
    let ctx2 = Context::new("analysis").with_domain("security");
    assert(ctx1.matches(&ctx2));
}

#[test]
fn test_context_not_matches() {
    let ctx1 = Context::new("analysis").with_domain("security");
    let ctx2 = Context::new("analysis").with_domain("performance");
    assert(!ctx1.matches(&ctx2));
}

// ============================================================================
// Tests: Action
// ============================================================================

#[test]
fn test_action_new() {
    let action = Action::new("step_through_debugger");
    assert_eq(action.approach, "step_through_debugger");
    assert_eq(action.skill_count(), 0);
}

#[test]
fn test_action_with_skill() {
    let action = Action::new("refactor")
        .with_skill("rust")
        .with_skill("testing");
    assert_eq(action.skill_count(), 2);
    assert(action.has_skill("rust"));
}

#[test]
fn test_action_with_details() {
    let action = Action::new("explain")
        .with_details("Used analogies");
    assert(action.details.is_some());
}

#[test]
fn test_action_clone() {
    let a1 = Action::new("test").with_skill("python");
    let a2 = a1.clone();
    assert_eq(a1.approach, a2.approach);
}

// ============================================================================
// Tests: ExperienceOutcome
// ============================================================================

#[test]
fn test_outcome_success() {
    let outcome = ExperienceOutcome::success(0.9);
    assert(outcome.success);
    assert_eq(outcome.quality, 0.9);
    assert(!outcome.unexpected);
}

#[test]
fn test_outcome_failure() {
    let outcome = ExperienceOutcome::failure("timeout");
    assert(!outcome.success);
    assert_eq(outcome.quality, 0.0);
}

#[test]
fn test_outcome_unexpected() {
    let outcome = ExperienceOutcome::unexpected(0.7);
    assert(outcome.success);
    assert(outcome.unexpected);
}

#[test]
fn test_outcome_quality_clamped() {
    let outcome = ExperienceOutcome::success(1.5);
    assert_eq(outcome.quality, 1.0);
}

#[test]
fn test_outcome_is_high_quality() {
    let high = ExperienceOutcome::success(0.85);
    let low = ExperienceOutcome::success(0.5);
    assert(high.is_high_quality());
    assert(!low.is_high_quality());
}

#[test]
fn test_outcome_is_low_quality() {
    let failure = ExperienceOutcome::failure("error");
    let low = ExperienceOutcome::success(0.3);
    let good = ExperienceOutcome::success(0.7);
    assert(failure.is_low_quality());
    assert(low.is_low_quality());
    assert(!good.is_low_quality());
}

#[test]
fn test_outcome_with_details() {
    let outcome = ExperienceOutcome::success(0.8)
        .with_details("Completed ahead of schedule");
    assert(outcome.details.is_some());
}

// ============================================================================
// Tests: Experience
// ============================================================================

#[test]
fn test_experience_new() {
    let exp = Experience::new(
        Context::new("coding"),
        Action::new("write_tests"),
        ExperienceOutcome::success(0.9)
    );
    assert(exp.was_successful());
    assert_eq(exp.quality(), 0.9);
}

#[test]
fn test_experience_skills_exercised_some() {
    let exp = Experience::new(
        Context::new("coding"),
        Action::new("implement").with_skill("rust").with_skill("async"),
        ExperienceOutcome::success(0.8)
    );
    let skills = exp.skills_exercised();
    assert(skills.is_some());
    assert_eq(skills.unwrap().len(), 2);
}

#[test]
fn test_experience_skills_exercised_none() {
    let exp = Experience::new(
        Context::new("reading"),
        Action::new("review"),
        ExperienceOutcome::success(0.7)
    );
    assert(exp.skills_exercised().is_none());
}

#[test]
fn test_experience_was_successful() {
    let success = Experience::new(
        Context::new("task"),
        Action::new("do"),
        ExperienceOutcome::success(0.9)
    );
    let failure = Experience::new(
        Context::new("task"),
        Action::new("do"),
        ExperienceOutcome::failure("error")
    );
    assert(success.was_successful());
    assert(!failure.was_successful());
}

// ============================================================================
// Tests: Confidence
// ============================================================================

#[test]
fn test_confidence_new() {
    let c = Confidence::new(0.75);
    assert_eq(c.value(), 0.75);
}

#[test]
fn test_confidence_clamped() {
    let c = Confidence::new(1.5);
    assert_eq(c.value(), 1.0);
}

#[test]
fn test_confidence_zero() {
    let c = Confidence::zero();
    assert_eq(c.value(), 0.0);
}

#[test]
fn test_confidence_full() {
    let c = Confidence::full();
    assert_eq(c.value(), 1.0);
}

#[test]
fn test_confidence_is_high() {
    let high = Confidence::new(0.8);
    let low = Confidence::new(0.5);
    assert(high.is_high());
    assert(!low.is_high());
}

#[test]
fn test_confidence_is_low() {
    let low = Confidence::new(0.2);
    let mid = Confidence::new(0.5);
    assert(low.is_low());
    assert(!mid.is_low());
}

// ============================================================================
// Tests: Priority
// ============================================================================

#[test]
fn test_priority_critical() {
    let p = Priority::Critical;
    assert_eq(p.as_int(), 4);
}

#[test]
fn test_priority_high() {
    let p = Priority::High;
    assert_eq(p.as_int(), 3);
}

#[test]
fn test_priority_normal() {
    let p = Priority::Normal;
    assert_eq(p.as_int(), 2);
}

#[test]
fn test_priority_low() {
    let p = Priority::Low;
    assert_eq(p.as_int(), 1);
}

#[test]
fn test_priority_equality() {
    assert(Priority::High == Priority::High);
    assert(Priority::Low != Priority::High);
}

fn main() {
    print("Gnosis types tests");
}
