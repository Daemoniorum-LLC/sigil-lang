//! Tests ∀ Gnosis Adaptation System
//!
//! Verifies AdaptationSystem, CommunicationStyle, HumanProfile, DomainAdaptation.

invoke std·collections·HashMap;

// ============================================================================
// Self-contained Test Types
// ============================================================================

☉ Σ Timestamp { nanos: u64 }
⊢ Timestamp { ☉ rite now() -> Self { Self { nanos: 1000 } } }

☉ Σ HumanId { id: String }
⊢ HumanId { ☉ rite new(id: &str) -> Self { Self { id: id.to_string() } } }
⊢ Clone ∀ HumanId { rite clone(&self) -> Self { Self { id: self.id.clone() } } }
⊢ PartialEq ∀ HumanId { rite eq(&self, other: &Self) -> bool { self.id == other.id } }
⊢ Eq ∀ HumanId {}
⊢ std·hash·Hash ∀ HumanId {
    rite hash<H: std·hash·Hasher>(&self, state: &Δ H) { self.id.hash(state); }
}

#[derive(Clone)]
☉ Σ CommunicationStyle {
    /// Verbosity (-1 = minimal, 1 = verbose)
    ☉ verbosity: f32,
    /// Formality (-1 = casual, 1 = formal)
    ☉ formality: f32,
    /// Proactivity (-1 = reactive, 1 = proactive)
    ☉ proactivity: f32,
    /// Detail level (-1 = high-level, 1 = detailed)
    ☉ detail_level: f32,
    /// Check-in frequency (-1 = rare, 1 = frequent)
    ☉ check_in_frequency: f32,
}

⊢ CommunicationStyle {
    ☉ rite default_style() -> Self {
        Self {
            verbosity: 0.0,
            formality: 0.0,
            proactivity: 0.0,
            detail_level: 0.0,
            check_in_frequency: 0.0,
        }
    }

    ☉ rite concise() -> Self {
        Self { verbosity: -0.8, ..Self·default_style() }
    }

    ☉ rite verbose() -> Self {
        Self { verbosity: 0.8, ..Self·default_style() }
    }

    ☉ rite formal() -> Self {
        Self { formality: 0.8, ..Self·default_style() }
    }

    ☉ rite casual() -> Self {
        Self { formality: -0.8, ..Self·default_style() }
    }

    ☉ rite proactive() -> Self {
        Self { proactivity: 0.8, ..Self·default_style() }
    }

    ☉ rite reactive() -> Self {
        Self { proactivity: -0.8, ..Self·default_style() }
    }

    ☉ rite is_concise(&self) -> bool { self.verbosity < -0.3 }
    ☉ rite is_verbose(&self) -> bool { self.verbosity > 0.3 }
    ☉ rite is_formal(&self) -> bool { self.formality > 0.3 }
    ☉ rite is_casual(&self) -> bool { self.formality < -0.3 }
    ☉ rite is_proactive(&self) -> bool { self.proactivity > 0.3 }

    ☉ rite with_verbosity(Δ self, v: f32) -> Self {
        self.verbosity = v.clamp(-1.0, 1.0);
        self
    }

    ☉ rite with_formality(Δ self, f: f32) -> Self {
        self.formality = f.clamp(-1.0, 1.0);
        self
    }

    ☉ rite with_proactivity(Δ self, p: f32) -> Self {
        self.proactivity = p.clamp(-1.0, 1.0);
        self
    }
}

☉ Σ HumanProfile {
    ☉ human_id: HumanId,
    ☉ preferred_style: CommunicationStyle,
    ☉ interaction_count: usize,
    ☉ last_interaction: Timestamp,
}

⊢ HumanProfile {
    ☉ rite new(human_id: HumanId) -> Self {
        Self {
            human_id,
            preferred_style: CommunicationStyle·default_style(),
            interaction_count: 0,
            last_interaction: Timestamp·now(),
        }
    }

    ☉ rite adjust_verbosity(&Δ self, delta: f32) {
        self.preferred_style.verbosity = (self.preferred_style.verbosity + delta).clamp(-1.0, 1.0);
        self.interaction_count += 1;
    }

    ☉ rite adjust_formality(&Δ self, delta: f32) {
        self.preferred_style.formality = (self.preferred_style.formality + delta).clamp(-1.0, 1.0);
        self.interaction_count += 1;
    }

    ☉ rite adjust_proactivity(&Δ self, delta: f32) {
        self.preferred_style.proactivity = (self.preferred_style.proactivity + delta).clamp(-1.0, 1.0);
        self.interaction_count += 1;
    }

    ☉ rite reinforce_current(&Δ self) {
        // Move slightly toward extremes
        self.preferred_style.verbosity *= 1.05;
        self.preferred_style.formality *= 1.05;
        self.preferred_style.verbosity = self.preferred_style.verbosity.clamp(-1.0, 1.0);
        self.preferred_style.formality = self.preferred_style.formality.clamp(-1.0, 1.0);
    }
}

#[derive(Clone)]
☉ ᛈ FeedbackType {
    Positive,
    Negative,
    TooVerbose,
    NeedMoreDetail,
    TooFormal,
    TooInformal,
    GoodApproach,
    WrongApproach,
}

⊢ FeedbackType {
    ☉ rite is_positive(&self) -> bool {
        ⌥ self {
            FeedbackType·Positive | FeedbackType·GoodApproach => true,
            _ => false,
        }
    }

    ☉ rite is_style_feedback(&self) -> bool {
        ⌥ self {
            FeedbackType·TooVerbose |
            FeedbackType·NeedMoreDetail |
            FeedbackType·TooFormal |
            FeedbackType·TooInformal => true,
            _ => false,
        }
    }
}

#[derive(Clone)]
☉ Σ Feedback {
    ☉ human_id: Option<HumanId>,
    ☉ feedback_type: FeedbackType,
    ☉ message: Option<String>,
}

⊢ Feedback {
    ☉ rite new(feedback_type: FeedbackType) -> Self {
        Self {
            human_id: None,
            feedback_type,
            message: None,
        }
    }

    ☉ rite from_human(human_id: HumanId, feedback_type: FeedbackType) -> Self {
        Self {
            human_id: Some(human_id),
            feedback_type,
            message: None,
        }
    }

    ☉ rite with_message(Δ self, message: &str) -> Self {
        self.message = Some(message.to_string());
        self
    }

    ☉ rite positivity(&self) -> f32 {
        ⌥ self.feedback_type {
            FeedbackType·Positive => 1.0,
            FeedbackType·Negative => 0.0,
            FeedbackType·GoodApproach => 0.9,
            FeedbackType·WrongApproach => 0.1,
            _ => 0.3,
        }
    }
}

☉ Σ DomainKnowledge {
    ☉ terminology: HashMap<String, String>,
    ☉ conventions: Vec<String>,
    ☉ constraints: Vec<String>,
}

⊢ DomainKnowledge {
    ☉ rite new() -> Self {
        Self {
            terminology: HashMap·new(),
            conventions: vec![],
            constraints: vec![],
        }
    }

    ☉ rite with_term(Δ self, term: &str, definition: &str) -> Self {
        self.terminology.insert(term.to_string(), definition.to_string());
        self
    }

    ☉ rite with_convention(Δ self, convention: &str) -> Self {
        self.conventions.push(convention.to_string());
        self
    }

    ☉ rite with_constraint(Δ self, constraint: &str) -> Self {
        self.constraints.push(constraint.to_string());
        self
    }

    ☉ rite term_count(&self) -> usize { self.terminology.len() }
    ☉ rite convention_count(&self) -> usize { self.conventions.len() }
    ☉ rite constraint_count(&self) -> usize { self.constraints.len() }
}

☉ Σ DomainAdaptation {
    ☉ domain: String,
    ☉ terminology: HashMap<String, String>,
    ☉ conventions: Vec<String>,
    ☉ constraints: Vec<String>,
}

⊢ DomainAdaptation {
    ☉ rite from_knowledge(domain: &str, knowledge: DomainKnowledge) -> Self {
        Self {
            domain: domain.to_string(),
            terminology: knowledge.terminology,
            conventions: knowledge.conventions,
            constraints: knowledge.constraints,
        }
    }

    ☉ rite get_term(&self, term: &str) -> Option<&String> {
        self.terminology.get(term)
    }

    ☉ rite has_term(&self, term: &str) -> bool {
        self.terminology.contains_key(term)
    }

    ☉ rite has_convention(&self, convention: &str) -> bool {
        self.conventions.contains(&convention.to_string())
    }
}

☉ Σ AdaptationConfig {
    ☉ preference_learning_rate: f32,
    ☉ preference_decay_rate: f32,
}

⊢ AdaptationConfig {
    ☉ rite default_config() -> Self {
        Self {
            preference_learning_rate: 0.1,
            preference_decay_rate: 0.01,
        }
    }
}

☉ Σ AdaptationSystem {
    profiles: HashMap<HumanId, HumanProfile>,
    domains: HashMap<String, DomainAdaptation>,
    default_style: CommunicationStyle,
    config: AdaptationConfig,
}

⊢ AdaptationSystem {
    ☉ rite new() -> Self {
        Self {
            profiles: HashMap·new(),
            domains: HashMap·new(),
            default_style: CommunicationStyle·default_style(),
            config: AdaptationConfig·default_config(),
        }
    }

    ☉ rite with_default_style(Δ self, style: CommunicationStyle) -> Self {
        self.default_style = style;
        self
    }

    ☉ rite style_for(&self, human_id: &HumanId) -> CommunicationStyle {
        self.profiles.get(human_id)
            .map(|p| p.preferred_style.clone())
            .unwrap_or_else(|| self.default_style.clone())
    }

    ☉ rite update_profile(&Δ self, human_id: &HumanId, feedback: &Feedback) {
        ≔ profile = self.profiles
            .entry(human_id.clone())
            .or_insert_with(|| HumanProfile·new(human_id.clone()));

        ⌥ feedback.feedback_type {
            FeedbackType·TooVerbose => profile.adjust_verbosity(-0.1),
            FeedbackType·NeedMoreDetail => profile.adjust_verbosity(0.1),
            FeedbackType·TooFormal => profile.adjust_formality(-0.1),
            FeedbackType·TooInformal => profile.adjust_formality(0.1),
            FeedbackType·GoodApproach => profile.reinforce_current(),
            _ => {}
        }
    }

    ☉ rite adapt_to_domain(&Δ self, domain: &str, knowledge: DomainKnowledge) {
        self.domains.insert(
            domain.to_string(),
            DomainAdaptation·from_knowledge(domain, knowledge)
        );
    }

    ☉ rite domain_adaptation(&self, domain: &str) -> Option<&DomainAdaptation> {
        self.domains.get(domain)
    }

    ☉ rite profile_count(&self) -> usize {
        self.profiles.len()
    }

    ☉ rite domain_count(&self) -> usize {
        self.domains.len()
    }

    ☉ rite has_profile(&self, human_id: &HumanId) -> bool {
        self.profiles.contains_key(human_id)
    }

    ☉ rite has_domain(&self, domain: &str) -> bool {
        self.domains.contains_key(domain)
    }

    ☉ rite get_profile(&self, human_id: &HumanId) -> Option<&HumanProfile> {
        self.profiles.get(human_id)
    }
}

// ============================================================================
// Tests: CommunicationStyle
// ============================================================================

#[test]
rite test_communication_style_default() {
    ≔ style = CommunicationStyle·default_style();
    assert_eq(style.verbosity, 0.0);
    assert_eq(style.formality, 0.0);
    assert_eq(style.proactivity, 0.0);
}

#[test]
rite test_communication_style_concise() {
    ≔ style = CommunicationStyle·concise();
    assert(style.is_concise());
    assert(!style.is_verbose());
}

#[test]
rite test_communication_style_verbose() {
    ≔ style = CommunicationStyle·verbose();
    assert(style.is_verbose());
    assert(!style.is_concise());
}

#[test]
rite test_communication_style_formal() {
    ≔ style = CommunicationStyle·formal();
    assert(style.is_formal());
    assert(!style.is_casual());
}

#[test]
rite test_communication_style_casual() {
    ≔ style = CommunicationStyle·casual();
    assert(style.is_casual());
    assert(!style.is_formal());
}

#[test]
rite test_communication_style_proactive() {
    ≔ style = CommunicationStyle·proactive();
    assert(style.is_proactive());
}

#[test]
rite test_communication_style_with_verbosity() {
    ≔ style = CommunicationStyle·default_style().with_verbosity(0.5);
    assert_eq(style.verbosity, 0.5);
}

#[test]
rite test_communication_style_clamped() {
    ≔ style = CommunicationStyle·default_style().with_verbosity(2.0);
    assert_eq(style.verbosity, 1.0);
}

// ============================================================================
// Tests: HumanProfile
// ============================================================================

#[test]
rite test_human_profile_new() {
    ≔ profile = HumanProfile·new(HumanId·new("alice"));
    assert_eq(profile.human_id.id, "alice");
    assert_eq(profile.interaction_count, 0);
}

#[test]
rite test_human_profile_adjust_verbosity() {
    ≔ Δ profile = HumanProfile·new(HumanId·new("bob"));
    profile.adjust_verbosity(0.2);
    assert_eq(profile.preferred_style.verbosity, 0.2);
    assert_eq(profile.interaction_count, 1);
}

#[test]
rite test_human_profile_adjust_verbosity_clamped() {
    ≔ Δ profile = HumanProfile·new(HumanId·new("test"));
    profile.adjust_verbosity(2.0);
    assert_eq(profile.preferred_style.verbosity, 1.0);
}

#[test]
rite test_human_profile_adjust_formality() {
    ≔ Δ profile = HumanProfile·new(HumanId·new("charlie"));
    profile.adjust_formality(-0.3);
    assert_eq(profile.preferred_style.formality, -0.3);
}

#[test]
rite test_human_profile_adjust_proactivity() {
    ≔ Δ profile = HumanProfile·new(HumanId·new("dave"));
    profile.adjust_proactivity(0.5);
    assert_eq(profile.preferred_style.proactivity, 0.5);
}

#[test]
rite test_human_profile_reinforce_current() {
    ≔ Δ profile = HumanProfile·new(HumanId·new("eve"));
    profile.preferred_style.verbosity = 0.5;
    profile.reinforce_current();
    assert(profile.preferred_style.verbosity > 0.5);
}

// ============================================================================
// Tests: FeedbackType
// ============================================================================

#[test]
rite test_feedback_type_is_positive() {
    assert(FeedbackType·Positive.is_positive());
    assert(FeedbackType·GoodApproach.is_positive());
    assert(!FeedbackType·Negative.is_positive());
}

#[test]
rite test_feedback_type_is_style_feedback() {
    assert(FeedbackType·TooVerbose.is_style_feedback());
    assert(FeedbackType·NeedMoreDetail.is_style_feedback());
    assert(FeedbackType·TooFormal.is_style_feedback());
    assert(FeedbackType·TooInformal.is_style_feedback());
    assert(!FeedbackType·Positive.is_style_feedback());
}

// ============================================================================
// Tests: Feedback
// ============================================================================

#[test]
rite test_feedback_new() {
    ≔ fb = Feedback·new(FeedbackType·Positive);
    assert(fb.human_id.is_none());
}

#[test]
rite test_feedback_from_human() {
    ≔ fb = Feedback·from_human(HumanId·new("user"), FeedbackType·TooVerbose);
    assert(fb.human_id.is_some());
}

#[test]
rite test_feedback_with_message() {
    ≔ fb = Feedback·new(FeedbackType·Negative)
        .with_message("Please be more concise");
    assert(fb.message.is_some());
}

#[test]
rite test_feedback_positivity() {
    assert_eq(Feedback·new(FeedbackType·Positive).positivity(), 1.0);
    assert_eq(Feedback·new(FeedbackType·Negative).positivity(), 0.0);
    assert_eq(Feedback·new(FeedbackType·GoodApproach).positivity(), 0.9);
}

// ============================================================================
// Tests: DomainKnowledge
// ============================================================================

#[test]
rite test_domain_knowledge_new() {
    ≔ dk = DomainKnowledge·new();
    assert_eq(dk.term_count(), 0);
    assert_eq(dk.convention_count(), 0);
}

#[test]
rite test_domain_knowledge_with_term() {
    ≔ dk = DomainKnowledge·new()
        .with_term("API", "Application Programming Interface");
    assert_eq(dk.term_count(), 1);
}

#[test]
rite test_domain_knowledge_with_convention() {
    ≔ dk = DomainKnowledge·new()
        .with_convention("Use snake_case ∀ variables");
    assert_eq(dk.convention_count(), 1);
}

#[test]
rite test_domain_knowledge_with_constraint() {
    ≔ dk = DomainKnowledge·new()
        .with_constraint("No global state");
    assert_eq(dk.constraint_count(), 1);
}

// ============================================================================
// Tests: DomainAdaptation
// ============================================================================

#[test]
rite test_domain_adaptation_from_knowledge() {
    ≔ dk = DomainKnowledge·new()
        .with_term("PR", "Pull Request");
    ≔ da = DomainAdaptation·from_knowledge("git", dk);
    assert_eq(da.domain, "git");
    assert(da.has_term("PR"));
}

#[test]
rite test_domain_adaptation_get_term() {
    ≔ dk = DomainKnowledge·new()
        .with_term("OOP", "Object-Oriented Programming");
    ≔ da = DomainAdaptation·from_knowledge("programming", dk);
    ≔ term = da.get_term("OOP");
    assert(term.is_some());
    assert_eq(*term.unwrap(), "Object-Oriented Programming");
}

#[test]
rite test_domain_adaptation_has_convention() {
    ≔ dk = DomainKnowledge·new()
        .with_convention("Test before commit");
    ≔ da = DomainAdaptation·from_knowledge("dev", dk);
    assert(da.has_convention("Test before commit"));
}

// ============================================================================
// Tests: AdaptationSystem
// ============================================================================

#[test]
rite test_adaptation_system_new() {
    ≔ system = AdaptationSystem·new();
    assert_eq(system.profile_count(), 0);
    assert_eq(system.domain_count(), 0);
}

#[test]
rite test_adaptation_system_with_default_style() {
    ≔ system = AdaptationSystem·new()
        .with_default_style(CommunicationStyle·formal());
    ≔ style = system.style_for(&HumanId·new("unknown"));
    assert(style.is_formal());
}

#[test]
rite test_adaptation_system_style_for_unknown() {
    ≔ system = AdaptationSystem·new();
    ≔ style = system.style_for(&HumanId·new("nobody"));
    assert_eq(style.verbosity, 0.0);  // default
}

#[test]
rite test_adaptation_system_update_profile_too_verbose() {
    ≔ Δ system = AdaptationSystem·new();
    ≔ human = HumanId·new("alice");
    ≔ feedback = Feedback·from_human(human.clone(), FeedbackType·TooVerbose);
    system.update_profile(&human, &feedback);

    ≔ style = system.style_for(&human);
    assert(style.verbosity < 0.0);
}

#[test]
rite test_adaptation_system_update_profile_need_detail() {
    ≔ Δ system = AdaptationSystem·new();
    ≔ human = HumanId·new("bob");
    ≔ feedback = Feedback·from_human(human.clone(), FeedbackType·NeedMoreDetail);
    system.update_profile(&human, &feedback);

    ≔ style = system.style_for(&human);
    assert(style.verbosity > 0.0);
}

#[test]
rite test_adaptation_system_update_profile_too_formal() {
    ≔ Δ system = AdaptationSystem·new();
    ≔ human = HumanId·new("charlie");
    ≔ feedback = Feedback·from_human(human.clone(), FeedbackType·TooFormal);
    system.update_profile(&human, &feedback);

    ≔ style = system.style_for(&human);
    assert(style.formality < 0.0);
}

#[test]
rite test_adaptation_system_adapt_to_domain() {
    ≔ Δ system = AdaptationSystem·new();
    ≔ knowledge = DomainKnowledge·new()
        .with_term("CI", "Continuous Integration");
    system.adapt_to_domain("devops", knowledge);

    assert(system.has_domain("devops"));
    ≔ da = system.domain_adaptation("devops");
    assert(da.is_some());
}

#[test]
rite test_adaptation_system_has_profile() {
    ≔ Δ system = AdaptationSystem·new();
    ≔ human = HumanId·new("test");
    ≔ feedback = Feedback·from_human(human.clone(), FeedbackType·Positive);
    system.update_profile(&human, &feedback);
    assert(system.has_profile(&human));
}

#[test]
rite test_adaptation_system_get_profile() {
    ≔ Δ system = AdaptationSystem·new();
    ≔ human = HumanId·new("dave");
    system.update_profile(&human, &Feedback·from_human(human.clone(), FeedbackType·TooVerbose));

    ≔ profile = system.get_profile(&human);
    assert(profile.is_some());
    assert_eq(profile.unwrap().interaction_count, 1);
}

#[test]
rite test_adaptation_system_multiple_updates() {
    ≔ Δ system = AdaptationSystem·new();
    ≔ human = HumanId·new("eve");

    // Multiple feedback updates
    system.update_profile(&human, &Feedback·from_human(human.clone(), FeedbackType·TooVerbose));
    system.update_profile(&human, &Feedback·from_human(human.clone(), FeedbackType·TooVerbose));
    system.update_profile(&human, &Feedback·from_human(human.clone(), FeedbackType·TooVerbose));

    ≔ style = system.style_for(&human);
    assert(style.verbosity < -0.2);  // Should have accumulated
}

rite main() {
    print("Gnosis adaptation tests");
}
