//! Tests for Gnosis Adaptation System
//!
//! Verifies AdaptationSystem, CommunicationStyle, HumanProfile, DomainAdaptation.

use std::collections::HashMap;

// ============================================================================
// Self-contained Test Types
// ============================================================================

pub struct Timestamp { nanos: u64 }
impl Timestamp { pub fn now() -> Self { Self { nanos: 1000 } } }

pub struct HumanId { id: String }
impl HumanId { pub fn new(id: &str) -> Self { Self { id: id.to_string() } } }
impl Clone for HumanId { fn clone(&self) -> Self { Self { id: self.id.clone() } } }
impl PartialEq for HumanId { fn eq(&self, other: &Self) -> bool { self.id == other.id } }
impl Eq for HumanId {}
impl std::hash::Hash for HumanId {
    fn hash<H: std::hash::Hasher>(&self, state: &mut H) { self.id.hash(state); }
}

#[derive(Clone)]
pub struct CommunicationStyle {
    /// Verbosity (-1 = minimal, 1 = verbose)
    pub verbosity: f32,
    /// Formality (-1 = casual, 1 = formal)
    pub formality: f32,
    /// Proactivity (-1 = reactive, 1 = proactive)
    pub proactivity: f32,
    /// Detail level (-1 = high-level, 1 = detailed)
    pub detail_level: f32,
    /// Check-in frequency (-1 = rare, 1 = frequent)
    pub check_in_frequency: f32,
}

impl CommunicationStyle {
    pub fn default_style() -> Self {
        Self {
            verbosity: 0.0,
            formality: 0.0,
            proactivity: 0.0,
            detail_level: 0.0,
            check_in_frequency: 0.0,
        }
    }

    pub fn concise() -> Self {
        Self { verbosity: -0.8, ..Self::default_style() }
    }

    pub fn verbose() -> Self {
        Self { verbosity: 0.8, ..Self::default_style() }
    }

    pub fn formal() -> Self {
        Self { formality: 0.8, ..Self::default_style() }
    }

    pub fn casual() -> Self {
        Self { formality: -0.8, ..Self::default_style() }
    }

    pub fn proactive() -> Self {
        Self { proactivity: 0.8, ..Self::default_style() }
    }

    pub fn reactive() -> Self {
        Self { proactivity: -0.8, ..Self::default_style() }
    }

    pub fn is_concise(&self) -> bool { self.verbosity < -0.3 }
    pub fn is_verbose(&self) -> bool { self.verbosity > 0.3 }
    pub fn is_formal(&self) -> bool { self.formality > 0.3 }
    pub fn is_casual(&self) -> bool { self.formality < -0.3 }
    pub fn is_proactive(&self) -> bool { self.proactivity > 0.3 }

    pub fn with_verbosity(mut self, v: f32) -> Self {
        self.verbosity = v.clamp(-1.0, 1.0);
        self
    }

    pub fn with_formality(mut self, f: f32) -> Self {
        self.formality = f.clamp(-1.0, 1.0);
        self
    }

    pub fn with_proactivity(mut self, p: f32) -> Self {
        self.proactivity = p.clamp(-1.0, 1.0);
        self
    }
}

pub struct HumanProfile {
    pub human_id: HumanId,
    pub preferred_style: CommunicationStyle,
    pub interaction_count: usize,
    pub last_interaction: Timestamp,
}

impl HumanProfile {
    pub fn new(human_id: HumanId) -> Self {
        Self {
            human_id,
            preferred_style: CommunicationStyle::default_style(),
            interaction_count: 0,
            last_interaction: Timestamp::now(),
        }
    }

    pub fn adjust_verbosity(&mut self, delta: f32) {
        self.preferred_style.verbosity = (self.preferred_style.verbosity + delta).clamp(-1.0, 1.0);
        self.interaction_count += 1;
    }

    pub fn adjust_formality(&mut self, delta: f32) {
        self.preferred_style.formality = (self.preferred_style.formality + delta).clamp(-1.0, 1.0);
        self.interaction_count += 1;
    }

    pub fn adjust_proactivity(&mut self, delta: f32) {
        self.preferred_style.proactivity = (self.preferred_style.proactivity + delta).clamp(-1.0, 1.0);
        self.interaction_count += 1;
    }

    pub fn reinforce_current(&mut self) {
        // Move slightly toward extremes
        self.preferred_style.verbosity *= 1.05;
        self.preferred_style.formality *= 1.05;
        self.preferred_style.verbosity = self.preferred_style.verbosity.clamp(-1.0, 1.0);
        self.preferred_style.formality = self.preferred_style.formality.clamp(-1.0, 1.0);
    }
}

#[derive(Clone)]
pub enum FeedbackType {
    Positive,
    Negative,
    TooVerbose,
    NeedMoreDetail,
    TooFormal,
    TooInformal,
    GoodApproach,
    WrongApproach,
}

impl FeedbackType {
    pub fn is_positive(&self) -> bool {
        match self {
            FeedbackType::Positive | FeedbackType::GoodApproach => true,
            _ => false,
        }
    }

    pub fn is_style_feedback(&self) -> bool {
        match self {
            FeedbackType::TooVerbose |
            FeedbackType::NeedMoreDetail |
            FeedbackType::TooFormal |
            FeedbackType::TooInformal => true,
            _ => false,
        }
    }
}

#[derive(Clone)]
pub struct Feedback {
    pub human_id: Option<HumanId>,
    pub feedback_type: FeedbackType,
    pub message: Option<String>,
}

impl Feedback {
    pub fn new(feedback_type: FeedbackType) -> Self {
        Self {
            human_id: None,
            feedback_type,
            message: None,
        }
    }

    pub fn from_human(human_id: HumanId, feedback_type: FeedbackType) -> Self {
        Self {
            human_id: Some(human_id),
            feedback_type,
            message: None,
        }
    }

    pub fn with_message(mut self, message: &str) -> Self {
        self.message = Some(message.to_string());
        self
    }

    pub fn positivity(&self) -> f32 {
        match self.feedback_type {
            FeedbackType::Positive => 1.0,
            FeedbackType::Negative => 0.0,
            FeedbackType::GoodApproach => 0.9,
            FeedbackType::WrongApproach => 0.1,
            _ => 0.3,
        }
    }
}

pub struct DomainKnowledge {
    pub terminology: HashMap<String, String>,
    pub conventions: Vec<String>,
    pub constraints: Vec<String>,
}

impl DomainKnowledge {
    pub fn new() -> Self {
        Self {
            terminology: HashMap::new(),
            conventions: vec![],
            constraints: vec![],
        }
    }

    pub fn with_term(mut self, term: &str, definition: &str) -> Self {
        self.terminology.insert(term.to_string(), definition.to_string());
        self
    }

    pub fn with_convention(mut self, convention: &str) -> Self {
        self.conventions.push(convention.to_string());
        self
    }

    pub fn with_constraint(mut self, constraint: &str) -> Self {
        self.constraints.push(constraint.to_string());
        self
    }

    pub fn term_count(&self) -> usize { self.terminology.len() }
    pub fn convention_count(&self) -> usize { self.conventions.len() }
    pub fn constraint_count(&self) -> usize { self.constraints.len() }
}

pub struct DomainAdaptation {
    pub domain: String,
    pub terminology: HashMap<String, String>,
    pub conventions: Vec<String>,
    pub constraints: Vec<String>,
}

impl DomainAdaptation {
    pub fn from_knowledge(domain: &str, knowledge: DomainKnowledge) -> Self {
        Self {
            domain: domain.to_string(),
            terminology: knowledge.terminology,
            conventions: knowledge.conventions,
            constraints: knowledge.constraints,
        }
    }

    pub fn get_term(&self, term: &str) -> Option<&String> {
        self.terminology.get(term)
    }

    pub fn has_term(&self, term: &str) -> bool {
        self.terminology.contains_key(term)
    }

    pub fn has_convention(&self, convention: &str) -> bool {
        self.conventions.contains(&convention.to_string())
    }
}

pub struct AdaptationConfig {
    pub preference_learning_rate: f32,
    pub preference_decay_rate: f32,
}

impl AdaptationConfig {
    pub fn default_config() -> Self {
        Self {
            preference_learning_rate: 0.1,
            preference_decay_rate: 0.01,
        }
    }
}

pub struct AdaptationSystem {
    profiles: HashMap<HumanId, HumanProfile>,
    domains: HashMap<String, DomainAdaptation>,
    default_style: CommunicationStyle,
    config: AdaptationConfig,
}

impl AdaptationSystem {
    pub fn new() -> Self {
        Self {
            profiles: HashMap::new(),
            domains: HashMap::new(),
            default_style: CommunicationStyle::default_style(),
            config: AdaptationConfig::default_config(),
        }
    }

    pub fn with_default_style(mut self, style: CommunicationStyle) -> Self {
        self.default_style = style;
        self
    }

    pub fn style_for(&self, human_id: &HumanId) -> CommunicationStyle {
        self.profiles.get(human_id)
            .map(|p| p.preferred_style.clone())
            .unwrap_or_else(|| self.default_style.clone())
    }

    pub fn update_profile(&mut self, human_id: &HumanId, feedback: &Feedback) {
        let profile = self.profiles
            .entry(human_id.clone())
            .or_insert_with(|| HumanProfile::new(human_id.clone()));

        match feedback.feedback_type {
            FeedbackType::TooVerbose => profile.adjust_verbosity(-0.1),
            FeedbackType::NeedMoreDetail => profile.adjust_verbosity(0.1),
            FeedbackType::TooFormal => profile.adjust_formality(-0.1),
            FeedbackType::TooInformal => profile.adjust_formality(0.1),
            FeedbackType::GoodApproach => profile.reinforce_current(),
            _ => {}
        }
    }

    pub fn adapt_to_domain(&mut self, domain: &str, knowledge: DomainKnowledge) {
        self.domains.insert(
            domain.to_string(),
            DomainAdaptation::from_knowledge(domain, knowledge)
        );
    }

    pub fn domain_adaptation(&self, domain: &str) -> Option<&DomainAdaptation> {
        self.domains.get(domain)
    }

    pub fn profile_count(&self) -> usize {
        self.profiles.len()
    }

    pub fn domain_count(&self) -> usize {
        self.domains.len()
    }

    pub fn has_profile(&self, human_id: &HumanId) -> bool {
        self.profiles.contains_key(human_id)
    }

    pub fn has_domain(&self, domain: &str) -> bool {
        self.domains.contains_key(domain)
    }

    pub fn get_profile(&self, human_id: &HumanId) -> Option<&HumanProfile> {
        self.profiles.get(human_id)
    }
}

// ============================================================================
// Tests: CommunicationStyle
// ============================================================================

#[test]
fn test_communication_style_default() {
    let style = CommunicationStyle::default_style();
    assert_eq(style.verbosity, 0.0);
    assert_eq(style.formality, 0.0);
    assert_eq(style.proactivity, 0.0);
}

#[test]
fn test_communication_style_concise() {
    let style = CommunicationStyle::concise();
    assert(style.is_concise());
    assert(!style.is_verbose());
}

#[test]
fn test_communication_style_verbose() {
    let style = CommunicationStyle::verbose();
    assert(style.is_verbose());
    assert(!style.is_concise());
}

#[test]
fn test_communication_style_formal() {
    let style = CommunicationStyle::formal();
    assert(style.is_formal());
    assert(!style.is_casual());
}

#[test]
fn test_communication_style_casual() {
    let style = CommunicationStyle::casual();
    assert(style.is_casual());
    assert(!style.is_formal());
}

#[test]
fn test_communication_style_proactive() {
    let style = CommunicationStyle::proactive();
    assert(style.is_proactive());
}

#[test]
fn test_communication_style_with_verbosity() {
    let style = CommunicationStyle::default_style().with_verbosity(0.5);
    assert_eq(style.verbosity, 0.5);
}

#[test]
fn test_communication_style_clamped() {
    let style = CommunicationStyle::default_style().with_verbosity(2.0);
    assert_eq(style.verbosity, 1.0);
}

// ============================================================================
// Tests: HumanProfile
// ============================================================================

#[test]
fn test_human_profile_new() {
    let profile = HumanProfile::new(HumanId::new("alice"));
    assert_eq(profile.human_id.id, "alice");
    assert_eq(profile.interaction_count, 0);
}

#[test]
fn test_human_profile_adjust_verbosity() {
    let mut profile = HumanProfile::new(HumanId::new("bob"));
    profile.adjust_verbosity(0.2);
    assert_eq(profile.preferred_style.verbosity, 0.2);
    assert_eq(profile.interaction_count, 1);
}

#[test]
fn test_human_profile_adjust_verbosity_clamped() {
    let mut profile = HumanProfile::new(HumanId::new("test"));
    profile.adjust_verbosity(2.0);
    assert_eq(profile.preferred_style.verbosity, 1.0);
}

#[test]
fn test_human_profile_adjust_formality() {
    let mut profile = HumanProfile::new(HumanId::new("charlie"));
    profile.adjust_formality(-0.3);
    assert_eq(profile.preferred_style.formality, -0.3);
}

#[test]
fn test_human_profile_adjust_proactivity() {
    let mut profile = HumanProfile::new(HumanId::new("dave"));
    profile.adjust_proactivity(0.5);
    assert_eq(profile.preferred_style.proactivity, 0.5);
}

#[test]
fn test_human_profile_reinforce_current() {
    let mut profile = HumanProfile::new(HumanId::new("eve"));
    profile.preferred_style.verbosity = 0.5;
    profile.reinforce_current();
    assert(profile.preferred_style.verbosity > 0.5);
}

// ============================================================================
// Tests: FeedbackType
// ============================================================================

#[test]
fn test_feedback_type_is_positive() {
    assert(FeedbackType::Positive.is_positive());
    assert(FeedbackType::GoodApproach.is_positive());
    assert(!FeedbackType::Negative.is_positive());
}

#[test]
fn test_feedback_type_is_style_feedback() {
    assert(FeedbackType::TooVerbose.is_style_feedback());
    assert(FeedbackType::NeedMoreDetail.is_style_feedback());
    assert(FeedbackType::TooFormal.is_style_feedback());
    assert(FeedbackType::TooInformal.is_style_feedback());
    assert(!FeedbackType::Positive.is_style_feedback());
}

// ============================================================================
// Tests: Feedback
// ============================================================================

#[test]
fn test_feedback_new() {
    let fb = Feedback::new(FeedbackType::Positive);
    assert(fb.human_id.is_none());
}

#[test]
fn test_feedback_from_human() {
    let fb = Feedback::from_human(HumanId::new("user"), FeedbackType::TooVerbose);
    assert(fb.human_id.is_some());
}

#[test]
fn test_feedback_with_message() {
    let fb = Feedback::new(FeedbackType::Negative)
        .with_message("Please be more concise");
    assert(fb.message.is_some());
}

#[test]
fn test_feedback_positivity() {
    assert_eq(Feedback::new(FeedbackType::Positive).positivity(), 1.0);
    assert_eq(Feedback::new(FeedbackType::Negative).positivity(), 0.0);
    assert_eq(Feedback::new(FeedbackType::GoodApproach).positivity(), 0.9);
}

// ============================================================================
// Tests: DomainKnowledge
// ============================================================================

#[test]
fn test_domain_knowledge_new() {
    let dk = DomainKnowledge::new();
    assert_eq(dk.term_count(), 0);
    assert_eq(dk.convention_count(), 0);
}

#[test]
fn test_domain_knowledge_with_term() {
    let dk = DomainKnowledge::new()
        .with_term("API", "Application Programming Interface");
    assert_eq(dk.term_count(), 1);
}

#[test]
fn test_domain_knowledge_with_convention() {
    let dk = DomainKnowledge::new()
        .with_convention("Use snake_case for variables");
    assert_eq(dk.convention_count(), 1);
}

#[test]
fn test_domain_knowledge_with_constraint() {
    let dk = DomainKnowledge::new()
        .with_constraint("No global state");
    assert_eq(dk.constraint_count(), 1);
}

// ============================================================================
// Tests: DomainAdaptation
// ============================================================================

#[test]
fn test_domain_adaptation_from_knowledge() {
    let dk = DomainKnowledge::new()
        .with_term("PR", "Pull Request");
    let da = DomainAdaptation::from_knowledge("git", dk);
    assert_eq(da.domain, "git");
    assert(da.has_term("PR"));
}

#[test]
fn test_domain_adaptation_get_term() {
    let dk = DomainKnowledge::new()
        .with_term("OOP", "Object-Oriented Programming");
    let da = DomainAdaptation::from_knowledge("programming", dk);
    let term = da.get_term("OOP");
    assert(term.is_some());
    assert_eq(*term.unwrap(), "Object-Oriented Programming");
}

#[test]
fn test_domain_adaptation_has_convention() {
    let dk = DomainKnowledge::new()
        .with_convention("Test before commit");
    let da = DomainAdaptation::from_knowledge("dev", dk);
    assert(da.has_convention("Test before commit"));
}

// ============================================================================
// Tests: AdaptationSystem
// ============================================================================

#[test]
fn test_adaptation_system_new() {
    let system = AdaptationSystem::new();
    assert_eq(system.profile_count(), 0);
    assert_eq(system.domain_count(), 0);
}

#[test]
fn test_adaptation_system_with_default_style() {
    let system = AdaptationSystem::new()
        .with_default_style(CommunicationStyle::formal());
    let style = system.style_for(&HumanId::new("unknown"));
    assert(style.is_formal());
}

#[test]
fn test_adaptation_system_style_for_unknown() {
    let system = AdaptationSystem::new();
    let style = system.style_for(&HumanId::new("nobody"));
    assert_eq(style.verbosity, 0.0);  // default
}

#[test]
fn test_adaptation_system_update_profile_too_verbose() {
    let mut system = AdaptationSystem::new();
    let human = HumanId::new("alice");
    let feedback = Feedback::from_human(human.clone(), FeedbackType::TooVerbose);
    system.update_profile(&human, &feedback);

    let style = system.style_for(&human);
    assert(style.verbosity < 0.0);
}

#[test]
fn test_adaptation_system_update_profile_need_detail() {
    let mut system = AdaptationSystem::new();
    let human = HumanId::new("bob");
    let feedback = Feedback::from_human(human.clone(), FeedbackType::NeedMoreDetail);
    system.update_profile(&human, &feedback);

    let style = system.style_for(&human);
    assert(style.verbosity > 0.0);
}

#[test]
fn test_adaptation_system_update_profile_too_formal() {
    let mut system = AdaptationSystem::new();
    let human = HumanId::new("charlie");
    let feedback = Feedback::from_human(human.clone(), FeedbackType::TooFormal);
    system.update_profile(&human, &feedback);

    let style = system.style_for(&human);
    assert(style.formality < 0.0);
}

#[test]
fn test_adaptation_system_adapt_to_domain() {
    let mut system = AdaptationSystem::new();
    let knowledge = DomainKnowledge::new()
        .with_term("CI", "Continuous Integration");
    system.adapt_to_domain("devops", knowledge);

    assert(system.has_domain("devops"));
    let da = system.domain_adaptation("devops");
    assert(da.is_some());
}

#[test]
fn test_adaptation_system_has_profile() {
    let mut system = AdaptationSystem::new();
    let human = HumanId::new("test");
    let feedback = Feedback::from_human(human.clone(), FeedbackType::Positive);
    system.update_profile(&human, &feedback);
    assert(system.has_profile(&human));
}

#[test]
fn test_adaptation_system_get_profile() {
    let mut system = AdaptationSystem::new();
    let human = HumanId::new("dave");
    system.update_profile(&human, &Feedback::from_human(human.clone(), FeedbackType::TooVerbose));

    let profile = system.get_profile(&human);
    assert(profile.is_some());
    assert_eq(profile.unwrap().interaction_count, 1);
}

#[test]
fn test_adaptation_system_multiple_updates() {
    let mut system = AdaptationSystem::new();
    let human = HumanId::new("eve");

    // Multiple feedback updates
    system.update_profile(&human, &Feedback::from_human(human.clone(), FeedbackType::TooVerbose));
    system.update_profile(&human, &Feedback::from_human(human.clone(), FeedbackType::TooVerbose));
    system.update_profile(&human, &Feedback::from_human(human.clone(), FeedbackType::TooVerbose));

    let style = system.style_for(&human);
    assert(style.verbosity < -0.2);  // Should have accumulated
}

fn main() {
    print("Gnosis adaptation tests");
}
