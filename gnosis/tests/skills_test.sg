fn test_skill_level_from_proficiency_novice() {
    assert_eq(SkillLevel::from_proficiency(0.1), SkillLevel::Novice);
    assert_eq(SkillLevel::from_proficiency(0.0), SkillLevel::Novice);
}

#[test]
fn test_skill_level_from_proficiency_advanced_beginner() {
    assert_eq(SkillLevel::from_proficiency(0.3), SkillLevel::AdvancedBeginner);
    assert_eq(SkillLevel::from_proficiency(0.4), SkillLevel::AdvancedBeginner);
}

#[test]
fn test_skill_level_from_proficiency_competent() {
    assert_eq(SkillLevel::from_proficiency(0.5), SkillLevel::Competent);
    assert_eq(SkillLevel::from_proficiency(0.6), SkillLevel::Competent);
}

#[test]
fn test_skill_level_from_proficiency_proficient() {
    assert_eq(SkillLevel::from_proficiency(0.7), SkillLevel::Proficient);
    assert_eq(SkillLevel::from_proficiency(0.8), SkillLevel::Proficient);
}

#[test]
fn test_skill_level_from_proficiency_expert() {
    assert_eq(SkillLevel::from_proficiency(0.9), SkillLevel::Expert);
    assert_eq(SkillLevel::from_proficiency(1.0), SkillLevel::Expert);
}

#[test]
fn test_skill_level_to_string() {
    assert_eq(SkillLevel::Novice.to_string(), "Novice");
    assert_eq(SkillLevel::Expert.to_string(), "Expert");
}

#[test]
fn test_skill_level_numeric() {
    assert_eq(SkillLevel::Novice.numeric_level(), 1);
    assert_eq(SkillLevel::Expert.numeric_level(), 5);
}

