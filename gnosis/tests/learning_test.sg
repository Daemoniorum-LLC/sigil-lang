//! Tests for Gnosis Learning Engine
//!
//! Verifies LearningEngine, Pattern, Lesson, and learning mechanics.

use std::collections::HashMap;

// ============================================================================
// Self-contained Test Types
// ============================================================================

pub struct Duration { nanos: u64 }
impl Duration { pub fn zero() -> Self { Self { nanos: 0 } } }
impl Copy for Duration {}
impl Clone for Duration { fn clone(&self) -> Self { *self } }

pub struct Timestamp { nanos: u64 }
impl Timestamp {
    pub fn now() -> Self { Self { nanos: 1000 } }
    pub fn from_nanos(n: u64) -> Self { Self { nanos: n } }
}

impl PartialOrd for Timestamp {
    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
        self.nanos.partial_cmp(&other.nanos)
    }
}

impl PartialEq for Timestamp {
    fn eq(&self, other: &Self) -> bool { self.nanos == other.nanos }
}

pub struct ExperienceId { id: String }
impl ExperienceId { pub fn generate() -> Self { Self { id: "exp".to_string() } } }
impl Clone for ExperienceId { fn clone(&self) -> Self { Self { id: self.id.clone() } } }

pub struct HumanId { id: String }
impl HumanId { pub fn new(id: &str) -> Self { Self { id: id.to_string() } } }
impl Clone for HumanId { fn clone(&self) -> Self { Self { id: self.id.clone() } } }

pub struct Confidence { value: f64 }
impl Confidence {
    pub fn new(v: f64) -> Self { Self { value: v.clamp(0.0, 1.0) } }
    pub fn zero() -> Self { Self { value: 0.0 } }
    pub fn value(&self) -> f64 { self.value }
}

#[derive(Clone)]
pub struct Context {
    pub task_type: String,
    pub domain: Option<String>,
}

impl Context {
    pub fn new(task_type: &str) -> Self {
        Self { task_type: task_type.to_string(), domain: None }
    }

    pub fn with_domain(mut self, domain: &str) -> Self {
        self.domain = Some(domain.to_string());
        self
    }

    pub fn similar_to(&self, other: &Context) -> bool {
        self.task_type == other.task_type
    }

    pub fn matches(&self, other: &Context) -> bool {
        self.task_type == other.task_type && self.domain == other.domain
    }
}

#[derive(Clone)]
pub struct Action {
    pub approach: String,
    pub skills: Vec<String>,
}

impl Action {
    pub fn new(approach: &str) -> Self {
        Self { approach: approach.to_string(), skills: vec![] }
    }

    pub fn with_skill(mut self, skill: &str) -> Self {
        self.skills.push(skill.to_string());
        self
    }
}

#[derive(Clone)]
pub struct ExperienceOutcome {
    pub success: bool,
    pub quality: f32,
    pub unexpected: bool,
}

impl ExperienceOutcome {
    pub fn success(quality: f32) -> Self {
        Self { success: true, quality: quality.clamp(0.0, 1.0), unexpected: false }
    }

    pub fn failure() -> Self {
        Self { success: false, quality: 0.0, unexpected: false }
    }

    pub fn unexpected(quality: f32) -> Self {
        Self { success: true, quality, unexpected: true }
    }
}

#[derive(Clone)]
pub struct Experience {
    pub id: ExperienceId,
    pub context: Context,
    pub action: Action,
    pub outcome: ExperienceOutcome,
    pub timestamp: Timestamp,
}

impl Experience {
    pub fn new(context: Context, action: Action, outcome: ExperienceOutcome) -> Self {
        Self {
            id: ExperienceId::generate(),
            context,
            action,
            outcome,
            timestamp: Timestamp::now(),
        }
    }
}

#[derive(Clone)]
pub enum LessonType {
    EffectiveApproach,
    IneffectiveApproach,
    SurprisingOutcome,
    FeedbackLearning,
}

pub struct Lesson {
    pub context: Context,
    pub approach: String,
    pub effectiveness: f32,
    pub lesson_type: LessonType,
}

impl Lesson {
    pub fn effective(context: Context, approach: &str, effectiveness: f32) -> Self {
        Self {
            context,
            approach: approach.to_string(),
            effectiveness,
            lesson_type: LessonType::EffectiveApproach,
        }
    }

    pub fn ineffective(context: Context, approach: &str) -> Self {
        Self {
            context,
            approach: approach.to_string(),
            effectiveness: 0.0,
            lesson_type: LessonType::IneffectiveApproach,
        }
    }

    pub fn is_positive(&self) -> bool {
        match self.lesson_type {
            LessonType::EffectiveApproach => true,
            _ => false,
        }
    }
}

pub struct Pattern {
    pub context: Context,
    pub approach: String,
    pub success_rate: f32,
    pub confidence: Confidence,
    pub occurrences: usize,
}

impl Pattern {
    pub fn new(context: Context, approach: &str) -> Self {
        Self {
            context,
            approach: approach.to_string(),
            success_rate: 0.0,
            confidence: Confidence::zero(),
            occurrences: 0,
        }
    }

    pub fn is_reliable(&self) -> bool {
        self.success_rate >= 0.7 && self.confidence.value() >= 0.5
    }

    pub fn record_outcome(&mut self, success: bool) {
        self.occurrences += 1;
        let outcome_val = if success { 1.0 } else { 0.0 };
        // Rolling average
        self.success_rate = (self.success_rate * (self.occurrences - 1) as f32 + outcome_val)
            / self.occurrences as f32;
        self.confidence = Confidence::new((self.occurrences as f64 / 10.0).min(1.0));
    }
}

pub struct LessonStore {
    lessons: Vec<Lesson>,
}

impl LessonStore {
    pub fn new() -> Self { Self { lessons: vec![] } }

    pub fn add(&mut self, lesson: Lesson) {
        self.lessons.push(lesson);
    }

    pub fn count(&self) -> usize { self.lessons.len() }

    pub fn lessons(&self) -> &[Lesson] { &self.lessons }

    pub fn for_context(&self, ctx: &Context) -> Vec<&Lesson> {
        self.lessons.iter().filter(|l| l.context.similar_to(ctx)).collect()
    }

    pub fn positive_lessons(&self) -> Vec<&Lesson> {
        self.lessons.iter().filter(|l| l.is_positive()).collect()
    }
}

pub struct PatternStore {
    patterns: Vec<Pattern>,
}

impl PatternStore {
    pub fn new() -> Self { Self { patterns: vec![] } }

    pub fn add(&mut self, pattern: Pattern) {
        self.patterns.push(pattern);
    }

    pub fn count(&self) -> usize { self.patterns.len() }

    pub fn get(&self, context: &Context, approach: &str) -> Option<&Pattern> {
        self.patterns.iter().find(|p|
            p.context.similar_to(context) && p.approach == approach
        )
    }

    pub fn get_mut(&mut self, context: &Context, approach: &str) -> Option<&mut Pattern> {
        self.patterns.iter_mut().find(|p|
            p.context.similar_to(context) && p.approach == approach
        )
    }

    pub fn reliable_patterns(&self) -> Vec<&Pattern> {
        self.patterns.iter().filter(|p| p.is_reliable()).collect()
    }

    pub fn for_context(&self, ctx: &Context) -> Vec<&Pattern> {
        self.patterns.iter().filter(|p| p.context.similar_to(ctx)).collect()
    }
}

pub struct LearningConfig {
    pub max_experiences: usize,
    pub pattern_threshold: usize,
    pub generalization_threshold: f32,
}

impl LearningConfig {
    pub fn default_config() -> Self {
        Self {
            max_experiences: 1000,
            pattern_threshold: 3,
            generalization_threshold: 0.7,
        }
    }

    pub fn with_pattern_threshold(mut self, threshold: usize) -> Self {
        self.pattern_threshold = threshold;
        self
    }
}

pub struct LearningEngine {
    experiences: Vec<Experience>,
    pub patterns: PatternStore,
    pub lessons: LessonStore,
    config: LearningConfig,
}

impl LearningEngine {
    pub fn new() -> Self {
        Self {
            experiences: vec![],
            patterns: PatternStore::new(),
            lessons: LessonStore::new(),
            config: LearningConfig::default_config(),
        }
    }

    pub fn with_config(config: LearningConfig) -> Self {
        Self {
            experiences: vec![],
            patterns: PatternStore::new(),
            lessons: LessonStore::new(),
            config,
        }
    }

    pub fn record_experience(&mut self, exp: Experience) {
        // Check for pattern or update existing
        if let Some(pattern) = self.patterns.get_mut(&exp.context, &exp.action.approach) {
            pattern.record_outcome(exp.outcome.success);
        } else {
            // Check if we should create new pattern
            let similar_count = self.experiences.iter()
                .filter(|e| e.context.similar_to(&exp.context) && e.action.approach == exp.action.approach)
                .count();

            if similar_count >= self.config.pattern_threshold - 1 {
                let mut pattern = Pattern::new(exp.context.clone(), &exp.action.approach);
                // Calculate success rate from similar experiences
                let similar: Vec<_> = self.experiences.iter()
                    .filter(|e| e.context.similar_to(&exp.context) && e.action.approach == exp.action.approach)
                    .collect();
                let successes = similar.iter().filter(|e| e.outcome.success).count() + if exp.outcome.success { 1 } else { 0 };
                let total = similar.len() + 1;
                pattern.success_rate = successes as f32 / total as f32;
                pattern.occurrences = total;
                pattern.confidence = Confidence::new((total as f64 / 10.0).min(1.0));
                self.patterns.add(pattern);
            }
        }

        self.experiences.push(exp);

        // Trim if over capacity
        while self.experiences.len() > self.config.max_experiences {
            self.experiences.remove(0);
        }
    }

    pub fn extract_lessons(&self, exp: &Experience) -> Vec<Lesson> {
        let mut lessons = Vec::new();

        if exp.outcome.success {
            lessons.push(Lesson::effective(
                exp.context.clone(),
                &exp.action.approach,
                exp.outcome.quality
            ));
        } else {
            lessons.push(Lesson::ineffective(
                exp.context.clone(),
                &exp.action.approach
            ));
        }

        if exp.outcome.unexpected {
            lessons.push(Lesson {
                context: exp.context.clone(),
                approach: exp.action.approach.clone(),
                effectiveness: 0.5,
                lesson_type: LessonType::SurprisingOutcome,
            });
        }

        lessons
    }

    pub fn experience_count(&self) -> usize {
        self.experiences.len()
    }

    pub fn pattern_count(&self) -> usize {
        self.patterns.count()
    }

    pub fn lesson_count(&self) -> usize {
        self.lessons.count()
    }

    pub fn find_similar(&self, context: &Context) -> Vec<&Experience> {
        self.experiences.iter().filter(|e| e.context.similar_to(context)).collect()
    }

    pub fn success_rate_for(&self, context: &Context, approach: &str) -> Option<f32> {
        self.patterns.get(context, approach).map(|p| p.success_rate)
    }
}

// ============================================================================
// Tests: Lesson
// ============================================================================

#[test]
fn test_lesson_effective() {
    let lesson = Lesson::effective(Context::new("coding"), "tdd", 0.9);
    assert(lesson.is_positive());
    assert_eq(lesson.effectiveness, 0.9);
}

#[test]
fn test_lesson_ineffective() {
    let lesson = Lesson::ineffective(Context::new("coding"), "cowboy_coding");
    assert(!lesson.is_positive());
    assert_eq(lesson.effectiveness, 0.0);
}

// ============================================================================
// Tests: Pattern
// ============================================================================

#[test]
fn test_pattern_new() {
    let pattern = Pattern::new(Context::new("testing"), "unit_tests");
    assert_eq(pattern.approach, "unit_tests");
    assert_eq(pattern.occurrences, 0);
}

#[test]
fn test_pattern_record_outcome_success() {
    let mut pattern = Pattern::new(Context::new("testing"), "approach");
    pattern.record_outcome(true);
    assert_eq(pattern.occurrences, 1);
    assert_eq(pattern.success_rate, 1.0);
}

#[test]
fn test_pattern_record_outcome_failure() {
    let mut pattern = Pattern::new(Context::new("testing"), "approach");
    pattern.record_outcome(false);
    assert_eq(pattern.success_rate, 0.0);
}

#[test]
fn test_pattern_record_multiple_outcomes() {
    let mut pattern = Pattern::new(Context::new("testing"), "approach");
    pattern.record_outcome(true);
    pattern.record_outcome(true);
    pattern.record_outcome(false);
    // 2/3 ≈ 0.667
    let diff = (pattern.success_rate - 0.667).abs();
    assert(diff < 0.01);
}

#[test]
fn test_pattern_is_reliable() {
    let mut pattern = Pattern::new(Context::new("testing"), "reliable");
    for _ in 0..10 {
        pattern.record_outcome(true);
    }
    assert(pattern.is_reliable());
}

#[test]
fn test_pattern_not_reliable_low_success() {
    let mut pattern = Pattern::new(Context::new("testing"), "unreliable");
    for _ in 0..10 {
        pattern.record_outcome(false);
    }
    assert(!pattern.is_reliable());
}

// ============================================================================
// Tests: LessonStore
// ============================================================================

#[test]
fn test_lesson_store_new() {
    let store = LessonStore::new();
    assert_eq(store.count(), 0);
}

#[test]
fn test_lesson_store_add() {
    let mut store = LessonStore::new();
    store.add(Lesson::effective(Context::new("task"), "approach", 0.8));
    assert_eq(store.count(), 1);
}

#[test]
fn test_lesson_store_for_context() {
    let mut store = LessonStore::new();
    store.add(Lesson::effective(Context::new("coding"), "tdd", 0.9));
    store.add(Lesson::effective(Context::new("coding"), "pair", 0.8));
    store.add(Lesson::effective(Context::new("testing"), "unit", 0.7));

    let coding_lessons = store.for_context(&Context::new("coding"));
    assert_eq(coding_lessons.len(), 2);
}

#[test]
fn test_lesson_store_positive_lessons() {
    let mut store = LessonStore::new();
    store.add(Lesson::effective(Context::new("task"), "good", 0.9));
    store.add(Lesson::ineffective(Context::new("task"), "bad"));

    let positive = store.positive_lessons();
    assert_eq(positive.len(), 1);
}

// ============================================================================
// Tests: PatternStore
// ============================================================================

#[test]
fn test_pattern_store_new() {
    let store = PatternStore::new();
    assert_eq(store.count(), 0);
}

#[test]
fn test_pattern_store_add() {
    let mut store = PatternStore::new();
    store.add(Pattern::new(Context::new("coding"), "tdd"));
    assert_eq(store.count(), 1);
}

#[test]
fn test_pattern_store_get() {
    let mut store = PatternStore::new();
    store.add(Pattern::new(Context::new("coding"), "tdd"));

    let pattern = store.get(&Context::new("coding"), "tdd");
    assert(pattern.is_some());
}

#[test]
fn test_pattern_store_get_missing() {
    let store = PatternStore::new();
    let pattern = store.get(&Context::new("coding"), "nonexistent");
    assert(pattern.is_none());
}

#[test]
fn test_pattern_store_reliable_patterns() {
    let mut store = PatternStore::new();

    let mut reliable = Pattern::new(Context::new("good"), "approach");
    for _ in 0..10 {
        reliable.record_outcome(true);
    }
    store.add(reliable);

    let mut unreliable = Pattern::new(Context::new("bad"), "approach");
    unreliable.record_outcome(false);
    store.add(unreliable);

    let reliable_patterns = store.reliable_patterns();
    assert_eq(reliable_patterns.len(), 1);
}

#[test]
fn test_pattern_store_for_context() {
    let mut store = PatternStore::new();
    store.add(Pattern::new(Context::new("coding"), "tdd"));
    store.add(Pattern::new(Context::new("coding"), "pair"));
    store.add(Pattern::new(Context::new("testing"), "unit"));

    let coding = store.for_context(&Context::new("coding"));
    assert_eq(coding.len(), 2);
}

