    pub fn is_reliable(&self) -> bool {
        self.success_rate >= 0.7 && self.confidence.value() >= 0.5
    }

    pub fn record_outcome(&mut self, success: bool) {
        self.occurrences += 1;
        let outcome_val = if success { 1.0 } else { 0.0 };
        // Rolling average
        self.success_rate = (self.success_rate * (self.occurrences - 1) as f32 + outcome_val)
            / self.occurrences as f32;
        self.confidence = Confidence::new((self.occurrences as f64 / 10.0).min(1.0));
    }
}

