#[test]
fn test_learning_config_default() {
    let config = LearningConfig::default_config();
    assert_eq(config.max_experiences, 1000);
    assert_eq(config.pattern_threshold, 3);
}

#[test]
fn test_learning_config_with_pattern_threshold() {
    let config = LearningConfig::default_config().with_pattern_threshold(5);
    assert_eq(config.pattern_threshold, 5);
}

// ============================================================================
// Tests: LearningEngine
// ============================================================================

#[test]
fn test_learning_engine_new() {
    let engine = LearningEngine::new();
    assert_eq(engine.experience_count(), 0);
    assert_eq(engine.pattern_count(), 0);
}

#[test]
fn test_learning_engine_record_experience() {
    let mut engine = LearningEngine::new();
    engine.record_experience(Experience::new(
        Context::new("coding"),
        Action::new("write_tests"),
        ExperienceOutcome::success(0.9)
    ));
    assert_eq(engine.experience_count(), 1);
}

#[test]
fn test_learning_engine_extract_lessons_success() {
    let engine = LearningEngine::new();
    let exp = Experience::new(
        Context::new("coding"),
        Action::new("tdd"),
        ExperienceOutcome::success(0.9)
    );

    let lessons = engine.extract_lessons(&exp);
    assert_eq(lessons.len(), 1);
    assert(lessons[0].is_positive());
}

#[test]
fn test_learning_engine_extract_lessons_failure() {
    let engine = LearningEngine::new();
    let exp = Experience::new(
        Context::new("coding"),
        Action::new("skip_tests"),
        ExperienceOutcome::failure()
    );

    let lessons = engine.extract_lessons(&exp);
    assert_eq(lessons.len(), 1);
    assert(!lessons[0].is_positive());
}

#[test]
fn test_learning_engine_extract_lessons_unexpected() {
    let engine = LearningEngine::new();
    let exp = Experience::new(
        Context::new("experiment"),
        Action::new("try_something"),
        ExperienceOutcome::unexpected(0.7)
    );

    let lessons = engine.extract_lessons(&exp);
    assert_eq(lessons.len(), 2);  // success + surprising
}

#[test]
fn test_learning_engine_pattern_detection() {
    let mut engine = LearningEngine::with_config(
        LearningConfig::default_config().with_pattern_threshold(2)
    );

    // Record enough similar experiences to trigger pattern detection
    engine.record_experience(Experience::new(
        Context::new("coding"),
        Action::new("tdd"),
        ExperienceOutcome::success(0.9)
    ));
    engine.record_experience(Experience::new(
        Context::new("coding"),
        Action::new("tdd"),
        ExperienceOutcome::success(0.8)
    ));

    assert_eq(engine.pattern_count(), 1);
}

#[test]
fn test_learning_engine_find_similar() {
    let mut engine = LearningEngine::new();
    engine.record_experience(Experience::new(
        Context::new("coding"),
        Action::new("approach1"),
        ExperienceOutcome::success(0.9)
    ));
    engine.record_experience(Experience::new(
        Context::new("testing"),
        Action::new("approach2"),
        ExperienceOutcome::success(0.8)
    ));
    engine.record_experience(Experience::new(
        Context::new("coding"),
        Action::new("approach3"),
        ExperienceOutcome::success(0.7)
    ));

    let similar = engine.find_similar(&Context::new("coding"));
    assert_eq(similar.len(), 2);
}

#[test]
fn test_learning_engine_success_rate_for() {
    let mut engine = LearningEngine::with_config(
        LearningConfig::default_config().with_pattern_threshold(2)
    );

    engine.record_experience(Experience::new(
        Context::new("task"),
        Action::new("approach"),
        ExperienceOutcome::success(0.9)
    ));
    engine.record_experience(Experience::new(
        Context::new("task"),
        Action::new("approach"),
        ExperienceOutcome::success(0.8)
    ));

    let rate = engine.success_rate_for(&Context::new("task"), "approach");
    assert(rate.is_some());
    assert_eq(rate.unwrap(), 1.0);
}

#[test]
fn test_learning_engine_max_experiences() {
    let mut engine = LearningEngine::with_config(LearningConfig {
        max_experiences: 3,
        pattern_threshold: 5,
        generalization_threshold: 0.7,
    });

    for i in 0..5 {
        engine.record_experience(Experience::new(
            Context::new(&format!("task_{}", i)),
            Action::new("approach"),
            ExperienceOutcome::success(0.8)
        ));
    }

    assert_eq(engine.experience_count(), 3);
}

#[test]
fn test_learning_engine_multiple_patterns() {
    let mut engine = LearningEngine::with_config(
        LearningConfig::default_config().with_pattern_threshold(2)
    );

    // Pattern 1
    engine.record_experience(Experience::new(
        Context::new("coding"), Action::new("tdd"), ExperienceOutcome::success(0.9)
    ));
    engine.record_experience(Experience::new(
        Context::new("coding"), Action::new("tdd"), ExperienceOutcome::success(0.9)
    ));

    // Pattern 2
    engine.record_experience(Experience::new(
        Context::new("testing"), Action::new("unit"), ExperienceOutcome::success(0.8)
    ));
    engine.record_experience(Experience::new(
        Context::new("testing"), Action::new("unit"), ExperienceOutcome::success(0.8)
    ));

    assert_eq(engine.pattern_count(), 2);
}

fn main() {
    print("Gnosis learning tests");
}
