// Benchmark: Collection Operations
// Tests: Vec push, iteration, map/filter

λ main() {
    // Build a large vector
    ≔ Δ nums: Vec<i64> = Vec·new();
    ≔ Δ i = 0;
    ⟳ i < 100000 {
        nums.push(i);
        i = i + 1;
    }
    println(nums.len());

    // Sum with loop
    ≔ Δ sum = 0;
    ∀ n ∈ nums {
        sum = sum + n;
    }
    println(sum);
}
