// Benchmark: String Operations
// Tests: String concatenation, manipulation

λ main() {
    ≔ Δ result = "";
    ≔ Δ i = 0;
    ⟳ i < 10000 {
        result = result + "x";
        i = i + 1;
    }
    println(result.len());

    // Split and join
    ≔ parts = result.split("");
    ≔ joined = parts.join("-");
