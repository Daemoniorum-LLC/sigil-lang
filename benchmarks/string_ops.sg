// Benchmark: String Operations
// Tests: String concatenation, manipulation

fn main() {
    let mut result = "";
    let mut i = 0;
    while i < 10000 {
        result = result + "x";
        i = i + 1;
    }
    println(result.len());

    // Split and join
    let parts = result.split("");
    let joined = parts.join("-");
    println(joined.len());
}
