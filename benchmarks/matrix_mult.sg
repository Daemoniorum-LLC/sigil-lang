// Benchmark: Matrix Multiplication (flattened)
// Tests: Nested loops, array indexing, arithmetic

λ matrix_mult(size: i64) -> i64 {
    ≔ n = size;
    ≔ total = n * n;

    // Create flattened matrices (row-major)
    ≔ Δ a: Vec<i64> = Vec·new();
    ≔ Δ b: Vec<i64> = Vec·new();
    ≔ Δ c: Vec<i64> = Vec·new();

    // Initialize
    ≔ Δ idx = 0;
    ⟳ idx < total {
        ≔ i = idx / n;
        ≔ j = idx % n;
        a.push(i + j);
        b.push(i * j);
        c.push(0);
        idx = idx + 1;
    }

    // Multiply: c[i,j] = sum(a[i,k] * b[k,j])
    ≔ Δ i = 0;
    ⟳ i < n {
        ≔ Δ j = 0;
        ⟳ j < n {
            ≔ Δ sum = 0;
            ≔ Δ k = 0;
            ⟳ k < n {
                ≔ a_idx = i * n + k;
                ≔ b_idx = k * n + j;
                sum = sum + a[a_idx] * b[b_idx];
                k = k + 1;
            }
            ≔ c_idx = i * n + j;
            c[c_idx] = sum;
            j = j + 1;
        }
        i = i + 1;
    }

    // Return corner element as checksum
    c[total - 1]
}

λ main() {
    ≔ result = matrix_mult(100);
    println(result);
}
