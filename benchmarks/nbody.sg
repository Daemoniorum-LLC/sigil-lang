// Benchmark: N-Body Simulation (simplified)
// Tests: Floating point, struct operations

struct Body {
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
    mass: f64
}

fn advance(bodies: &mut Vec<Body>, dt: f64) {
    let n = bodies.len();
    let mut i = 0;
    while i < n {
        let mut j = i + 1;
        while j < n {
            let dx = bodies[i].x - bodies[j].x;
            let dy = bodies[i].y - bodies[j].y;
            let dz = bodies[i].z - bodies[j].z;
            let dist2 = dx * dx + dy * dy + dz * dz;
            let dist = dist2.sqrt();
            let mag = dt / (dist2 * dist);

            let mi = bodies[i].mass;
            let mj = bodies[j].mass;

            bodies[i].vx = bodies[i].vx - dx * mj * mag;
            bodies[i].vy = bodies[i].vy - dy * mj * mag;
            bodies[i].vz = bodies[i].vz - dz * mj * mag;

            bodies[j].vx = bodies[j].vx + dx * mi * mag;
            bodies[j].vy = bodies[j].vy + dy * mi * mag;
            bodies[j].vz = bodies[j].vz + dz * mi * mag;

            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while i < n {
        bodies[i].x = bodies[i].x + dt * bodies[i].vx;
        bodies[i].y = bodies[i].y + dt * bodies[i].vy;
        bodies[i].z = bodies[i].z + dt * bodies[i].vz;
        i = i + 1;
    }
}

fn energy(bodies: &Vec<Body>) -> f64 {
    let mut e = 0.0;
    let n = bodies.len();
    let mut i = 0;
    while i < n {
        let b = &bodies[i];
        e = e + 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz);
        let mut j = i + 1;
        while j < n {
            let b2 = &bodies[j];
            let dx = b.x - b2.x;
            let dy = b.y - b2.y;
            let dz = b.z - b2.z;
            let dist = (dx * dx + dy * dy + dz * dz).sqrt();
            e = e - (b.mass * b2.mass) / dist;
            j = j + 1;
        }
        i = i + 1;
    }
    e
}

fn main() {
    let mut bodies: Vec<Body> = Vec::new();

    // Sun
    bodies.push(Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: 39.478 });
    // Jupiter
    bodies.push(Body { x: 4.84, y: -1.16, z: -0.10, vx: 0.606, vy: 2.811, vz: -0.025, mass: 0.0378 });
    // Saturn
    bodies.push(Body { x: 8.34, y: 4.12, z: -0.40, vx: -1.010, vy: 1.826, vz: 0.008, mass: 0.0113 });
    // Uranus
    bodies.push(Body { x: 12.89, y: -15.11, z: 0.22, vx: 1.083, vy: 0.868, vz: -0.010, mass: 0.00173 });
    // Neptune
    bodies.push(Body { x: 15.38, y: -25.92, z: 0.17, vx: 0.979, vy: 0.594, vz: -0.034, mass: 0.00203 });

    let n = 50000;
    let dt = 0.01;

    let e1 = energy(&bodies);
    println(e1);

    let mut i = 0;
    while i < n {
        advance(&mut bodies, dt);
        i = i + 1;
    }

    let e2 = energy(&bodies);
    println(e2);
}
